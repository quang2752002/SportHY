@model GiaiDauDto
@{
    ViewData["Title"] = $"Đăng Ký - {Model.Ten}";
    var currentUnit = ViewBag.CurrentDonVi as DonViDto;
    var athletes = ViewBag.Athletes as List<VanDongVienDto> ?? new();
    var categories = ViewBag.Categories as List<DanhMucMonTheThaoDto> ?? new();
    var sports = Model.MonTheThaos ?? new();
    bool isExpired = Model.HanDangKy.HasValue && Model.HanDangKy.Value < DateTime.Now;
}

<div class="d-flex flex-column gap-4">
    <!-- Breadcrumb & Back -->
    <div class="d-flex align-items-center justify-content-between">
        <a href="/DonVi/DangKy" class="btn btn-sm btn-light border rounded-pill px-3 d-inline-flex align-items-center gap-1.5">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Quay lại danh sách giải</span>
        </a>
        <span class="badge badge-soft-emerald px-3 py-1.5 rounded-pill fw-semibold">
            Đoàn: @(currentUnit?.Ten ?? "Đơn vị thi đấu")
        </span>
    </div>

    <!-- Tournament Banner -->
    <div class="card-custom p-4 position-relative overflow-hidden"
         style="background: linear-gradient(135deg, #065f46 0%, #0f766e 100%); color: #ffffff;">
        <div class="d-flex flex-column flex-md-row md-align-items-center justify-content-between gap-3">
            <div>
                <div class="d-inline-flex align-items-center gap-1.5 px-2.5 py-0.5 rounded-pill mb-2 bg-white bg-opacity-20 small">
                    <i class="fa-solid fa-trophy text-warning"></i>
                    <span>@Model.TrangThaiText</span>
                </div>
                <h3 class="fw-bold mb-1 text-white">@Model.Ten</h3>
                <div class="d-flex flex-wrap gap-3 text-white-50 small mt-2">
                    <span><i class="fa-solid fa-calendar me-1"></i> @Model.NgayBatDau.ToString("dd/MM/yyyy") - @Model.NgayKetThuc.ToString("dd/MM/yyyy")</span>
                    @if (Model.HanDangKy.HasValue)
                    {
                        <span class="@(isExpired ? "text-warning fw-bold" : "")">
                            <i class="fa-solid fa-clock me-1"></i> Hạn chót đăng ký: @Model.HanDangKy.Value.ToString("dd/MM/yyyy")
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(Model.DiaDiem))
                    {
                        <span><i class="fa-solid fa-location-dot me-1"></i> @Model.DiaDiem</span>
                    }
                </div>
            </div>

            <div class="text-md-end">
                <div class="fs-6 text-white-50">Tổng số môn thi đấu</div>
                <div class="fs-2 fw-bold text-white">@sports.Count môn</div>
            </div>
        </div>
    </div>

    @if (isExpired)
    {
        <div class="alert alert-warning border-warning d-flex align-items-center gap-2 mb-0 py-2.5">
            <i class="fa-solid fa-triangle-exclamation fs-5"></i>
            <div>
                <strong>Lưu ý:</strong> Giải đấu này đã quá thời hạn đăng ký thi đấu. Bạn chỉ có thể xem lại danh sách các hồ sơ đã nộp trước đó.
            </div>
        </div>
    }

    <!-- Tabs Header -->
    <div class="card-custom p-2">
        <ul class="nav nav-pills nav-fill gap-2" id="registrationTabs" role="tablist">
            @if (!isExpired)
            {
                <li class="nav-item" role="presentation">
                    <button class="nav-link active rounded-pill py-2.5 fw-semibold d-inline-flex align-items-center justify-content-center gap-2"
                            id="tab-new-reg" data-bs-toggle="pill" data-bs-target="#content-new-reg" type="button" role="tab">
                        <i class="fa-solid fa-file-circle-plus text-success"></i>
                        <span>Đăng Ký Môn Thi Đấu Mới</span>
                    </button>
                </li>
            }
            <li class="nav-item" role="presentation">
                <button class="nav-link @(isExpired ? "active" : "") rounded-pill py-2.5 fw-semibold d-inline-flex align-items-center justify-content-center gap-2"
                        id="tab-submitted-reg" data-bs-toggle="pill" data-bs-target="#content-submitted-reg" type="button" role="tab" onclick="loadSubmittedRegistrations()">
                    <i class="fa-solid fa-folder-open text-primary"></i>
                    <span>Hồ Sơ Đã Nộp Của Đoàn</span>
                    <span class="badge bg-secondary rounded-pill ms-1" id="regCountBadge">0</span>
                </button>
            </li>
        </ul>
    </div>

    <!-- Tabs Content -->
    <div class="tab-content" id="registrationTabsContent">
        <!-- Tab 1: Đăng ký mới -->
        @if (!isExpired)
        {
            <div class="tab-pane fade show active" id="content-new-reg" role="tabpanel">
                <div class="card-custom p-4">
                    <form id="formRegistration">
                        <h5 class="fw-bold text-dark mb-3 pb-2 border-bottom">
                            <i class="fa-solid fa-pen-to-square text-success me-2"></i> Phiếu Đăng Ký Thi Đấu
                        </h5>

                        <!-- Bước 1: Chọn môn thi -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label class="form-label small fw-bold text-dark">
                                    Danh mục môn thể thao
                                </label>
                                <select id="selectCategory" class="form-select" onchange="onCategoryChanged()">
                                    <option value="">-- Tất cả danh mục --</option>
                                    @foreach (var cat in categories)
                                    {
                                        <option value="@cat.Id">@cat.Ten</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-bold text-dark">
                                    1. Chọn Môn Thi Đấu Trong Giải <span class="text-danger">*</span>
                                </label>
                                <select id="selectSport" class="form-select" required onchange="onSportChanged()">
                                    <option value="">-- Vui lòng chọn môn thi đấu --</option>
                                    @foreach (var s in sports)
                                    {
                                        <option value="@s.Id"
                                                data-catid="@(s.DanhMucId ?? 0)"
                                                data-name="@s.Ten"
                                                data-team="@(s.LaMonDongDoi ? "true" : "false")"
                                                data-gender="@(s.GioiTinh ?? "TatCa")"
                                                data-format="@(s.HinhThucThiDau ?? "")"
                                                data-cat="@(s.TenDanhMuc ?? "")">
                                            @s.Ten @(!string.IsNullOrEmpty(s.TenDanhMuc) ? $"({s.TenDanhMuc})" : "") - @(s.LaMonDongDoi ? "Đồng đội" : "Cá nhân")
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-bold text-dark">
                                    Thông tin môn thi đã chọn
                                </label>
                                <div id="sportInfoBox" class="p-2.5 rounded-3 bg-light border text-muted small" style="min-height: 38px;">
                                    Chưa chọn môn thi đấu.
                                </div>
                            </div>
                        </div>

                        <!-- Bước 2: Tên đội / Đơn vị đại diện -->
                        <div class="mb-4" id="teamNameSection" style="display: none;">
                            <label class="form-label small fw-bold text-dark">
                                2. Tên Đội Thi Đấu (Cho môn đồng đội) <span class="text-danger">*</span>
                            </label>
                            <input type="text" id="inputTenDoi" class="form-control" placeholder="VD: Đội 1 - Đoàn Sở VH-TT" />
                            <small class="text-muted">Hệ thống sẽ dùng tên này để hiển thị trên bảng đấu và lịch thi đấu.</small>
                        </div>

                        <!-- Bước 3: Chọn VĐV từ đoàn -->
                        <div class="mb-4" id="athleteSection">
                            <div class="d-flex flex-column flex-sm-row sm-align-items-center justify-content-between gap-2 mb-2">
                                <label class="form-label small fw-bold text-dark mb-0">
                                    3. Chọn Vận Động Viên Tham Gia <span class="text-danger">*</span>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle ms-2" id="selectedCountBadge">Đã chọn: 0 VĐV</span>
                                </label>
                                <div class="d-flex align-items-center gap-2">
                                    <input type="text" id="athleteSearch" class="form-control form-control-sm" placeholder="Lọc tên VĐV..." style="max-width: 180px;" oninput="filterAthletes()" disabled />
                                    <div class="form-check form-switch small mb-0">
                                        <input class="form-check-input" type="checkbox" id="checkFilterGender" checked onchange="filterAthletes()" disabled />
                                        <label class="form-check-label text-muted" for="checkFilterGender">Lọc theo giới tính môn</label>
                                    </div>
                                </div>
                            </div>

                            <!-- Alert nhắc chọn môn -->
                            <div id="athleteSelectHint" class="alert alert-warning py-2 px-3 small mb-2 d-flex align-items-center gap-2 rounded-3 border-0 bg-warning bg-opacity-10 text-warning-emphasis">
                                <i class="fa-solid fa-circle-exclamation text-warning fs-6"></i>
                                <span>Vui lòng chọn <strong>Môn thi đấu trong giải</strong> ở bước 1 để mở danh sách chọn vận động viên.</span>
                            </div>

                            @if (athletes.Count == 0)
                            {
                                <div class="p-4 rounded-3 bg-light border text-center text-muted">
                                    <i class="fa-solid fa-user-xmark fs-2 opacity-50 mb-2"></i>
                                    <p class="mb-2">Đoàn của bạn chưa có VĐV nào trong danh sách.</p>
                                    <a href="/DonVi/VanDongVien" class="btn btn-sm btn-donvi-primary rounded-pill px-3">
                                        + Thêm VĐV vào đoàn ngay
                                    </a>
                                </div>
                            }
                            else
                            {
                                <div class="border rounded-3 p-3 bg-light" style="max-height: 320px; overflow-y: auto; opacity: 0.45; pointer-events: none; transition: all 0.3s;" id="athleteListContainer">
                                    <div class="row g-2" id="athleteGrid">
                                        @foreach (var a in athletes)
                                        {
                                            var dobStr = a.NgaySinh.HasValue ? a.NgaySinh.Value.ToString("dd/MM/yyyy") : "--";
                                            <div class="col-md-6 col-xl-4 athlete-item"
                                                 data-id="@a.Id"
                                                 data-name="@a.HoTen.ToLower()"
                                                 data-gender="@(a.GioiTinh ?? "Nam")">
                                                <div class="p-2.5 rounded-3 bg-white border d-flex align-items-center gap-2.5 athlete-card-selectable"
                                                     onclick="toggleAthleteSelection(@a.Id)"
                                                     id="athleteCard_@a.Id"
                                                     style="cursor: pointer; transition: all 0.2s;">
                                                    <input type="checkbox" class="form-check-input athlete-checkbox flex-shrink-0"
                                                           value="@a.Id"
                                                           id="cbAthlete_@a.Id"
                                                           onclick="event.stopPropagation(); toggleAthleteSelection(@a.Id)" />
                                                    <div class="overflow-hidden lh-sm">
                                                        <div class="fw-semibold text-dark text-truncate" style="font-size: 13px;">@a.HoTen</div>
                                                        <small class="text-muted" style="font-size: 11px;">
                                                            @(a.GioiTinh == "Nam" ? "Nam" : "Nữ") • @dobStr
                                                            @if (!string.IsNullOrEmpty(a.SoCCCD))
                                                            {
                                                                <span>• CCCD: @a.SoCCCD</span>
                                                            }
                                                        </small>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Ghi chú -->
                        <div class="mb-4">
                            <label class="form-label small fw-bold text-dark">4. Ghi Chú (Tùy chọn)</label>
                            <textarea id="inputGhiChu" class="form-control" rows="2" placeholder="Nhập ghi chú thêm cho ban tổ chức nếu cần..."></textarea>
                        </div>

                        <!-- Nút gửi hồ sơ -->
                        <div class="d-flex align-items-center justify-content-between pt-3 border-top">
                            <span class="small text-muted">
                                <i class="fa-solid fa-circle-info text-primary me-1"></i> Hồ sơ nộp từ đơn vị sẽ tự động được phê duyệt vào danh sách thi đấu.
                            </span>
                            <button type="submit" class="btn btn-donvi-primary rounded-pill px-4 py-2 fw-semibold" id="btnSubmitReg">
                                <i class="fa-solid fa-paper-plane me-1"></i> Gửi Hồ Sơ Đăng Ký
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        }

        <!-- Tab 2: Hồ sơ đã nộp -->
        <div class="tab-pane fade @(isExpired ? "show active" : "")" id="content-submitted-reg" role="tabpanel">
            <div class="card-custom p-4">
                <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                    <div>
                        <h5 class="fw-bold text-dark mb-1">
                            <i class="fa-solid fa-folder-open text-primary me-2"></i> Danh Sách Hồ Sơ Đã Gửi Của Đoàn
                        </h5>
                        <p class="text-muted small mb-0">Các nội dung và vận động viên đã đăng ký tham gia giải đấu này</p>
                    </div>
                    <button class="btn btn-sm btn-light border rounded-pill px-3" onclick="loadSubmittedRegistrations()">
                        <i class="fa-solid fa-arrow-rotate-right me-1"></i> Làm mới
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="tableSubmitted">
                        <thead class="table-light">
                            <tr style="font-size: 12px; text-transform: uppercase;">
                                <th class="ps-3 py-3">Số ĐK</th>
                                <th>Môn Thi Đấu</th>
                                <th>Tên Đội / Đăng Ký</th>
                                <th>Vận Động Viên Tham Gia</th>
                                <th>Ngày Nộp</th>
                                <th>Trạng Thái</th>
                                <th class="text-end pe-3">Hủy</th>
                            </tr>
                        </thead>
                        <tbody id="submittedTableBody" style="font-size: 13px;">
                            <!-- Injected by JS -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .athlete-card-selectable:hover {
            border-color: #059669 !important;
            background-color: #f0fdf4 !important;
        }
        .athlete-card-selectable.selected {
            border-color: #059669 !important;
            background-color: #ecfdf5 !important;
            box-shadow: 0 0 0 1px #059669;
        }
    </style>
}

@section Scripts {
    <script>
        const giaiDauId = @Model.Id;
        let selectedAthletes = [];
        let currentSportIsTeam = false;
        let submittedRegistrations = [];

        $(document).ready(function () {
            loadSubmittedRegistrations();

            $('#formRegistration').on('submit', function (e) {
                e.preventDefault();
                submitRegistrationForm();
            });
        });

        function onCategoryChanged() {
            const catId = $('#selectCategory').val();
            const $sportSelect = $('#selectSport');
            const currentSportVal = $sportSelect.val();
            let hasCurrent = false;

            $sportSelect.find('option').each(function () {
                const optCatId = $(this).data('catid');
                const val = $(this).val();

                if (!val) {
                    $(this).show();
                    return;
                }

                if (!catId || optCatId == catId) {
                    $(this).show();
                    if (val == currentSportVal) hasCurrent = true;
                } else {
                    $(this).hide();
                }
            });

            if (currentSportVal && !hasCurrent) {
                $sportSelect.val('');
                onSportChanged();
            }
        }

        function onSportChanged() {
            const select = document.getElementById('selectSport');
            const selectedOption = select.options[select.selectedIndex];

            if (!selectedOption || !selectedOption.value) {
                $('#sportInfoBox').html('Chưa chọn môn thi đấu.');
                $('#teamNameSection').slideUp();
                currentSportIsTeam = false;

                // Khóa chọn VĐV
                $('#athleteSelectHint').slideDown();
                $('#athleteListContainer').css({ 'opacity': '0.45', 'pointer-events': 'none' });
                $('#athleteSearch').prop('disabled', true);
                $('#checkFilterGender').prop('disabled', true);

                selectedAthletes = [];
                updateAthleteCheckboxes();
                return;
            }

            // Mở khóa chọn VĐV
            $('#athleteSelectHint').slideUp();
            $('#athleteListContainer').css({ 'opacity': '1', 'pointer-events': 'auto' });
            $('#athleteSearch').prop('disabled', false);
            $('#checkFilterGender').prop('disabled', false);

            const name = selectedOption.getAttribute('data-name');
            const isTeam = selectedOption.getAttribute('data-team') === 'true';
            const gender = selectedOption.getAttribute('data-gender');
            const format = selectedOption.getAttribute('data-format');
            currentSportIsTeam = isTeam;

            let genderText = gender === 'Nam' ? 'Nam' : (gender === 'Nu' ? 'Nữ' : 'Nam & Nữ (Hỗn hợp)');
            let infoHtml = `
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="badge ${isTeam ? 'bg-info-subtle text-info border border-info-subtle' : 'bg-primary-subtle text-primary border border-primary-subtle'}">
                        ${isTeam ? 'Đồng đội' : 'Cá nhân'}
                    </span>
                    <span class="badge bg-light text-dark border">Giới tính: ${genderText}</span>
                    ${format ? `<span class="badge bg-light text-dark border">Thể thức: ${format}</span>` : ''}
                </div>
            `;
            $('#sportInfoBox').html(infoHtml);

            if (isTeam) {
                $('#teamNameSection').slideDown();
                if (!$('#inputTenDoi').val()) {
                    $('#inputTenDoi').val(`Đội ${name} - @(currentUnit?.Ten ?? "Đoàn")`);
                }
            } else {
                $('#teamNameSection').slideUp();
                if (selectedAthletes.length > 1) {
                    selectedAthletes = [selectedAthletes[0]];
                    updateAthleteCheckboxes();
                }
            }

            // Tự động bỏ chọn các VĐV không đúng giới tính nếu trước đó có chọn
            cleanInvalidGenderAthletes(gender);
            filterAthletes();
        }

        function cleanInvalidGenderAthletes(sportGender) {
            if (!sportGender || sportGender === 'HonHop' || sportGender === 'TatCa') return;

            const validIds = [];
            selectedAthletes.forEach(id => {
                const athleteGender = $(`[data-id="${id}"]`).data('gender');
                if (athleteGender === sportGender) {
                    validIds.push(id);
                }
            });

            if (validIds.length !== selectedAthletes.length) {
                selectedAthletes = validIds;
                updateAthleteCheckboxes();
                SportApp.toast('warning', `Đã tự động bỏ chọn các VĐV không đúng giới tính quy định (${sportGender === 'Nam' ? 'Nam' : 'Nữ'}).`);
            }
        }

        function filterAthletes() {
            const keyword = $('#athleteSearch').val().toLowerCase().trim();
            const filterGender = $('#checkFilterGender').is(':checked');

            const select = document.getElementById('selectSport');
            const selectedOption = select.options[select.selectedIndex];
            const sportGender = selectedOption ? selectedOption.getAttribute('data-gender') : null;

            $('.athlete-item').each(function () {
                const name = $(this).data('name') || '';
                const gender = $(this).data('gender') || '';

                let matchGender = true;
                if (filterGender && sportGender && sportGender !== 'TatCa') {
                    matchGender = (gender === sportGender);
                }

                let matchText = !keyword || name.includes(keyword);

                if (matchGender && matchText) {
                    $(this).show();
                } else {
                    $(this).hide();
                }
            });
        }

        function toggleAthleteSelection(id) {
            const select = document.getElementById('selectSport');
            if (!select || !select.value) {
                Swal.fire('Thông báo', 'Vui lòng chọn môn thi đấu ở Bước 1 trước khi chọn vận động viên.', 'info');
                return;
            }

            const selectedOption = select.options[select.selectedIndex];
            const sportGender = selectedOption ? selectedOption.getAttribute('data-gender') : null;
            const athleteItem = $(`[data-id="${id}"]`);
            const athleteGender = athleteItem.data('gender') || '';

            const index = selectedAthletes.indexOf(id);
            if (index > -1) {
                // Deselect
                selectedAthletes.splice(index, 1);
            } else {
                // Select: Kiểm tra nghiêm ngặt giới tính
                if (sportGender && sportGender !== 'HonHop' && sportGender !== 'TatCa') {
                    if (sportGender !== athleteGender) {
                        const requiredText = sportGender === 'Nam' ? 'Nam' : 'Nữ';
                        const athleteText = athleteGender === 'Nam' ? 'Nam' : 'Nữ';
                        Swal.fire({
                            icon: 'warning',
                            title: 'Không đúng giới tính quy định',
                            text: `Môn này quy định chỉ dành riêng cho vận động viên ${requiredText}. Không thể chọn vận động viên ${athleteText}.`,
                            confirmButtonColor: '#059669'
                        });
                        return;
                    }
                }

                if (!currentSportIsTeam) {
                    selectedAthletes = [id];
                } else {
                    selectedAthletes.push(id);
                }
            }

            updateAthleteCheckboxes();
        }

        function updateAthleteCheckboxes() {
            $('.athlete-checkbox').each(function () {
                const id = parseInt($(this).val());
                const isSelected = selectedAthletes.includes(id);
                $(this).prop('checked', isSelected);
                if (isSelected) {
                    $(`#athleteCard_${id}`).addClass('selected');
                } else {
                    $(`#athleteCard_${id}`).removeClass('selected');
                }
            });

            $('#selectedCountBadge').text(`Đã chọn: ${selectedAthletes.length} VĐV`);
        }

        function submitRegistrationForm() {
            const select = document.getElementById('selectSport');
            const gdmId = parseInt(select ? select.value : 0);
            if (!gdmId) {
                Swal.fire('Lỗi', 'Vui lòng chọn môn thi đấu', 'warning');
                return;
            }

            if (selectedAthletes.length === 0) {
                Swal.fire('Lỗi', 'Vui lòng chọn ít nhất một vận động viên', 'warning');
                return;
            }

            if (!currentSportIsTeam && selectedAthletes.length > 1) {
                Swal.fire('Lỗi', 'Môn cá nhân chỉ được chọn đúng 1 vận động viên', 'warning');
                return;
            }

            // Kiểm tra giới tính toàn bộ VĐV đã chọn trước khi gửi
            const selectedOption = select.options[select.selectedIndex];
            const sportGender = selectedOption ? selectedOption.getAttribute('data-gender') : null;
            if (sportGender && sportGender !== 'HonHop' && sportGender !== 'TatCa') {
                for (let id of selectedAthletes) {
                    const athleteGender = $(`[data-id="${id}"]`).data('gender');
                    if (athleteGender !== sportGender) {
                        const expectedStr = sportGender === 'Nam' ? 'Nam' : 'Nữ';
                        Swal.fire('Lỗi giới tính', `Môn thi đấu này chỉ dành cho VĐV ${expectedStr}. Vui lòng bỏ chọn các VĐV không đúng giới tính quy định.`, 'error');
                        return;
                    }
                }
            }

            let tenDoi = $('#inputTenDoi').val().trim();
            if (currentSportIsTeam && !tenDoi) {
                tenDoi = `Đội @(currentUnit?.Ten ?? "Đoàn")`;
            }

            const payload = {
                giaiDauMonTheThaoId: gdmId,
                tuDongTaoDoi: true,
                tenDoi: tenDoi,
                ghiChu: $('#inputGhiChu').val().trim(),
                vanDongVienIds: selectedAthletes,
                trangThai: 'DaDuyet'
            };

            $('#btnSubmitReg').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Đang nộp hồ sơ...');

            $.ajax({
                url: '/DonVi/DangKy/SubmitRegistration',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    $('#btnSubmitReg').prop('disabled', false).html('<i class="fa-solid fa-paper-plane me-1"></i> Gửi Hồ Sơ Đăng Ký');
                    if (res.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Thành công!',
                            text: res.message,
                            timer: 2000,
                            showConfirmButton: false
                        });

                        // Reset form
                        $('#selectSport').val('');
                        $('#inputTenDoi').val('');
                        $('#inputGhiChu').val('');
                        selectedAthletes = [];
                        updateAthleteCheckboxes();
                        onSportChanged();

                        // Switch to tab "Hồ sơ đã gửi"
                        const submittedTabTrigger = document.querySelector('#tab-submitted-reg');
                        const tab = new bootstrap.Tab(submittedTabTrigger);
                        tab.show();
                        loadSubmittedRegistrations();
                    } else {
                        Swal.fire('Lỗi', res.message || 'Không thể gửi đăng ký', 'error');
                    }
                },
                error: function () {
                    $('#btnSubmitReg').prop('disabled', false).html('<i class="fa-solid fa-paper-plane me-1"></i> Gửi Hồ Sơ Đăng Ký');
                    Swal.fire('Lỗi', 'Lỗi kết nối máy chủ', 'error');
                }
            });
        }

        function loadSubmittedRegistrations() {
            $('#submittedTableBody').html(`<tr><td colspan="7" class="text-center py-4 text-muted"><div class="spinner-border spinner-border-sm text-success me-2"></div>Đang tải danh sách hồ sơ...</td></tr>`);

            $.get(`/DonVi/DangKy/GetRegistrations?giaiDauId=${giaiDauId}`, function (res) {
                if (res.success && res.data) {
                    submittedRegistrations = res.data;
                    $('#regCountBadge').text(submittedRegistrations.length);
                    renderSubmittedTable(submittedRegistrations);
                } else {
                    $('#submittedTableBody').html(`<tr><td colspan="7" class="text-center py-4 text-danger">Không thể tải hồ sơ.</td></tr>`);
                }
            }).fail(function () {
                $('#submittedTableBody').html(`<tr><td colspan="7" class="text-center py-4 text-danger">Lỗi kết nối máy chủ.</td></tr>`);
            });
        }

        function renderSubmittedTable(items) {
            const tbody = $('#submittedTableBody');
            tbody.empty();

            if (!items || items.length === 0) {
                tbody.html(`<tr><td colspan="7" class="text-center py-5 text-muted"><i class="fa-solid fa-folder-open fs-2 mb-2 opacity-50 d-block"></i>Chưa có hồ sơ đăng ký nào được nộp vào giải này.</td></tr>`);
                return;
            }

            items.forEach(r => {
                const dateStr = r.ngayDangKy ? new Date(r.ngayDangKy).toLocaleDateString('vi-VN') : '--';
                const vdvNamesHtml = (r.vanDongVienNames && r.vanDongVienNames.length > 0)
                    ? r.vanDongVienNames.map(name => `<span class="badge bg-light text-dark border me-1 mb-1 font-normal"><i class="fa-solid fa-user me-1 text-secondary"></i>${name}</span>`).join('')
                    : `<span class="text-muted small">${r.soVdv} VĐV</span>`;

                const tr = `
                    <tr>
                        <td class="ps-3 fw-bold text-secondary font-monospace" style="font-size: 12px;">${r.soDangKy || '--'}</td>
                        <td>
                            <div class="fw-semibold text-dark">${r.tenMonTheThao || 'Môn thi'}</div>
                        </td>
                        <td>
                            <div class="fw-medium text-dark">${r.tenDoi || r.tenDangKy || '--'}</div>
                        </td>
                        <td>
                            <div class="d-flex flex-wrap" style="max-width: 320px;">
                                ${vdvNamesHtml}
                            </div>
                        </td>
                        <td>${dateStr}</td>
                        <td>
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1 rounded-pill">
                                <i class="fa-solid fa-circle-check me-1"></i>Đã duyệt
                            </span>
                        </td>
                        <td class="text-end pe-3">
                            <button class="btn btn-sm btn-light border py-1 px-2 text-danger" title="Hủy hồ sơ" onclick="deleteReg(${r.id}, '${r.soDangKy || ''}')">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                `;
                tbody.append(tr);
            });
        }

        function deleteReg(id, code) {
            Swal.fire({
                title: 'Hủy hồ sơ đăng ký?',
                html: `Bạn có chắc chắn muốn hủy hồ sơ <strong>${code}</strong>? VĐV sẽ bị rút khỏi môn thi đấu này.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Hủy hồ sơ',
                cancelButtonText: 'Đóng'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: `/DonVi/DangKy/DeleteRegistration/${id}`,
                        type: 'POST',
                        success: function (res) {
                            if (res.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Đã hủy',
                                    text: res.message,
                                    timer: 1500,
                                    showConfirmButton: false
                                });
                                loadSubmittedRegistrations();
                            } else {
                                Swal.fire('Lỗi', res.message || 'Không thể hủy hồ sơ', 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Lỗi', 'Lỗi kết nối máy chủ', 'error');
                        }
                    });
                }
            });
        }
    </script>
}
