@model List<Dms.Application.DTOs.CoordinatorRefereeItemDto>
@{
    ViewData["Title"] = "Trọng tài phụ trách môn";
    var sportList = ViewBag.SportList as List<MonTheThao> ?? new();
    var currentAssignment = ViewBag.CurrentAssignment as Dms.Application.DTOs.CoordinatorAssignmentDto;
    var selectedMonId = ViewBag.SelectedMonId as int?;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1 dh-page-heading">
            <i class="fa-solid fa-user-shield me-2"></i> Trọng tài phụ trách môn
        </h4>
        <p class="dh-page-subtitle small mb-0">Danh sách trọng tài được phân công trong giải và danh mục môn hiện tại.</p>
        @if (currentAssignment != null)
        {
            <span class="badge bg-primary bg-opacity-10 text-primary mt-2"><i class="fa-solid fa-trophy me-1"></i>@currentAssignment.TenGiaiDau · @currentAssignment.TenDanhMuc</span>
        }
    </div>
    <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary px-3 py-2"><i class="fa-solid fa-users me-1"></i>@(Model?.Count ?? 0) trọng tài</span>
</div>

<div class="card card-custom mb-3 p-2 bg-white">
    <div class="d-flex align-items-center overflow-auto py-1 gap-2">
        <span class="text-muted small fw-bold text-uppercase px-2 text-nowrap"><i class="fa-solid fa-filter me-1 text-primary"></i>Lọc môn:</span>
        <a href="/DieuHanhMon/TrongTai?giaiDauId=@ViewBag.SelectedGiaiDauId&danhMucId=@ViewBag.SelectedDanhMucId" class="btn btn-sm text-nowrap rounded-pill @(!selectedMonId.HasValue ? "btn-primary fw-bold" : "btn-light border")">Tất cả môn</a>
        @foreach (var sp in sportList)
        {
            bool isActive = selectedMonId == sp.Id;
            <a href="/DieuHanhMon/TrongTai?giaiDauId=@ViewBag.SelectedGiaiDauId&danhMucId=@ViewBag.SelectedDanhMucId&monTheThaoId=@sp.Id" class="btn btn-sm text-nowrap rounded-pill @(isActive ? "btn-primary fw-bold" : "btn-light border")">@sp.Ten</a>
        }
    </div>
</div>

<!-- Bảng trọng tài -->
<div class="card card-custom">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-muted small text-uppercase">
                <tr>
                    <th style="width: 80px;">Mã TT</th>
                    <th>Họ và Tên</th>
                    <th>Giới Tính</th>
                    <th>Cấp Bậc</th>
                    <th>Thông Tin Liên Hệ</th>
                    <th class="text-center">Số Trận Điều Hành Môn</th>
                    <th>Các Vai Trò Đảm Nhiệm</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Count > 0)
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-secondary">@item.Ma</td>
                            <td>
                                <div class="fw-bold text-dark">@item.HoTen</div>
                            </td>
                            <td>@(item.GioiTinh ?? "Nam")</td>
                            <td>
                                <span class="badge bg-secondary bg-opacity-10 text-secondary px-2 py-1">
                                    @(item.CapBac ?? "Chưa xếp")
                                </span>
                            </td>
                            <td>
                                <div class="small">
                                    <div><i class="fa-solid fa-phone text-muted me-1"></i> @(item.SoDienThoai ?? "--")</div>
                                    <div class="text-muted"><i class="fa-regular fa-envelope text-muted me-1"></i> @(item.Email ?? "--")</div>
                                </div>
                            </td>
                            <td class="text-center">
                                <span class="badge rounded-pill bg-primary px-3 py-2 fs-6">
                                    @item.SoTranDieuHanh trận
                                </span>
                            </td>
                            <td>
                                    <span class="badge bg-primary bg-opacity-10 text-primary px-2 py-1">
                                    @(string.IsNullOrEmpty(item.CacVaiTro) ? "Trọng tài" : item.CacVaiTro)
                                </span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="dh-empty-state">
                            <i class="fa-solid fa-user-slash"></i>
                            Chưa có trọng tài nào được phân công điều hành môn này. Ban trọng tài sẽ phân công sớm.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
