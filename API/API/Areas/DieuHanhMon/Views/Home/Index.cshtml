@{
    ViewData["Title"] = "Tổng Quan Điều Hành Môn";
    var selectedGiaiDauId = ViewBag.SelectedGiaiDauId as int?;
    var selectedDanhMucId = ViewBag.SelectedDanhMucId as int?;
    var selectedAssignmentQuery = selectedGiaiDauId.HasValue && selectedDanhMucId.HasValue
        ? $"?giaiDauId={selectedGiaiDauId.Value}&danhMucId={selectedDanhMucId.Value}"
        : string.Empty;
}

<!-- Trạng thái Loading -->
<div id="dashboardLoading" class="text-center py-5">
    <div class="spinner-border text-primary" style="width: 2.5rem; height: 2.5rem;" role="status">
        <span class="visually-hidden">Đang tải dữ liệu...</span>
    </div>
    <p class="text-muted mt-3 fw-semibold">Đang tải dữ liệu điều hành môn thể thao...</p>
</div>

<!-- Trạng thái Thông báo / Cảnh báo -->
<div id="dashboardAlert" class="card card-custom d-none">
    <div class="card-body d-flex gap-3 align-items-start p-4">
        <span class="rounded-circle bg-primary bg-opacity-10 text-primary p-3"><i class="fa-solid fa-circle-info fs-5"></i></span>
        <div><h4 class="fw-bold mb-1">Chưa có môn được phân công</h4><p id="dashboardAlertMsg" class="text-muted mb-0">Bạn chưa được phân công điều hành môn thể thao nào trong các giải đấu.</p></div>
    </div>
</div>

<!-- Khung nội dung chính (Render qua AJAX) -->
<div id="dashboardContent" class="d-none">
    <!-- Banner môn điều hành -->
    <div class="card card-custom border-0 mb-4 text-white overflow-hidden position-relative" style="background: linear-gradient(120deg, #14264f 0%, #1d4ed8 72%, #3b82f6 100%);">
        <div class="card-body p-4 position-relative" style="z-index: 2;">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-primary text-white fw-bold px-3 py-1 rounded-pill">ĐIỀU HÀNH MÔN THỂ THAO</span>
                        <span id="bannerMaDanhMuc" class="badge bg-white bg-opacity-20 text-white px-3 py-1 rounded-pill">DM</span>
                    </div>
                    <h2 id="bannerTenDanhMuc" class="fw-bold mb-1 text-white">Môn Thể Thao</h2>
                    <p class="mb-0 text-white-50 fs-6">
                        <i class="fa-solid fa-trophy text-warning me-1"></i> Giải đấu: <strong id="bannerTenGiaiDau" class="text-white">--</strong>
                    </p>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a href="/DieuHanhMon/LichThiDau@(selectedAssignmentQuery)" class="btn btn-light fw-bold px-3 py-2 shadow-sm text-primary">
                        <i class="fa-solid fa-calendar-check me-1"></i> Lịch Thi Đấu & Tiến Độ
                    </a>
                    <a href="/DieuHanhMon/KetQua@(selectedAssignmentQuery)" class="btn btn-outline-light px-3 py-2">
                        <i class="fa-solid fa-square-poll-vertical me-1"></i> Kiểm Tra Kết Quả
                    </a>
                    <a href="/DieuHanhMon/SuCo@(selectedAssignmentQuery)" class="btn btn-outline-light px-3 py-2">
                        <i class="fa-solid fa-triangle-exclamation me-1"></i> Sự cố
                    </a>
                </div>
            </div>
        </div>
        <div class="position-absolute end-0 bottom-0 opacity-10" style="font-size: 14rem; line-height: 0.8; margin-right: -2rem; margin-bottom: -3rem;">
            <i class="fa-solid fa-volleyball"></i>
        </div>
    </div>

    <!-- Hàng thẻ KPI -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xxl-2">
            <div class="card card-custom p-3 h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Môn thể thao</span>
                        <h3 class="fw-bold mt-1 mb-0 text-primary"><span id="statTotalSports">0</span> <span class="fs-6 fw-normal text-muted">môn</span></h3>
                        <small class="text-muted">Thuộc danh mục được giao</small>
                    </div>
                    <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-3 fs-3">
                        <i class="fa-solid fa-shapes"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xxl-2">
            <div class="card card-custom p-3 h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Môn trong giải</span>
                        <h3 class="fw-bold mt-1 mb-0 text-primary"><span id="statTotalEvents">0</span> <span class="fs-6 fw-normal text-muted">môn</span></h3>
                        <small class="text-muted">Được thiết lập cho giải</small>
                    </div>
                    <div class="rounded-3 bg-primary bg-opacity-10 p-3 text-primary fs-3">
                        <i class="fa-solid fa-layer-group"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xxl-2">
            <div class="card card-custom p-3 h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Tổng Số Trận Đấu</span>
                        <h3 class="fw-bold mt-1 mb-0 text-success"><span id="statTotalMatches">0</span> <span class="fs-6 fw-normal text-muted">trận</span></h3>
                        <small class="text-muted fw-semibold"><i class="fa-solid fa-check me-1 text-success"></i> <span id="statCompletedMatches">0</span> đã hoàn thành</small>
                    </div>
                    <div class="rounded-3 bg-success bg-opacity-10 p-3 text-success fs-3">
                        <i class="fa-solid fa-futbol"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xxl-2">
            <div class="card card-custom p-3 h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Trọng Tài Của Môn</span>
                        <h3 class="fw-bold mt-1 mb-0 text-primary"><span id="statTotalReferees">0</span> <span class="fs-6 fw-normal text-muted">trọng tài</span></h3>
                        <small class="text-muted">Được ban trọng tài phân công</small>
                    </div>
                    <div class="rounded-3 bg-primary bg-opacity-10 p-3 text-primary fs-3">
                        <i class="fa-solid fa-user-shield"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xxl-2">
            <div class="card card-custom p-3 h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div><span class="text-muted small fw-semibold text-uppercase">Đang thi đấu</span><h3 class="fw-bold mt-1 mb-0 text-primary"><span id="statOngoingMatches">0</span> <span class="fs-6 fw-normal text-muted">trận</span></h3><small class="text-muted">Cần theo dõi trực tiếp</small></div>
                    <div class="rounded-3 bg-primary bg-opacity-10 p-3 text-primary fs-3"><i class="fa-solid fa-tower-broadcast"></i></div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xxl-2">
            <div class="card card-custom p-3 h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div><span class="text-muted small fw-semibold text-uppercase">Chưa bắt đầu</span><h3 class="fw-bold mt-1 mb-0 text-primary"><span id="statUpcomingMatches">0</span> <span class="fs-6 fw-normal text-muted">trận</span></h3><small class="text-muted">Trong lịch môn phụ trách</small></div>
                    <div class="rounded-3 bg-primary bg-opacity-10 p-3 text-primary fs-3"><i class="fa-regular fa-clock"></i></div>
                </div>
            </div>
        </div>
    </div>

    <div class="card card-custom p-3 p-md-4 mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
            <div><h5 class="fw-bold mb-1">Tiến độ thi đấu</h5><span id="overallProgressLabel" class="text-muted small">0 / 0 trận đã hoàn thành</span></div>
            <span id="overallProgressPercent" class="badge rounded-pill bg-primary bg-opacity-10 text-primary px-3 py-2">0%</span>
        </div>
        <div class="progress" role="progressbar" aria-label="Tiến độ thi đấu" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" style="height:10px;border-radius:999px">
            <div id="overallProgressBar" class="progress-bar" style="width:0%;background:linear-gradient(90deg,#1d4ed8,#60a5fa)"></div>
        </div>
    </div>

    <!-- Danh sách trận đấu mới nhất hoặc đang diễn ra của môn -->
    <div class="card card-custom mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-dark">
                <i class="fa-solid fa-clock-rotate-left text-primary me-2"></i> Trận đấu cần theo dõi
            </h5>
            <a href="/DieuHanhMon/LichThiDau@(selectedAssignmentQuery)" class="btn btn-sm btn-outline-primary">
                Xem toàn bộ lịch <i class="fa-solid fa-arrow-right ms-1"></i>
            </a>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small text-uppercase">
                    <tr>
                        <th style="width: 70px;">Trận</th>
                        <th>Môn</th>
                        <th>Tên Trận</th>
                        <th>Thời Gian</th>
                        <th>Trọng Tài Chính</th>
                        <th>Trạng Thái</th>
                        <th class="text-end">Chi Tiết</th>
                    </tr>
                </thead>
                <tbody id="recentMatchesBody">
                    <!-- Dynamic rendering qua AJAX -->
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            loadDashboardData();
        });

        async function loadDashboardData() {
            const loadingEl = document.getElementById('dashboardLoading');
            const alertEl = document.getElementById('dashboardAlert');
            const alertMsgEl = document.getElementById('dashboardAlertMsg');
            const contentEl = document.getElementById('dashboardContent');

            try {
                const params = new URLSearchParams(window.location.search);
                const queryStr = params.toString() ? ('?' + params.toString()) : '';
                const response = await fetch('/DieuHanhMon/Home/GetDashboardData' + queryStr);
                if (!response.ok) throw new Error('Không tải được dữ liệu tổng quan.');
                const result = await response.json();

                loadingEl.classList.add('d-none');

                if (!result.success || !result.data) {
                    alertMsgEl.textContent = result.message || 'Không có môn thể thao nào đang được điều hành.';
                    alertEl.classList.remove('d-none');
                    contentEl.classList.add('d-none');
                    return;
                }

                alertEl.classList.add('d-none');
                contentEl.classList.remove('d-none');

                const d = result.data;
                const a = d.assignment || {};

                // Cập nhật Banner
                document.getElementById('bannerMaDanhMuc').textContent = a.maDanhMuc || 'DM';
                document.getElementById('bannerTenDanhMuc').textContent = a.tenDanhMuc || 'Môn Thể Thao';
                document.getElementById('bannerTenGiaiDau').textContent = a.tenGiaiDau || '--';

                // Cập nhật các chỉ số KPI
                document.getElementById('statTotalSports').textContent = d.totalSports || 0;
                document.getElementById('statTotalEvents').textContent = d.totalEvents || 0;
                document.getElementById('statTotalMatches').textContent = d.totalMatches || 0;
                document.getElementById('statCompletedMatches').textContent = d.completedMatches || 0;
                document.getElementById('statTotalReferees').textContent = d.totalReferees || 0;
                document.getElementById('statOngoingMatches').textContent = d.ongoingMatches || 0;
                document.getElementById('statUpcomingMatches').textContent = d.upcomingMatches || 0;

                const totalMatches = Number(d.totalMatches) || 0;
                const completedMatches = Number(d.completedMatches) || 0;
                const progressPercent = totalMatches ? Math.min(100, Math.round(completedMatches * 100 / totalMatches)) : 0;
                const progressBar = document.getElementById('overallProgressBar');
                progressBar.style.width = progressPercent + '%';
                progressBar.parentElement.setAttribute('aria-valuenow', progressPercent);
                document.getElementById('overallProgressPercent').textContent = progressPercent + '%';
                document.getElementById('overallProgressLabel').textContent = `${completedMatches} / ${totalMatches} trận đã hoàn thành`;

                // Render danh sách trận đấu gần đây
                const tbody = document.getElementById('recentMatchesBody');
                tbody.replaceChildren();

                if (!d.recentMatches || d.recentMatches.length === 0) {
                    const row = document.createElement('tr');
                    const cell = document.createElement('td');
                    cell.colSpan = 7;
                    cell.className = 'dh-empty-state';
                    const icon = document.createElement('i');
                    icon.className = 'fa-regular fa-calendar-xmark';
                    const message = document.createElement('span');
                    message.textContent = 'Chưa có trận đấu nào được lên lịch thi đấu.';
                    cell.append(icon, message);
                    row.append(cell);
                    tbody.append(row);
                    return;
                }

                d.recentMatches.forEach(m => {
                    let statusText = 'Chưa đấu';
                    let statusClass = 'badge bg-light text-secondary border px-2 py-1';
                    if (m.trangThai === 'KetThuc' || m.trangThai === 'DaDau') {
                        statusText = 'Đã kết thúc';
                        statusClass = 'badge bg-success bg-opacity-10 text-success fw-semibold px-2 py-1';
                    } else if (m.trangThai === 'DangDau') {
                        statusText = 'Đang thi đấu';
                        statusClass = 'badge bg-primary text-white fw-bold px-2 py-1';
                    }

                    let timeText = 'Chưa xếp giờ';
                    if (m.thoiGianDuKien) {
                        const dt = new Date(m.thoiGianDuKien);
                        timeText = `${dt.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })} · ${dt.toLocaleDateString('vi-VN')}`;
                    }

                    const row = document.createElement('tr');
                    const matchNumber = document.createElement('td');
                    matchNumber.className = 'fw-bold text-center';
                    matchNumber.textContent = '#' + (m.soTran || '');
                    row.append(matchNumber);

                    const sportCell = document.createElement('td');
                    const sportBadge = document.createElement('span');
                    sportBadge.className = 'badge bg-light text-dark border fw-semibold px-2 py-1';
                    sportBadge.textContent = m.tenMon || 'Môn';
                    sportCell.append(sportBadge);
                    row.append(sportCell);

                    const nameCell = document.createElement('td');
                    nameCell.className = 'fw-semibold text-dark';
                    nameCell.textContent = m.tenTran || 'Trận đấu';
                    row.append(nameCell);

                    const timeCell = document.createElement('td');
                    timeCell.className = m.thoiGianDuKien ? 'small text-dark' : 'small text-muted';
                    timeCell.textContent = timeText;
                    row.append(timeCell);

                    const refereeCell = document.createElement('td');
                    const refereeBadge = document.createElement('span');
                    refereeBadge.className = 'badge bg-primary bg-opacity-10 text-primary px-2 py-1';
                    refereeBadge.textContent = m.trongTaiChinh || 'Chưa gán';
                    refereeCell.append(refereeBadge);
                    row.append(refereeCell);

                    const statusCell = document.createElement('td');
                    const statusBadge = document.createElement('span');
                    statusBadge.className = statusClass;
                    statusBadge.textContent = statusText;
                    statusCell.append(statusBadge);
                    row.append(statusCell);

                    const actionCell = document.createElement('td');
                    actionCell.className = 'text-end';
                    const resultLink = document.createElement('a');
                    resultLink.href = '/DieuHanhMon/KetQua' + '@Html.Raw(selectedAssignmentQuery)';
                    resultLink.className = 'btn btn-sm btn-outline-primary';
                    resultLink.textContent = 'Xem kết quả';
                    actionCell.append(resultLink);
                    row.append(actionCell);
                    tbody.append(row);
                });

            } catch (err) {
                console.error('Lỗi khi tải dữ liệu Dashboard qua AJAX:', err);
                loadingEl.classList.add('d-none');
                alertMsgEl.textContent = 'Đã có lỗi xảy ra khi kết nối máy chủ để tải dữ liệu.';
                alertEl.classList.remove('d-none');
            }
        }
    </script>
}
