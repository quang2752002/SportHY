@model Dms.Application.DTOs.ThuKyBienBanDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Biên Bản Trận @Model.SoTran - @Model.TenMonTheThao</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            font-family: 'Times New Roman', Times, serif;
            font-size: 13pt;
            color: #000;
            background: #fff;
            padding: 20px;
        }
        .text-header { font-size: 11pt; font-weight: bold; }
        .title { font-size: 16pt; font-weight: bold; text-align: center; }
        .score-box { font-size: 28pt; font-weight: bold; }
        table, th, td { border-color: #000 !important; }
        @@media print {
            .no-print { display: none !important; }
            body { padding: 0; }
        }
    </style>
</head>
<body onload="window.print()">
    <div class="no-print mb-3 text-center">
        <button class="btn btn-primary" onclick="window.print()">In Biên Bản</button>
        <button class="btn btn-secondary" onclick="window.close()">Đóng</button>
    </div>

    <!-- Quốc hiệu -->
    <div class="row text-center mb-4">
        <div class="col-6">
            <div class="text-header text-uppercase">BAN TỔ CHỨC GIẢI THỂ THAO</div>
            <div class="text-header text-uppercase">@(Model.TenGiaiDau ?? "GIẢI ĐẤU")</div>
            <div>TỔ THƯ KÝ - BAN TRỌNG TÀI</div>
        </div>
        <div class="col-6">
            <div class="text-header">CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</div>
            <div class="fw-bold">Độc lập - Tự do - Hạnh phúc</div>
            <div>---o0o---</div>
        </div>
    </div>

    <!-- Tiêu đề -->
    <div class="title text-uppercase mb-2">BIÊN BẢN THI ĐẤU CHÍNH THỨC</div>
    <div class="text-center mb-4 fst-italic">
        Trận số: <strong>#@Model.SoTran</strong> | Môn: <strong>@Model.TenMonTheThao</strong> | Sân: <strong>@(Model.TenSanDau ?? "Sân thi đấu")</strong>
    </div>

    <!-- Tỉ số chung cuộc -->
    <div class="row border p-3 text-center mb-4">
        <div class="col-5">
            <div class="fw-bold fs-5">@Model.TenDoi1</div>
            <div>Đơn vị: @(Model.DonViDoi1 ?? "Tự do")</div>
            <div class="score-box text-primary mt-2">@Model.Score1</div>
        </div>
        <div class="col-2 d-flex align-items-center justify-content-center">
            <span class="fs-3 fw-bold">VS</span>
        </div>
        <div class="col-5">
            <div class="fw-bold fs-5">@Model.TenDoi2</div>
            <div>Đơn vị: @(Model.DonViDoi2 ?? "Tự do")</div>
            <div class="score-box text-primary mt-2">@Model.Score2</div>
        </div>
    </div>

    <!-- Điểm từng hiệp -->
    <div class="mb-4">
        <h6 class="fw-bold">1. ĐIỂM SỐ CHI TIẾT CÁC HIỆP / SET</h6>
        <table class="table table-bordered text-center">
            <thead>
                <tr>
                    <th>Hiệp đấu</th>
                    <th>@Model.TenDoi1</th>
                    <th>@Model.TenDoi2</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.SetScores != null && Model.SetScores.Count > 0)
                {
                    foreach (var s in Model.SetScores)
                    {
                        <tr>
                            <td>Hiệp @s.SetNumber</td>
                            <td>@s.Score1</td>
                            <td>@s.Score2</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3">Không ghi nhận điểm hiệp riêng biệt</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Chữ ký 4 bên -->
    <div class="mt-5 pt-3">
        <div class="row text-center">
            <div class="col-3">
                <div class="fw-bold">ĐẠI DIỆN ĐỘI 1</div>
                <div class="fst-italic small mb-5">(Ký và ghi rõ họ tên)</div>
                <div class="fw-bold">@(Model.Signatures != null && Model.Signatures.ContainsKey("team1") ? Model.Signatures["team1"].SignerName : "")</div>
            </div>
            <div class="col-3">
                <div class="fw-bold">ĐẠI DIỆN ĐỘI 2</div>
                <div class="fst-italic small mb-5">(Ký và ghi rõ họ tên)</div>
                <div class="fw-bold">@(Model.Signatures != null && Model.Signatures.ContainsKey("team2") ? Model.Signatures["team2"].SignerName : "")</div>
            </div>
            <div class="col-3">
                <div class="fw-bold">TRỌNG TÀI CHÍNH</div>
                <div class="fst-italic small mb-5">(Ký và ghi rõ họ tên)</div>
                <div class="fw-bold">@(Model.Signatures != null && Model.Signatures.ContainsKey("referee") ? Model.Signatures["referee"].SignerName : "")</div>
            </div>
            <div class="col-3">
                <div class="fw-bold">THƯ KÝ GIẢI</div>
                <div class="fst-italic small mb-5">(Ký và ghi rõ họ tên)</div>
                <div class="fw-bold">@(Model.Signatures != null && Model.Signatures.ContainsKey("secretary") ? Model.Signatures["secretary"].SignerName : "")</div>
            </div>
        </div>
    </div>
</body>
</html>
