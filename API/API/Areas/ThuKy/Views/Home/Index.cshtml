@{
    ViewData["Title"] = "Dashboard Thư Ký Giải Đấu";
}

<!-- Loading State -->
<div id="dashboardLoading" class="text-center py-5">
    <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
        <span class="visually-hidden">Đang tải dữ liệu...</span>
    </div>
    <p class="text-muted mt-3 fw-semibold">Đang tổng hợp dữ liệu hồ sơ giải đấu...</p>
</div>

<!-- Main Content (Rendered via AJAX) -->
<div id="dashboardContent" class="d-none">
    <!-- Hero Banner -->
    <div class="card card-custom border-0 mb-4 text-white overflow-hidden position-relative" style="background: linear-gradient(135deg, #091326 0%, #1e3a8a 100%);">
        <div class="card-body p-4 position-relative" style="z-index: 2;">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-primary px-3 py-1 rounded-pill fw-bold">BAN THƯ KÝ GIẢI ĐẤU</span>
                        <span class="badge bg-info bg-opacity-20 text-info px-3 py-1 rounded-pill">GIÁM SÁT KẾT QUẢ & BIÊN BẢN</span>
                    </div>
                    <h2 id="bannerTenGiaiDau" class="fw-bold mb-1 text-white">Giải Đấu Thể Thao</h2>
                    <p class="mb-0 text-white-50 small">
                        <i class="fa-solid fa-clock me-1 text-warning"></i> Cập nhật dữ liệu thời gian thực theo biên bản điện tử chính thức
                    </p>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a href="/ThuKy/KetQua" class="btn btn-warning fw-bold px-3 py-2 shadow-sm text-dark">
                        <i class="fa-solid fa-square-check me-1"></i> Kiểm Tra Kết Quả (<span id="btnBadgeChoDuyet">0</span>)
                    </a>
                    <a href="/ThuKy/BaoCao" class="btn btn-light fw-bold px-3 py-2 shadow-sm text-primary">
                        <i class="fa-solid fa-file-excel me-1"></i> Báo Cáo & Excel
                    </a>
                </div>
            </div>
        </div>
        <div class="position-absolute end-0 bottom-0 opacity-10" style="font-size: 14rem; line-height: 0.8; margin-right: -2rem; margin-bottom: -3rem;">
            <i class="fa-solid fa-clipboard-list"></i>
        </div>
    </div>

    <!-- 4 KPI Cards -->
    <div class="row g-3 mb-4">
        <!-- KPI 1: Tổng Môn & Nội Dung -->
        <div class="col-sm-6 col-xl-3">
            <div class="card card-custom p-3.5 h-100 border-start border-4 border-primary">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Môn & Nội Dung</span>
                        <h3 class="fw-bold mt-1 mb-0 text-primary">
                            <span id="statTotalSports">0</span> <span class="fs-6 fw-normal text-muted">môn /</span> <span id="statTotalEvents">0</span> <span class="fs-6 fw-normal text-muted">nội dung</span>
                        </h3>
                        <small class="text-muted"><a href="/ThuKy/NoiDung" class="text-decoration-none">Xem toàn bộ nội dung &rarr;</a></small>
                    </div>
                    <div class="rounded-3 bg-primary bg-opacity-10 p-3 text-primary fs-3">
                        <i class="fa-solid fa-layer-group"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- KPI 2: Trận Đấu & Tiến Độ -->
        <div class="col-sm-6 col-xl-3">
            <div class="card card-custom p-3.5 h-100 border-start border-4 border-success">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Tiến Độ Giải Đấu</span>
                        <h3 class="fw-bold mt-1 mb-0 text-success">
                            <span id="statTiLeHoanThanh">0</span>%
                        </h3>
                        <small class="text-muted">
                            <strong id="statCompletedMatches">0</strong>/<span id="statTotalMatches">0</span> trận hoàn thành
                        </small>
                    </div>
                    <div class="rounded-3 bg-success bg-opacity-10 p-3 text-success fs-3">
                        <i class="fa-solid fa-bars-progress"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- KPI 3: Xác Nhận Kết Quả -->
        <div class="col-sm-6 col-xl-3">
            <div class="card card-custom p-3.5 h-100 border-start border-4 border-warning">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Chờ Duyệt Kết Quả</span>
                        <h3 class="fw-bold mt-1 mb-0 text-warning">
                            <span id="statChoDuyet">0</span> <span class="fs-6 fw-normal text-muted">trận</span>
                        </h3>
                        <small class="text-danger fw-semibold" id="statCanKiemTraWrap">
                            <i class="fa-solid fa-triangle-exclamation me-1"></i> <span id="statCanKiemTra">0</span> có khiếu nại/cần rà soát
                        </small>
                    </div>
                    <div class="rounded-3 bg-warning bg-opacity-10 p-3 text-warning fs-3">
                        <i class="fa-solid fa-square-check"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- KPI 4: Biên Bản & Huy Chương -->
        <div class="col-sm-6 col-xl-3">
            <div class="card card-custom p-3.5 h-100 border-start border-4 border-info">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Biên Bản & Huy Chương</span>
                        <h3 class="fw-bold mt-1 mb-0 text-info">
                            <span id="statBienBanDu">0</span>/<span id="statTotalBienBan">0</span> <span class="fs-6 fw-normal text-muted">biên bản đủ</span>
                        </h3>
                        <small class="text-muted">
                            <i class="fa-solid fa-medal text-warning me-1"></i> <span id="statHuyChuong">0</span> huy chương đã trao
                        </small>
                    </div>
                    <div class="rounded-3 bg-info bg-opacity-10 p-3 text-info fs-3">
                        <i class="fa-solid fa-file-signature"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Alert Queue: Trận đấu cần xử lý gấp -->
    <div id="alertQueueSection" class="card card-custom border-warning border-2 mb-4 d-none">
        <div class="card-header bg-warning bg-opacity-10 py-3 d-flex justify-content-between align-items-center border-bottom-0">
            <div class="fw-bold text-dark d-flex align-items-center gap-2">
                <i class="fa-solid fa-bell text-warning fs-5"></i>
                <span>HÀNG ĐỢI KIỂM TRA & DUYỆT KẾT QUẢ KHẨN CẤP</span>
                <span id="badgeAlertCount" class="badge bg-danger rounded-pill">0</span>
            </div>
            <a href="/ThuKy/KetQua" class="btn btn-sm btn-outline-dark rounded-pill">Xem tất cả kết quả &rarr;</a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-muted">
                        <tr>
                            <th class="ps-3">Trận</th>
                            <th>Môn thi</th>
                            <th>Hai Đội / VĐV</th>
                            <th>Tỉ số</th>
                            <th>Trạng thái biên bản</th>
                            <th>Trạng thái xác nhận</th>
                            <th class="text-end pe-3">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="alertTableBody"></tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- 2 Cột: Tiến Độ Từng Môn & Top Huy Chương -->
    <div class="row g-4">
        <!-- Cột trái: Tiến độ từng môn -->
        <div class="col-lg-7">
            <div class="card card-custom h-100">
                <div class="card-header bg-transparent py-3 d-flex justify-content-between align-items-center border-bottom">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="fa-solid fa-bars-progress text-primary me-2"></i> Tiến Độ Từng Môn Thể Thao
                    </h6>
                    <a href="/ThuKy/TienDo" class="text-decoration-none small fw-semibold">Chi tiết tất cả môn &rarr;</a>
                </div>
                <div class="card-body p-3">
                    <div id="listTienDoMon" class="d-flex flex-column gap-3"></div>
                </div>
            </div>
        </div>

        <!-- Cột phải: Top 5 Đoàn Huy Chương & Hoạt động -->
        <div class="col-lg-5">
            <div class="card card-custom h-100">
                <div class="card-header bg-transparent py-3 d-flex justify-content-between align-items-center border-bottom">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="fa-solid fa-award text-warning me-2"></i> Top Đoàn Dẫn Đầu Huy Chương
                    </h6>
                    <a href="/ThuKy/BaoCao" class="text-decoration-none small fw-semibold">Bảng tổng sắp đầy đủ &rarr;</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light small text-muted">
                                <tr>
                                    <th class="ps-3">Hạng</th>
                                    <th>Đoàn / Đơn vị</th>
                                    <th class="text-center text-warning" title="Vàng"><i class="fa-solid fa-medal"></i></th>
                                    <th class="text-center text-secondary" title="Bạc"><i class="fa-solid fa-medal"></i></th>
                                    <th class="text-center text-danger" title="Đồng"><i class="fa-solid fa-medal"></i></th>
                                    <th class="text-end pe-3">Tổng</th>
                                </tr>
                            </thead>
                            <tbody id="topMedalBody"></tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-light border-0 py-3 text-center">
                    <a href="/ThuKy/BaoCao?tab=huychuong" class="btn btn-sm btn-primary rounded-pill px-3">
                        <i class="fa-solid fa-file-excel me-1"></i> Xuất Bảng Tổng Sắp Excel
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            loadDashboard();
        });

        function loadDashboard() {
            var gId = $('#headerSelectGiaiDau').val();
            $.ajax({
                url: '/ThuKy/Home/GetDashboardData',
                type: 'GET',
                data: { giaiDauId: gId },
                success: function (res) {
                    $('#dashboardLoading').addClass('d-none');
                    if (!res.success || !res.data) {
                        Swal.fire('Thông báo', res.message || 'Không thể tải dữ liệu.', 'info');
                        return;
                    }
                    renderDashboard(res.data);
                },
                error: function () {
                    $('#dashboardLoading').addClass('d-none');
                    Swal.fire('Lỗi', 'Không thể kết nối máy chủ để lấy dữ liệu.', 'error');
                }
            });
        }

        function renderDashboard(data) {
            $('#dashboardContent').removeClass('d-none');
            $('#bannerTenGiaiDau').text(data.tenGiaiDau);

            $('#statTotalSports').text(data.tongSoMon);
            $('#statTotalEvents').text(data.tongSoNoiDung);
            $('#statTotalMatches').text(data.tongSoTranDau);
            $('#statCompletedMatches').text(data.soTranDaHoanThanh);
            $('#statTiLeHoanThanh').text(data.tiLeHoanThanh);

            $('#statChoDuyet').text(data.soKetQuaChoDuyet);
            $('#btnBadgeChoDuyet').text(data.soKetQuaChoDuyet);
            $('#statCanKiemTra').text(data.soKetQuaCanKiemTra);

            $('#statTotalBienBan').text(data.tongSoBienBan);
            $('#statBienBanDu').text(data.soBienBanDuChuKy);
            $('#statHuyChuong').text(data.tongSoHuyChuongDaTrao);

            // Render Alert Queue
            if (data.canhBaoCanXuLy && data.canhBaoCanXuLy.length > 0) {
                $('#alertQueueSection').removeClass('d-none');
                $('#badgeAlertCount').text(data.canhBaoCanXuLy.length);
                var alertHtml = '';
                data.canhBaoCanXuLy.forEach(function (m) {
                    var statusBadge = m.trangThaiXacNhan === 'CanKiemTraLai' 
                        ? '<span class="badge bg-danger">Có khiếu nại / Cần kiểm tra</span>'
                        : '<span class="badge bg-warning text-dark">Chờ Thư ký duyệt</span>';
                    
                    var sheetBadge = m.isScoresheetComplete 
                        ? '<span class="badge bg-success bg-opacity-10 text-success"><i class="fa-solid fa-check me-1"></i> Đủ chữ ký</span>'
                        : '<span class="badge bg-danger bg-opacity-10 text-danger"><i class="fa-solid fa-triangle-exclamation me-1"></i> Thiếu chữ ký</span>';

                    alertHtml += `
                        <tr>
                            <td class="ps-3 fw-bold text-primary">#${m.soTran}</td>
                            <td><span class="badge bg-light text-dark border">${m.tenMonTheThao}</span></td>
                            <td>
                                <div class="fw-semibold text-truncate" style="max-width: 220px;">${m.tenDoi1} vs ${m.tenDoi2}</div>
                            </td>
                            <td><span class="badge bg-primary fs-6 px-2.5 py-1">${m.tySoDoi1} - ${m.tySoDoi2}</span></td>
                            <td>${sheetBadge}</td>
                            <td>${statusBadge}</td>
                            <td class="text-end pe-3">
                                <a href="/ThuKy/BienBan?tranDauId=${m.tranDauId}" class="btn btn-xs btn-outline-primary rounded-pill px-2.5 py-1 me-1">
                                    <i class="fa-solid fa-file-signature"></i> Xem biên bản
                                </a>
                                <button type="button" class="btn btn-xs btn-success rounded-pill px-2.5 py-1" onclick="quickApprove(${m.tranDauId})">
                                    <i class="fa-solid fa-check"></i> Duyệt
                                </button>
                            </td>
                        </tr>
                    `;
                });
                $('#alertTableBody').html(alertHtml);
            } else {
                $('#alertQueueSection').addClass('d-none');
            }

            // Render Tiến Độ Môn
            var tdHtml = '';
            if (data.tienDoCacMon && data.tienDoCacMon.length > 0) {
                data.tienDoCacMon.slice(0, 6).forEach(function (mon) {
                    var barColor = mon.tiLeHoanThanh >= 100 ? 'bg-success' : (mon.tiLeHoanThanh >= 50 ? 'bg-primary' : 'bg-info');
                    tdHtml += `
                        <div class="p-2.5 rounded-3 border bg-light bg-opacity-50">
                            <div class="d-flex justify-content-between align-items-center mb-1.5">
                                <div class="fw-bold text-dark d-flex align-items-center gap-2">
                                    <i class="fa-solid ${mon.iconMon || 'fa-volleyball'} text-primary"></i>
                                    <span>${mon.tenMon}</span>
                                    <span class="badge bg-light text-muted border">${mon.tongSoNoiDung} nội dung</span>
                                </div>
                                <div class="text-end">
                                    <span class="fw-bold text-primary">${mon.tiLeHoanThanh}%</span>
                                    <small class="text-muted">(${mon.soTranDaHoanThanh}/${mon.tongSoTran} trận)</small>
                                </div>
                            </div>
                            <div class="progress" style="height: 7px;">
                                <div class="progress-bar ${barColor}" role="progressbar" style="width: ${mon.tiLeHoanThanh}%;" aria-valuenow="${mon.tiLeHoanThanh}" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                    `;
                });
            } else {
                tdHtml = '<div class="text-muted text-center py-4">Chưa có dữ liệu tiến độ môn thể thao.</div>';
            }
            $('#listTienDoMon').html(tdHtml);

            // Render Top Huy Chương
            var medalHtml = '';
            if (data.topHuyChuong && data.topHuyChuong.length > 0) {
                data.topHuyChuong.forEach(function (d) {
                    var rankBadge = d.xepHang === 1 ? '<span class="badge bg-warning text-dark px-2">1</span>' :
                                    d.xepHang === 2 ? '<span class="badge bg-secondary text-white px-2">2</span>' :
                                    d.xepHang === 3 ? '<span class="badge bg-danger px-2">3</span>' : `<span class="badge bg-light text-muted border px-2">${d.xepHang}</span>`;
                    medalHtml += `
                        <tr>
                            <td class="ps-3">${rankBadge}</td>
                            <td class="fw-semibold text-truncate" style="max-width: 150px;">${d.tenDonVi}</td>
                            <td class="text-center fw-bold text-warning">${d.soHuyChuongVang}</td>
                            <td class="text-center fw-bold text-secondary">${d.soHuyChuongBac}</td>
                            <td class="text-center fw-bold text-danger">${d.soHuyChuongDong}</td>
                            <td class="text-end pe-3 fw-bold text-dark">${d.tongSoHuyChuong}</td>
                        </tr>
                    `;
                });
            } else {
                medalHtml = '<tr><td colspan="6" class="text-center text-muted py-3">Chưa có kết quả huy chương.</td></tr>';
            }
            $('#topMedalBody').html(medalHtml);
        }

        function quickApprove(tranDauId) {
            Swal.fire({
                title: 'Xác nhận kết quả?',
                text: 'Bạn với vai trò Thư ký giải sẽ phê duyệt kết quả chính thức cho trận đấu này.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Đồng ý duyệt',
                cancelButtonText: 'Hủy'
            }).then((res) => {
                if (res.isConfirmed) {
                    $.ajax({
                        url: '/ThuKy/KetQua/XacNhan',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({ tranDauId: tranDauId, ghiChu: 'Duyệt nhanh từ Dashboard Thư ký' }),
                        success: function (r) {
                            if (r.success) {
                                Toast.fire({ icon: 'success', title: r.message });
                                loadDashboard();
                            } else {
                                Swal.fire('Lỗi', r.message, 'error');
                            }
                        }
                    });
                }
            });
        }
    </script>
}
