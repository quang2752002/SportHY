@model TranDauDto?
@{
    ViewData["Title"] = "Biên Bản Trận Đấu Chính Thức";
    var tournaments = ViewBag.Tournaments as List<GiaiDauDto> ?? new();
    var matches = ViewBag.Matches as List<TranDauDto> ?? new();
    int? selectedGiaiDauId = ViewBag.SelectedGiaiDauId as int?;
    var regTeam1 = ViewBag.RegTeam1 as DangKyThiDauDto;
    var regTeam2 = ViewBag.RegTeam2 as DangKyThiDauDto;
    int score1 = ViewBag.Score1 is int s1 ? s1 : 0;
    int score2 = ViewBag.Score2 is int s2 ? s2 : 0;
    int? extraTimeScore1 = ViewBag.ExtraTimeScore1 as int?;
    int? extraTimeScore2 = ViewBag.ExtraTimeScore2 as int?;
    string winner = ViewBag.Winner as string ?? "";
    string notes = ViewBag.Notes as string ?? "";
    var setScores = ViewBag.SetScores as List<SetScoreDto> ?? new();
    var events = ViewBag.Events as List<MatchEventItemDto> ?? new();
    var signatures = ViewBag.Signatures as Dictionary<string, SignatureInfoDto> ?? new();
    bool canCreateReport = ViewBag.CanCreateReport == true;
    var tournamentName = ViewBag.SelectedTournamentName as string;
    if (string.IsNullOrWhiteSpace(tournamentName)) tournamentName = Model?.TenGiaiDau;
    if (string.IsNullOrWhiteSpace(tournamentName)) tournamentName = "Chưa cập nhật tên giải";

    var matchFormat = ViewBag.MatchFormat as CauHinhTheThucDto;
    var heatResults = ViewBag.HeatResults as List<HeatParticipantResultDto> ?? new();
    bool isPerformanceMatch = (matchFormat?.IsPerformanceSport == true) || (heatResults.Count > 0);
}

<style>
    .official-report {
        --report-navy: #173b68;
        --report-blue: #2563a8;
        --report-line: #d9e5f2;
        width: 100%;
        max-width: 1120px;
        margin-right: auto !important;
        margin-left: auto !important;
        border: 1px solid var(--report-line) !important;
        border-radius: 16px;
        box-shadow: 0 12px 32px rgba(23, 59, 104, .09) !important;
        color: #24364b;
    }

    .official-report .report-masthead {
        border-bottom: 2px solid var(--report-blue) !important;
        padding-bottom: 1rem;
    }

    .official-report .report-title-block {
        background: linear-gradient(135deg, #f1f7ff, #fff 75%);
        border: 1px solid #dbe8f7;
        border-left: 5px solid var(--report-blue);
        border-radius: 12px;
        padding: 1rem;
    }

    .official-report .report-document-title {
        color: var(--report-navy) !important;
        letter-spacing: .035em;
    }

    .official-report .report-tournament-name {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        margin-top: .65rem;
        padding: .45rem .85rem;
        color: var(--report-navy);
        background: #e5f0ff;
        border: 1px solid #c7dcf7;
        border-radius: 999px;
        font-weight: 700;
    }

    .official-report .report-section-title {
        color: var(--report-navy) !important;
        border-bottom: 1px solid var(--report-line) !important;
        padding-bottom: .55rem !important;
        margin-bottom: .8rem;
        letter-spacing: .025em;
    }

    .official-report .report-info-grid {
        row-gap: .75rem !important;
    }

    .official-report .report-info-item {
        height: 100%;
        padding: .65rem .75rem;
        background: #f7faff;
        border: 1px solid #e4edf7;
        border-radius: 9px;
    }

    .official-report .report-info-item strong {
        display: block;
        margin-top: .15rem;
        color: #1e334e !important;
    }

    .official-report .report-team-card {
        height: 100%;
        background: #f8fbff !important;
        border: 1px solid #dce7f3 !important;
        border-radius: 12px !important;
    }

    .official-report .report-scoreboard {
        background: linear-gradient(135deg, #f2f7ff, #fff) !important;
        border: 1px solid #cfdef0 !important;
        border-radius: 14px !important;
    }

    .official-report .report-scoreboard {
        break-inside: avoid !important;
        page-break-inside: avoid !important;
    }

    .official-report .report-scoreboard-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 140px minmax(0, 1fr);
        align-items: center;
        gap: .75rem;
    }

    .official-report .report-score-team {
        min-width: 0;
        overflow-wrap: anywhere;
    }

    .official-report .report-score-summary {
        min-width: 0;
    }

    .official-report .report-score {
        color: var(--report-navy) !important;
        display: block;
        font-size: 2.15rem;
        letter-spacing: .04em;
        white-space: nowrap;
    }

    .official-report .report-signature-card {
        min-height: 130px;
        padding: .85rem .5rem;
        border: 1px solid #e2eaf3;
        border-radius: 10px;
        background: #fbfdff;
    }

    .official-report .table thead th {
        color: var(--report-navy);
        background: #edf4fc;
    }

    .report-page-toolbar {
        width: 100%;
        max-width: 1120px;
        margin-right: auto;
        margin-left: auto;
    }

    .report-page-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: flex-end;
        gap: .65rem;
    }

    .report-document-action {
        display: inline-flex;
        min-height: 44px;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        padding: .65rem 1.1rem !important;
        border-radius: 12px !important;
        font-weight: 650;
        text-decoration: none;
        transition: transform .16s ease, box-shadow .16s ease, background-color .16s ease;
    }

    .report-document-action:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 14px rgba(23, 59, 104, .14);
    }

    .report-edit-action {
        color: #244b78 !important;
        border: 1px solid #c9d8e9 !important;
        background: #fff !important;
    }

    .report-edit-action:hover {
        color: #173b68 !important;
        background: #f2f7fd !important;
    }

    .report-print-action {
        color: #fff !important;
        border: 1px solid #245a9d !important;
        background: linear-gradient(135deg, #3978c2, #245a9d) !important;
        box-shadow: 0 4px 10px rgba(37, 99, 168, .2);
    }

    .report-print-action:hover {
        background: linear-gradient(135deg, #2f6caf, #1d4d89) !important;
    }

    @@media (max-width: 767.98px) {
        .official-report { padding: 1rem !important; }
        .official-report .report-score { font-size: 1.8rem; }
        .official-report .report-scoreboard-grid { grid-template-columns: minmax(0, 1fr) 112px minmax(0, 1fr); gap: .35rem; }
        .report-page-toolbar { align-items: stretch !important; }
        .report-page-actions { justify-content: center; }
        .report-document-action { flex: 1 1 auto; }
    }

    @@media print {
        .official-report {
            max-width: none;
            border: 0 !important;
            border-radius: 0;
            box-shadow: none !important;
            padding: 0 !important;
        }
        .official-report .report-title-block,
        .official-report .report-info-item,
        .official-report .report-team-card,
        .official-report .report-scoreboard,
        .official-report .report-signature-card {
            print-color-adjust: exact;
            -webkit-print-color-adjust: exact;
        }
    }
</style>

<div class="d-flex flex-column gap-4">
    @if (Model != null && !canCreateReport)
    {
        <div class="alert alert-info mb-0 d-print-none" role="status">
            <i class="fa-solid fa-eye me-1"></i> Bạn được phân công với vai trò trọng tài phụ. Bạn có thể xem và xuất PDF biên bản nhưng không thể ký hoặc chỉnh sửa.
        </div>
    }
    @if (ViewBag.EmbeddedReport != true)
    {
    <!-- Header & Print Actions (Hidden on Print) -->
    <div class="report-page-toolbar d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 d-print-none">
        <div>
            <h4 class="fw-bold text-dark mb-1">
                <i class="fa-solid fa-file-signature text-primary me-2"></i> Biên Bản Trận Đấu Chính Thức
            </h4>
            <p class="text-muted small mb-0">Hồ sơ biên bản điện tử có chữ ký số xác nhận và định dạng chuẩn in ấn</p>
        </div>
        <div class="report-page-actions">
            @if (Model != null)
            {
                @if (canCreateReport)
                {
                    <a href="/TrongTai/KetQua?tranDauId=@Model.Id&giaiDauId=@selectedGiaiDauId" class="btn report-document-action report-edit-action">
                        <i class="fa-solid fa-pen-to-square"></i><span>Điều chỉnh kết quả</span>
                    </a>
                }
                <button type="button" class="btn report-document-action report-print-action" onclick="window.print()">
                    <i class="fa-solid fa-print"></i><span>In biên bản A4</span>
                </button>
            }
        </div>
    </div>

    <!-- Match Picker (Hidden on Print) -->
    <div class="card-custom p-3 d-print-none">
        <form method="get" action="/TrongTai/BienBan" id="pickerForm">
            <div class="row g-2 align-items-center">
                <div class="col-md-5">
                    <label class="form-label small fw-semibold mb-1">Chọn Giải Đấu</label>
                    <select name="giaiDauId" class="form-select form-select-sm" onchange="this.form.submit()">
                        @if (tournaments.Count == 0)
                        {
                            <option value="">-- Chưa có giải được phân công --</option>
                        }
                        @foreach (var t in tournaments)
                        {
                            if (selectedGiaiDauId == t.Id)
                            {
                                <option value="@t.Id" selected="selected">@t.Ten</option>
                            }
                            else
                            {
                                <option value="@t.Id">@t.Ten</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-7">
                    <label class="form-label small fw-semibold mb-1">Chọn Trận Đấu</label>
                    <select name="tranDauId" class="form-select form-select-sm" onchange="this.form.submit()">
                        @if (matches.Count == 0)
                        {
                            <option value="">@(tournaments.Count == 0 ? "-- Chưa có trận được phân công --" : "-- Giải này chưa có trận đấu được phân công --")</option>
                        }
                        else
                        {
                            @foreach (var m in matches)
                            {
                                if (Model != null && Model.Id == m.Id)
                                {
                                    <option value="@m.Id" selected="selected">Trận @m.SoTran: @(m.TenDoi1 ?? "Đội 1") VS @(m.TenDoi2 ?? "Đội 2") (@m.TenMonTheThao)</option>
                                }
                                else
                                {
                                    <option value="@m.Id">Trận @m.SoTran: @(m.TenDoi1 ?? "Đội 1") VS @(m.TenDoi2 ?? "Đội 2") (@m.TenMonTheThao)</option>
                                }
                            }
                        }
                    </select>
                </div>
            </div>
        </form>
    </div>
    }

    @if (Model == null)
    {
        <div class="card-custom p-5 text-center text-muted">
            <i class="fa-solid fa-file-excel fs-1 mb-3 opacity-25"></i>
            <h5>@(tournaments.Count == 0 ? "Bạn chưa được phân công giải đấu nào" : "Vui lòng chọn một trận đấu để hiển thị biên bản")</h5>
            @if (tournaments.Count == 0)
            {
                <p class="small mb-0">Liên hệ ban tổ chức để được phân công giải và trận đấu.</p>
            }
        </div>
    }
    else
    {
        <!-- Khung Biên Bản Chuẩn Thể Thao (Official Match Sheet) -->
        <div class="card-custom official-report p-4 p-md-5 bg-white print-area" id="officialReportContent" data-match-number="@Model.SoTran" data-sport-name="@Model.TenMonTheThao" data-tournament-name="@tournamentName">
            <!-- Quốc hiệu & Ban tổ chức -->
            <div class="row report-masthead pb-3 mb-4 text-center">
                <div class="col-5">
                    <div class="fw-bold text-uppercase" style="font-size: 13px;">BAN TỔ CHỨC GIẢI ĐẤU</div>
                    <div class="fw-semibold text-muted small text-uppercase">HỘI ĐỒNG TRỌNG TÀI & THƯ KÝ</div>
                </div>
                <div class="col-7">
                    <div class="fw-bold text-uppercase" style="font-size: 13px;">CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</div>
                    <div class="small fw-semibold text-muted">Độc lập - Tự do - Hạnh phúc</div>
                    <div class="text-muted" style="font-size: 11px;">---------------o0o---------------</div>
                </div>
            </div>

            <!-- Tên Biên Bản -->
            <div class="report-title-block text-center my-4">
                <h3 class="report-document-title fw-bold text-uppercase mb-1">BIÊN BẢN THI ĐẤU CHÍNH THỨC</h3>
                <div class="text-muted small">
                    Số biên bản: <span class="fw-bold font-monospace text-dark">BB-TD@(Model.Id)-@DateTime.Now.Year</span>
                </div>
                <div class="report-tournament-name"><i class="fa-solid fa-trophy"></i> @tournamentName</div>
            </div>

            <!-- 1. Thông Tin Chung Trận Đấu -->
            <div class="mb-4">
                <h6 class="report-section-title fw-bold text-uppercase" style="font-size: 13px;">
                    I. THÔNG TIN TRẬN ĐẤU
                </h6>
                <div class="row g-2 small mt-1 report-info-grid">
                    <div class="col-12">
                        <div class="report-info-item"><span class="text-muted">Giải đấu:</span><strong>@tournamentName</strong></div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="report-info-item"><span class="text-muted">Môn thi đấu:</span><strong>@Model.TenMonTheThao</strong></div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="report-info-item"><span class="text-muted">Trận số:</span><strong>Trận @Model.SoTran</strong></div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="report-info-item"><span class="text-muted">Vòng / Bảng:</span><strong>@(Model.TenVongDau ?? "--") @(Model.TenBangDau != null ? $"- {Model.TenBangDau}" : "")</strong></div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="report-info-item"><span class="text-muted">Địa điểm:</span><strong>@(Model.TenSanDau ?? "Chưa xếp sân")</strong></div>
                    </div>
                    <div class="col-6 col-md-6">
                        <div class="report-info-item"><span class="text-muted">Thời gian bắt đầu:</span><strong>@(Model.ThoiGianBatDau?.ToString("HH:mm - dd/MM/yyyy") ?? Model.ThoiGianDuKien?.ToString("HH:mm - dd/MM/yyyy") ?? "--")</strong></div>
                    </div>
                    <div class="col-6 col-md-6">
                        <div class="report-info-item"><span class="text-muted">Thời gian kết thúc:</span><strong>@(Model.ThoiGianKetThuc?.ToString("HH:mm - dd/MM/yyyy") ?? "--")</strong></div>
                    </div>
                </div>
            </div>

            <!-- 2. Tổ Trọng Tài Điều Hành -->
            <div class="mb-4">
                <h6 class="report-section-title fw-bold text-uppercase" style="font-size: 13px;">
                    II. TỔ TRỌNG TÀI & ĐIỀU HÀNH THI ĐẤU
                </h6>
                <div class="row g-2 small mt-1">
                    @if (Model.DanhSachTrongTai != null && Model.DanhSachTrongTai.Count > 0)
                    {
                        @foreach (var tt in Model.DanhSachTrongTai)
                        {
                            <div class="col-md-6">
                                <span class="text-muted">@(tt.VaiTro ?? "Trọng tài"):</span> <strong class="text-dark">@tt.TenTrongTai</strong> (@(tt.CapBac ?? "Quốc gia"))
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-12 text-muted fst-italic">Chưa có thông tin phân công tổ trọng tài.</div>
                    }
                </div>
            </div>

            <!-- 3. Thành Phần Thi Đấu -->
            <div class="mb-4">
                <h6 class="report-section-title fw-bold text-uppercase" style="font-size: 13px;">
                    III. THÀNH PHẦN THI ĐẤU
                </h6>
                @if (isPerformanceMatch && Model.ThanhPhanTranDaus != null && Model.ThanhPhanTranDaus.Count > 0)
                {
                    <div class="p-3 border rounded-2 bg-light">
                        <div class="small fw-semibold text-secondary mb-2">Danh sách vận động viên tham gia lượt thi (@Model.ThanhPhanTranDaus.Count VĐV):</div>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered bg-white mb-0 text-center align-middle">
                                <thead class="table-light small">
                                    <tr>
                                        <th style="width: 90px;">@(matchFormat?.HinhThucXuatPhat == "DongLoat" ? "Số BIB" : "Làn/STT")</th>
                                        <th class="text-start">Họ và Tên VĐV</th>
                                        <th class="text-start">Đoàn / Đơn Vị</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.ThanhPhanTranDaus.Count; i++)
                                    {
                                        var tp = Model.ThanhPhanTranDaus[i];
                                        <tr>
                                            <td class="font-monospace fw-bold">@(tp.SoDeoBIB ?? (tp.SoLane.HasValue ? $"Làn {tp.SoLane}" : $"{i + 1}"))</td>
                                            <td class="text-start fw-semibold">@(tp.TenDangKy ?? tp.TenDoi ?? $"VĐV {tp.DangKyThiDauId}")</td>
                                            <td class="text-start text-muted">@(tp.TenDonVi ?? "--")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                else
                {
                    <div class="row g-3 mt-1">
                        <!-- Đội 1 -->
                        <div class="col-md-6">
                            <div class="report-team-card p-3 border rounded-2 bg-light">
                                <div class="fw-bold text-dark">ĐỘI 1: @(Model.TenDoi1 ?? "Đội 1")</div>
                                <div class="small text-muted mb-2">Đơn vị: @(Model.DonViDoi1 ?? "--")</div>
                                <div class="small fw-semibold text-secondary">Danh sách vận động viên:</div>
                                <ul class="mb-0 ps-3 small text-dark">
                                    @if (regTeam1 != null && regTeam1.VanDongVienNames.Count > 0)
                                    {
                                        @foreach (var v in regTeam1.VanDongVienNames)
                                        {
                                            <li>@v</li>
                                        }
                                    }
                                    else
                                    {
                                        <li>Vận động viên thi đấu chính thức</li>
                                    }
                                </ul>
                            </div>
                        </div>

                        <!-- Đội 2 -->
                        <div class="col-md-6">
                            <div class="report-team-card p-3 border rounded-2 bg-light">
                                <div class="fw-bold text-dark">ĐỘI 2: @(Model.TenDoi2 ?? "Đội 2")</div>
                                <div class="small text-muted mb-2">Đơn vị: @(Model.DonViDoi2 ?? "--")</div>
                                <div class="small fw-semibold text-secondary">Danh sách vận động viên:</div>
                                <ul class="mb-0 ps-3 small text-dark">
                                    @if (regTeam2 != null && regTeam2.VanDongVienNames.Count > 0)
                                    {
                                        @foreach (var v in regTeam2.VanDongVienNames)
                                        {
                                            <li>@v</li>
                                        }
                                    }
                                    else
                                    {
                                        <li>Vận động viên thi đấu chính thức</li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- 4. Kết Quả Thi Đấu Chung Cuộc -->
            <div class="mb-4 report-score-section">
                <h6 class="report-section-title fw-bold text-uppercase" style="font-size: 13px;">
                    IV. KẾT QUẢ THI ĐẤU
                </h6>
                @if (isPerformanceMatch && heatResults.Count > 0)
                {
                    <div class="table-responsive border rounded-2 p-2 bg-light my-2">
                        <table class="table table-bordered table-hover align-middle text-center mb-0 bg-white">
                            <thead class="table-dark small">
                                <tr>
                                    <th style="width: 100px;">Thứ Hạng</th>
                                    <th style="width: 90px;">@(matchFormat?.HinhThucXuatPhat == "DongLoat" ? "Số BIB" : "Làn/STT")</th>
                                    <th class="text-start">Vận Động Viên</th>
                                    <th class="text-start">Đơn Vị</th>
                                    <th style="width: 180px;">Thành Tích Công Nhận</th>
                                    <th style="width: 140px;">@(matchFormat?.TenTieuChiPhuThanhTich ?? "Chỉ số phụ")</th>
                                    <th style="width: 120px;">Trạng Thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var sortedResults = heatResults.OrderBy(r => r.XepHang ?? int.MaxValue).ThenBy(r => r.SoLane).ToList();
                                }
                                @foreach (var r in sortedResults)
                                {
                                    var tpItem = Model.ThanhPhanTranDaus?.FirstOrDefault(t => t.Id == r.ThanhPhanTranDauId);
                                    <tr>
                                        <td>
                                            @if (r.XepHang == 1)
                                            {
                                                <span class="badge bg-warning text-dark font-monospace fs-6 px-2 py-1">🥇 Hạng 1</span>
                                            }
                                            else if (r.XepHang == 2)
                                            {
                                                <span class="badge bg-secondary text-white font-monospace fs-6 px-2 py-1">🥈 Hạng 2</span>
                                            }
                                            else if (r.XepHang == 3)
                                            {
                                                <span class="badge bg-danger text-white font-monospace fs-6 px-2 py-1">🥉 Hạng 3</span>
                                            }
                                            else if (r.XepHang.HasValue)
                                            {
                                                <span class="badge bg-primary text-white font-monospace">Hạng @r.XepHang</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">--</span>
                                            }
                                        </td>
                                        <td class="font-monospace fw-bold">@(r.SoDeoBIB ?? (r.SoLane > 0 ? $"Làn {r.SoLane}" : "--"))</td>
                                        <td class="text-start fw-bold text-dark">@(tpItem?.TenDangKy ?? tpItem?.TenDoi ?? $"VĐV {r.DangKyThiDauId}")</td>
                                        <td class="text-start text-muted small">@(tpItem?.TenDonVi ?? "--")</td>
                                        <td class="font-monospace fw-bold text-success fs-6">@(r.KetQuaText ?? (r.GiaTri.HasValue ? $"{r.GiaTri.Value:0.00} {matchFormat?.DonViThanhTich}" : r.TrangThai))</td>
                                        <td class="font-monospace text-muted small">@(r.GiaTriPhu?.ToString("0.00") ?? "--")</td>
                                        <td>
                                            @if (r.TrangThai == "ThamGia")
                                            {
                                                <span class="badge bg-success-subtle text-success">Hợp lệ</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger">@r.TrangThai</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="report-scoreboard text-center p-3 border rounded-2 bg-light my-2">
                        <div class="report-scoreboard-grid">
                            <div class="report-score-team">
                                <h5 class="fw-bold text-dark mb-0">@(Model.TenDoi1 ?? "Đội 1")</h5>
                                <small class="text-muted">@(Model.DonViDoi1 ?? "")</small>
                            </div>
                            <div class="report-score-summary">
                                <div class="report-score report-score-value fw-bold font-monospace">
                                    @score1 - @score2
                                </div>
                                <small class="text-muted">Tỷ số chung cuộc</small>
                            </div>
                            <div class="report-score-team">
                                <h5 class="fw-bold text-dark mb-0">@(Model.TenDoi2 ?? "Đội 2")</h5>
                                <small class="text-muted">@(Model.DonViDoi2 ?? "")</small>
                            </div>
                        </div>

                        @if (setScores.Count > 0)
                        {
                            <div class="d-flex justify-content-center gap-3 mt-3 pt-2 border-top small">
                                @foreach (var s in setScores)
                                {
                                    <span class="badge bg-white text-dark border">
                                        Hiệp @s.SetNumber: <strong>@s.Score1 - @s.Score2</strong>
                                    </span>
                                }
                            </div>
                        }

                        @if (extraTimeScore1.HasValue && extraTimeScore2.HasValue)
                        {
                            <div class="d-flex justify-content-center mt-2 small">
                                <span class="badge bg-warning-subtle text-dark border">
                                    Tổng điểm hiệp phụ: <strong>@extraTimeScore1.Value - @extraTimeScore2.Value</strong>
                                </span>
                            </div>
                        }

                        <div class="mt-2 text-success fw-bold small">
                            @if (winner == "1")
                            {
                                <span>🏆 Kết quả: <strong>@(Model.TenDoi1 ?? "Đội 1")</strong> Thắng chung cuộc</span>
                            }
                            else if (winner == "2")
                            {
                                <span>🏆 Kết quả: <strong>@(Model.TenDoi2 ?? "Đội 2")</strong> Thắng chung cuộc</span>
                            }
                            else if (winner == "draw")
                            {
                                <span>🤝 Kết quả: Hai đội Hòa</span>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- 5. Diễn Biến & Thẻ Phạt -->
            @if (events.Count > 0)
            {
                <div class="mb-4">
                    <h6 class="report-section-title fw-bold text-uppercase" style="font-size: 13px;">
                        V. DIỄN BIẾN & CÁC SỰ KIỆN PHÁT SINH
                    </h6>
                    <table class="table table-sm table-bordered small mt-2">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 70px;">Phút</th>
                                <th>Loại Sự Kiện</th>
                                <th>Đội</th>
                                <th>Vận Động Viên</th>
                                <th>Chi Tiết</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ev in events)
                            {
                                string evTitle = ev.Type switch
                                {
                                    "yellow_card" => "🟨 Thẻ vàng",
                                    "red_card" => "🟥 Thẻ đỏ",
                                    "foul" => "⚠️ Lỗi phạm quy",
                                    "sub" => "🔄 Thay người",
                                    _ => "⚽ Bàn thắng / Điểm"
                                };
                                string teamName = ev.Team == 1 ? (Model.TenDoi1 ?? "Đội 1") : (Model.TenDoi2 ?? "Đội 2");
                                <tr>
                                    <td class="text-center font-monospace">@ev.Minute'</td>
                                    <td>@evTitle</td>
                                    <td>@teamName</td>
                                    <td>@(ev.Player ?? "--")</td>
                                    <td>@(ev.Notes ?? "--")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <!-- 6. Nhận Xét Của Trọng Tài -->
            <div class="mb-4">
                <h6 class="report-section-title fw-bold text-uppercase" style="font-size: 13px;">
                    VI. NHẬN XÉT CỦA TỔ TRỌNG TÀI
                </h6>
                <p class="small text-dark mt-1" style="min-height: 40px; font-style: italic;">
                    @(string.IsNullOrWhiteSpace(notes) ? "Trận đấu diễn ra theo đúng điều lệ và tinh thần thể thao cao thượng, không có khiếu nại phát sinh." : notes)
                </p>
            </div>

            <!-- 7. Chữ Ký Xác Nhận (4 Bên) -->
            <div class="mt-5 pt-3">
                <div class="row text-center g-3" style="font-size: 13px;">
                    <!-- Đội 1 -->
                    <div class="col-3 report-signature-card">
                        <div class="fw-bold text-uppercase">ĐẠI DIỆN ĐỘI 1</div>
                        <small class="text-muted">(Ký & ghi rõ họ tên)</small>
                        <div class="mt-4 signature-box" id="sigBox_team1">
                            @if (signatures.TryGetValue("team1", out var sig1))
                            {
                                <div class="fw-bold text-success"><i class="fa-solid fa-signature"></i> @sig1.SignerName</div>
                                <div class="text-muted" style="font-size: 10px;">@sig1.SignedAt?.ToString("dd/MM/yyyy HH:mm")</div>
                            }
                            else
                            {
                                @if (canCreateReport)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-1 d-print-none"
                                            onclick="openSignModal('team1', 'Đại diện Đội 1')">
                                        <i class="fa-solid fa-pen me-1"></i> Ký tên
                                    </button>
                                }
                                else { <span class="text-muted">Chưa ký</span> }
                            }
                        </div>
                    </div>

                    <!-- Đội 2 -->
                    <div class="col-3 report-signature-card">
                        <div class="fw-bold text-uppercase">ĐẠI DIỆN ĐỘI 2</div>
                        <small class="text-muted">(Ký & ghi rõ họ tên)</small>
                        <div class="mt-4 signature-box" id="sigBox_team2">
                            @if (signatures.TryGetValue("team2", out var sig2))
                            {
                                <div class="fw-bold text-success"><i class="fa-solid fa-signature"></i> @sig2.SignerName</div>
                                <div class="text-muted" style="font-size: 10px;">@sig2.SignedAt?.ToString("dd/MM/yyyy HH:mm")</div>
                            }
                            else
                            {
                                @if (canCreateReport)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-1 d-print-none"
                                            onclick="openSignModal('team2', 'Đại diện Đội 2')">
                                        <i class="fa-solid fa-pen me-1"></i> Ký tên
                                    </button>
                                }
                                else { <span class="text-muted">Chưa ký</span> }
                            }
                        </div>
                    </div>

                    <!-- Thư Ký -->
                    <div class="col-3 report-signature-card">
                        <div class="fw-bold text-uppercase">THƯ KÝ TRẬN ĐẤU</div>
                        <small class="text-muted">(Ký & ghi rõ họ tên)</small>
                        <div class="mt-4 signature-box" id="sigBox_secretary">
                            @if (signatures.TryGetValue("secretary", out var sigSec))
                            {
                                <div class="fw-bold text-success"><i class="fa-solid fa-signature"></i> @sigSec.SignerName</div>
                                <div class="text-muted" style="font-size: 10px;">@sigSec.SignedAt?.ToString("dd/MM/yyyy HH:mm")</div>
                            }
                            else
                            {
                                @if (canCreateReport)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-1 d-print-none"
                                            onclick="openSignModal('secretary', 'Thư ký trận đấu')">
                                        <i class="fa-solid fa-pen me-1"></i> Ký tên
                                    </button>
                                }
                                else { <span class="text-muted">Chưa ký</span> }
                            }
                        </div>
                    </div>

                    <!-- Trọng Tài Chính -->
                    <div class="col-3 report-signature-card">
                        <div class="fw-bold text-uppercase">TRỌNG TÀI CHÍNH</div>
                        <small class="text-muted">(Ký & ghi rõ họ tên)</small>
                        <div class="mt-4 signature-box" id="sigBox_referee">
                            @if (signatures.TryGetValue("referee", out var sigRef))
                            {
                                <div class="fw-bold text-success"><i class="fa-solid fa-signature"></i> @sigRef.SignerName</div>
                                <div class="text-muted" style="font-size: 10px;">@sigRef.SignedAt?.ToString("dd/MM/yyyy HH:mm")</div>
                            }
                            else
                            {
                                @if (canCreateReport)
                                {
                                    <button type="button" class="btn btn-sm btn-warning text-dark fw-semibold rounded-pill px-2.5 py-1 d-print-none"
                                            onclick="openSignModal('referee', 'Trọng tài chính')">
                                        <i class="fa-solid fa-pen me-1"></i> Ký tên
                                    </button>
                                }
                                else { <span class="text-muted">Chưa ký</span> }
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal Ký Điện Tử -->
@if (canCreateReport)
{
<div class="modal fade" id="signModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white py-2.5 px-3">
                <h6 class="modal-title fw-bold" id="signModalTitle">Xác Nhận Ký Biên Bản</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="signForm">
                <input type="hidden" id="signRole" />
                <input type="hidden" id="signTranDauId" value="@(Model?.Id ?? 0)" />
                <div class="modal-body p-4">
                    <p class="small text-muted mb-3">
                        Nhập họ và tên của người ký đại diện để xác thực biên bản thi đấu chính thức.
                    </p>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Họ và tên người ký <span class="text-danger">*</span></label>
                        <input type="text" id="signerNameInput" class="form-control" required placeholder="VD: Nguyễn Văn Trưởng" />
                    </div>
                </div>
                <div class="modal-footer bg-light py-2 px-3">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-sm btn-primary px-3">
                        <i class="fa-solid fa-signature me-1"></i> Xác Nhận Ký Tên
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
}
