@model TranDauDto?
@{
    ViewData["Title"] = "Điều Hành Trận Đấu & Biên Bản";
    var tournaments = ViewBag.Tournaments as List<GiaiDauDto> ?? new();
    var matches = ViewBag.Matches as List<TranDauDto> ?? new();
    var sports = ViewBag.Sports as List<KeyValuePair<int, string>> ?? new();
    int? selectedGiaiDauId = ViewBag.SelectedGiaiDauId as int?;
    int? selectedGiaiDauMonTheThaoId = ViewBag.SelectedGiaiDauMonTheThaoId as int?;
    string selectedAssignmentRole = ViewBag.SelectedAssignmentRole as string ?? string.Empty;
    var matchFormat = ViewBag.MatchFormat as CauHinhTheThucDto;
    bool canRecordResult = ViewBag.CanRecordResult == true;

    int initScore1 = ViewBag.Score1 is int s1 ? s1 : (Model?.TySoDoi1 ?? 0);
    int initScore2 = ViewBag.Score2 is int s2 ? s2 : (Model?.TySoDoi2 ?? 0);
    string initWinner = ViewBag.Winner as string ?? (Model?.DoiThangDangKyId.HasValue == true ? (Model.DoiThangDangKyId == Model.Doi1DangKyId ? "1" : "2") : (Model?.IsHoa == true ? "draw" : ""));
    string initNotes = ViewBag.Notes as string ?? "";
    var setScores = ViewBag.SetScores as List<SetScoreDto> ?? new();
    int initLiveSetScore1 = setScores.LastOrDefault()?.Score1 ?? 0;
    int initLiveSetScore2 = setScores.LastOrDefault()?.Score2 ?? 0;
    var events = ViewBag.Events as List<MatchEventItemDto> ?? new();
    var savedHeatResults = ViewBag.HeatResults as List<HeatParticipantResultDto> ?? new();
    var heatResultByParticipantId = savedHeatResults.ToDictionary(result => result.ThanhPhanTranDauId);

    bool isHeatMatch = matchFormat?.LoaiTheThuc == "TinhDiemXepHang" || (Model?.ThanhPhanTranDaus?.Count > 2);
    bool isSetSport = matchFormat?.LoaiTheThuc == "SetDiem";
    bool isTimeSport = matchFormat?.LoaiTheThuc == "ThoiGianHiep" || (!isHeatMatch && !isSetSport);
    bool isKnockout = Model != null && (Model.BangDauId == null || !string.IsNullOrEmpty(Model.MaTranBracket));
    bool hasPenaltyCards = matchFormat?.CoThePhat == true;
    bool hasExtraTime = matchFormat?.CoHiepPhu == true;
    bool hasPenalty = matchFormat?.CoPenalty == true;
    bool secondaryMetricSmallerIsBetter = matchFormat?.TieuChiPhuCangNhoCangTot != false;
    int? initExtraTime1 = ViewBag.ExtraTimeScore1 as int?;
    int? initExtraTime2 = ViewBag.ExtraTimeScore2 as int?;
    int? initPen1 = Model?.DiemPenaltyDoi1;
    int? initPen2 = Model?.DiemPenaltyDoi2;
    string matchStatus = Model?.TrangThai ?? "ChuaDau";
    bool isMatchInProgress = matchStatus == "DangDau";
    bool isMatchCompleted = new[] { "KetThuc", "DaKetThuc", "DaDau" }.Contains(matchStatus, StringComparer.OrdinalIgnoreCase);
    DateTime? actualStartTime = Model?.ThoiGianBatDau;
    DateTime? actualEndTime = Model?.ThoiGianKetThuc;
    int elapsedSeconds = (matchStatus == "DangDau" || matchStatus == "KetThuc") && actualStartTime.HasValue
        ? Math.Max(0, (int)(((actualEndTime ?? DateTime.UtcNow) - actualStartTime.Value).TotalSeconds))
        : 0;
}

<div class="d-flex flex-column gap-4">
    <!-- Header & Selectors -->
    <div class="d-flex flex-column flex-md-row md-align-items-center justify-content-between gap-3">
        <div>
            <h4 class="fw-bold text-dark mb-1">
                <i class="fa-solid fa-clipboard-list text-warning me-2"></i> Điều Hành Trận Đấu & Biên Bản
            </h4>
            <p class="text-muted small mb-0">Ghi nhận kết quả, thẻ và diễn biến; tạo biên bản, xuất PDF sau khi trận đấu kết thúc.</p>
        </div>
    </div>

    <!-- Match Picker Card -->
    <div class="card-custom p-3">
        <form method="get" action="/TrongTai/KetQua" id="pickerForm">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold mb-1">1. Chọn Giải Đấu</label>
                    <select name="giaiDauId" class="form-select form-select-sm" onchange="document.getElementById('sportSelect').value=''; document.getElementById('matchSelect').value=''; this.form.submit()">
                        @if (tournaments.Count == 0)
                        {
                            <option value="">-- Chưa có giải được phân công --</option>
                        }
                        @foreach (var t in tournaments)
                        {
                            if (selectedGiaiDauId == t.Id)
                            {
                                <option value="@t.Id" selected="selected">@t.Ten</option>
                            }
                            else
                            {
                                <option value="@t.Id">@t.Ten</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold mb-1">2. Lọc theo môn thi đấu</label>
                    <select id="sportSelect" name="giaiDauMonTheThaoId" class="form-select form-select-sm" onchange="document.getElementById('matchSelect').value=''; this.form.submit()">
                        <option value="">-- Tất cả môn --</option>
                        @foreach (var sport in sports)
                        {
                            if (selectedGiaiDauMonTheThaoId == sport.Key)
                            {
                                <option value="@sport.Key" selected="selected">@sport.Value</option>
                            }
                            else
                            {
                                <option value="@sport.Key">@sport.Value</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold mb-1">3. Lọc theo vai trò</label>
                    <select id="assignmentRoleSelect" name="vaiTroPhanCong" class="form-select form-select-sm" onchange="document.getElementById('matchSelect').value=''; this.form.submit()">
                        @if (selectedAssignmentRole == "Chinh")
                        {
                            <option value="">-- Tất cả vai trò --</option>
                            <option value="Chinh" selected="selected">Trọng tài chính</option>
                            <option value="Phu">Trọng tài phụ</option>
                        }
                        else if (selectedAssignmentRole == "Phu")
                        {
                            <option value="">-- Tất cả vai trò --</option>
                            <option value="Chinh">Trọng tài chính</option>
                            <option value="Phu" selected="selected">Trọng tài phụ</option>
                        }
                        else
                        {
                            <option value="" selected="selected">-- Tất cả vai trò --</option>
                            <option value="Chinh">Trọng tài chính</option>
                            <option value="Phu">Trọng tài phụ</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold mb-1">4. Chọn Trận Đấu Cần Điều Hành</label>
                    <select id="matchSelect" name="tranDauId" class="form-select form-select-sm" onchange="this.form.submit()">
                        @if (matches.Count == 0)
                        {
                            <option value="">@(tournaments.Count == 0 ? "-- Chưa có trận được phân công --" : "-- Giải này chưa có trận đấu được phân công --")</option>
                        }
                        else
                        {
                            @foreach (var m in matches)
                            {
                                string st = m.TrangThai switch { "DangDau" => "🔴 [Đang đấu]", "KetThuc" => "✅ [Đã xong]", _ => "⏳ [Chưa đấu]" };
                                string matchTitle = (m.ThanhPhanTranDaus != null && m.ThanhPhanTranDaus.Count > 2)
                                    ? $"{m.TenTran} ({m.ThanhPhanTranDaus.Count} VĐV)"
                                    : $"{(m.TenDoi1 ?? "Đội 1")} VS {(m.TenDoi2 ?? "Đội 2")}";

                                if (Model != null && Model.Id == m.Id)
                                {
                                    <option value="@m.Id" selected="selected">@st Trận @m.SoTran: @matchTitle (@m.TenMonTheThao)</option>
                                }
                                else
                                {
                                    <option value="@m.Id">@st Trận @m.SoTran: @matchTitle (@m.TenMonTheThao)</option>
                                }
                            }
                        }
                    </select>
                </div>
            </div>
        </form>
    </div>

    @if (Model == null)
    {
        <div class="card-custom p-5 text-center text-muted">
            <i class="fa-solid fa-gamepad fs-1 mb-3 opacity-25"></i>
            <h5>@(tournaments.Count == 0 ? "Bạn chưa được phân công giải đấu nào" : "Vui lòng chọn một trận đấu để bắt đầu điều hành")</h5>
            <p class="small mb-0">@(tournaments.Count == 0 ? "Liên hệ ban tổ chức để được phân công giải và trận đấu." : "Chọn giải đấu và trận đấu ở thanh lọc phía trên.")</p>
        </div>
    }
    else
    {
        @if (!canRecordResult)
        {
            <div class="alert alert-info mb-0" role="status">
                <i class="fa-solid fa-eye me-1"></i> Bạn được phân công với vai trò trọng tài phụ. Màn hình này chỉ cho phép xem kết quả và diễn biến.
            </div>
        }
        <fieldset disabled="@(!canRecordResult)" class="border-0 p-0 m-0">
        <!-- Bảng Thông Tin Cấu Hình Thể Thức & Nhánh Thi Đấu -->
        <div class="card-custom p-3 bg-light border-start border-4 border-warning">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-warning bg-opacity-20 p-2.5 text-warning fs-5">
                        @if (isHeatMatch)
                        {
                            <i class="fa-solid fa-person-running"></i>
                        }
                        else if (isSetSport)
                        {
                            <i class="fa-solid fa-baseball-bat-ball"></i>
                        }
                        else
                        {
                            <i class="fa-solid fa-futbol"></i>
                        }
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="fw-bold text-dark">Luật & Thể thức thi đấu:</span>
                            @if (matchFormat != null)
                            {
                                @if (isSetSport)
                                {
                                    <span class="badge bg-primary text-white font-monospace">
                                        Best of @matchFormat.SoHiepToiDa (Chạm @matchFormat.SoHiepThangDeThangTran set)
                                    </span>
                                    <span class="badge bg-secondary-subtle text-secondary font-monospace">
                                        @matchFormat.DiemMoiHiep điểm/hiệp (Cách biệt @matchFormat.CachBietDiemToiThieu, Trần @(matchFormat.DiemToiDaMoiHiep ?? 30))
                                    </span>
                                }
                                else if (isHeatMatch)
                                {
                                    <span class="badge bg-info text-white font-monospace">
                                        Lượt thi @matchFormat.SoVdvMoiLuotThi VĐV
                                    </span>
                                    <span class="badge bg-secondary-subtle text-secondary font-monospace">
                                        Đo: @matchFormat.LoaiDoThanhTich (@matchFormat.DonViThanhTich) - @(matchFormat.TieuChiXepHangThanhTich == "CangNhoCangTot" ? "Thời gian nhanh nhất xếp trên" : "Thành tích cao nhất xếp trên")
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success text-white font-monospace">
                                        @(matchFormat.ThoiGianHiepChinhPhut > 0 ? $"{matchFormat.ThoiGianHiepChinhPhut} phút/hiệp" : "Thời gian chuẩn")
                                    </span>
                                    @if (matchFormat.CoHiepPhu)
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary font-monospace">Có hiệp phụ</span>
                                    }
                                    @if (matchFormat.CoPenalty)
                                    {
                                        <span class="badge bg-danger-subtle text-danger font-monospace">Penalty khi hòa</span>
                                    }
                                }
                            }
                            else
                            {
                                <span class="badge bg-secondary text-white">Mặc định tiêu chuẩn môn</span>
                            }
                        </div>

                        <!-- Tiến trình DAG Knockout nếu có -->
                        @if (Model.NextTranDauId.HasValue || !string.IsNullOrEmpty(Model.MaTranBracket))
                        {
                            <div class="small text-primary mt-1 d-flex align-items-center gap-2">
                                <i class="fa-solid fa-diagram-project"></i>
                                <span>Nhánh đấu: <strong>@(Model.MaTranBracket ?? "Knockout")</strong></span>
                                <span>➔ Đội thắng tự động vào <strong>Trận @Model.NextTranDauId (Vị trí @(Model.NextTranDauViTri ?? 1))</strong></span>
                                @if (Model.LoserNextTranDauId.HasValue)
                                {
                                    <span class="text-danger">| ➔ Đội thua vào <strong>Trận tranh hạng Ba (Trận @Model.LoserNextTranDauId)</strong></span>
                                }
                            </div>
                        }
                    </div>
                </div>

                @if (isHeatMatch && matchFormat?.KyLucHienTai.HasValue == true)
                {
                    <div class="text-end">
                        <small class="text-muted d-block">Kỷ lục giải hiện tại</small>
                        <span class="badge bg-warning text-dark font-monospace fs-6 px-3 py-1">
                            <i class="fa-solid fa-medal me-1"></i>@(matchFormat.KyLucHienTaiText ?? $"{matchFormat.KyLucHienTai}s")
                        </span>
                    </div>
                }
            </div>
        </div>

        <div class="card-custom px-3 py-2 d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="d-flex align-items-center gap-2">
                <i class="fa-solid fa-stopwatch text-primary"></i>
                <span class="small fw-semibold text-muted">Thời gian trận đấu</span>
                <span id="matchElapsedClock" class="font-monospace fw-bold fs-5 text-dark">00:00:00</span>
            </div>
            <small class="text-muted">
                @if ((matchStatus == "DangDau" || matchStatus == "KetThuc") && actualStartTime.HasValue)
                {
                    <span>Bắt đầu: @actualStartTime.Value.ToString("HH:mm:ss dd/MM/yyyy")</span>
                }
                else
                {
                    <span>Đồng hồ bắt đầu khi chuyển trận sang trạng thái đang thi đấu.</span>
                }
            </small>
            @if (isHeatMatch && matchStatus == "ChuaDau")
            {
                <button type="button" id="btnStartMatch" class="btn btn-primary rounded-pill px-4 py-2 fw-bold" onclick="startMatch()">
                    <i class="fa-solid fa-play me-1"></i> Bắt đầu lượt thi
                </button>
            }
        </div>

        @if (isHeatMatch)
        {
            <!-- ===================== GIAO DIỆN BƠI LỘI / ĐIỀN KINH (LEADERBOARD HEATS) ===================== -->
            <div class="card-custom p-4">
                <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                    <div>
                        <h5 class="fw-bold text-dark mb-1">
                            <i class="fa-solid fa-stopwatch text-danger me-2"></i> Bảng Kết Quả Lượt Thi (Heat) Theo Làn
                        </h5>
                        <p class="text-muted small mb-0">Nhập thời gian (giây hoặc mm:ss.xx) cho từng làn thi đấu. Hệ thống sẽ tự động xếp hạng và chọn top VĐV đi tiếp.</p>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="recalculateHeatRanks()">
                        <i class="fa-solid fa-arrow-down-short-wide me-1"></i> Tự Động Xếp Hạng Làn
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered align-middle text-center" id="tableHeatLanes">
                        <thead class="table-dark small">
                            <tr>
                                <th style="width: 70px;">Làn</th>
                                <th class="text-start">Vận Động Viên & Đơn Vị</th>
                                <th style="width: 200px;">Thành Tích (@(matchFormat?.DonViThanhTich ?? "giây"))</th>
                                <th style="width: 180px;">@(matchFormat?.TenTieuChiPhuThanhTich ?? "Chỉ số phụ") (@(secondaryMetricSmallerIsBetter ? "nhỏ hơn tốt hơn" : "lớn hơn tốt hơn"))</th>
                                <th style="width: 220px;">Trạng Thái Xuất Phát</th>
                                <th style="width: 110px;">Xếp Hạng</th>
                                <th>Kỷ Lục / Ghi Chú</th>
                            </tr>
                        </thead>
                        <tbody id="bodyHeatLanes">
                            @if (Model.ThanhPhanTranDaus != null && Model.ThanhPhanTranDaus.Count > 0)
                            {
                                @for (int i = 0; i < Model.ThanhPhanTranDaus.Count; i++)
                                {
                                    var tp = Model.ThanhPhanTranDaus[i];
                                    heatResultByParticipantId.TryGetValue(tp.Id, out var savedHeatResult);
                                    <tr data-tp-id="@tp.Id" data-dk-id="@tp.DangKyThiDauId" data-lane="@(tp.SoLane ?? (i + 1))">
                                        <td class="fw-bold fs-5 font-monospace text-primary">
                                            Làn @(tp.SoLane ?? (i + 1))
                                        </td>
                                        <td class="text-start">
                                            <div class="fw-bold text-dark">@(tp.TenDangKy ?? tp.TenDoi ?? $"VĐV {tp.DangKyThiDauId}")</div>
                                            <small class="text-muted">@(tp.TenDonVi ?? "Đơn vị tự do")</small>
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm text-center font-monospace fs-6 heat-time-input"
                                                   placeholder="VD: 10.45"
                                                   value="@(savedHeatResult?.GiaTri?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                                   @(isMatchInProgress ? "" : "disabled")
                                                   onchange="onLaneTimeChanged(this)" />
                                        </td>
                                        <td>
                                            <input type="number" step="0.01" class="form-control form-control-sm text-center font-monospace heat-tiebreak-input"
                                                   placeholder="@(matchFormat?.TenTieuChiPhuThanhTich ?? "Nhập chỉ số phụ")"
                                                   value="@(savedHeatResult?.GiaTriPhu?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                                   @(isMatchInProgress ? "" : "disabled") onchange="recalculateHeatRanks()" />
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm w-100" role="group">
                                                <input type="radio" class="btn-check" name="laneStatus_@tp.Id" id="laneSt_ok_@tp.Id" value="ThamGia" @(savedHeatResult?.TrangThai == null || savedHeatResult.TrangThai == "ThamGia" ? "checked" : "") @(isMatchInProgress ? "" : "disabled") onchange="onLaneStatusChanged(@tp.Id)" />
                                                <label class="btn btn-outline-success" for="laneSt_ok_@tp.Id">Hợp lệ</label>

                                                <input type="radio" class="btn-check" name="laneStatus_@tp.Id" id="laneSt_dns_@tp.Id" value="DNS" @(savedHeatResult?.TrangThai == "DNS" ? "checked" : "") @(isMatchInProgress ? "" : "disabled") onchange="onLaneStatusChanged(@tp.Id)" />
                                                <label class="btn btn-outline-secondary" for="laneSt_dns_@tp.Id" title="Did Not Start">DNS</label>

                                                <input type="radio" class="btn-check" name="laneStatus_@tp.Id" id="laneSt_dnf_@tp.Id" value="DNF" @(savedHeatResult?.TrangThai == "DNF" ? "checked" : "") @(isMatchInProgress ? "" : "disabled") onchange="onLaneStatusChanged(@tp.Id)" />
                                                <label class="btn btn-outline-warning" for="laneSt_dnf_@tp.Id" title="Did Not Finish">DNF</label>

                                                <input type="radio" class="btn-check" name="laneStatus_@tp.Id" id="laneSt_dq_@tp.Id" value="DQ" @(savedHeatResult?.TrangThai == "DQ" ? "checked" : "") @(isMatchInProgress ? "" : "disabled") onchange="onLaneStatusChanged(@tp.Id)" />
                                                <label class="btn btn-outline-danger" for="laneSt_dq_@tp.Id" title="Disqualified">DQ</label>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary font-monospace fs-6 lane-rank-badge">--</span>
                                        </td>
                                        <td class="lane-record-notice">
                                            <small class="text-muted">--</small>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-muted py-4">Chưa có danh sách VĐV trong lượt thi này.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <!-- ===================== GIAO DIỆN BÓNG ĐÁ / CẦU LÔNG / BÓNG CHUYỀN (MATCH 1V1) ===================== -->
            <!-- Bảng Điểm Điện Tử Trực Tiếp (Live Digital Scoreboard) -->
            <style>
                .score-adjustment {
                    margin-top: .85rem;
                }

                .score-adjustment-caption {
                    display: block;
                    margin-bottom: .45rem;
                    color: #64748b;
                    font-size: .7rem;
                    font-weight: 700;
                    letter-spacing: .07em;
                    text-align: center;
                    text-transform: uppercase;
                }

                .score-adjustment-actions {
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    gap: .65rem;
                }

                .score-adjustment-divider {
                    width: 1px;
                    height: 30px;
                    background: #cbd5e1;
                }

                .score-adjustment-button {
                    display: inline-flex;
                    min-width: 58px;
                    min-height: 48px;
                    align-items: center;
                    justify-content: center;
                    gap: .35rem;
                    border: 1px solid transparent;
                    border-radius: 12px;
                    font-size: 1rem;
                    font-weight: 750;
                    line-height: 1;
                    touch-action: manipulation;
                    transition: transform .12s ease, box-shadow .12s ease, background-color .12s ease;
                }

                .score-adjustment-button:hover:not(:disabled) {
                    transform: translateY(-1px);
                    box-shadow: 0 4px 10px rgba(30, 64, 175, .16);
                }

                .score-adjustment-button:active:not(:disabled) {
                    transform: translateY(0);
                    box-shadow: none;
                }

                .score-adjustment-button:focus-visible {
                    outline: 3px solid rgba(59, 130, 246, .35);
                    outline-offset: 2px;
                }

                .score-adjustment-button:disabled {
                    cursor: not-allowed;
                    opacity: .42;
                }

                .score-adjustment-subtract {
                    min-width: 68px;
                    border-color: #fecaca;
                    background: #fff1f2;
                    color: #b91c1c;
                }

                .score-adjustment-add-primary {
                    min-width: 76px;
                    background: #1d4ed8;
                    color: #fff;
                    box-shadow: 0 2px 5px rgba(29, 78, 216, .2);
                }

                .score-adjustment-add-secondary {
                    border-color: #bfdbfe;
                    background: #fff;
                    color: #1d4ed8;
                }

                @@media (max-width: 575.98px) {
                    .score-adjustment-actions { gap: .45rem; }
                    .score-adjustment-button { min-width: 54px; }
                    .score-adjustment-subtract { min-width: 62px; }
                    .score-adjustment-add-primary { min-width: 68px; }
                }
            </style>
            <div class="card-custom p-4 overflow-hidden position-relative"
                 style="background: linear-gradient(135deg, #e8f0fb 0%, #dce8f8 55%, #d1e1f4 100%); border-color: #b8cfea;">

                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4 pb-3 border-bottom" style="border-color: #b8cfea !important;">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary-subtle text-primary font-monospace px-2.5 py-1">Trận @Model.SoTran</span>
                        <span class="fw-bold text-dark fs-6">@Model.TenMonTheThao</span>
                        @if (!string.IsNullOrEmpty(Model.TenVongDau))
                        {
                            <span class="badge bg-white text-secondary border">@Model.TenVongDau</span>
                        }
                        @if (!string.IsNullOrEmpty(Model.TenBangDau))
                        {
                            <span class="badge bg-info bg-opacity-25 text-info">@Model.TenBangDau</span>
                        }
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-secondary small"><i class="fa-solid fa-location-dot me-1 text-primary"></i>@(Model.TenSanDau ?? "Sân đấu")</span>
                        <span class="text-secondary small">•</span>
                        <span class="text-secondary small"><i class="fa-solid fa-clock me-1 text-primary"></i>@(Model.ThoiGianDuKien?.ToString("HH:mm - dd/MM/yyyy") ?? "--")</span>
                    </div>
                </div>

                <!-- 2 Đội & Tỷ Số Lớn -->
                <div class="row g-3 align-items-center text-center my-3">
                    <!-- Đội 1 -->
                    <div class="col-md-5">
                        <div class="p-3 rounded-4 bg-white border position-relative" style="border-color: #b8cfea !important;">
                            <h4 class="fw-bold text-dark mb-1 text-truncate" id="labelTeam1">@(Model.TenDoi1 ?? "Đội 1")</h4>
                            <small class="text-secondary text-truncate d-block mb-3">@(Model.DonViDoi1 ?? "Đơn vị chủ quản")</small>

                            <div class="display-2 fw-bold font-monospace text-primary my-2" id="displayScore1">@(isSetSport ? initLiveSetScore1 : initScore1)</div>
                            <small class="text-secondary d-block mb-2" id="subLabelScore1">@(isSetSport ? "Điểm set đang đấu" : "Tổng tỷ số (cộng các hiệp)")</small>

                            <div class="score-adjustment" role="group" aria-label="Điều chỉnh điểm đội 1">
                                <span class="score-adjustment-caption">Điều chỉnh điểm</span>
                                <div class="score-adjustment-actions">
                                    <button type="button" class="score-adjustment-button score-adjustment-subtract" id="btnSubtractScore1" title="Trừ 1 điểm đội 1" aria-label="Trừ 1 điểm đội 1" onclick="adjustScore(1, -1)" @(isMatchInProgress ? "" : "disabled")>
                                        <i class="fa-solid fa-minus" aria-hidden="true"></i><span>1</span>
                                    </button>
                                    <span class="score-adjustment-divider" aria-hidden="true"></span>
                                    <button type="button" id="btnAddScore1Primary" class="score-adjustment-button score-adjustment-add-primary" title="Cộng 1 điểm đội 1" aria-label="Cộng 1 điểm đội 1" onclick="adjustScore(1, 1)" @(isMatchInProgress ? "" : "disabled")>
                                        <i class="fa-solid fa-plus" aria-hidden="true"></i><span>1</span>
                                    </button>
                                    <button type="button" id="btnAddScore1Two" class="score-adjustment-button score-adjustment-add-secondary" title="Cộng 2 điểm đội 1" aria-label="Cộng 2 điểm đội 1" onclick="adjustScore(1, 2)" @(isMatchInProgress ? "" : "disabled")>+2</button>
                                    <button type="button" id="btnAddScore1Three" class="score-adjustment-button score-adjustment-add-secondary" title="Cộng 3 điểm đội 1" aria-label="Cộng 3 điểm đội 1" onclick="adjustScore(1, 3)" @(isMatchInProgress ? "" : "disabled")>+3</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Dấu phân cách & Trạng thái giữa -->
                    <div class="col-md-2 my-2 my-md-0">
                        <div class="display-3 fw-bold text-secondary font-monospace">:</div>
                        @if (matchStatus == "ChuaDau")
                        {
                            <button type="button" id="btnStartMatch" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm" onclick="startMatch()">
                                <i class="fa-solid fa-play me-1"></i> Bắt đầu
                            </button>
                        }
                        @if (isSetSport)
                        {
                            <div class="badge bg-primary rounded-pill px-3 py-1" id="displayMatchSetScore">Set thắng @initScore1 - @initScore2</div>
                        }
                        <div class="mt-2" id="badgeMatchStatus">
                            @if (Model.TrangThai == "DangDau")
                            {
                                <span class="badge bg-danger rounded-pill px-3 py-1.5"><i class="fa-solid fa-circle-play me-1"></i>Đang diễn ra</span>
                            }
                            else if (Model.TrangThai == "KetThuc")
                            {
                                <span class="badge bg-success rounded-pill px-3 py-1.5"><i class="fa-solid fa-flag-checkered me-1"></i>Đã kết thúc</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary rounded-pill px-3 py-1.5"><i class="fa-solid fa-clock me-1"></i>Chưa đấu</span>
                            }
                        </div>

                        @if (isTimeSport)
                        {
                            <div id="activePeriodLabel" class="small text-primary fw-semibold mt-2"></div>
                        }
                        <div id="setAdvantageNotice" class="mt-2 text-warning small fw-bold"></div>
                    </div>

                    <!-- Đội 2 -->
                    <div class="col-md-5">
                        <div class="p-3 rounded-4 bg-white border position-relative" style="border-color: #b8cfea !important;">
                            <h4 class="fw-bold text-dark mb-1 text-truncate" id="labelTeam2">@(Model.TenDoi2 ?? "Đội 2")</h4>
                            <small class="text-secondary text-truncate d-block mb-3">@(Model.DonViDoi2 ?? "Đơn vị chủ quản")</small>

                            <div class="display-2 fw-bold font-monospace text-primary my-2" id="displayScore2">@(isSetSport ? initLiveSetScore2 : initScore2)</div>
                            <small class="text-secondary d-block mb-2" id="subLabelScore2">@(isSetSport ? "Điểm set đang đấu" : "Tổng tỷ số (cộng các hiệp)")</small>

                            <div class="score-adjustment" role="group" aria-label="Điều chỉnh điểm đội 2">
                                <span class="score-adjustment-caption">Điều chỉnh điểm</span>
                                <div class="score-adjustment-actions">
                                    <button type="button" class="score-adjustment-button score-adjustment-subtract" id="btnSubtractScore2" title="Trừ 1 điểm đội 2" aria-label="Trừ 1 điểm đội 2" onclick="adjustScore(2, -1)" @(isMatchInProgress ? "" : "disabled")>
                                        <i class="fa-solid fa-minus" aria-hidden="true"></i><span>1</span>
                                    </button>
                                    <span class="score-adjustment-divider" aria-hidden="true"></span>
                                    <button type="button" id="btnAddScore2Primary" class="score-adjustment-button score-adjustment-add-primary" title="Cộng 1 điểm đội 2" aria-label="Cộng 1 điểm đội 2" onclick="adjustScore(2, 1)" @(isMatchInProgress ? "" : "disabled")>
                                        <i class="fa-solid fa-plus" aria-hidden="true"></i><span>1</span>
                                    </button>
                                    <button type="button" id="btnAddScore2Two" class="score-adjustment-button score-adjustment-add-secondary" title="Cộng 2 điểm đội 2" aria-label="Cộng 2 điểm đội 2" onclick="adjustScore(2, 2)" @(isMatchInProgress ? "" : "disabled")>+2</button>
                                    <button type="button" id="btnAddScore2Three" class="score-adjustment-button score-adjustment-add-secondary" title="Cộng 3 điểm đội 2" aria-label="Cộng 3 điểm đội 2" onclick="adjustScore(2, 3)" @(isMatchInProgress ? "" : "disabled")>+3</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Thông báo tự động xác định người thắng -->
                <div id="autoWinnerAlert" class="alert alert-success d-none mt-3 mb-0 text-center fw-semibold py-2">
                    <i class="fa-solid fa-trophy text-warning me-1"></i> <span id="autoWinnerText"></span>
                </div>
            </div>

            @if ((isKnockout || matchFormat?.ChoPhepHoaVongBang == false) && !isSetSport && !isHeatMatch && (hasPenalty || (hasExtraTime && isKnockout)))
            {
                <div id="tieBreakCard" class="card-custom p-4 border border-warning border-opacity-25 bg-warning-subtle bg-opacity-10 d-none">
                    <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom border-warning border-opacity-25">
                        <h6 class="fw-bold text-dark mb-0"><i class="fa-solid fa-scale-balanced text-warning me-2"></i>Phân định kết quả hòa</h6>
                        <span class="badge bg-warning text-dark">Theo cấu hình môn thi đấu</span>
                    </div>
                    @if (hasExtraTime && isKnockout)
                    {
                        <div class="mb-3">
                            <div class="small text-muted mb-2">Nhập điểm hiệp phụ. Điểm được cộng vào tỷ số chính trước khi xét luân lưu.</div>
                            <div class="row g-3 align-items-center">
                                <div class="col-md-5 text-center">
                                    <label class="form-label small fw-semibold">Hiệp phụ: @(Model.TenDoi1 ?? "Đội 1")</label>
                                    <input type="number" id="inputExtraTime1" class="form-control form-control-lg text-center font-monospace fw-bold" min="0" step="1" value="@(initExtraTime1?.ToString() ?? "")" @(isMatchInProgress ? "" : "disabled") onchange="onTieBreakScoreChanged()" />
                                </div>
                                <div class="col-md-2 text-center"><span class="fs-4 fw-bold text-warning">VS</span></div>
                                <div class="col-md-5 text-center">
                                    <label class="form-label small fw-semibold">Hiệp phụ: @(Model.TenDoi2 ?? "Đội 2")</label>
                                    <input type="number" id="inputExtraTime2" class="form-control form-control-lg text-center font-monospace fw-bold" min="0" step="1" value="@(initExtraTime2?.ToString() ?? "")" @(isMatchInProgress ? "" : "disabled") onchange="onTieBreakScoreChanged()" />
                                </div>
                            </div>
                        </div>
                    }
                    @if (hasPenalty)
                    {
                        <div id="penaltySection" class="@(hasExtraTime && isKnockout ? "d-none" : "")">
                            <div class="small text-muted mb-2">@(hasExtraTime && isKnockout ? "Nếu tổng tỷ số sau hiệp phụ vẫn hòa, nhập kết quả luân lưu." : "Nhập kết quả phân định để xác định đội thắng.")</div>
                            <div class="row g-3 align-items-center">
                                <div class="col-md-5 text-center">
                                    <label class="form-label small fw-semibold">Luân lưu: @(Model.TenDoi1 ?? "Đội 1")</label>
                                    <input type="number" id="inputPenalty1" class="form-control form-control-lg text-center font-monospace fw-bold fs-3" min="0" max="50" value="@(initPen1?.ToString() ?? "")" @(isMatchInProgress ? "" : "disabled") onchange="onPenaltyScoreChanged()" />
                                </div>
                                <div class="col-md-2 text-center"><span class="fs-4 fw-bold text-danger">VS</span></div>
                                <div class="col-md-5 text-center">
                                    <label class="form-label small fw-semibold">Luân lưu: @(Model.TenDoi2 ?? "Đội 2")</label>
                                    <input type="number" id="inputPenalty2" class="form-control form-control-lg text-center font-monospace fw-bold fs-3" min="0" max="50" value="@(initPen2?.ToString() ?? "")" @(isMatchInProgress ? "" : "disabled") onchange="onPenaltyScoreChanged()" />
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            <!-- 2 Cột: Điểm Từng Hiệp / Set & Diễn Biến Sự Kiện -->
            <div class="row g-4">
                <!-- Cột 1: Điểm Từng Hiệp (Set Scores) -->
                <div class="col-lg-5">
                    <div class="card-custom p-4 h-100 d-flex flex-column">
                        <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                            <div>
                                <h6 class="fw-bold text-dark mb-0">
                                    <i class="fa-solid fa-layer-group text-primary me-2"></i> Điểm Từng Hiệp / Set
                                </h6>
                                <small class="text-muted">@(isSetSport ? "Luật deuce & chạm trần tự động tính" : "Ghi nhận tỷ số các hiệp")</small>
                            </div>
                            <button type="button" id="btnAddPeriod" class="btn btn-sm btn-outline-primary rounded-pill px-2.5" onclick="addNewSet()" @(isMatchInProgress ? "" : "disabled")>
                                <i class="fa-solid fa-plus me-1"></i> @(isSetSport ? "Bắt đầu set tiếp theo" : "Sang hiệp tiếp theo")
                            </button>
                        </div>

                        <div class="table-responsive flex-grow-1">
                            <table class="table table-bordered align-middle text-center mb-0" id="tableSets">
                                <thead class="table-light small">
                                    <tr>
                                        <th style="width: 80px;">Hiệp</th>
                                        <th>@(Model.TenDoi1 ?? "Đội 1")</th>
                                        <th>@(Model.TenDoi2 ?? "Đội 2")</th>
                                        <th style="width: 60px;">Kết quả</th>
                                        <th style="width: 145px;">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody id="bodySets">
                                    <!-- Rendered by JS -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Cột 2: Diễn biến sự kiện trận đấu (Match Events) -->
                <div class="col-lg-7">
                    <div class="card-custom p-4 h-100 d-flex flex-column">
                        <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                            <h6 class="fw-bold text-dark mb-0">
                                <i class="fa-solid fa-timeline text-success me-2"></i> Diễn Biến & Sự Kiện (Bàn thắng, Thẻ phạt, Lỗi)
                            </h6>
                            <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-2.5" onclick="openEventModal()" @(isMatchInProgress ? "" : "disabled")>
                                <i class="fa-solid fa-plus me-1"></i> Thêm Sự Kiện
                            </button>
                        </div>

                        <div class="flex-grow-1 border rounded-3 p-3 bg-light overflow-auto" style="max-height: 280px;" id="eventContainer">
                            <!-- Rendered by JS -->
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Điều Khiển Trạng Thái & Người Thắng -->
        <div class="card-custom p-4">
            <h6 class="fw-bold text-dark mb-3 pb-2 border-bottom">
                <i class="fa-solid fa-sliders text-warning me-2"></i> Trạng Thái Trận Đấu & Xác Định Kết Quả
            </h6>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label small fw-semibold">Trạng thái trận đấu</label>
                    <div class="form-control bg-light d-flex align-items-center gap-2">
                        @if (matchStatus == "DangDau")
                        {
                            <span class="badge bg-danger"><i class="fa-solid fa-circle-play me-1"></i>Đang diễn ra</span>
                        }
                        else if (matchStatus == "KetThuc")
                        {
                            <span class="badge bg-success"><i class="fa-solid fa-flag-checkered me-1"></i>Đã kết thúc</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary"><i class="fa-solid fa-clock me-1"></i>Chưa đấu</span>
                        }
                        <span class="small text-muted">Trạng thái được cập nhật bằng nút Bắt đầu và Hoàn tất trận.</span>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label small fw-semibold">Kết quả chung cuộc</label>
                    @if (isHeatMatch)
                    {
                        <div class="form-control text-muted small bg-light">
                            <i class="fa-solid fa-info-circle text-info me-1"></i> Kết quả xếp hạng sẽ được xác định tự động từ thành tích các làn.
                        </div>
                    }
                    else
                    {
                        <select id="selectWinner" class="form-select" @(isMatchInProgress ? "" : "disabled")>
                            <option value="">-- Chưa xác định kết quả --</option>
                            <option value="1" selected="@(initWinner == "1" ? "selected" : null)">🏆 @(Model.TenDoi1 ?? "Đội 1") Thắng</option>
                            <option value="2" selected="@(initWinner == "2" ? "selected" : null)">🏆 @(Model.TenDoi2 ?? "Đội 2") Thắng</option>
                            <option value="draw" selected="@(initWinner == "draw" ? "selected" : null)">🤝 Hai đội Hòa</option>
                        </select>
                    }
                </div>
            </div>
        </div>

        <!-- Ghi chú chung -->
        <div class="card-custom p-4">
            <label class="form-label small fw-bold text-dark mb-2">
                <i class="fa-solid fa-comment-dots text-secondary me-1"></i> Nhận Xét / Ghi Chú Của Trọng Tài
            </label>
            <textarea id="matchNotes" class="form-control" rows="2" placeholder="Ghi chú về tinh thần thi đấu, sự cố sân bãi, điều kiện thời tiết nếu có..." @(isMatchInProgress ? "" : "disabled")>@initNotes</textarea>
        </div>

        <!-- Floating Action Bar -->
        <div class="card-custom p-3 d-flex flex-column flex-md-row align-items-center justify-content-between gap-3 shadow-sm bg-white sticky-bottom" style="z-index: 1020;">
            <span class="small text-muted" aria-live="polite">
                @if (isMatchInProgress)
                {
                    @if (isHeatMatch)
                    {
                        <span id="scoreAutoSaveStatus"><i class="fa-solid fa-circle-info text-primary me-1"></i>Nhập thành tích từng làn; hệ thống sẽ kiểm tra trước khi hoàn tất lượt thi.</span>
                    }
                    else
                    {
                        <span id="scoreAutoSaveStatus"><i class="fa-solid fa-cloud-arrow-up text-primary me-1"></i>Tỷ số và điểm từng hiệp sẽ tự lưu sau mỗi lần điều chỉnh.</span>
                    }
                }
                else if (matchStatus == "ChuaDau")
                {
                    <span><i class="fa-solid fa-circle-info text-primary me-1"></i>Bấm <strong>@(isHeatMatch ? "Bắt đầu lượt thi" : "Bắt đầu")</strong> để mở quyền nhập kết quả.</span>
                }
                else
                {
                    <span><i class="fa-solid fa-circle-check text-success me-1"></i>Trận đã kết thúc; kết quả không thể chỉnh sửa.</span>
                }
            </span>
            <div class="d-flex gap-2 w-100 w-md-auto justify-content-end">
                @if (isMatchInProgress && !isHeatMatch)
                {
                <button type="button" class="btn btn-outline-secondary rounded-pill px-3 py-2 fw-semibold" id="btnSaveDraft" onclick="saveDraftResult()">
                    <i class="fa-solid fa-floppy-disk me-1"></i> Lưu Tạm Diễn Biến
                </button>
                <button type="button" class="btn btn-success rounded-pill px-4 py-2 fw-bold shadow-sm" id="btnCompleteMatch" onclick="completeMatchFinal()">
                    <i class="fa-solid fa-trophy me-1"></i> Hoàn Tất & Xác Nhận Kết Quả
                </button>
                }
            </div>
        </div>
        </fieldset>

        @if (isMatchCompleted)
        {
            <style>
                .official-report.pdf-exporting .d-print-none { display: none !important; }
                .official-report.pdf-exporting { background: #ffffff !important; color: #111827 !important; }

                #matchReportPanel .match-report-actions {
                    display: flex;
                    flex-wrap: wrap;
                    align-items: center;
                    justify-content: flex-end;
                    gap: .6rem;
                    padding: .45rem;
                    border: 1px solid #e1eaf4;
                    border-radius: 16px;
                    background: linear-gradient(135deg, #f8fbff, #f2f7fd);
                }

                #matchReportPanel .match-report-status {
                    display: inline-flex;
                    min-height: 40px;
                    align-items: center;
                    gap: .45rem;
                    padding: .55rem .85rem;
                    border: 1px solid #d6e2ee;
                    border-radius: 12px;
                    font-size: .8rem;
                    font-weight: 700;
                }

                #matchReportPanel .match-report-status.bg-secondary-subtle {
                    color: #52657a !important;
                    background: #fff !important;
                }

                #matchReportPanel .match-report-status.bg-success-subtle {
                    color: #187347 !important;
                    border-color: #b9e3cc;
                    background: #eaf7ef !important;
                }

                #matchReportPanel .match-report-button {
                    display: inline-flex;
                    min-height: 42px;
                    align-items: center;
                    justify-content: center;
                    gap: .5rem;
                    padding: .6rem 1rem;
                    border-radius: 12px;
                    font-weight: 700;
                    transition: transform .16s ease, box-shadow .16s ease, background-color .16s ease;
                }

                #matchReportPanel .match-report-button:hover:not(:disabled) {
                    transform: translateY(-1px);
                    box-shadow: 0 6px 14px rgba(31, 74, 124, .16);
                }

                #matchReportPanel .match-report-create {
                    color: #245a9d;
                    border: 1px solid #c5d9ef;
                    background: #fff;
                }

                #matchReportPanel .match-report-create:hover:not(:disabled) {
                    color: #173b68;
                    background: #eef5fd;
                }

                #matchReportPanel .match-report-export {
                    color: #fff;
                    border: 1px solid #b72d3c;
                    background: linear-gradient(135deg, #e34c5b, #c93445);
                    box-shadow: 0 4px 10px rgba(201, 52, 69, .2);
                }

                #matchReportPanel .match-report-export:hover:not(:disabled) {
                    color: #fff;
                    background: linear-gradient(135deg, #d64050, #b8293a);
                }

                #matchReportPreview .official-report {
                    width: 100%;
                    max-width: 1120px;
                    margin: 0 auto !important;
                }

                @@media (max-width: 767.98px) {
                    #matchReportPanel .match-report-actions { justify-content: center; }
                    #matchReportPanel .match-report-status { flex: 1 1 100%; justify-content: center; }
                    #matchReportPanel .match-report-button { flex: 1 1 auto; }
                }
            </style>
            <div id="matchReportPanel" class="card-custom p-3 p-md-4">
                <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
                    <div>
                        <h5 class="fw-bold text-dark mb-1"><i class="fa-solid fa-file-signature text-primary me-2"></i>Biên bản trận đấu</h5>
                        <p class="text-muted small mb-0">Tạo biên bản từ kết quả, điểm từng hiệp/set, diễn biến và danh sách vận động viên đã ghi nhận.</p>
                    </div>
                    <div class="match-report-actions">
                        <span id="matchReportStatus" class="match-report-status bg-secondary-subtle text-secondary"><i class="fa-solid fa-file-circle-question"></i><span>Chưa tạo bản xem trước</span></span>
                        <button type="button" id="btnCreateMatchReport" class="btn match-report-button match-report-create" onclick="createMatchReport()">
                            <i class="fa-solid fa-file-circle-plus"></i><span>Tạo biên bản</span>
                        </button>
                        <button type="button" id="btnExportMatchReport" class="btn match-report-button match-report-export d-none" onclick="exportMatchReportPdf()">
                            <i class="fa-solid fa-file-pdf"></i><span>Xuất PDF</span>
                        </button>
                    </div>
                </div>
                <div id="matchReportPreview" class="d-none mt-3"></div>
            </div>
        }
    }
</div>

<!-- Modal Thêm Sự Kiện -->
@if (canRecordResult)
{
<div class="modal fade" id="eventModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
