@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script>
        const matchId = @(Model?.Id ?? 0);
        const selectedTournamentId = @(selectedGiaiDauId ?? 0);
        const matchStatus = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(matchStatus));
        const matchCanHaveReport = @(isMatchCompleted ? "true" : "false");
        let score1 = @initScore1;
        let score2 = @initScore2;
        let pen1 = @(initPen1.HasValue ? initPen1.Value.ToString() : "null");
        let pen2 = @(initPen2.HasValue ? initPen2.Value.ToString() : "null");
        let extraTime1 = @(initExtraTime1.HasValue ? initExtraTime1.Value.ToString() : "null");
        let extraTime2 = @(initExtraTime2.HasValue ? initExtraTime2.Value.ToString() : "null");

        const isHeatMatch = @(isHeatMatch ? "true" : "false");
        const isSetSport = @(isSetSport ? "true" : "false");
        const isTimeSport = @(isTimeSport ? "true" : "false");
        const isKnockout = @(isKnockout ? "true" : "false");
        const hasExtraTime = @(hasExtraTime ? "true" : "false");
        const hasPenalty = @(hasPenalty ? "true" : "false");
        const hasPenaltyCards = @(hasPenaltyCards ? "true" : "false");
        const matchWasInProgress = @(matchStatus == "DangDau" ? "true" : "false");
        let scoreSaveTimer = null;
        let scoreSaveInProgress = false;
        let pendingScoreSave = null;
        let lastAutoSaveFailed = false;
        let elapsedMatchSeconds = @elapsedSeconds;
        let matchClockStartedAt = matchWasInProgress ? Date.now() : null;

        const sportConfig = @Html.Raw(matchFormat != null ? System.Text.Json.JsonSerializer.Serialize(matchFormat) : "null");
        const tenDoi1 = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.TenDoi1 ?? "Đội 1"));
        const tenDoi2 = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.TenDoi2 ?? "Đội 2"));

        let setScoresList = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(setScores));
        setScoresList = setScoresList.map(function (set) {
            return {
                setNumber: set.setNumber ?? set.SetNumber ?? 1,
                score1: set.score1 ?? set.Score1 ?? 0,
                score2: set.score2 ?? set.Score2 ?? 0
            };
        });
        let editingSetIndex = null;
        let eventsList = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(events));
        let eventModal = null;

        $(document).ready(function () {
            const eventModalElement = document.getElementById('eventModal');
            if (eventModalElement) eventModal = new bootstrap.Modal(eventModalElement);
            renderMatchClock();
            setInterval(renderMatchClock, 1000);
            $('.score-adjustment-add-secondary').toggleClass('d-none', isSetSport);

            if (!isHeatMatch) {
                if (setScoresList.length === 0 && isSetSport) {
                    setScoresList.push({ setNumber: 1, score1: 0, score2: 0 });
                }
                if (!isSetSport) {
                    reconcileCurrentPeriodScores();
                    recalculatePeriodTotals();
                }
                renderSets();
                renderEvents();
                checkTieBreakCondition();
                if (isSetSport) {
                    recalculateSetsWon();
                }
            } else {
                recalculateHeatRanks();
            }
            updateScoreSubtractButtons();
            updatePeriodControls();

            $('#matchNotes').on('change blur', function () { queueScoreAutoSave(); });
            $('#selectWinner').on('change', function () { queueScoreAutoSave(); });

            $('#eventForm').on('submit', function (e) {
                e.preventDefault();
                addEvent();
            });
        });

        function createMatchReport() {
            if (!matchCanHaveReport) {
                Swal.fire('Chưa thể tạo biên bản', 'Chỉ có thể tạo biên bản sau khi trận đấu đã kết thúc.', 'info');
                return;
            }

            const button = $('#btnCreateMatchReport');
            button.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span><span>Đang tạo...</span>');
            loadMatchReportPreview(true);
        }

        function loadMatchReportPreview(showError) {
            $.get('/TrongTai/BienBan', {
                tranDauId: matchId,
                giaiDauId: selectedTournamentId,
                embedded: true
            }).done(function (html) {
                $('#matchReportPreview').html(html).removeClass('d-none');
                $('#matchReportStatus').removeClass('bg-secondary-subtle text-secondary bg-danger-subtle text-danger')
                    .addClass('bg-success-subtle text-success')
                    .html('<i class="fa-solid fa-circle-check"></i><span>Biên bản đã sẵn sàng</span>');
                $('#btnCreateMatchReport').addClass('d-none').prop('disabled', false)
                    .html('<i class="fa-solid fa-file-circle-plus"></i><span>Tạo biên bản</span>');
                $('#btnExportMatchReport').removeClass('d-none');
                if (showError) {
                    document.getElementById('matchReportPanel')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            }).fail(function (xhr) {
                $('#btnCreateMatchReport').prop('disabled', false)
                    .html('<i class="fa-solid fa-file-circle-plus"></i><span>Tạo biên bản</span>');
                const message = xhr.responseText || 'Không tải được dữ liệu biên bản. Vui lòng thử lại.';
                if (showError) Swal.fire('Không thể tạo biên bản', message, 'error');
                else Swal.fire('Không thể làm mới biên bản', message, 'error');
            });
        }

        function exportMatchReportPdf() {
            const report = document.getElementById('officialReportContent');
            if (!report || typeof html2pdf === 'undefined') {
                Swal.fire('Chưa thể xuất PDF', 'Không tải được công cụ xuất PDF. Vui lòng tải lại trang và thử lại.', 'error');
                return;
            }

            const matchNumber = report.dataset.matchNumber || matchId;
            const sportName = report.dataset.sportName || 'MonThiDau';
            const safeSportName = sportName.normalize('NFD').replace(/[\u0300-\u036f]/g, '')
                .replace(/[^a-z0-9]+/gi, '_').replace(/^_+|_+$/g, '') || 'MonThiDau';
            const exportStage = document.createElement('div');
            exportStage.setAttribute('aria-hidden', 'true');
            exportStage.style.cssText = 'position:fixed;inset:0;width:100vw;min-height:100vh;overflow:visible;display:flex;justify-content:center;align-items:flex-start;background:#fff;z-index:2147483647;';
            const exportReport = report.cloneNode(true);
            exportReport.removeAttribute('id');
            exportReport.classList.add('pdf-exporting');
            exportReport.style.setProperty('width', '190mm', 'important');
            exportReport.style.setProperty('max-width', 'none', 'important');
            exportReport.style.setProperty('margin', '0 auto', 'important');
            exportReport.style.setProperty('box-sizing', 'border-box', 'important');
            exportReport.style.setProperty('box-shadow', 'none', 'important');
            exportStage.appendChild(exportReport);
            document.body.appendChild(exportStage);

            html2pdf().set({
                margin: [10, 10, 10, 10],
                filename: `BienBan_Tran_${matchNumber}_${safeSportName}.pdf`,
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2, useCORS: true, backgroundColor: '#ffffff', scrollX: 0, scrollY: 0 },
                jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' },
                pagebreak: { mode: [] }
            }).from(exportReport).save()
                .then(function () { Swal.fire({ icon: 'success', title: 'Đã xuất biên bản PDF', timer: 1500, showConfirmButton: false }); })
                .catch(function () { Swal.fire('Lỗi xuất PDF', 'Không thể tạo tệp PDF từ biên bản.', 'error'); })
                .finally(function () { exportStage.remove(); });
        }

        function openSignModal(role, roleTitle) {
            $('#signRole').val(role);
            $('#signModalTitle').text(`Ký Biên Bản: ${roleTitle}`);
            $('#signerNameInput').val('');
            const modalElement = document.getElementById('signModal');
            if (modalElement) bootstrap.Modal.getOrCreateInstance(modalElement).show();
        }

        $(document).on('submit', '#signForm', function (event) {
            event.preventDefault();
            const signerName = $('#signerNameInput').val().trim();
            if (!signerName) return;

            $.ajax({
                url: '/TrongTai/BienBan/SignReport',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    tranDauId: Number($('#signTranDauId').val()),
                    role: $('#signRole').val(),
                    signerName: signerName
                }),
                success: function (response) {
                    if (!response.success) {
                        Swal.fire('Lỗi', response.message || 'Không thể lưu chữ ký.', 'error');
                        return;
                    }
                    const modalElement = document.getElementById('signModal');
                    if (modalElement) bootstrap.Modal.getOrCreateInstance(modalElement).hide();
                    Swal.fire({ icon: 'success', title: 'Đã ký xác nhận', text: response.message, timer: 1300, showConfirmButton: false })
                        .then(function () { loadMatchReportPreview(false); });
                },
                error: function (xhr) {
                    Swal.fire('Lỗi', xhr.responseJSON?.message || 'Không thể lưu chữ ký biên bản.', 'error');
                }
            });
        });

        // ====================================================================
        // 1. TÍNH ĐIỂM THEO SET (BADMINTON, VOLLEYBALL, TABLE TENNIS)
        // ====================================================================
        function renderSets() {
            const tbody = $('#bodySets');
            if (!tbody.length) return;
            tbody.empty();

            setScoresList.forEach((s, idx) => {
                const isEditing = editingSetIndex === idx;
                let badge = '<span class="badge bg-secondary-subtle text-secondary font-monospace">-</span>';
                if (sportConfig && sportConfig.LoaiTheThuc === 'SetDiem') {
                    const evalSet = evaluateSingleSet(s.setNumber, s.score1, s.score2);
                    if (evalSet.isSetWon) {
                        badge = evalSet.winner === 1 
                            ? '<span class="badge bg-success font-monospace">Đội 1</span>'
                            : '<span class="badge bg-primary font-monospace">Đội 2</span>';
                    } else if (evalSet.isDeuce) {
                        badge = '<span class="badge bg-warning text-dark font-monospace">Deuce</span>';
                    }
                }
                if (!isSetSport) {
                    badge = idx === setScoresList.length - 1
                        ? '<span class="badge bg-primary-subtle text-primary">Đang nhập</span>'
                        : '<span class="badge bg-secondary-subtle text-secondary">Hiệp trước</span>';
                }

                const score1Cell = isEditing
                    ? `<input type="number" id="editSetScore1_${idx}" class="form-control form-control-sm text-center font-monospace fw-bold" min="0" step="1" value="${s.score1}" aria-label="Điểm đội 1 set ${s.setNumber}" />`
                    : `<span class="font-monospace fw-bold">${s.score1}</span>`;
                const score2Cell = isEditing
                    ? `<input type="number" id="editSetScore2_${idx}" class="form-control form-control-sm text-center font-monospace fw-bold" min="0" step="1" value="${s.score2}" aria-label="Điểm đội 2 set ${s.setNumber}" />`
                    : `<span class="font-monospace fw-bold">${s.score2}</span>`;
                const actionButtons = isEditing
                    ? `<button type="button" class="btn btn-sm btn-success" title="Lưu điểm set" onclick="saveSetEdit(${idx})" ${matchStatus === 'DangDau' ? '' : 'disabled'}><i class="fa-solid fa-check"></i></button>
                       <button type="button" class="btn btn-sm btn-outline-secondary" title="Hủy sửa" onclick="cancelSetEdit()"><i class="fa-solid fa-xmark"></i></button>`
                    : `<button type="button" class="btn btn-sm btn-outline-primary" title="Chỉnh sửa điểm set" onclick="beginSetEdit(${idx})" ${matchStatus === 'DangDau' ? '' : 'disabled'}><i class="fa-solid fa-pen-to-square me-1"></i>Sửa</button>
                       <button type="button" class="btn btn-sm btn-outline-danger" title="Xóa set" onclick="removeSet(${idx})" ${matchStatus === 'DangDau' ? '' : 'disabled'}><i class="fa-solid fa-trash-can"></i></button>`;

                const tr = `
                    <tr>
                        <td class="fw-bold text-secondary">${isSetSport ? 'Set' : 'Hiệp'} ${s.setNumber}</td>
                        <td>${score1Cell}</td>
                        <td>${score2Cell}</td>
                        <td>${badge}</td>
                        <td><div class="d-flex justify-content-center gap-1">${actionButtons}</div></td>
                    </tr>
                `;
                tbody.append(tr);
            });
        }

        function evaluateSingleSet(setNumber, s1, s2) {
            if (!sportConfig) return { isSetWon: false, winner: 0, isDeuce: false };

            const targetPts = (sportConfig.DiemHiepQuyetDinh && setNumber === sportConfig.SoHiepToiDa)
                ? sportConfig.DiemHiepQuyetDinh
                : (sportConfig.DiemMoiHiep || 21);
            const diffMin = sportConfig.CachBietDiemToiThieu || 2;
            const cap = Number(sportConfig.DiemToiDaMoiHiep) || 0;

            if (s1 >= targetPts && (s1 - s2) >= diffMin) return { isSetWon: true, winner: 1, isDeuce: false };
            if (s2 >= targetPts && (s2 - s1) >= diffMin) return { isSetWon: true, winner: 2, isDeuce: false };

            if (cap > 0 && s1 >= cap && s1 > s2) return { isSetWon: true, winner: 1, isDeuce: false };
            if (cap > 0 && s2 >= cap && s2 > s1) return { isSetWon: true, winner: 2, isDeuce: false };

            const isDeuce = (s1 >= targetPts - 1 && s2 >= targetPts - 1 && Math.abs(s1 - s2) < diffMin);
            return { isSetWon: false, winner: 0, isDeuce: isDeuce };
        }

        function beginSetEdit(idx) {
            if (matchStatus !== 'DangDau') return;
            if (editingSetIndex !== null) {
                Swal.fire('Đang chỉnh sửa set', 'Hãy lưu hoặc hủy set đang sửa trước.', 'info');
                return;
            }
            editingSetIndex = idx;
            renderSets();
            $(`#editSetScore1_${idx}`).trigger('focus').trigger('select');
        }

        function saveSetEdit(idx) {
            if (matchStatus !== 'DangDau') return;
            const rawScore1 = $(`#editSetScore1_${idx}`).val();
            const rawScore2 = $(`#editSetScore2_${idx}`).val();
            const newScore1 = Number(rawScore1);
            const newScore2 = Number(rawScore2);
            if (rawScore1 === '' || rawScore2 === '' || !Number.isInteger(newScore1) || !Number.isInteger(newScore2) || newScore1 < 0 || newScore2 < 0) {
                Swal.fire('Điểm không hợp lệ', 'Điểm mỗi đội phải là số nguyên không âm.', 'warning');
                return;
            }

            setScoresList[idx].score1 = newScore1;
            setScoresList[idx].score2 = newScore2;
            editingSetIndex = null;
            renderSets();
            if (isSetSport) recalculateSetsWon();
            else {
                recalculatePeriodTotals();
                checkTieBreakCondition();
            }
            queueScoreAutoSave();
        }

        function cancelSetEdit() {
            editingSetIndex = null;
            renderSets();
        }

        function ensureNoSetEdit() {
            if (editingSetIndex === null) return true;
            Swal.fire('Đang chỉnh sửa set', 'Hãy lưu hoặc hủy set đang sửa trước khi tiếp tục nhập điểm.', 'info');
            return false;
        }

        function updateScoreSubtractButtons() {
            const currentPeriod = setScoresList.length > 0
                ? setScoresList[setScoresList.length - 1]
                : { score1: 0, score2: 0 };
            const currentSetComplete = isSetSport && evaluateSingleSet(currentPeriod.setNumber, currentPeriod.score1, currentPeriod.score2).isSetWon;
            const setsToWin = Number(sportConfig?.SoHiepThangDeThangTran) || 2;
            const matchAlreadyDecided = isSetSport && (score1 >= setsToWin || score2 >= setsToWin);
            const canAdjust = matchStatus === 'DangDau' && !currentSetComplete && !matchAlreadyDecided;
            $('#btnSubtractScore1').prop('disabled', !canAdjust || currentPeriod.score1 <= 0);
            $('#btnSubtractScore2').prop('disabled', !canAdjust || currentPeriod.score2 <= 0);
            $('#btnAddScore1Primary, #btnAddScore1Two, #btnAddScore1Three, #btnAddScore2Primary, #btnAddScore2Two, #btnAddScore2Three')
                .prop('disabled', !canAdjust);
        }

        function reconcileCurrentPeriodScores() {
            if (setScoresList.length === 0) {
                setScoresList.push({ setNumber: 1, score1: 0, score2: 0 });
            }

            const recordedScore1 = setScoresList.reduce((sum, period) => sum + period.score1, 0);
            const recordedScore2 = setScoresList.reduce((sum, period) => sum + period.score2, 0);
            const currentPeriod = setScoresList[setScoresList.length - 1];
            currentPeriod.score1 += Math.max(0, score1 - recordedScore1);
            currentPeriod.score2 += Math.max(0, score2 - recordedScore2);
        }

        function recalculatePeriodTotals() {
            score1 = setScoresList.reduce((sum, period) => sum + Number(period.score1 || 0), 0);
            score2 = setScoresList.reduce((sum, period) => sum + Number(period.score2 || 0), 0);
            $('#displayScore1').text(score1);
            $('#displayScore2').text(score2);
            if ($('#activePeriodLabel').length) {
                const activeNumber = setScoresList.length ? setScoresList[setScoresList.length - 1].setNumber : 1;
                $('#activePeriodLabel').text(`Đang nhập điểm: Hiệp ${activeNumber}`);
            }
            updateScoreSubtractButtons();
        }

        function recalculateSetsWon() {
            let won1 = 0, won2 = 0;
            setScoresList.forEach(s => {
                const evalSet = evaluateSingleSet(s.setNumber, s.score1, s.score2);
                if (evalSet.isSetWon) {
                    if (evalSet.winner === 1) won1++;
                    else if (evalSet.winner === 2) won2++;
                }
            });

            score1 = won1;
            score2 = won2;
            const currentSet = setScoresList.length > 0
                ? setScoresList[setScoresList.length - 1]
                : { score1: 0, score2: 0 };
            $('#displayScore1').text(currentSet.score1 ?? currentSet.Score1 ?? 0);
            $('#displayScore2').text(currentSet.score2 ?? currentSet.Score2 ?? 0);
            $('#displayMatchSetScore').text(`Set thắng ${won1} - ${won2}`);
            updateScoreSubtractButtons();

            const setsToWin = sportConfig?.SoHiepThangDeThangTran || 2;
            if (won1 >= setsToWin) {
                $('#autoWinnerAlert').removeClass('d-none');
                $('#autoWinnerText').text(`${tenDoi1} đã thắng ${won1} set -> Đủ điều kiện thắng trận!`);
                $('#selectWinner').val('1');
            } else if (won2 >= setsToWin) {
                $('#autoWinnerAlert').removeClass('d-none');
                $('#autoWinnerText').text(`${tenDoi2} đã thắng ${won2} set -> Đủ điều kiện thắng trận!`);
                $('#selectWinner').val('2');
            } else {
                $('#autoWinnerAlert').addClass('d-none');
            }
            updatePeriodControls();
        }

        function updatePeriodControls() {
            const button = $('#btnAddPeriod');
            if (!button.length) return;

            const maxPeriods = Number(sportConfig?.SoHiepToiDa) || (isSetSport ? 3 : 2);
            if (isSetSport) {
                const setsToWin = Number(sportConfig?.SoHiepThangDeThangTran) || 2;
                const previousSet = setScoresList.length ? setScoresList[setScoresList.length - 1] : null;
                const previousSetWon = previousSet && evaluateSingleSet(previousSet.setNumber, previousSet.score1, previousSet.score2).isSetWon;
                const matchDecided = score1 >= setsToWin || score2 >= setsToWin;
                const canStartNext = matchStatus === 'DangDau' && previousSetWon && !matchDecided && setScoresList.length < maxPeriods;
                const nextLabel = setScoresList.length ? `Bắt đầu set ${setScoresList.length + 1}` : 'Bắt đầu set 1';
                button.prop('disabled', !canStartNext).html(`<i class="fa-solid fa-plus me-1"></i>${nextLabel}`);
                return;
            }

            const canStartNext = matchStatus === 'DangDau' && setScoresList.length < maxPeriods;
            const nextLabel = canStartNext ? `Sang hiệp ${setScoresList.length + 1}` : `Đủ ${maxPeriods} hiệp chính`;
            button.prop('disabled', !canStartNext).html(`<i class="fa-solid fa-plus me-1"></i>${nextLabel}`);
        }

        function addNewSet() {
            if (matchStatus !== 'DangDau') return;
            if (!ensureNoSetEdit()) return;
            const nextNum = setScoresList.length + 1;
            const maxSets = Number(sportConfig?.SoHiepToiDa) || (isSetSport ? 3 : 2);
            if (nextNum > maxSets) {
                Swal.fire('Đã đạt giới hạn', isSetSport
                    ? `Môn này được cấu hình tối đa ${maxSets} set.`
                    : `Môn này được cấu hình ${maxSets} hiệp chính.`, 'info');
                return;
            }
            if (isSetSport) {
                const setsToWin = Number(sportConfig?.SoHiepThangDeThangTran) || 2;
                const previousSet = setScoresList[setScoresList.length - 1];
                if (score1 >= setsToWin || score2 >= setsToWin) {
                    Swal.fire('Trận đã đủ set thắng', 'Không thể bắt đầu thêm set sau khi đã xác định bên thắng.', 'info');
                    return;
                }
                if (!previousSet || !evaluateSingleSet(previousSet.setNumber, previousSet.score1, previousSet.score2).isSetWon) {
                    Swal.fire('Set hiện tại chưa kết thúc', 'Chỉ bắt đầu set tiếp theo sau khi set hiện tại đã có đội thắng theo luật.', 'info');
                    return;
                }
            }
            setScoresList.push({ setNumber: nextNum, score1: 0, score2: 0 });
            renderSets();
            if (isSetSport) recalculateSetsWon();
            else recalculatePeriodTotals();
            updatePeriodControls();
            queueScoreAutoSave();
        }

        function removeSet(idx) {
            if (matchStatus !== 'DangDau') return;
            if (!ensureNoSetEdit()) return;
            setScoresList.splice(idx, 1);
            setScoresList.forEach((s, i) => s.setNumber = i + 1);
            if (isSetSport) recalculateSetsWon();
            else recalculatePeriodTotals();
            renderSets();
            updatePeriodControls();
            queueScoreAutoSave();
        }

        function adjustScore(team, delta) {
            if (matchStatus !== 'DangDau') {
                Swal.fire('Trận chưa bắt đầu', 'Chỉ có thể điều chỉnh điểm khi trận đang diễn ra.', 'info');
                return;
            }
            if (!ensureNoSetEdit()) return;
            if (isSetSport) {
                // Với môn theo set, cộng điểm pha đấu vào set hiện tại.
                if (setScoresList.length === 0) setScoresList.push({ setNumber: 1, score1: 0, score2: 0 });
                const lastSet = setScoresList[setScoresList.length - 1];
                if (evaluateSingleSet(lastSet.setNumber, lastSet.score1, lastSet.score2).isSetWon) {
                    Swal.fire('Set đã kết thúc', 'Hãy bắt đầu set tiếp theo hoặc sửa lại điểm set đã ghi.', 'info');
                    return;
                }
                const setsToWin = Number(sportConfig?.SoHiepThangDeThangTran) || 2;
                if (score1 >= setsToWin || score2 >= setsToWin) {
                    Swal.fire('Trận đã đủ set thắng', 'Không thể cộng thêm điểm sau khi trận đã xác định đội thắng.', 'info');
                    return;
                }
                if (team === 1) lastSet.score1 = Math.max(0, lastSet.score1 + delta);
                else lastSet.score2 = Math.max(0, lastSet.score2 + delta);
                renderSets();
                recalculateSetsWon();
            } else {
                // Với môn tính điểm theo hiệp, chỉ sửa hiệp hiện tại rồi cộng lại toàn bộ các hiệp.
                if (setScoresList.length === 0) {
                    setScoresList.push({ setNumber: 1, score1: 0, score2: 0 });
                }
                const currentPeriod = setScoresList[setScoresList.length - 1];
                if (team === 1) currentPeriod.score1 = Math.max(0, currentPeriod.score1 + delta);
                else currentPeriod.score2 = Math.max(0, currentPeriod.score2 + delta);

                renderSets();
                recalculatePeriodTotals();
                checkTieBreakCondition();
            }
            queueScoreAutoSave();
        }

        function checkTieBreakCondition() {
            if (isSetSport || isHeatMatch) return;
            refreshTieBreakUI();
            if (matchStatus === 'KetThuc') {
                const outcome = getTimedMatchOutcome();
                $('#selectWinner').val(outcome.winner || '');
            }
        }

        function readOptionalScore(selector) {
            const raw = $(selector).val();
            if (raw === undefined || raw === null || String(raw).trim() === '') return null;
            const parsed = Number(raw);
            return Number.isInteger(parsed) && parsed >= 0 ? parsed : null;
        }

        function getTimedMatchOutcome() {
            if (score1 > score2) return { winner: '1' };
            if (score2 > score1) return { winner: '2' };

            if (!isKnockout && sportConfig?.ChoPhepHoaVongBang !== false) return { winner: 'draw' };

            let final1 = score1;
            let final2 = score2;
            if (isKnockout && hasExtraTime) {
                extraTime1 = readOptionalScore('#inputExtraTime1');
                extraTime2 = readOptionalScore('#inputExtraTime2');
                if (extraTime1 === null || extraTime2 === null) {
                    return { winner: null, message: 'Hãy nhập điểm hiệp phụ cho cả hai đội.' };
                }
                final1 += extraTime1;
                final2 += extraTime2;
                if (final1 !== final2) return { winner: final1 > final2 ? '1' : '2' };
            }

            if (hasPenalty) {
                pen1 = readOptionalScore('#inputPenalty1');
                pen2 = readOptionalScore('#inputPenalty2');
                if (pen1 === null || pen2 === null) {
                    return { winner: null, message: 'Hãy nhập kết quả luân lưu cho cả hai đội.' };
                }
                if (pen1 !== pen2) return { winner: pen1 > pen2 ? '1' : '2' };
                return { winner: null, message: 'Kết quả luân lưu vẫn hòa; chưa thể chốt trận.' };
            }

            return { winner: null, message: isKnockout
                ? 'Trận loại trực tiếp đang hòa nhưng chưa có cách phân định hợp lệ theo cấu hình môn.'
                : 'Môn này không cho phép hòa ở giai đoạn hiện tại và chưa có kết quả phân định.' };
        }

        function refreshTieBreakUI() {
            const requiresResolution = isKnockout || sportConfig?.ChoPhepHoaVongBang === false;
            const showTieBreak = requiresResolution && score1 === score2;
            $('#tieBreakCard').toggleClass('d-none', !showTieBreak);

            if ($('#penaltySection').length) {
                let showPenalty = !hasExtraTime || !isKnockout;
                if (hasExtraTime && isKnockout) {
                    const ot1 = readOptionalScore('#inputExtraTime1');
                    const ot2 = readOptionalScore('#inputExtraTime2');
                    showPenalty = ot1 !== null && ot2 !== null && (score1 + ot1 === score2 + ot2);
                }
                $('#penaltySection').toggleClass('d-none', !showTieBreak || !showPenalty);
            }
        }

        function onTieBreakScoreChanged() {
            extraTime1 = readOptionalScore('#inputExtraTime1');
            extraTime2 = readOptionalScore('#inputExtraTime2');
            refreshTieBreakUI();
            checkTieBreakCondition();
            queueScoreAutoSave();
        }

        function onPenaltyScoreChanged() {
            pen1 = readOptionalScore('#inputPenalty1');
            pen2 = readOptionalScore('#inputPenalty2');
            checkTieBreakCondition();
            queueScoreAutoSave();
        }

        function renderMatchClock() {
            let displayedSeconds = elapsedMatchSeconds;
            if (matchClockStartedAt !== null) {
                displayedSeconds += Math.floor((Date.now() - matchClockStartedAt) / 1000);
            }
            const hours = Math.floor(displayedSeconds / 3600);
            const minutes = Math.floor((displayedSeconds % 3600) / 60);
            const seconds = displayedSeconds % 60;
            $('#matchElapsedClock').text(
                String(hours).padStart(2, '0') + ':' +
                String(minutes).padStart(2, '0') + ':' +
                String(seconds).padStart(2, '0'));
        }

        // ====================================================================
        // 2. TÍNH ĐIỂM XẾP HẠNG / LƯỢT THI (HEAT LEADERBOARD)
        // ====================================================================
        function onLaneTimeChanged(input) {
            recalculateHeatRanks();
        }

        function onLaneStatusChanged(tpId) {
            recalculateHeatRanks();
        }

        function recalculateHeatRanks() {
            const rows = $('#bodyHeatLanes tr').toArray();
            if (rows.length === 0) return;

            const kyLuc = sportConfig?.KyLucHienTai || null;
            const cangNhoCangTot = (sportConfig?.TieuChiXepHangThanhTich !== 'CangLonCangTot');
            const secondarySmallerIsBetter = sportConfig?.TieuChiPhuCangNhoCangTot !== false;

            const validItems = [];
            rows.forEach(r => {
                const $r = $(r);
                const tpId = $r.data('tp-id');
                const st = $r.find(`input[name="laneStatus_${tpId}"]:checked`).val() || 'ThamGia';
                const timeStr = $r.find('.heat-time-input').val().trim();
                const val = parseFloat(timeStr);
                const secondaryRaw = $r.find('.heat-tiebreak-input').val();
                const secondary = secondaryRaw !== undefined && String(secondaryRaw).trim() !== '' ? Number(secondaryRaw) : null;

                if (st === 'ThamGia' && !isNaN(val) && val > 0) {
                    validItems.push({ row: $r, val: val, secondary: Number.isFinite(secondary) ? secondary : null });
                } else {
                    $r.find('.lane-rank-badge').text(st !== 'ThamGia' ? st : '--').removeClass('bg-success bg-warning bg-primary bg-danger text-dark text-white').addClass('bg-secondary').removeData('rank');
                    $r.find('.lane-record-notice').html('<small class="text-muted">--</small>');
                }
            });

            const unresolvedPrimaryValues = new Set();
            const primaryGroups = new Map();
            validItems.forEach(item => {
                const group = primaryGroups.get(item.val) || [];
                group.push(item);
                primaryGroups.set(item.val, group);
            });
            primaryGroups.forEach((group, primary) => {
                if (group.length > 1 && (group.some(item => item.secondary === null) ||
                    new Set(group.map(item => item.secondary)).size !== group.length)) {
                    unresolvedPrimaryValues.add(primary);
                }
            });

            validItems.sort((a, b) => {
                const primaryOrder = cangNhoCangTot ? (a.val - b.val) : (b.val - a.val);
                if (primaryOrder !== 0) return primaryOrder;
                if (a.secondary === null) return b.secondary === null ? 0 : 1;
                if (b.secondary === null) return -1;
                return secondarySmallerIsBetter ? a.secondary - b.secondary : b.secondary - a.secondary;
            });

            validItems.forEach((item, idx) => {
                const unresolvedSecondaryTie = unresolvedPrimaryValues.has(item.val);
                const rank = idx + 1;
                const $badge = item.row.find('.lane-rank-badge');
                if (unresolvedSecondaryTie) {
                    $badge.text('Cần chỉ số phụ').removeClass('bg-secondary bg-success bg-warning bg-primary text-dark text-white').addClass('bg-danger text-white').removeData('rank');
                } else {
                    $badge.text('#' + rank).removeClass('bg-secondary bg-danger bg-success bg-warning bg-primary text-dark text-white').data('rank', rank);
                }
                if (unresolvedSecondaryTie) {
                    // Không hiển thị huy chương/thứ hạng giả khi tiêu chí phụ chưa phân định được.
                } else if (rank === 1) $badge.addClass('bg-warning text-dark');
                else if (rank <= 3) $badge.addClass('bg-success text-white');
                else $badge.addClass('bg-primary text-white');

                // Check kỷ lục
                const $notice = item.row.find('.lane-record-notice');
                if (kyLuc && ((cangNhoCangTot && item.val < kyLuc) || (!cangNhoCangTot && item.val > kyLuc))) {
                    $notice.html('<span class="badge bg-danger text-white animate-pulse"><i class="fa-solid fa-fire me-1"></i>PHÁ KỶ LỤC!</span>');
                } else {
                    $notice.html('<small class="text-success font-monospace">Hợp lệ</small>');
                }
            });
        }

        // ====================================================================
        // 3. DIỄN BIẾN SỰ KIỆN TRẬN ĐẤU (MATCH EVENTS)
        // ====================================================================
        function renderEvents() {
            const container = $('#eventContainer');
            if (!container.length) return;
            container.empty();

            if (eventsList.length === 0) {
                container.html('<div class="text-center py-4 text-muted small"><i class="fa-solid fa-clipboard-check me-1"></i> Chưa có sự kiện nào được ghi nhận.</div>');
                return;
            }

            eventsList.sort((a, b) => a.minute - b.minute);

            eventsList.forEach((ev, idx) => {
                let icon = '⚽', badgeClass = 'bg-primary-subtle text-primary';
                if (ev.type === 'yellow_card') { icon = '🟨'; badgeClass = 'bg-warning-subtle text-warning border border-warning'; }
                else if (ev.type === 'red_card') { icon = '🟥'; badgeClass = 'bg-danger-subtle text-danger border border-danger'; }
                else if (ev.type === 'foul') { icon = '⚠️'; badgeClass = 'bg-secondary-subtle text-secondary'; }
                else if (ev.type === 'sub') { icon = '🔄'; badgeClass = 'bg-info-subtle text-info'; }

                const teamName = ev.team === 1 ? '@(Model?.TenDoi1 ?? "Đội 1")' : '@(Model?.TenDoi2 ?? "Đội 2")';

                const item = `
                    <div class="p-2 rounded-2 bg-white border mb-2 d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-2 overflow-hidden pe-2">
                            <span class="badge bg-dark font-monospace" style="font-size: 11px;">${ev.minute}'</span>
                            <span class="fs-6">${icon}</span>
                            <div class="overflow-hidden lh-sm">
                                <span class="fw-semibold text-dark small text-truncate d-block">${ev.player || 'VĐV'} (${teamName})</span>
                                ${ev.notes ? `<small class="text-muted" style="font-size: 11px;">${ev.notes}</small>` : ''}
                            </div>
                        </div>
                        <button type="button" class="btn btn-sm text-danger p-0 flex-shrink-0" onclick="removeEvent(${idx})">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                `;
                container.append(item);
            });
        }

        function openEventModal() {
            if (matchStatus !== 'DangDau') return;
            $('#evMinute').val(1);
            $('#evPlayer').val('');
            $('#evNotes').val('');
            eventModal.show();
        }

        function addEvent() {
            if (matchStatus !== 'DangDau') return;
            const eventType = $('#evType').val();
            if (!hasPenaltyCards && (eventType === 'yellow_card' || eventType === 'red_card')) {
                Swal.fire('Không áp dụng thẻ', 'Môn thi đấu này không được cấu hình thẻ phạt.', 'warning');
                return;
            }
            const ev = {
                id: Date.now(),
                minute: parseInt($('#evMinute').val()) || 1,
                type: eventType,
                team: parseInt($('#evTeam').val()) || 1,
                player: $('#evPlayer').val().trim(),
                notes: $('#evNotes').val().trim()
            };
            eventsList.push(ev);
            renderEvents();
            eventModal.hide();
            queueScoreAutoSave();
        }

        function removeEvent(idx) {
            if (matchStatus !== 'DangDau') return;
            eventsList.splice(idx, 1);
            renderEvents();
            queueScoreAutoSave();
        }

        // ====================================================================
        // 4. LƯU TẠM & HOÀN TẤT TRẬN ĐẤU (AJAX / COMPLETE MATCH)
        // ====================================================================
        function getHeatResultsPayload() {
            const heatPayload = [];
            $('#bodyHeatLanes tr').each(function () {
                const $r = $(this);
                const tpId = $r.data('tp-id');
                const dkId = $r.data('dk-id');
                const lane = $r.data('lane');
                const st = $r.find(`input[name="laneStatus_${tpId}"]:checked`).val() || 'ThamGia';
                const timeStr = $r.find('.heat-time-input').val().trim();
                const secondaryRaw = $r.find('.heat-tiebreak-input').val();
                const rankText = $r.find('.lane-rank-badge').text().replace('#', '');
                const rank = parseInt(rankText) || null;

                heatPayload.push({
                    thanhPhanTranDauId: tpId,
                    dangKyThiDauId: dkId,
                    soLane: lane,
                    giaTri: parseFloat(timeStr) || null,
                    giaTriPhu: secondaryRaw !== undefined && String(secondaryRaw).trim() !== '' ? Number(secondaryRaw) : null,
                    ketQuaText: timeStr || st,
                    trangThai: st,
                    xepHang: rank
                });
            });
            return heatPayload;
        }

        function validateHeatTieBreaks() {
            const primaryGroups = new Map();
            $('#bodyHeatLanes tr').each(function () {
                const $row = $(this);
                const tpId = $row.data('tp-id');
                const status = $row.find(`input[name="laneStatus_${tpId}"]:checked`).val() || 'ThamGia';
                const primary = parseFloat($row.find('.heat-time-input').val().trim());
                if (status !== 'ThamGia' || !Number.isFinite(primary) || primary <= 0) return;

                const rawSecondary = $row.find('.heat-tiebreak-input').val();
                const secondary = rawSecondary !== undefined && String(rawSecondary).trim() !== ''
                    ? Number(rawSecondary)
                    : null;
                const group = primaryGroups.get(primary) || [];
                group.push(secondary);
                primaryGroups.set(primary, group);
            });

            const hasUnresolvedTie = Array.from(primaryGroups.values()).some(group =>
                group.length > 1 && (group.some(value => value === null || !Number.isFinite(value)) ||
                    new Set(group).size !== group.length));
            if (hasUnresolvedTie) {
                recalculateHeatRanks();
                Swal.fire({
                    icon: 'warning',
                    title: 'Chưa phân định được thứ hạng',
                    text: 'Có VĐV bằng thành tích chính. Hãy nhập chỉ số phụ khác nhau cho từng VĐV trước khi chốt lượt thi.'
                });
                return false;
            }
            return true;
        }

        function buildResultPayload() {
            return {
                tranDauId: matchId,
                score1: score1,
                score2: score2,
                penaltyScore1: readOptionalScore('#inputPenalty1'),
                penaltyScore2: readOptionalScore('#inputPenalty2'),
                extraTimeScore1: readOptionalScore('#inputExtraTime1'),
                extraTimeScore2: readOptionalScore('#inputExtraTime2'),
                winner: $('#selectWinner').val(),
                trangThai: matchStatus,
                setScores: setScoresList.map(set => ({ ...set })),
                events: eventsList.map(event => ({ ...event })),
                ghiChu: $('#matchNotes').val().trim()
            };
        }

        function queueScoreAutoSave(immediate = false) {
            if (matchStatus !== 'DangDau') return;
            pendingScoreSave = buildResultPayload();
            lastAutoSaveFailed = false;
            $('#btnCompleteMatch').prop('disabled', true);
            $('#scoreAutoSaveStatus').removeClass('text-danger text-success').addClass('text-muted')
                .html('<i class="fa-solid fa-cloud-arrow-up text-primary me-1"></i>Đang lưu tỷ số và điểm từng hiệp...');
            if (scoreSaveTimer !== null) {
                clearTimeout(scoreSaveTimer);
                scoreSaveTimer = null;
            }
            if (immediate) {
                flushScoreAutoSave();
            } else {
                scoreSaveTimer = setTimeout(function () {
                    scoreSaveTimer = null;
                    flushScoreAutoSave();
                }, 250);
            }
        }

        function flushScoreAutoSave() {
            if (scoreSaveInProgress || !pendingScoreSave) return;
            const payload = pendingScoreSave;
            pendingScoreSave = null;
            scoreSaveInProgress = true;
            $.ajax({
                url: '/TrongTai/KetQua/SaveResult',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    if (res.success) {
                        lastAutoSaveFailed = false;
                        const savedAt = new Date().toLocaleTimeString('vi-VN');
                        $('#scoreAutoSaveStatus').removeClass('text-danger text-muted').addClass('text-success')
                            .html(`<i class="fa-solid fa-circle-check me-1"></i>Đã tự lưu tỷ số và điểm từng hiệp lúc ${savedAt}.`);
                    } else {
                        lastAutoSaveFailed = true;
                        $('#scoreAutoSaveStatus').removeClass('text-success text-muted').addClass('text-danger')
                            .text(res.message || 'Không thể tự lưu điểm. Hãy thử bấm Lưu Tạm Diễn Biến.');
                    }
                },
                error: function (xhr) {
                    lastAutoSaveFailed = true;
                    const message = xhr.responseJSON?.message || 'Mất kết nối máy chủ; điểm chưa được xác nhận đã lưu.';
                    $('#scoreAutoSaveStatus').removeClass('text-success text-muted').addClass('text-danger').text(message);
                },
                complete: function () {
                    scoreSaveInProgress = false;
                    if (pendingScoreSave) {
                        flushScoreAutoSave();
                        return;
                    }
                    $('#btnCompleteMatch').prop('disabled', lastAutoSaveFailed);
                }
            });
        }

        function saveDraftResult() {
            if (matchStatus !== 'DangDau') return;
            if (!ensureNoSetEdit()) return;
            queueScoreAutoSave(true);
        }

        function startMatch() {
            const button = $('#btnStartMatch');
            if (!button.length || matchStatus !== 'ChuaDau') return;
            button.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Đang bắt đầu...');
            $.ajax({
                url: '/TrongTai/KetQua/StartMatch',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ tranDauId: matchId }),
                success: function (res) {
                    if (res.success) {
                        window.location.reload();
                        return;
                    }
                    button.prop('disabled', false).html('<i class="fa-solid fa-play me-1"></i>Bắt đầu');
                    Swal.fire('Không thể bắt đầu', res.message || 'Không thể chuyển trận sang trạng thái đang diễn ra.', 'error');
                },
                error: function (xhr) {
                    button.prop('disabled', false).html('<i class="fa-solid fa-play me-1"></i>Bắt đầu');
                    const message = xhr.responseJSON?.message || 'Không thể kết nối máy chủ để bắt đầu trận.';
                    Swal.fire('Không thể bắt đầu', message, 'error');
                }
            });
        }

        function completeMatchFinal() {
            if (matchStatus !== 'DangDau') {
                Swal.fire('Chưa thể hoàn tất', 'Chỉ có thể hoàn tất trận khi trận đang diễn ra.', 'info');
                return;
            }
            if (lastAutoSaveFailed || scoreSaveInProgress || pendingScoreSave || scoreSaveTimer !== null) {
                Swal.fire('Điểm chưa được lưu', 'Hãy đợi hệ thống tự lưu xong hoặc bấm “Lưu Tạm Diễn Biến” để thử lưu lại trước khi chốt trận.', 'warning');
                return;
            }
            if (!ensureNoSetEdit()) return;
            if (isHeatMatch && !validateHeatTieBreaks()) return;
            if (!isHeatMatch && isTimeSport) {
                const expectedPeriods = Number(sportConfig?.SoHiepToiDa) || 2;
                if (setScoresList.length !== expectedPeriods) {
                    Swal.fire('Chưa đủ hiệp chính', `Cần ghi nhận đủ ${expectedPeriods} hiệp trước khi chốt trận.`, 'warning');
                    return;
                }
                recalculatePeriodTotals();
            }
            if (!isHeatMatch && isSetSport) recalculateSetsWon();
            let winnerVal = $('#selectWinner').val();

            if (!isHeatMatch && !isSetSport) {
                const outcome = getTimedMatchOutcome();
                if (!outcome.winner) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Chưa phân định được kết quả',
                        text: outcome.message || 'Hãy hoàn tất tiêu chí phân định hòa đã cấu hình trước khi chốt trận.'
                    });
                    return;
                }
                winnerVal = outcome.winner;
            }

            const payload = {
                tranDauId: matchId,
                score1: score1,
                score2: score2,
                penaltyScore1: readOptionalScore('#inputPenalty1'),
                penaltyScore2: readOptionalScore('#inputPenalty2'),
                extraTimeScore1: readOptionalScore('#inputExtraTime1'),
                extraTimeScore2: readOptionalScore('#inputExtraTime2'),
                winner: winnerVal,
                trangThai: 'KetThuc',
                setScores: setScoresList,
                events: eventsList,
                heatResults: isHeatMatch ? getHeatResultsPayload() : null,
                ghiChu: $('#matchNotes').val().trim()
            };

            Swal.fire({
                title: 'Xác nhận hoàn tất trận đấu?',
                text: 'Hệ thống sẽ chốt tỷ số chính thức, tính toán bảng xếp hạng hoặc tự động đẩy đội thắng vào nhánh đấu kế tiếp!',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#198754',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Đồng ý, Chốt kết quả!',
                cancelButtonText: 'Xem lại'
            }).then((result) => {
                if (result.isConfirmed) {
                    $('#btnCompleteMatch').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Đang xử lý...');

                    $.ajax({
                        url: '/TrongTai/KetQua/CompleteMatch',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(payload),
                        success: function (res) {
                            $('#btnCompleteMatch').prop('disabled', false).html('<i class="fa-solid fa-trophy me-1"></i> Hoàn Tất & Xác Nhận Kết Quả');
                            if (res.success) {
                                let detailsHtml = `<div class="text-start mt-3">`;
                                if (res.winnerName) {
                                    detailsHtml += `<p class="mb-2">🏆 <strong>Đội/VĐV thắng cuộc:</strong> <span class="text-success">${res.winnerName}</span></p>`;
                                } else if (res.isDraw) {
                                    detailsHtml += `<p class="mb-2">🤝 <strong>Kết quả:</strong> <span class="text-primary">Hòa chung cuộc</span></p>`;
                                }

                                if (res.standingsUpdateNotice) {
                                    detailsHtml += `<div class="alert alert-info py-2 px-3 small mb-2"><i class="fa-solid fa-table me-1"></i> ${res.standingsUpdateNotice}</div>`;
                                }
                                if (res.nextMatchNotice) {
                                    detailsHtml += `<div class="alert alert-success py-2 px-3 small mb-2"><i class="fa-solid fa-arrow-right-arrow-left me-1"></i> ${res.nextMatchNotice}</div>`;
                                }
                                if (res.medalsAwarded && res.medalsAwarded.length > 0) {
                                    detailsHtml += `<div class="alert alert-warning py-2 px-3 small mb-0 fw-bold"><i class="fa-solid fa-medal me-1"></i> Trao huy chương: ${res.medalsAwarded.join(' • ')}</div>`;
                                }
                                detailsHtml += `</div>`;

                                Swal.fire({
                                    icon: 'success',
                                    title: 'Đã hoàn tất trận đấu thành công!',
                                    html: detailsHtml,
                                    confirmButtonText: 'Đóng & Tải lại',
                                    confirmButtonColor: '#0d6efd'
                                }).then(() => {
                                    window.location.reload();
                                });
                            } else {
                                Swal.fire('Lỗi xử lý', res.message || 'Không thể chốt kết quả trận đấu.', 'error');
                            }
                        },
                        error: function (xhr) {
                            $('#btnCompleteMatch').prop('disabled', false).html('<i class="fa-solid fa-trophy me-1"></i> Hoàn Tất & Xác Nhận Kết Quả');
                            Swal.fire('Lỗi', 'Lỗi kết nối máy chủ hoặc dịch vụ xử lý.', 'error');
                        }
                    });
                }
            });
        }
    </script>
}
