@model List<Dms.Application.DTOs.ScanConflictItemDto>
@{
    ViewData["Title"] = "Kiểm Tra Trùng Lịch & Quá Tải Trọng Tài";
    var trungGioCount = Model?.Count(c => c.LoaiXungDot == "TrungGio") ?? 0;
    var thieuNghiCount = Model?.Count(c => c.LoaiXungDot == "ThieuThoiGianNghi") ?? 0;
    var quaTaiCount = Model?.Count(c => c.LoaiXungDot == "QuaTaiSoTran") ?? 0;
    var totalIssues = Model?.Count ?? 0;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1 text-dark">
            <i class="fa-solid fa-shield-halved text-danger me-2"></i> Giám Sát Trùng Lịch & Quá Tải Trọng Tài
        </h4>
        <p class="text-muted small mb-0">
            Tự động phát hiện vi phạm: Trực tiếp trùng giờ, thiếu thời gian đệm nghỉ hồi sức giữa 2 trận (<code>NghiToiThieuTrongTaiPhut</code>), và quá tải số trận trong ngày (<code>SoTranToiDaMoiTrongTaiMoiNgay</code>).
        </p>
    </div>
    <div>
        <a href="/TruongBanTrongTai/KiemTraTrungLich" class="btn btn-outline-primary shadow-sm">
            <i class="fa-solid fa-arrows-rotate me-1"></i> Quét Lại Toàn Giải
        </a>
    </div>
</div>

@if (totalIssues > 0)
{
    <!-- Banner thống kê vi phạm -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 bg-danger bg-opacity-10 border-start border-danger border-4">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">Trực Tiếp Trùng Giờ</div>
                        <div class="fs-4 fw-bold text-danger">@trungGioCount <span class="fs-6 fw-normal text-muted">ca</span></div>
                    </div>
                    <div class="rounded-circle bg-danger text-white d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                        <i class="fa-solid fa-triangle-exclamation fs-5"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 bg-warning bg-opacity-10 border-start border-warning border-4">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">Thiếu Đệm Nghỉ Hồi Sức</div>
                        <div class="fs-4 fw-bold text-warning-emphasis">@thieuNghiCount <span class="fs-6 fw-normal text-muted">ca</span></div>
                    </div>
                    <div class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                        <i class="fa-solid fa-bed fs-5"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 bg-primary bg-opacity-10 border-start border-primary border-4">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">Quá Tải Số Trận / Ngày</div>
                        <div class="fs-4 fw-bold text-primary">@quaTaiCount <span class="fs-6 fw-normal text-muted">ca</span></div>
                    </div>
                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                        <i class="fa-solid fa-battery-empty fs-5"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bộ lọc nhanh -->
    <div class="d-flex gap-2 mb-3">
        <button type="button" class="btn btn-sm btn-dark filter-btn active" onclick="filterConflicts('all')">Tất cả (@totalIssues)</button>
        <button type="button" class="btn btn-sm btn-outline-danger filter-btn" onclick="filterConflicts('TrungGio')">Trùng giờ (@trungGioCount)</button>
        <button type="button" class="btn btn-sm btn-outline-warning filter-btn" onclick="filterConflicts('ThieuThoiGianNghi')">Thiếu đệm nghỉ (@thieuNghiCount)</button>
        <button type="button" class="btn btn-sm btn-outline-primary filter-btn" onclick="filterConflicts('QuaTaiSoTran')">Quá tải ngày (@quaTaiCount)</button>
    </div>

    <div class="row g-4" id="conflictListContainer">
        @foreach (var c in Model!)
        {
            var borderClass = c.LoaiXungDot switch
            {
                "TrungGio" => "border-danger",
                "ThieuThoiGianNghi" => "border-warning",
                "QuaTaiSoTran" => "border-primary",
                _ => "border-secondary"
            };
            var headerBg = c.LoaiXungDot switch
            {
                "TrungGio" => "bg-danger bg-opacity-10 text-danger",
                "ThieuThoiGianNghi" => "bg-warning bg-opacity-10 text-dark",
                "QuaTaiSoTran" => "bg-primary bg-opacity-10 text-primary",
                _ => "bg-secondary bg-opacity-10 text-dark"
            };

            <div class="col-12 conflict-item" data-type="@c.LoaiXungDot">
                <div class="card card-custom border @borderClass shadow-sm">
                    <div class="card-header py-3 @headerBg d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-solid fa-user-shield fs-5"></i>
                            <span class="fw-bold fs-6">Trọng tài: @c.HoTenTrongTai (@c.MaTrongTai)</span>
                            <span class="badge bg-secondary">@(c.SoDienThoai ?? "Chưa có SĐT")</span>
                        </div>
                        <div>
                            @if (c.LoaiXungDot == "TrungGio")
                            {
                                <span class="badge bg-danger px-3 py-2 fs-6">
                                    <i class="fa-solid fa-triangle-exclamation me-1"></i> Trực tiếp trùng giờ
                                </span>
                            }
                            else if (c.LoaiXungDot == "ThieuThoiGianNghi")
                            {
                                <span class="badge bg-warning text-dark px-3 py-2 fs-6">
                                    <i class="fa-solid fa-bed me-1"></i> Cách nhau: @c.ChenhLechPhut phút (Thiếu đệm nghỉ)
                                </span>
                            }
                            else if (c.LoaiXungDot == "QuaTaiSoTran")
                            {
                                <span class="badge bg-primary px-3 py-2 fs-6">
                                    <i class="fa-solid fa-battery-empty me-1"></i> Vượt giới hạn trận/ngày
                                </span>
                            }
                        </div>
                    </div>

                    <div class="card-body p-4">
                        @if (!string.IsNullOrEmpty(c.MoTaLoi))
                        {
                            <div class="alert alert-warning py-2 px-3 small mb-3 border-0 bg-opacity-25 d-flex align-items-center gap-2">
                                <i class="fa-solid fa-circle-info fs-5 text-warning"></i>
                                <div>@c.MoTaLoi</div>
                            </div>
                        }

                        <div class="row g-3 align-items-center">
                            <!-- Trận 1 -->
                            <div class="col-md-5">
                                <div class="p-3 rounded-3 border bg-light h-100">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="badge bg-primary">TRẬN 1: #@c.Tran1So</span>
                                        <span class="badge bg-info text-dark">@c.Tran1VaiTro</span>
                                    </div>
                                    <h6 class="fw-bold text-dark mb-1">@c.Tran1Ten</h6>
                                    <div class="small text-muted mb-2">
                                        <i class="fa-solid fa-volleyball text-warning me-1"></i> Môn: <strong class="text-dark">@c.Tran1Mon</strong>
                                    </div>
                                    <div class="small mb-1">
                                        <i class="fa-regular fa-clock text-danger me-1"></i> Giờ đấu: <strong class="text-danger">@c.Tran1ThoiGian.ToString("HH:mm - dd/MM/yyyy")</strong>
                                    </div>
                                    <div class="small text-muted mb-3">
                                        <i class="fa-solid fa-location-dot text-secondary me-1"></i> Sân: @c.Tran1San
                                    </div>
                                    <a href="/TruongBanTrongTai/PhanCong" class="btn btn-sm btn-outline-primary w-100">
                                        <i class="fa-solid fa-user-pen me-1"></i> Điều Chỉnh Phân Công
                                    </a>
                                </div>
                            </div>

                            <!-- Icon Xung đột ở giữa -->
                            <div class="col-md-2 text-center">
                                @if (c.LoaiXungDot == "TrungGio")
                                {
                                    <div class="fs-2 mb-1 text-danger">
                                        <i class="fa-solid fa-bolt"></i>
                                    </div>
                                    <span class="badge bg-danger bg-opacity-20 text-danger fw-bold px-2 py-1 small">
                                        Trùng Giờ
                                    </span>
                                }
                                else if (c.LoaiXungDot == "ThieuThoiGianNghi")
                                {
                                    <div class="fs-2 mb-1 text-warning">
                                        <i class="fa-solid fa-hourglass-half"></i>
                                    </div>
                                    <span class="badge bg-warning bg-opacity-25 text-dark fw-bold px-2 py-1 small">
                                        Thiếu Nghỉ
                                    </span>
                                }
                                else
                                {
                                    <div class="fs-2 mb-1 text-primary">
                                        <i class="fa-solid fa-battery-empty"></i>
                                    </div>
                                    <span class="badge bg-primary bg-opacity-20 text-primary fw-bold px-2 py-1 small">
                                        Quá Tải
                                    </span>
                                }
                            </div>

                            <!-- Trận 2 -->
                            <div class="col-md-5">
                                <div class="p-3 rounded-3 border bg-light h-100">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="badge bg-primary">TRẬN 2: #@c.Tran2So</span>
                                        <span class="badge bg-info text-dark">@c.Tran2VaiTro</span>
                                    </div>
                                    <h6 class="fw-bold text-dark mb-1">@c.Tran2Ten</h6>
                                    <div class="small text-muted mb-2">
                                        <i class="fa-solid fa-volleyball text-warning me-1"></i> Môn: <strong class="text-dark">@c.Tran2Mon</strong>
                                    </div>
                                    <div class="small mb-1">
                                        <i class="fa-regular fa-clock text-danger me-1"></i> Giờ đấu: <strong class="text-danger">@c.Tran2ThoiGian.ToString("HH:mm - dd/MM/yyyy")</strong>
                                    </div>
                                    <div class="small text-muted mb-3">
                                        <i class="fa-solid fa-location-dot text-secondary me-1"></i> Sân: @c.Tran2San
                                    </div>
                                    <a href="/TruongBanTrongTai/PhanCong" class="btn btn-sm btn-outline-primary w-100">
                                        <i class="fa-solid fa-user-pen me-1"></i> Điều Chỉnh Phân Công
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card card-custom p-5 text-center text-success border-0 shadow-sm">
        <div class="rounded-circle bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 80px; height: 80px; font-size: 2.5rem;">
            <i class="fa-solid fa-circle-check"></i>
        </div>
        <h4 class="fw-bold text-dark mb-2">Lịch Trọng Tài Hoàn Toàn An Toàn!</h4>
        <p class="text-muted mb-4">
            Không tìm thấy bất kỳ xung đột trùng lịch, thiếu thời gian đệm nghỉ hồi sức hay quá tải số trận trong ngày nào giữa các trọng tài trong giải đấu này.
        </p>
        <div>
            <a href="/TruongBanTrongTai/PhanCong" class="btn btn-primary fw-semibold px-4">
                <i class="fa-solid fa-clipboard-user me-1"></i> Xem Bảng Phân Công
            </a>
        </div>
    </div>
}

@section Scripts {
    <script>
        function filterConflicts(type) {
            $('.filter-btn').removeClass('active');
            if (type === 'all') {
                $('.conflict-item').show();
                $('[onclick="filterConflicts(\'all\')"]').addClass('active');
            } else {
                $('.conflict-item').hide();
                $(`.conflict-item[data-type="${type}"]`).show();
                $(`[onclick="filterConflicts('${type}')"]`).addClass('active');
            }
        }
    </script>
}
