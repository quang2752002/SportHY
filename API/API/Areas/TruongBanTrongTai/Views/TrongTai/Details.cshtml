@model Dms.Domain.Entities.TrongTai
@{
    ViewData["Title"] = "Hồ Sơ Trọng Tài: " + Model.HoTen;
    var history = ViewBag.History as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<div class="mb-4">
    <a href="/TruongBanTrongTai/TrongTai" class="btn btn-sm btn-outline-secondary mb-2">
        <i class="fa-solid fa-arrow-left me-1"></i> Quay lại danh sách
    </a>
    <h4 class="fw-bold text-dark mb-0">Hồ Sơ & Lịch Sử Phân Công Trọng Tài</h4>
</div>

<div class="row g-4 mb-4">
    <!-- Card thông tin cá nhân -->
    <div class="col-md-4">
        <div class="card card-custom p-4 text-center">
            <div class="rounded-circle bg-primary bg-opacity-10 text-primary mx-auto d-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px; font-size: 2.5rem;">
                <i class="fa-solid fa-user-tie"></i>
            </div>
            <h5 class="fw-bold text-dark mb-1">@Model.HoTen</h5>
            <div class="badge bg-secondary bg-opacity-10 text-secondary mb-3">Mã: @Model.Ma</div>

            <div class="text-start border-top pt-3">
                <div class="mb-2">
                    <span class="text-muted small">Cấp bậc:</span>
                    <span class="float-end fw-semibold">@(Model.CapBac ?? "Chưa xếp")</span>
                </div>
                <div class="mb-2">
                    <span class="text-muted small">Giới tính:</span>
                    <span class="float-end">@(Model.GioiTinh ?? "Nam")</span>
                </div>
                <div class="mb-2">
                    <span class="text-muted small">Số điện thoại:</span>
                    <span class="float-end fw-medium">@(Model.SoDienThoai ?? "--")</span>
                </div>
                <div class="mb-2">
                    <span class="text-muted small">Email:</span>
                    <span class="float-end text-break">@(Model.Email ?? "--")</span>
                </div>
                <div class="mb-2">
                    <span class="text-muted small">Trạng thái:</span>
                    <span class="float-end">
                        @if (Model.TrangThai)
                        {
                            <span class="badge bg-success">Hoạt động</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Tạm ngưng</span>
                        }
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Lịch sử phân công các trận đấu -->
    <div class="col-md-8">
        <div class="card card-custom h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="fa-solid fa-clock-rotate-left text-warning me-2"></i> Lịch Sử Các Trận Đấu Phân Công
                </h6>
                <span class="badge bg-primary rounded-pill px-3 py-1">@history.Count() trận</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small text-uppercase">
                        <tr>
                            <th>Trận</th>
                            <th>Môn & Giải</th>
                            <th>Thời Gian</th>
                            <th>Vai Trò Phân Công</th>
                            <th>Trạng Thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (history.Any())
                        {
                            foreach (var item in history)
                            {
                                <tr>
                                    <td class="fw-bold">#@item.SoTran</td>
                                    <td>
                                        <div class="fw-semibold text-primary">@item.TenMon</div>
                                        <small class="text-muted">@item.TenGiaiDau</small>
                                    </td>
                                    <td>
                                        @if (item.ThoiGianDuKien != null)
                                        {
                                            <span>@(((DateTime)item.ThoiGianDuKien).ToString("HH:mm dd/MM/yyyy"))</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">--</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-info bg-opacity-10 text-info fw-bold px-2 py-1">
                                            @item.VaiTro
                                        </span>
                                    </td>
                                    <td>
                                        @if (item.TrangThai == "KetThuc" || item.TrangThai == "DaDau")
                                        {
                                            <span class="badge bg-success">Đã đấu</span>
                                        }
                                        else if (item.TrangThai == "DangDau")
                                        {
                                            <span class="badge bg-danger">Đang đấu</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border">Chưa đấu</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    Chưa có dữ liệu phân công trận đấu nào cho trọng tài này.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
