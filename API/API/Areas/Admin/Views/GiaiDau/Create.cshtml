@{
    ViewData["Title"] = "Thêm mới Giải Đấu";
    var khois = ViewBag.Khois as IEnumerable<KhoiDto> ?? Enumerable.Empty<KhoiDto>();
    var monTheThaos = ViewBag.MonTheThaos as IEnumerable<MonTheThaoDto> ?? Enumerable.Empty<MonTheThaoDto>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1 text-dark">
            <i class="fa-solid fa-trophy text-primary me-2"></i>Thêm Mới Giải Đấu Thể Thao
        </h4>
        <p class="text-muted small mb-0">Điền thông tin chi tiết để tạo giải đấu mới trong hệ thống.</p>
    </div>
    <div>
        <a href="/Admin/GiaiDau" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>
</div>

<form id="formGiaiDau" novalidate>
    <div class="row g-4">
        <!-- Cột trái: Thông tin chính -->
        <div class="col-lg-8">
            <div class="card card-custom mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="fa-solid fa-circle-info text-primary me-2"></i>1. Thông Tin Cơ Bản
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">Tên giải đấu <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="ten" required placeholder="Ví dụ: Hội Khỏe Phù Đổng Toàn Quốc 2026">
                            <div class="invalid-feedback">Vui lòng nhập tên giải đấu.</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Mã giải đấu <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="ma" required placeholder="Ví dụ: HKPD-2026">
                            <div class="invalid-feedback">Vui lòng nhập mã giải đấu.</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Đường dẫn thân thiện (Slug)</label>
                            <input type="text" class="form-control" id="slug" placeholder="hoi-khoe-phu-dong-2026">
                            <small class="text-muted">Để trống hệ thống sẽ tự sinh tự động từ tên giải.</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Địa điểm tổ chức</label>
                            <input type="text" class="form-control" id="diaDiem" placeholder="Ví dụ: Cung Thể Thao Tiên Sơn, Đà Nẵng">
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Ngày bắt đầu <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="ngayBatDau" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Ngày kết thúc <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="ngayKetThuc" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Hạn nộp hồ sơ đăng ký</label>
                            <input type="date" class="form-control" id="hanDangKy">
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Mô tả tóm tắt giải đấu</label>
                            <textarea class="form-control" id="moTa" rows="3" placeholder="Giới thiệu mục đích, ý nghĩa và quy mô giải đấu..."></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Môn thi đấu tổ chức -->
            <div class="card card-custom mb-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="fa-solid fa-volleyball text-success me-2"></i>2. Các Môn Thi Đấu Tổ Chức
                    </h6>
                    <button type="button" class="btn btn-sm btn-outline-primary" id="btnSelectAllMon">Chọn tất cả</button>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">Tích chọn các môn thi đấu nằm trong khuôn khổ giải đấu này:</p>
                    <div class="row g-2" id="listMonTheThao">
                        @foreach (var mon in monTheThaos)
                        {
                            <div class="col-md-4 col-sm-6">
                                <div class="form-check p-2 border rounded hover-shadow h-100">
                                    <input class="form-check-input chk-mon me-2" type="checkbox" value="@mon.Id" id="mon_@mon.Id">
                                    <label class="form-check-label fw-semibold text-dark small" for="mon_@mon.Id">
                                        @mon.Ten
                                        @if (mon.LaMonDongDoi)
                                        {
                                            <span class="badge bg-info-subtle text-info border">Đồng đội</span>
                                        }
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Điều lệ giải đấu -->
            <div class="card card-custom mb-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="fa-solid fa-book-bookmark text-warning me-2"></i>3. Điều Lệ Giải Đấu
                    </h6>
                    <button type="button" class="btn btn-sm btn-primary" id="btnAddDieuLe">
                        <i class="fa-solid fa-plus me-1"></i> Thêm mục điều lệ
                    </button>
                </div>
                <div class="card-body">
                    <div id="dieuLeContainer">
                        <!-- Danh sách điều lệ sẽ render bằng jQuery -->
                    </div>
                    <div id="emptyDieuLe" class="text-center py-4 text-muted border border-dashed rounded">
                        <i class="fa-regular fa-file-lines fa-2x mb-2 text-muted"></i>
                        <p class="small mb-0">Chưa có mục điều lệ nào. Nhấn "Thêm mục điều lệ" để thêm quy định, tệp điều lệ đính kèm.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cột phải: Banner, Phạm vi, Trạng thái, Lưu -->
        <div class="col-lg-4">
            <!-- Ảnh Banner -->
            <div class="card card-custom mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="fa-solid fa-image text-info me-2"></i>Banner Giải Đấu
                    </h6>
                </div>
                <div class="card-body text-center">
                    <div class="mb-3 position-relative">
                        <img id="bannerPreview" src="https://placehold.co/600x350/2563eb/white?text=K%C3%ADch+th%C6%B0%E1%BB%9Bc+khuy%E1%BA%BFn+ngh%E1%BB%8B+1200x600" class="img-fluid rounded border shadow-sm w-100 object-fit-cover" style="height: 180px;" alt="Banner Preview">
                        <input type="hidden" id="hinhAnh" value="">
                    </div>
                    <input type="file" id="bannerFileInput" class="d-none" accept="image/*">
                    <button type="button" class="btn btn-outline-primary btn-sm w-100 mb-2" id="btnUploadBanner">
                        <i class="fa-solid fa-upload me-1"></i> Tải ảnh banner lên
                    </button>
                    <small class="text-muted d-block">Hỗ trợ .jpg, .png, .webp (Tối đa 5MB)</small>
                </div>
            </div>

            <!-- Cài đặt Trạng thái & Phạm vi -->
            <div class="card card-custom mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="fa-solid fa-sliders text-secondary me-2"></i>Thiết Lập Vận Hành
                    </h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Trạng thái giải đấu</label>
                        <select class="form-select" id="trangThai">
                            <option value="1">Bản nháp</option>
                            <option value="2" selected>Sắp diễn ra</option>
                            <option value="3">Đang diễn ra</option>
                            <option value="4">Đã kết thúc</option>
                            <option value="5">Đã hủy giải</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Phạm vi đối tượng tham gia</label>
                        <select class="form-select" id="phamVi">
                            <option value="1" selected>Tất cả đơn vị</option>
                            <option value="2">Giới hạn theo khối cụ thể</option>
                        </select>
                    </div>

                    <!-- Danh sách khối áp dụng (Chỉ hiện khi chọn Theo khối) -->
                    <div id="khoiSection" class="d-none border rounded p-3 bg-light mb-3">
                        <label class="form-label fw-semibold text-dark small mb-2">Chọn các khối áp dụng:</label>
                        @foreach (var k in khois)
                        {
                            <div class="form-check mb-1">
                                <input class="form-check-input chk-khoi" type="checkbox" value="@k.Id" id="khoi_@k.Id">
                                <label class="form-check-label small" for="khoi_@k.Id">@k.Ten</label>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Nút Lưu & Hoàn tất -->
            <div class="card card-custom">
                <div class="card-body p-3">
                    <button type="submit" class="btn btn-primary w-100 py-2 fw-bold mb-2" id="btnSubmit">
                        <i class="fa-solid fa-floppy-disk me-2"></i> Lưu Giải Đấu
                    </button>
                    <a href="/Admin/GiaiDau" class="btn btn-light border w-100 py-2 text-muted">
                        Hủy bỏ
                    </a>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        let dieuLeIndex = 0;

        $(document).ready(function () {
            // Tự động gợi ý slug khi gõ tên
            $('#ten').on('keyup change', function () {
                if (!$('#slug').data('user-edited')) {
                    $('#slug').val(generateSlug($(this).val()));
                }
            });

            $('#slug').on('input', function () {
                $(this).data('user-edited', true);
            });

            // Toggle khối áp dụng
            $('#phamVi').on('change', function () {
                if ($(this).val() === '2') {
                    $('#khoiSection').removeClass('d-none');
                } else {
                    $('#khoiSection').addClass('d-none');
                }
            });

            // Chọn tất cả môn
            $('#btnSelectAllMon').on('click', function () {
                const allChecked = $('.chk-mon:checked').length === $('.chk-mon').length;
                $('.chk-mon').prop('checked', !allChecked);
                $(this).text(allChecked ? 'Chọn tất cả' : 'Bỏ chọn tất cả');
            });

            // Upload Banner
            $('#btnUploadBanner').on('click', function () {
                $('#bannerFileInput').click();
            });

            $('#bannerFileInput').on('change', function () {
                const file = this.files[0];
                if (!file) return;

                const formData = new FormData();
                formData.append('file', file);

                $('#btnUploadBanner').prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin me-1"></i> Đang tải ảnh...');

                $.ajax({
                    url: '/Admin/GiaiDau/UploadBanner',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (res) {
                        if (res.success && res.url) {
                            $('#bannerPreview').attr('src', res.url);
                            $('#hinhAnh').val(res.url);
                            SportApp.toast('success', 'Đã tải ảnh banner thành công!');
                        } else {
                            Swal.fire('Lỗi tải ảnh', res.message || 'Không thể tải ảnh.', 'error');
                        }
                    },
                    error: function () {
                        Swal.fire('Lỗi', 'Không thể kết nối máy chủ.', 'error');
                    },
                    complete: function () {
                        $('#btnUploadBanner').prop('disabled', false).html('<i class="fa-solid fa-upload me-1"></i> Tải ảnh banner lên');
                    }
                });
            });

            // Thêm mục điều lệ
            $('#btnAddDieuLe').on('click', function () {
                addDieuLeRow();
            });

            // Xử lý gửi Form tạo mới giải đấu
            $('#formGiaiDau').on('submit', function (e) {
                e.preventDefault();

                // Validate cơ bản
                const ten = $('#ten').val().trim();
                const ma = $('#ma').val().trim();
                const ngayBatDau = $('#ngayBatDau').val();
                const ngayKetThuc = $('#ngayKetThuc').val();

                if (!ten || !ma || !ngayBatDau || !ngayKetThuc) {
                    Swal.fire('Thiếu thông tin', 'Vui lòng điền đầy đủ Tên, Mã, Ngày bắt đầu và Ngày kết thúc giải đấu.', 'warning');
                    return;
                }

                if (new Date(ngayKetThuc) < new Date(ngayBatDau)) {
                    Swal.fire('Ngày không hợp lệ', 'Ngày kết thúc không được nhỏ hơn ngày bắt đầu.', 'warning');
                    return;
                }

                // Thu thập danh sách ID môn
                const monTheThaoIds = [];
                $('.chk-mon:checked').each(function () {
                    monTheThaoIds.push(parseInt($(this).val()));
                });

                // Thu thập danh sách ID khối
                const khoiIds = [];
                if ($('#phamVi').val() === '2') {
                    $('.chk-khoi:checked').each(function () {
                        khoiIds.push(parseInt($(this).val()));
                    });
                }

                // Thu thập điều lệ
                const dieuLes = [];
                $('.dieu-le-item').each(function (i) {
                    const row = $(this);
                    const tieuDe = row.find('.dl-tieude').val().trim();
                    const noiDung = row.find('.dl-noidung').val().trim();
                    const tepDinhKem = row.find('.dl-tep').val();

                    if (tieuDe) {
                        dieuLes.push({
                            tieuDe: tieuDe,
                            noiDung: noiDung,
                            tepDinhKem: tepDinhKem || null,
                            thuTu: i + 1,
                            trangThai: true
                        });
                    }
                });

                const payload = {
                    ma: ma,
                    ten: ten,
                    slug: $('#slug').val().trim() || generateSlug(ten),
                    hinhAnh: $('#hinhAnh').val() || null,
                    moTa: $('#moTa').val().trim() || null,
                    ngayBatDau: ngayBatDau,
                    ngayKetThuc: ngayKetThuc,
                    hanDangKy: $('#hanDangKy').val() || null,
                    diaDiem: $('#diaDiem').val().trim() || null,
                    phamVi: parseInt($('#phamVi').val()),
                    trangThai: parseInt($('#trangThai').val()),
                    khoiIds: khoiIds,
                    monTheThaoIds: monTheThaoIds,
                    dieuLeGiaiDaus: dieuLes
                };

                $('#btnSubmit').prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin me-2"></i> Đang lưu...');

                $.ajax({
                    url: '/Admin/GiaiDau/Save',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function (res) {
                        if (res.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Thành công!',
                                text: res.message || 'Giải đấu đã được tạo thành công.',
                                confirmButtonText: 'Về danh sách giải đấu'
                            }).then(() => {
                                window.location.href = '/Admin/GiaiDau';
                            });
                        } else {
                            Swal.fire('Lỗi lưu', res.message || 'Không thể lưu giải đấu.', 'error');
                            $('#btnSubmit').prop('disabled', false).html('<i class="fa-solid fa-floppy-disk me-2"></i> Lưu Giải Đấu');
                        }
                    },
                    error: function () {
                        Swal.fire('Lỗi kết nối', 'Không thể gửi dữ liệu lên máy chủ.', 'error');
                        $('#btnSubmit').prop('disabled', false).html('<i class="fa-solid fa-floppy-disk me-2"></i> Lưu Giải Đấu');
                    }
                });
            });
        });

        // Hàm thêm dòng điều lệ
        function addDieuLeRow(data) {
            dieuLeIndex++;
            $('#emptyDieuLe').hide();

            const title = data ? data.tieuDe : '';
            const content = data ? data.noiDung : '';
            const fileUrl = data ? data.tepDinhKem : '';

            const rowHtml = `
                <div class="dieu-le-item border rounded p-3 mb-3 bg-light position-relative" id="dlRow_${dieuLeIndex}">
                    <button type="button" class="btn btn-sm btn-outline-danger position-absolute top-0 end-0 m-2" onclick="removeDieuLeRow(${dieuLeIndex})" title="Xóa mục này">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                    <div class="row g-2">
                        <div class="col-md-7">
                            <label class="form-label small fw-semibold">Tiêu đề điều lệ <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm dl-tieude" value="${escapeHtml(title)}" placeholder="Ví dụ: Chương I: Quy định chung về độ tuổi" required>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label small fw-semibold">Tệp tài liệu đính kèm (PDF/Word)</label>
                            <div class="input-group input-group-sm">
                                <input type="text" class="form-control form-control-sm dl-tep" value="${escapeHtml(fileUrl || '')}" placeholder="/dieu-le/file.pdf" readonly>
                                <button class="btn btn-outline-secondary btn-upload-dl" type="button" onclick="triggerUploadDl(${dieuLeIndex})">
                                    <i class="fa-solid fa-paperclip"></i>
                                </button>
                            </div>
                            <input type="file" class="d-none dl-file-input" id="dlFile_${dieuLeIndex}" onchange="handleDlFileChange(this, ${dieuLeIndex})">
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Nội dung chi tiết</label>
                            <textarea class="form-control form-control-sm dl-noidung" rows="2" placeholder="Nhập nội dung tóm tắt hoặc quy định...">${escapeHtml(content)}</textarea>
                        </div>
                    </div>
                </div>
            `;

            $('#dieuLeContainer').append(rowHtml);
        }

        function removeDieuLeRow(idx) {
            $(`#dlRow_${idx}`).remove();
            if ($('.dieu-le-item').length === 0) {
                $('#emptyDieuLe').show();
            }
        }

        function triggerUploadDl(idx) {
            $(`#dlFile_${idx}`).click();
        }

        function handleDlFileChange(input, idx) {
            const file = input.files[0];
            if (!file) return;

            const formData = new FormData();
            formData.append('file', file);

            $.ajax({
                url: '/Admin/GiaiDau/UploadDieuLe',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (res) {
                    if (res.success && res.url) {
                        $(`#dlRow_${idx}`).find('.dl-tep').val(res.url);
                        SportApp.toast('success', 'Đã tải tệp tài liệu thành công!');
                    } else {
                        Swal.fire('Lỗi tải file', res.message || 'Không thể tải tài liệu.', 'error');
                    }
                }
            });
        }

        function generateSlug(text) {
            return text.toString().toLowerCase()
                .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
                .replace(/[đĐ]/g, 'd')
                .replace(/[^a-z0-9 -]/g, '')
                .replace(/\s+/g, '-')
                .replace(/-+/g, '-');
        }

        function escapeHtml(text) {
            if (!text) return '';
            return $('<div>').text(text).html();
        }
    </script>
}
