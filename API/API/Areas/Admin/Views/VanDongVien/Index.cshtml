@{
    ViewData["Title"] = "Quản lý Vận Động Viên";
    var donVis = ViewBag.DonVis as IEnumerable<DonViDto> ?? Enumerable.Empty<DonViDto>();
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1 text-dark">
            <i class="fa-solid fa-person-running text-primary me-2"></i>Quản lý Hồ Sơ Vận Động Viên
        </h4>
        <p class="text-muted small mb-0">Quản lý cơ sở dữ liệu hồ sơ, thông tin cá nhân và đơn vị chủ quản của các vận động viên.</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-primary shadow-sm" onclick="openCreateModal()">
            <i class="fa-solid fa-user-plus me-1"></i> Thêm Vận Động Viên Mới
        </button>
    </div>
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="card card-custom mb-4">
    <div class="card-body p-3">
        <div class="row g-2 align-items-center">
            <div class="col-md-5">
                <input type="text" id="keyword" class="form-control" placeholder="Tìm theo họ tên, mã VĐV, số CCCD, SĐT...">
            </div>
            <div class="col-md-4">
                <select id="donViFilter" class="form-select">
                    <option value="">-- Tất cả đoàn / đơn vị --</option>
                    @foreach (var dv in donVis)
                    {
                        <option value="@dv.Id">@dv.Ten</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-1">
                <button type="button" class="btn btn-primary flex-grow-1" onclick="loadData(1)">
                    <i class="fa-solid fa-filter me-1"></i> Lọc
                </button>
                <button type="button" class="btn btn-outline-secondary" onclick="resetFilter()" title="Làm mới">
                    <i class="fa-solid fa-arrows-rotate"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Bảng dữ liệu VĐV -->
<div class="card card-custom">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="tblVDV">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3" style="width: 50px;">STT</th>
                        <th>Họ Và Tên VĐV</th>
                        <th>Đơn Vị Chủ Quản</th>
                        <th>Ngày Sinh</th>
                        <th>Giới Tính</th>
                        <th>CCCD & Liên Hệ</th>
                        <th>Trạng Thái</th>
                        <th class="text-end pe-3" style="width: 130px;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody id="tblBody">
                    <tr><td colspan="8" class="text-center py-5 text-muted">Đang tải danh sách vận động viên...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center py-3">
        <div class="text-muted small" id="paginationInfo">Hiển thị 0 trên 0 vận động viên</div>
        <ul class="pagination pagination-sm mb-0" id="paginationList"></ul>
    </div>
</div>

<!-- Modal Thêm / Sửa VĐV -->
<div class="modal fade" id="modalVDV" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="modalTitle">Thêm Vận Động Viên Mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formVDV">
                <input type="hidden" id="vdvId" value="">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">Họ và tên VĐV <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="hoTen" required placeholder="Ví dụ: Nguyễn Văn An">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Mã VĐV</label>
                            <input type="text" class="form-control" id="ma" placeholder="VDV-001">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Đơn vị chủ quản <span class="text-danger">*</span></label>
                            <select class="form-select" id="donViId" required>
                                <option value="">-- Chọn đơn vị / đoàn --</option>
                                @foreach (var dv in donVis)
                                {
                                    <option value="@dv.Id">@dv.Ten</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Ngày sinh</label>
                            <input type="date" class="form-control" id="ngaySinh">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Giới tính</label>
                            <select class="form-select" id="gioiTinh">
                                <option value="Nam">Nam</option>
                                <option value="Nu">Nữ</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Số CCCD / Định danh</label>
                            <input type="text" class="form-control" id="soCCCD" placeholder="04820200xxxx">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Số điện thoại</label>
                            <input type="text" class="form-control" id="soDienThoai" placeholder="0905 xxx xxx">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Email</label>
                            <input type="email" class="form-control" id="email" placeholder="vdv@gmail.com">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Địa chỉ thường trú</label>
                            <input type="text" class="form-control" id="diaChi" placeholder="Địa chỉ cư trú...">
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="trangThai" checked>
                                <label class="form-check-label fw-semibold" for="trangThai">Hoạt động (Đủ điều kiện thi đấu)</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary" id="btnSave">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Lưu thông tin
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentPage = 1;
        const pageSize = 10;

        $(document).ready(function () {
            loadData(1);

            $('#keyword').on('keypress', function (e) {
                if (e.which === 13) loadData(1);
            });

            $('#donViFilter').on('change', function () {
                loadData(1);
            });

            $('#formVDV').on('submit', function (e) {
                e.preventDefault();
                saveData();
            });
        });

        function loadData(page) {
            currentPage = page;
            const keyword = $('#keyword').val().trim();
            const donViId = $('#donViFilter').val();

            $.ajax({
                url: '/Admin/VanDongVien/GetPagedData',
                type: 'GET',
                data: {
                    pageIndex: page,
                    pageSize: pageSize,
                    keyword: keyword || undefined,
                    donViId: donViId ? parseInt(donViId) : undefined
                },
                success: function (res) {
                    if (res.success && res.data) {
                        renderTable(res.data);
                    }
                }
            });
        }

        function renderTable(data) {
            const items = data.items || [];
            if (items.length === 0) {
                $('#tblBody').html('<tr><td colspan="8" class="text-center py-5 text-muted">Chưa có vận động viên nào.</td></tr>');
                $('#paginationInfo').text('Hiển thị 0 trên 0 vận động viên');
                $('#paginationList').empty();
                return;
            }

            let html = '';
            const start = (data.pageIndex - 1) * data.pageSize;

            $.each(items, function (i, item) {
                const stt = start + i + 1;
                const ngaySinhStr = item.ngaySinh ? formatDate(item.ngaySinh) : '-';
                const gioiTinhBadge = item.gioiTinh === 'Nam' ? '<span class="badge bg-info text-dark">Nam</span>' : '<span class="badge bg-danger-subtle text-danger border">Nữ</span>';

                html += `
                    <tr>
                        <td class="ps-3 fw-bold text-muted">${stt}</td>
                        <td>
                            <div class="fw-bold text-dark">${escapeHtml(item.hoTen)}</div>
                            <small class="text-muted"><span class="badge bg-light text-secondary border">Mã: ${escapeHtml(item.ma)}</span></small>
                        </td>
                        <td>
                            <span class="fw-semibold text-primary"><i class="fa-solid fa-building-columns me-1"></i>${escapeHtml(item.tenDonVi || 'Chưa gắn')}</span>
                        </td>
                        <td><small class="text-dark">${ngaySinhStr}</small></td>
                        <td>${gioiTinhBadge}</td>
                        <td>
                            ${item.soCCCD ? `<div class="small text-muted"><i class="fa-regular fa-id-card me-1"></i>${escapeHtml(item.soCCCD)}</div>` : ''}
                            ${item.soDienThoai ? `<div class="small text-success"><i class="fa-solid fa-phone me-1"></i>${escapeHtml(item.soDienThoai)}</div>` : ''}
                        </td>
                        <td>
                            <span class="badge ${item.trangThai ? 'bg-success' : 'bg-danger'} badge-status">
                                ${item.trangThai ? 'Đủ điều kiện' : 'Tạm khóa'}
                            </span>
                        </td>
                        <td class="text-end pe-3">
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-light border" title="Sửa" onclick="openEditModal(${item.id})">
                                    <i class="fa-solid fa-pen-to-square text-success"></i>
                                </button>
                                <button type="button" class="btn btn-light border" title="Xóa" onclick="deleteItem(${item.id}, '${escapeHtml(item.hoTen)}')">
                                    <i class="fa-solid fa-trash text-danger"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            });

            $('#tblBody').html(html);

            const total = data.totalCount || 0;
            const from = total === 0 ? 0 : start + 1;
            const to = Math.min(start + data.pageSize, total);
            $('#paginationInfo').text(`Hiển thị ${from} - ${to} trên tổng số ${total} vận động viên`);

            renderPagination(data.pageIndex, data.totalPages);
        }

        function renderPagination(current, totalPages) {
            if (totalPages <= 1) {
                $('#paginationList').empty();
                return;
            }

            let pagHtml = '';
            pagHtml += `<li class="page-item ${current === 1 ? 'disabled' : ''}">
                <a class="page-link" href="javascript:void(0)" onclick="loadData(${current - 1})">&laquo;</a>
            </li>`;

            for (let i = 1; i <= totalPages; i++) {
                if (i === 1 || i === totalPages || (i >= current - 2 && i <= current + 2)) {
                    pagHtml += `<li class="page-item ${i === current ? 'active' : ''}">
                        <a class="page-link" href="javascript:void(0)" onclick="loadData(${i})">${i}</a>
                    </li>`;
                }
            }

            pagHtml += `<li class="page-item ${current === totalPages ? 'disabled' : ''}">
                <a class="page-link" href="javascript:void(0)" onclick="loadData(${current + 1})">&raquo;</a>
            </li>`;

            $('#paginationList').html(pagHtml);
        }

        function openCreateModal() {
            $('#modalTitle').text('Thêm Vận Động Viên Mới');
            $('#vdvId').val('');
            $('#hoTen').val('');
            $('#ma').val('');
            $('#donViId').val('');
            $('#ngaySinh').val('');
            $('#gioiTinh').val('Nam');
            $('#soCCCD').val('');
            $('#soDienThoai').val('');
            $('#email').val('');
            $('#diaChi').val('');
            $('#trangThai').prop('checked', true);
            $('#modalVDV').modal('show');
        }

        function openEditModal(id) {
            $.get('/Admin/VanDongVien/GetById', { id: id }, function (res) {
                if (res.success && res.data) {
                    const item = res.data;
                    $('#modalTitle').text('Chỉnh Sửa Hồ Sơ Vận Động Viên');
                    $('#vdvId').val(item.id);
                    $('#hoTen').val(item.hoTen);
                    $('#ma').val(item.ma || '');
                    $('#donViId').val(item.donViId || '');
                    $('#ngaySinh').val(item.ngaySinh ? item.ngaySinh.substring(0, 10) : '');
                    $('#gioiTinh').val(item.gioiTinh || 'Nam');
                    $('#soCCCD').val(item.soCCCD || '');
                    $('#soDienThoai').val(item.soDienThoai || '');
                    $('#email').val(item.email || '');
                    $('#diaChi').val(item.diaChi || '');
                    $('#trangThai').prop('checked', item.trangThai);
                    $('#modalVDV').modal('show');
                }
            });
        }

        function saveData() {
            const id = $('#vdvId').val();
            const hoTen = $('#hoTen').val().trim();
            const donViId = $('#donViId').val();

            if (!hoTen || !donViId) {
                Swal.fire('Lỗi', 'Vui lòng nhập họ tên và chọn đơn vị chủ quản.', 'warning');
                return;
            }

            const payload = {
                hoTen: hoTen,
                ma: $('#ma').val().trim() || 'VDV-' + Date.now().toString().slice(-6),
                donViId: parseInt(donViId),
                ngaySinh: $('#ngaySinh').val() || null,
                gioiTinh: $('#gioiTinh').val(),
                soCCCD: $('#soCCCD').val().trim() || null,
                soDienThoai: $('#soDienThoai').val().trim() || null,
                email: $('#email').val().trim() || null,
                diaChi: $('#diaChi').val().trim() || null,
                trangThai: $('#trangThai').is(':checked')
            };

            const url = id ? `/Admin/VanDongVien/Save?id=${id}` : '/Admin/VanDongVien/Save';

            $.ajax({
                url: url,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    if (res.success) {
                        $('#modalVDV').modal('hide');
                        SportApp.toast('success', res.message || 'Lưu hồ sơ VĐV thành công!');
                        loadData(currentPage);
                    } else {
                        Swal.fire('Lỗi', res.message || 'Không thể lưu hồ sơ.', 'error');
                    }
                }
            });
        }

        function deleteItem(id, name) {
            SportApp.confirm('Xóa Hồ Sơ VĐV?', `Bạn có chắc muốn xóa vận động viên "${name}" không?`, function () {
                $.post('/Admin/VanDongVien/Delete', { id: id }, function (res) {
                    if (res.success) {
                        SportApp.toast('success', res.message || 'Đã xóa VĐV!');
                        loadData(currentPage);
                    } else {
                        Swal.fire('Lỗi', res.message || 'Không thể xóa.', 'error');
                    }
                });
            });
        }

        function formatDate(str) {
            if (!str) return '';
            const d = new Date(str);
            if (isNaN(d.getTime())) return str;
            return String(d.getDate()).padStart(2, '0') + '/' + String(d.getMonth() + 1).padStart(2, '0') + '/' + d.getFullYear();
        }

        function resetFilter() {
            $('#keyword').val('');
            $('#donViFilter').val('');
            loadData(1);
        }

        function escapeHtml(text) {
            if (!text) return '';
            return $('<div>').text(text).html();
        }
    </script>
}
