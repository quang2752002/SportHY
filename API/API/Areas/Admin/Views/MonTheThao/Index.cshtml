@{
    ViewData["Title"] = "Quản lý Môn Thể Thao";
    var danhMucs = ViewBag.DanhMucs as IEnumerable<DanhMucMonTheThaoDto> ?? Enumerable.Empty<DanhMucMonTheThaoDto>();
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1 text-dark">
            <i class="fa-solid fa-volleyball text-primary me-2"></i>Quản lý Môn Thể Thao Thi Đấu
        </h4>
        <p class="text-muted small mb-0">Cấu hình danh mục môn, thể thức thi đấu, giới tính và quy định số lượng VĐV.</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-primary shadow-sm" onclick="openCreateModal()">
            <i class="fa-solid fa-plus me-1"></i> Thêm Môn Thể Thao Mới
        </button>
    </div>
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="card card-custom mb-4">
    <div class="card-body p-3">
        <div class="row g-2 align-items-center">
            <div class="col-md-5">
                <input type="text" id="keyword" class="form-control" placeholder="Tìm theo tên môn, mã môn...">
            </div>
            <div class="col-md-3">
                <select id="danhMucFilter" class="form-select">
                    <option value="">-- Tất cả danh mục --</option>
                    @foreach (var dm in danhMucs)
                    {
                        <option value="@dm.Id">@dm.Ten</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select id="gioiTinhFilter" class="form-select">
                    <option value="">-- Giới tính --</option>
                    <option value="Nam">Nam</option>
                    <option value="Nu">Nữ</option>
                    <option value="HonHop">Hỗn hợp (Nam/Nữ)</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="button" class="btn btn-primary flex-grow-1" onclick="loadData(1)">
                    <i class="fa-solid fa-filter me-1"></i> Lọc
                </button>
                <button type="button" class="btn btn-outline-secondary" onclick="resetFilter()" title="Làm mới">
                    <i class="fa-solid fa-arrows-rotate"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Bảng danh sách Môn thể thao -->
<div class="card card-custom">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="tblMonTheThao">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3" style="width: 50px;">STT</th>
                        <th>Tên Môn Thể Thao</th>
                        <th>Danh Mục</th>
                        <th>Hình Thức</th>
                        <th>Giới Tính</th>
                        <th>Quy Mô VĐV</th>
                        <th>Trạng Thái</th>
                        <th class="text-end pe-3" style="width: 150px;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody id="tblBody">
                    <tr><td colspan="8" class="text-center py-5 text-muted">Đang tải danh sách môn thể thao...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center py-3">
        <div class="text-muted small" id="paginationInfo">Hiển thị 0 trên 0 môn thể thao</div>
        <ul class="pagination pagination-sm mb-0" id="paginationList"></ul>
    </div>
</div>

<!-- Modal Thêm / Sửa Môn Thể Thao -->
<div class="modal fade" id="modalMon" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="modalTitle">Thêm Môn Thể Thao Mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formMon">
                <input type="hidden" id="monId" value="">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">Tên môn thể thao <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="ten" required placeholder="Ví dụ: Bóng Đá 7 Người">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Mã môn</label>
                            <input type="text" class="form-control" id="ma" placeholder="BD-07">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Danh mục môn <span class="text-danger">*</span></label>
                            <select class="form-select" id="danhMucId" required>
                                <option value="">-- Chọn danh mục --</option>
                                @foreach (var dm in danhMucs)
                                {
                                    <option value="@dm.Id">@dm.Ten</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Giới tính áp dụng</label>
                            <select class="form-select" id="gioiTinh">
                                <option value="HonHop">Hỗn hợp (Nam / Nữ)</option>
                                <option value="Nam">Nam</option>
                                <option value="Nu">Nữ</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Hình thức / Thể thức thi đấu</label>
                            <input type="text" class="form-control" id="hinhThucThiDau" placeholder="Ví dụ: Vòng bảng + Loại trực tiếp">
                        </div>
                        <div class="col-md-6 d-flex align-items-center pt-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="laMonDongDoi">
                                <label class="form-check-label fw-semibold" for="laMonDongDoi">Môn thi đấu Đồng đội (Theo đội tuyển)</label>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Số VĐV tối thiểu</label>
                            <input type="number" class="form-control" id="soLuongVanDongVienToiThieu" placeholder="1">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Số VĐV tối đa</label>
                            <input type="number" class="form-control" id="soLuongVanDongVienToiDa" placeholder="14">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Số đội tối đa</label>
                            <input type="number" class="form-control" id="soDoiToiDa" placeholder="16">
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Mô tả / Luật thi đấu</label>
                            <textarea class="form-control" id="moTa" rows="2" placeholder="Ghi chú luật thi đấu áp dụng..."></textarea>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="trangThai" checked>
                                <label class="form-check-label fw-semibold" for="trangThai">Hoạt động (Cho phép tổ chức)</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary" id="btnSave">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Lưu thông tin
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Cấu hình Thể thức & Luật thi đấu -->
<div class="modal fade" id="modalTheThuc" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-gradient bg-primary text-white px-4 py-3 border-0">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa-solid fa-sliders fs-5"></i>
                    <div>
                        <h5 class="modal-title fw-bold mb-0 text-white" id="formatModalTitle">Cấu Hình Thể Thức & Luật Thi Đấu</h5>
                        <div class="small opacity-75" id="formatModalSubtitle">Tùy biến số hiệp, điểm số, thời gian, tie-break, penalty và quy cách xếp hạng</div>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formTheThuc">
                <input type="hidden" id="fmtMonId" value="">
                <div class="modal-body p-4 bg-light">
                    <!-- Quick Presets -->
                    <div class="card border-0 shadow-sm rounded-3 mb-4 bg-white">
                        <div class="card-body p-3">
                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                                <div class="d-flex align-items-center gap-2 text-primary fw-bold small">
                                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                                    <span>Mẫu cấu hình chuẩn quốc tế (Nhanh):</span>
                                </div>
                                <div class="d-flex flex-wrap gap-2">
                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="applyPreset('badminton')">
                                        🏸 Cầu lông (Best of 3, 21đ)
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="applyPreset('volleyball')">
                                        🏐 Bóng chuyền (Best of 5, 25đ)
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="applyPreset('football')">
                                        ⚽ Bóng đá (Hiệp phụ + Penalty)
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="applyPreset('tabletennis')">
                                        🏓 Bóng bàn (Best of 5, 11đ)
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="applyPreset('athletics')">
                                        🏃 Điền kinh 100m (8 Làn)
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="applyPreset('swimming')">
                                        🏊 Bơi lội (8 Làn)
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Main Format Configuration -->
                    <div class="row g-3 align-items-center">
                        <div class="col-md-4">
                            <label class="form-label fw-bold small text-secondary">
                                <i class="fa-solid fa-sitemap text-primary me-1"></i> Sơ đồ thi đấu của môn
                            </label>
                            <select id="fmtHinhThucThiDau" class="form-select fw-semibold border-primary-subtle" onchange="onBracketFormatChange()">
                                <option value="LoaiTrucTiep">Loại trực tiếp (Knockout)</option>
                                <option value="VongBang">Vòng tròn tính điểm / Bảng</option>
                                <option value="KetHopVongBangVaLoaiTrucTiep">Bảng + Knockout</option>
                                <option value="NhanhThangNhanhThua">Nhánh thắng - thua (Double Elim)</option>
                                <option value="HeThuySi">Hệ Thụy Sĩ (Swiss System - Cờ vua)</option>
                                <option value="TinhDiemXepHang">Đo thành tích / Chạy làn</option>
                                <option value="Khac">Khác</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small text-secondary">
                                <i class="fa-solid fa-stopwatch text-success me-1"></i> Cơ chế tính điểm trận (Scoring) <span class="text-danger">*</span>
                            </label>
                            <select id="fmtLoaiTheThuc" class="form-select fw-semibold border-success-subtle" onchange="onFormatTypeChange()">
                                <option value="SetDiem">🎯 Đấu Set / Hiệp tính điểm (Cầu lông, Bóng chuyền, Bóng bàn...)</option>
                                <option value="ThoiGianHiep">⏱️ Tính thời gian hiệp (Bóng đá, Futsal, Bóng rổ...)</option>
                                <option value="TinhDiemXepHang">🏅 Đo thành tích / Chạy làn (Điền kinh, Bơi lội...)</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <div class="alert alert-info border-0 rounded-3 py-2 px-3 mb-0 small" id="fmtTypeNote">
                                <i class="fa-solid fa-circle-info me-1"></i>
                                Hệ thống tự động áp dụng giao diện chấm điểm và bảng xếp hạng tương ứng cho môn này.
                            </div>
                        </div>
                        <div class="col-12" id="fmtBracketTipContainer">
                            <!-- Chú thích tương thích thông minh -->
                        </div>
                        <div class="col-12">
                            <div class="p-3 bg-light rounded-3 border">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="fmtCoThePhat">
                                    <label class="form-check-label fw-bold small" for="fmtCoThePhat">Môn này áp dụng thẻ phạt (thẻ vàng/thẻ đỏ)</label>
                                    <div class="form-text">Khi tắt, giao diện và máy chủ sẽ từ chối cập nhật sự kiện thẻ cho môn này.</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Panel: Đấu Set Điểm -->
                    <div class="card border-0 shadow-sm rounded-3 mt-3 bg-white" id="panelSetDiem">
                        <div class="card-header bg-white border-bottom py-3">
                            <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                                <i class="fa-solid fa-list-ol text-primary"></i> Quy định Game / Set đấu & Luật Deuce
                            </h6>
                        </div>
                        <div class="card-body p-4">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold small">Số hiệp tối đa (Best of X)</label>
                                    <input type="number" class="form-control" id="fmtSoHiepToiDa" value="3" min="1" max="15">
                                    <small class="text-muted">VD: 3 (thắng 2), 5 (thắng 3)</small>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold small">Số hiệp thắng để thắng trận</label>
                                    <input type="number" class="form-control" id="fmtSoHiepThang" value="2" min="1" max="10">
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold small">Điểm chuẩn mỗi hiệp thường</label>
                                    <input type="number" class="form-control" id="fmtDiemMoiHiep" value="21" min="1">
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold small">Điểm hiệp quyết định (Hiệp cuối/tie-break)</label>
                                    <input type="number" class="form-control" id="fmtDiemHiepQuyetDinh" value="21" min="1">
                                    <small class="text-muted">VD: Bóng chuyền set 5 là 15đ</small>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold small">Cách biệt điểm tối thiểu (Deuce)</label>
                                    <input type="number" class="form-control" id="fmtCachBiet" value="2" min="1">
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold small">Điểm tối đa kịch trần (Cap point)</label>
                                    <input type="number" class="form-control" id="fmtDiemToiDa" value="30" min="1">
                                    <small class="text-muted">VD: Cầu lông chạm 30 trước là thắng; 0 = không giới hạn</small>
                                </div>
                                <div class="col-12 mt-2">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="fmtCachTinhDiemTheoSet">
                                        <label class="form-check-label fw-semibold small" for="fmtCachTinhDiemTheoSet">
                                            Quy đổi điểm BXH vòng bảng theo tỉ số set (Kiểu Bóng chuyền FIVB: 3-0/3-1 = 3đ; 3-2 = 2đ; 2-3 = 1đ)
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Panel: Tính Thời Gian Hiệp -->
                    <div class="card border-0 shadow-sm rounded-3 mt-3 bg-white d-none" id="panelThoiGianHiep">
                        <div class="card-header bg-white border-bottom py-3">
                            <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                                <i class="fa-solid fa-stopwatch text-primary"></i> Quy định Thời gian, Hiệp phụ & Sút Luân lưu Penalty
                            </h6>
                        </div>
                        <div class="card-body p-4">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold small">Thời gian hiệp chính (phút)</label>
                                    <input type="number" class="form-control" id="fmtThoiGianChinh" value="45" min="1">
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold small">Điểm vòng bảng: Thắng / Hòa / Thua</label>
                                    <div class="input-group">
                                        <input type="number" class="form-control text-center" id="fmtDiemThang" value="3" title="Thắng">
                                        <input type="number" class="form-control text-center" id="fmtDiemHoa" value="1" title="Hòa">
                                        <input type="number" class="form-control text-center" id="fmtDiemThua" value="0" title="Thua">
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-check mt-4">
                                        <input class="form-check-input" type="checkbox" id="fmtChoPhepHoaVongBang" checked>
                                        <label class="form-check-label fw-semibold small" for="fmtChoPhepHoaVongBang">Cho phép kết quả Hòa ở vòng bảng</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="p-3 bg-light rounded-3 border">
                                        <div class="form-check form-switch mb-2">
                                            <input class="form-check-input" type="checkbox" id="fmtCoHiepPhu">
                                            <label class="form-check-label fw-bold small" for="fmtCoHiepPhu">Áp dụng Hiệp phụ (Khi hòa ở Knockout)</label>
                                        </div>
                                        <div class="row g-2 mt-1">
                                            <div class="col-6">
                                                <label class="form-label small text-muted">Số hiệp phụ</label>
                                                <input type="number" class="form-control form-control-sm" id="fmtSoHiepPhu" value="2">
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label small text-muted">Phút mỗi hiệp phụ</label>
                                                <input type="number" class="form-control form-control-sm" id="fmtThoiGianPhu" value="15">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="p-3 bg-light rounded-3 border">
                                        <div class="form-check form-switch mb-2">
                                            <input class="form-check-input" type="checkbox" id="fmtCoPenalty" checked>
                                            <label class="form-check-label fw-bold small" for="fmtCoPenalty">Áp dụng Sút luân lưu Penalty</label>
                                        </div>
                                        <div class="mt-1">
                                            <label class="form-label small text-muted">Số lượt sút luân lưu cơ bản mỗi đội</label>
                                            <input type="number" class="form-control form-control-sm" id="fmtSoLuotPen" value="5">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Panel: Đo thành tích / Chạy làn -->
                    <div class="card border-0 shadow-sm rounded-3 mt-3 bg-white d-none" id="panelTinhDiemXepHang">
                        <div class="card-header bg-white border-bottom py-3">
                            <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                                <i class="fa-solid fa-person-running text-primary"></i> Quy cách Đợt chạy/Lượt bơi, Làn thi đấu & Tiến vào Chung kết
                            </h6>
                        </div>
                        <div class="card-body p-4">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold small">Loại đo lường thành tích</label>
                                    <select id="fmtLoaiDo" class="form-select">
                                        <option value="ThoiGian">⏱️ Thời gian (Giây / mili-giây)</option>
                                        <option value="KhoangCach">📏 Khoảng cách (Mét / cm)</option>
                                        <option value="DiemSo">🎯 Điểm số ban giám khảo</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold small">Tiêu chí xếp hạng</label>
                                    <select id="fmtTieuChiThanhTich" class="form-select">
                                        <option value="CangNhoCangTot">Nhỏ hơn là tốt hơn (Thời gian ngắn nhất thắng)</option>
                                        <option value="CangLonCangTot">Lớn hơn là tốt hơn (Xa nhất / Cao nhất thắng)</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold small">Số làn / VĐV mỗi lượt thi</label>
                                    <input type="number" class="form-control" id="fmtSoVdvLuot" value="8" min="1" max="12">
                                </div>
                                <div class="col-md-6">
                                    <div class="p-3 bg-light rounded-3 border h-100">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" id="fmtChoPhepDongHangThanhTich" checked>
                                            <label class="form-check-label fw-semibold small" for="fmtChoPhepDongHangThanhTich">Cho phép đồng hạng khi thành tích bằng nhau</label>
                                        </div>
                                        <small class="form-text">Nếu tắt, trọng tài phải nhập chỉ số phụ để phân định; nếu chỉ số phụ vẫn bằng nhau, hệ thống không chốt lượt thi.</small>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">Chiều xếp theo chỉ số phụ</label>
                                    <select id="fmtTieuChiPhuCangNhoCangTot" class="form-select">
                                        <option value="true">Giá trị nhỏ hơn xếp trên</option>
                                        <option value="false">Giá trị lớn hơn xếp trên</option>
                                    </select>
                                    <small class="form-text">Áp dụng khi không cho phép đồng hạng, ví dụ số lần thử phụ hoặc thời gian phản ứng.</small>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">Tên tiêu chí phụ</label>
                                    <input type="text" class="form-control" id="fmtTenTieuChiPhuThanhTich" maxlength="100" placeholder="VD: Lần nhảy tốt thứ hai">
                                    <small class="form-text">Tên này hiển thị trên bảng nhập kết quả cho trọng tài.</small>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold small">Quy cách chọn vào Chung kết</label>
                                    <select id="fmtQuyCachVaoCk" class="form-select">
                                        <option value="TopNToanVong">Lấy Top N thành tích tốt nhất toàn vòng</option>
                                        <option value="TopNTheoBang">Nhất & Nhì mỗi đợt + Top thành tích</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold small">Số vòng thi đấu</label>
                                    <select id="fmtSoVongThi" class="form-select">
                                        <option value="1">1 vòng (Chung kết tính giờ trực tiếp)</option>
                                        <option value="2" selected>2 vòng (Vòng loại → Chung kết Top 8)</option>
                                        <option value="3">3 vòng (Sơ loại → Bán kết → Chung kết)</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold small">Phương thức xếp lượt</label>
                                    <select id="fmtPhuongThucPhanNhom" class="form-select">
                                        <option value="random" selected>Bốc thăm ngẫu nhiên</option>
                                        <option value="performance_seed">Xếp theo hạt giống / thành tích</option>
                                        <option value="registration_order">Theo thứ tự đăng ký</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Panel: Cấu hình Thời lượng trận & Chia Bảng (Tự Động Xếp Lịch) - Luôn hiển thị cho mọi môn -->
                    <div class="card border border-primary-subtle shadow-sm rounded-3 mt-3 bg-white" id="panelThoiLuongVaChiaBang">
                        <div class="card-header bg-primary-subtle bg-opacity-25 border-bottom py-3 d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold mb-0 text-primary d-flex align-items-center gap-2">
                                <i class="fa-solid fa-clock-rotate-left"></i> Quy định Thời Lượng & Chia Bảng (Đồng bộ Tự Động Xếp Lịch)
                            </h6>
                            <span class="badge bg-primary text-white small px-2 py-1 shadow-2xs">Đồng bộ sang Lịch Thi Đấu</span>
                        </div>
                        <div class="card-body p-4">
                            <div class="alert alert-light border border-info-subtle text-muted rounded-3 py-2 px-3 small mb-3 d-flex align-items-center gap-2">
                                <i class="fa-solid fa-circle-info text-primary fs-6"></i>
                                <span>Cấu hình tại đây được hệ thống <strong>tự động đồng bộ vào thuật toán Xếp Lịch Thi Đấu</strong> tại <code>/Manager/LichThiDau</code> mà không cần người dùng cấu hình lại.</span>
                            </div>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">
                                        <i class="fa-solid fa-stopwatch text-primary me-1"></i><span id="lblThoiLuongTran">Thời lượng mỗi trận / lượt (phút)</span> <span class="text-danger">*</span>
                                    </label>
                                    <input type="number" class="form-control" id="fmtThoiLuongTranPhut" value="60" min="1" max="300" required>
                                    <small class="text-muted" id="subThoiLuongTran">Tổng thời lượng thi đấu dự kiến của 1 trận đấu/lượt thi</small>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">
                                        <i class="fa-solid fa-mug-hot text-primary me-1"></i><span id="lblNghiGiuaTran">Nghỉ giữa 2 trận (phút)</span> <span class="text-danger">*</span>
                                    </label>
                                    <input type="number" class="form-control" id="fmtNghiGiuaTranPhut" value="15" min="0" max="180" required>
                                    <small class="text-muted" id="subNghiGiuaTran">Thời gian giãn cách, dọn dẹp vệ sinh sân bãi giữa 2 trận liên tiếp</small>
                                </div>

                                <!-- Cấu hình chia bảng & vòng Knockout -->
                                <div class="col-12" id="boxFormatGroupConfig">
                                    <div class="p-3 bg-light rounded-3 border">
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <div class="d-flex align-items-center">
                                                <i class="fa-solid fa-table-cells-large text-primary me-2 fs-6"></i>
                                                <strong class="text-primary small">Cấu hình Chia Bảng Đấu & Vòng Knockout</strong>
                                            </div>
                                            <span class="badge bg-secondary-subtle text-secondary small" id="badgeGroupFormatStatus">Áp dụng khi thi đấu Bảng / Knockout</span>
                                        </div>
                                        <div class="row g-3">
                                            <div class="col-md-4">
                                                <label class="form-label fw-semibold small">Số bảng đấu</label>
                                                <select class="form-select form-select-sm" id="fmtSoBang">
                                                    <option value="0" selected>Tự động chia theo số đội</option>
                                                    <option value="1">1 bảng đấu (Vòng tròn 1 bảng)</option>
                                                    <option value="2">2 bảng đấu (Bảng A & Bảng B)</option>
                                                    <option value="3">3 bảng đấu (Bảng A, B, C)</option>
                                                    <option value="4">4 bảng đấu (Bảng A, B, C, D)</option>
                                                    <option value="6">6 bảng đấu (Bảng A đến F)</option>
                                                    <option value="8">8 bảng đấu (Bảng A đến H)</option>
                                                </select>
                                                <small class="text-muted">Chọn số bảng hoặc để thuật toán tự tính</small>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label fw-semibold small">Số đội mỗi bảng <span class="text-danger">*</span></label>
                                                <input type="number" class="form-control form-control-sm" id="fmtSoDoiMoiBang" value="4" min="2" max="16">
                                                <small class="text-muted">Dùng khi chọn Tự động chia (mặc định 4)</small>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label fw-semibold small">Đội vào Vòng Knockout</label>
                                                <select class="form-select form-select-sm" id="fmtSoDoiMoiBangVaoVongTrong">
                                                    <option value="1">Chỉ Nhất bảng</option>
                                                    <option value="2" selected>Top 2 (Nhất & Nhì mỗi bảng)</option>
                                                    <option value="3">Top 3 mỗi bảng</option>
                                                    <option value="4">Top 4 mỗi bảng</option>
                                                </select>
                                                <small class="text-muted">Tiến vào Bán kết / Chung kết</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top px-4 py-3 bg-white">
                    <button type="button" class="btn btn-secondary rounded-3 px-3" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary rounded-3 px-4 shadow-sm" id="btnSaveTheThuc">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Lưu Cấu Hình Thể Thức
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentPage = 1;
        const pageSize = 10;

        $(document).ready(function () {
            loadData(1);

            $('#keyword').on('keypress', function (e) {
                if (e.which === 13) loadData(1);
            });

            $('#danhMucFilter, #gioiTinhFilter').on('change', function () {
                loadData(1);
            });

            $('#formMon').on('submit', function (e) {
                e.preventDefault();
                saveData();
            });

            $('#formTheThuc').on('submit', function (e) {
                e.preventDefault();
                saveFormatData();
            });
        });

        function loadData(page) {
            currentPage = page;
            const keyword = $('#keyword').val().trim();
            const danhMucId = $('#danhMucFilter').val();
            const gioiTinh = $('#gioiTinhFilter').val();

            $.ajax({
                url: '/Admin/MonTheThao/GetPagedData',
                type: 'GET',
                data: {
                    pageIndex: page,
                    pageSize: pageSize,
                    keyword: keyword || undefined,
                    danhMucId: danhMucId ? parseInt(danhMucId) : undefined,
                    gioiTinh: gioiTinh || undefined
                },
                success: function (res) {
                    if (res.success && res.data) {
                        renderTable(res.data);
                    }
                }
            });
        }

        function renderTable(data) {
            const items = data.items || [];
            if (items.length === 0) {
                $('#tblBody').html('<tr><td colspan="8" class="text-center py-5 text-muted">Chưa có môn thể thao nào.</td></tr>');
                $('#paginationInfo').text('Hiển thị 0 trên 0 môn thể thao');
                $('#paginationList').empty();
                return;
            }

            let html = '';
            const start = (data.pageIndex - 1) * data.pageSize;

            $.each(items, function (i, item) {
                const stt = start + i + 1;
                const gioiTinhBadge = renderGioiTinhBadge(item.gioiTinh);
                const loaiMon = item.laMonDongDoi ? '<span class="badge bg-primary-subtle text-primary border">Đồng đội</span>' : '<span class="badge bg-secondary-subtle text-secondary border">Cá nhân</span>';

                html += `
                    <tr>
                        <td class="ps-3 fw-bold text-muted">${stt}</td>
                        <td>
                            <div class="fw-bold text-dark">${escapeHtml(item.ten)}</div>
                            <small class="text-muted"><span class="badge bg-light text-secondary border">Mã: ${escapeHtml(item.ma)}</span></small>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border"><i class="fa-solid fa-folder me-1 text-warning"></i>${escapeHtml(item.tenDanhMuc || 'Chung')}</span>
                        </td>
                        <td>
                            <div class="small fw-semibold">${escapeHtml(item.hinhThucThiDau || 'Chuẩn')}</div>
                            <div>${loaiMon}</div>
                        </td>
                        <td>${gioiTinhBadge}</td>
                        <td>
                            <small class="text-muted">${item.soLuongVanDongVienToiThieu || 1} - ${item.soLuongVanDongVienToiDa || '∞'} VĐV</small>
                        </td>
                        <td>
                            <span class="badge ${item.trangThai ? 'bg-success' : 'bg-danger'} badge-status">
                                ${item.trangThai ? 'Hoạt động' : 'Tạm dừng'}
                            </span>
                        </td>
                        <td class="text-end pe-3">
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-light border text-primary" title="Cấu hình thể thức & luật thi đấu" onclick="openFormatModal(${item.id}, '${escapeHtml(item.ten)}', '${escapeHtml(item.hinhThucThiDau || 'LoaiTrucTiep')}')">
                                    <i class="fa-solid fa-sliders"></i>
                                </button>
                                <button type="button" class="btn btn-light border" title="Sửa" onclick="openEditModal(${item.id})">
                                    <i class="fa-solid fa-pen-to-square text-success"></i>
                                </button>
                                <button type="button" class="btn btn-light border" title="Xóa" onclick="deleteItem(${item.id}, '${escapeHtml(item.ten)}')">
                                    <i class="fa-solid fa-trash text-danger"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            });

            $('#tblBody').html(html);

            const total = data.totalCount || 0;
            const from = total === 0 ? 0 : start + 1;
            const to = Math.min(start + data.pageSize, total);
            $('#paginationInfo').text(`Hiển thị ${from} - ${to} trên tổng số ${total} môn thể thao`);

            renderPagination(data.pageIndex, data.totalPages);
        }

        function renderGioiTinhBadge(gt) {
            if (gt === 'Nam') return '<span class="badge bg-info text-dark">Nam</span>';
            if (gt === 'Nu') return '<span class="badge bg-danger-subtle text-danger border">Nữ</span>';
            return '<span class="badge bg-secondary-subtle text-dark border">Nam / Nữ</span>';
        }

        function renderPagination(current, totalPages) {
            if (totalPages <= 1) {
                $('#paginationList').empty();
                return;
            }

            let pagHtml = '';
            pagHtml += `<li class="page-item ${current === 1 ? 'disabled' : ''}">
                <a class="page-link" href="javascript:void(0)" onclick="loadData(${current - 1})">&laquo;</a>
            </li>`;

            for (let i = 1; i <= totalPages; i++) {
                if (i === 1 || i === totalPages || (i >= current - 2 && i <= current + 2)) {
                    pagHtml += `<li class="page-item ${i === current ? 'active' : ''}">
                        <a class="page-link" href="javascript:void(0)" onclick="loadData(${i})">${i}</a>
                    </li>`;
                }
            }

            pagHtml += `<li class="page-item ${current === totalPages ? 'disabled' : ''}">
                <a class="page-link" href="javascript:void(0)" onclick="loadData(${current + 1})">&raquo;</a>
            </li>`;

            $('#paginationList').html(pagHtml);
        }

        function openCreateModal() {
            $('#modalTitle').text('Thêm Môn Thể Thao Mới');
            $('#monId').val('');
            $('#ten').val('');
            $('#ma').val('');
            $('#danhMucId').val('');
            $('#gioiTinh').val('HonHop');
            $('#hinhThucThiDau').val('');
            $('#laMonDongDoi').prop('checked', false);
            $('#soLuongVanDongVienToiThieu').val('1');
            $('#soLuongVanDongVienToiDa').val('10');
            $('#soDoiToiDa').val('');
            $('#moTa').val('');
            $('#trangThai').prop('checked', true);
            $('#modalMon').modal('show');
        }

        function openEditModal(id) {
            $.get('/Admin/MonTheThao/GetById', { id: id }, function (res) {
                if (res.success && res.data) {
                    const item = res.data;
                    $('#modalTitle').text('Chỉnh Sửa Môn Thể Thao');
                    $('#monId').val(item.id);
                    $('#ten').val(item.ten);
                    $('#ma').val(item.ma || '');
                    $('#danhMucId').val(item.danhMucId);
                    $('#gioiTinh').val(item.gioiTinh || 'HonHop');
                    $('#hinhThucThiDau').val(item.hinhThucThiDau || '');
                    $('#laMonDongDoi').prop('checked', item.laMonDongDoi);
                    $('#soLuongVanDongVienToiThieu').val(item.soLuongVanDongVienToiThieu || '');
                    $('#soLuongVanDongVienToiDa').val(item.soLuongVanDongVienToiDa || '');
                    $('#soDoiToiDa').val(item.soDoiToiDa || '');
                    $('#moTa').val(item.moTa || '');
                    $('#trangThai').prop('checked', item.trangThai);
                    $('#modalMon').modal('show');
                }
            });
        }

        function saveData() {
            const id = $('#monId').val();
            const ten = $('#ten').val().trim();
            const danhMucId = $('#danhMucId').val();

            if (!ten || !danhMucId) {
                Swal.fire('Lỗi', 'Vui lòng nhập tên môn và chọn danh mục.', 'warning');
                return;
            }

            const payload = {
                danhMucId: parseInt(danhMucId),
                ten: ten,
                ma: $('#ma').val().trim() || 'M-' + Date.now().toString().slice(-6),
                gioiTinh: $('#gioiTinh').val(),
                hinhThucThiDau: $('#hinhThucThiDau').val().trim() || null,
                laMonDongDoi: $('#laMonDongDoi').is(':checked'),
                soLuongVanDongVienToiThieu: $('#soLuongVanDongVienToiThieu').val() ? parseInt($('#soLuongVanDongVienToiThieu').val()) : null,
                soLuongVanDongVienToiDa: $('#soLuongVanDongVienToiDa').val() ? parseInt($('#soLuongVanDongVienToiDa').val()) : null,
                soDoiToiDa: $('#soDoiToiDa').val() ? parseInt($('#soDoiToiDa').val()) : null,
                moTa: $('#moTa').val().trim() || null,
                trangThai: $('#trangThai').is(':checked')
            };

            const url = id ? `/Admin/MonTheThao/Save?id=${id}` : '/Admin/MonTheThao/Save';

            $.ajax({
                url: url,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    if (res.success) {
                        $('#modalMon').modal('hide');
                        SportApp.toast('success', res.message || 'Lưu môn thể thao thành công!');
                        loadData(currentPage);
                    } else {
                        Swal.fire('Lỗi', res.message || 'Không thể lưu môn.', 'error');
                    }
                }
            });
        }

        function deleteItem(id, name) {
            SportApp.confirm('Xóa Môn Thể Thao?', `Bạn có chắc muốn xóa môn "${name}" không?`, function () {
                $.post('/Admin/MonTheThao/Delete', { id: id }, function (res) {
                    if (res.success) {
                        SportApp.toast('success', res.message || 'Đã xóa môn!');
                        loadData(currentPage);
                    } else {
                        Swal.fire('Lỗi', res.message || 'Không thể xóa.', 'error');
                    }
                });
            });
        }

        function resetFilter() {
            $('#keyword').val('');
            $('#danhMucFilter').val('');
            $('#gioiTinhFilter').val('');
            loadData(1);
        }

        function escapeHtml(text) {
            if (!text) return '';
            return $('<div>').text(text).html();
        }

        // ================= CẤU HÌNH THỂ THỨC & LUẬT THI ĐẤU =================
        function onFormatTypeChange() {
            const loai = $('#fmtLoaiTheThuc').val();
            $('#panelSetDiem').toggleClass('d-none', loai !== 'SetDiem');
            $('#panelThoiGianHiep').toggleClass('d-none', loai !== 'ThoiGianHiep');
            $('#panelTinhDiemXepHang').toggleClass('d-none', loai !== 'TinhDiemXepHang');

            if (loai === 'SetDiem') {
                $('#fmtTypeNote').html('<i class="fa-solid fa-circle-info me-1"></i> <strong>Set điểm:</strong> Nhập điểm từng hiệp, áp dụng Deuce 2đ & trần điểm.');
                $('#lblThoiLuongTran').text('Thời lượng mỗi trận đấu (phút)');
                $('#lblNghiGiuaTran').text('Nghỉ giữa 2 trận liên tiếp (phút)');
                $('#subThoiLuongTran').text('Tổng thời lượng thi đấu dự kiến của 1 trận đấu');
                $('#subNghiGiuaTran').text('Thời gian giãn cách chuẩn bị sân bãi giữa 2 trận liên tiếp');
                $('#boxFormatGroupConfig').removeClass('d-none');
            } else if (loai === 'ThoiGianHiep') {
                $('#fmtTypeNote').html('<i class="fa-solid fa-circle-info me-1"></i> <strong>Thời gian:</strong> Tính tỉ số phút, hiệp phụ & luân lưu Penalty.');
                $('#lblThoiLuongTran').text('Thời lượng mỗi trận đấu (phút)');
                $('#lblNghiGiuaTran').text('Nghỉ giữa 2 trận liên tiếp (phút)');
                $('#subThoiLuongTran').text('Tổng thời lượng thi đấu dự kiến của 1 trận đấu');
                $('#subNghiGiuaTran').text('Thời gian giãn cách chuẩn bị sân bãi giữa 2 trận liên tiếp');
                $('#boxFormatGroupConfig').removeClass('d-none');
            } else {
                $('#fmtTypeNote').html('<i class="fa-solid fa-circle-info me-1"></i> <strong>Đo thành tích:</strong> Xếp hạng theo làn chạy/bơi, kiểm tra kỷ lục & vé Chung kết.');
                $('#lblThoiLuongTran').text('Thời lượng mỗi lượt thi / Heat (phút)');
                $('#lblNghiGiuaTran').text('Nghỉ giữa 2 lượt thi liên tiếp (phút)');
                $('#subThoiLuongTran').text('Tổng thời lượng thi đấu dự kiến của 1 lượt thi/đợt chạy');
                $('#subNghiGiuaTran').text('Thời gian giãn cách chuẩn bị làn bơi/đường chạy giữa 2 đợt');
                $('#boxFormatGroupConfig').addClass('d-none');
            }
            onBracketFormatChange();
        }

        function onBracketFormatChange() {
            const hinhThuc = $('#fmtHinhThucThiDau').val();
            const loaiTheThuc = $('#fmtLoaiTheThuc').val();
            let tipHtml = '';

            if (hinhThuc === 'LoaiTrucTiep') {
                tipHtml = `
                    <div class="alert alert-light border border-info-subtle text-muted rounded-3 py-2 px-3 small mb-0 d-flex align-items-center gap-2">
                        <i class="fa-solid fa-circle-info text-info fs-6"></i>
                        <span>Sơ đồ <strong>Loại trực tiếp (Knockout)</strong>: Các mục cấu hình chia bảng vẫn được lưu làm mẫu dự phòng nếu môn chuyển sang đấu bảng.</span>
                    </div>`;
                $('#badgeGroupFormatStatus').text('Dự phòng (Khi chuyển sang vòng bảng)');
            } else if (hinhThuc === 'TinhDiemXepHang' && loaiTheThuc !== 'TinhDiemXepHang') {
                tipHtml = `
                    <div class="alert alert-warning border border-warning-subtle text-warning-emphasis rounded-3 py-2 px-3 small mb-0 d-flex align-items-center gap-2">
                        <i class="fa-solid fa-triangle-exclamation text-warning fs-6"></i>
                        <span>Sơ đồ <strong>Đo thành tích</strong>: Khuyên dùng cơ chế tính điểm <strong>🏅 Đo thành tích / Chạy làn</strong> để hệ thống bấm giờ và chia làn thi đấu chuẩn xác.</span>
                    </div>`;
                $('#badgeGroupFormatStatus').text('Không áp dụng cho đo thành tích');
            } else if (hinhThuc === 'VongBang' || hinhThuc === 'KetHopVongBangVaLoaiTrucTiep') {
                tipHtml = `
                    <div class="alert alert-light border border-success-subtle text-muted rounded-3 py-2 px-3 small mb-0 d-flex align-items-center gap-2">
                        <i class="fa-solid fa-circle-check text-success fs-6"></i>
                        <span>Môn có <strong>Vòng bảng</strong>: Thông số Số bảng, Số đội/bảng và Số đội vào Knockout bên dưới sẽ được tự động nạp sang Lịch Thi Đấu.</span>
                    </div>`;
                $('#badgeGroupFormatStatus').text('Đang áp dụng trực tiếp cho giải');
            } else {
                $('#badgeGroupFormatStatus').text('Cấu hình mặc định');
            }

            $('#fmtBracketTipContainer').html(tipHtml);
        }

        function openFormatModal(monId, monTen, hinhThucThiDau) {
            $('#fmtMonId').val(monId);
            $('#formatModalTitle').text(`Cấu Hình Thể Thức & Luật Thi Đấu - ${monTen}`);
            $('#formatModalSubtitle').html(`Mã môn #${monId}: <strong>${monTen}</strong> • Tùy chỉnh luật và bracket engine`);

            // Mặc định ban đầu
            resetFormatForm();
            if (hinhThucThiDau) {
                $('#fmtHinhThucThiDau').val(hinhThucThiDau);
            }

            // Lấy cấu hình từ server (dùng chung API controller /Manager/CauHinhTheThuc)
            $.get('/Manager/CauHinhTheThuc/GetConfig', { monTheThaoId: monId }, function (res) {
                if (res && res.success && res.data) {
                    populateFormatForm(res.data);
                } else {
                    guessPreset(monTen);
                }
                $('#modalTheThuc').modal('show');
            }).fail(function () {
                guessPreset(monTen);
                $('#modalTheThuc').modal('show');
            });
        }

        function resetFormatForm() {
            $('#fmtHinhThucThiDau').val('LoaiTrucTiep');
            $('#fmtLoaiTheThuc').val('SetDiem');
            $('#fmtSoHiepToiDa').val(3);
            $('#fmtSoHiepThang').val(2);
            $('#fmtDiemMoiHiep').val(21);
            $('#fmtDiemHiepQuyetDinh').val(21);
            $('#fmtCachBiet').val(2);
            $('#fmtDiemToiDa').val(30);
            $('#fmtCachTinhDiemTheoSet').prop('checked', false);

            $('#fmtThoiGianChinh').val(45);
            $('#fmtDiemThang').val(3);
            $('#fmtDiemHoa').val(1);
            $('#fmtDiemThua').val(0);
            $('#fmtChoPhepHoaVongBang').prop('checked', true);
            $('#fmtCoHiepPhu').prop('checked', false);
            $('#fmtSoHiepPhu').val(2);
            $('#fmtThoiGianPhu').val(15);
            $('#fmtCoPenalty').prop('checked', true);
            $('#fmtSoLuotPen').val(5);
            $('#fmtCoThePhat').prop('checked', false);

            $('#fmtLoaiDo').val('ThoiGian');
            $('#fmtTieuChiThanhTich').val('CangNhoCangTot');
            $('#fmtChoPhepDongHangThanhTich').prop('checked', true);
            $('#fmtTieuChiPhuCangNhoCangTot').val('true');
            $('#fmtTenTieuChiPhuThanhTich').val('Chỉ số phụ');
            $('#fmtSoVdvLuot').val(8);
            $('#fmtQuyCachVaoCk').val('TopNToanVong');
            $('#fmtSoVdvVaoCk').val(8);
            $('#fmtKyLuc').val('');

            $('#fmtThoiLuongTranPhut').val(60);
            $('#fmtNghiGiuaTranPhut').val(15);
            $('#fmtSoBang').val(0);
            $('#fmtSoDoiMoiBang').val(4);
            $('#fmtSoDoiMoiBangVaoVongTrong').val(2);
            $('#fmtSoVongThi').val(2);
            $('#fmtPhuongThucPhanNhom').val('random');

            onFormatTypeChange();
        }

        function populateFormatForm(data) {
            if (data.hinhThucThiDau) {
                $('#fmtHinhThucThiDau').val(data.hinhThucThiDau);
            }
            $('#fmtLoaiTheThuc').val(data.loaiTheThuc || 'SetDiem');
            $('#fmtSoHiepToiDa').val(data.soHiepToiDa || 3);
            $('#fmtSoHiepThang').val(data.soHiepThangDeThangTran || 2);
            $('#fmtDiemMoiHiep').val(data.diemMoiHiep || 21);
            $('#fmtDiemHiepQuyetDinh').val(data.diemHiepQuyetDinh || 21);
            $('#fmtCachBiet').val(data.cachBietDiemToiThieu ?? 2);
            $('#fmtDiemToiDa').val(data.diemToiDaMoiHiep || '');
            $('#fmtCachTinhDiemTheoSet').prop('checked', !!data.cachTinhDiemTheoSet);

            $('#fmtThoiGianChinh').val(data.thoiGianHiepChinhPhut || 45);
            $('#fmtDiemThang').val(data.diemThang ?? 3);
            $('#fmtDiemHoa').val(data.diemHoa ?? 1);
            $('#fmtDiemThua').val(data.diemThua ?? 0);
            $('#fmtChoPhepHoaVongBang').prop('checked', data.choPhepHoaVongBang !== false);
            $('#fmtCoHiepPhu').prop('checked', !!data.coHiepPhu);
            $('#fmtSoHiepPhu').val(data.soHiepPhu || 2);
            $('#fmtThoiGianPhu').val(data.thoiGianHiepPhuPhut || 15);
            $('#fmtCoPenalty').prop('checked', data.coPenalty !== false);
            $('#fmtSoLuotPen').val(data.soLuotPenaltyMoiDoi || 5);
            $('#fmtCoThePhat').prop('checked', data.coThePhat === true);

            $('#fmtLoaiDo').val(data.loaiDoThanhTich || 'ThoiGian');
            $('#fmtTieuChiThanhTich').val(data.tieuChiXepHangThanhTich || 'CangNhoCangTot');
            $('#fmtChoPhepDongHangThanhTich').prop('checked', data.choPhepDongHangThanhTich !== false);
            $('#fmtTieuChiPhuCangNhoCangTot').val(data.tieuChiPhuCangNhoCangTot === false ? 'false' : 'true');
            $('#fmtTenTieuChiPhuThanhTich').val(data.tenTieuChiPhuThanhTich || 'Chỉ số phụ');
            $('#fmtSoVdvLuot').val(data.soVdvMoiLuotThi || 8);
            $('#fmtQuyCachVaoCk').val(data.quyCachTienVaoChungKet || 'TopNToanVong');
            $('#fmtSoVdvVaoCk').val(data.soVdvVaoChungKet || 8);
            $('#fmtKyLuc').val(data.kyLucHienTai || '');

            $('#fmtThoiLuongTranPhut').val(data.thoiLuongTranPhut || 60);
            $('#fmtNghiGiuaTranPhut').val(data.nghiGiuaTranPhut ?? 15);
            $('#fmtSoBang').val(data.soBang || 0);
            $('#fmtSoDoiMoiBang').val(data.soDoiMoiBang || 4);
            $('#fmtSoDoiMoiBangVaoVongTrong').val(data.soDoiMoiBangVaoVongTrong || 2);
            $('#fmtSoVongThi').val(data.soVongThi || 2);
            $('#fmtPhuongThucPhanNhom').val(data.phuongThucPhanNhom || 'random');

            onFormatTypeChange();
        }

        function guessPreset(name) {
            const lower = (name || '').toLowerCase();
            if (lower.includes('cầu lông') || lower.includes('badminton')) {
                applyPreset('badminton');
            } else if (lower.includes('bóng chuyền') || lower.includes('volleyball')) {
                applyPreset('volleyball');
            } else if (lower.includes('bóng bàn') || lower.includes('table tennis')) {
                applyPreset('tabletennis');
            } else if (lower.includes('bóng đá') || lower.includes('football') || lower.includes('futsal')) {
                applyPreset('football');
            } else if (lower.includes('điền kinh') || lower.includes('chạy') || lower.includes('100m')) {
                applyPreset('athletics');
            } else if (lower.includes('bơi')) {
                applyPreset('swimming');
            } else {
                applyPreset('badminton');
            }
        }

        function applyPreset(preset) {
            if (preset === 'badminton') {
                $('#fmtHinhThucThiDau').val('LoaiTrucTiep');
                $('#fmtLoaiTheThuc').val('SetDiem');
                $('#fmtSoHiepToiDa').val(3);
                $('#fmtSoHiepThang').val(2);
                $('#fmtDiemMoiHiep').val(21);
                $('#fmtDiemHiepQuyetDinh').val(21);
                $('#fmtCachBiet').val(2);
                $('#fmtDiemToiDa').val(30);
                $('#fmtCachTinhDiemTheoSet').prop('checked', false);
                $('#fmtThoiLuongTranPhut').val(45);
                $('#fmtNghiGiuaTranPhut').val(15);
                $('#fmtSoBang').val(0);
                $('#fmtSoDoiMoiBang').val(4);
            } else if (preset === 'volleyball') {
                $('#fmtHinhThucThiDau').val('KetHopVongBangVaLoaiTrucTiep');
                $('#fmtLoaiTheThuc').val('SetDiem');
                $('#fmtSoHiepToiDa').val(5);
                $('#fmtSoHiepThang').val(3);
                $('#fmtDiemMoiHiep').val(25);
                $('#fmtDiemHiepQuyetDinh').val(15);
                $('#fmtCachBiet').val(2);
                $('#fmtDiemToiDa').val('');
                $('#fmtCachTinhDiemTheoSet').prop('checked', true);
                $('#fmtThoiLuongTranPhut').val(75);
                $('#fmtNghiGiuaTranPhut').val(15);
                $('#fmtSoBang').val(2);
                $('#fmtSoDoiMoiBang').val(4);
            } else if (preset === 'football') {
                $('#fmtHinhThucThiDau').val('KetHopVongBangVaLoaiTrucTiep');
                $('#fmtLoaiTheThuc').val('ThoiGianHiep');
                $('#fmtThoiGianChinh').val(45);
                $('#fmtDiemThang').val(3);
                $('#fmtDiemHoa').val(1);
                $('#fmtDiemThua').val(0);
                $('#fmtChoPhepHoaVongBang').prop('checked', true);
                $('#fmtCoHiepPhu').prop('checked', true);
                $('#fmtSoHiepPhu').val(2);
                $('#fmtThoiGianPhu').val(15);
                $('#fmtCoPenalty').prop('checked', true);
                $('#fmtSoLuotPen').val(5);
                $('#fmtCoThePhat').prop('checked', true);
                $('#fmtThoiLuongTranPhut').val(60);
                $('#fmtNghiGiuaTranPhut').val(15);
                $('#fmtSoBang').val(0);
                $('#fmtSoDoiMoiBang').val(4);
                $('#fmtSoDoiMoiBangVaoVongTrong').val(2);
            } else if (preset === 'tabletennis') {
                $('#fmtHinhThucThiDau').val('VongBang');
                $('#fmtLoaiTheThuc').val('SetDiem');
                $('#fmtSoHiepToiDa').val(5);
                $('#fmtSoHiepThang').val(3);
                $('#fmtDiemMoiHiep').val(11);
                $('#fmtDiemHiepQuyetDinh').val(11);
                $('#fmtCachBiet').val(2);
                $('#fmtDiemToiDa').val('');
                $('#fmtCachTinhDiemTheoSet').prop('checked', false);
                $('#fmtThoiLuongTranPhut').val(35);
                $('#fmtNghiGiuaTranPhut').val(10);
                $('#fmtSoBang').val(0);
                $('#fmtSoDoiMoiBang').val(4);
            } else if (preset === 'athletics') {
                $('#fmtHinhThucThiDau').val('TinhDiemXepHang');
                $('#fmtLoaiTheThuc').val('TinhDiemXepHang');
                $('#fmtLoaiDo').val('ThoiGian');
                $('#fmtTieuChiThanhTich').val('CangNhoCangTot');
                $('#fmtSoVdvLuot').val(8);
                $('#fmtQuyCachVaoCk').val('TopNToanVong');
                $('#fmtSoVdvVaoCk').val(8);
                $('#fmtKyLuc').val(9.58);
                $('#fmtThoiLuongTranPhut').val(20);
                $('#fmtNghiGiuaTranPhut').val(10);
                $('#fmtSoVongThi').val(2);
                $('#fmtPhuongThucPhanNhom').val('performance_seed');
            } else if (preset === 'swimming') {
                $('#fmtHinhThucThiDau').val('TinhDiemXepHang');
                $('#fmtLoaiTheThuc').val('TinhDiemXepHang');
                $('#fmtLoaiDo').val('ThoiGian');
                $('#fmtTieuChiThanhTich').val('CangNhoCangTot');
                $('#fmtSoVdvLuot').val(8);
                $('#fmtQuyCachVaoCk').val('TopNToanVong');
                $('#fmtSoVdvVaoCk').val(8);
                $('#fmtKyLuc').val(20.91);
                $('#fmtThoiLuongTranPhut').val(20);
                $('#fmtNghiGiuaTranPhut').val(10);
                $('#fmtSoVongThi').val(2);
                $('#fmtPhuongThucPhanNhom').val('performance_seed');
            }
            onFormatTypeChange();
            SportApp.toast('info', `Đã áp dụng mẫu luật: ${preset.toUpperCase()}`);
        }

        function saveFormatData() {
            const monId = parseInt($('#fmtMonId').val());
            if (!monId) return;

            const loaiTheThuc = $('#fmtLoaiTheThuc').val();
            const payload = {
                monTheThaoId: monId,
                hinhThucThiDau: $('#fmtHinhThucThiDau').val() || undefined,
                loaiTheThuc: loaiTheThuc,
                soHiepToiDa: parseInt($('#fmtSoHiepToiDa').val()) || 3,
                soHiepThangDeThangTran: parseInt($('#fmtSoHiepThang').val()) || 2,
                diemMoiHiep: parseInt($('#fmtDiemMoiHiep').val()) || 21,
                diemHiepQuyetDinh: parseInt($('#fmtDiemHiepQuyetDinh').val()) || 21,
                cachBietDiemToiThieu: parseInt($('#fmtCachBiet').val()) || 2,
                diemToiDaMoiHiep: $('#fmtDiemToiDa').val() ? parseInt($('#fmtDiemToiDa').val()) : null,
                cachTinhDiemTheoSet: $('#fmtCachTinhDiemTheoSet').is(':checked'),

                thoiGianHiepChinhPhut: parseInt($('#fmtThoiGianChinh').val()) || 45,
                diemThang: parseFloat($('#fmtDiemThang').val()) || 3,
                diemHoa: parseFloat($('#fmtDiemHoa').val()) || 1,
                diemThua: parseFloat($('#fmtDiemThua').val()) || 0,
                choPhepHoaVongBang: $('#fmtChoPhepHoaVongBang').is(':checked'),
                coHiepPhu: $('#fmtCoHiepPhu').is(':checked'),
                soHiepPhu: parseInt($('#fmtSoHiepPhu').val()) || 2,
                thoiGianHiepPhuPhut: parseInt($('#fmtThoiGianPhu').val()) || 15,
                coPenalty: $('#fmtCoPenalty').is(':checked'),
                soLuotPenaltyMoiDoi: parseInt($('#fmtSoLuotPen').val()) || 5,
                coThePhat: $('#fmtCoThePhat').is(':checked'),

                loaiDoThanhTich: $('#fmtLoaiDo').val(),
                tieuChiXepHangThanhTich: $('#fmtTieuChiThanhTich').val(),
                choPhepDongHangThanhTich: $('#fmtChoPhepDongHangThanhTich').is(':checked'),
                tenTieuChiPhuThanhTich: ($('#fmtTenTieuChiPhuThanhTich').val() || '').trim(),
                tieuChiPhuCangNhoCangTot: $('#fmtTieuChiPhuCangNhoCangTot').val() === 'true',
                soVdvMoiLuotThi: parseInt($('#fmtSoVdvLuot').val()) || 8,
                quyCachTienVaoChungKet: $('#fmtQuyCachVaoCk').val(),
                soVdvVaoChungKet: parseInt($('#fmtSoVdvVaoCk').val()) || 8,
                kyLucHienTai: $('#fmtKyLuc').val() ? parseFloat($('#fmtKyLuc').val()) : null,

                thoiLuongTranPhut: parseInt($('#fmtThoiLuongTranPhut').val()) || 60,
                nghiGiuaTranPhut: parseInt($('#fmtNghiGiuaTranPhut').val()) ?? 15,
                soBang: parseInt($('#fmtSoBang').val()) || 0,
                soDoiMoiBang: parseInt($('#fmtSoDoiMoiBang').val()) || 4,
                soDoiMoiBangVaoVongTrong: parseInt($('#fmtSoDoiMoiBangVaoVongTrong').val()) || 2,
                soVongThi: parseInt($('#fmtSoVongThi').val()) || 2,
                phuongThucPhanNhom: $('#fmtPhuongThucPhanNhom').val() || 'random'
            };

            const $btn = $('#btnSaveTheThuc');
            $btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin me-1"></i> Đang lưu...');

            $.ajax({
                url: '/Manager/CauHinhTheThuc/SaveConfig',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    $btn.prop('disabled', false).html('<i class="fa-solid fa-floppy-disk me-1"></i> Lưu Cấu Hình Thể Thức');
                    if (res && res.success) {
                        $('#modalTheThuc').modal('hide');
                        SportApp.toast('success', res.message || 'Đã lưu cấu hình thể thức thành công!');
                        loadData(currentPage);
                    } else {
                        Swal.fire('Lỗi', res.message || 'Không thể lưu cấu hình thể thức.', 'error');
                    }
                },
                error: function (xhr) {
                    $btn.prop('disabled', false).html('<i class="fa-solid fa-floppy-disk me-1"></i> Lưu Cấu Hình Thể Thức');
                    Swal.fire('Lỗi', 'Không thể kết nối máy chủ để lưu cấu hình.', 'error');
                }
            });
        }
    </script>
}
