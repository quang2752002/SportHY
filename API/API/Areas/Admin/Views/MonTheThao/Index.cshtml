@{
    ViewData["Title"] = "Quản lý Môn Thể Thao";
    var danhMucs = ViewBag.DanhMucs as IEnumerable<DanhMucMonTheThaoDto> ?? Enumerable.Empty<DanhMucMonTheThaoDto>();
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1 text-dark">
            <i class="fa-solid fa-volleyball text-primary me-2"></i>Quản lý Môn Thể Thao Thi Đấu
        </h4>
        <p class="text-muted small mb-0">Cấu hình danh mục môn, thể thức thi đấu, giới tính và quy định số lượng VĐV.</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-primary shadow-sm" onclick="openCreateModal()">
            <i class="fa-solid fa-plus me-1"></i> Thêm Môn Thể Thao Mới
        </button>
    </div>
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="card card-custom mb-4">
    <div class="card-body p-3">
        <div class="row g-2 align-items-center">
            <div class="col-md-5">
                <input type="text" id="keyword" class="form-control" placeholder="Tìm theo tên môn, mã môn...">
            </div>
            <div class="col-md-3">
                <select id="danhMucFilter" class="form-select">
                    <option value="">-- Tất cả danh mục --</option>
                    @foreach (var dm in danhMucs)
                    {
                        <option value="@dm.Id">@dm.Ten</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select id="gioiTinhFilter" class="form-select">
                    <option value="">-- Giới tính --</option>
                    <option value="Nam">Nam</option>
                    <option value="Nu">Nữ</option>
                    <option value="HonHop">Hỗn hợp (Nam/Nữ)</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="button" class="btn btn-primary flex-grow-1" onclick="loadData(1)">
                    <i class="fa-solid fa-filter me-1"></i> Lọc
                </button>
                <button type="button" class="btn btn-outline-secondary" onclick="resetFilter()" title="Làm mới">
                    <i class="fa-solid fa-arrows-rotate"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Bảng danh sách Môn thể thao -->
<div class="card card-custom">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="tblMonTheThao">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3" style="width: 50px;">STT</th>
                        <th>Tên Môn Thể Thao</th>
                        <th>Danh Mục</th>
                        <th>Hình Thức</th>
                        <th>Giới Tính</th>
                        <th>Quy Mô VĐV</th>
                        <th>Trạng Thái</th>
                        <th class="text-end pe-3" style="width: 130px;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody id="tblBody">
                    <tr><td colspan="8" class="text-center py-5 text-muted">Đang tải danh sách môn thể thao...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center py-3">
        <div class="text-muted small" id="paginationInfo">Hiển thị 0 trên 0 môn thể thao</div>
        <ul class="pagination pagination-sm mb-0" id="paginationList"></ul>
    </div>
</div>

<!-- Modal Thêm / Sửa Môn Thể Thao -->
<div class="modal fade" id="modalMon" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="modalTitle">Thêm Môn Thể Thao Mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formMon">
                <input type="hidden" id="monId" value="">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">Tên môn thể thao <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="ten" required placeholder="Ví dụ: Bóng Đá 7 Người">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Mã môn</label>
                            <input type="text" class="form-control" id="ma" placeholder="BD-07">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Danh mục môn <span class="text-danger">*</span></label>
                            <select class="form-select" id="danhMucId" required>
                                <option value="">-- Chọn danh mục --</option>
                                @foreach (var dm in danhMucs)
                                {
                                    <option value="@dm.Id">@dm.Ten</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Giới tính áp dụng</label>
                            <select class="form-select" id="gioiTinh">
                                <option value="HonHop">Hỗn hợp (Nam / Nữ)</option>
                                <option value="Nam">Nam</option>
                                <option value="Nu">Nữ</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Hình thức / Thể thức thi đấu</label>
                            <input type="text" class="form-control" id="hinhThucThiDau" placeholder="Ví dụ: Vòng bảng + Loại trực tiếp">
                        </div>
                        <div class="col-md-6 d-flex align-items-center pt-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="laMonDongDoi">
                                <label class="form-check-label fw-semibold" for="laMonDongDoi">Môn thi đấu Đồng đội (Theo đội tuyển)</label>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Số VĐV tối thiểu</label>
                            <input type="number" class="form-control" id="soLuongVanDongVienToiThieu" placeholder="1">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Số VĐV tối đa</label>
                            <input type="number" class="form-control" id="soLuongVanDongVienToiDa" placeholder="14">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Số đội tối đa</label>
                            <input type="number" class="form-control" id="soDoiToiDa" placeholder="16">
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Mô tả / Luật thi đấu</label>
                            <textarea class="form-control" id="moTa" rows="2" placeholder="Ghi chú luật thi đấu áp dụng..."></textarea>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="trangThai" checked>
                                <label class="form-check-label fw-semibold" for="trangThai">Hoạt động (Cho phép tổ chức)</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary" id="btnSave">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Lưu thông tin
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentPage = 1;
        const pageSize = 10;

        $(document).ready(function () {
            loadData(1);

            $('#keyword').on('keypress', function (e) {
                if (e.which === 13) loadData(1);
            });

            $('#danhMucFilter, #gioiTinhFilter').on('change', function () {
                loadData(1);
            });

            $('#formMon').on('submit', function (e) {
                e.preventDefault();
                saveData();
            });
        });

        function loadData(page) {
            currentPage = page;
            const keyword = $('#keyword').val().trim();
            const danhMucId = $('#danhMucFilter').val();
            const gioiTinh = $('#gioiTinhFilter').val();

            $.ajax({
                url: '/Admin/MonTheThao/GetPagedData',
                type: 'GET',
                data: {
                    pageIndex: page,
                    pageSize: pageSize,
                    keyword: keyword || undefined,
                    danhMucId: danhMucId ? parseInt(danhMucId) : undefined,
                    gioiTinh: gioiTinh || undefined
                },
                success: function (res) {
                    if (res.success && res.data) {
                        renderTable(res.data);
                    }
                }
            });
        }

        function renderTable(data) {
            const items = data.items || [];
            if (items.length === 0) {
                $('#tblBody').html('<tr><td colspan="8" class="text-center py-5 text-muted">Chưa có môn thể thao nào.</td></tr>');
                $('#paginationInfo').text('Hiển thị 0 trên 0 môn thể thao');
                $('#paginationList').empty();
                return;
            }

            let html = '';
            const start = (data.pageIndex - 1) * data.pageSize;

            $.each(items, function (i, item) {
                const stt = start + i + 1;
                const gioiTinhBadge = renderGioiTinhBadge(item.gioiTinh);
                const loaiMon = item.laMonDongDoi ? '<span class="badge bg-primary-subtle text-primary border">Đồng đội</span>' : '<span class="badge bg-secondary-subtle text-secondary border">Cá nhân</span>';

                html += `
                    <tr>
                        <td class="ps-3 fw-bold text-muted">${stt}</td>
                        <td>
                            <div class="fw-bold text-dark">${escapeHtml(item.ten)}</div>
                            <small class="text-muted"><span class="badge bg-light text-secondary border">Mã: ${escapeHtml(item.ma)}</span></small>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border"><i class="fa-solid fa-folder me-1 text-warning"></i>${escapeHtml(item.tenDanhMuc || 'Chung')}</span>
                        </td>
                        <td>
                            <div class="small fw-semibold">${escapeHtml(item.hinhThucThiDau || 'Chuẩn')}</div>
                            <div>${loaiMon}</div>
                        </td>
                        <td>${gioiTinhBadge}</td>
                        <td>
                            <small class="text-muted">${item.soLuongVanDongVienToiThieu || 1} - ${item.soLuongVanDongVienToiDa || '∞'} VĐV</small>
                        </td>
                        <td>
                            <span class="badge ${item.trangThai ? 'bg-success' : 'bg-danger'} badge-status">
                                ${item.trangThai ? 'Hoạt động' : 'Tạm dừng'}
                            </span>
                        </td>
                        <td class="text-end pe-3">
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-light border" title="Sửa" onclick="openEditModal(${item.id})">
                                    <i class="fa-solid fa-pen-to-square text-success"></i>
                                </button>
                                <button type="button" class="btn btn-light border" title="Xóa" onclick="deleteItem(${item.id}, '${escapeHtml(item.ten)}')">
                                    <i class="fa-solid fa-trash text-danger"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            });

            $('#tblBody').html(html);

            const total = data.totalCount || 0;
            const from = total === 0 ? 0 : start + 1;
            const to = Math.min(start + data.pageSize, total);
            $('#paginationInfo').text(`Hiển thị ${from} - ${to} trên tổng số ${total} môn thể thao`);

            renderPagination(data.pageIndex, data.totalPages);
        }

        function renderGioiTinhBadge(gt) {
            if (gt === 'Nam') return '<span class="badge bg-info text-dark">Nam</span>';
            if (gt === 'Nu') return '<span class="badge bg-danger-subtle text-danger border">Nữ</span>';
            return '<span class="badge bg-secondary-subtle text-dark border">Nam / Nữ</span>';
        }

        function renderPagination(current, totalPages) {
            if (totalPages <= 1) {
                $('#paginationList').empty();
                return;
            }

            let pagHtml = '';
            pagHtml += `<li class="page-item ${current === 1 ? 'disabled' : ''}">
                <a class="page-link" href="javascript:void(0)" onclick="loadData(${current - 1})">&laquo;</a>
            </li>`;

            for (let i = 1; i <= totalPages; i++) {
                if (i === 1 || i === totalPages || (i >= current - 2 && i <= current + 2)) {
                    pagHtml += `<li class="page-item ${i === current ? 'active' : ''}">
                        <a class="page-link" href="javascript:void(0)" onclick="loadData(${i})">${i}</a>
                    </li>`;
                }
            }

            pagHtml += `<li class="page-item ${current === totalPages ? 'disabled' : ''}">
                <a class="page-link" href="javascript:void(0)" onclick="loadData(${current + 1})">&raquo;</a>
            </li>`;

            $('#paginationList').html(pagHtml);
        }

        function openCreateModal() {
            $('#modalTitle').text('Thêm Môn Thể Thao Mới');
            $('#monId').val('');
            $('#ten').val('');
            $('#ma').val('');
            $('#danhMucId').val('');
            $('#gioiTinh').val('HonHop');
            $('#hinhThucThiDau').val('');
            $('#laMonDongDoi').prop('checked', false);
            $('#soLuongVanDongVienToiThieu').val('1');
            $('#soLuongVanDongVienToiDa').val('10');
            $('#soDoiToiDa').val('');
            $('#moTa').val('');
            $('#trangThai').prop('checked', true);
            $('#modalMon').modal('show');
        }

        function openEditModal(id) {
            $.get('/Admin/MonTheThao/GetById', { id: id }, function (res) {
                if (res.success && res.data) {
                    const item = res.data;
                    $('#modalTitle').text('Chỉnh Sửa Môn Thể Thao');
                    $('#monId').val(item.id);
                    $('#ten').val(item.ten);
                    $('#ma').val(item.ma || '');
                    $('#danhMucId').val(item.danhMucId);
                    $('#gioiTinh').val(item.gioiTinh || 'HonHop');
                    $('#hinhThucThiDau').val(item.hinhThucThiDau || '');
                    $('#laMonDongDoi').prop('checked', item.laMonDongDoi);
                    $('#soLuongVanDongVienToiThieu').val(item.soLuongVanDongVienToiThieu || '');
                    $('#soLuongVanDongVienToiDa').val(item.soLuongVanDongVienToiDa || '');
                    $('#soDoiToiDa').val(item.soDoiToiDa || '');
                    $('#moTa').val(item.moTa || '');
                    $('#trangThai').prop('checked', item.trangThai);
                    $('#modalMon').modal('show');
                }
            });
        }

        function saveData() {
            const id = $('#monId').val();
            const ten = $('#ten').val().trim();
            const danhMucId = $('#danhMucId').val();

            if (!ten || !danhMucId) {
                Swal.fire('Lỗi', 'Vui lòng nhập tên môn và chọn danh mục.', 'warning');
                return;
            }

            const payload = {
                danhMucId: parseInt(danhMucId),
                ten: ten,
                ma: $('#ma').val().trim() || 'M-' + Date.now().toString().slice(-6),
                gioiTinh: $('#gioiTinh').val(),
                hinhThucThiDau: $('#hinhThucThiDau').val().trim() || null,
                laMonDongDoi: $('#laMonDongDoi').is(':checked'),
                soLuongVanDongVienToiThieu: $('#soLuongVanDongVienToiThieu').val() ? parseInt($('#soLuongVanDongVienToiThieu').val()) : null,
                soLuongVanDongVienToiDa: $('#soLuongVanDongVienToiDa').val() ? parseInt($('#soLuongVanDongVienToiDa').val()) : null,
                soDoiToiDa: $('#soDoiToiDa').val() ? parseInt($('#soDoiToiDa').val()) : null,
                moTa: $('#moTa').val().trim() || null,
                trangThai: $('#trangThai').is(':checked')
            };

            const url = id ? `/Admin/MonTheThao/Save?id=${id}` : '/Admin/MonTheThao/Save';

            $.ajax({
                url: url,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    if (res.success) {
                        $('#modalMon').modal('hide');
                        SportApp.toast('success', res.message || 'Lưu môn thể thao thành công!');
                        loadData(currentPage);
                    } else {
                        Swal.fire('Lỗi', res.message || 'Không thể lưu môn.', 'error');
                    }
                }
            });
        }

        function deleteItem(id, name) {
            SportApp.confirm('Xóa Môn Thể Thao?', `Bạn có chắc muốn xóa môn "${name}" không?`, function () {
                $.post('/Admin/MonTheThao/Delete', { id: id }, function (res) {
                    if (res.success) {
                        SportApp.toast('success', res.message || 'Đã xóa môn!');
                        loadData(currentPage);
                    } else {
                        Swal.fire('Lỗi', res.message || 'Không thể xóa.', 'error');
                    }
                });
            });
        }

        function resetFilter() {
            $('#keyword').val('');
            $('#danhMucFilter').val('');
            $('#gioiTinhFilter').val('');
            loadData(1);
        }

        function escapeHtml(text) {
            if (!text) return '';
            return $('<div>').text(text).html();
        }
    </script>
}
