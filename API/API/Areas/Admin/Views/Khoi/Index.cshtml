@{
    ViewData["Title"] = "Quản lý Khối Tham Gia";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1 text-dark">
            <i class="fa-solid fa-layer-group text-primary me-2"></i>Quản lý Khối Tham Gia
        </h4>
        <p class="text-muted small mb-0">Phân loại các khối ngành, khối cơ quan, đơn vị hành chính và khối đối tượng tham gia thi đấu.</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-primary shadow-sm" onclick="openCreateModal()">
            <i class="fa-solid fa-plus me-1"></i> Thêm Khối Mới
        </button>
    </div>
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="card card-custom mb-4">
    <div class="card-body p-3">
        <div class="row g-2 align-items-center">
            <div class="col-md-6">
                <input type="text" id="keyword" class="form-control" placeholder="Tìm theo tên khối, mã khối...">
            </div>
            <div class="col-md-3">
                <select id="trangThaiFilter" class="form-select">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="true">Đang hoạt động</option>
                    <option value="false">Tạm dừng</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-1">
                <button type="button" class="btn btn-primary flex-grow-1" onclick="loadData(1)">
                    <i class="fa-solid fa-filter me-1"></i> Lọc
                </button>
                <button type="button" class="btn btn-outline-secondary" onclick="resetFilter()" title="Làm mới">
                    <i class="fa-solid fa-arrows-rotate"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Bảng dữ liệu Khối -->
<div class="card card-custom">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="tblKhoi">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3" style="width: 50px;">STT</th>
                        <th>Tên Khối Tham Gia</th>
                        <th>Mô Tả / Phân Loại</th>
                        <th>Số Đơn Vị Trực Thuộc</th>
                        <th>Trạng Thái</th>
                        <th class="text-end pe-3" style="width: 130px;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody id="tblBody">
                    <tr><td colspan="6" class="text-center py-5 text-muted">Đang tải danh sách khối...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center py-3">
        <div class="text-muted small" id="paginationInfo">Hiển thị 0 trên 0 khối</div>
        <ul class="pagination pagination-sm mb-0" id="paginationList"></ul>
    </div>
</div>

<!-- Modal Thêm / Sửa Khối -->
<div class="modal fade" id="modalKhoi" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="modalTitle">Thêm Khối Tham Gia Mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formKhoi">
                <input type="hidden" id="khoiId" value="">
                <div class="modal-body p-4">
                    <div class="row g-2 mb-3">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">Tên khối tham gia <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="ten" required placeholder="Ví dụ: Khối Giáo Dục & Đào Tạo">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Mã khối</label>
                            <input type="text" class="form-control" id="ma" placeholder="K-GD">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mô tả / Ghi chú</label>
                        <textarea class="form-control" id="moTa" rows="3" placeholder="Ghi chú về các đơn vị thuộc khối này..."></textarea>
                    </div>

                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="trangThai" checked>
                        <label class="form-check-label fw-semibold" for="trangThai">Hoạt động (Cho phép tham gia giải)</label>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary" id="btnSave">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Lưu thông tin
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentPage = 1;
        const pageSize = 10;

        $(document).ready(function () {
            loadData(1);

            $('#keyword').on('keypress', function (e) {
                if (e.which === 13) loadData(1);
            });

            $('#trangThaiFilter').on('change', function () {
                loadData(1);
            });

            $('#formKhoi').on('submit', function (e) {
                e.preventDefault();
                saveData();
            });
        });

        function loadData(page) {
            currentPage = page;
            const keyword = $('#keyword').val().trim();
            const trangThai = $('#trangThaiFilter').val();

            $.ajax({
                url: '/Admin/Khoi/GetPagedData',
                type: 'GET',
                data: {
                    pageIndex: page,
                    pageSize: pageSize,
                    keyword: keyword || undefined,
                    trangThai: trangThai !== '' ? (trangThai === 'true') : undefined
                },
                success: function (res) {
                    if (res.success && res.data) {
                        renderTable(res.data);
                    }
                }
            });
        }

        function renderTable(data) {
            const items = data.items || [];
            if (items.length === 0) {
                $('#tblBody').html('<tr><td colspan="6" class="text-center py-5 text-muted">Chưa có khối tham gia nào.</td></tr>');
                $('#paginationInfo').text('Hiển thị 0 trên 0 khối');
                $('#paginationList').empty();
                return;
            }

            let html = '';
            const start = (data.pageIndex - 1) * data.pageSize;

            $.each(items, function (i, item) {
                const stt = start + i + 1;
                html += `
                    <tr>
                        <td class="ps-3 fw-bold text-muted">${stt}</td>
                        <td>
                            <div class="fw-bold text-dark">${escapeHtml(item.ten)}</div>
                            <small class="text-muted"><span class="badge bg-light text-secondary border">Mã: ${escapeHtml(item.ma)}</span></small>
                        </td>
                        <td><small class="text-muted">${escapeHtml(item.moTa || '-')}</small></td>
                        <td>
                            <span class="badge bg-primary-subtle text-primary border p-2">
                                <i class="fa-solid fa-building-columns me-1"></i>${item.soDonVi || 0} đoàn/đơn vị
                            </span>
                        </td>
                        <td>
                            <span class="badge ${item.trangThai ? 'bg-success' : 'bg-danger'} badge-status">
                                ${item.trangThai ? 'Hoạt động' : 'Tạm dừng'}
                            </span>
                        </td>
                        <td class="text-end pe-3">
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-light border" title="Sửa" onclick="openEditModal(${item.id})">
                                    <i class="fa-solid fa-pen-to-square text-success"></i>
                                </button>
                                <button type="button" class="btn btn-light border" title="Xóa" onclick="deleteItem(${item.id}, '${escapeHtml(item.ten)}')">
                                    <i class="fa-solid fa-trash text-danger"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            });

            $('#tblBody').html(html);

            const total = data.totalCount || 0;
            const from = total === 0 ? 0 : start + 1;
            const to = Math.min(start + data.pageSize, total);
            $('#paginationInfo').text(`Hiển thị ${from} - ${to} trên tổng số ${total} khối`);

            renderPagination(data.pageIndex, data.totalPages);
        }

        function renderPagination(current, totalPages) {
            if (totalPages <= 1) {
                $('#paginationList').empty();
                return;
            }

            let pagHtml = '';
            pagHtml += `<li class="page-item ${current === 1 ? 'disabled' : ''}">
                <a class="page-link" href="javascript:void(0)" onclick="loadData(${current - 1})">&laquo;</a>
            </li>`;

            for (let i = 1; i <= totalPages; i++) {
                if (i === 1 || i === totalPages || (i >= current - 2 && i <= current + 2)) {
                    pagHtml += `<li class="page-item ${i === current ? 'active' : ''}">
                        <a class="page-link" href="javascript:void(0)" onclick="loadData(${i})">${i}</a>
                    </li>`;
                }
            }

            pagHtml += `<li class="page-item ${current === totalPages ? 'disabled' : ''}">
                <a class="page-link" href="javascript:void(0)" onclick="loadData(${current + 1})">&raquo;</a>
            </li>`;

            $('#paginationList').html(pagHtml);
        }

        function openCreateModal() {
            $('#modalTitle').text('Thêm Khối Tham Gia Mới');
            $('#khoiId').val('');
            $('#ten').val('');
            $('#ma').val('');
            $('#moTa').val('');
            $('#trangThai').prop('checked', true);
            $('#modalKhoi').modal('show');
        }

        function openEditModal(id) {
            $.get('/Admin/Khoi/GetById', { id: id }, function (res) {
                if (res.success && res.data) {
                    const item = res.data;
                    $('#modalTitle').text('Chỉnh Sửa Khối Tham Gia');
                    $('#khoiId').val(item.id);
                    $('#ten').val(item.ten);
                    $('#ma').val(item.ma || '');
                    $('#moTa').val(item.moTa || '');
                    $('#trangThai').prop('checked', item.trangThai);
                    $('#modalKhoi').modal('show');
                }
            });
        }

        function saveData() {
            const id = $('#khoiId').val();
            const ten = $('#ten').val().trim();
            if (!ten) {
                Swal.fire('Lỗi', 'Vui lòng nhập tên khối.', 'warning');
                return;
            }

            const payload = {
                ten: ten,
                ma: $('#ma').val().trim() || 'K-' + Date.now().toString().slice(-5),
                moTa: $('#moTa').val().trim() || null,
                trangThai: $('#trangThai').is(':checked')
            };

            const url = id ? `/Admin/Khoi/Save?id=${id}` : '/Admin/Khoi/Save';

            $.ajax({
                url: url,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    if (res.success) {
                        $('#modalKhoi').modal('hide');
                        SportApp.toast('success', res.message || 'Lưu khối thành công!');
                        loadData(currentPage);
                    } else {
                        Swal.fire('Lỗi', res.message || 'Không thể lưu khối.', 'error');
                    }
                }
            });
        }

        function deleteItem(id, name) {
            SportApp.confirm('Xóa Khối?', `Bạn có chắc muốn xóa khối "${name}" không?`, function () {
                $.post('/Admin/Khoi/Delete', { id: id }, function (res) {
                    if (res.success) {
                        SportApp.toast('success', res.message || 'Đã xóa khối!');
                        loadData(currentPage);
                    } else {
                        Swal.fire('Lỗi', res.message || 'Không thể xóa.', 'error');
                    }
                });
            });
        }

        function resetFilter() {
            $('#keyword').val('');
            $('#trangThaiFilter').val('');
            loadData(1);
        }

        function escapeHtml(text) {
            if (!text) return '';
            return $('<div>').text(text).html();
        }
    </script>
}
