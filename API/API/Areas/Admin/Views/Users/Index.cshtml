@{
    ViewData["Title"] = "Quản lý Tài Khoản & Vai Trò";
    var roles = ViewBag.Roles as string[] ?? Array.Empty<string>();
    var donVis = ViewBag.DonVis as IEnumerable<DonViDto> ?? Enumerable.Empty<DonViDto>();
    var trongTais = ViewBag.TrongTais as IEnumerable<TrongTaiDto> ?? Enumerable.Empty<TrongTaiDto>();
    var thuKys = ViewBag.ThuKys as IEnumerable<ThuKyDto> ?? Enumerable.Empty<ThuKyDto>();
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1 text-dark">
            <i class="fa-solid fa-users-gear text-primary me-2"></i>Quản lý Tài Khoản & Phân Quyền Theo Vai Trò
        </h4>
        <p class="text-muted small mb-0">Cấp tài khoản theo vai trò: quản lý, điều hành môn, trọng tài, thư ký và đơn vị/đoàn.</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-primary shadow-sm" onclick="openCreateModal()">
            <i class="fa-solid fa-user-plus me-1"></i> Thêm Tài Khoản Mới
        </button>
    </div>
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="card card-custom mb-4">
    <div class="card-body p-3">
        <div class="row g-2 align-items-center">
            <div class="col-md-5">
                <input type="text" id="keyword" class="form-control" placeholder="Tìm theo tên đăng nhập, họ tên, email...">
            </div>
            <div class="col-md-4">
                <select id="roleFilter" class="form-select">
                    <option value="">-- Tất cả vai trò (Roles) --</option>
                    @foreach (var r in roles)
                    {
                        <option value="@r">@r</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-1">
                <button type="button" class="btn btn-primary flex-grow-1" onclick="loadData(1)">
                    <i class="fa-solid fa-filter me-1"></i> Lọc
                </button>
                <button type="button" class="btn btn-outline-secondary" onclick="resetFilter()" title="Làm mới">
                    <i class="fa-solid fa-arrows-rotate"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Bảng dữ liệu người dùng -->
<div class="card card-custom">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="tblUsers">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3" style="width: 50px;">STT</th>
                        <th>Tên Đăng Nhập</th>
                        <th>Họ Và Tên</th>
                        <th>Email</th>
                        <th>Vai Trò (Role)</th>
                        <th>Phân Vùng Area Được Cấp</th>
                        <th>Hồ Sơ / Đơn Vị Liên Kết</th>
                        <th class="text-end pe-3" style="width: 130px;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody id="tblBody">
                    <tr><td colspan="8" class="text-center py-5 text-muted">Đang tải danh sách tài khoản...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center py-3">
        <div class="text-muted small" id="paginationInfo">Hiển thị 0 trên 0 người dùng</div>
        <ul class="pagination pagination-sm mb-0" id="paginationList"></ul>
    </div>
</div>

<!-- Modal Thêm / Sửa Tài Khoản -->
<div class="modal fade" id="modalUser" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="modalTitle">Thêm Tài Khoản Mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formUser">
                <input type="hidden" id="userId" value="">
                <div class="modal-body p-4">

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Vai trò phân quyền (Role) <span class="text-danger">*</span></label>
                        <select class="form-select" id="role" required>
                            @* <option value="Admin">Admin (Quản trị viên toàn quyền)</option> *@
                            <option value="Manager">Manager (Quản lý giải đấu)</option>
                            <option value="Delegation">Delegation (Đoàn thể thao / Đơn vị nộp hồ sơ)</option>
                            <option value="SportCoordinator">SportCoordinator (Người điều hành môn)</option>
                            <option value="HeadReferee">HeadReferee (Trưởng ban trọng tài)</option>
                            <option value="Referee">Referee (Trọng tài điều hành)</option>
                            <option value="Secretary">Secretary (Thư ký bàn)</option>
                        </select>
                        <div class="form-text text-primary small">
                            <i class="fa-solid fa-circle-check me-1"></i>
                            Tài khoản sẽ tự động được cấp quyền truy cập vào đúng phân vùng Area tương ứng với vai trò này.
                        </div>
                        <div class="form-text text-muted small d-none" id="coordinatorProfileHelp">
                            Hồ sơ người điều hành môn riêng sẽ tự động được tạo từ họ tên, email và số điện thoại của tài khoản.
                        </div>
                    </div>

                    <!-- Dropdown chọn đơn vị nếu là Delegation -->
                    <div class="mb-3 d-none" id="donViGroup">
                        <label class="form-label fw-semibold">Đơn vị / Đoàn thể thao quản lý <span class="text-danger">*</span></label>
                        <select class="form-select" id="donViId">
                            <option value="">-- Chọn đơn vị trực thuộc --</option>
                            @foreach (var dv in donVis)
                            {
                                <option value="@dv.Id" data-name="@(string.IsNullOrEmpty(dv.NguoiDaiDien) ? dv.Ten : dv.NguoiDaiDien)" data-email="@(dv.Email ?? "")">@dv.Ten</option>
                            }
                        </select>
                    </div>

                    <!-- Dropdown chọn trọng tài nếu là Referee hoặc HeadReferee -->
                    <div class="mb-3 d-none" id="trongTaiGroup">
                        <label class="form-label fw-semibold">Hồ sơ Trọng tài liên kết <span class="text-danger">*</span></label>
                        <select class="form-select" id="trongTaiId">
                            <option value="">-- Chọn hồ sơ trọng tài --</option>
                            @foreach (var tt in trongTais)
                            {
                                <option value="@tt.Id" data-name="@tt.HoTen" data-email="@(tt.Email ?? "")">@(string.IsNullOrEmpty(tt.Ma) ? tt.HoTen : $"{tt.Ma} - {tt.HoTen}")@(string.IsNullOrEmpty(tt.CapBac) ? "" : $" ({tt.CapBac})")</option>
                            }
                        </select>
                        <small class="text-muted">Chọn hồ sơ trọng tài để tự động điền họ tên, email và phân quyền.</small>
                    </div>

                    <!-- Dropdown chọn thư ký nếu là Secretary -->
                    <div class="mb-3 d-none" id="thuKyGroup">
                        <label class="form-label fw-semibold">Hồ sơ Thư ký liên kết <span class="text-danger">*</span></label>
                        <select class="form-select" id="thuKyId">
                            <option value="">-- Chọn hồ sơ thư ký --</option>
                            @foreach (var tk in thuKys)
                            {
                                <option value="@tk.Id" data-name="@tk.HoTen" data-email="@(tk.Email ?? "")">@(string.IsNullOrEmpty(tk.Ma) ? tk.HoTen : $"{tk.Ma} - {tk.HoTen}")@(string.IsNullOrEmpty(tk.ChucVu) ? "" : $" ({tk.ChucVu})")</option>
                            }
                        </select>
                        <small class="text-muted">Chọn hồ sơ thư ký để tự động điền họ tên, email và phân quyền.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên đăng nhập (Username) <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="username" required placeholder="Ví dụ: referee_an">
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Họ và tên đầy đủ <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="fullName" required placeholder="Ví dụ: Nguyễn Văn An">
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Địa chỉ Email <span class="text-danger">*</span></label>
                        <input type="email" class="form-control" id="email" required placeholder="nguyenvanan@gmail.com">
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold" id="lblPassword">Mật khẩu khởi tạo <span class="text-danger">*</span></label>
                        <input type="password" class="form-control" id="password" placeholder="••••••••">
                        <small class="text-muted" id="pwdHelp" style="display: none;">Để trống nếu không muốn đổi mật khẩu.</small>
                    </div>

                   
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary" id="btnSave">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Lưu tài khoản
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentPage = 1;
        const pageSize = 10;

        $(document).ready(function () {
            loadData(1);

            $('#keyword').on('keypress', function (e) {
                if (e.which === 13) loadData(1);
            });

            $('#roleFilter').on('change', function () {
                loadData(1);
            });

            $('#role').on('change', function () {
                toggleRoleLinkedGroups($(this).val());
            });

            // Khi chọn Đơn vị / Đoàn: tự động điền Họ tên và Email
            $('#donViId').on('change', function () {
                const opt = $(this).find('option:selected');
                const name = opt.data('name');
                const email = opt.data('email');
                if (name) $('#fullName').val(name);
                if (email) $('#email').val(email);
            });

            // Khi chọn Trọng tài: tự động điền Họ tên và Email
            $('#trongTaiId').on('change', function () {
                const opt = $(this).find('option:selected');
                const name = opt.data('name');
                const email = opt.data('email');
                if (name) $('#fullName').val(name);
                if (email) $('#email').val(email);
            });

            // Khi chọn Thư ký: tự động điền Họ tên và Email
            $('#thuKyId').on('change', function () {
                const opt = $(this).find('option:selected');
                const name = opt.data('name');
                const email = opt.data('email');
                if (name) $('#fullName').val(name);
                if (email) $('#email').val(email);
            });

            $('#formUser').on('submit', function (e) {
                e.preventDefault();
                saveData();
            });
        });

        function toggleRoleLinkedGroups(role) {
            $('#donViGroup').addClass('d-none');
            $('#trongTaiGroup').addClass('d-none');
            $('#thuKyGroup').addClass('d-none');
            $('#coordinatorProfileHelp').addClass('d-none');

            if (role === 'Delegation') {
                $('#donViGroup').removeClass('d-none');
            } else if (role === 'Referee' || role === 'HeadReferee') {
                $('#trongTaiGroup').removeClass('d-none');
            } else if (role === 'Secretary') {
                $('#thuKyGroup').removeClass('d-none');
            } else if (role === 'SportCoordinator') {
                $('#coordinatorProfileHelp').removeClass('d-none');
            }
        }

        function loadData(page) {
            currentPage = page;
            const keyword = $('#keyword').val().trim();
            const role = $('#roleFilter').val();

            $.ajax({
                url: '/Admin/Users/GetPagedData',
                type: 'GET',
                data: {
                    pageIndex: page,
                    pageSize: pageSize,
                    keyword: keyword || undefined,
                    role: role || undefined
                },
                success: function (res) {
                    if (res.success && res.data) {
                        renderTable(res.data);
                    }
                }
            });
        }

        function renderTable(data) {
            const items = data.items || [];
            if (items.length === 0) {
                $('#tblBody').html('<tr><td colspan="8" class="text-center py-5 text-muted">Chưa có tài khoản nào.</td></tr>');
                $('#paginationInfo').text('Hiển thị 0 trên 0 người dùng');
                $('#paginationList').empty();
                return;
            }

            let html = '';
            const start = (data.pageIndex - 1) * data.pageSize;

            $.each(items, function (i, item) {
                const stt = start + i + 1;
                const roleBadge = renderRoleBadge(item.role);
                const areaBadge = renderAreaBadge(item.role);

                // Render linked entity (Đoàn, Trọng tài, Thư ký)
                let linkedHtml = '<span class="text-muted small">-</span>';
                if (item.tenDonVi) {
                    linkedHtml = `<span class="badge bg-light text-dark border" title="Đơn vị / Đoàn thể thao"><i class="fa-solid fa-building-columns me-1 text-info"></i>${escapeHtml(item.tenDonVi)}</span>`;
                } else if (item.tenTrongTai) {
                    linkedHtml = `<span class="badge bg-light text-dark border" title="Hồ sơ Trọng tài"><i class="fa-solid fa-whistle me-1 text-primary"></i>${escapeHtml(item.tenTrongTai)}</span>`;
                } else if (item.tenThuKy) {
                    linkedHtml = `<span class="badge bg-light text-dark border" title="Hồ sơ Thư ký"><i class="fa-solid fa-clipboard-user me-1 text-secondary"></i>${escapeHtml(item.tenThuKy)}</span>`;
                } else if (item.tenNguoiDieuHanhMon) {
                    linkedHtml = `<span class="badge bg-light text-dark border" title="Hồ sơ Người điều hành môn"><i class="fa-solid fa-person-chalkboard me-1 text-primary"></i>${escapeHtml(item.tenNguoiDieuHanhMon)}</span>`;
                }

                html += `
                    <tr>
                        <td class="ps-3 fw-bold text-muted">${stt}</td>
                        <td>
                            <div class="fw-bold text-dark">
                                <i class="fa-solid fa-circle-user text-primary me-1"></i>${escapeHtml(item.username)}
                            </div>
                        </td>
                        <td>${escapeHtml(item.fullName)}</td>
                        <td><small class="text-muted">${escapeHtml(item.email)}</small></td>
                        <td>${roleBadge}</td>
                        <td>${areaBadge}</td>
                        <td>
                            ${linkedHtml}
                        </td>
                        <td class="text-end pe-3">
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-light border" title="Sửa vai trò" onclick="openEditModal(${item.id})">
                                    <i class="fa-solid fa-pen-to-square text-success"></i>
                                </button>
                                ${item.username.toLowerCase() !== 'admin' ? `
                                <button type="button" class="btn btn-light border" title="Xóa tài khoản" onclick="deleteItem(${item.id}, '${escapeHtml(item.username)}')">
                                    <i class="fa-solid fa-trash text-danger"></i>
                                </button>` : ''}
                            </div>
                        </td>
                    </tr>
                `;
            });

            $('#tblBody').html(html);

            const total = data.totalCount || 0;
            const from = total === 0 ? 0 : start + 1;
            const to = Math.min(start + data.pageSize, total);
            $('#paginationInfo').text(`Hiển thị ${from} - ${to} trên tổng số ${total} người dùng`);

            renderPagination(data.pageIndex, data.totalPages);
        }

        function renderRoleBadge(role) {
            switch (role) {
                case 'Admin': return '<span class="badge bg-danger badge-status"><i class="fa-solid fa-shield-halved me-1"></i>Admin</span>';
                case 'Manager': return '<span class="badge bg-warning text-dark badge-status">Manager</span>';
                case 'Delegation': return '<span class="badge bg-purple text-white badge-status" style="background-color: #8b5cf6;"><i class="fa-solid fa-flag me-1"></i>Đoàn VĐV</span>';
                case 'HeadReferee': return '<span class="badge bg-info text-dark badge-status">Trưởng Ban TT</span>';
                case 'Referee': return '<span class="badge bg-primary badge-status">Trọng Tài</span>';
                case 'Secretary': return '<span class="badge bg-secondary badge-status">Thư Ký</span>';
                case 'SportCoordinator': return '<span class="badge bg-primary badge-status">Điều hành môn</span>';
                default: return `<span class="badge bg-light text-dark border">${escapeHtml(role)}</span>`;
            }
        }

        function renderAreaBadge(role) {
            if (role === 'Admin' || role === 'Manager') {
                return '<span class="badge bg-primary-subtle text-primary border">Area: Admin</span>';
            }
            if (role === 'Delegation') {
                return '<span class="badge bg-info-subtle text-info border">Area: DonVi</span>';
            }
            if (role === 'SportCoordinator') {
                return '<span class="badge bg-primary-subtle text-primary border">Area: DieuHanhMon</span>';
            }
            return '<span class="badge bg-success-subtle text-success border">Area: TrongTai</span>';
        }

        function renderPagination(current, totalPages) {
            if (totalPages <= 1) {
                $('#paginationList').empty();
                return;
            }

            let pagHtml = '';
            pagHtml += `<li class="page-item ${current === 1 ? 'disabled' : ''}">
                <a class="page-link" href="javascript:void(0)" onclick="loadData(${current - 1})">&laquo;</a>
            </li>`;

            for (let i = 1; i <= totalPages; i++) {
                if (i === 1 || i === totalPages || (i >= current - 2 && i <= current + 2)) {
                    pagHtml += `<li class="page-item ${i === current ? 'active' : ''}">
                        <a class="page-link" href="javascript:void(0)" onclick="loadData(${i})">${i}</a>
                    </li>`;
                }
            }

            pagHtml += `<li class="page-item ${current === totalPages ? 'disabled' : ''}">
                <a class="page-link" href="javascript:void(0)" onclick="loadData(${current + 1})">&raquo;</a>
            </li>`;

            $('#paginationList').html(pagHtml);
        }

        function openCreateModal() {
            $('#modalTitle').text('Thêm Tài Khoản Mới');
            $('#userId').val('');
            $('#username').val('').prop('readonly', false);
            $('#fullName').val('');
            $('#email').val('');
            $('#password').val('123').prop('required', false);
            $('#lblPassword').html('Mật khẩu khởi tạo (Mặc định: 123)');
            $('#pwdHelp').hide();
            $('#role').val('Delegation');
            $('#donViId').val('');
            $('#trongTaiId').val('');
            $('#thuKyId').val('');
            toggleRoleLinkedGroups('Delegation');
            $('#modalUser').modal('show');
        }

        function openEditModal(id) {
            $.get('/Admin/Users/GetById', { id: id }, function (res) {
                if (res.success && res.data) {
                    const item = res.data;
                    $('#modalTitle').text('Chỉnh Sửa Tài Khoản');
                    $('#userId').val(item.id);
                    $('#username').val(item.username).prop('readonly', true);
                    $('#fullName').val(item.fullName);
                    $('#email').val(item.email);
                    $('#password').val('').prop('required', false);
                    $('#lblPassword').html('Đổi mật khẩu (Tùy chọn)');
                    $('#pwdHelp').show();
                    $('#role').val(item.role);
                    $('#donViId').val(item.donViId || '');
                    $('#trongTaiId').val(item.trongTaiId || '');
                    $('#thuKyId').val(item.thuKyId || '');
                    toggleRoleLinkedGroups(item.role);
                    $('#modalUser').modal('show');
                }
            });
        }

        function saveData() {
            const id = $('#userId').val();
            const username = $('#username').val().trim();
            const fullName = $('#fullName').val().trim();
            const email = $('#email').val().trim();
            const password = $('#password').val();
            const role = $('#role').val();
            const donViId = $('#donViId').val();
            const trongTaiId = $('#trongTaiId').val();
            const thuKyId = $('#thuKyId').val();

            if (!username || !fullName || !email) {
                Swal.fire('Lỗi', 'Vui lòng điền đầy đủ Tên đăng nhập, Họ tên và Email.', 'warning');
                return;
            }

            if (!id && !password) {
                Swal.fire('Lỗi', 'Vui lòng nhập mật khẩu khi tạo tài khoản mới.', 'warning');
                return;
            }

            if (role === 'Delegation' && !donViId) {
                Swal.fire('Lưu ý', 'Vui lòng chọn Đơn vị / Đoàn thể thao quản lý.', 'warning');
                return;
            }

            if ((role === 'Referee' || role === 'HeadReferee') && !trongTaiId) {
                Swal.fire('Lưu ý', 'Vui lòng chọn Hồ sơ Trọng tài liên kết.', 'warning');
                return;
            }

            if (role === 'Secretary' && !thuKyId) {
                Swal.fire('Lưu ý', 'Vui lòng chọn Hồ sơ Thư ký liên kết.', 'warning');
                return;
            }

            const payload = {
                username: username,
                fullName: fullName,
                email: email,
                password: password || null,
                role: role,
                donViId: role === 'Delegation' && donViId ? parseInt(donViId) : null,
                trongTaiId: (role === 'Referee' || role === 'HeadReferee') && trongTaiId ? parseInt(trongTaiId) : null,
                thuKyId: role === 'Secretary' && thuKyId ? parseInt(thuKyId) : null
            };

            const url = id ? `/Admin/Users/Save?id=${id}` : '/Admin/Users/Save';

            $.ajax({
                url: url,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    if (res.success) {
                        $('#modalUser').modal('hide');
                        SportApp.toast('success', res.message || 'Lưu tài khoản thành công!');
                        loadData(currentPage);
                    } else {
                        Swal.fire('Lỗi', res.message || 'Không thể lưu tài khoản.', 'error');
                    }
                }
            });
        }

        function deleteItem(id, username) {
            SportApp.confirm('Xóa Tài Khoản?', `Bạn có chắc muốn xóa tài khoản "${username}" không?`, function () {
                $.post('/Admin/Users/Delete', { id: id }, function (res) {
                    if (res.success) {
                        SportApp.toast('success', res.message || 'Đã xóa tài khoản!');
                        loadData(currentPage);
                    } else {
                        Swal.fire('Lỗi', res.message || 'Không thể xóa.', 'error');
                    }
                });
            });
        }

        function resetFilter() {
            $('#keyword').val('');
            $('#roleFilter').val('');
            loadData(1);
        }

        function escapeHtml(text) {
            if (!text) return '';
            return $('<div>').text(text).html();
        }
    </script>
}
