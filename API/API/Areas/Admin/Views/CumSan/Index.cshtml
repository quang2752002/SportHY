@{
    ViewData["Title"] = "Quản lý Cụm Sân";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1 text-dark">
            <i class="fa-solid fa-map-location-dot text-primary me-2"></i>Quản lý Cụm Sân Thi Đấu
        </h4>
        <p class="text-muted small mb-0">Quản lý các địa điểm thi đấu, cụm tổ hợp sân và trung tâm thể thao.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/Admin/SanDau" class="btn btn-outline-info">
            <i class="fa-solid fa-futbol me-1"></i> Quản lý Sân Đấu Chi Tiết
        </a>
        <button type="button" class="btn btn-primary shadow-sm" onclick="openCreateModal()">
            <i class="fa-solid fa-plus me-1"></i> Thêm Cụm Sân Mới
        </button>
    </div>
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="card card-custom mb-4">
    <div class="card-body p-3">
        <div class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </span>
                    <input type="text" id="keyword" class="form-control border-start-0 ps-0" placeholder="Tìm theo tên cụm sân, địa chỉ...">
                </div>
            </div>
            <div class="col-md-3">
                <select id="trangThaiFilter" class="form-select">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="true">Đang hoạt động</option>
                    <option value="false">Tạm dừng</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="button" class="btn btn-primary w-100" onclick="loadData(1)">
                    <i class="fa-solid fa-filter me-1"></i> Lọc
                </button>
            </div>
            <div class="col-md-2">
                <button type="button" class="btn btn-outline-secondary w-100" onclick="resetFilter()">
                    <i class="fa-solid fa-arrows-rotate me-1"></i> Làm mới
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Bảng Cụm Sân -->
<div class="card card-custom">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="tblCumSan">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3" style="width: 50px;">STT</th>
                        <th>Tên Cụm Sân</th>
                        <th>Địa Chỉ</th>
                        <th>Số Điện Thoại</th>
                        <th>Ghi Chú</th>
                        <th>Trạng Thái</th>
                        <th class="text-end pe-3" style="width: 130px;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody id="tblBody">
                    <tr><td colspan="7" class="text-center py-5 text-muted">Đang tải dữ liệu...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center py-3">
        <div class="text-muted small" id="paginationInfo">Hiển thị 0 trên 0 cụm sân</div>
        <ul class="pagination pagination-sm mb-0" id="paginationList"></ul>
    </div>
</div>

<!-- Modal Thêm / Sửa Cụm Sân -->
<div class="modal fade" id="modalCumSan" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="modalTitle">Thêm Cụm Sân Mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formCumSan">
                <input type="hidden" id="cumSanId" value="">
                <div class="modal-body p-4">
                    <div class="row g-2 mb-3">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">Tên cụm sân <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="ten" required placeholder="Ví dụ: Cung Thể Thao Tiên Sơn">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Mã cụm sân</label>
                            <input type="text" class="form-control" id="ma" placeholder="CS-01">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Địa chỉ cụ thể</label>
                        <input type="text" class="form-control" id="diaChi" placeholder="Ví dụ: Đường Phan Đăng Lưu, Hải Châu, Đà Nẵng">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mô tả / Ghi chú</label>
                        <textarea class="form-control" id="moTa" rows="2" placeholder="Ghi chú về quy mô, số lượng sân..."></textarea>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="trangThai" checked>
                        <label class="form-check-label fw-semibold" for="trangThai">Hoạt động</label>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary" id="btnSave">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Lưu thông tin
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentPage = 1;
        const pageSize = 10;

        $(document).ready(function () {
            loadData(1);

            $('#keyword').on('keypress', function (e) {
                if (e.which === 13) loadData(1);
            });

            $('#trangThaiFilter').on('change', function () {
                loadData(1);
            });

            $('#formCumSan').on('submit', function (e) {
                e.preventDefault();
                saveData();
            });
        });

        function loadData(page) {
            currentPage = page;
            const keyword = $('#keyword').val().trim();
            const trangThai = $('#trangThaiFilter').val();

            $.ajax({
                url: '/Admin/CumSan/GetPagedData',
                type: 'GET',
                data: {
                    pageIndex: page,
                    pageSize: pageSize,
                    keyword: keyword || undefined,
                    trangThai: trangThai !== '' ? (trangThai === 'true') : undefined
                },
                success: function (res) {
                    if (res.success && res.data) {
                        renderTable(res.data);
                    }
                }
            });
        }

        function renderTable(data) {
            const items = data.items || [];
            if (items.length === 0) {
                $('#tblBody').html('<tr><td colspan="7" class="text-center py-5 text-muted">Chưa có cụm sân nào.</td></tr>');
                $('#paginationInfo').text('Hiển thị 0 trên 0 cụm sân');
                $('#paginationList').empty();
                return;
            }

            let html = '';
            const start = (data.pageIndex - 1) * data.pageSize;

            $.each(items, function (i, item) {
                const stt = start + i + 1;
                html += `
                    <tr>
                        <td class="ps-3 fw-bold text-muted">${stt}</td>
                        <td>
                            <div class="fw-bold text-dark">${escapeHtml(item.ten)}</div>
                            <small class="text-muted"><span class="badge bg-light text-secondary border">Mã: ${escapeHtml(item.ma)}</span></small>
                        </td>
                        <td>${item.diaChi ? `<i class="fa-solid fa-location-dot me-1 text-danger"></i>${escapeHtml(item.diaChi)}` : '<span class="text-muted">-</span>'}</td>
                        <td><span class="badge bg-info-subtle text-info border"><i class="fa-solid fa-futbol me-1"></i>${item.soSanHienCo || 0} sân</span></td>
                        <td><small class="text-muted">${escapeHtml(item.moTa || '-')}</small></td>
                        <td>
                            <span class="badge ${item.trangThai ? 'bg-success' : 'bg-danger'} badge-status">
                                ${item.trangThai ? 'Hoạt động' : 'Tạm dừng'}
                            </span>
                        </td>
                        <td class="text-end pe-3">
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-light border" title="Sửa" onclick="openEditModal(${item.id})">
                                    <i class="fa-solid fa-pen-to-square text-success"></i>
                                </button>
                                <button type="button" class="btn btn-light border" title="Xóa" onclick="deleteItem(${item.id}, '${escapeHtml(item.ten)}')">
                                    <i class="fa-solid fa-trash text-danger"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            });

            $('#tblBody').html(html);

            const total = data.totalCount || 0;
            const from = total === 0 ? 0 : start + 1;
            const to = Math.min(start + data.pageSize, total);
            $('#paginationInfo').text(`Hiển thị ${from} - ${to} trên tổng số ${total} cụm sân`);

            renderPagination(data.pageIndex, data.totalPages);
        }

        function renderPagination(current, totalPages) {
            if (totalPages <= 1) {
                $('#paginationList').empty();
                return;
            }

            let pagHtml = '';
            pagHtml += `<li class="page-item ${current === 1 ? 'disabled' : ''}">
                <a class="page-link" href="javascript:void(0)" onclick="loadData(${current - 1})">&laquo;</a>
            </li>`;

            for (let i = 1; i <= totalPages; i++) {
                if (i === 1 || i === totalPages || (i >= current - 2 && i <= current + 2)) {
                    pagHtml += `<li class="page-item ${i === current ? 'active' : ''}">
                        <a class="page-link" href="javascript:void(0)" onclick="loadData(${i})">${i}</a>
                    </li>`;
                }
            }

            pagHtml += `<li class="page-item ${current === totalPages ? 'disabled' : ''}">
                <a class="page-link" href="javascript:void(0)" onclick="loadData(${current + 1})">&raquo;</a>
            </li>`;

            $('#paginationList').html(pagHtml);
        }

        function openCreateModal() {
            $('#modalTitle').text('Thêm Cụm Sân Mới');
            $('#cumSanId').val('');
            $('#ten').val('');
            $('#ma').val('');
            $('#diaChi').val('');
            $('#moTa').val('');
            $('#trangThai').prop('checked', true);
            $('#modalCumSan').modal('show');
        }

        function openEditModal(id) {
            $.get('/Admin/CumSan/GetById', { id: id }, function (res) {
                if (res.success && res.data) {
                    const item = res.data;
                    $('#modalTitle').text('Chỉnh Sửa Cụm Sân');
                    $('#cumSanId').val(item.id);
                    $('#ten').val(item.ten);
                    $('#ma').val(item.ma || '');
                    $('#diaChi').val(item.diaChi || '');
                    $('#moTa').val(item.moTa || '');
                    $('#trangThai').prop('checked', item.trangThai);
                    $('#modalCumSan').modal('show');
                }
            });
        }

        function saveData() {
            const id = $('#cumSanId').val();
            const ten = $('#ten').val().trim();
            if (!ten) {
                Swal.fire('Lỗi', 'Vui lòng nhập tên cụm sân.', 'warning');
                return;
            }

            const payload = {
                ten: ten,
                ma: $('#ma').val().trim() || null,
                diaChi: $('#diaChi').val().trim() || null,
                moTa: $('#moTa').val().trim() || null,
                trangThai: $('#trangThai').is(':checked')
            };

            const url = id ? `/Admin/CumSan/Save?id=${id}` : '/Admin/CumSan/Save';

            $.ajax({
                url: url,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    if (res.success) {
                        $('#modalCumSan').modal('hide');
                        SportApp.toast('success', res.message || 'Lưu thành công!');
                        loadData(currentPage);
                    } else {
                        Swal.fire('Lỗi', res.message || 'Không thể lưu cụm sân.', 'error');
                    }
                }
            });
        }

        function deleteItem(id, name) {
            SportApp.confirm('Xóa Cụm Sân?', `Bạn có chắc muốn xóa cụm sân "${name}" không?`, function () {
                $.post('/Admin/CumSan/Delete', { id: id }, function (res) {
                    if (res.success) {
                        SportApp.toast('success', res.message || 'Đã xóa cụm sân!');
                        loadData(currentPage);
                    } else {
                        Swal.fire('Lỗi', res.message || 'Không thể xóa.', 'error');
                    }
                });
            });
        }

        function resetFilter() {
            $('#keyword').val('');
            $('#trangThaiFilter').val('');
            loadData(1);
        }

        function escapeHtml(text) {
            if (!text) return '';
            return $('<div>').text(text).html();
        }
    </script>
}
