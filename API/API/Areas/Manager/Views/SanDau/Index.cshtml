@{
    ViewData["Title"] = "Sân Thi Đấu";
    Layout = "~/Areas/Manager/Views/Shared/_ManagerLayout.cshtml";
}

<div class="container-fluid p-0">
    <div class="card card-custom border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 pb-3 mb-4 border-bottom">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 bg-primary-subtle text-primary rounded-4"><i class="fa-solid fa-futbol fs-4"></i></div>
                    <div>
                        <h4 class="fw-bold mb-1 text-dark">Sân Thi Đấu</h4>
                        <p class="text-muted small mb-0">Danh sách chỉ xem. Việc thêm, sửa và xóa do Đơn vị sở hữu thực hiện.</p>
                    </div>
                </div>
                <a href="/Manager/CumSan" class="btn btn-outline-secondary rounded-3 px-3"><i class="fa-solid fa-arrow-left me-1"></i> Về Cụm Sân</a>
            </div>

            <div class="p-3 bg-light rounded-3 mb-4 border">
                <div class="row g-2 align-items-center">
                    <div class="col-md-3"><input type="text" id="keyword" class="form-control bg-white border rounded-3" placeholder="Tìm theo tên, mã sân..."></div>
                    <div class="col-md-3"><select id="cumSanFilter" class="form-select bg-white border rounded-3"><option value="">-- Tất cả cụm sân --</option></select></div>
                    <div class="col-md-2"><select id="monTheThaoFilter" class="form-select bg-white border rounded-3"><option value="">-- Tất cả môn --</option></select></div>
                    <div class="col-md-2"><select id="trangThaiFilter" class="form-select bg-white border rounded-3"><option value="">-- Trạng thái --</option><option value="true">Đang hoạt động</option><option value="false">Tạm dừng</option></select></div>
                    <div class="col-md-2 d-flex gap-1"><button type="button" class="btn btn-dark flex-grow-1 rounded-3" onclick="loadData(1)"><i class="fa-solid fa-filter"></i></button><button type="button" class="btn btn-outline-secondary rounded-3" onclick="resetFilter()"><i class="fa-solid fa-arrows-rotate"></i></button></div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase fs-7 text-muted">
                        <tr>
                            <th class="ps-3" style="width:50px">STT</th>
                            <th>Tên Sân</th>
                            <th>Mã Sân</th>
                            <th>Đơn vị sở hữu</th>
                            <th>Thuộc Cụm Sân</th>
                            <th>Môn chuyên dụng</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody id="tblBody"><tr><td colspan="7" class="text-center py-5 text-muted">Đang tải...</td></tr></tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-center py-3 mt-3 border-top">
                <div class="text-muted small" id="paginationInfo">Hiển thị 0 trên 0 sân đấu</div>
                <ul class="pagination pagination-sm mb-0" id="paginationList"></ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let currentPage = 1;
    const pageSize = 10;

    $(function () {
        const queryCumSanId = new URLSearchParams(window.location.search).get('cumSanId');
        $.get('/Manager/SanDau/GetLookupData', function (res) {
            if (!res.success || !res.data) return;
            (res.data.cumSans || []).forEach(item => $('#cumSanFilter').append(`<option value="${item.id}">${escapeHtml(item.ten)}</option>`));
            (res.data.monTheThaos || []).forEach(item => $('#monTheThaoFilter').append(`<option value="${item.id}">${escapeHtml(item.ten)}</option>`));
            if (queryCumSanId) $('#cumSanFilter').val(queryCumSanId);
            loadData(1);
        });
        $('#keyword').on('keypress', e => { if (e.which === 13) loadData(1); });
        $('#cumSanFilter, #monTheThaoFilter, #trangThaiFilter').on('change', () => loadData(1));
    });

    function loadData(page) {
        currentPage = page;
        $.get('/Manager/SanDau/GetPagedData', {
            pageIndex: page,
            pageSize: pageSize,
            keyword: $('#keyword').val().trim() || undefined,
            cumSanId: $('#cumSanFilter').val() || undefined,
            monTheThaoId: $('#monTheThaoFilter').val() || undefined,
            trangThai: $('#trangThaiFilter').val() === '' ? undefined : $('#trangThaiFilter').val() === 'true'
        }, function (res) { if (res.success && res.data) renderTable(res.data); });
    }

    function renderTable(data) {
        const items = data.items || [];
        if (!items.length) {
            $('#tblBody').html('<tr><td colspan="7" class="text-center py-5 text-muted">Chưa có sân đấu nào.</td></tr>');
            $('#paginationInfo').text('Hiển thị 0 trên 0 sân đấu'); $('#paginationList').empty(); return;
        }
        const start = (data.pageIndex - 1) * data.pageSize;
        $('#tblBody').html(items.map((item, index) => `
            <tr>
                <td class="ps-3 fw-bold text-muted">${start + index + 1}</td>
                <td><div class="fw-bold text-dark">${escapeHtml(item.ten)}</div><small class="text-muted">${escapeHtml(item.loaiSan || '-')}</small></td>
                <td><span class="badge bg-light text-secondary border font-monospace">${escapeHtml(item.ma)}</span></td>
                <td><span class="badge bg-primary-subtle text-primary border">${escapeHtml(item.tenDonVi || 'Chưa gán')}</span></td>
                <td><span class="badge bg-info-subtle text-info border"><i class="fa-solid fa-map-location-dot me-1"></i>${escapeHtml(item.tenCumSan || '-')}</span></td>
                <td><span class="badge bg-primary-subtle text-primary border">${escapeHtml(item.tenMonTheThao || 'Đa năng')}</span></td>
                <td><span class="badge ${item.trangThai ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-danger-subtle text-danger border border-danger-subtle'} rounded-pill">${item.trangThai ? 'Hoạt động' : 'Tạm dừng'}</span></td>
            </tr>`).join(''));
        const total = data.totalCount || 0;
        $('#paginationInfo').text(`Hiển thị ${start + 1} - ${Math.min(start + data.pageSize, total)} trên tổng số ${total} sân đấu`);
        renderPagination(data.pageIndex, data.totalPages);
    }

    function renderPagination(current, totalPages) {
        if (totalPages <= 1) { $('#paginationList').empty(); return; }
        let html = `<li class="page-item ${current === 1 ? 'disabled' : ''}"><a class="page-link" href="javascript:void(0)" onclick="loadData(${current - 1})">&laquo;</a></li>`;
        for (let i = 1; i <= totalPages; i++) if (i === 1 || i === totalPages || (i >= current - 2 && i <= current + 2)) html += `<li class="page-item ${i === current ? 'active' : ''}"><a class="page-link" href="javascript:void(0)" onclick="loadData(${i})">${i}</a></li>`;
        html += `<li class="page-item ${current === totalPages ? 'disabled' : ''}"><a class="page-link" href="javascript:void(0)" onclick="loadData(${current + 1})">&raquo;</a></li>`;
        $('#paginationList').html(html);
    }

    function resetFilter() { $('#keyword').val(''); $('#cumSanFilter').val(''); $('#monTheThaoFilter').val(''); $('#trangThaiFilter').val(''); loadData(1); }
    function escapeHtml(value) { return $('<div>').text(value || '').html(); }
</script>
}
