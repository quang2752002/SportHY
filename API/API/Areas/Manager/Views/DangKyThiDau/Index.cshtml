@{
    ViewData["Title"] = "Hồ Sơ Đăng Ký Thi Đấu";
    var giaiDaus = ViewBag.GiaiDaus as IEnumerable<GiaiDauDto> ?? Enumerable.Empty<GiaiDauDto>();
    var monTheThaos = ViewBag.MonTheThaos as IEnumerable<MonTheThaoDto> ?? Enumerable.Empty<MonTheThaoDto>();
    var donVis = ViewBag.DonVis as IEnumerable<DonViDto> ?? Enumerable.Empty<DonViDto>();
    var selectedGiaiDauId = ViewBag.SelectedGiaiDauId as int?;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1 text-dark">
            <i class="fa-solid fa-users text-success me-2"></i>Quản Lý Hồ Sơ Đăng Ký Thi Đấu
        </h4>
        <p class="text-muted small mb-0">Hồ sơ từ các đoàn/đơn vị khi nộp lên được tự động phê duyệt và tiếp nhận trực tiếp vào giải đấu.</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary" onclick="loadData(1)">
            <i class="fa-solid fa-arrows-rotate me-1"></i> Làm mới danh sách
        </button>
    </div>
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="card card-custom mb-4">
    <div class="card-body p-3">
        <div class="row g-2 align-items-center">
            <div class="col-md-4">
                <input type="text" id="keyword" class="form-control" placeholder="Tìm theo tên đội, mã đăng ký...">
            </div>
            <div class="col-md-3">
                <select id="giaiDauFilter" class="form-select">
                    <option value="">-- Tất cả giải đấu --</option>
                    @foreach (var g in giaiDaus)
                    {
                        if (selectedGiaiDauId.HasValue && selectedGiaiDauId.Value == g.Id)
                        {
                            <option value="@g.Id" selected>@g.Ten</option>
                        }
                        else
                        {
                            <option value="@g.Id">@g.Ten</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select id="donViFilter" class="form-select">
                    <option value="">-- Tất cả đơn vị / đoàn --</option>
                    @foreach (var dv in donVis)
                    {
                        <option value="@dv.Id">@dv.Ten</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="button" class="btn btn-primary flex-grow-1" onclick="loadData(1)">
                    <i class="fa-solid fa-filter me-1"></i> Lọc
                </button>
                <button type="button" class="btn btn-outline-secondary" onclick="resetFilter()" title="Làm mới">
                    <i class="fa-solid fa-arrows-rotate"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Bảng dữ liệu Đăng Ký -->
<div class="card card-custom">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="tblDangKy">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3" style="width: 50px;">STT</th>
                        <th>Thông Tin Đăng Ký</th>
                        <th>Đơn Vị / Đoàn</th>
                        <th>Môn / Giải Đấu</th>
                        <th>Ngày Đăng Ký</th>
                        <th>Trạng Thái</th>
                        <th class="text-end pe-3" style="width: 160px;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody id="tblBody">
                    <tr><td colspan="7" class="text-center py-5 text-muted">Đang tải danh sách hồ sơ...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center py-3">
        <div class="text-muted small" id="paginationInfo">Hiển thị 0 trên 0 hồ sơ</div>
        <ul class="pagination pagination-sm mb-0" id="paginationList"></ul>
    </div>
</div>

<!-- Modal Xem Chi Tiết Hồ Sơ Đăng Ký & Danh Sách VĐV -->
<div class="modal fade" id="modalDetails" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold">
                    <i class="fa-solid fa-id-card me-2"></i>Chi Tiết Hồ Sơ Đăng Ký Thi Đấu
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="modalDetailsBody">
                <div class="text-center py-4 text-muted">Đang tải thông tin...</div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentPage = 1;
        const pageSize = 10;

        $(document).ready(function () {
            loadData(1);

            $('#keyword').on('keypress', function (e) {
                if (e.which === 13) loadData(1);
            });

            $('#giaiDauFilter, #donViFilter').on('change', function () {
                loadData(1);
            });
        });

        function loadData(page) {
            currentPage = page;
            const keyword = $('#keyword').val().trim();
            const giaiDauId = $('#giaiDauFilter').val();
            const donViId = $('#donViFilter').val();

            $.ajax({
                url: '/Manager/DangKyThiDau/GetPagedData',
                type: 'GET',
                data: {
                    pageIndex: page,
                    pageSize: pageSize,
                    keyword: keyword || undefined,
                    giaiDauId: giaiDauId ? parseInt(giaiDauId) : undefined,
                    donViId: donViId ? parseInt(donViId) : undefined
                },
                success: function (res) {
                    if (res.success && res.data) {
                        renderTable(res.data);
                    }
                }
            });
        }

        function renderTable(data) {
            const items = data.items || [];
            if (items.length === 0) {
                $('#tblBody').html('<tr><td colspan="7" class="text-center py-5 text-muted">Không có hồ sơ đăng ký nào.</td></tr>');
                $('#paginationInfo').text('Hiển thị 0 trên 0 hồ sơ');
                $('#paginationList').empty();
                return;
            }

            let html = '';
            const start = (data.pageIndex - 1) * data.pageSize;

            $.each(items, function (i, item) {
                const stt = start + i + 1;
                const statusBadge = '<span class="badge bg-success-subtle text-success border"><i class="fa-solid fa-circle-check me-1"></i>Đã duyệt</span>';
                const regDate = formatDate(item.ngayDangKy);

                const actionButtons = `
                    <div class="btn-group btn-group-sm">
                        <button type="button" class="btn btn-outline-primary" title="Xem Chi Tiết & Danh Sách VĐV" onclick="openDetailsModal(${item.id})">
                            <i class="fa-solid fa-eye me-1"></i> Chi tiết
                        </button>
                        <button type="button" class="btn btn-light border" title="Xóa hồ sơ" onclick="deleteItem(${item.id}, '${escapeHtml(item.tenDangKy)}')">
                            <i class="fa-solid fa-trash text-danger"></i>
                        </button>
                    </div>
                `;

                html += `
                    <tr>
                        <td class="ps-3 fw-bold text-muted">${stt}</td>
                        <td>
                            <div class="fw-bold text-dark">${escapeHtml(item.tenDangKy || 'Hồ sơ')}</div>
                            <small class="text-muted"><span class="badge bg-light text-secondary border">Mã: ${escapeHtml(item.soDangKy || '-')}</span></small>
                        </td>
                        <td>
                            <span class="fw-semibold text-dark"><i class="fa-solid fa-building me-1 text-secondary"></i>${escapeHtml(item.tenDonVi || 'Vãng lai')}</span>
                        </td>
                        <td>
                            <div class="text-primary fw-semibold"><i class="fa-solid fa-volleyball me-1"></i>${escapeHtml(item.tenMonTheThao || 'Môn thi đấu')}</div>
                            <small class="text-muted">${escapeHtml(item.tenGiaiDau || '')}</small>
                        </td>
                        <td><small class="text-muted">${regDate}</small></td>
                        <td>${statusBadge}</td>
                        <td class="text-end pe-3">${actionButtons}</td>
                    </tr>
                `;
            });

            $('#tblBody').html(html);

            const total = data.totalCount || 0;
            const from = total === 0 ? 0 : start + 1;
            const to = Math.min(start + data.pageSize, total);
            $('#paginationInfo').text(`Hiển thị ${from} - ${to} trên tổng số ${total} hồ sơ`);

            renderPagination(data.pageIndex, data.totalPages);
        }

        function renderPagination(current, totalPages) {
            if (totalPages <= 1) {
                $('#paginationList').empty();
                return;
            }

            let pagHtml = '';
            pagHtml += `<li class="page-item ${current === 1 ? 'disabled' : ''}">
                <a class="page-link" href="javascript:void(0)" onclick="loadData(${current - 1})">&laquo;</a>
            </li>`;

            for (let i = 1; i <= totalPages; i++) {
                if (i === 1 || i === totalPages || (i >= current - 2 && i <= current + 2)) {
                    pagHtml += `<li class="page-item ${i === current ? 'active' : ''}">
                        <a class="page-link" href="javascript:void(0)" onclick="loadData(${i})">${i}</a>
                    </li>`;
                }
            }

            pagHtml += `<li class="page-item ${current === totalPages ? 'disabled' : ''}">
                <a class="page-link" href="javascript:void(0)" onclick="loadData(${current + 1})">&raquo;</a>
            </li>`;

            $('#paginationList').html(pagHtml);
        }

        function openDetailsModal(id) {
            $('#modalDetails').modal('show');
            $('#modalDetailsBody').html('<div class="text-center py-4 text-muted"><div class="spinner-border text-primary spinner-border-sm me-2"></div>Đang tải chi tiết hồ sơ...</div>');

            $.get('/Manager/DangKyThiDau/GetById', { id: id }, function (res) {
                if (res.success && res.data) {
                    const item = res.data;
                    const vdvs = item.chiTietDangKyThiDaus || [];

                    let vdvHtml = '';
                    if (vdvs.length === 0) {
                        vdvHtml = '<div class="text-center py-3 text-muted">Chưa gắn danh sách vận động viên cụ thể.</div>';
                    } else {
                        vdvHtml = `
                            <div class="table-responsive mt-3">
                                <table class="table table-sm table-bordered align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>STT</th>
                                            <th>Họ và Tên VĐV</th>
                                            <th>Mã VĐV</th>
                                            <th>Số Áo</th>
                                            <th>Vị Trí / Vai Trò</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                        `;
                        $.each(vdvs, function (idx, v) {
                            vdvHtml += `
                                <tr>
                                    <td>${idx + 1}</td>
                                    <td class="fw-bold">${escapeHtml(v.tenVanDongVien || v.hoTen || '-')}</td>
                                    <td><small class="badge bg-light text-secondary border">${escapeHtml(v.maVanDongVien || '-')}</small></td>
                                    <td>${v.soAo ? `<span class="badge bg-primary">${v.soAo}</span>` : '-'}</td>
                                    <td>${v.laDoiTruong ? '<span class="badge bg-warning text-dark"><i class="fa-solid fa-star me-1"></i>Đội trưởng</span>' : (v.viTri || 'VĐV')}</td>
                                </tr>
                            `;
                        });
                        vdvHtml += `</tbody></table></div>`;
                    }

                    const bodyHtml = `
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="text-muted small">Tên hồ sơ / Đội:</label>
                                <div class="fw-bold fs-6">${escapeHtml(item.tenDangKy)}</div>
                            </div>
                            <div class="col-md-3">
                                <label class="text-muted small">Mã số đăng ký:</label>
                                <div><span class="badge bg-light text-secondary border">${escapeHtml(item.soDangKy)}</span></div>
                            </div>
                            <div class="col-md-3">
                                <label class="text-muted small">Trạng thái:</label>
                                <div><span class="badge bg-success-subtle text-success border"><i class="fa-solid fa-circle-check me-1"></i>Đã duyệt</span></div>
                            </div>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="text-muted small">Giải đấu:</label>
                                <div class="fw-semibold text-primary">${escapeHtml(item.tenGiaiDau || '-')}</div>
                            </div>
                            <div class="col-md-6">
                                <label class="text-muted small">Môn thi đấu:</label>
                                <div class="fw-semibold text-dark">${escapeHtml(item.tenMonTheThao || '-')}</div>
                            </div>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="text-muted small">Đơn vị / Đoàn:</label>
                                <div class="fw-semibold text-dark">${escapeHtml(item.tenDonVi || 'Vãng lai')}</div>
                            </div>
                            <div class="col-md-6">
                                <label class="text-muted small">Ngày đăng ký:</label>
                                <div class="text-muted">${formatDate(item.ngayDangKy, true)}</div>
                            </div>
                        </div>
                        ${item.ghiChu ? `<div class="alert alert-info py-2 small mb-3"><strong>Ghi chú:</strong> ${escapeHtml(item.ghiChu)}</div>` : ''}
                        
                        <h6 class="fw-bold mt-4 mb-2 text-dark">
                            <i class="fa-solid fa-user-group text-primary me-2"></i>Danh Sách Vận Động Viên (${vdvs.length} thành viên)
                        </h6>
                        ${vdvHtml}
                    `;
                    $('#modalDetailsBody').html(bodyHtml);
                }
            });
        }

        function deleteItem(id, name) {
            SportApp.confirm('Xác nhận xóa hồ sơ?', `Bạn có chắc muốn xóa hồ sơ đăng ký "${name}" này không?`, function () {
                $.post('/Manager/DangKyThiDau/Delete', { id: id }, function (res) {
                    if (res.success) {
                        SportApp.toast('success', res.message || 'Đã xóa hồ sơ thành công!');
                        loadData(currentPage);
                    } else {
                        Swal.fire('Lỗi', res.message || 'Không thể xóa hồ sơ này.', 'error');
                    }
                });
            });
        }

        function resetFilter() {
            $('#keyword').val('');
            $('#giaiDauFilter').val('');
            $('#donViFilter').val('');
            loadData(1);
        }

        function formatDate(str, withTime = false) {
            if (!str) return '-';
            const d = new Date(str);
            if (isNaN(d.getTime())) return str;
            const day = String(d.getDate()).padStart(2, '0');
            const month = String(d.getMonth() + 1).padStart(2, '0');
            const year = d.getFullYear();
            if (withTime) {
                const h = String(d.getHours()).padStart(2, '0');
                const m = String(d.getMinutes()).padStart(2, '0');
                return `${day}/${month}/${year} ${h}:${m}`;
            }
            return `${day}/${month}/${year}`;
        }

        function escapeHtml(text) {
            if (!text) return '';
            return $('<div>').text(text).html();
        }
    </script>
}
