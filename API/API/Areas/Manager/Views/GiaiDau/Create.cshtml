@{
    ViewData["Title"] = "Thêm Mới Giải Đấu";
    var khois = ViewBag.Khois as IEnumerable<KhoiDto> ?? Enumerable.Empty<KhoiDto>();
    var monTheThaos = ViewBag.MonTheThaos as IEnumerable<MonTheThaoDto> ?? Enumerable.Empty<MonTheThaoDto>();
    var trongTais = ViewBag.TrongTais as IEnumerable<TrongTaiDto> ?? Enumerable.Empty<TrongTaiDto>();
    var sportCoordinatorUsers = ViewBag.SportCoordinatorUsers as List<SportCoordinatorUserOptionDto> ?? new();
    var secretaryAssignments = ViewBag.SecretaryAssignments as List<ThuKyPhanCongDto> ?? new();
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1 text-dark">
            <i class="fa-solid fa-trophy text-warning me-2"></i>Thêm Mới Giải Đấu Thể Thao
        </h4>
        <p class="text-muted small mb-0">Thiết lập thông tin giải đấu, phân bổ các bộ môn thi đấu và điều lệ tham gia.</p>
    </div>
    <div>
        <a href="/Manager/GiaiDau" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>
</div>

<form id="formGiaiDau" novalidate>
    <div class="row g-4">
        <!-- Cột trái: Thông tin chính & Môn thi đấu -->
        <div class="col-lg-8">
            <!-- 1. Thông tin cơ bản -->
            <div class="card card-custom mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="fa-solid fa-circle-info text-primary me-2"></i>1. Thông Tin Cơ Bản Giải Đấu
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">Tên giải đấu <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="ten" required placeholder="Ví dụ: Đại Hội Thể Thao Sinh Viên TP.HCM 2026">
                            <div class="invalid-feedback">Vui lòng nhập tên giải đấu.</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Mã giải đấu <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="ma" required placeholder="DH_TTH_2026">
                            <div class="invalid-feedback">Vui lòng nhập mã giải đấu.</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Địa điểm tổ chức</label>
                            <input type="text" class="form-control" id="diaDiem" placeholder="Ví dụ: Cung Thể Thao Phú Thọ, TP.HCM">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Đường dẫn thân thiện (Slug)</label>
                            <input type="text" class="form-control" id="slug" placeholder="dai-hoi-the-thao-sinh-vien-2026">
                            <small class="text-muted">Để trống hệ thống sẽ tự sinh tự động từ tên giải.</small>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Ngày bắt đầu <span class="text-danger">*</span></label>
                            <div class="input-group has-validation position-relative">
                                <input type="text" class="form-control date-dmy-input bg-white" id="ngayBatDau" placeholder="dd/mm/yyyy" maxlength="10" required autocomplete="off">
                                <span class="input-group-text bg-white cursor-pointer" onclick="openDatePicker('ngayBatDau')" title="Mở lịch chọn ngày">
                                    <i class="fa-solid fa-calendar-days text-primary"></i>
                                </span>
                                <input type="date" class="date-native-picker" id="ngayBatDau_picker" tabindex="-1" aria-hidden="true" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; pointer-events: none; z-index: -1;">
                                <div class="invalid-feedback">Vui lòng chọn ngày bắt đầu giải đấu.</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Ngày kết thúc <span class="text-danger">*</span></label>
                            <div class="input-group has-validation position-relative">
                                <input type="text" class="form-control date-dmy-input bg-white" id="ngayKetThuc" placeholder="dd/mm/yyyy" maxlength="10" required autocomplete="off">
                                <span class="input-group-text bg-white cursor-pointer" onclick="openDatePicker('ngayKetThuc')" title="Mở lịch chọn ngày">
                                    <i class="fa-solid fa-calendar-days text-primary"></i>
                                </span>
                                <input type="date" class="date-native-picker" id="ngayKetThuc_picker" tabindex="-1" aria-hidden="true" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; pointer-events: none; z-index: -1;">
                                <div class="invalid-feedback">Vui lòng chọn ngày kết thúc giải đấu.</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Hạn nộp hồ sơ đăng ký <span class="text-danger">*</span></label>
                            <div class="input-group has-validation position-relative">
                                <input type="text" class="form-control date-dmy-input bg-white" id="hanDangKy" placeholder="dd/mm/yyyy" maxlength="10" required autocomplete="off">
                                <span class="input-group-text bg-white cursor-pointer" onclick="openDatePicker('hanDangKy')" title="Mở lịch chọn ngày">
                                    <i class="fa-solid fa-calendar-days text-primary"></i>
                                </span>
                                <input type="date" class="date-native-picker" id="hanDangKy_picker" tabindex="-1" aria-hidden="true" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; pointer-events: none; z-index: -1;">
                                <div class="invalid-feedback">Vui lòng chọn hạn nộp hồ sơ đăng ký.</div>
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Mô tả tóm tắt giải đấu</label>
                            <textarea class="form-control" id="moTa" rows="3" placeholder="Giới thiệu mục đích, ý nghĩa, quy mô và đối tượng tham gia..."></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. Chọn Môn thi đấu tổ chức trong giải -->
            <div class="card card-custom mb-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="fw-bold text-dark mb-0">
                            <i class="fa-solid fa-volleyball text-success me-2"></i>2. Môn Thi Đấu Tổ Chức Trong Giải
                        </h6>
                        <small class="text-muted">Tích chọn các môn thi đấu nằm trong khuôn khổ giải đấu này</small>
                    </div>
                    <div class="btn-group btn-group-sm">
                        <button type="button" class="btn btn-outline-primary" id="btnSelectAllMon">Chọn tất cả</button>
                        <button type="button" class="btn btn-outline-secondary" id="btnDeselectAllMon">Bỏ chọn</button>
                    </div>
                </div>
                <div class="card-body">
                    @if (!monTheThaos.Any())
                    {
                        <div class="text-center py-4 text-muted">
                            Chưa có danh mục môn thể thao nào trên hệ thống.
                        </div>
                    }
                    else
                    {
                        <div class="row g-2" id="listMonTheThao">
                            @foreach (var mon in monTheThaos)
                            {
                                <div class="col-md-4 col-sm-6">
                                    <div class="form-check p-2 border rounded hover-shadow h-100 d-flex align-items-center bg-white">
                                        <input class="form-check-input chk-mon me-2 ms-1" type="checkbox" value="@mon.Id" id="mon_@mon.Id">
                                        <label class="form-check-label fw-semibold text-dark small w-100 cursor-pointer" for="mon_@mon.Id">
                                            <div>@mon.Ten</div>
                                            <div class="mt-1">
                                                @if (mon.LaMonDongDoi)
                                                {
                                                    <span class="badge bg-info-subtle text-info border" style="font-size: 0.68rem;">Đồng đội</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary border" style="font-size: 0.68rem;">Cá nhân</span>
                                                }
                                                @if (!string.IsNullOrEmpty(mon.TenDanhMuc))
                                                {
                                                    <span class="text-muted" style="font-size: 0.68rem;">• @mon.TenDanhMuc</span>
                                                }
                                            </div>
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- 3. Điều lệ giải đấu -->
            <div class="card card-custom mb-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="fa-solid fa-file-contract text-warning me-2"></i>3. Điều Lệ Giải Đấu
                    </h6>
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="addDieuLeRow()">
                        <i class="fa-solid fa-plus me-1"></i> Thêm mục điều lệ
                    </button>
                </div>
                <div class="card-body">
                    <div id="dieuLeContainer">
                        <!-- Render các dòng điều lệ bằng JS -->
                    </div>
                </div>
            </div>

            <!-- 4. Phân Công Nhân Sự Điều Hành Giải (Trưởng ban, Điều hành môn & Thư ký) -->
            <div class="card card-custom mb-4 shadow-sm" id="sectionPhanCong">
                <div class="card-header bg-white py-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div class="d-flex align-items-center gap-2.5">
                        <div class="rounded-3 d-flex align-items-center justify-content-center text-white shadow-2xs" style="width: 38px; height: 38px; background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);">
                            <i class="fa-solid fa-users-gear fs-6"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold text-dark mb-0">
                                4. Phân Công Nhân Sự Điều Hành Giải
                            </h6>
                            <small class="text-muted">Chỉ định Trưởng ban trọng tài, phân công Người điều hành môn và Thư ký ngay khi tạo giải</small>
                        </div>
                    </div>
                </div>
                <div class="card-body p-3 p-md-4 d-flex flex-column gap-4">
                    <!-- 4.1. Trưởng ban trọng tài -->
                    <div class="card border rounded-3 overflow-hidden shadow-2xs" style="border-color: #fde68a !important;">
                        <div class="p-3 border-bottom d-flex flex-wrap align-items-center justify-content-between gap-2" style="background-color: #fffbeb; border-color: #fef3c7 !important;">
                            <div class="d-flex align-items-center gap-2.5">
                                <div class="rounded-circle d-flex align-items-center justify-content-center shadow-2xs" style="width: 36px; height: 36px; background-color: #fef3c7; border: 1px solid #fde68a;">
                                    <i class="fa-solid fa-user-shield text-warning"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark" style="font-size: 0.95rem;">
                                        Trưởng Ban Trọng Tài Giải Đấu
                                    </div>
                                    <small class="text-muted" style="font-size: 0.8rem;">Trọng tài được chọn sẽ làm Trưởng ban trọng tài, chịu trách nhiệm xếp lịch, phân công trọng tài và duyệt biên bản.</small>
                                </div>
                            </div>
                        </div>
                        <div class="p-3 bg-white">
                            <label class="form-label small fw-semibold text-secondary mb-1.5">
                                <i class="fa-solid fa-user-check me-1 text-primary"></i>Chọn tài khoản trọng tài làm Trưởng ban (Tùy chọn):
                            </label>
                            <select class="form-select form-select-md shadow-2xs" id="truongBanTrongTaiId" style="border-color: #cbd5e1; font-weight: 500;">
                                <option value="">-- Chưa chỉ định / Phân công sau --</option>
                                @foreach (var tt in trongTais)
                                {
                                    <option value="@tt.Id">@tt.HoTen (@tt.Ma) - @tt.CapBac</option>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- 4.2. Phân công người điều hành theo danh mục môn -->
                    <div class="card border rounded-3 overflow-hidden shadow-2xs" style="border-color: #bbf7d0 !important;">
                        <div class="p-3 border-bottom d-flex flex-wrap align-items-center justify-content-between gap-2" style="background-color: #f0fdf4; border-color: #dcfce7 !important;">
                            <div class="d-flex align-items-center gap-2.5">
                                <div class="rounded-circle d-flex align-items-center justify-content-center shadow-2xs" style="width: 36px; height: 36px; background-color: #dcfce7; border: 1px solid #bbf7d0;">
                                    <i class="fa-solid fa-volleyball text-success"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark" style="font-size: 0.95rem;">
                                        Phân Công Người Điều Hành Môn (Tùy Chọn)
                                    </div>
                                    <small class="text-muted" style="font-size: 0.8rem;">Gán tài khoản Người điều hành môn theo danh mục môn thi đấu</small>
                                </div>
                            </div>
                        </div>
                        <div class="p-3 bg-white">
                            @{
                                var categoriesFromMons = monTheThaos
                                    .Where(m => m.DanhMucId > 0 && !string.IsNullOrEmpty(m.TenDanhMuc))
                                    .GroupBy(m => new { m.DanhMucId, m.TenDanhMuc })
                                    .Select(g => new { DanhMucId = g.Key.DanhMucId, TenDanhMuc = g.Key.TenDanhMuc })
                                    .ToList();
                            }
                            @if (categoriesFromMons.Any())
                            {
                                <div class="table-responsive border rounded-3 overflow-hidden shadow-2xs">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead style="background-color: #f8fafc; border-bottom: 1px solid #e2e8f0;">
                                            <tr class="text-muted small fw-bold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                                                <th class="ps-3 py-2.5">Danh Mục Môn</th>
                                                <th class="py-2.5" style="width: 420px;">Người Điều Hành Phụ Trách</th>
                                            </tr>
                                        </thead>
                                        <tbody style="font-size: 13px;">
                                            @foreach (var cat in categoriesFromMons)
                                            {
                                                <tr>
                                                    <td class="ps-3 py-2.5 fw-bold text-dark">@cat.TenDanhMuc</td>
                                                    <td class="py-2.5">
                                                        <select class="form-select form-select-sm sel-coordinator shadow-2xs" data-danhmuc-id="@cat.DanhMucId" style="border-color: #cbd5e1;">
                                                            <option value="">-- Chưa gán người điều hành --</option>
                                                            @foreach (var coord in sportCoordinatorUsers)
                                                            {
                                                                <option value="@coord.Id">@coord.Ma - @coord.FullName (@coord.UserName)</option>
                                                            }
                                                        </select>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-4 bg-light rounded-3 border border-dashed text-muted">
                                    <i class="fa-solid fa-volleyball fa-2x mb-2 text-secondary opacity-50"></i>
                                    <div class="fw-semibold">Chưa có danh mục môn thể thao nào trên hệ thống</div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- 4.3. Phân công thư ký giải đấu -->
                    <div class="card border rounded-3 overflow-hidden shadow-2xs" style="border-color: #bfdbfe !important;">
                        <div class="p-3 border-bottom d-flex flex-wrap align-items-center justify-content-between gap-2" style="background-color: #eff6ff; border-color: #dbeafe !important;">
                            <div class="d-flex align-items-center gap-2.5">
                                <div class="rounded-circle d-flex align-items-center justify-content-center shadow-2xs" style="width: 36px; height: 36px; background-color: #dbeafe; border: 1px solid #bfdbfe;">
                                    <i class="fa-solid fa-user-pen text-primary"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark" style="font-size: 0.95rem;">
                                        Phân Công Thư Ký Cho Giải Đấu
                                    </div>
                                    <small class="text-muted" style="font-size: 0.8rem;">Tích chọn các thư ký được quyền quản lý và tác nghiệp giải đấu này sau khi đăng nhập</small>
                                </div>
                            </div>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1.5 rounded-pill fw-semibold">
                                <i class="fa-solid fa-users me-1"></i>Đã chọn: <span id="selectedSecretaryCount" class="fw-bold text-primary">0</span> thư ký
                            </span>
                        </div>
                        <div class="p-3 bg-white">
                            @if (!secretaryAssignments.Any())
                            {
                                <div class="text-center py-4 bg-light rounded-3 border border-dashed text-muted">
                                    <i class="fa-solid fa-clipboard-user fa-2x mb-2 text-secondary opacity-50"></i>
                                    <div class="fw-semibold">Chưa có hồ sơ thư ký hoạt động trong hệ thống</div>
                                    <small class="text-muted">Bạn có thể tạo hồ sơ thư ký trong mục Quản lý Thư ký trước khi phân công.</small>
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive border rounded-3 overflow-hidden shadow-2xs mb-2" style="max-height: 280px; overflow-y: auto;">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="sticky-top" style="background-color: #f8fafc; border-bottom: 1px solid #e2e8f0;">
                                            <tr class="text-muted small fw-bold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                                                <th class="text-center ps-2 py-2.5" style="width: 50px;">
                                                    <input type="checkbox" class="form-check-input cursor-pointer" id="chkAllSecretaries" onchange="toggleSelectAllSecretaries(this)" title="Chọn tất cả">
                                                </th>
                                                <th class="py-2.5">Thư Ký</th>
                                                <th class="py-2.5">Chức Vụ / Đơn Vị</th>
                                                <th class="py-2.5">Liên Hệ</th>
                                            </tr>
                                        </thead>
                                        <tbody style="font-size: 13px;">
                                            @foreach (var s in secretaryAssignments)
                                            {
                                                <tr>
                                                    <td class="text-center ps-2 py-2.5">
                                                        <input type="checkbox" class="form-check-input chk-secretary cursor-pointer" value="@s.ThuKyId" onchange="updateSelectedSecretaryCount()">
                                                    </td>
                                                    <td class="py-2.5">
                                                        <div class="fw-bold text-dark">@s.HoTen</div>
                                                        <span class="badge bg-light text-secondary border font-monospace" style="font-size: 0.7rem;">Mã: @s.Ma</span>
                                                    </td>
                                                    <td class="py-2.5">
                                                        <div class="text-dark">@(s.ChucVu ?? "-")</div>
                                                        <small class="text-muted">@(s.DonViCongTac ?? "-")</small>
                                                    </td>
                                                    <td class="py-2.5">
                                                        <div class="text-dark"><i class="fa-solid fa-phone me-1 text-muted" style="font-size: 11px;"></i>@(s.SoDienThoai ?? "-")</div>
                                                        <small class="text-muted"><i class="fa-solid fa-envelope me-1 text-muted" style="font-size: 11px;"></i>@(s.Email ?? "-")</small>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cột phải: Khối tham gia, Cấu hình & Banner -->
        <div class="col-lg-4">
            <!-- Trạng thái & Quy mô -->
            <div class="card card-custom mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="fa-solid fa-sliders text-info me-2"></i>Cấu Hình & Trạng Thái
                    </h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Trạng thái giải</label>
                        <select class="form-select" id="trangThai">
                            <option value="Nhap">Bản nháp</option>
                            <option value="SapDienRa" selected>Sắp diễn ra</option>
                            <option value="DangDienRa">Đang diễn ra</option>
                            <option value="KetThuc">Đã kết thúc</option>
                            <option value="Huy">Đã hủy</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Phạm vi tổ chức</label>
                        <select class="form-select" id="phamVi">
                            <option value="TatCa" selected>Tất cả đơn vị</option>
                            <option value="TheoKhoi">Theo khối ngành / đơn vị</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            <i class="fa-solid fa-users-gear text-primary me-1"></i>Phân công nhân sự
                        </label>
                        <a href="#sectionPhanCong" class="btn btn-sm btn-outline-primary w-100 text-start py-2">
                            <i class="fa-solid fa-arrow-down me-1"></i> Đến mục Phân công (Mục 4)
                        </a>
                        <div class="form-text small text-muted">Trưởng ban, Điều hành môn & Thư ký được thiết lập trực tiếp tại Mục 4 bên dưới.</div>
                    </div>
                </div>
            </div>

            <!-- Khối tham gia -->
            <div class="card card-custom mb-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="fa-solid fa-layer-group text-primary me-2"></i>Khối Tham Gia
                    </h6>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">Chọn các khối đơn vị được phép đăng ký tham dự giải:</p>
                    <div class="d-flex flex-column gap-2" id="listKhoi">
                        @foreach (var khoi in khois)
                        {
                            <div class="form-check p-2 border rounded hover-shadow">
                                <input class="form-check-input chk-khoi me-2 ms-1" type="checkbox" value="@khoi.Id" id="khoi_@khoi.Id">
                                <label class="form-check-label fw-semibold text-dark small cursor-pointer" for="khoi_@khoi.Id">
                                    @khoi.Ten
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Banner / Poster ảnh -->
            <div class="card card-custom mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="fa-solid fa-image text-danger me-2"></i>Hình Ảnh / Poster Giải
                    </h6>
                </div>
                <div class="card-body text-center">
                    <div class="mb-3">
                        <img id="bannerPreview" src="https://placehold.co/600x300?text=Chua+co+poster" 
                             class="img-fluid rounded border shadow-sm w-100" style="max-height: 180px; object-fit: cover;" alt="Banner Preview">
                    </div>
                    <input type="hidden" id="bannerUrl" value="">
                    <input type="file" id="fileBanner" class="d-none" accept="image/*" onchange="uploadBannerFile(this)">
                    <button type="button" class="btn btn-outline-primary w-100" onclick="$('#fileBanner').click()">
                        <i class="fa-solid fa-cloud-arrow-up me-1"></i> Tải ảnh poster lên
                    </button>
                </div>
            </div>

            <!-- Nút Hành Động -->
            <div class="card card-custom border-primary">
                <div class="card-body p-3">
                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold mb-2" id="btnSubmit">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Hoàn Tất & Tạo Giải Đấu
                    </button>
                    <a href="/Manager/GiaiDau" class="btn btn-outline-secondary w-100">
                        Hủy bỏ
                    </a>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        let dieuLeIndex = 0;

        $(document).ready(function () {
            // Tự động tạo slug và mã từ tên giải
            $('#ten').on('input', function () {
                const name = $(this).val();
                if (!$('#slug').val() || $('#slug').data('auto') !== false) {
                    $('#slug').val(generateSlug(name)).data('auto', true);
                }
                if (!$('#ma').val() || $('#ma').data('auto') !== false) {
                    $('#ma').val(generateCode(name)).data('auto', true);
                }
            });

            $('#slug, #ma').on('input', function () {
                $(this).data('auto', false);
            });

            // Highlight visual on check/uncheck
            $('.chk-mon, .chk-khoi').on('change', function () {
                const parent = $(this).closest('.form-check');
                if ($(this).is(':checked')) {
                    parent.addClass('border-primary bg-primary-subtle');
                } else {
                    parent.removeClass('border-primary bg-primary-subtle');
                }
            });

            // Chọn tất cả môn thi đấu
            $('#btnSelectAllMon').on('click', function () {
                $('.chk-mon').prop('checked', true).closest('.form-check').addClass('border-primary bg-primary-subtle');
            });

            $('#btnDeselectAllMon').on('click', function () {
                $('.chk-mon').prop('checked', false).closest('.form-check').removeClass('border-primary bg-primary-subtle');
            });

            // Tự động định dạng ngày trước tháng sau (dd/mm/yyyy) khi gõ
            $('.date-dmy-input').on('input', function () {
                let v = $(this).val().replace(/\D/g, '').slice(0, 8);
                if (v.length >= 5) {
                    $(this).val(`${v.slice(0, 2)}/${v.slice(2, 4)}/${v.slice(4)}`);
                } else if (v.length >= 3) {
                    $(this).val(`${v.slice(0, 2)}/${v.slice(2)}`);
                } else {
                    $(this).val(v);
                }

                if (v.length === 8) {
                    const d = v.slice(0, 2), m = v.slice(2, 4), y = v.slice(4);
                    $(this).closest('.input-group').find('.date-native-picker').val(`${y}-${m}-${d}`);
                }

                if ($('#ngayBatDau.is-invalid, #ngayKetThuc.is-invalid, #hanDangKy.is-invalid').length > 0) {
                    validateDateFields(true);
                }
            });

            // Đồng bộ ngày dd/mm/yyyy khi chọn từ popup lịch
            $('.date-native-picker').on('change', function () {
                const iso = $(this).val();
                if (iso) {
                    const parts = iso.split('-');
                    if (parts.length === 3) {
                        const dmy = `${parts[2]}/${parts[1]}/${parts[0]}`;
                        $(this).closest('.input-group').find('.date-dmy-input').val(dmy);
                    }
                }
                if ($('#ngayBatDau.is-invalid, #ngayKetThuc.is-invalid, #hanDangKy.is-invalid').length > 0) {
                    validateDateFields(true);
                }
            });

            $('#ten, #ma').on('input blur', function () {
                if ($(this).val().trim()) {
                    $(this).removeClass('is-invalid').addClass('is-valid');
                }
            });

            // Thêm 1 dòng điều lệ mặc định
            addDieuLeRow('Điều lệ chung', 'Quy định về đối tượng, điều kiện tham gia và thể thức tính điểm');

            // Xử lý submit form
            $('#formGiaiDau').on('submit', function (e) {
                e.preventDefault();
                saveGiaiDau();
            });
        });

        function addDieuLeRow(title = '', desc = '', fileUrl = '') {
            dieuLeIndex++;
            const rowId = `dieule_${dieuLeIndex}`;
            const html = `
                <div class="border rounded p-3 mb-3 bg-light position-relative" id="${rowId}">
                    <button type="button" class="btn btn-sm btn-outline-danger position-absolute top-0 end-0 m-2" onclick="$('#${rowId}').remove()" title="Xóa mục này">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Tiêu đề điều lệ <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm dl-tieude" required value="${escapeHtml(title)}" placeholder="Ví dụ: Điều lệ thi đấu bóng đá">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Tệp đính kèm (PDF / Word)</label>
                            <div class="input-group input-group-sm">
                                <input type="text" class="form-control dl-file" value="${escapeHtml(fileUrl)}" placeholder="Chưa có tệp" readonly>
                                <input type="file" class="d-none dl-file-input" onchange="uploadDieuLeFile(this, '${rowId}')">
                                <button type="button" class="btn btn-outline-secondary" onclick="$(this).siblings('.dl-file-input').click()">
                                    <i class="fa-solid fa-upload"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Nội dung tóm tắt</label>
                            <textarea class="form-control form-control-sm dl-mota" rows="2" placeholder="Tóm tắt nội dung quy định...">${escapeHtml(desc)}</textarea>
                        </div>
                    </div>
                </div>
            `;
            $('#dieuLeContainer').append(html);
        }

        function uploadBannerFile(input) {
            if (!input.files || !input.files[0]) return;
            const file = input.files[0];
            const formData = new FormData();
            formData.append('file', file);

            SportApp.toast('info', 'Đang tải ảnh banner...');

            $.ajax({
                url: '/Manager/GiaiDau/UploadBanner',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (res) {
                    if (res.success) {
                        $('#bannerUrl').val(res.url);
                        $('#bannerPreview').attr('src', res.url);
                        SportApp.toast('success', 'Tải ảnh banner thành công!');
                    } else {
                        Swal.fire('Lỗi', res.message || 'Không thể tải ảnh.', 'error');
                    }
                }
            });
        }

        function uploadDieuLeFile(input, rowId) {
            if (!input.files || !input.files[0]) return;
            const file = input.files[0];
            const formData = new FormData();
            formData.append('file', file);

            SportApp.toast('info', 'Đang tải tệp điều lệ...');

            $.ajax({
                url: '/Manager/GiaiDau/UploadDieuLe',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (res) {
                    if (res.success) {
                        $(`#${rowId} .dl-file`).val(res.url);
                        SportApp.toast('success', 'Đã đính kèm tệp điều lệ!');
                    } else {
                        Swal.fire('Lỗi', res.message || 'Không thể tải tệp điều lệ.', 'error');
                    }
                }
            });
        }

        function openDatePicker(id) {
            const el = document.getElementById(id + '_picker');
            if (el && typeof el.showPicker === 'function') {
                el.showPicker();
            }
        }

        function setElementValidation($elem, isValid, errorText) {
            const $feedback = $elem.siblings('.invalid-feedback');
            if (isValid) {
                $elem.removeClass('is-invalid').addClass('is-valid');
            } else {
                $elem.removeClass('is-valid').addClass('is-invalid');
                if (errorText) {
                    $feedback.text(errorText);
                }
            }
        }

        function clearElementValidation($elem) {
            $elem.removeClass('is-invalid is-valid');
        }

        function getTodayIsoString() {
            const now = new Date();
            const y = now.getFullYear();
            const m = String(now.getMonth() + 1).padStart(2, '0');
            const d = String(now.getDate()).padStart(2, '0');
            return `${y}-${m}-${d}`;
        }

        function parseDateDmy(str) {
            if (!str || typeof str !== 'string') return null;
            const parts = str.trim().split(/[\/\-\.]/);
            if (parts.length !== 3) return null;
            const d = parseInt(parts[0], 10);
            const m = parseInt(parts[1], 10);
            const y = parseInt(parts[2], 10);
            if (isNaN(d) || isNaN(m) || isNaN(y) || y < 1900 || y > 2100 || m < 1 || m > 12 || d < 1 || d > 31) return null;

            const dateObj = new Date(y, m - 1, d);
            if (dateObj.getFullYear() !== y || (dateObj.getMonth() + 1) !== m || dateObj.getDate() !== d) return null;

            const iso = `${y}-${String(m).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
            return { dateObj, iso };
        }

        function validateDateFields(showFeedback = true) {
            const $nbd = $('#ngayBatDau');
            const $nkt = $('#ngayKetThuc');
            const $hdk = $('#hanDangKy');

            const strNbd = $nbd.val() ? $nbd.val().trim() : '';
            const strNkt = $nkt.val() ? $nkt.val().trim() : '';
            const strHdk = $hdk.val() ? $hdk.val().trim() : '';

            const parsedNbd = parseDateDmy(strNbd);
            const parsedNkt = parseDateDmy(strNkt);
            const parsedHdk = parseDateDmy(strHdk);

            const todayStr = getTodayIsoString();

            let isValid = true;
            let firstErrorElem = null;
            let errorMessage = '';

            if (showFeedback) {
                clearElementValidation($nbd);
                clearElementValidation($nkt);
                clearElementValidation($hdk);
            }

            // 1. Kiểm tra Hạn nộp hồ sơ đăng ký
            if (!strHdk) {
                if (showFeedback) {
                    isValid = false;
                    const msg = 'Vui lòng chọn hạn nộp hồ sơ đăng ký.';
                    if (!errorMessage) errorMessage = msg;
                    setElementValidation($hdk, false, msg);
                    if (!firstErrorElem) firstErrorElem = $hdk;
                }
            } else if (!parsedHdk) {
                if (showFeedback) {
                    isValid = false;
                    const msg = 'Hạn nộp hồ sơ không đúng định dạng (dd/mm/yyyy).';
                    if (!errorMessage) errorMessage = msg;
                    setElementValidation($hdk, false, msg);
                    if (!firstErrorElem) firstErrorElem = $hdk;
                }
            } else if (parsedHdk.iso < todayStr) {
                isValid = false;
                const msg = 'Hạn nộp hồ sơ đăng ký không được trước ngày hiện tại.';
                if (!errorMessage) errorMessage = msg;
                if (showFeedback) {
                    setElementValidation($hdk, false, msg);
                    if (!firstErrorElem) firstErrorElem = $hdk;
                }
            } else {
                if (showFeedback) setElementValidation($hdk, true);
            }

            // 2. Kiểm tra Ngày bắt đầu
            if (!strNbd) {
                if (showFeedback) {
                    isValid = false;
                    const msg = 'Vui lòng chọn ngày bắt đầu giải đấu.';
                    if (!errorMessage) errorMessage = msg;
                    setElementValidation($nbd, false, msg);
                    if (!firstErrorElem) firstErrorElem = $nbd;
                }
            } else if (!parsedNbd) {
                if (showFeedback) {
                    isValid = false;
                    const msg = 'Ngày bắt đầu không đúng định dạng (dd/mm/yyyy).';
                    if (!errorMessage) errorMessage = msg;
                    setElementValidation($nbd, false, msg);
                    if (!firstErrorElem) firstErrorElem = $nbd;
                }
            } else if (parsedNbd.iso <= todayStr) {
                isValid = false;
                const msg = 'Ngày bắt đầu phải lớn hơn ngày hiện tại.';
                if (!errorMessage) errorMessage = msg;
                if (showFeedback) {
                    setElementValidation($nbd, false, msg);
                    if (!firstErrorElem) firstErrorElem = $nbd;
                }
            } else if (parsedHdk && parsedHdk.iso >= parsedNbd.iso) {
                isValid = false;
                const msg = 'Hạn nộp hồ sơ đăng ký phải nhỏ hơn ngày bắt đầu giải đấu.';
                if (!errorMessage) errorMessage = msg;
                if (showFeedback) {
                    setElementValidation($hdk, false, msg);
                    setElementValidation($nbd, false, msg);
                    if (!firstErrorElem) firstErrorElem = $hdk;
                }
            } else {
                if (showFeedback && parsedNbd.iso > todayStr && (!parsedHdk || parsedHdk.iso < parsedNbd.iso)) {
                    setElementValidation($nbd, true);
                }
            }

            // 3. Kiểm tra Ngày kết thúc
            if (!strNkt) {
                if (showFeedback) {
                    isValid = false;
                    const msg = 'Vui lòng chọn ngày kết thúc giải đấu.';
                    if (!errorMessage) errorMessage = msg;
                    setElementValidation($nkt, false, msg);
                    if (!firstErrorElem) firstErrorElem = $nkt;
                }
            } else if (!parsedNkt) {
                if (showFeedback) {
                    isValid = false;
                    const msg = 'Ngày kết thúc không đúng định dạng (dd/mm/yyyy).';
                    if (!errorMessage) errorMessage = msg;
                    setElementValidation($nkt, false, msg);
                    if (!firstErrorElem) firstErrorElem = $nkt;
                }
            } else if (parsedNkt.iso <= todayStr) {
                isValid = false;
                const msg = 'Ngày kết thúc phải lớn hơn ngày hiện tại.';
                if (!errorMessage) errorMessage = msg;
                if (showFeedback) {
                    setElementValidation($nkt, false, msg);
                    if (!firstErrorElem) firstErrorElem = $nkt;
                }
            } else if (parsedNbd && parsedNbd.iso >= parsedNkt.iso) {
                isValid = false;
                const msg = 'Ngày bắt đầu phải nhỏ hơn ngày kết thúc (ngày kết thúc phải sau ngày bắt đầu).';
                if (!errorMessage) errorMessage = msg;
                if (showFeedback) {
                    setElementValidation($nkt, false, msg);
                    setElementValidation($nbd, false, msg);
                    if (!firstErrorElem) firstErrorElem = $nkt;
                }
            } else {
                if (showFeedback && parsedNkt.iso > todayStr && (!parsedNbd || parsedNbd.iso < parsedNkt.iso)) {
                    setElementValidation($nkt, true);
                }
            }

            return { 
                isValid, 
                firstErrorElem, 
                errorMessage,
                isoNbd: parsedNbd ? parsedNbd.iso : null,
                isoNkt: parsedNkt ? parsedNkt.iso : null,
                isoHdk: parsedHdk ? parsedHdk.iso : null
            };
        }

        function saveGiaiDau() {
            const ten = $('#ten').val().trim();
            const ma = $('#ma').val().trim();
            const ngayBatDau = $('#ngayBatDau').val();
            const ngayKetThuc = $('#ngayKetThuc').val();
            const hanDangKy = $('#hanDangKy').val();

            let formValid = true;
            let firstErrorElem = null;

            // Kiểm tra tên & mã giải đấu
            if (!ten) {
                $('#ten').addClass('is-invalid');
                formValid = false;
                if (!firstErrorElem) firstErrorElem = $('#ten');
            } else {
                $('#ten').removeClass('is-invalid').addClass('is-valid');
            }

            if (!ma) {
                $('#ma').addClass('is-invalid');
                formValid = false;
                if (!firstErrorElem) firstErrorElem = $('#ma');
            } else {
                $('#ma').removeClass('is-invalid').addClass('is-valid');
            }

            // Kiểm tra các trường ngày
            const dateCheck = validateDateFields(true);
            if (!dateCheck.isValid) {
                formValid = false;
                if (!firstErrorElem) firstErrorElem = dateCheck.firstErrorElem;
            }

            if (!formValid) {
                if (firstErrorElem) {
                    $('html, body').animate({
                        scrollTop: firstErrorElem.closest('.card').offset().top - 20
                    }, 300);
                    firstErrorElem.focus();
                }
                Swal.fire({
                    icon: 'warning',
                    title: 'Thông tin chưa hợp lệ',
                    text: dateCheck.errorMessage || 'Vui lòng kiểm tra lại các trường thông tin và thời gian giải đấu (được đánh dấu đỏ).',
                    confirmButtonText: 'Đã hiểu'
                });
                return;
            }

            // Thu thập danh sách Môn thể thao đã chọn
            const monTheThaoIds = [];
            $('.chk-mon:checked').each(function () {
                monTheThaoIds.push(parseInt($(this).val()));
            });

            // Thu thập danh sách Khối đã chọn
            const khoiIds = [];
            $('.chk-khoi:checked').each(function () {
                khoiIds.push(parseInt($(this).val()));
            });

            // Thu thập các mục Điều lệ
            const dieuLeGiaiDaus = [];
            $('#dieuLeContainer .border').each(function (idx) {
                const tieuDe = $(this).find('.dl-tieude').val().trim();
                if (tieuDe) {
                    dieuLeGiaiDaus.push({
                        tieuDe: tieuDe,
                        noiDung: $(this).find('.dl-mota').val().trim(),
                        tepDinhKem: $(this).find('.dl-file').val().trim(),
                        thuTu: idx + 1
                    });
                }
            });

            // Thu thập danh sách Thư ký được chọn
            const thuKyIds = [];
            $('.chk-secretary:checked').each(function () {
                thuKyIds.push(parseInt($(this).val()));
            });

            // Thu thập danh sách Người điều hành môn
            const dieuHanhMonAssignments = [];
            $('.sel-coordinator').each(function () {
                const dmId = parseInt($(this).data('danhmuc-id'));
                const coordVal = $(this).val();
                if (coordVal) {
                    dieuHanhMonAssignments.push({
                        danhMucId: dmId,
                        nguoiDieuHanhMonId: parseInt(coordVal)
                    });
                }
            });

            const payload = {
                ten: ten,
                ma: ma,
                slug: $('#slug').val().trim() || generateSlug(ten),
                diaDiem: $('#diaDiem').val().trim(),
                ngayBatDau: dateCheck.isoNbd,
                ngayKetThuc: dateCheck.isoNkt,
                hanDangKy: dateCheck.isoHdk,
                moTa: $('#moTa').val().trim(),
                trangThai: $('#trangThai').val(),
                phamVi: $('#phamVi').val() || 'TatCa',
                truongBanTrongTaiId: $('#truongBanTrongTaiId').val() ? parseInt($('#truongBanTrongTaiId').val()) : null,
                hinhAnh: $('#bannerUrl').val() || null,
                monTheThaoIds: monTheThaoIds,
                khoiIds: khoiIds,
                dieuLes: dieuLeGiaiDaus,
                thuKyIds: thuKyIds,
                dieuHanhMonAssignments: dieuHanhMonAssignments
            };

            $('#btnSubmit').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Đang tạo giải đấu...');

            $.ajax({
                url: '/Manager/GiaiDau/Save',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    $('#btnSubmit').prop('disabled', false).html('<i class="fa-solid fa-floppy-disk me-1"></i> Hoàn Tất & Tạo Giải Đấu');
                    if (res.success) {
                        Swal.fire({
                            title: 'Thành công!',
                            text: 'Giải đấu đã được tạo thành công.',
                            icon: 'success',
                            confirmButtonText: 'Đến danh sách giải'
                        }).then(() => {
                            window.location.href = '/Manager/GiaiDau';
                        });
                    } else {
                        Swal.fire('Lỗi', res.message || 'Không thể tạo giải đấu.', 'error');
                    }
                },
                error: function (xhr) {
                    $('#btnSubmit').prop('disabled', false).html('<i class="fa-solid fa-floppy-disk me-1"></i> Hoàn Tất & Tạo Giải Đấu');
                    Swal.fire('Lỗi', xhr.responseJSON?.message || 'Có lỗi xảy ra khi lưu dữ liệu.', 'error');
                }
            });
        }

        function generateSlug(text) {
            return text.toLowerCase()
                .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
                .replace(/[đĐ]/g, 'd')
                .replace(/[^a-z0-9\s-]/g, '')
                .trim()
                .replace(/\s+/g, '-');
        }

        function generateCode(text) {
            const words = text.normalize('NFD').replace(/[\u0300-\u036f]/g, '').split(/\s+/);
            const initials = words.filter(w => w.length > 0).map(w => w[0].toUpperCase()).join('');
            const year = new Date().getFullYear();
            return (initials + '_' + year).substring(0, 20);
        }

        function updateSelectedSecretaryCount() {
            const count = $('.chk-secretary:checked').length;
            $('#selectedSecretaryCount').text(count);
        }

        function toggleSelectAllSecretaries(checkbox) {
            $('.chk-secretary').prop('checked', $(checkbox).is(':checked'));
            updateSelectedSecretaryCount();
        }

        function escapeHtml(text) {
            if (!text) return '';
            return $('<div>').text(text).html();
        }
    </script>
}
