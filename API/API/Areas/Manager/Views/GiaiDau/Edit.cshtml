        function loadTournamentRegistrations(page) {
            tournamentRegCurrentPage = page || 1;
            const giaiDauId = parseInt($('#giaiDauId').val()) || @Model.Id;
            const keyword = ($('#regKeywordFilter').val() || '').trim();
            const monId = $('#regMonFilter').val();
            const donViId = $('#regDonViFilter').val();

            $('#tblTournamentRegBody').html('<tr><td colspan="7" class="text-center py-5 text-muted"><div class="spinner-border spinner-border-sm text-primary me-2"></div>Đang tải danh sách hồ sơ...</td></tr>');

            $.ajax({
                url: '/Manager/DangKyThiDau/GetPagedData',
                type: 'GET',
                data: {
                    pageIndex: tournamentRegCurrentPage,
                    pageSize: tournamentRegPageSize,
                    keyword: keyword || undefined,
                    giaiDauId: giaiDauId,
                    monTheThaoId: monId ? parseInt(monId) : undefined,
                    donViId: donViId ? parseInt(donViId) : undefined
                },
                success: function (res) {
                    tournamentRegLoaded = true;
                    if (res && res.success && res.data) {
                        renderTournamentRegTable(res.data);
                    } else {
                        $('#tblTournamentRegBody').html('<tr><td colspan="7" class="text-center py-5 text-muted">Không có hồ sơ đăng ký nào.</td></tr>');
                        $('#tournamentRegPaginationInfo').text('Hiển thị 0 trên 0 hồ sơ');
                        $('#tournamentRegPaginationList').empty();
                    }
                },
                error: function () {
                    $('#tblTournamentRegBody').html('<tr><td colspan="7" class="text-center py-5 text-danger">Có lỗi khi tải danh sách hồ sơ đăng ký.</td></tr>');
                }
            });
        }

        function renderTournamentRegTable(data) {
            const items = data.items || [];
            if (items.length === 0) {
                $('#tblTournamentRegBody').html('<tr><td colspan="7" class="text-center py-5 text-muted">Không tìm thấy hồ sơ đăng ký nào phù hợp.</td></tr>');
                $('#tournamentRegPaginationInfo').text('Hiển thị 0 trên 0 hồ sơ');
                $('#tournamentRegPaginationList').empty();
                return;
            }

            let html = '';
            const start = (data.pageIndex - 1) * data.pageSize;

            $.each(items, function (i, item) {
                const stt = start + i + 1;
                const statusBadge = '<span class="badge bg-success-subtle text-success border"><i class="fa-solid fa-circle-check me-1"></i>Đã duyệt</span>';
                const regDate = formatDateDisplay(item.ngayDangKy);

                const actionButtons = `
                    <div class="btn-group btn-group-sm">
                        <button type="button" class="btn btn-outline-primary" title="Xem Chi Tiết & Danh Sách VĐV" onclick="openTournamentRegDetailsModal(${item.id})">
                            <i class="fa-solid fa-eye me-1"></i> Chi tiết
                        </button>
                        <button type="button" class="btn btn-light border" title="Xóa hồ sơ" onclick="deleteTournamentRegItem(${item.id}, '${escapeHtml(item.tenDangKy || item.tenDoi || '')}')">
                            <i class="fa-solid fa-trash text-danger"></i>
                        </button>
                    </div>
                `;

                html += `
                    <tr>
                        <td class="ps-3 fw-bold text-muted">${stt}</td>
                        <td>
                            <div class="fw-bold text-dark"><i class="fa-solid fa-users text-primary me-1"></i>${escapeHtml(item.tenDoi || item.tenDangKy || 'Đội thi đấu')}</div>
                            ${item.tenDoi && item.tenDangKy && item.tenDangKy !== item.tenDoi ? `<div class="small text-muted mb-1">${escapeHtml(item.tenDangKy)}</div>` : ''}
                            <small class="text-muted"><span class="badge bg-light text-secondary border font-monospace">Mã: ${escapeHtml(item.soDangKy || '-')}</span></small>
                        </td>
                        <td>
                            <span class="fw-semibold text-dark"><i class="fa-solid fa-building me-1 text-secondary"></i>${escapeHtml(item.tenDonVi || 'Vãng lai')}</span>
                        </td>
                        <td>
                            <div class="text-primary fw-semibold"><i class="fa-solid fa-volleyball me-1"></i>${escapeHtml(item.tenMonTheThao || 'Môn thi đấu')}</div>
                        </td>
                        <td><small class="text-muted">${regDate}</small></td>
                        <td>${statusBadge}</td>
                        <td class="text-end pe-3">${actionButtons}</td>
                    </tr>
                `;
            });

            $('#tblTournamentRegBody').html(html);

            const total = data.totalCount || 0;
            const from = total === 0 ? 0 : start + 1;
            const to = Math.min(start + data.pageSize, total);
            $('#tournamentRegPaginationInfo').text(`Hiển thị ${from} - ${to} trên tổng số ${total} hồ sơ`);

            renderTournamentRegPagination(data.pageIndex, data.totalPages);
        }

        function renderTournamentRegPagination(current, totalPages) {
            if (totalPages <= 1) {
                $('#tournamentRegPaginationList').empty();
                return;
            }

            let pagHtml = '';
            pagHtml += `<li class="page-item ${current === 1 ? 'disabled' : ''}">
                <a class="page-link" href="javascript:void(0)" onclick="loadTournamentRegistrations(${current - 1})">&laquo;</a>
            </li>`;

            for (let i = 1; i <= totalPages; i++) {
                if (i === 1 || i === totalPages || (i >= current - 2 && i <= current + 2)) {
                    pagHtml += `<li class="page-item ${i === current ? 'active' : ''}">
                        <a class="page-link" href="javascript:void(0)" onclick="loadTournamentRegistrations(${i})">${i}</a>
                    </li>`;
                }
            }

            pagHtml += `<li class="page-item ${current === totalPages ? 'disabled' : ''}">
                <a class="page-link" href="javascript:void(0)" onclick="loadTournamentRegistrations(${current + 1})">&raquo;</a>
            </li>`;

            $('#tournamentRegPaginationList').html(pagHtml);
        }

        function openTournamentRegDetailsModal(id) {
            $('#modalTournamentRegDetails').modal('show');
            $('#modalTournamentRegDetailsBody').html('<div class="text-center py-4 text-muted"><div class="spinner-border text-primary spinner-border-sm me-2"></div>Đang tải chi tiết hồ sơ...</div>');

            $.get('/Manager/DangKyThiDau/GetById', { id: id }, function (res) {
                if (res && res.success && res.data) {
                    const item = res.data;
                    const vdvs = item.thanhVienDois || item.chiTietDangKyThiDaus || [];

                    let vdvHtml = '';
                    if (vdvs.length === 0) {
                        vdvHtml = '<div class="text-center py-3 text-muted">Chưa gắn danh sách vận động viên cụ thể.</div>';
                    } else {
                        vdvHtml = `
                            <div class="table-responsive mt-3">
                                <table class="table table-sm table-bordered align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="text-center" style="width: 50px;">STT</th>
                                            <th>Họ và Tên VĐV</th>
                                            <th>Mã VĐV</th>
                                            <th class="text-center">Số Áo</th>
                                            <th>Vị Trí / Vai Trò</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                        `;
                        $.each(vdvs, function (idx, v) {
                            vdvHtml += `
                                <tr>
                                    <td class="text-center fw-bold text-muted">${idx + 1}</td>
                                    <td class="fw-bold">${escapeHtml(v.tenVanDongVien || v.hoTen || '-')}</td>
                                    <td><small class="badge bg-light text-secondary border font-monospace">${escapeHtml(v.maVanDongVien || '-')}</small></td>
                                    <td class="text-center">${v.soAo ? `<span class="badge bg-primary">${v.soAo}</span>` : '-'}</td>
                                    <td>${v.laDoiTruong ? '<span class="badge bg-warning text-dark"><i class="fa-solid fa-star me-1"></i>Đội trưởng</span>' : (v.viTri || 'VĐV')}</td>
                                </tr>
                            `;
                        });
                        vdvHtml += `</tbody></table></div>`;
                    }

                    const bodyHtml = `
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="text-muted small">Tên Đội / Hồ sơ:</label>
                                <div class="fw-bold fs-6 text-dark"><i class="fa-solid fa-users text-primary me-1"></i>${escapeHtml(item.tenDoi || item.tenDangKy)}</div>
                                ${item.tenDoi && item.tenDangKy && item.tenDangKy !== item.tenDoi ? `<div class="small text-muted">${escapeHtml(item.tenDangKy)}</div>` : ''}
                            </div>
                            <div class="col-md-3">
                                <label class="text-muted small">Mã số đăng ký:</label>
                                <div><span class="badge bg-light text-secondary border font-monospace">${escapeHtml(item.soDangKy)}</span></div>
                            </div>
                            <div class="col-md-3">
                                <label class="text-muted small">Trạng thái:</label>
                                <div><span class="badge bg-success-subtle text-success border"><i class="fa-solid fa-circle-check me-1"></i>Đã duyệt</span></div>
                            </div>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="text-muted small">Môn thi đấu:</label>
                                <div class="fw-semibold text-dark">${escapeHtml(item.tenMonTheThao || '-')}</div>
                            </div>
                            <div class="col-md-6">
                                <label class="text-muted small">Đơn vị / Đoàn:</label>
                                <div class="fw-semibold text-dark">${escapeHtml(item.tenDonVi || 'Vãng lai')}</div>
                            </div>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="text-muted small">Ngày đăng ký:</label>
                                <div class="text-muted">${formatDateDisplay(item.ngayDangKy, true)}</div>
                            </div>
                        </div>
                        ${item.ghiChu ? `<div class="alert alert-info py-2 small mb-3"><strong>Ghi chú:</strong> ${escapeHtml(item.ghiChu)}</div>` : ''}
                        
                        <h6 class="fw-bold mt-4 mb-2 text-dark">
                            <i class="fa-solid fa-user-group text-primary me-2"></i>Danh Sách Vận Động Viên (${vdvs.length} thành viên)
                        </h6>
                        ${vdvHtml}
                    `;
                    $('#modalTournamentRegDetailsBody').html(bodyHtml);
                } else {
                    $('#modalTournamentRegDetailsBody').html('<div class="text-center py-4 text-danger">Không tìm thấy thông tin hồ sơ này.</div>');
                }
            }).fail(function () {
                $('#modalTournamentRegDetailsBody').html('<div class="text-center py-4 text-danger">Có lỗi khi tải dữ liệu chi tiết hồ sơ.</div>');
            });
        }

        function deleteTournamentRegItem(id, name) {
            SportApp.confirm('Xác nhận xóa hồ sơ?', `Bạn có chắc chắn muốn xóa hồ sơ đăng ký "${name}" này không?`, function () {
                $.post('/Manager/DangKyThiDau/Delete', { id: id }, function (res) {
                    if (res && res.success) {
                        SportApp.toast('success', res.message || 'Đã xóa hồ sơ thành công!');
                        loadTournamentRegistrations(tournamentRegCurrentPage);
                    } else {
                        Swal.fire('Lỗi', res ? res.message : 'Không thể xóa hồ sơ này.', 'error');
                    }
                }).fail(function () {
                    Swal.fire('Lỗi', 'Không thể kết nối đến máy chủ để xóa hồ sơ.', 'error');
                });
            });
        }

        function resetTournamentRegFilter() {
            $('#regKeywordFilter').val('');
            $('#regMonFilter').val('');
            $('#regDonViFilter').val('');
            loadTournamentRegistrations(1);
        }

        // ==================== TAB 6: BẢNG TỔNG SẮP & HUY CHƯƠNG ====================
        let tournamentMedalsLoaded = false;
        let tournamentMedalList = [];

        function loadTournamentMedals() {
            const giaiDauId = parseInt($('#giaiDauId').val()) || @Model.Id;

            $('#tblTournamentMedalBody').html(`
                <tr>
                    <td colspan="6" class="text-center py-5 text-muted">
                        <div class="spinner-border spinner-border-sm text-warning me-2" role="status"></div>
                        Đang nạp dữ liệu bảng tổng sắp huy chương...
                    </td>
                </tr>
            `);

            // 1. Tải bảng tổng sắp toàn đoàn
            $.get(`/Manager/HuyChuong/GetMedalRankings?giaiDauId=${giaiDauId}`, function (res) {
                tournamentMedalsLoaded = true;
                if (res && res.success && res.data) {
                    const data = res.data;
                    const apiRankings = data.bangXepHang || [];

                    $('#statGoldTournament').text(data.tongSoHuyChuongVang ?? 0);
                    $('#statSilverTournament').text(data.tongSoHuyChuongBac ?? 0);
                    $('#statBronzeTournament').text(data.tongSoHuyChuongDong ?? 0);
                    $('#statTotalTournament').text(data.tongSoHuyChuongDaTrao ?? ((data.tongSoHuyChuongVang || 0) + (data.tongSoHuyChuongBac || 0) + (data.tongSoHuyChuongDong || 0)));

                    $('#tournamentUnitCountBadge').text(`${apiRankings.length} đơn vị`);
                    if (data.ngayXuatBaoCao) {
                        $('#tournamentMedalReportDate').text(`Thời điểm xuất: ${formatDateTimeDisplay(data.ngayXuatBaoCao)}`);
                    } else {
                        $('#tournamentMedalReportDate').text('Cập nhật mới nhất theo kết quả trận đấu');
                    }

                    tournamentMedalList = apiRankings;
                    renderTournamentMedalTable(tournamentMedalList);
                } else {
                    showTournamentMedalEmpty();
                }
            }).fail(function () {
                $('#tblTournamentMedalBody').html('<tr><td colspan="6" class="text-center py-5 text-danger">Có lỗi khi tải bảng tổng sắp huy chương.</td></tr>');
            });

            // 2. Tải kết quả theo từng môn
            $('#tournamentSportRankingsContainer').html(`
                <div class="col-12 text-center py-4 text-muted">
                    <div class="spinner-border spinner-border-sm text-primary me-2"></div>
                    Đang nạp kết quả theo từng môn thi đấu...
                </div>
            `);

            $.get(`/Manager/HuyChuong/GetRankingsByMonTheThao?giaiDauId=${giaiDauId}`, function (res) {
                if (res && res.success && Array.isArray(res.data) && res.data.length > 0) {
                    renderTournamentSportRankings(res.data);
                } else {
                    $('#tournamentSportRankingsContainer').html(`
                        <div class="col-12 text-center py-4 text-muted">
                            <i class="fa-solid fa-award fa-2x mb-2 text-secondary opacity-50"></i>
                            <div>Chưa có kết quả huy chương theo môn thi đấu nào.</div>
                            <small class="text-muted">Nhấn nút "Quét & Đồng Bộ Huy Chương" sau khi các trận đấu có kết quả.</small>
                        </div>
                    `);
                }
            }).fail(function () {
                $('#tournamentSportRankingsContainer').html('<div class="col-12 text-center py-4 text-danger">Không tải được kết quả theo môn.</div>');
            });
        }

        function renderTournamentMedalTable(list) {
            if (!list || list.length === 0) {
                showTournamentMedalEmpty();
                return;
            }

            let html = '';
            list.forEach((item, index) => {
                const rank = item.xepHang || (index + 1);
                let rankDisplay = '';

                if (rank === 1) {
                    rankDisplay = '<span class="badge rounded-circle p-2 bg-warning text-dark fs-6" title="Hạng 1 - Vô địch">🥇</span>';
                } else if (rank === 2) {
                    rankDisplay = '<span class="badge rounded-circle p-2 bg-secondary text-white fs-6" title="Hạng 2 - Á quân">🥈</span>';
                } else if (rank === 3) {
                    rankDisplay = '<span class="badge rounded-circle p-2 text-white fs-6" style="background:#b45309;" title="Hạng 3 - Hạng ba">🥉</span>';
                } else {
                    rankDisplay = `<span class="badge rounded-pill bg-light text-secondary border px-2.5 py-1 fw-bold">${rank}</span>`;
                }

                html += `
                    <tr>
                        <td class="text-center">${rankDisplay}</td>
                        <td>
                            <div class="fw-bold text-dark" style="font-size: 0.95rem;">${escapeHtml(item.tenDonVi)}</div>
                            ${item.maDonVi ? `<div class="text-muted small font-monospace">${escapeHtml(item.maDonVi)}</div>` : ''}
                        </td>
                        <td class="text-center fw-bold text-warning">${item.soHuyChuongVang}</td>
                        <td class="text-center fw-bold text-secondary">${item.soHuyChuongBac}</td>
                        <td class="text-center fw-bold" style="color: #b45309;">${item.soHuyChuongDong}</td>
                        <td class="text-center fw-bold text-primary">${item.tongSoHuyChuong}</td>
                    </tr>
                `;
            });

            $('#tblTournamentMedalBody').html(html);
        }

        function showTournamentMedalEmpty() {
            $('#statGoldTournament, #statSilverTournament, #statBronzeTournament, #statTotalTournament').text('0');
            $('#tournamentUnitCountBadge').text('0 đơn vị');
            $('#tblTournamentMedalBody').html(`
                <tr>
                    <td colspan="6" class="text-center py-5 text-muted">
                        <i class="fa-solid fa-award fa-3x mb-3 text-secondary opacity-50"></i>
                        <h6 class="fw-bold text-secondary">Chưa có dữ liệu huy chương</h6>
                        <p class="mb-0 small">Chưa có huy chương nào được trao. Bấm "Quét & Đồng Bộ Huy Chương" để tính kết quả từ các trận đã đấu.</p>
                    </td>
                </tr>
            `);
        }

        function handleSearchTournamentMedal(val) {
            const keyword = (val || '').trim().toLowerCase();
            const filtered = tournamentMedalList.filter(item => {
                const name = (item.tenDonVi || '').toLowerCase();
                const code = (item.maDonVi || '').toLowerCase();
                return name.includes(keyword) || code.includes(keyword);
            });
            renderTournamentMedalTable(filtered);
        }

        function renderTournamentSportRankings(sports) {
            let html = '';
            sports.forEach(sport => {
                let rowsHtml = '';
                const winners = sport.danhSachDatGiai || [];
                const isTeam = sport.laMonDongDoi;

                if (winners.length === 0) {
                    rowsHtml = `<tr><td colspan="3" class="text-center text-muted py-2 small">Chưa có kết quả</td></tr>`;
                } else {
                    winners.forEach(w => {
                        let badgeHtml = '';
                        if (w.loaiHuyChuong === 1) {
                            badgeHtml = '<span class="badge bg-warning text-dark">🥇 Vàng</span>';
                        } else if (w.loaiHuyChuong === 2) {
                            badgeHtml = '<span class="badge bg-secondary text-white">🥈 Bạc</span>';
                        } else if (w.loaiHuyChuong === 3) {
                            badgeHtml = '<span class="badge text-white" style="background:#b45309;">🥉 Đồng</span>';
                        } else {
                            badgeHtml = '<span class="badge bg-light text-dark border">Khuyến khích</span>';
                        }

                        rowsHtml += `
                            <tr>
                                <td class="fw-semibold small">${escapeHtml(w.tenDoi || w.tenVanDongVien || '-')}</td>
                                <td class="text-muted small">${escapeHtml(w.tenDonVi || '-')}</td>
                                <td class="text-center">${badgeHtml}</td>
                            </tr>
                        `;
                    });
                }

                html += `
                    <div class="col-md-6">
                        <div class="card border rounded-3 h-100 shadow-2xs overflow-hidden">
                            <div class="card-header bg-light py-2 px-3 d-flex justify-content-between align-items-center">
                                <div class="fw-bold text-dark small"><i class="fa-solid fa-volleyball text-primary me-1.5"></i>${escapeHtml(sport.tenMon)}</div>
                                <span class="badge bg-white text-secondary border font-monospace" style="font-size: 0.7rem;">${escapeHtml(sport.tenDanhMuc || '')}</span>
                            </div>
                            <div class="card-body p-0">
                                <table class="table table-sm table-hover align-middle mb-0" style="font-size: 0.85rem;">
                                    <thead class="table-light text-muted" style="font-size: 0.72rem;">
                                        <tr>
                                            <th>${isTeam ? 'Đội Đạt Giải' : 'Vận Động Viên'}</th>
                                            <th>Đơn Vị</th>
                                            <th class="text-center">Huy Chương</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        ${rowsHtml}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                `;
            });

            $('#tournamentSportRankingsContainer').html(html);
        }

        function syncTournamentMedals() {
            const giaiDauId = parseInt($('#giaiDauId').val()) || @Model.Id;

            Swal.fire({
                title: 'Đồng bộ kết quả huy chương?',
                html: 'Hệ thống sẽ tự động quét các bảng đấu và trận đấu đã hoàn thành của giải để tính toán và trao huy chương (Vàng, Bạc, Đồng) theo đúng thứ hạng thực tế.<br><br>Bạn có muốn thực hiện ngay không?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: '<i class="fa-solid fa-wand-magic-sparkles me-1"></i> Đồng bộ ngay',
                cancelButtonText: 'Hủy',
                confirmButtonColor: '#f59e0b',
                cancelButtonColor: '#6c757d'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: 'Đang quét và tính toán...',
                        allowOutsideClick: false,
                        didOpen: () => { Swal.showLoading(); }
                    });

                    $.post(`/Manager/HuyChuong/SyncMedalsFromResults?giaiDauId=${giaiDauId}`, function (res) {
                        Swal.close();
                        if (res && res.success) {
                            let detailHtml = res.message || 'Đã đồng bộ huy chương thành công!';
                            if (res.awarded && res.awarded.length > 0) {
                                detailHtml += '<div class="text-start mt-3 p-2 bg-light rounded" style="max-height: 200px; overflow-y: auto; font-size: 0.85rem;">' +
                                    res.awarded.map(a => `<div>${escapeHtml(a)}</div>`).join('') +
                                    '</div>';
                            }
                            Swal.fire('Thành công', detailHtml, 'success');
                            loadTournamentMedals();
                        } else {
                            Swal.fire('Thông báo', res ? res.message : 'Không có thay đổi nào.', 'info');
                        }
                    }).fail(function () {
                        Swal.close();
                        Swal.fire('Lỗi', 'Không thể kết nối đến máy chủ để đồng bộ huy chương.', 'error');
                    });
                }
            });
        }

        function formatDateDisplay(str, withTime = false) {
            if (!str) return '-';
            const d = new Date(str);
            if (isNaN(d.getTime())) return str;
            const day = String(d.getDate()).padStart(2, '0');
            const month = String(d.getMonth() + 1).padStart(2, '0');
            const year = d.getFullYear();
            if (withTime) {
                const h = String(d.getHours()).padStart(2, '0');
                const m = String(d.getMinutes()).padStart(2, '0');
                return `${day}/${month}/${year} ${h}:${m}`;
            }
            return `${day}/${month}/${year}`;
        }

        function formatDateTimeDisplay(dtStr) {
            return formatDateDisplay(dtStr, true);
        }

        function escapeHtml(text) {
            if (!text) return '';
            return $('<div>').text(text).html();
        }
    </script>
}
