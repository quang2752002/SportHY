@section Scripts {
    <!-- CKEditor 5 Classic -->
    <script src="https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/ckeditor.js"></script>

    <script>
        async function copyUnitRegistrationLink(button) {
            const registrationUrl = button?.dataset.registrationUrl;
            if (!registrationUrl) {
                Swal.fire('Không thể sao chép', 'Chưa tạo được link đăng ký cho giải đấu này.', 'error');
                return;
            }

            try {
                if (navigator.clipboard && window.isSecureContext) {
                    await navigator.clipboard.writeText(registrationUrl);
                } else {
                    const temporaryInput = document.createElement('textarea');
                    temporaryInput.value = registrationUrl;
                    temporaryInput.setAttribute('readonly', '');
                    temporaryInput.style.position = 'fixed';
                    temporaryInput.style.opacity = '0';
                    document.body.appendChild(temporaryInput);
                    temporaryInput.select();
                    const copied = document.execCommand('copy');
                    temporaryInput.remove();
                    if (!copied) throw new Error('Clipboard is unavailable');
                }

                const hostName = window.location.hostname.toLowerCase();
                const isLocalAddress = ['localhost', '127.0.0.1', '::1', '[::1]'].includes(hostName);
                SportApp.toast('success', isLocalAddress
                    ? 'Đã sao chép link. Lưu ý: địa chỉ localhost chỉ mở được trên máy này.'
                    : 'Đã sao chép link đăng ký giải đấu.');
            } catch {
                await Swal.fire({
                    icon: 'info',
                    title: 'Link đăng ký giải đấu',
                    text: 'Trình duyệt không cho phép sao chép tự động. Bạn hãy sao chép link bên dưới:',
                    input: 'text',
                    inputValue: registrationUrl,
                    inputAttributes: { readonly: true, 'aria-label': 'Link đăng ký giải đấu' },
                    confirmButtonText: 'Đóng'
                });
            }
        }

        let dieuLeIndex = @dieuLes.Count + 10;
        let moTaEditor = null;

