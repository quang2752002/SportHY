        function uploadDieuLeFile(input, rowId) {
            if (!input.files || !input.files[0]) return;
            const file = input.files[0];
            const formData = new FormData();
            formData.append('file', file);

            SportApp.toast('info', 'Đang tải tệp điều lệ...');

            $.ajax({
                url: '/Manager/GiaiDau/UploadDieuLe',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (res) {
                    if (res.success) {
