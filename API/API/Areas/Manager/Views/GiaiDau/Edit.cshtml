@model GiaiDauDto
@{
    ViewData["Title"] = "Chỉnh sửa Giải Đấu - " + Model.Ten;
    var khois = ViewBag.Khois as IEnumerable<KhoiDto> ?? Enumerable.Empty<KhoiDto>();
    var monTheThaos = ViewBag.MonTheThaos as IEnumerable<MonTheThaoDto> ?? Enumerable.Empty<MonTheThaoDto>();
    var trongTais = ViewBag.TrongTais as IEnumerable<TrongTaiDto> ?? Enumerable.Empty<TrongTaiDto>();
    var sportCoordinatorUsers = ViewBag.SportCoordinatorUsers as List<SportCoordinatorUserOptionDto> ?? new();
    var secretaryAssignments = ViewBag.SecretaryAssignments as List<ThuKyPhanCongDto> ?? new();
    var categoryAssignments = ViewBag.CategoryAssignments as List<CategoryAssignmentViewModelDto> ?? new();
    var selectedMonIds = Model.MonTheThaoIds ?? new List<int>();
    var selectedKhoiIds = Model.KhoiIds ?? new List<int>();
    var dieuLes = Model.DieuLeGiaiDaus ?? new List<DieuLeGiaiDauDto>();
    var unitRegistrationUrl = Url.Action("ChiTiet", "DangKy", new { area = "DonVi", id = Model.Id }, Context.Request.Scheme)
        ?? $"{Context.Request.Scheme}://{Context.Request.Host}/DonVi/DangKy/ChiTiet/{Model.Id}";
}

@section Styles {
    <style>
        .ck-editor__editable_inline {
            min-height: 220px;
            max-height: 480px;
            font-size: 0.95rem;
            line-height: 1.6;
        }
        .ck.ck-editor {
            width: 100% !important;
        }
        .ck.ck-toolbar {
            border-top-left-radius: 0.5rem !important;
            border-top-right-radius: 0.5rem !important;
            border-color: #cbd5e1 !important;
        }
        .ck.ck-content {
            border-bottom-left-radius: 0.5rem !important;
            border-bottom-right-radius: 0.5rem !important;
            border-color: #cbd5e1 !important;
        }
    </style>
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1 text-dark">
            <i class="fa-solid fa-pen-to-square text-primary me-2"></i>Chỉnh Sửa Giải Đấu: @Model.Ten
        </h4>
        <p class="text-muted small mb-0">Cập nhật thông tin chi tiết giải, điều chỉnh các môn thi đấu, điều lệ và phân công nhân sự.</p>
    </div>
    <div class="d-flex flex-wrap align-items-center justify-content-end gap-2">
        <button type="button"
                class="btn btn-outline-primary"
                data-registration-url="@unitRegistrationUrl"
                onclick="copyUnitRegistrationLink(this)">
            <i class="fa-solid fa-link me-1"></i> Sao chép link đăng ký
        </button>
        <a href="/Manager/GiaiDau" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>
</div>

<form id="formEditGiaiDau" novalidate>
    <input type="hidden" id="giaiDauId" value="@Model.Id">

    <ul class="nav nav-tabs mb-4" id="giaiDauEditTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="editGeneralTab" data-bs-toggle="tab" data-bs-target="#editGeneralPane" type="button" role="tab" aria-controls="editGeneralPane" aria-selected="true">
                <i class="fa-solid fa-circle-info me-1"></i>Thông tin chung
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="editSportsTab" data-bs-toggle="tab" data-bs-target="#editSportsPane" type="button" role="tab" aria-controls="editSportsPane" aria-selected="false">
                <i class="fa-solid fa-volleyball me-1"></i>Môn thi đấu & khối tham gia
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="editRulesTab" data-bs-toggle="tab" data-bs-target="#editRulesPane" type="button" role="tab" aria-controls="editRulesPane" aria-selected="false">
                <i class="fa-solid fa-file-contract me-1"></i>Điều lệ giải đấu
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="editPersonnelTab" data-bs-toggle="tab" data-bs-target="#editPersonnelPane" type="button" role="tab" aria-controls="editPersonnelPane" aria-selected="false">
                <i class="fa-solid fa-users-gear me-1"></i>Phân công nhân sự
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="editRegistrationsTab" data-bs-toggle="tab" data-bs-target="#editRegistrationsPane" type="button" role="tab" aria-controls="editRegistrationsPane" aria-selected="false">
                <i class="fa-solid fa-clipboard-user me-1"></i>Hồ sơ đăng ký
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="editMedalsTab" data-bs-toggle="tab" data-bs-target="#editMedalsPane" type="button" role="tab" aria-controls="editMedalsPane" aria-selected="false">
                <i class="fa-solid fa-medal me-1"></i>Bảng tổng sắp & Huy chương
            </button>
        </li>
    </ul>

    <div class="tab-content" id="giaiDauEditTabContent">
        <!-- TAB 1: THÔNG TIN CHUNG -->
        <div class="tab-pane fade show active" id="editGeneralPane" role="tabpanel" aria-labelledby="editGeneralTab" tabindex="0">
            <div class="row g-4">
                <!-- Cột trái: 1. Thông tin cơ bản -->
                <div class="col-lg-8">
                    <div class="card card-custom mb-4">
                        <div class="card-header bg-white py-3">
                            <h6 class="fw-bold text-dark mb-0">
                                <i class="fa-solid fa-circle-info text-primary me-2"></i>1. Thông Tin Cơ Bản Giải Đấu
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-8">
                                    <label class="form-label fw-semibold">Tên giải đấu <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="ten" required value="@Model.Ten" placeholder="Ví dụ: Đại Hội Thể Thao Sinh Viên TP.HCM 2026">
                                    <div class="invalid-feedback">Vui lòng nhập tên giải đấu.</div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold">Mã giải đấu <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="ma" required value="@Model.Ma" placeholder="DH_TTH_2026">
                                    <div class="invalid-feedback">Vui lòng nhập mã giải đấu.</div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Địa điểm tổ chức</label>
                                    <input type="text" class="form-control" id="diaDiem" value="@Model.DiaDiem" placeholder="Ví dụ: Cung Thể Thao Phú Thọ, TP.HCM">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Đường dẫn thân thiện (Slug)</label>
                                    <input type="text" class="form-control" id="slug" value="@Model.Slug" placeholder="dai-hoi-the-thao-sinh-vien-2026">
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label fw-semibold">Ngày bắt đầu <span class="text-danger">*</span></label>
                                    <div class="input-group has-validation position-relative">
                                        <input type="text" class="form-control date-dmy-input bg-white" id="ngayBatDau" placeholder="dd/mm/yyyy" maxlength="10" required autocomplete="off" value="@Model.NgayBatDau.ToString("dd/MM/yyyy")">
                                        <span class="input-group-text bg-white cursor-pointer" onclick="openDatePicker('ngayBatDau')" title="Mở lịch chọn ngày">
                                            <i class="fa-solid fa-calendar-days text-primary"></i>
                                        </span>
                                        <input type="date" class="date-native-picker" id="ngayBatDau_picker" tabindex="-1" aria-hidden="true" value="@Model.NgayBatDau.ToString("yyyy-MM-dd")" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; pointer-events: none; z-index: -1;">
                                        <div class="invalid-feedback">Vui lòng chọn ngày bắt đầu giải đấu.</div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold">Ngày kết thúc <span class="text-danger">*</span></label>
                                    <div class="input-group has-validation position-relative">
                                        <input type="text" class="form-control date-dmy-input bg-white" id="ngayKetThuc" placeholder="dd/mm/yyyy" maxlength="10" required autocomplete="off" value="@Model.NgayKetThuc.ToString("dd/MM/yyyy")">
                                        <span class="input-group-text bg-white cursor-pointer" onclick="openDatePicker('ngayKetThuc')" title="Mở lịch chọn ngày">
                                            <i class="fa-solid fa-calendar-days text-primary"></i>
                                        </span>
                                        <input type="date" class="date-native-picker" id="ngayKetThuc_picker" tabindex="-1" aria-hidden="true" value="@Model.NgayKetThuc.ToString("yyyy-MM-dd")" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; pointer-events: none; z-index: -1;">
                                        <div class="invalid-feedback">Vui lòng chọn ngày kết thúc giải đấu.</div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold">Hạn nộp hồ sơ đăng ký <span class="text-danger">*</span></label>
                                    <div class="input-group has-validation position-relative">
                                        <input type="text" class="form-control date-dmy-input bg-white" id="hanDangKy" placeholder="dd/mm/yyyy" maxlength="10" required autocomplete="off" value="@(Model.HanDangKy?.ToString("dd/MM/yyyy"))">
                                        <span class="input-group-text bg-white cursor-pointer" onclick="openDatePicker('hanDangKy')" title="Mở lịch chọn ngày">
                                            <i class="fa-solid fa-calendar-days text-primary"></i>
                                        </span>
                                        <input type="date" class="date-native-picker" id="hanDangKy_picker" tabindex="-1" aria-hidden="true" value="@(Model.HanDangKy?.ToString("yyyy-MM-dd"))" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; pointer-events: none; z-index: -1;">
                                        <div class="invalid-feedback">Vui lòng chọn hạn nộp hồ sơ đăng ký.</div>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <label class="form-label fw-semibold d-flex justify-content-between align-items-center">
                                        <span>Mô tả tóm tắt giải đấu</span>
                                        <small class="text-muted fw-normal"><i class="fa-solid fa-pen-nib text-primary me-1"></i>Soạn thảo phong phú (CKEditor)</small>
                                    </label>
                                    <textarea class="form-control" id="moTa" rows="5" placeholder="Giới thiệu mục đích, ý nghĩa, quy mô và đối tượng tham gia...">@Model.MoTa</textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Cột phải: Cấu hình, Phân mục & Banner -->
                <div class="col-lg-4">
                    <!-- Trạng thái & Quy mô -->
                    <div class="card card-custom mb-4">
                        <div class="card-header bg-white py-3">
                            <h6 class="fw-bold text-dark mb-0">
                                <i class="fa-solid fa-sliders text-info me-2"></i>Cấu Hình & Trạng Thái
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Trạng thái giải</label>
                                <select class="form-select" id="trangThai">
                                    <option value="Nhap" selected="@(Model.TrangThai == TrangThaiGiaiDau.Nhap ? "selected" : null)">Bản nháp</option>
                                    <option value="SapDienRa" selected="@(Model.TrangThai == TrangThaiGiaiDau.SapDienRa ? "selected" : null)">Sắp diễn ra</option>
                                    <option value="DangDienRa" selected="@(Model.TrangThai == TrangThaiGiaiDau.DangDienRa ? "selected" : null)">Đang diễn ra</option>
                                    <option value="KetThuc" selected="@(Model.TrangThai == TrangThaiGiaiDau.KetThuc ? "selected" : null)">Đã kết thúc</option>
                                    <option value="Huy" selected="@(Model.TrangThai == TrangThaiGiaiDau.Huy ? "selected" : null)">Đã hủy</option>
                                </select>
                            </div>

                            <div class="mb-0">
                                <label class="form-label fw-semibold">Phạm vi tổ chức</label>
                                <select class="form-select" id="phamVi">
                                    <option value="TatCa" selected="@(Model.PhamVi == PhamViGiaiDau.TatCa ? "selected" : null)">Tất cả đơn vị</option>
                                    <option value="TheoKhoi" selected="@(Model.PhamVi == PhamViGiaiDau.TheoKhoi ? "selected" : null)">Theo khối ngành / đơn vị</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Điều hướng các phân mục tiếp theo -->
                    <div class="card card-custom mb-4">
                        <div class="card-header bg-white py-3">
                            <h6 class="fw-bold text-dark mb-0">
                                <i class="fa-solid fa-list-check text-primary me-2"></i>Các Phân Mục Thiết Lập
                            </h6>
                        </div>
                        <div class="card-body d-flex flex-column gap-2">
                            <button type="button" class="btn btn-outline-success text-start d-flex align-items-center justify-content-between p-2.5" onclick="switchToSportsTab()">
                                <div>
                                    <div class="fw-semibold small"><i class="fa-solid fa-volleyball me-1.5"></i>2. Môn thi & Khối tham gia</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">Chọn các môn và khối thi đấu</div>
                                </div>
                                <i class="fa-solid fa-chevron-right text-muted small"></i>
                            </button>
                            <button type="button" class="btn btn-outline-warning text-start d-flex align-items-center justify-content-between p-2.5 text-dark" onclick="switchToRulesTab()">
                                <div>
                                    <div class="fw-semibold small"><i class="fa-solid fa-file-contract me-1.5 text-warning"></i>3. Điều lệ giải đấu</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">Quy định, thể thức & tệp đính kèm (@dieuLes.Count mục)</div>
                                </div>
                                <i class="fa-solid fa-chevron-right text-muted small"></i>
                            </button>
                            <button type="button" class="btn btn-outline-primary text-start d-flex align-items-center justify-content-between p-2.5" onclick="switchToPersonnelTab()">
                                <div>
                                    <div class="fw-semibold small"><i class="fa-solid fa-users-gear me-1.5 text-primary"></i>4. Phân công nhân sự</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">Trưởng ban, Điều hành môn & Thư ký</div>
                                </div>
                                <i class="fa-solid fa-chevron-right text-muted small"></i>
                            </button>
                            <button type="button" class="btn btn-outline-info text-start d-flex align-items-center justify-content-between p-2.5 text-dark" onclick="switchToRegistrationsTab()">
                                <div>
                                    <div class="fw-semibold small"><i class="fa-solid fa-clipboard-user me-1.5 text-info"></i>5. Hồ sơ đăng ký thi đấu</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">Quản lý danh sách đội & VĐV nộp hồ sơ</div>
                                </div>
                                <i class="fa-solid fa-chevron-right text-muted small"></i>
                            </button>
                            <button type="button" class="btn btn-outline-danger text-start d-flex align-items-center justify-content-between p-2.5 text-dark" onclick="switchToMedalsTab()">
                                <div>
                                    <div class="fw-semibold small"><i class="fa-solid fa-medal me-1.5 text-danger"></i>6. Bảng tổng sắp & Huy chương</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">Thống kê xếp hạng đoàn & kết quả môn</div>
                                </div>
                                <i class="fa-solid fa-chevron-right text-muted small"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Banner / Poster ảnh -->
                    <div class="card card-custom mb-4">
                        <div class="card-header bg-white py-3">
                            <h6 class="fw-bold text-dark mb-0">
                                <i class="fa-solid fa-image text-danger me-2"></i>Hình Ảnh / Poster Giải
                            </h6>
                        </div>
                        <div class="card-body text-center">
                            <div class="mb-3">
                                <img id="bannerPreview" src="@(string.IsNullOrEmpty(Model.HinhAnh) ? "https://placehold.co/600x300?text=Chua+co+poster" : Model.HinhAnh)" 
                                     class="img-fluid rounded border shadow-sm w-100" style="max-height: 180px; object-fit: cover;" alt="Banner Preview">
                            </div>
                            <input type="hidden" id="bannerUrl" value="@Model.HinhAnh">
                            <input type="file" id="fileBanner" class="d-none" accept="image/*" onchange="uploadBannerFile(this)">
                            <button type="button" class="btn btn-outline-primary w-100" onclick="$('#fileBanner').click()">
                                <i class="fa-solid fa-cloud-arrow-up me-1"></i> Thay đổi ảnh poster
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Chuyển tab tiếp theo -->
            <div class="d-flex justify-content-end mt-2">
                <button type="button" class="btn btn-primary px-3 py-2 fw-semibold" onclick="switchToSportsTab()">
                    <span>Tiếp theo: Môn thi đấu & Khối</span>
                    <i class="fa-solid fa-arrow-right ms-1.5"></i>
                </button>
            </div>
        </div>

        <!-- TAB 2: MÔN THI ĐẤU & KHỐI THAM GIA -->
        <div class="tab-pane fade" id="editSportsPane" role="tabpanel" aria-labelledby="editSportsTab" tabindex="0">
            <div class="row g-4">
                <!-- Cột trái: 2. Chọn Môn thi đấu tổ chức trong giải -->
                <div class="col-lg-8">
                    <div class="card card-custom mb-4" id="competitionSportCard">
                        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="fw-bold text-dark mb-0">
                                    <i class="fa-solid fa-volleyball text-success me-2"></i>2. Môn Thi Đấu Tổ Chức Trong Giải
                                </h6>
                                <small class="text-muted">Tích chọn các môn thi đấu áp dụng cho giải đấu này</small>
                            </div>
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-outline-primary" id="btnSelectAllMon">Chọn tất cả</button>
                                <button type="button" class="btn btn-outline-secondary" id="btnDeselectAllMon">Bỏ chọn</button>
                            </div>
                        </div>
                        <div class="card-body">
                            <div id="sportSelectionError" class="alert alert-danger py-2 small d-none" role="alert">
                                Vui lòng chọn ít nhất một môn thi đấu cho giải.
                            </div>
                            @if (!monTheThaos.Any())
                            {
                                <div class="text-center py-4 text-muted">
                                    Chưa có danh mục môn thể thao nào trên hệ thống.
                                </div>
                            }
                            else
                            {
                                <div class="d-flex flex-column gap-3" id="listMonTheThao">
                                    @foreach (var categoryGroup in monTheThaos
                                        .GroupBy(mon => new
                                        {
                                            mon.DanhMucId,
                                            TenDanhMuc = string.IsNullOrWhiteSpace(mon.TenDanhMuc) ? "Chưa phân danh mục" : mon.TenDanhMuc.Trim()
                                        })
                                        .OrderBy(group => group.Key.TenDanhMuc))
                                    {
                                        <section class="border rounded-3 overflow-hidden">
                                            <div class="d-flex align-items-center justify-content-between gap-2 px-3 py-2 bg-light border-bottom">
                                                <div class="fw-bold text-dark small">
                                                    <i class="fa-solid fa-layer-group text-primary me-2"></i>@categoryGroup.Key.TenDanhMuc
                                                </div>
                                                <span class="badge bg-white text-secondary border">@categoryGroup.Count() môn</span>
                                            </div>
                                            <div class="p-2">
                                                <div class="row g-2">
                                                    @foreach (var mon in categoryGroup.OrderBy(item => item.Ten))
                                                    {
                                                        var isChecked = selectedMonIds.Contains(mon.Id);
                                                        <div class="col-md-4 col-sm-6">
                                                            <div class="form-check p-2 border rounded hover-shadow h-100 d-flex align-items-center bg-white @(isChecked ? "border-primary bg-primary-subtle" : "")">
                                                                <input class="form-check-input chk-mon me-2 ms-1" type="checkbox" value="@mon.Id" id="mon_@mon.Id" @(isChecked ? "checked" : "")>
                                                                <label class="form-check-label fw-semibold text-dark small w-100 cursor-pointer" for="mon_@mon.Id">
                                                                    <div>@mon.Ten</div>
                                                                    <div class="mt-1">
                                                                        @if (mon.LaMonDongDoi)
                                                                        {
                                                                            <span class="badge bg-info-subtle text-info border" style="font-size: 0.68rem;">Đồng đội</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="badge bg-secondary-subtle text-secondary border" style="font-size: 0.68rem;">Cá nhân</span>
                                                                        }
                                                                    </div>
                                                                </label>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </section>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Cột phải: Khối tham gia -->
                <div class="col-lg-4">
                    <div class="card card-custom mb-4" id="participatingBlocksCard">
                        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold text-dark mb-0">
                                <i class="fa-solid fa-layer-group text-primary me-2"></i>Khối Tham Gia
                            </h6>
                        </div>
                        <div class="card-body">
                            <div id="blockSelectionError" class="alert alert-danger py-2 small d-none" role="alert">
                                Vui lòng chọn ít nhất một khối tham gia khi phạm vi tổ chức là “Theo khối ngành / đơn vị”.
                            </div>
                            <p class="text-muted small mb-3">Chọn các khối đơn vị được phép đăng ký tham dự giải:</p>
                            <div class="d-flex flex-column gap-2" id="listKhoi">
                                @foreach (var khoi in khois)
                                {
                                    var isKhoiChecked = selectedKhoiIds.Contains(khoi.Id);
                                    <div class="form-check p-2 border rounded hover-shadow @(isKhoiChecked ? "border-primary bg-primary-subtle" : "")">
                                        <input class="form-check-input chk-khoi me-2 ms-1" type="checkbox" value="@khoi.Id" id="khoi_@khoi.Id" @(isKhoiChecked ? "checked" : "")>
                                        <label class="form-check-label fw-semibold text-dark small cursor-pointer" for="khoi_@khoi.Id">
                                            @khoi.Ten
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Chuyển tab trước/sau -->
            <div class="d-flex justify-content-between mt-2">
                <button type="button" class="btn btn-outline-secondary px-3 py-2" onclick="switchToGeneralTab()">
                    <i class="fa-solid fa-arrow-left me-1.5"></i>
                    <span>Quay lại: Thông tin chung</span>
                </button>
                <button type="button" class="btn btn-primary px-3 py-2 fw-semibold" onclick="switchToRulesTab()">
                    <span>Tiếp theo: Điều lệ giải đấu</span>
                    <i class="fa-solid fa-arrow-right ms-1.5"></i>
                </button>
            </div>
        </div>

        <!-- TAB 3: ĐIỀU LỆ GIẢI ĐẤU -->
        <div class="tab-pane fade" id="editRulesPane" role="tabpanel" aria-labelledby="editRulesTab" tabindex="0">
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="card card-custom mb-4">
                        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="fw-bold text-dark mb-0">
                                    <i class="fa-solid fa-file-contract text-warning me-2"></i>3. Điều Lệ Giải Đấu
                                </h6>
                                <small class="text-muted">Định nghĩa các mục quy định, thể thức và đính kèm văn bản điều lệ</small>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-primary" onclick="addDieuLeRow()">
                                <i class="fa-solid fa-plus me-1"></i> Thêm mục điều lệ
                            </button>
                        </div>
                        <div class="card-body">
                            <div id="dieuLeContainer">
                                @for (int i = 0; i < dieuLes.Count; i++)
                                {
                                    var dl = dieuLes[i];
                                    var rowId = $"dieule_existing_{i + 1}";
                                    <div class="border rounded p-3 mb-3 bg-light position-relative" id="@rowId">
                                        <button type="button" class="btn btn-sm btn-outline-danger position-absolute top-0 end-0 m-2" onclick="$('#@rowId').remove()" title="Xóa mục này">
                                            <i class="fa-solid fa-xmark"></i>
                                        </button>
                                        <div class="row g-2">
                                            <div class="col-md-6">
                                                <label class="form-label small fw-semibold">Tiêu đề điều lệ <span class="text-danger">*</span></label>
                                                <input type="text" class="form-control form-control-sm dl-tieude" required value="@dl.TieuDe" placeholder="Ví dụ: Điều lệ thi đấu bóng đá">
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label small fw-semibold">Tệp đính kèm (PDF / Word)</label>
                                                <div class="input-group input-group-sm">
                                                    <input type="text" class="form-control dl-file" value="@dl.TepDinhKem" placeholder="Chưa có tệp" readonly>
                                                    <input type="file" class="d-none dl-file-input" onchange="uploadDieuLeFile(this, '@rowId')">
                                                    <button type="button" class="btn btn-outline-secondary" onclick="$(this).siblings('.dl-file-input').click()" title="Tải tệp lên">
                                                        <i class="fa-solid fa-upload"></i>
                                                    </button>
                                                    @if (!string.IsNullOrEmpty(dl.TepDinhKem))
                                                    {
                                                        <a href="@dl.TepDinhKem" target="_blank" class="btn btn-outline-info dl-view-btn" title="Xem tệp">
                                                            <i class="fa-solid fa-eye"></i>
                                                        </a>
                                                    }
                                                </div>
                                            </div>
                                            <div class="col-12">
                                                <label class="form-label small fw-semibold">Nội dung tóm tắt</label>
                                                <textarea class="form-control form-control-sm dl-mota" rows="2" placeholder="Tóm tắt nội dung quy định...">@dl.NoiDung</textarea>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card card-custom mb-4 border-0 shadow-sm" style="background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%); border: 1px solid #e2e8f0 !important;">
                        <div class="card-header bg-white py-3 border-bottom">
                            <h6 class="fw-bold text-dark mb-0">
                                <i class="fa-solid fa-circle-question text-primary me-2"></i>Hướng Dẫn Về Điều Lệ
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="d-flex align-items-start gap-2.5 mb-3">
                                <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center flex-shrink-0" style="width: 28px; height: 28px; font-size: 13px;">
                                    <i class="fa-solid fa-1"></i>
                                </div>
                                <div class="small text-muted">
                                    <span class="fw-semibold text-dark">Tiêu đề điều lệ:</span> Nên đặt rõ ràng theo cấu trúc phân mục (ví dụ: <em>Điều lệ chung giải đấu, Điều lệ kỹ thuật môn Bóng đá...</em>).
                                </div>
                            </div>
                            <div class="d-flex align-items-start gap-2.5 mb-3">
                                <div class="rounded-circle bg-success-subtle text-success d-flex align-items-center justify-content-center flex-shrink-0" style="width: 28px; height: 28px; font-size: 13px;">
                                    <i class="fa-solid fa-2"></i>
                                </div>
                                <div class="small text-muted">
                                    <span class="fw-semibold text-dark">Tệp đính kèm:</span> Tải lên các quyết định, điều lệ chính thức dạng <strong>PDF, Word (.docx, .doc)</strong>.
                                </div>
                            </div>
                            <div class="d-flex align-items-start gap-2.5 mb-3">
                                <div class="rounded-circle bg-warning-subtle text-warning d-flex align-items-center justify-content-center flex-shrink-0" style="width: 28px; height: 28px; font-size: 13px;">
                                    <i class="fa-solid fa-3"></i>
                                </div>
                                <div class="small text-muted">
                                    <span class="fw-semibold text-dark">Công khai cho đơn vị:</span> Các mục điều lệ và tệp đính kèm sẽ hiển thị công khai để các đoàn thể thao nghiên cứu khi nộp hồ sơ.
                                </div>
                            </div>
                            <div class="alert alert-info py-2 px-3 mb-0 small border-0 bg-info-subtle text-dark">
                                <i class="fa-solid fa-lightbulb text-info me-1.5"></i>
                                <strong>Mẹo:</strong> Nhấn <em>"Thêm mục điều lệ"</em> để tạo nhiều phần điều lệ riêng theo từng nhóm nội dung hoặc từng môn.
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Chuyển tab trước/sau -->
            <div class="d-flex justify-content-between mt-2">
                <button type="button" class="btn btn-outline-secondary px-3 py-2" onclick="switchToSportsTab()">
                    <i class="fa-solid fa-arrow-left me-1.5"></i>
                    <span>Quay lại: Môn thi đấu & Khối</span>
                </button>
                <button type="button" class="btn btn-primary px-3 py-2 fw-semibold" onclick="switchToPersonnelTab()">
                    <span>Tiếp theo: Phân công nhân sự</span>
                    <i class="fa-solid fa-arrow-right ms-1.5"></i>
                </button>
            </div>
        </div>

        <!-- TAB 4: PHÂN CÔNG NHÂN SỰ -->
        <div class="tab-pane fade" id="editPersonnelPane" role="tabpanel" aria-labelledby="editPersonnelTab" tabindex="0">
            <div class="row g-4">
                <div class="col-12">
                    <div class="card card-custom mb-4 shadow-sm" id="sectionPhanCong">
                        <div class="card-header bg-white py-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div class="d-flex align-items-center gap-2.5">
                                <div class="rounded-3 d-flex align-items-center justify-content-center text-white shadow-2xs" style="width: 38px; height: 38px; background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);">
                                    <i class="fa-solid fa-users-gear fs-6"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold text-dark mb-0">
                                        4. Phân Công Nhân Sự Điều Hành Giải
                                    </h6>
                                    <small class="text-muted">Phân công Trưởng ban trọng tài, Người điều hành từng môn và Thư ký trực tiếp cho giải đấu này</small>
                                </div>
                            </div>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1.5 rounded-pill fw-semibold shadow-2xs">
                                <i class="fa-solid fa-trophy me-1"></i>@Model.Ten
                            </span>
                        </div>
                        <div class="card-body p-3 p-md-4 d-flex flex-column gap-4">
                            <!-- 4.1. Trưởng ban trọng tài -->
                            <div class="card border rounded-3 overflow-hidden shadow-2xs" style="border-color: #fde68a !important;">
                                <div class="p-3 border-bottom d-flex flex-wrap align-items-center justify-content-between gap-2" style="background-color: #fffbeb; border-color: #fef3c7 !important;">
                                    <div class="d-flex align-items-center gap-2.5">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center shadow-2xs" style="width: 36px; height: 36px; background-color: #fef3c7; border: 1px solid #fde68a;">
                                            <i class="fa-solid fa-user-shield text-warning"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark" style="font-size: 0.95rem;">
                                                Trưởng Ban Trọng Tài Giải Đấu
                                            </div>
                                            <small class="text-muted" style="font-size: 0.8rem;">Trưởng ban chịu trách nhiệm phân bổ trọng tài, giám sát trùng lịch và phê duyệt biên bản thi đấu.</small>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (Model.TruongBanTrongTaiId.HasValue)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1.5 rounded-pill fw-semibold" id="badgeHeadRefStatus">
                                                <i class="fa-solid fa-check me-1"></i> Đã phân công
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2.5 py-1.5 rounded-pill fw-semibold" id="badgeHeadRefStatus">
                                                <i class="fa-solid fa-clock me-1"></i> Chưa phân công
                                            </span>
                                        }
                                    </div>
                                </div>
                                <div class="p-3 bg-white">
                                    <label class="form-label small fw-semibold text-secondary mb-1.5">
                                        <i class="fa-solid fa-user-check me-1 text-primary"></i>Chọn tài khoản trọng tài làm Trưởng ban:
                                    </label>
                                    <div class="row g-2 align-items-center">
                                        <div class="col-md-9 col-lg-10">
                                            <select class="form-select form-select-md shadow-2xs" id="truongBanTrongTaiId" style="border-color: #cbd5e1; font-weight: 500;">
                                                <option value="">-- Chưa chỉ định / Hủy phân công --</option>
                                                @foreach (var tt in trongTais)
                                                {
                                                    if (Model.TruongBanTrongTaiId == tt.Id)
                                                    {
                                                        <option value="@tt.Id" selected="selected">@tt.HoTen (@tt.Ma) - @tt.CapBac</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@tt.Id">@tt.HoTen (@tt.Ma) - @tt.CapBac</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-3 col-lg-2">
                                            <button type="button" class="btn btn-outline-primary w-100 shadow-2xs fw-semibold d-inline-flex align-items-center justify-content-center gap-1.5" onclick="quickSaveHeadReferee()" title="Lưu riêng Trưởng ban trọng tài">
                                                <i class="fa-solid fa-floppy-disk"></i>
                                                <span>Lưu ngay</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- 4.2. Người điều hành theo danh mục môn -->
                            <div class="card border rounded-3 overflow-hidden shadow-2xs" style="border-color: #bbf7d0 !important;">
                                <div class="p-3 border-bottom d-flex flex-wrap align-items-center justify-content-between gap-2" style="background-color: #f0fdf4; border-color: #dcfce7 !important;">
                                    <div class="d-flex align-items-center gap-2.5">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center shadow-2xs" style="width: 36px; height: 36px; background-color: #dcfce7; border: 1px solid #bbf7d0;">
                                            <i class="fa-solid fa-volleyball text-success"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark" style="font-size: 0.95rem;">
                                                Người Điều Hành Môn (Theo Danh Mục Môn)
                                            </div>
                                            <small class="text-muted" style="font-size: 0.8rem;">Chọn tài khoản Người điều hành môn phụ trách giám sát môn thi đấu</small>
                                        </div>
                                    </div>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1.5 rounded-pill fw-semibold">
                                        <i class="fa-solid fa-layer-group me-1"></i>@categoryAssignments.Count danh mục
                                    </span>
                                </div>
                                <div class="p-3 bg-white">
                                    @if (!categoryAssignments.Any())
                                    {
                                        <div class="text-center py-4 bg-light rounded-3 border border-dashed text-muted">
                                            <i class="fa-solid fa-volleyball fa-2x mb-2 text-secondary opacity-50"></i>
                                            <div class="fw-semibold">Chưa có môn thi đấu nào trong giải</div>
                                            <small class="text-muted">Hãy tích chọn môn ở tab Môn thi đấu và lưu lại để hiển thị danh mục môn.</small>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="table-responsive border rounded-3 overflow-hidden shadow-2xs">
                                            <table class="table table-hover align-middle mb-0">
                                                <thead style="background-color: #f8fafc; border-bottom: 1px solid #e2e8f0;">
                                                    <tr class="text-muted small fw-bold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                                                        <th class="ps-3 py-2.5">Danh Mục Môn</th>
                                                        <th class="py-2.5" style="width: 380px;">Người Điều Hành Phụ Trách</th>
                                                        <th class="text-end pe-3 py-2.5" style="width: 100px;">Thao Tác</th>
                                                    </tr>
                                                </thead>
                                                <tbody style="font-size: 13px;">
                                                    @foreach (var cat in categoryAssignments)
                                                    {
                                                        <tr>
                                                            <td class="ps-3 py-2.5">
                                                                <div class="fw-bold text-dark">@cat.TenDanhMuc</div>
                                                                <span class="badge bg-light text-secondary border font-monospace mt-1" style="font-size: 0.7rem;">Mã: @cat.MaDanhMuc</span>
                                                            </td>
                                                            <td class="py-2.5">
                                                                <select class="form-select form-select-sm sel-coordinator shadow-2xs" data-danhmuc-id="@cat.DanhMucId" id="selectCoord_@cat.DanhMucId" style="border-color: #cbd5e1;">
                                                                    <option value="">-- Chưa gán người điều hành --</option>
                                                                    @foreach (var coord in sportCoordinatorUsers)
                                                                    {
                                                                        if (cat.NguoiDieuHanhMonId == coord.Id)
                                                                        {
                                                                            <option value="@coord.Id" selected="selected">@coord.Ma - @coord.FullName (@coord.UserName)</option>
                                                                        }
                                                                        else
                                                                        {
                                                                            <option value="@coord.Id">@coord.Ma - @coord.FullName (@coord.UserName)</option>
                                                                        }
                                                                    }
                                                                    @if (cat.NguoiDieuHanhMonId.HasValue && sportCoordinatorUsers.All(p => p.Id != cat.NguoiDieuHanhMonId.Value))
                                                                    {
                                                                        <option value="@cat.NguoiDieuHanhMonId" selected="selected" disabled>@(cat.TenNguoiDieuHanh ?? "Hồ sơ đã phân công")</option>
                                                                    }
                                                                </select>
                                                            </td>
                                                            <td class="text-end pe-3 py-2.5">
                                                                <button type="button" class="btn btn-sm btn-outline-success px-2.5 shadow-2xs fw-semibold" onclick="quickSaveCoordinator(@cat.DanhMucId, '@cat.TenDanhMuc')" title="Lưu người điều hành này">
                                                                    <i class="fa-solid fa-check me-1"></i> Lưu
                                                                </button>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- 4.3. Phân công thư ký giải đấu -->
                            <div class="card border rounded-3 overflow-hidden shadow-2xs" style="border-color: #bfdbfe !important;">
                                <div class="p-3 border-bottom d-flex flex-wrap align-items-center justify-content-between gap-2" style="background-color: #eff6ff; border-color: #dbeafe !important;">
                                    <div class="d-flex align-items-center gap-2.5">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center shadow-2xs" style="width: 36px; height: 36px; background-color: #dbeafe; border: 1px solid #bfdbfe;">
                                            <i class="fa-solid fa-user-pen text-primary"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark" style="font-size: 0.95rem;">
                                                Phân Công Thư Ký Cho Giải Đấu
                                            </div>
                                            <small class="text-muted" style="font-size: 0.8rem;">Chỉ các thư ký được tích chọn mới nhìn thấy và quản trị giải đấu này sau khi đăng nhập</small>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1.5 rounded-pill fw-semibold">
                                            <i class="fa-solid fa-users me-1"></i>Đã chọn: <span id="selectedSecretaryCount" class="fw-bold text-primary">@secretaryAssignments.Count(s => s.DaPhanCong)</span> thư ký
                                        </span>
                                        @if (secretaryAssignments.Any())
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-primary px-3 shadow-2xs fw-semibold d-inline-flex align-items-center gap-1.5" onclick="quickSaveSecretaries()" title="Lưu riêng danh sách thư ký">
                                                <i class="fa-solid fa-floppy-disk"></i>
                                                <span>Lưu Thư Ký</span>
                                            </button>
                                        }
                                    </div>
                                </div>
                                <div class="p-3 bg-white">
                                    @if (!secretaryAssignments.Any())
                                    {
                                        <div class="text-center py-4 bg-light rounded-3 border border-dashed text-muted">
                                            <i class="fa-solid fa-clipboard-user fa-2x mb-2 text-secondary opacity-50"></i>
                                            <div class="fw-semibold">Chưa có hồ sơ thư ký hoạt động trong hệ thống</div>
                                            <small class="text-muted">Bạn có thể tạo hồ sơ thư ký trong mục Quản lý Thư ký trước khi phân công.</small>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="table-responsive border rounded-3 overflow-hidden shadow-2xs mb-2" style="max-height: 280px; overflow-y: auto;">
                                            <table class="table table-hover align-middle mb-0">
                                                <thead class="sticky-top" style="background-color: #f8fafc; border-bottom: 1px solid #e2e8f0;">
                                                    <tr class="text-muted small fw-bold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                                                        <th class="text-center ps-2 py-2.5" style="width: 50px;">
                                                            <input type="checkbox" class="form-check-input cursor-pointer" id="chkAllSecretaries" onchange="toggleSelectAllSecretaries(this)" title="Chọn tất cả">
                                                        </th>
                                                        <th class="py-2.5">Thư Ký</th>
                                                        <th class="py-2.5">Chức Vụ / Đơn Vị</th>
                                                        <th class="py-2.5">Liên Hệ</th>
                                                        <th class="text-end pe-3 py-2.5">Trạng Thái</th>
                                                    </tr>
                                                </thead>
                                                <tbody style="font-size: 13px;">
                                                    @foreach (var s in secretaryAssignments)
                                                    {
                                                        <tr>
                                                            <td class="text-center ps-2 py-2.5">
                                                                <input type="checkbox" class="form-check-input chk-secretary cursor-pointer" value="@s.ThuKyId" @(s.DaPhanCong ? "checked" : "") onchange="updateSelectedSecretaryCount()">
                                                            </td>
                                                            <td class="py-2.5">
                                                                <div class="fw-bold text-dark">@s.HoTen</div>
                                                                <span class="badge bg-light text-secondary border font-monospace" style="font-size: 0.7rem;">Mã: @s.Ma</span>
                                                            </td>
                                                            <td class="py-2.5">
                                                                <div class="text-dark">@(s.ChucVu ?? "-")</div>
                                                                <small class="text-muted">@(s.DonViCongTac ?? "-")</small>
                                                            </td>
                                                            <td class="py-2.5">
                                                                <div class="text-dark"><i class="fa-solid fa-phone me-1 text-muted" style="font-size: 11px;"></i>@(s.SoDienThoai ?? "-")</div>
                                                                <small class="text-muted"><i class="fa-solid fa-envelope me-1 text-muted" style="font-size: 11px;"></i>@(s.Email ?? "-")</small>
                                                            </td>
                                                            <td class="text-end pe-3 py-2.5">
                                                                <span class="badge @(s.DaPhanCong ? "bg-success-subtle text-success border border-success-subtle" : "bg-light text-secondary border") rounded-pill px-2.5 py-1">
