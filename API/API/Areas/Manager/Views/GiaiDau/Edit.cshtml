                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="text-muted small">Ngày đăng ký:</label>
                                <div class="text-muted">${formatDateDisplay(item.ngayDangKy, true)}</div>
                            </div>
                        </div>
                        ${item.ghiChu ? `<div class="alert alert-info py-2 small mb-3"><strong>Ghi chú:</strong> ${escapeHtml(item.ghiChu)}</div>` : ''}
                        
                        <h6 class="fw-bold mt-4 mb-2 text-dark">
                            <i class="fa-solid fa-user-group text-primary me-2"></i>Danh Sách Vận Động Viên (${vdvs.length} thành viên)
                        </h6>
                        ${vdvHtml}
                    `;
                    $('#modalTournamentRegDetailsBody').html(bodyHtml);
                } else {
                    $('#modalTournamentRegDetailsBody').html('<div class="text-center py-4 text-danger">Không tìm thấy thông tin hồ sơ này.</div>');
                }
            }).fail(function () {
                $('#modalTournamentRegDetailsBody').html('<div class="text-center py-4 text-danger">Có lỗi khi tải dữ liệu chi tiết hồ sơ.</div>');
            });
        }

        function deleteTournamentRegItem(id, name) {
            SportApp.confirm('Xác nhận xóa hồ sơ?', `Bạn có chắc chắn muốn xóa hồ sơ đăng ký "${name}" này không?`, function () {
                $.post('/Manager/DangKyThiDau/Delete', { id: id }, function (res) {
                    if (res && res.success) {
                        SportApp.toast('success', res.message || 'Đã xóa hồ sơ thành công!');
                        loadTournamentRegistrations(tournamentRegCurrentPage);
                    } else {
                        Swal.fire('Lỗi', res ? res.message : 'Không thể xóa hồ sơ này.', 'error');
                    }
                }).fail(function () {
                    Swal.fire('Lỗi', 'Không thể kết nối đến máy chủ để xóa hồ sơ.', 'error');
                });
            });
        }

        function resetTournamentRegFilter() {
            $('#regKeywordFilter').val('');
            $('#regMonFilter').val('');
            $('#regDonViFilter').val('');
            loadTournamentRegistrations(1);
        }

        // ==================== TAB 6: BẢNG TỔNG SẮP & HUY CHƯƠNG (Chuẩn /BangXepHang) ====================
        let tournamentMedalsLoaded = false;
        let tournamentMedalList = [];
        let tournamentCategoryRankingsData = [];
        let tournamentSportRankingsData = [];
        let editMedalCurrentDanhMucId = 0;
        let editMedalSearchKeyword = '';
        let editMedalSportSearchKeyword = '';

        function loadTournamentMedals() {
            const giaiDauId = parseInt($('#giaiDauId').val()) || @Model.Id;
            tournamentMedalsLoaded = true;

            // Mặc định tạm thời ẩn chi tiết các môn nếu chưa chọn danh mục môn nào
            if (editMedalCurrentDanhMucId <= 0) {
                $('#tournamentSportDetailSection').addClass('d-none');
            }

            loadTournamentOverallRankings(giaiDauId);
            loadTournamentCategoryRankings(giaiDauId);
            loadTournamentSportRankings(giaiDauId);
        }

        function onEditMedalCategoryChange(val) {
            editMedalCurrentDanhMucId = val ? parseInt(val) : 0;
            updateEditMedalFilterBadge();
            const giaiDauId = parseInt($('#giaiDauId').val()) || @Model.Id;
            loadTournamentOverallRankings(giaiDauId);

            // Bảng danh mục môn: Luôn hiển thị đầy đủ tất cả danh mục, không ẩn môn nào
            updateEditMedalCategoryHeaderCount();
            renderTournamentCategoryRankings(tournamentCategoryRankingsData);

            // Chi tiết môn thi đấu: Chỉ hiện khi chọn xem theo danh mục, bình thường tạm thời ẩn đi
            const hasCategory = editMedalCurrentDanhMucId > 0;
            $('#tournamentSportDetailSection').toggleClass('d-none', !hasCategory);

            if (hasCategory) {
                const visibleSports = getVisibleTournamentSportRankings();
                renderTournamentSportRankings(visibleSports);

                const catText = $('#editMedalSelectCategory option:selected').text().replace('--', '').trim();
                $('#tournamentSportDetailTitle').text(catText ? `Chi tiết các môn · ${catText}` : 'Chi tiết các môn thi đấu');
            }
        }

        function updateEditMedalCategoryHeaderCount() {
            if (editMedalCurrentDanhMucId > 0) {
                const selCat = tournamentCategoryRankingsData.find(c => Number(c.danhMucId) === editMedalCurrentDanhMucId);
                const selName = selCat ? selCat.tenDanhMuc : '';
                $('#editMedalCategoryCountText').html(`Hiển thị <strong>${tournamentCategoryRankingsData.length}</strong> danh mục · Đang xem môn: <span class="badge bg-primary text-white">${escapeHtml(selName)}</span> <button type="button" class="btn btn-link btn-sm p-0 ms-1 text-danger text-decoration-none" onclick="clearEditMedalCategoryFilter()" title="Bỏ lọc danh mục (xem tất cả)"><i class="fa-solid fa-circle-xmark"></i></button>`);
            } else {
                $('#editMedalCategoryCountText').text(`${tournamentCategoryRankingsData.length} danh mục có phát sinh huy chương`);
            }
        }

        function updateEditMedalFilterBadge() {
            const catText = $('#editMedalSelectCategory option:selected').text().replace('--', '').trim();
            if (editMedalCurrentDanhMucId > 0 && catText) {
                $('#editMedalActiveFilterBadge').text(catText);
            } else {
                $('#editMedalActiveFilterBadge').text('Tất cả danh mục');
            }
        }

        function loadTournamentOverallRankings(giaiDauId) {
            $('#tblTournamentMedalBody').html(`
                <tr>
                    <td colspan="6" class="text-center py-5 text-muted">
                        <div class="spinner-border spinner-border-sm text-warning me-2" role="status"></div>
                        Đang nạp dữ liệu bảng tổng sắp huy chương...
                    </td>
                </tr>
            `);

            let url = `/Manager/HuyChuong/GetMedalRankings?giaiDauId=${giaiDauId}`;
            if (editMedalCurrentDanhMucId > 0) {
                url += `&danhMucId=${editMedalCurrentDanhMucId}`;
            }

            $.get(url, function (res) {
                if (res && res.success && res.data) {
                    const data = res.data;
                    const apiRankings = data.bangXepHang || [];

                    $('#statGoldTournament').text(data.tongSoHuyChuongVang ?? 0);
                    $('#statSilverTournament').text(data.tongSoHuyChuongBac ?? 0);
                    $('#statBronzeTournament').text(data.tongSoHuyChuongDong ?? 0);
                    $('#statTotalTournament').text(data.tongSoHuyChuongDaTrao ?? ((data.tongSoHuyChuongVang || 0) + (data.tongSoHuyChuongBac || 0) + (data.tongSoHuyChuongDong || 0)));

                    $('#tournamentUnitCountBadge').text(`${apiRankings.length} đơn vị`);
                    if (data.ngayXuatBaoCao) {
                        $('#tournamentMedalReportDate').text(`Thời điểm xuất: ${formatDateTimeDisplay(data.ngayXuatBaoCao)}`);
                    } else {
                        $('#tournamentMedalReportDate').text('Cập nhật mới nhất');
                    }

                    tournamentMedalList = apiRankings;
                    if (editMedalSearchKeyword) {
                        handleSearchTournamentMedal(editMedalSearchKeyword);
                    } else {
                        renderTournamentMedalTable(tournamentMedalList);
                    }
                } else {
                    showTournamentMedalEmpty();
                }
            }).fail(function () {
                $('#tblTournamentMedalBody').html('<tr><td colspan="6" class="text-center py-5 text-danger">Có lỗi khi tải bảng tổng sắp huy chương.</td></tr>');
            });
        }

        function renderTournamentMedalTable(list) {
            if (!list || list.length === 0) {
                $('#tblTournamentMedalBody').html(`
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-magnifying-glass fs-3 text-secondary mb-2 d-block opacity-50"></i>
                            Không tìm thấy đơn vị nào phù hợp với từ khóa tìm kiếm.
                        </td>
                    </tr>
                `);
                return;
            }

            let html = '';
            list.forEach((item, index) => {
                const rank = item.xepHang || (index + 1);
                const rankRowClass = rank === 1 ? 'rank-row-gold' : rank === 2 ? 'rank-row-silver' : rank === 3 ? 'rank-row-bronze' : '';
                let rankDisplay = '';

                if (rank === 1) {
                    rankDisplay = '<span class="badge rounded-circle p-2 bg-warning text-dark fs-6" title="Hạng 1 - Vô địch">🥇</span>';
                } else if (rank === 2) {
                    rankDisplay = '<span class="badge rounded-circle p-2 bg-secondary text-white fs-6" title="Hạng 2 - Á quân">🥈</span>';
                } else if (rank === 3) {
                    rankDisplay = '<span class="badge rounded-circle p-2 text-white fs-6" style="background:#b45309;" title="Hạng 3 - Hạng ba">🥉</span>';
                } else {
                    rankDisplay = `<span class="badge rounded-pill bg-light text-secondary border px-2.5 py-1 fw-bold">${rank}</span>`;
                }

                const initial = (item.tenDonVi || 'Đ').substring(0, 1).toUpperCase();

                html += `
                    <tr class="${rankRowClass}">
                        <td class="text-center">${rankDisplay}</td>
                        <td>
                            <div class="d-flex align-items-center gap-2.5">
                                <div class="unit-avatar-circle">${initial}</div>
                                <div>
                                    <div class="fw-bold text-dark" style="font-size: 0.95rem;">${escapeHtml(item.tenDonVi)}</div>
                                    ${item.maDonVi ? `<div class="text-muted small">${escapeHtml(item.maDonVi)}</div>` : ''}
                                </div>
                            </div>
                        </td>
                        <td class="text-center">
                            <span class="medal-badge-count medal-gold">${item.soHuyChuongVang}</span>
                        </td>
                        <td class="text-center">
                            <span class="medal-badge-count medal-silver">${item.soHuyChuongBac}</span>
                        </td>
                        <td class="text-center">
                            <span class="medal-badge-count medal-bronze">${item.soHuyChuongDong}</span>
                        </td>
                        <td class="text-center">
                            <span class="medal-badge-count medal-total fw-bold">${item.tongSoHuyChuong}</span>
                        </td>
                    </tr>
                `;
            });

            $('#tblTournamentMedalBody').html(html);
        }

        function showTournamentMedalEmpty() {
            $('#statGoldTournament, #statSilverTournament, #statBronzeTournament, #statTotalTournament').text('0');
            $('#tournamentUnitCountBadge').text('0 đơn vị');
            $('#tournamentMedalReportDate').text('Cập nhật mới nhất');
            $('#tblTournamentMedalBody').html(`
                <tr>
                    <td colspan="6" class="text-center py-5 text-muted">
                        <i class="fa-solid fa-award fa-3x mb-3 text-secondary opacity-50"></i>
                        <h6 class="fw-bold text-secondary">Chưa có dữ liệu huy chương</h6>
                        <p class="mb-0 small">Chưa có huy chương nào được trao. Bấm "Quét & Đồng Bộ Huy Chương" để tính kết quả từ các trận đã đấu.</p>
                    </td>
                </tr>
            `);
        }

        function handleSearchTournamentMedal(val) {
            editMedalSearchKeyword = (val || '').trim().toLowerCase();
            const filtered = tournamentMedalList.filter(item => {
                const name = (item.tenDonVi || '').toLowerCase();
                const code = (item.maDonVi || '').toLowerCase();
                return name.includes(editMedalSearchKeyword) || code.includes(editMedalSearchKeyword);
            });
            renderTournamentMedalTable(filtered);
        }

        function loadTournamentCategoryRankings(giaiDauId) {
            $('#tournamentCategoryRankingsContainer').html(`
                <div class="col-12 text-center py-5 text-muted">
                    <div class="spinner-border spinner-border-sm text-warning me-2" role="status"></div>
                    Đang nạp bảng xếp hạng theo từng danh mục môn thể thao...
                </div>
            `);

            $.get(`/Manager/HuyChuong/GetRankingsByDanhMuc?giaiDauId=${giaiDauId}`, function (res) {
                if (res && res.success) {
                    tournamentCategoryRankingsData = Array.isArray(res.data) ? res.data : [];

                    // Cập nhật dropdown chọn danh mục nếu chưa có
                    let catOpts = '<option value="">-- Tất cả danh mục môn --</option>';
                    tournamentCategoryRankingsData.forEach(c => {
                        const sel = editMedalCurrentDanhMucId === Number(c.danhMucId) ? 'selected' : '';
                        catOpts += `<option value="${c.danhMucId}" ${sel}>${escapeHtml(c.tenDanhMuc)}</option>`;
                    });
                    $('#editMedalSelectCategory').html(catOpts);

                    updateEditMedalCategoryHeaderCount();
                    renderTournamentCategoryRankings(tournamentCategoryRankingsData);
                } else {
                    $('#tournamentCategoryRankingsContainer').html(`
                        <div class="col-12 text-center py-5 text-muted">
                            <i class="fa-solid fa-folder-open fa-3x mb-3 text-secondary opacity-50"></i>
                            <h6 class="fw-bold text-secondary">Chưa có dữ liệu danh mục môn nào</h6>
                        </div>
                    `);
                }
            }).fail(function () {
                $('#tournamentCategoryRankingsContainer').html('<div class="col-12 text-center py-4 text-danger">Có lỗi khi tải bảng xếp hạng theo danh mục.</div>');
            });
        }

        function getVisibleTournamentCategoryRankings() {
            // Luôn hiển thị tất cả các danh mục môn, không ẩn danh mục nào khi chọn xem các môn
            return tournamentCategoryRankingsData;
        }

        function renderTournamentCategoryRankings(list) {
            const dataToRender = list || tournamentCategoryRankingsData;
            if (!dataToRender || dataToRender.length === 0) {
                $('#tournamentCategoryRankingsContainer').html(`
                    <div class="col-12 text-center py-5 text-muted">
                        <i class="fa-solid fa-folder-open fa-3x mb-3 text-secondary opacity-50"></i>
                        <h6 class="fw-bold text-secondary">Chưa có dữ liệu danh mục môn nào</h6>
                    </div>
                `);
                return;
            }

            let html = '';
            dataToRender.forEach(item => {
                const isSelected = editMedalCurrentDanhMucId > 0 && Number(item.danhMucId) === editMedalCurrentDanhMucId;
                const cardActiveCls = isSelected ? 'active-category-card' : '';
                const rankingList = item.bangXepHang || [];
                let rowsHtml = '';

                if (rankingList.length === 0) {
                    rowsHtml = `
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted small">
                                Chưa có đơn vị nào đạt huy chương trong danh mục này.
                            </td>
                        </tr>
                    `;
                } else {
                    rankingList.forEach((r, idx) => {
                        const rankNum = r.xepHang || (idx + 1);
                        let rankBadge = rankNum === 1 ? '🥇' : rankNum === 2 ? '🥈' : rankNum === 3 ? '🥉' : rankNum;
                        rowsHtml += `
                            <tr>
                                <td class="text-center fw-bold" style="width: 45px;">${rankBadge}</td>
                                <td>
                                    <div class="fw-bold text-dark text-truncate" style="max-width: 220px;" title="${escapeHtml(r.tenDonVi)}">${escapeHtml(r.tenDonVi)}</div>
                                    ${r.maDonVi ? `<div class="text-muted small" style="font-size:0.75rem;">${escapeHtml(r.maDonVi)}</div>` : ''}
                                </td>
                                <td class="text-center"><span class="badge bg-warning bg-opacity-10 text-dark fw-bold border border-warning-subtle">${r.soHuyChuongVang}</span></td>
                                <td class="text-center"><span class="badge bg-secondary bg-opacity-10 text-secondary fw-bold border">${r.soHuyChuongBac}</span></td>
                                <td class="text-center"><span class="badge text-white fw-bold" style="background:#c2410c;">${r.soHuyChuongDong}</span></td>
                                <td class="text-center fw-bold text-primary">${r.tongSoHuyChuong}</td>
                            </tr>
                        `;
                    });
                }

                html += `
                    <div class="col-lg-6">
                        <div class="sub-ranking-card ${cardActiveCls}">
                            <div class="sub-card-header d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="portal-logo-badge" style="width: 36px; height: 36px; font-size: 0.85rem; background: ${isSelected ? 'linear-gradient(135deg, #0284c7 0%, #0369a1 100%)' : 'linear-gradient(135deg, #475569 0%, #334155 100%)'};">
                                        <i class="fa-solid fa-folder-tree text-white"></i>
                                    </div>
                                    <div>
                                        <div class="d-flex align-items-center gap-1.5">
                                            <h6 class="fw-bold mb-0 text-dark">${escapeHtml(item.tenDanhMuc)}</h6>
                                            ${isSelected ? '<span class="badge bg-primary text-white" style="font-size:0.68rem;"><i class="fa-solid fa-check me-0.5"></i>Đang xem môn</span>' : ''}
                                        </div>
                                        <div class="text-muted small" style="font-size: 0.75rem;">${item.tongSoMon} môn thi đấu • Mã: ${escapeHtml(item.maDanhMuc)}</div>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    <span class="badge bg-warning text-dark" title="Huy chương vàng">🥇 ${item.tongHuyChuongVang}</span>
                                    <span class="badge bg-secondary text-white" title="Huy chương bạc">🥈 ${item.tongHuyChuongBac}</span>
                                    <span class="badge text-white" style="background:#b45309;" title="Huy chương đồng">🥉 ${item.tongHuyChuongDong}</span>
                                </div>
                            </div>
                            <div class="table-responsive flex-grow-1">
                                <table class="table table-sm table-hover align-middle mb-0" style="font-size: 0.85rem;">
                                    <thead class="table-light text-muted small">
                                        <tr>
                                            <th class="text-center">#</th>
                                            <th>Đơn vị</th>
                                            <th class="text-center text-warning">Vàng</th>
                                            <th class="text-center text-secondary">Bạc</th>
                                            <th class="text-center" style="color:#b45309;">Đồng</th>
                                            <th class="text-center text-primary">Tổng</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        ${rowsHtml}
                                    </tbody>
                                </table>
                            </div>
                            <div class="category-ranking-footer bg-light border-top d-flex justify-content-between align-items-center">
                                <span class="small text-muted" style="font-size:0.75rem;">Tổng số: ${item.tongHuyChuong} huy chương</span>
                                <div class="d-flex align-items-center gap-1">
                                    ${isSelected ? `
                                        <button type="button" class="btn btn-primary btn-sm rounded-pill ranking-footer-action active" aria-label="Đang xem môn thuộc danh mục này" title="Đang xem môn thuộc danh mục này. Nhấn để cuộn tới chi tiết môn" onclick="filterDirectToEditMedalCategory(${item.danhMucId})">
                                            <i class="fa-solid fa-check"></i>
                                            <span class="ranking-footer-action-label">Đang xem môn</span>
                                            <i class="fa-solid fa-arrow-down"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-2" title="Bỏ lọc danh mục (xem tất cả môn)" onclick="clearEditMedalCategoryFilter()">
                                            <i class="fa-solid fa-xmark"></i>
                                        </button>
                                    ` : `
                                        <button type="button" class="btn btn-outline-primary btn-sm rounded-pill ranking-footer-action" aria-label="Xem các môn thi đấu trong danh mục" title="Xem các môn thi đấu trong danh mục" onclick="filterDirectToEditMedalCategory(${item.danhMucId})">
                                            <span class="ranking-footer-action-label">Xem các môn</span>
                                            <i class="fa-solid fa-arrow-right"></i>
                                        </button>
                                    `}
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            });

            $('#tournamentCategoryRankingsContainer').html(html);
        }

        function filterDirectToEditMedalCategory(dmId) {
            $('#editMedalSelectCategory').val(dmId);
            onEditMedalCategoryChange(dmId);
            setTimeout(() => {
                document.getElementById('tournamentSportDetailSection')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }, 60);
        }

        function clearEditMedalCategoryFilter() {
            $('#editMedalSelectCategory').val('');
            onEditMedalCategoryChange('');
        }

        function loadTournamentSportRankings(giaiDauId) {
            $('#tournamentSportRankingsContainer').html(`
                <div class="col-12 text-center py-5 text-muted">
                    <div class="spinner-border spinner-border-sm text-primary me-2"></div>
                    Đang nạp bảng xếp hạng theo từng môn thi đấu...
                </div>
            `);

            let url = `/Manager/HuyChuong/GetRankingsByMonTheThao?giaiDauId=${giaiDauId}`;
            if (editMedalCurrentDanhMucId > 0) {
                url += `&danhMucId=${editMedalCurrentDanhMucId}`;
            }

            $.get(url, function (res) {
                if (res && res.success) {
                    tournamentSportRankingsData = Array.isArray(res.data) ? res.data : [];
                    if (editMedalCurrentDanhMucId > 0) {
                        const visibleRankings = getVisibleTournamentSportRankings();
                        renderTournamentSportRankings(visibleRankings);
                    }
                } else {
                    $('#tournamentSportRankingsContainer').html(`
                        <div class="col-12 text-center py-5 text-muted">
                            <i class="fa-solid fa-award fa-2x mb-2 text-secondary opacity-50"></i>
                            <div>Chưa có kết quả huy chương theo môn thi đấu nào.</div>
                            <small class="text-muted">Nhấn nút "Quét & Đồng Bộ Huy Chương" sau khi các trận đấu có kết quả.</small>
                        </div>
                    `);
                }
            }).fail(function () {
                $('#tournamentSportRankingsContainer').html('<div class="col-12 text-center py-4 text-danger">Có lỗi khi tải bảng xếp hạng theo môn thể thao.</div>');
            });
        }

        function handleTournamentSportFilterSearch(val) {
            editMedalSportSearchKeyword = (val || '').trim().toLowerCase();
            const visible = getVisibleTournamentSportRankings().filter(s => {
                const name = (s.tenMon || '').toLowerCase();
                const code = (s.maMon || '').toLowerCase();
                const cat = (s.tenDanhMuc || '').toLowerCase();
                return name.includes(editMedalSportSearchKeyword) || code.includes(editMedalSportSearchKeyword) || cat.includes(editMedalSportSearchKeyword);
            });
            renderTournamentSportRankings(visible);
        }

        function getVisibleTournamentSportRankings() {
            let visible = tournamentSportRankingsData;
            if (editMedalCurrentDanhMucId > 0) {
                visible = visible.filter(item => Number(item.danhMucId) === editMedalCurrentDanhMucId);
            }
            if (!editMedalSportSearchKeyword) return visible;

            return visible.filter(s => {
                const name = (s.tenMon || '').toLowerCase();
                const code = (s.maMon || '').toLowerCase();
                const cat = (s.tenDanhMuc || '').toLowerCase();
                return name.includes(editMedalSportSearchKeyword) || code.includes(editMedalSportSearchKeyword) || cat.includes(editMedalSportSearchKeyword);
            });
        }

        function renderTournamentSportRankings(list) {
            if (!list || list.length === 0) {
                $('#tournamentSportRankingsContainer').html(`
                    <div class="col-12 text-center py-5 text-muted">
                        <i class="fa-solid fa-magnifying-glass fs-2 text-secondary mb-2 d-block opacity-50"></i>
                        Không tìm thấy môn thi đấu nào phù hợp.
                    </div>
                `);
                return;
            }

            let html = '';
            list.forEach(item => {
                const isTeamSport = item.laMonDongDoi !== false;
                const resultList = item.ketQua || item.danhSachDatGiai || [];
                let rowsHtml = '';

                if (resultList.length === 0) {
                    rowsHtml = `
                        <tr>
                            <td colspan="4" class="text-center py-3 text-muted small">
                                Chưa có kết quả trao huy chương cho môn này.
                            </td>
                        </tr>
                    `;
                } else {
                    resultList.forEach((r, idx) => {
                        const rankNum = r.xepHang || (idx + 1);
                        const rankBadge = rankNum === 1 ? '🥇' : rankNum === 2 ? '🥈' : rankNum === 3 ? '🥉' : rankNum;
                        const name = isTeamSport ? (r.tenDoi || 'Đội') : (r.tenVanDongVien || 'VĐV');
                        const code = isTeamSport ? r.maDoi : r.maVanDongVien;
                        const medalClass = rankNum === 1 ? 'bg-warning text-dark' : rankNum === 2 ? 'bg-secondary text-white' : 'text-white';
                        const medalStyle = rankNum === 3 ? 'background:#b45309;' : '';
                        const detail = code ? `<div class="text-muted small" style="font-size:0.75rem;">${escapeHtml(code)}</div>` : '';
                        const medalName = r.tenLoaiHuyChuong || (rankNum === 1 ? 'Huy chương Vàng' : rankNum === 2 ? 'Huy chương Bạc' : 'Huy chương Đồng');

                        rowsHtml += `
                            <tr>
                                <td class="text-center fw-bold" style="width: 70px;">${rankBadge}</td>
                                <td>
                                    <div class="fw-bold text-dark text-truncate" style="max-width: 220px;" title="${escapeHtml(name)}">${escapeHtml(name)}</div>
                                    ${detail}
                                </td>
                                <td class="small text-muted">${escapeHtml(r.tenDonVi || '—')}</td>
                                <td class="text-center"><span class="badge ${medalClass}" style="${medalStyle}">${escapeHtml(medalName)}</span></td>
                            </tr>
                        `;
                    });
                }

                html += `
                    <div class="col-12 col-xl-6">
                        <div class="sport-detail-card">
                            <div class="sport-detail-card-header d-flex justify-content-between align-items-start gap-2">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="portal-logo-badge" style="width: 36px; height: 36px; font-size: 0.85rem; background: linear-gradient(135deg, #ea580c 0%, #c2410c 100%);">
                                        <i class="fa-solid fa-medal text-white"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-0 text-dark text-truncate" style="max-width: 200px;" title="${escapeHtml(item.tenMon)}">${escapeHtml(item.tenMon)}</h6>
                                        <span class="badge bg-light text-secondary border small py-0.5" style="font-size: 0.7rem;">${escapeHtml(item.tenDanhMuc || '')}</span>
                                        <span class="badge ${isTeamSport ? 'bg-primary-subtle text-primary' : 'bg-warning-subtle text-warning-emphasis'} sport-type-badge">${isTeamSport ? 'Đồng đội' : 'Cá nhân'}</span>
                                    </div>
                                </div>
                            </div>
                            <div class="table-responsive flex-grow-1">
                                <table class="table table-sm table-hover align-middle mb-0 sport-detail-table" style="font-size: 0.82rem;">
                                    <thead class="table-light text-muted small">
                                        <tr>
                                            <th class="text-center">Hạng</th>
                                            <th>${isTeamSport ? 'Đội đạt giải' : 'Vận động viên đạt giải'}</th>
                                            <th>Đơn vị</th>
                                            <th class="text-center">Huy chương</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        ${rowsHtml}
                                    </tbody>
                                </table>
                            </div>
                            <div class="p-2 bg-light border-top d-flex justify-content-between align-items-center">
                                <span class="small text-muted" style="font-size:0.75rem;">${item.tongHuyChuong || resultList.length} kết quả huy chương</span>
                                <button type="button" class="btn btn-outline-warning btn-sm rounded-pill py-0 px-2.5" style="font-size:0.75rem; border-color:#ea580c; color:#ea580c;" title="Lọc môn này" onclick="filterDirectToEditMedalSport(${item.monTheThaoId}, ${item.danhMucId})">
                                    <i class="fa-solid fa-filter me-1"></i> Lọc môn này
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            });

            $('#tournamentSportRankingsContainer').html(html);
        }

        function filterDirectToEditMedalSport(monId, dmId) {
            if (dmId) {
                $('#editMedalSelectCategory').val(dmId);
                editMedalCurrentDanhMucId = dmId;
                updateEditMedalFilterBadge();
            }
            const targetSport = tournamentSportRankingsData.find(s => s.monTheThaoId === monId);
            if (targetSport) {
                $('#tournamentSportSearchInput').val(targetSport.tenMon);
                handleTournamentSportFilterSearch(targetSport.tenMon);
            }
            document.getElementById('tournamentSportDetailSection')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        function syncTournamentMedals() {
            const giaiDauId = parseInt($('#giaiDauId').val()) || @Model.Id;

            Swal.fire({
                title: 'Đồng bộ kết quả huy chương?',
                html: 'Hệ thống sẽ tự động quét các bảng đấu và trận đấu đã hoàn thành của giải để tính toán và trao huy chương (Vàng, Bạc, Đồng) theo đúng thứ hạng thực tế.<br><br>Bạn có muốn thực hiện ngay không?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: '<i class="fa-solid fa-wand-magic-sparkles me-1"></i> Đồng bộ ngay',
                cancelButtonText: 'Hủy',
                confirmButtonColor: '#f59e0b',
                cancelButtonColor: '#6c757d'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: 'Đang quét và tính toán...',
                        allowOutsideClick: false,
                        didOpen: () => { Swal.showLoading(); }
                    });

                    $.post(`/Manager/HuyChuong/SyncMedalsFromResults?giaiDauId=${giaiDauId}`, function (res) {
                        Swal.close();
                        if (res && res.success) {
                            let detailHtml = res.message || 'Đã đồng bộ huy chương thành công!';
                            if (res.awarded && res.awarded.length > 0) {
                                detailHtml += '<div class="text-start mt-3 p-2 bg-light rounded" style="max-height: 200px; overflow-y: auto; font-size: 0.85rem;">' +
                                    res.awarded.map(a => `<div>${escapeHtml(a)}</div>`).join('') +
                                    '</div>';
                            }
                            Swal.fire('Thành công', detailHtml, 'success');
                            loadTournamentMedals();
                        } else {
                            Swal.fire('Thông báo', res ? res.message : 'Không có thay đổi nào.', 'info');
                        }
                    }).fail(function () {
                        Swal.close();
                        Swal.fire('Lỗi', 'Không thể kết nối đến máy chủ để đồng bộ huy chương.', 'error');
                    });
                }
            });
        }

        function formatDateDisplay(str, withTime = false) {
            if (!str) return '-';
            const d = new Date(str);
            if (isNaN(d.getTime())) return str;
            const day = String(d.getDate()).padStart(2, '0');
            const month = String(d.getMonth() + 1).padStart(2, '0');
            const year = d.getFullYear();
            if (withTime) {
                const h = String(d.getHours()).padStart(2, '0');
                const m = String(d.getMinutes()).padStart(2, '0');
                return `${day}/${month}/${year} ${h}:${m}`;
            }
            return `${day}/${month}/${year}`;
        }

        function formatDateTimeDisplay(dtStr) {
            return formatDateDisplay(dtStr, true);
        }

        function escapeHtml(text) {
            if (!text) return '';
            return $('<div>').text(text).html();
        }
    </script>
}
