@section Scripts {
    <!-- CKEditor 5 Classic -->
    <script src="https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/ckeditor.js"></script>

    <script>
        async function copyUnitRegistrationLink(button) {
            const registrationUrl = button?.dataset.registrationUrl;
            if (!registrationUrl) {
                Swal.fire('Không thể sao chép', 'Chưa tạo được link đăng ký cho giải đấu này.', 'error');
                return;
            }

            try {
                if (navigator.clipboard && window.isSecureContext) {
                    await navigator.clipboard.writeText(registrationUrl);
                } else {
                    const temporaryInput = document.createElement('textarea');
                    temporaryInput.value = registrationUrl;
                    temporaryInput.setAttribute('readonly', '');
                    temporaryInput.style.position = 'fixed';
                    temporaryInput.style.opacity = '0';
                    document.body.appendChild(temporaryInput);
                    temporaryInput.select();
                    const copied = document.execCommand('copy');
                    temporaryInput.remove();
                    if (!copied) throw new Error('Clipboard is unavailable');
                }

                const hostName = window.location.hostname.toLowerCase();
                const isLocalAddress = ['localhost', '127.0.0.1', '::1', '[::1]'].includes(hostName);
                SportApp.toast('success', isLocalAddress
                    ? 'Đã sao chép link. Lưu ý: địa chỉ localhost chỉ mở được trên máy này.'
                    : 'Đã sao chép link đăng ký giải đấu.');
            } catch {
                await Swal.fire({
                    icon: 'info',
                    title: 'Link đăng ký giải đấu',
                    text: 'Trình duyệt không cho phép sao chép tự động. Bạn hãy sao chép link bên dưới:',
                    input: 'text',
                    inputValue: registrationUrl,
                    inputAttributes: { readonly: true, 'aria-label': 'Link đăng ký giải đấu' },
                    confirmButtonText: 'Đóng'
                });
            }
        }

        let dieuLeIndex = @dieuLes.Count + 10;
        let moTaEditor = null;

        function switchToTab(tabId) {
            const tabEl = document.getElementById(tabId);
            if (tabEl) {
                bootstrap.Tab.getOrCreateInstance(tabEl).show();
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }
        }

        function switchToGeneralTab() {
            switchToTab('editGeneralTab');
        }

        function switchToSportsTab() {
            switchToTab('editSportsTab');
        }

        function switchToRulesTab() {
            switchToTab('editRulesTab');
        }

        function switchToPersonnelTab() {
            const tabBtn = document.getElementById('editPersonnelTab');
            if (tabBtn) {
                bootstrap.Tab.getOrCreateInstance(tabBtn).show();
                setTimeout(() => {
                    const sec = document.getElementById('sectionPhanCong');
                    if (sec) sec.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }, 150);
            }
        }

        function switchToRegistrationsTab() {
            switchToTab('editRegistrationsTab');
        }

        function switchToMedalsTab() {
            switchToTab('editMedalsTab');
        }

        $(document).ready(function () {
            // Khởi tạo CKEditor 5 cho Mô tả tóm tắt giải đấu
            const moTaEl = document.querySelector('#moTa');
            if (moTaEl) {
                ClassicEditor
                    .create(moTaEl, {
                        toolbar: [
                            'heading', '|',
                            'bold', 'italic', 'link', '|',
                            'bulletedList', 'numberedList', 'blockQuote', '|',
                            'insertTable', '|',
                            'undo', 'redo'
                        ],
                        placeholder: 'Giới thiệu mục đích, ý nghĩa, quy mô và đối tượng tham gia giải đấu...'
                    })
                    .then(editor => {
                        moTaEditor = editor;
                    })
                    .catch(error => {
                        console.error('Lỗi khởi tạo CKEditor cho mô tả:', error);
                    });
            }

            // Highlight visual on check/uncheck
            $('.chk-mon, .chk-khoi').on('change', function () {
                const parent = $(this).closest('.form-check');
                if ($(this).is(':checked')) {
                    parent.addClass('border-primary bg-primary-subtle');
                } else {
                    parent.removeClass('border-primary bg-primary-subtle');
                }

                if ($(this).hasClass('chk-mon') && $('.chk-mon:checked').length > 0) {
                    $('#sportSelectionError').addClass('d-none');
                }
                if ($(this).hasClass('chk-khoi') && $('.chk-khoi:checked').length > 0) {
                    $('#blockSelectionError').addClass('d-none');
                }
            });

            $('#phamVi').on('change', function () {
                if ($(this).val() !== 'TheoKhoi') $('#blockSelectionError').addClass('d-none');
            });

            // Chọn tất cả môn thi đấu
            $('#btnSelectAllMon').on('click', function () {
                $('.chk-mon').prop('checked', true).closest('.form-check').addClass('border-primary bg-primary-subtle');
                if ($('.chk-mon:checked').length > 0) $('#sportSelectionError').addClass('d-none');
            });

            $('#btnDeselectAllMon').on('click', function () {
                $('.chk-mon').prop('checked', false).closest('.form-check').removeClass('border-primary bg-primary-subtle');
            });

            // Tự động định dạng ngày trước tháng sau (dd/mm/yyyy) khi gõ
            $('.date-dmy-input').on('input', function () {
                let v = $(this).val().replace(/\D/g, '').slice(0, 8);
                if (v.length >= 5) {
                    $(this).val(`${v.slice(0, 2)}/${v.slice(2, 4)}/${v.slice(4)}`);
                } else if (v.length >= 3) {
                    $(this).val(`${v.slice(0, 2)}/${v.slice(2)}`);
                } else {
                    $(this).val(v);
                }

                if (v.length === 8) {
                    const d = v.slice(0, 2), m = v.slice(2, 4), y = v.slice(4);
                    $(this).closest('.input-group').find('.date-native-picker').val(`${y}-${m}-${d}`);
                }

                if ($('#ngayBatDau.is-invalid, #ngayKetThuc.is-invalid, #hanDangKy.is-invalid').length > 0) {
                    validateDateFields(true);
                }
            });

            // Đồng bộ ngày dd/mm/yyyy khi chọn từ popup lịch
            $('.date-native-picker').on('change', function () {
                const iso = $(this).val();
                if (iso) {
                    const parts = iso.split('-');
                    if (parts.length === 3) {
                        const dmy = `${parts[2]}/${parts[1]}/${parts[0]}`;
                        $(this).closest('.input-group').find('.date-dmy-input').val(dmy);
                    }
                }
                if ($('#ngayBatDau.is-invalid, #ngayKetThuc.is-invalid, #hanDangKy.is-invalid').length > 0) {
                    validateDateFields(true);
                }
            });

            $('#ten, #ma').on('input blur', function () {
                if ($(this).val().trim()) {
                    $(this).removeClass('is-invalid').addClass('is-valid');
                }
            });

            // Sự kiện khi chuyển tab
            $('button[data-bs-toggle="tab"]').on('shown.bs.tab', function (e) {
                const targetId = $(e.target).attr('id');
                if (targetId === 'editRegistrationsTab') {
                    if (!tournamentRegLoaded) {
                        loadTournamentRegistrations(1);
                    }
                } else if (targetId === 'editMedalsTab') {
                    if (!tournamentMedalsLoaded) {
                        loadTournamentMedals();
                    }
                }
            });

            // Tải trước danh sách đơn vị cho bộ lọc hồ sơ
            loadTournamentUnits();

            $('#regKeywordFilter').on('keypress', function (e) {
                if (e.which === 13) {
