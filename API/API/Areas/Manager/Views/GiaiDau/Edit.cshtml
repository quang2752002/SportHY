                            $viewBtn.attr('href', res.url);
                        } else {
                            $(`#${rowId} .input-group`).append(`<a href="${res.url}" target="_blank" class="btn btn-outline-info dl-view-btn" title="Xem tệp"><i class="fa-solid fa-eye"></i></a>`);
