        function loadTournamentRegistrations(page) {
            tournamentRegCurrentPage = page || 1;
            const giaiDauId = parseInt($('#giaiDauId').val()) || @Model.Id;
            const keyword = ($('#regKeywordFilter').val() || '').trim();
            const monId = $('#regMonFilter').val();
            const donViId = $('#regDonViFilter').val();

            $('#tblTournamentRegBody').html('<tr><td colspan="7" class="text-center py-5 text-muted"><div class="spinner-border spinner-border-sm text-primary me-2"></div>Đang tải danh sách hồ sơ...</td></tr>');

            $.ajax({
                url: '/Manager/DangKyThiDau/GetPagedData',
                type: 'GET',
                data: {
                    pageIndex: tournamentRegCurrentPage,
                    pageSize: tournamentRegPageSize,
                    keyword: keyword || undefined,
                    giaiDauId: giaiDauId,
                    monTheThaoId: monId ? parseInt(monId) : undefined,
                    donViId: donViId ? parseInt(donViId) : undefined
                },
                success: function (res) {
                    tournamentRegLoaded = true;
                    if (res && res.success && res.data) {
                        renderTournamentRegTable(res.data);
                    } else {
                        $('#tblTournamentRegBody').html('<tr><td colspan="7" class="text-center py-5 text-muted">Không có hồ sơ đăng ký nào.</td></tr>');
                        $('#tournamentRegPaginationInfo').text('Hiển thị 0 trên 0 hồ sơ');
                        $('#tournamentRegPaginationList').empty();
                    }
                },
                error: function () {
                    $('#tblTournamentRegBody').html('<tr><td colspan="7" class="text-center py-5 text-danger">Có lỗi khi tải danh sách hồ sơ đăng ký.</td></tr>');
                }
            });
        }

        function renderTournamentRegTable(data) {
            const items = data.items || [];
            if (items.length === 0) {
                $('#tblTournamentRegBody').html('<tr><td colspan="7" class="text-center py-5 text-muted">Không tìm thấy hồ sơ đăng ký nào phù hợp.</td></tr>');
                $('#tournamentRegPaginationInfo').text('Hiển thị 0 trên 0 hồ sơ');
                $('#tournamentRegPaginationList').empty();
                return;
            }

            let html = '';
            const start = (data.pageIndex - 1) * data.pageSize;

            $.each(items, function (i, item) {
                const stt = start + i + 1;
                const statusBadge = '<span class="badge bg-success-subtle text-success border"><i class="fa-solid fa-circle-check me-1"></i>Đã duyệt</span>';
                const regDate = formatDateDisplay(item.ngayDangKy);

                const actionButtons = `
                    <div class="btn-group btn-group-sm">
                        <button type="button" class="btn btn-outline-primary" title="Xem Chi Tiết & Danh Sách VĐV" onclick="openTournamentRegDetailsModal(${item.id})">
                            <i class="fa-solid fa-eye me-1"></i> Chi tiết
                        </button>
                        <button type="button" class="btn btn-light border" title="Xóa hồ sơ" onclick="deleteTournamentRegItem(${item.id}, '${escapeHtml(item.tenDangKy || item.tenDoi || '')}')">
                            <i class="fa-solid fa-trash text-danger"></i>
                        </button>
                    </div>
                `;

                html += `
                    <tr>
                        <td class="ps-3 fw-bold text-muted">${stt}</td>
                        <td>
                            <div class="fw-bold text-dark"><i class="fa-solid fa-users text-primary me-1"></i>${escapeHtml(item.tenDoi || item.tenDangKy || 'Đội thi đấu')}</div>
                            ${item.tenDoi && item.tenDangKy && item.tenDangKy !== item.tenDoi ? `<div class="small text-muted mb-1">${escapeHtml(item.tenDangKy)}</div>` : ''}
                            <small class="text-muted"><span class="badge bg-light text-secondary border font-monospace">Mã: ${escapeHtml(item.soDangKy || '-')}</span></small>
                        </td>
                        <td>
                            <span class="fw-semibold text-dark"><i class="fa-solid fa-building me-1 text-secondary"></i>${escapeHtml(item.tenDonVi || 'Vãng lai')}</span>
                        </td>
                        <td>
                            <div class="text-primary fw-semibold"><i class="fa-solid fa-volleyball me-1"></i>${escapeHtml(item.tenMonTheThao || 'Môn thi đấu')}</div>
                        </td>
                        <td><small class="text-muted">${regDate}</small></td>
                        <td>${statusBadge}</td>
                        <td class="text-end pe-3">${actionButtons}</td>
                    </tr>
                `;
            });

            $('#tblTournamentRegBody').html(html);

            const total = data.totalCount || 0;
            const from = total === 0 ? 0 : start + 1;
            const to = Math.min(start + data.pageSize, total);
            $('#tournamentRegPaginationInfo').text(`Hiển thị ${from} - ${to} trên tổng số ${total} hồ sơ`);

            renderTournamentRegPagination(data.pageIndex, data.totalPages);
        }

        function renderTournamentRegPagination(current, totalPages) {
            if (totalPages <= 1) {
                $('#tournamentRegPaginationList').empty();
                return;
            }

            let pagHtml = '';
            pagHtml += `<li class="page-item ${current === 1 ? 'disabled' : ''}">
                <a class="page-link" href="javascript:void(0)" onclick="loadTournamentRegistrations(${current - 1})">&laquo;</a>
            </li>`;

            for (let i = 1; i <= totalPages; i++) {
                if (i === 1 || i === totalPages || (i >= current - 2 && i <= current + 2)) {
                    pagHtml += `<li class="page-item ${i === current ? 'active' : ''}">
                        <a class="page-link" href="javascript:void(0)" onclick="loadTournamentRegistrations(${i})">${i}</a>
                    </li>`;
                }
            }

            pagHtml += `<li class="page-item ${current === totalPages ? 'disabled' : ''}">
                <a class="page-link" href="javascript:void(0)" onclick="loadTournamentRegistrations(${current + 1})">&raquo;</a>
            </li>`;

            $('#tournamentRegPaginationList').html(pagHtml);
        }

