@model GiaiDauDto
@{
    ViewData["Title"] = "Chỉnh sửa Giải Đấu - " + Model.Ten;
    var khois = ViewBag.Khois as IEnumerable<KhoiDto> ?? Enumerable.Empty<KhoiDto>();
    var monTheThaos = ViewBag.MonTheThaos as IEnumerable<MonTheThaoDto> ?? Enumerable.Empty<MonTheThaoDto>();
    var trongTais = ViewBag.TrongTais as IEnumerable<TrongTaiDto> ?? Enumerable.Empty<TrongTaiDto>();
    var sportCoordinatorUsers = ViewBag.SportCoordinatorUsers as List<SportCoordinatorUserOptionDto> ?? new();
    var secretaryAssignments = ViewBag.SecretaryAssignments as List<ThuKyPhanCongDto> ?? new();
    var categoryAssignments = ViewBag.CategoryAssignments as List<CategoryAssignmentViewModelDto> ?? new();
    var selectedMonIds = Model.MonTheThaoIds ?? new List<int>();
    var selectedKhoiIds = Model.KhoiIds ?? new List<int>();
    var dieuLes = Model.DieuLeGiaiDaus ?? new List<DieuLeGiaiDauDto>();
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1 text-dark">
            <i class="fa-solid fa-pen-to-square text-primary me-2"></i>Chỉnh Sửa Giải Đấu: @Model.Ten
        </h4>
        <p class="text-muted small mb-0">Cập nhật thông tin chi tiết giải, điều chỉnh các môn thi đấu và điều lệ tham dự.</p>
    </div>
    <div>
        <a href="/Manager/GiaiDau" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>
</div>

<form id="formEditGiaiDau" novalidate>
    <input type="hidden" id="giaiDauId" value="@Model.Id">

    <div class="row g-4">
        <!-- Cột trái: Thông tin chính & Môn thi đấu -->
        <div class="col-lg-8">
            <!-- 1. Thông tin cơ bản -->
            <div class="card card-custom mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="fa-solid fa-circle-info text-primary me-2"></i>1. Thông Tin Cơ Bản Giải Đấu
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">Tên giải đấu <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="ten" required value="@Model.Ten" placeholder="Ví dụ: Đại Hội Thể Thao Sinh Viên TP.HCM 2026">
                            <div class="invalid-feedback">Vui lòng nhập tên giải đấu.</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Mã giải đấu <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="ma" required value="@Model.Ma" placeholder="DH_TTH_2026">
                            <div class="invalid-feedback">Vui lòng nhập mã giải đấu.</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Địa điểm tổ chức</label>
                            <input type="text" class="form-control" id="diaDiem" value="@Model.DiaDiem" placeholder="Ví dụ: Cung Thể Thao Phú Thọ, TP.HCM">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Đường dẫn thân thiện (Slug)</label>
                            <input type="text" class="form-control" id="slug" value="@Model.Slug" placeholder="dai-hoi-the-thao-sinh-vien-2026">
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Ngày bắt đầu <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="ngayBatDau" required value="@Model.NgayBatDau.ToString("yyyy-MM-dd")">
                            <div class="invalid-feedback">Vui lòng chọn ngày bắt đầu.</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Ngày kết thúc <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="ngayKetThuc" required value="@Model.NgayKetThuc.ToString("yyyy-MM-dd")">
                            <div class="invalid-feedback">Vui lòng chọn ngày kết thúc (phải sau ngày bắt đầu).</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Hạn nộp hồ sơ đăng ký <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="hanDangKy" required value="@(Model.HanDangKy?.ToString("yyyy-MM-dd"))">
                            <div class="invalid-feedback">Vui lòng chọn hạn đăng ký (phải trước hoặc bằng ngày bắt đầu).</div>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Mô tả tóm tắt giải đấu</label>
                            <textarea class="form-control" id="moTa" rows="3" placeholder="Giới thiệu mục đích, ý nghĩa, quy mô và đối tượng tham gia...">@Model.MoTa</textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. Chọn Môn thi đấu tổ chức trong giải -->
            <div class="card card-custom mb-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="fw-bold text-dark mb-0">
                            <i class="fa-solid fa-volleyball text-success me-2"></i>2. Môn Thi Đấu Tổ Chức Trong Giải
                        </h6>
                        <small class="text-muted">Tích chọn các môn thi đấu áp dụng cho giải đấu này</small>
                    </div>
                    <div class="btn-group btn-group-sm">
                        <button type="button" class="btn btn-outline-primary" id="btnSelectAllMon">Chọn tất cả</button>
                        <button type="button" class="btn btn-outline-secondary" id="btnDeselectAllMon">Bỏ chọn</button>
                    </div>
                </div>
                <div class="card-body">
                    @if (!monTheThaos.Any())
                    {
                        <div class="text-center py-4 text-muted">
                            Chưa có danh mục môn thể thao nào trên hệ thống.
                        </div>
                    }
                    else
                    {
                        <div class="row g-2" id="listMonTheThao">
                            @foreach (var mon in monTheThaos)
                            {
                                var isChecked = selectedMonIds.Contains(mon.Id);
                                <div class="col-md-4 col-sm-6">
                                    <div class="form-check p-2 border rounded hover-shadow h-100 d-flex align-items-center bg-white @(isChecked ? "border-primary bg-primary-subtle" : "")">
                                        <input class="form-check-input chk-mon me-2 ms-1" type="checkbox" value="@mon.Id" id="mon_@mon.Id" @(isChecked ? "checked" : "")>
                                        <label class="form-check-label fw-semibold text-dark small w-100 cursor-pointer" for="mon_@mon.Id">
                                            <div>@mon.Ten</div>
                                            <div class="mt-1">
                                                @if (mon.LaMonDongDoi)
                                                {
                                                    <span class="badge bg-info-subtle text-info border" style="font-size: 0.68rem;">Đồng đội</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary border" style="font-size: 0.68rem;">Cá nhân</span>
                                                }
                                                @if (!string.IsNullOrEmpty(mon.TenDanhMuc))
                                                {
                                                    <span class="text-muted" style="font-size: 0.68rem;">• @mon.TenDanhMuc</span>
                                                }
                                            </div>
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- 3. Điều lệ giải đấu -->
            <div class="card card-custom mb-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="fa-solid fa-file-contract text-warning me-2"></i>3. Điều Lệ Giải Đấu
                    </h6>
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="addDieuLeRow()">
                        <i class="fa-solid fa-plus me-1"></i> Thêm mục điều lệ
                    </button>
                </div>
                <div class="card-body">
                    <div id="dieuLeContainer">
                        @for (int i = 0; i < dieuLes.Count; i++)
                        {
                            var dl = dieuLes[i];
                            var rowId = $"dieule_existing_{i + 1}";
                            <div class="border rounded p-3 mb-3 bg-light position-relative" id="@rowId">
                                <button type="button" class="btn btn-sm btn-outline-danger position-absolute top-0 end-0 m-2" onclick="$('#@rowId').remove()" title="Xóa mục này">
                                    <i class="fa-solid fa-xmark"></i>
                                </button>
                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <label class="form-label small fw-semibold">Tiêu đề điều lệ <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control form-control-sm dl-tieude" required value="@dl.TieuDe" placeholder="Ví dụ: Điều lệ thi đấu bóng đá">
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-semibold">Tệp đính kèm (PDF / Word)</label>
                                        <div class="input-group input-group-sm">
                                            <input type="text" class="form-control dl-file" value="@dl.TepDinhKem" placeholder="Chưa có tệp" readonly>
                                            <input type="file" class="d-none dl-file-input" onchange="uploadDieuLeFile(this, '@rowId')">
                                            <button type="button" class="btn btn-outline-secondary" onclick="$(this).siblings('.dl-file-input').click()">
                                                <i class="fa-solid fa-upload"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label small fw-semibold">Nội dung tóm tắt</label>
                                        <textarea class="form-control form-control-sm dl-mota" rows="2" placeholder="Tóm tắt nội dung quy định...">@dl.NoiDung</textarea>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- 4. Phân Công Nhân Sự Điều Hành Giải (Trưởng ban, Điều hành môn & Thư ký) -->
            <div class="card card-custom mb-4" id="sectionPhanCong">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="fw-bold text-dark mb-0">
                            <i class="fa-solid fa-users-gear text-primary me-2"></i>4. Phân Công Nhân Sự Điều Hành Giải
                        </h6>
                        <small class="text-muted">Phân công Trưởng ban trọng tài, Người điều hành từng môn và Thư ký trực tiếp cho giải đấu này</small>
                    </div>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill small fw-semibold">
                        @Model.Ten
                    </span>
                </div>
                <div class="card-body">
                    <!-- 4.1. Trưởng ban trọng tài -->
                    <div class="p-3 bg-light rounded-3 mb-4 border">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <label class="form-label fw-bold text-dark mb-0">
                                <i class="fa-solid fa-user-shield text-warning me-1"></i> Trưởng Ban Trọng Tài Giải Đấu
                            </label>
                            @if (Model.TruongBanTrongTaiId.HasValue)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1" id="badgeHeadRefStatus">
                                    <i class="fa-solid fa-check me-1"></i> Đã phân công
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2.5 py-1" id="badgeHeadRefStatus">
                                    <i class="fa-solid fa-clock me-1"></i> Chưa phân công
                                </span>
                            }
                        </div>
                        <p class="text-muted small mb-2">Trưởng ban chịu trách nhiệm phân bổ trọng tài, giám sát trùng lịch và phê duyệt biên bản thi đấu.</p>
                        <div class="input-group">
                            <select class="form-select" id="truongBanTrongTaiId">
                                <option value="">-- Chưa chỉ định / Hủy phân công --</option>
                                @foreach (var tt in trongTais)
                                {
                                    if (Model.TruongBanTrongTaiId == tt.Id)
                                    {
                                        <option value="@tt.Id" selected="selected">@tt.HoTen (@tt.Ma) - @tt.CapBac</option>
                                    }
                                    else
                                    {
                                        <option value="@tt.Id">@tt.HoTen (@tt.Ma) - @tt.CapBac</option>
                                    }
                                }
                            </select>
                            <button type="button" class="btn btn-outline-primary" onclick="quickSaveHeadReferee()" title="Lưu riêng Trưởng ban trọng tài">
                                <i class="fa-solid fa-floppy-disk me-1"></i> Lưu ngay
                            </button>
                        </div>
                    </div>

                    <!-- 4.2. Người điều hành theo danh mục môn -->
                    <div class="mb-4">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <div>
                                <h6 class="fw-bold text-dark mb-0">
                                    <i class="fa-solid fa-volleyball text-success me-1"></i> Người Điều Hành Môn (Theo Danh Mục Môn)
                                </h6>
                                <small class="text-muted">Chọn tài khoản Người điều hành môn phụ trách giám sát môn thi đấu</small>
                            </div>
                            <span class="badge bg-light text-secondary border">@categoryAssignments.Count danh mục</span>
                        </div>

                        @if (!categoryAssignments.Any())
                        {
                            <div class="text-center py-3 text-muted bg-light rounded-3 small">
                                Chưa có môn thi đấu nào trong giải. Hãy tích chọn môn ở mục 2 và lưu lại để hiển thị danh mục môn.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive border rounded">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light small">
                                        <tr>
                                            <th class="ps-3" style="width: 220px;">Danh Mục Môn</th>
                                            <th>Các Môn Trong Danh Mục</th>
                                            <th style="width: 290px;">Người Điều Hành Phụ Trách</th>
                                            <th class="text-end pe-3" style="width: 100px;">Thao Tác</th>
                                        </tr>
                                    </thead>
                                    <tbody style="font-size: 13px;">
                                        @foreach (var cat in categoryAssignments)
                                        {
                                            <tr>
                                                <td class="ps-3">
                                                    <div class="fw-bold text-dark">@cat.TenDanhMuc</div>
                                                    <small class="text-muted font-monospace">Mã: @cat.MaDanhMuc</small>
                                                </td>
                                                <td>
                                                    <div class="d-flex flex-wrap gap-1">
                                                        @foreach (var m in cat.DanhSachMon)
                                                        {
                                                            <span class="badge bg-light text-dark border" style="font-size: 0.72rem;">@m</span>
                                                        }
                                                    </div>
                                                </td>
                                                <td>
                                                    <select class="form-select form-select-sm sel-coordinator" data-danhmuc-id="@cat.DanhMucId" id="selectCoord_@cat.DanhMucId">
                                                        <option value="">-- Chưa gán người điều hành --</option>
                                                        @foreach (var coord in sportCoordinatorUsers)
                                                        {
                                                            if (cat.NguoiDieuHanhMonId == coord.Id)
                                                            {
                                                                <option value="@coord.Id" selected="selected">@coord.Ma - @coord.FullName (@coord.UserName)</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@coord.Id">@coord.Ma - @coord.FullName (@coord.UserName)</option>
                                                            }
                                                        }
                                                        @if (cat.NguoiDieuHanhMonId.HasValue && sportCoordinatorUsers.All(p => p.Id != cat.NguoiDieuHanhMonId.Value))
                                                        {
                                                            <option value="@cat.NguoiDieuHanhMonId" selected="selected" disabled>@(cat.TenNguoiDieuHanh ?? "Hồ sơ đã phân công")</option>
                                                        }
                                                    </select>
                                                </td>
                                                <td class="text-end pe-3">
                                                    <button type="button" class="btn btn-sm btn-outline-success" onclick="quickSaveCoordinator(@cat.DanhMucId, '@cat.TenDanhMuc')" title="Lưu người điều hành này">
                                                        <i class="fa-solid fa-check"></i> Lưu
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>

                    <!-- 4.3. Phân công thư ký giải đấu -->
                    <div>
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <div>
                                <h6 class="fw-bold text-dark mb-0">
                                    <i class="fa-solid fa-user-pen text-info me-1"></i> Phân Công Thư Ký Cho Giải Đấu
                                </h6>
                                <small class="text-muted">Chỉ các thư ký được tích chọn mới nhìn thấy và quản trị giải đấu này sau khi đăng nhập</small>
                            </div>
                            <span class="badge bg-light text-secondary border">
                                Đã chọn: <span id="selectedSecretaryCount" class="fw-bold text-primary">@secretaryAssignments.Count(s => s.DaPhanCong)</span> thư ký
                            </span>
                        </div>

                        @if (!secretaryAssignments.Any())
                        {
                            <div class="text-center py-3 text-muted bg-light rounded-3 small">
                                Chưa có hồ sơ thư ký hoạt động trong hệ thống.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive border rounded mb-2" style="max-height: 280px; overflow-y: auto;">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light small sticky-top">
                                        <tr>
                                            <th class="text-center ps-2" style="width: 50px;">
                                                <input type="checkbox" class="form-check-input" id="chkAllSecretaries" onchange="toggleSelectAllSecretaries(this)">
                                            </th>
                                            <th>Thư Ký</th>
                                            <th>Chức Vụ / Đơn Vị</th>
                                            <th>Liên Hệ</th>
                                            <th class="text-end pe-3">Trạng Thái</th>
                                        </tr>
                                    </thead>
                                    <tbody style="font-size: 13px;">
                                        @foreach (var s in secretaryAssignments)
                                        {
                                            <tr>
                                                <td class="text-center ps-2">
                                                    <input type="checkbox" class="form-check-input chk-secretary" value="@s.ThuKyId" @(s.DaPhanCong ? "checked" : "") onchange="updateSelectedSecretaryCount()">
                                                </td>
                                                <td>
                                                    <div class="fw-bold text-dark">@s.HoTen</div>
                                                    <small class="text-muted font-monospace">Mã: @s.Ma</small>
                                                </td>
                                                <td>
                                                    <div>@(s.ChucVu ?? "-")</div>
                                                    <small class="text-muted">@(s.DonViCongTac ?? "-")</small>
                                                </td>
                                                <td>
                                                    <div>@(s.SoDienThoai ?? "-")</div>
                                                    <small class="text-muted">@(s.Email ?? "-")</small>
                                                </td>
                                                <td class="text-end pe-3">
                                                    <span class="badge @(s.DaPhanCong ? "bg-success-subtle text-success" : "bg-light text-secondary")">
                                                        @(s.DaPhanCong ? "Đã phân công" : "Chưa phân công")
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="d-flex justify-content-end">
                                <button type="button" class="btn btn-sm btn-outline-info" onclick="quickSaveSecretaries()">
                                    <i class="fa-solid fa-floppy-disk me-1"></i> Lưu riêng danh sách thư ký
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Cột phải: Khối tham gia, Cấu hình & Banner -->
        <div class="col-lg-4">
            <!-- Trạng thái & Quy mô -->
            <div class="card card-custom mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="fa-solid fa-sliders text-info me-2"></i>Cấu Hình & Trạng Thái
                    </h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Trạng thái giải</label>
                        <select class="form-select" id="trangThai">
                            <option value="Nhap" selected="@(Model.TrangThai == TrangThaiGiaiDau.Nhap ? "selected" : null)">Bản nháp</option>
                            <option value="SapDienRa" selected="@(Model.TrangThai == TrangThaiGiaiDau.SapDienRa ? "selected" : null)">Sắp diễn ra</option>
                            <option value="DangDienRa" selected="@(Model.TrangThai == TrangThaiGiaiDau.DangDienRa ? "selected" : null)">Đang diễn ra</option>
                            <option value="KetThuc" selected="@(Model.TrangThai == TrangThaiGiaiDau.KetThuc ? "selected" : null)">Đã kết thúc</option>
                            <option value="Huy" selected="@(Model.TrangThai == TrangThaiGiaiDau.Huy ? "selected" : null)">Đã hủy</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Phạm vi tổ chức</label>
                        <select class="form-select" id="phamVi">
                            <option value="TatCa" selected="@(Model.PhamVi == PhamViGiaiDau.TatCa ? "selected" : null)">Tất cả đơn vị</option>
                            <option value="TheoKhoi" selected="@(Model.PhamVi == PhamViGiaiDau.TheoKhoi ? "selected" : null)">Theo khối ngành / đơn vị</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            <i class="fa-solid fa-users-gear text-primary me-1"></i>Phân công nhân sự
                        </label>
                        <a href="#sectionPhanCong" class="btn btn-sm btn-outline-primary w-100 text-start py-2">
                            <i class="fa-solid fa-arrow-down me-1"></i> Đến mục Phân công (Mục 4)
                        </a>
                        <div class="form-text small text-muted">Trưởng ban, Điều hành môn & Thư ký được thiết lập trực tiếp tại Mục 4 bên dưới.</div>
                    </div>
                </div>
            </div>

            <!-- Khối tham gia -->
            <div class="card card-custom mb-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="fa-solid fa-layer-group text-primary me-2"></i>Khối Tham Gia
                    </h6>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">Chọn các khối đơn vị được phép đăng ký tham dự giải:</p>
                    <div class="d-flex flex-column gap-2" id="listKhoi">
                        @foreach (var khoi in khois)
                        {
                            var isKhoiChecked = selectedKhoiIds.Contains(khoi.Id);
                            <div class="form-check p-2 border rounded hover-shadow @(isKhoiChecked ? "border-primary bg-primary-subtle" : "")">
                                <input class="form-check-input chk-khoi me-2 ms-1" type="checkbox" value="@khoi.Id" id="khoi_@khoi.Id" @(isKhoiChecked ? "checked" : "")>
                                <label class="form-check-label fw-semibold text-dark small cursor-pointer" for="khoi_@khoi.Id">
                                    @khoi.Ten
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Banner / Poster ảnh -->
            <div class="card card-custom mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="fa-solid fa-image text-danger me-2"></i>Hình Ảnh / Poster Giải
                    </h6>
                </div>
                <div class="card-body text-center">
                    <div class="mb-3">
                        <img id="bannerPreview" src="@(string.IsNullOrEmpty(Model.HinhAnh) ? "https://placehold.co/600x300?text=Chua+co+poster" : Model.HinhAnh)" 
                             class="img-fluid rounded border shadow-sm w-100" style="max-height: 180px; object-fit: cover;" alt="Banner Preview">
                    </div>
                    <input type="hidden" id="bannerUrl" value="@Model.HinhAnh">
                    <input type="file" id="fileBanner" class="d-none" accept="image/*" onchange="uploadBannerFile(this)">
                    <button type="button" class="btn btn-outline-primary w-100" onclick="$('#fileBanner').click()">
                        <i class="fa-solid fa-cloud-arrow-up me-1"></i> Thay đổi ảnh poster
                    </button>
                </div>
            </div>

            <!-- Nút Hành Động -->
            <div class="card card-custom border-primary">
                <div class="card-body p-3">
                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold mb-2" id="btnSubmit">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Lưu Cập Nhật Giải Đấu
                    </button>
                    <a href="/Manager/GiaiDau" class="btn btn-outline-secondary w-100">
                        Hủy bỏ
                    </a>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        let dieuLeIndex = @dieuLes.Count + 10;

        $(document).ready(function () {
            // Highlight visual on check/uncheck
            $('.chk-mon, .chk-khoi').on('change', function () {
                const parent = $(this).closest('.form-check');
                if ($(this).is(':checked')) {
                    parent.addClass('border-primary bg-primary-subtle');
                } else {
                    parent.removeClass('border-primary bg-primary-subtle');
                }
            });

            // Chọn tất cả môn thi đấu
            $('#btnSelectAllMon').on('click', function () {
                $('.chk-mon').prop('checked', true).closest('.form-check').addClass('border-primary bg-primary-subtle');
            });

            $('#btnDeselectAllMon').on('click', function () {
                $('.chk-mon').prop('checked', false).closest('.form-check').removeClass('border-primary bg-primary-subtle');
            });

            // Xử lý submit form
            $('#formEditGiaiDau').on('submit', function (e) {
                e.preventDefault();
                saveGiaiDau();
            });
        });

        function addDieuLeRow(title = '', desc = '', fileUrl = '') {
            dieuLeIndex++;
            const rowId = `dieule_${dieuLeIndex}`;
            const html = `
                <div class="border rounded p-3 mb-3 bg-light position-relative" id="${rowId}">
                    <button type="button" class="btn btn-sm btn-outline-danger position-absolute top-0 end-0 m-2" onclick="$('#${rowId}').remove()" title="Xóa mục này">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Tiêu đề điều lệ <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm dl-tieude" required value="${escapeHtml(title)}" placeholder="Ví dụ: Điều lệ thi đấu bóng đá">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Tệp đính kèm (PDF / Word)</label>
                            <div class="input-group input-group-sm">
                                <input type="text" class="form-control dl-file" value="${escapeHtml(fileUrl)}" placeholder="Chưa có tệp" readonly>
                                <input type="file" class="d-none dl-file-input" onchange="uploadDieuLeFile(this, '${rowId}')">
                                <button type="button" class="btn btn-outline-secondary" onclick="$(this).siblings('.dl-file-input').click()">
                                    <i class="fa-solid fa-upload"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Nội dung tóm tắt</label>
                            <textarea class="form-control form-control-sm dl-mota" rows="2" placeholder="Tóm tắt nội dung quy định...">${escapeHtml(desc)}</textarea>
                        </div>
                    </div>
                </div>
            `;
            $('#dieuLeContainer').append(html);
        }

        function uploadBannerFile(input) {
            if (!input.files || !input.files[0]) return;
            const file = input.files[0];
            const formData = new FormData();
            formData.append('file', file);

            SportApp.toast('info', 'Đang tải ảnh banner...');

            $.ajax({
                url: '/Manager/GiaiDau/UploadBanner',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (res) {
                    if (res.success) {
                        $('#bannerUrl').val(res.url);
                        $('#bannerPreview').attr('src', res.url);
                        SportApp.toast('success', 'Tải ảnh banner thành công!');
                    } else {
                        Swal.fire('Lỗi', res.message || 'Không thể tải ảnh.', 'error');
                    }
                }
            });
        }

        function uploadDieuLeFile(input, rowId) {
            if (!input.files || !input.files[0]) return;
            const file = input.files[0];
            const formData = new FormData();
            formData.append('file', file);

            SportApp.toast('info', 'Đang tải tệp điều lệ...');

            $.ajax({
                url: '/Manager/GiaiDau/UploadDieuLe',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (res) {
                    if (res.success) {
                        $(`#${rowId} .dl-file`).val(res.url);
                        SportApp.toast('success', 'Đã đính kèm tệp điều lệ!');
                    } else {
                        Swal.fire('Lỗi', res.message || 'Không thể tải tệp điều lệ.', 'error');
                    }
                }
            });
        }

        function saveGiaiDau() {
            const id = $('#giaiDauId').val();
            const ten = $('#ten').val().trim();
            const ma = $('#ma').val().trim();
            const ngayBatDau = $('#ngayBatDau').val();
            const ngayKetThuc = $('#ngayKetThuc').val();
            const hanDangKy = $('#hanDangKy').val();

            // Reset trạng thái validate cũ
            $('#ngayBatDau, #ngayKetThuc, #hanDangKy').removeClass('is-invalid is-valid');

            let valid = true;

            if (!ten || !ma) {
                Swal.fire('Thiếu thông tin', 'Vui lòng điền đầy đủ tên giải và mã giải.', 'warning');
                return;
            }

            if (!ngayBatDau) {
                $('#ngayBatDau').addClass('is-invalid');
                valid = false;
            } else {
                $('#ngayBatDau').addClass('is-valid');
            }

            if (!ngayKetThuc) {
                $('#ngayKetThuc').addClass('is-invalid');
                valid = false;
            } else if (ngayBatDau && ngayKetThuc <= ngayBatDau) {
                $('#ngayKetThuc').addClass('is-invalid').next('.invalid-feedback').text('Ngày kết thúc phải sau ngày bắt đầu.');
                valid = false;
            } else {
                $('#ngayKetThuc').addClass('is-valid');
            }

            if (!hanDangKy) {
                $('#hanDangKy').addClass('is-invalid');
                valid = false;
            } else if (ngayBatDau && hanDangKy > ngayBatDau) {
                $('#hanDangKy').addClass('is-invalid').next('.invalid-feedback').text('Hạn đăng ký phải trước hoặc bằng ngày bắt đầu.');
                valid = false;
            } else {
                $('#hanDangKy').addClass('is-valid');
            }

            if (!valid) {
                Swal.fire('Thông tin chưa hợp lệ', 'Vui lòng kiểm tra lại các trường ngày được đánh dấu đỏ.', 'warning');
                return;
            }

            // Thu thập danh sách Môn thể thao đã chọn
            const monTheThaoIds = [];
            $('.chk-mon:checked').each(function () {
                monTheThaoIds.push(parseInt($(this).val()));
            });

            // Thu thập danh sách Khối đã chọn
            const khoiIds = [];
            $('.chk-khoi:checked').each(function () {
                khoiIds.push(parseInt($(this).val()));
            });

            // Thu thập các mục Điều lệ
            const dieuLeGiaiDaus = [];
            $('#dieuLeContainer .border').each(function (idx) {
                const tieuDe = $(this).find('.dl-tieude').val().trim();
                if (tieuDe) {
                    dieuLeGiaiDaus.push({
                        tieuDe: tieuDe,
                        noiDung: $(this).find('.dl-mota').val().trim(),
                        tepDinhKem: $(this).find('.dl-file').val().trim(),
                        thuTu: idx + 1
                    });
                }
            });

            // Thu thập danh sách Thư ký được chọn
            const thuKyIds = [];
            $('.chk-secretary:checked').each(function () {
                thuKyIds.push(parseInt($(this).val()));
            });

            // Thu thập danh sách Người điều hành môn
            const dieuHanhMonAssignments = [];
            $('.sel-coordinator').each(function () {
                const dmId = parseInt($(this).data('danhmuc-id'));
                const coordVal = $(this).val();
                dieuHanhMonAssignments.push({
                    danhMucId: dmId,
                    nguoiDieuHanhMonId: coordVal ? parseInt(coordVal) : null
                });
            });

            const payload = {
                ten: ten,
                ma: ma,
                slug: $('#slug').val().trim() || null,
                diaDiem: $('#diaDiem').val().trim(),
                ngayBatDau: ngayBatDau,
                ngayKetThuc: ngayKetThuc,
                hanDangKy: $('#hanDangKy').val() || null,
                moTa: $('#moTa').val().trim(),
                trangThai: $('#trangThai').val(),
                phamVi: $('#phamVi').val() || 'TatCa',
                truongBanTrongTaiId: $('#truongBanTrongTaiId').val() ? parseInt($('#truongBanTrongTaiId').val()) : null,
                hinhAnh: $('#bannerUrl').val() || null,
                monTheThaoIds: monTheThaoIds,
                khoiIds: khoiIds,
                dieuLes: dieuLeGiaiDaus,
                thuKyIds: thuKyIds,
                dieuHanhMonAssignments: dieuHanhMonAssignments
            };

            $('#btnSubmit').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Đang lưu cập nhật...');

            $.ajax({
                url: `/Manager/GiaiDau/Save?id=${id}`,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    $('#btnSubmit').prop('disabled', false).html('<i class="fa-solid fa-floppy-disk me-1"></i> Lưu Cập Nhật Giải Đấu');
                    if (res.success) {
                        Swal.fire({
                            title: 'Thành công!',
                            text: 'Giải đấu đã được cập nhật thành công.',
                            icon: 'success',
                            confirmButtonText: 'Về danh sách giải'
                        }).then(() => {
                            window.location.href = '/Manager/GiaiDau';
                        });
                    } else {
                        Swal.fire('Lỗi', res.message || 'Không thể cập nhật giải đấu.', 'error');
                    }
                },
                error: function (xhr) {
                    $('#btnSubmit').prop('disabled', false).html('<i class="fa-solid fa-floppy-disk me-1"></i> Lưu Cập Nhật Giải Đấu');
                    Swal.fire('Lỗi', xhr.responseJSON?.message || 'Có lỗi xảy ra khi lưu dữ liệu.', 'error');
                }
            });
        }

        function quickSaveHeadReferee() {
            const refId = $('#truongBanTrongTaiId').val();
            const giaiDauId = parseInt($('#giaiDauId').val());
            $.post('/Manager/PhanCong/AssignHeadReferee', {
                giaiDauId: giaiDauId,
                trongTaiId: refId ? parseInt(refId) : null
            }, function (res) {
                if (res.success) {
                    SportApp.toast('success', res.message || 'Đã lưu Trưởng ban trọng tài!');
                    if (refId) {
                        $('#badgeHeadRefStatus').removeClass('bg-warning-subtle text-warning').addClass('bg-success-subtle text-success').html('<i class="fa-solid fa-check me-1"></i> Đã phân công');
                    } else {
                        $('#badgeHeadRefStatus').removeClass('bg-success-subtle text-success').addClass('bg-warning-subtle text-warning').html('<i class="fa-solid fa-clock me-1"></i> Chưa phân công');
                    }
                } else {
                    Swal.fire('Lỗi', res.message || 'Không thể lưu', 'error');
                }
            });
        }

        function quickSaveCoordinator(danhMucId, tenDanhMuc) {
            const coordId = $(`#selectCoord_${danhMucId}`).val();
            const giaiDauId = parseInt($('#giaiDauId').val());
            $.post('/Manager/PhanCong/AssignSportCoordinator', {
                giaiDauId: giaiDauId,
                danhMucId: danhMucId,
                nguoiDieuHanhMonId: coordId ? parseInt(coordId) : null
            }, function (res) {
                if (res.success) {
                    SportApp.toast('success', `Đã lưu điều hành cho môn: ${tenDanhMuc}!`);
                } else {
                    Swal.fire('Lỗi', res.message || 'Không thể lưu', 'error');
                }
            });
        }

        function quickSaveSecretaries() {
            const thuKyIds = [];
            $('.chk-secretary:checked').each(function () {
                thuKyIds.push(parseInt($(this).val()));
            });
            const giaiDauId = parseInt($('#giaiDauId').val());
            $.ajax({
                url: `/Manager/PhanCong/AssignSecretaries?giaiDauId=${giaiDauId}`,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(thuKyIds),
                success: function (res) {
                    if (res.success) {
                        SportApp.toast('success', res.message || 'Đã lưu danh sách thư ký giải!');
                    } else {
                        Swal.fire('Lỗi', res.message || 'Không thể lưu', 'error');
                    }
                }
            });
        }

        function updateSelectedSecretaryCount() {
            const count = $('.chk-secretary:checked').length;
            $('#selectedSecretaryCount').text(count);
        }

        function toggleSelectAllSecretaries(checkbox) {
            $('.chk-secretary').prop('checked', $(checkbox).is(':checked'));
            updateSelectedSecretaryCount();
        }

        function escapeHtml(text) {
            if (!text) return '';
            return $('<div>').text(text).html();
        }
    </script>
}
