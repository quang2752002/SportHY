        function loadTournamentUnits() {
            $.get('/Manager/DonVi/GetAll', function (res) {
                const donVis = (res && res.data) ? res.data : (Array.isArray(res) ? res : []);
                if (donVis.length > 0) {
                    let opts = '<option value="">-- Tất cả đơn vị / đoàn --</option>';
