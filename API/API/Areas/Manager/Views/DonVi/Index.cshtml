@using Dms.Application.DTOs
@{
    ViewData["Title"] = "Quản lý Đơn Vị / Đoàn Thể Thao";
    Layout = "~/Areas/Manager/Views/Shared/_ManagerLayout.cshtml";
    var khois = ViewBag.Khois as IEnumerable<KhoiDto> ?? Enumerable.Empty<KhoiDto>();
}

<div class="container-fluid p-0">
    <div class="card card-custom border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-body p-4">
            <!-- Header -->
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 pb-3 mb-4 border-bottom">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 bg-primary-subtle text-primary rounded-4">
                        <i class="fa-solid fa-building-columns fs-4"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-1 text-dark">Quản Lý Đơn Vị & Đoàn Thể Thao</h4>
                        <p class="text-muted small mb-0">Quản lý các cơ quan, đoàn vận động viên, trường học và câu lạc bộ trực thuộc các khối.</p>
                    </div>
                </div>
                <div>
                    <button type="button" class="btn btn-primary px-3 py-2 fw-semibold rounded-3 d-inline-flex align-items-center gap-2 shadow-sm" onclick="openCreateModal()">
                        <i class="fa-solid fa-plus"></i> Thêm Đơn Vị Mới
                    </button>
                </div>
            </div>

            <!-- Bộ lọc tìm kiếm -->
            <div class="p-3 bg-light rounded-3 mb-4 border">
                <div class="row g-2 align-items-center">
                    <div class="col-md-5">
                        <div class="input-group bg-white rounded-3 border overflow-hidden">
                            <span class="input-group-text bg-white border-0 text-muted ps-3">
                                <i class="fa-solid fa-magnifying-glass"></i>
                            </span>
                            <input type="text" id="keyword" class="form-control border-0 shadow-none ps-2" placeholder="Tìm theo tên đơn vị, mã đơn vị, người đại diện...">
                        </div>
                    </div>
                    <div class="col-md-4">
                        <select id="khoiFilter" class="form-select bg-white border rounded-3 shadow-none">
                            <option value="">-- Tất cả khối tham gia --</option>
                            @foreach (var k in khois)
                            {
                                <option value="@k.Id">@k.Ten</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 d-flex gap-1">
                        <button type="button" class="btn btn-dark flex-grow-1 rounded-3" onclick="loadData(1)">
                            <i class="fa-solid fa-filter me-1"></i> Lọc
                        </button>
                        <button type="button" class="btn btn-outline-secondary rounded-3" onclick="resetFilter()" title="Làm mới">
                            <i class="fa-solid fa-arrows-rotate"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Bảng dữ liệu Đơn vị -->
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="tblDonVi">
                    <thead class="table-light text-uppercase fs-7 text-muted">
                        <tr>
                            <th class="ps-3" style="width: 50px;">STT</th>
                            <th>Tên Đơn Vị / Đoàn</th>
                            <th>Khối Áp Dụng</th>
                            <th>Người Đại Diện</th>
                            <th>Liên Hệ</th>
                            <th>Lực Lượng VĐV</th>
                            <th>Trạng Thái</th>
                            <th class="text-end pe-3" style="width: 130px;">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody id="tblBody">
                        <tr><td colspan="8" class="text-center py-5 text-muted">Đang tải danh sách đơn vị...</td></tr>
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center py-3 mt-3 border-top">
                <div class="text-muted small" id="paginationInfo">Hiển thị 0 trên 0 đơn vị</div>
                <ul class="pagination pagination-sm mb-0" id="paginationList"></ul>
            </div>
        </div>
    </div>
</div>

<!-- Modal Thêm / Sửa Đơn vị -->
<div class="modal fade" id="modalDonVi" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-bottom px-4 py-3">
                <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2" id="modalTitle">
                    <i class="fa-solid fa-building-columns text-primary"></i>
                    <span>Thêm Đơn Vị / Đoàn Mới</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formDonVi">
                <input type="hidden" id="donViId" value="">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold small">Tên đơn vị / đoàn <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="ten" required placeholder="Ví dụ: Trường THPT Lê Hồng Phong">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">Mã đơn vị</label>
                            <input type="text" class="form-control" id="ma" placeholder="LHP-01">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Trực thuộc Khối <span class="text-danger">*</span></label>
                            <select id="khoiId" class="form-select" required>
                                <option value="">-- Chọn khối tham gia --</option>
                                @foreach (var k in khois)
                                {
                                    <option value="@k.Id">@k.Ten</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Loại hình đơn vị</label>
                            <input type="text" class="form-control" id="loaiDonVi" placeholder="Trường học, Doanh nghiệp, CLB...">
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">Người đại diện / Trưởng đoàn</label>
                            <input type="text" class="form-control" id="nguoiDaiDien" placeholder="Họ và tên...">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">Số điện thoại</label>
                            <input type="text" class="form-control" id="soDienThoai" placeholder="0912...">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">Email liên hệ</label>
                            <input type="email" class="form-control" id="email" placeholder="email@donvi.vn">
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold small">Địa chỉ cơ quan</label>
                            <input type="text" class="form-control" id="diaChi" placeholder="Số nhà, đường, quận/huyện...">
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold small">Ghi chú thêm</label>
                            <textarea class="form-control" id="moTa" rows="2" placeholder="Ghi chú về đơn vị..."></textarea>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" id="trangThai" checked>
                                <label class="form-check-label fw-semibold small" for="trangThai">Hoạt động (Cho phép lập hồ sơ thi đấu)</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top px-4 py-3 bg-light">
                    <button type="button" class="btn btn-secondary rounded-3 px-3" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary rounded-3 px-4" id="btnSave">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Lưu thông tin
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentPage = 1;
        const pageSize = 10;

        $(document).ready(function () {
            loadData(1);

            $('#keyword').on('keypress', function (e) {
                if (e.which === 13) loadData(1);
            });

            $('#khoiFilter').on('change', function () {
                loadData(1);
            });

            $('#formDonVi').on('submit', function (e) {
                e.preventDefault();
                saveData();
            });
        });

        function loadData(page) {
            currentPage = page;
            const keyword = $('#keyword').val().trim();
            const khoiId = $('#khoiFilter').val();

            $.ajax({
                url: '/Manager/DonVi/GetPagedData',
                type: 'GET',
                data: {
                    pageIndex: page,
                    pageSize: pageSize,
                    keyword: keyword || undefined,
                    khoiId: khoiId ? parseInt(khoiId) : undefined
                },
                success: function (res) {
                    if (res.success && res.data) {
                        renderTable(res.data);
                    }
                }
            });
        }

        function renderTable(data) {
            const items = data.items || [];
            if (items.length === 0) {
                $('#tblBody').html('<tr><td colspan="8" class="text-center py-5 text-muted">Chưa có đơn vị nào.</td></tr>');
                $('#paginationInfo').text('Hiển thị 0 trên 0 đơn vị');
                $('#paginationList').empty();
                return;
            }

            let html = '';
            const start = (data.pageIndex - 1) * data.pageSize;

            $.each(items, function (i, item) {
                const stt = start + i + 1;
                html += `
                    <tr>
                        <td class="ps-3 fw-bold text-muted">${stt}</td>
                        <td>
                            <div class="fw-bold text-dark">${escapeHtml(item.ten)}</div>
                            <small class="text-muted"><span class="badge bg-light text-secondary border font-monospace">Mã: ${escapeHtml(item.ma)}</span></small>
                        </td>
                        <td>
                            <span class="badge bg-info-subtle text-info border">
                                <i class="fa-solid fa-layer-group me-1"></i>${escapeHtml(item.tenKhoi || 'Khác')}
                            </span>
                        </td>
                        <td>
                            <div class="fw-semibold text-dark">${escapeHtml(item.nguoiDaiDien || '-')}</div>
                            <small class="text-muted">${escapeHtml(item.loaiDonVi || '-')}</small>
                        </td>
                        <td>
                            <div><i class="fa-solid fa-phone me-1 text-muted"></i><small>${escapeHtml(item.soDienThoai || '-')}</small></div>
                            ${item.email ? `<div><i class="fa-solid fa-envelope me-1 text-muted"></i><small class="text-muted">${escapeHtml(item.email)}</small></div>` : ''}
                        </td>
                        <td>
                            <span class="badge bg-primary-subtle text-primary border p-2">
                                <i class="fa-solid fa-person-running me-1"></i>${item.soVdv || 0} VĐV
                            </span>
                        </td>
                        <td>
                            <span class="badge ${item.trangThai ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-danger-subtle text-danger border border-danger-subtle'} px-2.5 py-1 rounded-pill">
                                ${item.trangThai ? 'Hoạt động' : 'Tạm dừng'}
                            </span>
                        </td>
                        <td class="text-end pe-3">
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-light border" title="Sửa" onclick="openEditModal(${item.id})">
                                    <i class="fa-solid fa-pen-to-square text-success"></i>
                                </button>
                                <button type="button" class="btn btn-light border" title="Xóa" onclick="deleteItem(${item.id}, '${escapeHtml(item.ten)}')">
                                    <i class="fa-solid fa-trash text-danger"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            });

            $('#tblBody').html(html);

            const total = data.totalCount || 0;
            const from = total === 0 ? 0 : start + 1;
            const to = Math.min(start + data.pageSize, total);
            $('#paginationInfo').text(`Hiển thị ${from} - ${to} trên tổng số ${total} đơn vị`);

            renderPagination(data.pageIndex, data.totalPages);
        }

        function renderPagination(current, totalPages) {
            if (totalPages <= 1) {
                $('#paginationList').empty();
                return;
            }

            let pagHtml = '';
            pagHtml += `<li class="page-item ${current === 1 ? 'disabled' : ''}">
                <a class="page-link" href="javascript:void(0)" onclick="loadData(${current - 1})">&laquo;</a>
            </li>`;

            for (let i = 1; i <= totalPages; i++) {
                if (i === 1 || i === totalPages || (i >= current - 2 && i <= current + 2)) {
                    pagHtml += `<li class="page-item ${i === current ? 'active' : ''}">
                        <a class="page-link" href="javascript:void(0)" onclick="loadData(${i})">${i}</a>
                    </li>`;
                }
            }

            pagHtml += `<li class="page-item ${current === totalPages ? 'disabled' : ''}">
                <a class="page-link" href="javascript:void(0)" onclick="loadData(${current + 1})">&raquo;</a>
            </li>`;

            $('#paginationList').html(pagHtml);
        }

        function openCreateModal() {
            $('#modalTitle span').text('Thêm Đơn Vị / Đoàn Mới');
            $('#donViId').val('');
            $('#ten').val('');
            $('#ma').val('');
            $('#khoiId').val('');
            $('#loaiDonVi').val('');
            $('#nguoiDaiDien').val('');
            $('#soDienThoai').val('');
            $('#email').val('');
            $('#diaChi').val('');
            $('#moTa').val('');
            $('#trangThai').prop('checked', true);
            $('#modalDonVi').modal('show');
        }

        function openEditModal(id) {
            $.get('/Manager/DonVi/GetById', { id: id }, function (res) {
                if (res.success && res.data) {
                    const item = res.data;
                    $('#modalTitle span').text('Chỉnh Sửa Đơn Vị / Đoàn');
                    $('#donViId').val(item.id);
                    $('#ten').val(item.ten);
                    $('#ma').val(item.ma || '');
                    $('#khoiId').val(item.khoiId || '');
                    $('#loaiDonVi').val(item.loaiDonVi || '');
                    $('#nguoiDaiDien').val(item.nguoiDaiDien || '');
                    $('#soDienThoai').val(item.soDienThoai || '');
                    $('#email').val(item.email || '');
                    $('#diaChi').val(item.diaChi || '');
                    $('#moTa').val(item.moTa || '');
                    $('#trangThai').prop('checked', item.trangThai);
                    $('#modalDonVi').modal('show');
                }
            });
        }

        function saveData() {
            const id = $('#donViId').val();
            const ten = $('#ten').val().trim();
            const khoiId = $('#khoiId').val();

            if (!ten || !khoiId) {
                Swal.fire('Lỗi', 'Vui lòng nhập tên đơn vị và chọn khối trực thuộc.', 'warning');
                return;
            }

            const payload = {
                ten: ten,
                ma: $('#ma').val().trim() || 'DV-' + Date.now().toString().slice(-6),
                khoiId: parseInt(khoiId),
                loaiDonVi: $('#loaiDonVi').val().trim() || null,
                nguoiDaiDien: $('#nguoiDaiDien').val().trim() || null,
                soDienThoai: $('#soDienThoai').val().trim() || null,
                email: $('#email').val().trim() || null,
                diaChi: $('#diaChi').val().trim() || null,
                moTa: $('#moTa').val().trim() || null,
                trangThai: $('#trangThai').is(':checked')
            };

            const url = id ? `/Manager/DonVi/Save?id=${id}` : '/Manager/DonVi/Save';

            $.ajax({
                url: url,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    if (res.success) {
                        $('#modalDonVi').modal('hide');
                        SportApp.toast('success', res.message || 'Lưu đơn vị thành công!');
                        loadData(currentPage);
                    } else {
                        Swal.fire('Lỗi', res.message || 'Không thể lưu đơn vị.', 'error');
                    }
                }
            });
        }

        function deleteItem(id, name) {
            SportApp.confirm('Xóa Đơn Vị?', `Bạn có chắc muốn xóa đoàn/đơn vị "${name}" không?`, function () {
                $.post('/Manager/DonVi/Delete', { id: id }, function (res) {
                    if (res.success) {
                        SportApp.toast('success', res.message || 'Đã xóa đơn vị!');
                        loadData(currentPage);
                    } else {
                        Swal.fire('Lỗi', res.message || 'Không thể xóa.', 'error');
                    }
                });
            });
        }

        function resetFilter() {
            $('#keyword').val('');
            $('#khoiFilter').val('');
            loadData(1);
        }

        function escapeHtml(text) {
            if (!text) return '';
            return $('<div>').text(text).html();
        }
    </script>
}
