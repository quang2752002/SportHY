                                    <input type="checkbox" id="comb_coPenalty" checked>
                                    <span class="fmt-slider green"></span>
                                </label>
                            </div>
                        </div>

                        <!-- SECTION 3: Tiebreaker for Group Stage -->
                        <div class="fmt-section">
                            <div class="fmt-section-hdr">
                                <div class="fmt-ico-circle fmt-ico-orange"><i class="fa-solid fa-list-ol"></i></div>
                                <div>
                                    <h6 class="fw-bold mb-0" style="color:#111827">3. Tiêu Chí Xét Duyệt Nếu Bằng Điểm Ở Vòng Bảng</h6>
                                    <p class="mb-0 mt-1" style="font-size:12px;color:#9ca3af">Khi các đội có cùng số điểm trong cùng một bảng đấu, thứ hạng sẽ được phân định theo thứ tự ưu tiên bên dưới.</p>
                                </div>
                            </div>
                            <div id="comb_criteriaList">
                                <div class="fmt-criteria-row" data-criteria-id="DiemDoiDauTrucTiep">
                                    <input type="checkbox" class="fmt-criteria-cb orange" checked>
                                    <span class="fmt-num-badge orange">#1</span>
                                    <div class="flex-grow-1"><div class="fmt-criteria-title">Điểm đối đầu trực tiếp</div><div class="fmt-criteria-desc">Tổng số điểm đối đầu giữa các đội bằng điểm trong bảng</div></div>
                                    <div class="d-flex gap-1"><button type="button" class="fmt-arr-btn" onclick="moveCriteria('comb_criteriaList',this,-1)"><i class="fa-solid fa-chevron-up"></i></button><button type="button" class="fmt-arr-btn" onclick="moveCriteria('comb_criteriaList',this,1)"><i class="fa-solid fa-chevron-down"></i></button></div>
                                </div>
                                <div class="fmt-criteria-row" data-criteria-id="HieuSoDoiDauTrongBang">
                                    <input type="checkbox" class="fmt-criteria-cb orange" checked>
                                    <span class="fmt-num-badge orange">#2</span>
                                    <div class="flex-grow-1"><div class="fmt-criteria-title">Hiệu số đối đầu trong bảng</div><div class="fmt-criteria-desc">Hiệu số bàn thắng/bại trong các trận gặp nhau trực tiếp</div></div>
                                    <div class="d-flex gap-1"><button type="button" class="fmt-arr-btn" onclick="moveCriteria('comb_criteriaList',this,-1)"><i class="fa-solid fa-chevron-up"></i></button><button type="button" class="fmt-arr-btn" onclick="moveCriteria('comb_criteriaList',this,1)"><i class="fa-solid fa-chevron-down"></i></button></div>
                                </div>
                                <div class="fmt-criteria-row" data-criteria-id="HieuSoToanBang">
                                    <input type="checkbox" class="fmt-criteria-cb orange" checked>
                                    <span class="fmt-num-badge orange">#3</span>
                                    <div class="flex-grow-1"><div class="fmt-criteria-title">Hiệu số toàn bảng đấu</div><div class="fmt-criteria-desc">Hiệu số bàn thắng/bại của tất cả các trận trong bảng</div></div>
                                    <div class="d-flex gap-1"><button type="button" class="fmt-arr-btn" onclick="moveCriteria('comb_criteriaList',this,-1)"><i class="fa-solid fa-chevron-up"></i></button><button type="button" class="fmt-arr-btn" onclick="moveCriteria('comb_criteriaList',this,1)"><i class="fa-solid fa-chevron-down"></i></button></div>
                                </div>
                                <div class="fmt-criteria-row" data-criteria-id="TongBanThang">
                                    <input type="checkbox" class="fmt-criteria-cb orange" checked>
                                    <span class="fmt-num-badge orange">#4</span>
                                    <div class="flex-grow-1"><div class="fmt-criteria-title">Tổng số bàn thắng ghi được</div><div class="fmt-criteria-desc">Đội ghi được nhiều bàn thắng hơn trong toàn bảng</div></div>
                                    <div class="d-flex gap-1"><button type="button" class="fmt-arr-btn" onclick="moveCriteria('comb_criteriaList',this,-1)"><i class="fa-solid fa-chevron-up"></i></button><button type="button" class="fmt-arr-btn" onclick="moveCriteria('comb_criteriaList',this,1)"><i class="fa-solid fa-chevron-down"></i></button></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ====== TAB 4: TÍNH GIỜ / THÀNH TÍCH (giữ lại, làm sau) ====== -->
                    <div id="mechTinhDiem" class="format-mechanism-panel d-none">
                        <div class="fmt-section">
                            <div class="d-flex flex-column align-items-center justify-content-center py-5 text-center gap-3">
                                <div class="d-flex align-items-center justify-content-center rounded-circle" style="width:64px;height:64px;background:#fffbeb">
                                    <i class="fa-solid fa-stopwatch fs-3" style="color:#eab308"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold" style="color:#111827">Tab Tính Giờ / Thành Tích</h6>
                                    <p class="text-muted small mb-0">Tính năng đang được phát triển và sẽ được cập nhật sớm.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                </div><!-- end scrollable area -->

                <!-- ── FOOTER (sticky) ── -->
                <div class="d-flex align-items-center justify-content-between px-4 py-3 bg-white" style="border-top:1px solid #e5e7eb;flex-shrink:0">
                    <div class="small" style="color:#4f46e5">
                        <i class="fa-solid fa-circle-info me-1"></i>
                        Cấu hình sẽ được lưu và cập nhật trực tiếp vào bản điều lệ của giải.
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary rounded-3 px-4 fw-semibold" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn rounded-3 px-4 fw-bold" id="btnSaveTheThuc" style="background:#4f46e5;color:#fff;border:none">
                            <i class="fa-solid fa-check me-1"></i> Lưu Cấu Hình
                        </button>
                    </div>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentPage = 1;
        const pageSize = 10;

        $(document).ready(function () {
            loadData(1);

            $('#keyword').on('keypress', function (e) {
                if (e.which === 13) loadData(1);
            });

            $('#danhMucFilter, #gioiTinhFilter, #hinhThucFilter, #quyMoFilter').on('change', function () {
                loadData(1);
            });

            $('#formMon').on('submit', function (e) {
                e.preventDefault();
                saveData();
            });

            // Gợi ý thông minh khi gõ tên môn thể thao mới
            $('#ten').on('input', function () {
                if ($('#monId').val()) return; // Chỉ áp dụng khi thêm mới
                const val = $(this).val().toLowerCase().trim();
                if (!val) return;

                if (val.includes('bóng đá') || val.includes('futsal')) {
                    $('#loaiThiDau').val('DongDoi');
                    $('#hinhThucThiDau').val('KetHopVongBangVaLoaiTrucTiep');
                    $('#soLuongVdvToiThieu').val(7);
                    $('#soLuongVdvToiDa').val(14);
                } else if (val.includes('bóng chuyền')) {
                    $('#loaiThiDau').val('DongDoi');
                    $('#hinhThucThiDau').val('KetHopVongBangVaLoaiTrucTiep');
                    $('#soLuongVdvToiThieu').val(6);
                    $('#soLuongVdvToiDa').val(12);
                } else if (val.includes('bóng rổ')) {
                    $('#loaiThiDau').val('DongDoi');
                    $('#hinhThucThiDau').val('LoaiTrucTiep');
                    $('#soLuongVdvToiThieu').val(3);
                    $('#soLuongVdvToiDa').val(5);
                } else if (val.includes('cầu lông')) {
                    $('#loaiThiDau').val('CaNhan');
                    $('#hinhThucThiDau').val('LoaiTrucTiep');
                    $('#soLuongVdvToiThieu').val(1);
                    $('#soLuongVdvToiDa').val(2);
                } else if (val.includes('bóng bàn')) {
                    $('#loaiThiDau').val('CaNhan');
                    $('#hinhThucThiDau').val('VongBang');
                    $('#soLuongVdvToiThieu').val(1);
                    $('#soLuongVdvToiDa').val(2);
                } else if (val.includes('tennis') || val.includes('quần vợt') || val.includes('pickleball')) {
                    $('#loaiThiDau').val('CaNhan');
                    $('#hinhThucThiDau').val('LoaiTrucTiep');
                    $('#soLuongVdvToiThieu').val(1);
                    $('#soLuongVdvToiDa').val(2);
                } else if (val.includes('chạy') || val.includes('điền kinh') || val.includes('bơi')) {
                    $('#loaiThiDau').val('CaNhan');
                    $('#hinhThucThiDau').val('TinhDiemXepHang');
                    $('#soLuongVdvToiThieu').val(1);
                    $('#soLuongVdvToiDa').val(1);
                } else if (val.includes('cờ vua') || val.includes('cờ tướng')) {
                    $('#loaiThiDau').val('CaNhan');
                    $('#hinhThucThiDau').val('HeThuySi');
                    $('#soLuongVdvToiThieu').val(1);
                    $('#soLuongVdvToiDa').val(1);
                }
            });
        });

        function loadData(page) {
            currentPage = page;
            const keyword = $('#keyword').val().trim();
            const danhMucId = $('#danhMucFilter').val();
            const gioiTinh = $('#gioiTinhFilter').val();
            const hinhThucThiDau = $('#hinhThucFilter').val();
            const loaiThiDau = $('#quyMoFilter').val();

            $.ajax({
                url: '/Manager/MonTheThao/GetPagedData',
                type: 'GET',
                data: {
                    pageIndex: page,
                    pageSize: pageSize,
                    keyword: keyword || undefined,
                    danhMucId: danhMucId ? parseInt(danhMucId) : undefined,
                    gioiTinh: gioiTinh || undefined,
                    hinhThucThiDau: hinhThucThiDau || undefined,
                    loaiThiDau: loaiThiDau || undefined
                },
                success: function (res) {
                    if (res.success && res.data) {
                        renderTable(res.data);
                    }
                }
            });
        }

        function renderTable(data) {
            const items = data.items || [];
            if (items.length === 0) {
                $('#tblBody').html('<tr><td colspan="9" class="text-center py-5 text-muted">Chưa có môn thể thao nào.</td></tr>');
                $('#paginationInfo').text('Hiển thị 0 trên 0 môn thể thao');
                $('#paginationList').empty();
                return;
            }

            let html = '';
            const start = (data.pageIndex - 1) * data.pageSize;

            $.each(items, function (i, item) {
                const stt = start + i + 1;
                const loaiVal = item.loaiThiDau || (item.laMonDongDoi ? 'DongDoi' : 'CaNhan');
                let loaiBadge = '<span class="badge bg-primary-subtle text-primary border fw-semibold"><i class="fa-solid fa-users me-1"></i>Đồng đội</span>';
                if (loaiVal === 'CaNhan') {
                    loaiBadge = '<span class="badge bg-info-subtle text-info border fw-semibold"><i class="fa-solid fa-user me-1"></i>Cá nhân</span>';
                }

                // Sơ đồ / Hình thức thi đấu badge
                let hinhThucBadge = '';
                switch (item.hinhThucThiDau) {
                    case 'LoaiTrucTiep':
                        hinhThucBadge = '<span class="badge bg-danger-subtle text-danger border fw-semibold"><i class="fa-solid fa-sitemap me-1"></i>Loại trực tiếp</span>';
                        break;
                    case 'VongBang':
                        hinhThucBadge = '<span class="badge bg-success-subtle text-success border fw-semibold"><i class="fa-solid fa-table-cells me-1"></i>Vòng tròn</span>';
                        break;
                    case 'KetHopVongBangVaLoaiTrucTiep':
                        hinhThucBadge = '<span class="badge bg-primary-subtle text-primary border fw-semibold"><i class="fa-solid fa-diagram-project me-1"></i>Bảng + Knockout</span>';
                        break;                    
                    case 'TinhDiemXepHang':
                        hinhThucBadge = '<span class="badge bg-info-subtle text-info border fw-semibold"><i class="fa-solid fa-stopwatch me-1"></i>Đo thành tích</span>';
                        break;
                    default:
                        hinhThucBadge = `<span class="badge bg-secondary-subtle text-secondary border fw-semibold">${escapeHtml(item.hinhThucThiDau || 'Mặc định')}</span>`;
                        break;
                }

                const gt = item.gioiTinh === 'Nu' ? 'Nữ' : (item.gioiTinh === 'HonHop' ? 'Hỗn hợp' : 'Nam');

                // Lấy số VĐV chính xác
                const vdvMin = item.soLuongVanDongVienToiThieu ?? item.soLuongVdvToiThieu;
                const vdvMax = item.soLuongVanDongVienToiDa ?? item.soLuongVdvToiDa;
                let vdvDisplay = '<span class="text-muted small">Chưa quy định</span>';
                if (vdvMin != null && vdvMax != null) {
                    if (vdvMin === vdvMax) {
                        vdvDisplay = `<span class="badge bg-light text-dark border px-2 py-1">${vdvMin} người</span>`;
                    } else {
                        vdvDisplay = `<span class="badge bg-light text-dark border px-2 py-1">${vdvMin} - ${vdvMax} người</span>`;
                    }
                } else if (vdvMin != null) {
                    vdvDisplay = `<span class="badge bg-light text-dark border px-2 py-1">Tối thiểu ${vdvMin} người</span>`;
                } else if (vdvMax != null) {
                    vdvDisplay = `<span class="badge bg-light text-dark border px-2 py-1">Tối đa ${vdvMax} người</span>`;
                }

                html += `
                    <tr>
                        <td class="ps-3 fw-bold text-muted">${stt}</td>
                        <td>
                            <div class="fw-bold text-dark">${escapeHtml(item.ten)}</div>
                            <small class="text-muted"><span class="badge bg-light text-secondary border font-monospace">Mã: ${escapeHtml(item.ma)}</span></small>
                        </td>
                        <td>
                            <span class="badge bg-primary-subtle text-primary border">
                                <i class="fa-solid fa-tags me-1"></i>${escapeHtml(item.tenDanhMuc || 'Khác')}
                            </span>
                        </td>
                        <td>${loaiBadge}</td>
                        <td>${hinhThucBadge}</td>
                        <td>
                            <span class="badge ${item.gioiTinh === 'Nu' ? 'bg-danger-subtle text-danger' : 'bg-info-subtle text-info'} border">
                                ${gt}
                            </span>
                        </td>
                        <td>${vdvDisplay}</td>
                        <td>
                            <span class="badge ${item.trangThai ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-danger-subtle text-danger border border-danger-subtle'} px-2.5 py-1 rounded-pill">
                                ${item.trangThai ? 'Hoạt động' : 'Tạm dừng'}
                            </span>
                        </td>
                        <td class="text-end pe-3">
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-light border text-primary" title="Cấu hình thể thức & luật thi đấu" onclick="openFormatModal(${item.id}, '${escapeHtml(item.ten)}', '${escapeHtml(item.hinhThucThiDau || 'LoaiTrucTiep')}')">
                                    <i class="fa-solid fa-sliders"></i>
                                </button>
                                <button type="button" class="btn btn-light border" title="Sửa" onclick="openEditModal(${item.id})">
                                    <i class="fa-solid fa-pen-to-square text-success"></i>
                                </button>
                                <button type="button" class="btn btn-light border" title="Xóa" onclick="deleteItem(${item.id}, '${escapeHtml(item.ten)}')">
                                    <i class="fa-solid fa-trash text-danger"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            });

            $('#tblBody').html(html);

            const total = data.totalCount || 0;
            const from = total === 0 ? 0 : start + 1;
            const to = Math.min(start + data.pageSize, total);
            $('#paginationInfo').text(`Hiển thị ${from} - ${to} trên tổng số ${total} môn thể thao`);

            renderPagination(data.pageIndex, data.totalPages);
        }

        function renderPagination(current, totalPages) {
            if (totalPages <= 1) {
                $('#paginationList').empty();
                return;
            }

            let pagHtml = '';
            pagHtml += `<li class="page-item ${current === 1 ? 'disabled' : ''}">
                <a class="page-link" href="javascript:void(0)" onclick="loadData(${current - 1})">&laquo;</a>
            </li>`;

            for (let i = 1; i <= totalPages; i++) {
                if (i === 1 || i === totalPages || (i >= current - 2 && i <= current + 2)) {
                    pagHtml += `<li class="page-item ${i === current ? 'active' : ''}">
                        <a class="page-link" href="javascript:void(0)" onclick="loadData(${i})">${i}</a>
                    </li>`;
                }
            }

            pagHtml += `<li class="page-item ${current === totalPages ? 'disabled' : ''}">
                <a class="page-link" href="javascript:void(0)" onclick="loadData(${current + 1})">&raquo;</a>
            </li>`;

            $('#paginationList').html(pagHtml);
        }

        function openCreateModal() {
            $('#modalTitle span').text('Thêm Môn Thể Thao Mới');
            $('#monId').val('');
            $('#ten').val('');
            $('#ma').val('');
            $('#danhMucId').val('');
            $('#loaiThiDau').val('DongDoi');
            $('#hinhThucThiDau').val('LoaiTrucTiep');
            $('#gioiTinh').val('Nam');
            $('#soLuongVdvToiThieu').val('1');
            $('#soLuongVdvToiDa').val('1');
            $('#moTa').val('');
            $('#trangThai').prop('checked', true);
            $('#modalMon').modal('show');
        }

        function openEditModal(id) {
            $.get('/Manager/MonTheThao/GetById', { id: id }, function (res) {
                if (res.success && res.data) {
                    const item = res.data;
                    $('#modalTitle span').text('Chỉnh Sửa Môn Thể Thao');
                    $('#monId').val(item.id);
                    $('#ten').val(item.ten);
                    $('#ma').val(item.ma || '');
                    $('#danhMucId').val(item.danhMucId || '');
                    const loaiVal = item.loaiThiDau || (item.laMonDongDoi ? 'DongDoi' : 'CaNhan');
                    $('#loaiThiDau').val(loaiVal === 'CaNhan' ? 'CaNhan' : 'DongDoi');
                    $('#hinhThucThiDau').val(item.hinhThucThiDau || 'LoaiTrucTiep');
                    $('#gioiTinh').val(item.gioiTinh || 'Nam');
                    const vMin = item.soLuongVanDongVienToiThieu ?? item.soLuongVdvToiThieu ?? 1;
                    const vMax = item.soLuongVanDongVienToiDa ?? item.soLuongVdvToiDa ?? 1;
                    $('#soLuongVdvToiThieu').val(vMin);
                    $('#soLuongVdvToiDa').val(vMax);
                    $('#moTa').val(item.moTa || '');
                    $('#trangThai').prop('checked', item.trangThai);
                    $('#modalMon').modal('show');
                }
            });
        }

        function saveData() {
            const id = $('#monId').val();
            const ten = $('#ten').val().trim();
            if (!ten) {
                Swal.fire('Lỗi', 'Vui lòng nhập tên môn thể thao.', 'warning');
                return;
            }

            const loaiVal = $('#loaiThiDau').val();
            const hinhThucVal = $('#hinhThucThiDau').val() || 'LoaiTrucTiep';
            const minVdv = parseInt($('#soLuongVdvToiThieu').val()) || 1;
            const maxVdv = parseInt($('#soLuongVdvToiDa').val()) || 1;

            const payload = {
                ten: ten,
                ma: $('#ma').val().trim() || 'MON-' + Date.now().toString().slice(-5),
                danhMucId: $('#danhMucId').val() ? parseInt($('#danhMucId').val()) : null,
                loaiThiDau: loaiVal,
                laMonDongDoi: (loaiVal === 'DongDoi'),
                hinhThucThiDau: hinhThucVal,
                gioiTinh: $('#gioiTinh').val(),
                soLuongVanDongVienToiThieu: minVdv,
                soLuongVanDongVienToiDa: maxVdv,
                soLuongVdvToiThieu: minVdv,
                soLuongVdvToiDa: maxVdv,
                moTa: $('#moTa').val().trim() || null,
                trangThai: $('#trangThai').is(':checked')
            };

            const url = id ? `/Manager/MonTheThao/Save?id=${id}` : '/Manager/MonTheThao/Save';

            $.ajax({
                url: url,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    if (res.success) {
                        $('#modalMon').modal('hide');
                        SportApp.toast('success', res.message || 'Lưu môn thành công!');
                        loadData(currentPage);
                    } else {
                        Swal.fire('Lỗi', res.message || 'Không thể lưu môn.', 'error');
                    }
                }
            });
        }

        function deleteItem(id, name) {
            SportApp.confirm('Xóa Môn Thể Thao?', `Bạn có chắc muốn xóa môn "${name}" không?`, function () {
                $.post('/Manager/MonTheThao/Delete', { id: id }, function (res) {
                    if (res.success) {
                        SportApp.toast('success', res.message || 'Đã xóa môn!');
                        loadData(currentPage);
                    } else {
                        Swal.fire('Lỗi', res.message || 'Không thể xóa.', 'error');
                    }
                });
            });
        }

        function resetFilter() {
            $('#keyword').val('');
            $('#danhMucFilter').val('');
            $('#gioiTinhFilter').val('');
            $('#hinhThucFilter').val('');
            $('#quyMoFilter').val('');
            loadData(1);
        }

        function escapeHtml(text) {
            if (!text) return '';
            return $('<div>').text(text).html();
        }

        // ================= CẤU HÌNH THỂ THỨC & LUẬT THI ĐẤU (THIẾT KẾ MỚI) =================

        let currentFormat = 'LoaiTrucTiep';

        // Switch tab + highlight card
        function switchFormat(format) {
            currentFormat = format;
            $('#fmtHinhThucThiDau').val(format);

            // Tab card styles
            const tabMap = {
                'LoaiTrucTiep': 'fmt-active',
                'VongBang': 'fmt-active-rr',
                'KetHopVongBangVaLoaiTrucTiep': 'fmt-active-grp',
                'TinhDiemXepHang': 'fmt-active-perf'
            };
            $('.fmt-tab-card').removeClass('fmt-active fmt-active-rr fmt-active-grp fmt-active-perf');
            $(`#tabCard_${format}`).addClass(tabMap[format]);

            // Panel visibility
            const panelMap = {
                'LoaiTrucTiep': 'mechLoaiTrucTiep',
                'VongBang': 'mechVongBang',
                'KetHopVongBangVaLoaiTrucTiep': 'mechKetHop',
                'TinhDiemXepHang': 'mechTinhDiem'
            };
            $('.format-mechanism-panel').addClass('d-none');
            $(`#${panelMap[format]}`).removeClass('d-none');
        }

        // Compatibility alias
        function onFormatSelectChange() { switchFormat($('#fmtHinhThucThiDau').val()); }

        // Set field value + update label + mark active button
        function setFmtVal(inputId, labelId, value, unit, groupClass, btn) {
            $(`#${inputId}`).val(value);
            if (labelId) $(`#${labelId}`).text(`${value} ${unit}`);
            if (groupClass) {
                $(`.${groupClass}`).removeClass('active');
                if (btn) $(btn).addClass('active');
            }
            updateAllComputedTimes();
        }

        // ---- Computed time updaters ----
        function updateKoComputedTime() {
            const h = parseInt($('#ko_soHiep').val()) || 0;
            const t = parseInt($('#ko_tgHiep').val()) || 0;
            const total = h * t;
            $('#ko_totalTime').val(total);
            $('#ko_totalTimeHint').text(`${h} hiệp x ${t}p = ${total} phút`);
            $('#ko_soHiepLabel').text(`${h} Hiệp`);
            $('#ko_tgHiepLabel').text(`${t} Phút`);
        }
        function updateKoPhuComputedTime() {
            const h = parseInt($('#ko_soHiepPhu').val()) || 0;
            const t = parseInt($('#ko_tgHiepPhu').val()) || 0;
            const total = h * t;
            $('#ko_totalPhuTime').val(total);
            $('#ko_totalPhuTimeHint').text(`${h} hiệp phụ x ${t}p = ${total} phút`);
            $('#ko_soHiepPhuLabel').text(`${h} Hiệp`);
            $('#ko_tgPhuLabel').text(`${t} Phút`);
        }
        function updateRrComputedTime() {
            const h = parseInt($('#rr_soHiep').val()) || 0;
            const t = parseInt($('#rr_tgHiep').val()) || 0;
            const total = h * t;
            $('#rr_totalTime').val(total);
            $('#rr_totalTimeHint').text(`${h} hiệp x ${t}p = ${total} phút`);
            $('#rr_soHiepLabel').text(`${h} Hiệp`);
            $('#rr_tgHiepLabel').text(`${t} Phút`);
        }
        function updateCombComputedTime() {
            const h = parseInt($('#comb_soHiep').val()) || 0;
            const t = parseInt($('#comb_tgHiep').val()) || 0;
            const total = h * t;
            $('#comb_totalTime').val(total);
            $('#comb_totalTimeHint').text(`${h} hiệp x ${t}p = ${total} phút`);
            $('#comb_soHiepLabel').text(`${h} Hiệp`);
            $('#comb_tgHiepLabel').text(`${t} Phút`);
        }
        function updateCombPhuComputedTime() {
            const h = parseInt($('#comb_soHiepPhu').val()) || 0;
            const t = parseInt($('#comb_tgHiepPhu').val()) || 0;
            const total = h * t;
            $('#comb_totalPhuTime').val(total);
            $('#comb_totalPhuTimeHint').text(`${h} hiệp phụ x ${t}p = ${total} phút`);
            $('#comb_soHiepPhuLabel').text(`${h} Hiệp`);
            $('#comb_tgPhuLabel').text(`${t} Phút`);
        }
        function updateAllComputedTimes() {
            updateKoComputedTime();
            updateKoPhuComputedTime();
            updateRrComputedTime();
            updateCombComputedTime();
            updateCombPhuComputedTime();
        }

        // ---- Quick time presets (inline buttons) ----
        function applyKoTimePreset(hiep, tg, nghi) {
            $('#ko_soHiep').val(hiep); $('#ko_tgHiep').val(tg); $('#ko_nghi').val(nghi);
            $('#ko_nghiLabel').text(`${nghi} Phút`);
            updateKoComputedTime();
            setActiveQbtn('.koHiepBtn', hiep); setActiveQbtn('.koTgHiepBtn', tg); setActiveQbtn('.koNghiBtn', nghi);
        }
        function applyRrTimePreset(hiep, tg, nghi) {
            $('#rr_soHiep').val(hiep); $('#rr_tgHiep').val(tg); $('#rr_nghi').val(nghi);
            $('#rr_nghiLabel').text(`${nghi} Phút`);
            updateRrComputedTime();
            setActiveQbtn('.rrHiepBtn', hiep); setActiveQbtn('.rrTgBtn', tg); setActiveQbtn('.rrNghiBtn', nghi);
        }
        function applyCombTimePreset(hiep, tg, nghi) {
            $('#comb_soHiep').val(hiep); $('#comb_tgHiep').val(tg); $('#comb_nghi').val(nghi);
            $('#comb_nghiLabel').text(`${nghi} Phút`);
            updateCombComputedTime();
            setActiveQbtn('.combHiepBtn', hiep); setActiveQbtn('.combTgBtn', tg); setActiveQbtn('.combNghiBtn', nghi);
        }
        function setActiveQbtn(selector, value) {
            $(selector).each(function() {
                const btnTxt = $(this).text().trim();
                const btnVal = parseFloat(btnTxt);
                $(this).toggleClass('active', btnVal === parseFloat(value));
            });
        }

        // ---- Criteria up/down ----
        function moveCriteria(listId, btn, direction) {
            const $row = $(btn).closest('.fmt-criteria-row');
            const $list = $(`#${listId}`);
            const $rows = $list.find('.fmt-criteria-row');
            const idx = $rows.index($row);
            if (direction === -1 && idx > 0) {
                $row.insertBefore($rows.eq(idx - 1));
            } else if (direction === 1 && idx < $rows.length - 1) {
                $row.insertAfter($rows.eq(idx + 1));
            }
            $list.find('.fmt-criteria-row').each(function(i) {
                $(this).find('.fmt-num-badge').text(`#${i + 1}`);
            });
        }

        // ---- Open modal ----
        function openFormatModal(monId, monTen, hinhThucThiDau) {
            $('#fmtMonId').val(monId);
            $('#badgeModalSportName').text(monTen || `#${monId}`).removeClass('d-none');
            $('#formatModalSubtitle').html(`Môn: <strong>${escapeHtml(monTen)}</strong> &nbsp;·&nbsp; Tùy biến sơ đồ thi đấu và tự động xếp lịch`);

            resetFormatForm();

            $.get('/Manager/CauHinhTheThuc/GetConfig', { monTheThaoId: monId }, function(res) {
                if (res && res.success && res.data) {
                    populateFormatForm(res.data);
                } else {
                    if (hinhThucThiDau) switchFormat(hinhThucThiDau);
                    guessPreset(monTen);
                }
                $('#modalTheThuc').modal('show');
            }).fail(function() {
                if (hinhThucThiDau) switchFormat(hinhThucThiDau);
                guessPreset(monTen);
                $('#modalTheThuc').modal('show');
            });
        }

        // ---- Reset form ----
        function resetFormatForm() {
            // KO defaults
            applyKoTimePreset(2, 45, 15);
            $('#ko_coTranhHangBa').prop('checked', true);
            $('#ko_coHiepPhu').prop('checked', true);
            $('#ko_overtimeSub').show();
            $('#ko_soHiepPhu').val(2); $('#ko_tgHiepPhu').val(15);
            updateKoPhuComputedTime();
            setActiveQbtn('.koPhuHiepBtn', 2); setActiveQbtn('.koPhuTgBtn', 15);
            $('#ko_coPenalty').prop('checked', true);

            // RR defaults
            applyRrTimePreset(2, 45, 15);
            $('#rr_diemThang').val(3); $('#rr_diemHoa').val(1); $('#rr_diemThua').val(0);

            // Comb defaults
            applyCombTimePreset(2, 45, 15);
            $('#comb_soBang').val(4);
            $('#comb_soDoiMoiBangVaoVongTrong').val(2);
            $('#comb_diemThang').val(3); $('#comb_diemHoa').val(1); $('#comb_diemThua').val(0);
            $('#comb_coTranhHangBa').prop('checked', true);
            $('#comb_coHiepPhu').prop('checked', true);
            $('#comb_overtimeSub').show();
            $('#comb_soHiepPhu').val(2); $('#comb_tgHiepPhu').val(15);
            updateCombPhuComputedTime();
            setActiveQbtn('.combPhuHiepBtn', 2); setActiveQbtn('.combPhuTgBtn', 15);
            $('#comb_coPenalty').prop('checked', true);

            $('#fmtPresetSelect').val('');
            switchFormat('LoaiTrucTiep');
        }

        // ---- Populate from API data ----
        function populateFormatForm(data) {
            const format = data.hinhThucThiDau || 'LoaiTrucTiep';

            if (format === 'LoaiTrucTiep') {
                const h = data.soHiepToiDa || 2, t = data.thoiGianHiepChinhPhut || 45, n = data.nghiGiuaTranPhut ?? 15;
                applyKoTimePreset(h, t, n);
                const coHiepPhu = !!data.coHiepPhu;
                $('#ko_coTranhHangBa').prop('checked', data.coTranhHangBa !== false);
                $('#ko_coHiepPhu').prop('checked', coHiepPhu);
                $('#ko_overtimeSub').toggle(coHiepPhu);
                if (coHiepPhu) {
                    const ph = data.soHiepPhu || 2, pt = data.thoiGianHiepPhuPhut || 15;
                    $('#ko_soHiepPhu').val(ph); $('#ko_tgHiepPhu').val(pt);
                    updateKoPhuComputedTime();
                    setActiveQbtn('.koPhuHiepBtn', ph); setActiveQbtn('.koPhuTgBtn', pt);
                }
                $('#ko_coPenalty').prop('checked', data.coPenalty !== false);
            } else if (format === 'VongBang') {
                const h = data.soHiepToiDa || 2, t = data.thoiGianHiepChinhPhut || 45, n = data.nghiGiuaTranPhut ?? 15;
                applyRrTimePreset(h, t, n);
                $('#rr_diemThang').val(data.diemThang ?? 3);
                $('#rr_diemHoa').val(data.diemHoa ?? 1);
                $('#rr_diemThua').val(data.diemThua ?? 0);
            } else if (format === 'KetHopVongBangVaLoaiTrucTiep') {
                const h = data.soHiepToiDa || 2, t = data.thoiGianHiepChinhPhut || 45, n = data.nghiGiuaTranPhut ?? 15;
                applyCombTimePreset(h, t, n);
                $('#comb_soBang').val(data.soBang || 4);
                $('#comb_soDoiMoiBangVaoVongTrong').val(data.soDoiMoiBangVaoVongTrong || 2);
                $('#comb_diemThang').val(data.diemThang ?? 3);
                $('#comb_diemHoa').val(data.diemHoa ?? 1);
                $('#comb_diemThua').val(data.diemThua ?? 0);
                $('#comb_coTranhHangBa').prop('checked', data.coTranhHangBa !== false);
                const coHiepPhu = !!data.coHiepPhu;
                $('#comb_coHiepPhu').prop('checked', coHiepPhu);
                $('#comb_overtimeSub').toggle(coHiepPhu);
                if (coHiepPhu) {
                    const ph = data.soHiepPhu || 2, pt = data.thoiGianHiepPhuPhut || 15;
                    $('#comb_soHiepPhu').val(ph); $('#comb_tgHiepPhu').val(pt);
                    updateCombPhuComputedTime();
                    setActiveQbtn('.combPhuHiepBtn', ph); setActiveQbtn('.combPhuTgBtn', pt);
                }
                $('#comb_coPenalty').prop('checked', data.coPenalty !== false);
            }

            switchFormat(format);
        }

        // ---- Auto-guess preset from sport name ----
        function guessPreset(name) {
            const s = (name || '').toLowerCase();
            if (s.includes('bóng đá') || s.includes('football')) applyPreset('football');
            else if (s.includes('futsal')) applyPreset('futsal');
            else if (s.includes('bóng chuyền') || s.includes('volleyball')) applyPreset('volleyball');
            else if (s.includes('bóng rổ') || s.includes('basketball')) applyPreset('basketball');
            else if (s.includes('bóng bàn') || s.includes('table tennis')) applyPreset('tabletennis');
            else if (s.includes('cầu lông') || s.includes('badminton')) applyPreset('badminton');
            else if (s.includes('điền kinh') || s.includes('chạy')) applyPreset('athletics');
            else if (s.includes('bơi') || s.includes('swimming')) applyPreset('swimming');
        }

        // ---- Apply preset from dropdown ----
        function applyPresetFromSelect(val) {
            if (val) { applyPreset(val); setTimeout(() => $('#fmtPresetSelect').val(''), 100); }
        }

        // ---- Apply preset ----
        function applyPreset(preset) {
            switch (preset) {
                case 'football':
                    switchFormat('KetHopVongBangVaLoaiTrucTiep');
                    applyCombTimePreset(2, 45, 15);
                    $('#comb_soBang').val(4); $('#comb_soDoiMoiBangVaoVongTrong').val(2);
                    $('#comb_diemThang').val(3); $('#comb_diemHoa').val(1); $('#comb_diemThua').val(0);
                    $('#comb_coTranhHangBa').prop('checked', true);
                    $('#comb_coHiepPhu').prop('checked', true); $('#comb_overtimeSub').show();
                    $('#comb_soHiepPhu').val(2); $('#comb_tgHiepPhu').val(15); updateCombPhuComputedTime();
                    setActiveQbtn('.combPhuHiepBtn', 2); setActiveQbtn('.combPhuTgBtn', 15);
                    $('#comb_coPenalty').prop('checked', true); break;
                case 'futsal':
                    switchFormat('KetHopVongBangVaLoaiTrucTiep');
                    applyCombTimePreset(2, 20, 10);
                    $('#comb_soBang').val(4); $('#comb_soDoiMoiBangVaoVongTrong').val(2);
                    $('#comb_diemThang').val(3); $('#comb_diemHoa').val(1); $('#comb_diemThua').val(0);
                    $('#comb_coTranhHangBa').prop('checked', true);
                    $('#comb_coHiepPhu').prop('checked', true); $('#comb_overtimeSub').show();
                    $('#comb_soHiepPhu').val(2); $('#comb_tgHiepPhu').val(5); updateCombPhuComputedTime();
                    setActiveQbtn('.combPhuHiepBtn', 2); setActiveQbtn('.combPhuTgBtn', 5);
                    $('#comb_coPenalty').prop('checked', true); break;
                case 'volleyball':
                    switchFormat('KetHopVongBangVaLoaiTrucTiep');
                    applyCombTimePreset(5, 25, 15);
                    $('#comb_soBang').val(2); $('#comb_soDoiMoiBangVaoVongTrong').val(2);
                    $('#comb_diemThang').val(3); $('#comb_diemHoa').val(1);
                    $('#comb_coTranhHangBa').prop('checked', true);
                    $('#comb_coHiepPhu').prop('checked', false); $('#comb_overtimeSub').hide();
                    $('#comb_coPenalty').prop('checked', false); break;
                case 'basketball':
                    switchFormat('LoaiTrucTiep');
                    applyKoTimePreset(4, 12, 5);
                    $('#ko_coTranhHangBa').prop('checked', true);
                    $('#ko_coHiepPhu').prop('checked', true); $('#ko_overtimeSub').show();
                    $('#ko_soHiepPhu').val(1); $('#ko_tgHiepPhu').val(5); updateKoPhuComputedTime();
                    setActiveQbtn('.koPhuHiepBtn', 1); setActiveQbtn('.koPhuTgBtn', 5);
                    $('#ko_coPenalty').prop('checked', false); break;
                case 'badminton':
                    switchFormat('LoaiTrucTiep');
                    applyKoTimePreset(3, 30, 15);
                    $('#ko_coHiepPhu').prop('checked', false); $('#ko_overtimeSub').hide();
                    $('#ko_coPenalty').prop('checked', false);
                    $('#ko_coTranhHangBa').prop('checked', true); break;
                case 'tabletennis':
                    switchFormat('VongBang');
                    applyRrTimePreset(5, 15, 10);
                    $('#rr_diemThang').val(2); $('#rr_diemHoa').val(1); $('#rr_diemThua').val(0); break;
                case 'athletics':
                case 'swimming':
                    switchFormat('TinhDiemXepHang'); break;
            }
            if (window.SportApp && SportApp.toast) SportApp.toast('info', `Đã áp dụng mẫu: ${preset.toUpperCase()}`);
        }

        // ---- Form submit handler ----
        $('#formTheThuc').on('submit', function(e) {
            e.preventDefault();
            saveFormatData();
        });

        // ---- Save data ----
        function saveFormatData() {
            const monId = parseInt($('#fmtMonId').val());
            if (!monId) { Swal.fire('Lỗi', 'Không tìm thấy ID môn thể thao.', 'error'); return; }

            const hinhThuc = currentFormat;
            let payload = { monTheThaoId: monId, hinhThucThiDau: hinhThuc };

            if (hinhThuc === 'LoaiTrucTiep') {
                payload.soHiepToiDa            = parseInt($('#ko_soHiep').val()) || 2;
                payload.thoiGianHiepChinhPhut  = parseInt($('#ko_tgHiep').val()) || 45;
                payload.nghiGiuaTranPhut        = parseInt($('#ko_nghi').val()) || 15;
                payload.thoiLuongTranPhut       = parseInt($('#ko_totalTime').val()) || 90;
                payload.coTranhHangBa           = $('#ko_coTranhHangBa').is(':checked');
                payload.coHiepPhu               = $('#ko_coHiepPhu').is(':checked');
                payload.soHiepPhu               = parseInt($('#ko_soHiepPhu').val()) || 2;
                payload.thoiGianHiepPhuPhut      = parseInt($('#ko_tgHiepPhu').val()) || 15;
                payload.coPenalty               = $('#ko_coPenalty').is(':checked');
                payload.soLuotPenaltyMoiDoi     = 5;
                payload.loaiTheThuc             = 'ThoiGianHiep';
                payload.soBang                  = 0;
                payload.soDoiMoiBang             = 2;
                payload.soDoiMoiBangVaoVongTrong = 1;
            } else if (hinhThuc === 'VongBang') {
                payload.soHiepToiDa            = parseInt($('#rr_soHiep').val()) || 2;
                payload.thoiGianHiepChinhPhut  = parseInt($('#rr_tgHiep').val()) || 45;
                payload.nghiGiuaTranPhut        = parseInt($('#rr_nghi').val()) || 15;
                payload.thoiLuongTranPhut       = parseInt($('#rr_totalTime').val()) || 90;
                payload.diemThang               = parseFloat($('#rr_diemThang').val()) || 3;
                payload.diemHoa                 = parseFloat($('#rr_diemHoa').val()) || 1;
                payload.diemThua                = parseFloat($('#rr_diemThua').val()) || 0;
                payload.choPhepHoaVongBang       = true;
                payload.loaiTheThuc             = 'ThoiGianHiep';
                payload.soBang                  = 1;
                payload.soDoiMoiBang             = 4;
                payload.soDoiMoiBangVaoVongTrong = 1;
                // Criteria order
                const crit = [];
                $('#rr_criteriaList .fmt-criteria-row').each(function() {
                    if ($(this).find('.fmt-criteria-cb').is(':checked')) crit.push($(this).data('criteria-id'));
                });
                payload.tieuChiXepHang = crit;
            } else if (hinhThuc === 'KetHopVongBangVaLoaiTrucTiep') {
                payload.soHiepToiDa              = parseInt($('#comb_soHiep').val()) || 2;
                payload.thoiGianHiepChinhPhut    = parseInt($('#comb_tgHiep').val()) || 45;
                payload.nghiGiuaTranPhut          = parseInt($('#comb_nghi').val()) || 15;
                payload.thoiLuongTranPhut         = parseInt($('#comb_totalTime').val()) || 90;
                payload.soBang                    = parseInt($('#comb_soBang').val()) || 4;
                payload.soDoiMoiBangVaoVongTrong  = parseInt($('#comb_soDoiMoiBangVaoVongTrong').val()) || 2;
                payload.diemThang                 = parseFloat($('#comb_diemThang').val()) || 3;
                payload.diemHoa                   = parseFloat($('#comb_diemHoa').val()) || 1;
                payload.diemThua                  = parseFloat($('#comb_diemThua').val()) || 0;
                payload.coTranhHangBa             = $('#comb_coTranhHangBa').is(':checked');
                payload.coHiepPhu                 = $('#comb_coHiepPhu').is(':checked');
                payload.soHiepPhu                 = parseInt($('#comb_soHiepPhu').val()) || 2;
                payload.thoiGianHiepPhuPhut       = parseInt($('#comb_tgHiepPhu').val()) || 15;
                payload.coPenalty                 = $('#comb_coPenalty').is(':checked');
                payload.soLuotPenaltyMoiDoi       = 5;
                payload.choPhepHoaVongBang        = true;
                payload.loaiTheThuc               = 'ThoiGianHiep';
                const crit = [];
                $('#comb_criteriaList .fmt-criteria-row').each(function() {
                    if ($(this).find('.fmt-criteria-cb').is(':checked')) crit.push($(this).data('criteria-id'));
                });
                payload.tieuChiXepHang = crit;
            } else if (hinhThuc === 'TinhDiemXepHang') {
                payload.loaiTheThuc = 'TinhDiemXepHang';
            }

            const $btn = $('#btnSaveTheThuc');
            $btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin me-1"></i> Đang lưu...');

            $.ajax({
                url: '/Manager/CauHinhTheThuc/SaveConfig',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function(res) {
                    $btn.prop('disabled', false).html('<i class="fa-solid fa-check me-1"></i> Lưu Cấu Hình');
                    if (res && res.success) {
                        $('#modalTheThuc').modal('hide');
                        if (window.SportApp && SportApp.toast) SportApp.toast('success', res.message || 'Đã lưu cấu hình thể thức!');
                        else Swal.fire('Thành công', res.message || 'Đã lưu thành công!', 'success');
                        loadData(currentPage);
                    } else { Swal.fire('Lỗi', res.message || 'Không thể lưu cấu hình.', 'error'); }
                },
                error: function() {
                    $btn.prop('disabled', false).html('<i class="fa-solid fa-check me-1"></i> Lưu Cấu Hình');
                    Swal.fire('Lỗi', 'Không thể kết nối máy chủ.', 'error');
                }
            });
        }

        // Init on page load
        $(document).ready(function() {
            updateAllComputedTimes();
            switchFormat('LoaiTrucTiep');
        });
    </script>
}
