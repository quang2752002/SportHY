@section Scripts {
    <script src="https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/ckeditor.js"></script>
    <script>
        let currentPage = 1;
        const pageSize = 10;
        let formatConfigured = false;
        let categoriesData = [];
        let categoryModalInstance = null;
        let sportRegulationEditor = null;
        let sportRegulationFiles = [];
        let sportRegulationContentId = 0;
        let sportRegulationContentTitle = 'Điều lệ môn thi đấu';
        let sportRegulationContentStatus = true;
        let regulationUploadsInProgress = 0;

        $(document).ready(function () {
            categoryModalInstance = new bootstrap.Modal(document.getElementById('modalCategory'));
            loadCategories().then(function () {
                populateCategorySelects();
                loadData(1);
            }).catch(function () {
                loadData(1);
            });

            // Chuyển bộ cấu hình thể thức vào tab của form môn; form chỉ còn một nút lưu chung.
            const $formatRoot = $('#modalTheThuc');
            $formatRoot.children('.w-100').removeClass('w-100 m-0').addClass('format-editor-dialog');
            $formatRoot.appendTo('#formatEditorMount');
            $formatRoot.find('.modal-content').css('max-height', 'none');
            $('#formTheThuc').css({ overflow: 'visible', minHeight: '0' });
            $('#modalTheThuc button:not([type])').attr('type', 'button');
            $('#formatRequiredNotice').after('<div class="alert alert-info py-2 mb-3 small"><i class="fa-solid fa-circle-info me-1"></i>Cấu hình này được lưu cùng môn và dùng làm cấu hình mặc định cho các giải sử dụng môn.</div>');

            $('#formatSportTabButton').on('shown.bs.tab', function () {
                formatConfigured = true;
                const format = $('#hinhThucThiDau').val() || 'LoaiTrucTiep';
                $('#fmtHinhThucThiDau').val(format);
                switchFormat(format);
                setFormatConfirmation(true);
            });

            $('#regulationSportTabButton').on('shown.bs.tab', initializeSportRegulationEditor);
            $('#sportRegulationFiles').on('change', function () {
                uploadSportRegulationFiles(Array.from(this.files || []));
            });

            $('#hinhThucThiDau').on('change', function () {
                switchFormat(this.value);
                $('#fmtHinhThucThiDau').val(this.value);
            });

            $('#keyword').on('keypress', function (e) {
                if (e.which === 13) loadData(1);
            });

            $('#danhMucFilter, #gioiTinhFilter, #hinhThucFilter, #quyMoFilter, #trangThaiFilter, #categoryStatusFilter').on('change', function () {
                loadData(1);
            });

            $('#formCategory').on('submit', function (e) {
                saveCategory(e);
            });

            $('#formMon').on('submit', function (e) {
                e.preventDefault();
                saveData();
            });

            // Theo dõi nhập mã thủ công
            $('#categoryCode').on('input', function () {
                isCategoryCodeManual = true;
            });

            $('#ma').on('input', function () {
                isSportCodeManual = true;
            });

            $('#danhMucId').on('change', function () {
                if (!$('#monId').val() && !isSportCodeManual) {
                    autoGenerateSportCode($(this).val());
                }
            });

            // Gợi ý thông minh khi gõ tên môn thể thao mới
            $('#ten').on('input', function () {
                if ($('#monId').val()) return; // Chỉ áp dụng khi thêm mới
                const rawVal = $(this).val().trim();
                const val = rawVal.toLowerCase();
                if (!val) return;

                if (val.includes('bóng đá') || val.includes('futsal')) {
                    $('#loaiThiDau').val('DongDoi');
                    $('#hinhThucThiDau').val('KetHopVongBangVaLoaiTrucTiep');
                    $('#soLuongVdvToiThieu').val(7);
                    $('#soLuongVdvToiDa').val(14);
                } else if (val.includes('bóng chuyền')) {
                    $('#loaiThiDau').val('DongDoi');
                    $('#hinhThucThiDau').val('KetHopVongBangVaLoaiTrucTiep');
                    $('#soLuongVdvToiThieu').val(6);
                    $('#soLuongVdvToiDa').val(12);
                } else if (val.includes('bóng rổ')) {
                    $('#loaiThiDau').val('DongDoi');
                    $('#hinhThucThiDau').val('LoaiTrucTiep');
                    $('#soLuongVdvToiThieu').val(3);
                    $('#soLuongVdvToiDa').val(5);
                } else if (val.includes('cầu lông')) {
                    $('#loaiThiDau').val('CaNhan');
                    $('#hinhThucThiDau').val('LoaiTrucTiep');
                    $('#soLuongVdvToiThieu').val(1);
                    $('#soLuongVdvToiDa').val(2);
                } else if (val.includes('bóng bàn')) {
                    $('#loaiThiDau').val('CaNhan');
                    $('#hinhThucThiDau').val('VongBang');
                    $('#soLuongVdvToiThieu').val(1);
                    $('#soLuongVdvToiDa').val(2);
                } else if (val.includes('tennis') || val.includes('quần vợt') || val.includes('pickleball')) {
                    $('#loaiThiDau').val('CaNhan');
                    $('#hinhThucThiDau').val('LoaiTrucTiep');
                    $('#soLuongVdvToiThieu').val(1);
                    $('#soLuongVdvToiDa').val(2);
                } else if (val.includes('chạy') || val.includes('điền kinh') || val.includes('bơi')) {
                    $('#loaiThiDau').val('CaNhan');
                    $('#hinhThucThiDau').val('TinhDiemXepHang');
                    $('#soLuongVdvToiThieu').val(1);
                    $('#soLuongVdvToiDa').val(1);
                } else if (val.includes('cờ vua') || val.includes('cờ tướng')) {
                    $('#loaiThiDau').val('CaNhan');
                    $('#hinhThucThiDau').val('HeThuySi');
                    $('#soLuongVdvToiThieu').val(1);
                    $('#soLuongVdvToiDa').val(1);
                }
            });
        });

        function loadCategories() {
            return $.ajax({
                url: '/Manager/DanhMucMonTheThao/GetPagedData',
                type: 'GET',
                data: { pageIndex: 1, pageSize: 500 }
            }).then(function (res) {
                if (!res.success || !res.data) throw new Error('Không thể tải danh mục môn.');
                categoriesData = res.data.items || [];
                const totalPages = res.data.totalPages || 1;
                if (totalPages <= 1) return categoriesData;

                const requests = [];
                for (let page = 2; page <= totalPages; page++) {
                    requests.push($.get('/Manager/DanhMucMonTheThao/GetPagedData', { pageIndex: page, pageSize: 500 }));
                }
                return $.when.apply($, requests).then(function () {
                    const results = requests.length === 1 ? [arguments[0]] : Array.from(arguments, result => result[0]);
                    results.forEach(result => {
                        if (result && result.success && result.data) categoriesData = categoriesData.concat(result.data.items || []);
                    });
                    return categoriesData;
                });
            });
        }

        function populateCategorySelects() {
            const options = '<option value="">-- Danh mục --</option>' + categoriesData.map(category =>
                `<option value="${category.id}">${escapeHtml(category.ten)}${category.trangThai ? '' : ' (Tạm dừng)'}</option>`
            ).join('');
            const selectedFilter = $('#danhMucFilter').val();
            $('#danhMucFilter').html(options).val(selectedFilter || '');

            const sportOptions = '<option value="">-- Chọn nhóm môn --</option>' + categoriesData.map(category =>
                `<option value="${category.id}">${escapeHtml(category.ten)}${category.trangThai ? '' : ' (Tạm dừng)'}</option>`
            ).join('');
            const selectedSportCategory = $('#danhMucId').val();
            $('#danhMucId').html(sportOptions).val(selectedSportCategory || '');
        }

        function loadData(page) {
            currentPage = page;
            const keyword = $('#keyword').val().trim();
            const danhMucId = $('#danhMucFilter').val();
            const gioiTinh = $('#gioiTinhFilter').val();
            const hinhThucThiDau = $('#hinhThucFilter').val();
            const loaiThiDau = $('#quyMoFilter').val();

            $.ajax({
                url: '/Manager/MonTheThao/GetPagedData',
                type: 'GET',
                data: {
                    pageIndex: page,
                    pageSize: pageSize,
                    keyword: keyword || undefined,
                    danhMucId: danhMucId ? parseInt(danhMucId) : undefined,
                    trangThai: $('#trangThaiFilter').val() === '' ? undefined : $('#trangThaiFilter').val() === 'true',
                    gioiTinh: gioiTinh || undefined,
                    hinhThucThiDau: hinhThucThiDau || undefined,
                    loaiThiDau: loaiThiDau || undefined,
                    danhMucTrangThai: $('#categoryStatusFilter').val() === '' ? undefined : $('#categoryStatusFilter').val() === 'true'
                },
                success: function (res) {
                    if (res.success && res.data) {
                        renderTable(res.data);
                    }
                }
            });
        }

        function renderTable(data) {
            const items = data.items || [];
            const start = (data.pageIndex - 1) * data.pageSize;
            const grouped = new Map();
            items.forEach(item => {
                const categoryId = item.danhMucId || 0;
                if (!grouped.has(categoryId)) grouped.set(categoryId, []);
                grouped.get(categoryId).push(item);
            });

            let html = '';
            const itemNumbers = new Map(items.map((item, index) => [item.id, start + index + 1]));
            const categoryKeyword = ($('#keyword').val() || '').trim().toLocaleLowerCase();
            const categoryStatus = $('#categoryStatusFilter').val();
            const selectedCategory = $('#danhMucFilter').val();
            const visibleCategories = categoriesData.filter(category => {
                const matchesStatus = categoryStatus === '' || String(category.trangThai) === categoryStatus;
                const matchesKeyword = !categoryKeyword || `${category.ten || ''} ${category.ma || ''}`.toLocaleLowerCase().includes(categoryKeyword);
                return matchesStatus && (grouped.has(category.id) || selectedCategory === String(category.id) || (matchesKeyword && categoryKeyword) || (!categoryKeyword && category.soMonTheThao === 0));
            });

            visibleCategories.forEach(category => {
                const children = grouped.get(category.id) || [];
                html += renderCategoryNode(category, children, itemNumbers);
            });

            const knownCategoryIds = new Set(categoriesData.map(category => Number(category.id)));
            const unknownCategoryItems = items.filter(item => !knownCategoryIds.has(Number(item.danhMucId || 0)));
            if (unknownCategoryItems.length) {
                html += renderCategoryNode({ id: 0, ma: '', ten: 'Chưa phân loại', moTa: '', trangThai: true, soMonTheThao: unknownCategoryItems.length }, unknownCategoryItems, itemNumbers);
            }

            if (items.length === 0 && visibleCategories.length === 0) {
                html = '<div class="text-center py-5 text-muted"><i class="fa-regular fa-folder-open fs-2 d-block mb-2"></i>Chưa có danh mục hoặc môn thi đấu phù hợp.</div>';
            } else if (items.length === 0) {
                html = visibleCategories.map(category => renderCategoryNode(category, [], itemNumbers)).join('');
            }

            $('#sportTree').html(html);
            const total = data.totalCount || 0;
            const from = total === 0 ? 0 : start + 1;
            const to = Math.min(start + data.pageSize, total);
            $('#paginationInfo').text(`Hiển thị ${from} - ${to} trên tổng số ${total} môn thi đấu · ${categoriesData.length} danh mục`);
            renderPagination(data.pageIndex, data.totalPages);
        }

        function renderCategoryNode(category, items, itemNumbers) {
            const id = Number(category.id || 0);
            const isUnclassified = id === 0;
            const safeCategoryName = escapeHtml(category.ten || 'Chưa phân loại');
            const statusBadge = category.trangThai
                ? '<span class="badge bg-success-subtle text-success border border-success-subtle">Hoạt động</span>'
                : '<span class="badge bg-secondary-subtle text-secondary border">Tạm dừng</span>';
            const count = Number(category.soMonTheThao ?? items.length);
            const categoryActions = isUnclassified ? '' : `
                <div class="d-flex gap-1 ms-auto">
                    <button type="button" class="btn btn-sm btn-outline-primary" title="Thêm môn vào danh mục này" onclick="openCreateModal(${id})"><i class="fa-solid fa-plus me-1"></i>Thêm môn</button>
                    <button type="button" class="btn btn-sm btn-light border text-primary" title="Sửa danh mục" onclick="openEditCategoryModal(${id})"><i class="fa-solid fa-pen-to-square"></i></button>
                    <label class="form-check form-switch m-0 d-flex align-items-center" title="${category.trangThai ? 'Tắt hoạt động danh mục' : 'Bật hoạt động danh mục'}">
                        <input class="form-check-input m-0" type="checkbox" role="switch" aria-label="Trạng thái danh mục ${safeCategoryName}" ${category.trangThai ? 'checked' : ''} onchange="setCategoryStatus(${id}, this.checked, this)">
                    </label>
                </div>`;

            const childrenHtml = items.length
                ? items.map(item => renderSportLeaf(item, itemNumbers.get(item.id) || '')).join('')
                : `<div class="sport-tree-empty"><i class="fa-regular fa-circle-dot me-2"></i>${count === 0 ? 'Danh mục này chưa có môn thi đấu.' : 'Không có môn phù hợp trong trang/lọc hiện tại.'}</div>`;

            return `
                <section class="sport-tree-category" data-category-node="${id}">
                    <div class="sport-tree-category-header">
                        <button type="button" class="sport-tree-toggle" aria-expanded="true" aria-label="Thu gọn danh mục" onclick="toggleCategoryNode(${id})"><i class="fa-solid fa-chevron-down"></i></button>
                        <i class="fa-solid fa-folder-open sport-tree-category-icon"></i>
                        <div class="min-w-0">
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <strong class="text-dark">${safeCategoryName}</strong>
                                ${category.ma ? `<span class="badge bg-light text-secondary border font-monospace">${escapeHtml(category.ma)}</span>` : ''}
                                ${statusBadge}
                                <span class="badge bg-primary-subtle text-primary">${count} môn</span>
                                ${items.length && items.length < count ? `<span class="small text-muted">Hiển thị ${items.length} môn theo bộ lọc/trang hiện tại</span>` : ''}
                            </div>
                            ${category.moTa ? `<small class="text-muted">${escapeHtml(category.moTa)}</small>` : ''}
                        </div>
                        ${categoryActions}
                    </div>
                    <div class="sport-tree-category-content" id="categoryChildren-${id}">${childrenHtml}</div>
                </section>`;
        }

        function renderSportLeaf(item, number) {
                const loaiVal = item.loaiThiDau || (item.laMonDongDoi ? 'DongDoi' : 'CaNhan');
                let loaiBadge = '<span class="badge bg-primary-subtle text-primary border fw-semibold"><i class="fa-solid fa-users me-1"></i>Đồng đội</span>';
                if (loaiVal === 'CaNhan') {
                    loaiBadge = '<span class="badge bg-info-subtle text-info border fw-semibold"><i class="fa-solid fa-user me-1"></i>Cá nhân</span>';
                }

                // Sơ đồ / Hình thức thi đấu badge
                let hinhThucBadge = '';
                switch (item.hinhThucThiDau) {
                    case 'LoaiTrucTiep':
                        hinhThucBadge = '<span class="badge bg-danger-subtle text-danger border fw-semibold"><i class="fa-solid fa-sitemap me-1"></i>Loại trực tiếp</span>';
                        break;
                    case 'VongBang':
                        hinhThucBadge = '<span class="badge bg-success-subtle text-success border fw-semibold"><i class="fa-solid fa-table-cells me-1"></i>Vòng tròn</span>';
                        break;
                    case 'KetHopVongBangVaLoaiTrucTiep':
                        hinhThucBadge = '<span class="badge bg-primary-subtle text-primary border fw-semibold"><i class="fa-solid fa-diagram-project me-1"></i>Bảng + Knockout</span>';
                        break;                    
                    case 'TinhDiemXepHang':
                        hinhThucBadge = '<span class="badge bg-info-subtle text-info border fw-semibold"><i class="fa-solid fa-stopwatch me-1"></i>Đo thành tích</span>';
                        break;
                    default:
                        hinhThucBadge = `<span class="badge bg-secondary-subtle text-secondary border fw-semibold">${escapeHtml(item.hinhThucThiDau || 'Mặc định')}</span>`;
                        break;
                }

                const gt = item.gioiTinh === 'Nu' ? 'Nữ' : (item.gioiTinh === 'HonHop' ? 'Hỗn hợp' : 'Nam');

                // Lấy số VĐV chính xác
                const vdvMin = item.soLuongVanDongVienToiThieu ?? item.soLuongVdvToiThieu;
                const vdvMax = item.soLuongVanDongVienToiDa ?? item.soLuongVdvToiDa;
                let vdvDisplay = '<span class="text-muted small">Chưa quy định</span>';
                if (vdvMin != null && vdvMax != null) {
                    if (vdvMin === vdvMax) {
                        vdvDisplay = `<span class="badge bg-light text-dark border px-2 py-1">${vdvMin} người</span>`;
                    } else {
                        vdvDisplay = `<span class="badge bg-light text-dark border px-2 py-1">${vdvMin} - ${vdvMax} người</span>`;
                    }
                } else if (vdvMin != null) {
                    vdvDisplay = `<span class="badge bg-light text-dark border px-2 py-1">Tối thiểu ${vdvMin} người</span>`;
                } else if (vdvMax != null) {
                    vdvDisplay = `<span class="badge bg-light text-dark border px-2 py-1">Tối đa ${vdvMax} người</span>`;
                }

                const statusBadge = item.trangThai
                    ? '<span class="badge bg-success-subtle text-success border border-success-subtle">Hoạt động</span>'
                    : '<span class="badge bg-danger-subtle text-danger border border-danger-subtle">Tạm dừng</span>';
                const encodedName = encodeURIComponent(item.ten || '');
                const format = item.hinhThucThiDau || 'LoaiTrucTiep';
                return `
                    <div class="sport-tree-leaf">
                        <span class="text-muted small" style="width:28px">${number ? `${number}.` : ''}</span>
                        <div class="sport-tree-leaf-main">
                            <div class="fw-bold text-dark">${escapeHtml(item.ten)}</div>
                            <small class="text-muted font-monospace">Mã: ${escapeHtml(item.ma || '---')}</small>
                        </div>
                        <div class="sport-tree-leaf-meta">
                            ${loaiBadge}${hinhThucBadge}
                            <span class="badge ${item.gioiTinh === 'Nu' ? 'bg-danger-subtle text-danger' : 'bg-info-subtle text-info'} border">${gt}</span>
                            ${vdvDisplay}${statusBadge}
                        </div>
                        <div class="btn-group btn-group-sm ms-auto">
                            <button type="button" class="btn btn-light border text-primary" title="Cấu hình thể thức & luật thi đấu" onclick="openFormatModal(${item.id}, decodeURIComponent('${encodedName}'), '${format}')"><i class="fa-solid fa-sliders"></i></button>
                            <button type="button" class="btn btn-light border" title="Sửa môn" onclick="openEditModal(${item.id})"><i class="fa-solid fa-pen-to-square text-success"></i></button>
                            <label class="btn btn-light border mb-0 d-flex align-items-center" title="${item.trangThai ? 'Tắt hoạt động môn' : 'Bật hoạt động môn'}">
                                <input class="form-check-input m-0" type="checkbox" role="switch" aria-label="Trạng thái môn ${escapeHtml(item.ten)}" ${item.trangThai ? 'checked' : ''} onchange="setSportStatus(${item.id}, this.checked, this)">
                            </label>
                        </div>
                    </div>`;
        }

        function toggleCategoryNode(id) {
            const $content = $(`#categoryChildren-${id}`);
            const $toggle = $(`[data-category-node="${id}"] .sport-tree-toggle`);
            const expanded = $toggle.attr('aria-expanded') === 'true';
            $toggle.attr('aria-expanded', String(!expanded)).attr('aria-label', expanded ? 'Mở danh mục' : 'Thu gọn danh mục');
            $content.toggleClass('is-collapsed', expanded);
            $toggle.find('i').toggleClass('fa-chevron-down', !expanded).toggleClass('fa-chevron-right', expanded);
        }

        // Reusable Helper sinh mã ngẫu nhiên có cả số và chữ phía Client
        const CodeHelper = {
            generateRandomCode: function (prefix = '', len = 6) {
                if (len < 2) len = 2;
                const letters = 'ABCDEFGHJKLMNPQRSTUVWXYZ';
                const digits = '23456789';
                const allChars = letters + digits;
                let res = [
                    letters[Math.floor(Math.random() * letters.length)],
                    digits[Math.floor(Math.random() * digits.length)]
                ];
                for (let i = 2; i < len; i++) {
                    res.push(allChars[Math.floor(Math.random() * allChars.length)]);
                }
                for (let i = res.length - 1; i > 0; i--) {
                    const j = Math.floor(Math.random() * (i + 1));
                    const temp = res[i]; res[i] = res[j]; res[j] = temp;
                }
                const randomStr = res.join('');
                return prefix ? `${prefix.trim().toUpperCase()}${randomStr}` : randomStr;
            }
        };

        let isCategoryCodeManual = false;

        function autoGenerateCategoryCode() {
            $.get('/Manager/DanhMucMonTheThao/GenerateCode', function (res) {
                if (res.success && res.data) {
                    $('#categoryCode').val(res.data);
                } else {
                    $('#categoryCode').val(CodeHelper.generateRandomCode('DM', 6));
                }
            }).fail(function () {
                $('#categoryCode').val(CodeHelper.generateRandomCode('DM', 6));
            });
        }

        function openCreateCategoryModal() {
            $('#categoryId').val('');
            $('#categoryModalTitle span').text('Thêm Danh Mục Môn');
            isCategoryCodeManual = false;
            $('#categoryCode').val('').prop('readonly', false);
            $('#categoryName').val('');
            $('#categoryDescription').val('');
            $('#categoryActive').prop('checked', true);
            autoGenerateCategoryCode();
            categoryModalInstance.show();
        }

        function openEditCategoryModal(id) {
            isCategoryCodeManual = true;
            $.get('/Manager/DanhMucMonTheThao/GetById', { id: id }, function (res) {
                if (!res.success || !res.data) {
                    Swal.fire('Lỗi', res.message || 'Không tìm thấy danh mục môn.', 'error');
                    return;
                }
                const category = res.data;
                $('#categoryId').val(category.id);
                $('#categoryModalTitle span').text('Chỉnh Sửa Danh Mục Môn');
                $('#categoryCode').val(category.ma || '').prop('readonly', false);
                $('#categoryName').val(category.ten || '');
                $('#categoryDescription').val(category.moTa || '');
                $('#categoryActive').prop('checked', !!category.trangThai);
                categoryModalInstance.show();
            }).fail(function () {
                Swal.fire('Lỗi', 'Không thể tải thông tin danh mục môn.', 'error');
            });
        }

        function saveCategory(event) {
            event.preventDefault();
            const id = $('#categoryId').val();
            let ma = $('#categoryCode').val().trim().toUpperCase();
            const ten = $('#categoryName').val().trim();
            if (!ten) {
                Swal.fire('Thiếu thông tin', 'Vui lòng nhập tên danh mục.', 'warning');
                return;
            }
            if (!ma) {
                ma = CodeHelper.generateRandomCode('DM', 6);
                $('#categoryCode').val(ma);
            }

            const payload = {
                ma: ma,
                ten: ten,
                moTa: $('#categoryDescription').val().trim() || null,
                trangThai: $('#categoryActive').is(':checked')
            };
            if (!payload.ma || !payload.ten) {
                Swal.fire('Thiếu thông tin', 'Vui lòng nhập mã và tên danh mục.', 'warning');
                return;
            }

            const $button = $('#btnSaveCategory').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Đang lưu...');
            $.ajax({
                url: id ? `/Manager/DanhMucMonTheThao/Save?id=${id}` : '/Manager/DanhMucMonTheThao/Save',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload)
            }).done(function (res) {
                if (res.success) {
                    categoryModalInstance.hide();
                    SportApp.toast('success', res.message || 'Đã lưu danh mục môn.');
                    reloadTreeData();
                } else {
                    Swal.fire('Lỗi', res.message || 'Không thể lưu danh mục môn.', 'error');
                }
            }).fail(function () {
                Swal.fire('Lỗi', 'Không thể kết nối máy chủ để lưu danh mục môn.', 'error');
            }).always(function () {
                $button.prop('disabled', false).html('<i class="fa-solid fa-floppy-disk me-1"></i>Lưu danh mục');
            });
        }

        function setCategoryStatus(id, trangThai, toggle) {
            toggle.disabled = true;
            $.post('/Manager/DanhMucMonTheThao/SetStatus', { id: id, trangThai: trangThai })
                .done(function (res) {
                    if (res.success) {
                        SportApp.toast('success', res.message || 'Đã cập nhật trạng thái danh mục.');
                        reloadTreeData();
                    } else {
                        toggle.checked = !trangThai;
                        Swal.fire('Lỗi', res.message || 'Không thể cập nhật trạng thái danh mục.', 'error');
                    }
                })
                .fail(function () {
                    toggle.checked = !trangThai;
                    Swal.fire('Lỗi', 'Không thể kết nối máy chủ để cập nhật danh mục.', 'error');
                })
                .always(function () { toggle.disabled = false; });
        }

        function setSportStatus(id, trangThai, toggle) {
            toggle.disabled = true;
            $.post('/Manager/MonTheThao/SetStatus', { id: id, trangThai: trangThai })
                .done(function (res) {
                    if (res.success) {
                        SportApp.toast('success', res.message || 'Đã cập nhật trạng thái môn.');
                        reloadTreeData();
                    } else {
                        toggle.checked = !trangThai;
                        Swal.fire('Lỗi', res.message || 'Không thể cập nhật trạng thái môn.', 'error');
                    }
                })
                .fail(function () {
                    toggle.checked = !trangThai;
                    Swal.fire('Lỗi', 'Không thể kết nối máy chủ để cập nhật môn.', 'error');
                })
                .always(function () { toggle.disabled = false; });
        }

        function reloadTreeData() {
            loadCategories().then(function () {
                populateCategorySelects();
                loadData(currentPage);
            }).catch(function () {
                loadData(currentPage);
            });
        }

        function renderPagination(current, totalPages) {
            if (totalPages <= 1) {
                $('#paginationList').empty();
                return;
            }

            let pagHtml = '';
            pagHtml += `<li class="page-item ${current === 1 ? 'disabled' : ''}">
                <a class="page-link" href="javascript:void(0)" onclick="loadData(${current - 1})">&laquo;</a>
            </li>`;

            for (let i = 1; i <= totalPages; i++) {
                if (i === 1 || i === totalPages || (i >= current - 2 && i <= current + 2)) {
                    pagHtml += `<li class="page-item ${i === current ? 'active' : ''}">
                        <a class="page-link" href="javascript:void(0)" onclick="loadData(${i})">${i}</a>
                    </li>`;
                }
            }

            pagHtml += `<li class="page-item ${current === totalPages ? 'disabled' : ''}">
                <a class="page-link" href="javascript:void(0)" onclick="loadData(${current + 1})">&raquo;</a>
            </li>`;

            $('#paginationList').html(pagHtml);
        }

        let isSportCodeManual = false;

        function autoGenerateSportCode(danhMucId = null) {
            danhMucId = danhMucId !== undefined && danhMucId !== null ? danhMucId : $('#danhMucId').val();
            $.get('/Manager/MonTheThao/GenerateCode', { danhMucId: danhMucId || undefined }, function (res) {
                if (res.success && res.data) {
                    $('#ma').val(res.data);
                } else {
                    $('#ma').val(CodeHelper.generateRandomCode('MON', 6));
                }
            }).fail(function () {
                $('#ma').val(CodeHelper.generateRandomCode('MON', 6));
            });
        }

        function openCreateModal(categoryId = null) {
            $('#modalTitle span').text('Thêm Môn Thể Thao Mới');
            $('#monId').val('');
            $('#ten').val('');
            isSportCodeManual = false;
            $('#ma').val('');
            $('#danhMucId').val(categoryId || '');
            $('#loaiThiDau').val('DongDoi');
            $('#hinhThucThiDau').val('LoaiTrucTiep');
            $('#gioiTinh').val('Nam');
            $('#soLuongVdvToiThieu').val('1');
            $('#soLuongVdvToiDa').val('1');
            $('#moTa').val('');
            $('#trangThai').prop('checked', true);
            resetSportRegulations();
            formatConfigured = false;
            resetFormatForm();
            $('#fmtMonId').val('');
            $('#fmtHinhThucThiDau').val('LoaiTrucTiep');
            $('#badgeModalSportName').addClass('d-none').text('');
            setFormatConfirmation(false);
            autoGenerateSportCode(categoryId);
            new bootstrap.Tab(document.getElementById('basicSportTabButton')).show();
            $('#modalMon').modal('show');
        }

        function openEditModal(id, openConfigTab = false) {
            isSportCodeManual = true;
            $.get('/Manager/MonTheThao/GetById', { id: id }, function (res) {
                if (res.success && res.data) {
                    const item = res.data;
                    $('#modalTitle span').text('Chỉnh Sửa Môn Thể Thao');
                    $('#monId').val(item.id);
                    $('#ten').val(item.ten);
                    $('#ma').val(item.ma || '');
                    $('#danhMucId').val(item.danhMucId || '');
                    const loaiVal = item.loaiThiDau || (item.laMonDongDoi ? 'DongDoi' : 'CaNhan');
                    $('#loaiThiDau').val(loaiVal === 'CaNhan' ? 'CaNhan' : 'DongDoi');
                    $('#hinhThucThiDau').val(item.hinhThucThiDau || 'LoaiTrucTiep');
                    $('#gioiTinh').val(item.gioiTinh || 'Nam');
                    const vMin = item.soLuongVanDongVienToiThieu ?? item.soLuongVdvToiThieu ?? 1;
                    const vMax = item.soLuongVanDongVienToiDa ?? item.soLuongVdvToiDa ?? 1;
                    $('#soLuongVdvToiThieu').val(vMin);
                    $('#soLuongVdvToiDa').val(vMax);
                    $('#moTa').val(item.moTa || '');
                    $('#trangThai').prop('checked', item.trangThai);
                    loadSportRegulations(item.dieuLeMonTheThaos || []);
                    new bootstrap.Tab(document.getElementById('basicSportTabButton')).show();
                    $('#modalMon').modal('show');
                    loadFormatConfiguration(item.id, item.ten, item.hinhThucThiDau || 'LoaiTrucTiep', function () {
                        if (openConfigTab) new bootstrap.Tab(document.getElementById('formatSportTabButton')).show();
                    });
                }
            });
        }

        function saveData() {
            const id = $('#monId').val();
            const ten = $('#ten').val().trim();
            if (!ten) {
                Swal.fire('Lỗi', 'Vui lòng nhập tên môn thể thao.', 'warning');
                return;
            }
            if (!formatConfigured) {
                setFormatConfirmation(false);
                new bootstrap.Tab(document.getElementById('formatSportTabButton')).show();
                Swal.fire('Thiếu cấu hình', 'Hãy kiểm tra cấu hình trong tab vừa mở, sau đó nhấn lưu lại.', 'warning');
                return;
            }
            if (regulationUploadsInProgress > 0) {
                Swal.fire('Đang tải tệp', 'Vui lòng đợi tải xong các tệp điều lệ trước khi lưu.', 'info');
                return;
            }

            const configPayload = buildFormatPayload();
            if (!configPayload) return;

            const loaiVal = $('#loaiThiDau').val();
            const hinhThucVal = $('#hinhThucThiDau').val() || currentFormat || 'LoaiTrucTiep';
            configPayload.monTheThaoId = id ? parseInt(id, 10) : 0;
            configPayload.giaiDauMonTheThaoId = null;
            configPayload.hinhThucThiDau = hinhThucVal;
            const minVdv = parseInt($('#soLuongVdvToiThieu').val()) || 1;
            const maxVdv = parseInt($('#soLuongVdvToiDa').val()) || 1;

            let ma = $('#ma').val().trim().toUpperCase();
            if (!ma) {
                ma = CodeHelper.generateRandomCode('MON', 6);
                $('#ma').val(ma);
            }

            const payload = {
                ten: ten,
                ma: ma,
                danhMucId: $('#danhMucId').val() ? parseInt($('#danhMucId').val()) : null,
                loaiThiDau: loaiVal,
                laMonDongDoi: (loaiVal === 'DongDoi'),
                hinhThucThiDau: hinhThucVal,
                gioiTinh: $('#gioiTinh').val(),
                soLuongVanDongVienToiThieu: minVdv,
                soLuongVanDongVienToiDa: maxVdv,
                soLuongVdvToiThieu: minVdv,
                soLuongVdvToiDa: maxVdv,
                moTa: $('#moTa').val().trim() || null,
                trangThai: $('#trangThai').is(':checked'),
                dieuLeMonTheThaos: collectSportRegulations(),
                cauHinhTheThuc: configPayload
            };

            const url = id ? `/Manager/MonTheThao/Save?id=${id}` : '/Manager/MonTheThao/Save';

            $.ajax({
                url: url,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    if (res.success) {
                        $('#modalMon').modal('hide');
                        SportApp.toast('success', res.message || 'Lưu môn và cấu hình thành công!');
                        reloadTreeData();
                    } else {
                        Swal.fire('Lỗi', res.message || 'Không thể lưu môn.', 'error');
                    }
                },
                error: function () { Swal.fire('Lỗi', 'Không thể kết nối máy chủ để lưu môn và cấu hình.', 'error'); }
            });
        }

        function initializeSportRegulationEditor() {
            if (sportRegulationEditor) return;
            if (!window.ClassicEditor) {
                $('#sportRegulationUploadStatus').removeClass('text-primary').addClass('text-danger')
                    .text('Không tải được CKEditor. Hãy kiểm tra kết nối rồi tải lại trang.');
                return;
            }
            ClassicEditor.create(document.querySelector('#sportRegulationContent'), {
                toolbar: ['heading', '|', 'bold', 'italic', 'bulletedList', 'numberedList', '|', 'link', 'blockQuote', 'undo', 'redo']
            }).then(function (editor) {
                sportRegulationEditor = editor;
            }).catch(function (error) {
                console.error('Không thể khởi tạo CKEditor cho điều lệ môn:', error);
                $('#sportRegulationUploadStatus').removeClass('text-primary').addClass('text-danger')
                    .text('Không tải được trình soạn thảo. Bạn vẫn có thể thử tải lại trang.');
            });
        }

        function setSportRegulationContent(content) {
            const value = content || '';
            $('#sportRegulationContent').val(value);
            if (sportRegulationEditor) sportRegulationEditor.setData(value);
        }

        function resetSportRegulations() {
            sportRegulationContentId = 0;
            sportRegulationContentTitle = 'Điều lệ môn thi đấu';
            sportRegulationContentStatus = true;
            sportRegulationFiles = [];
            setSportRegulationContent('');
            $('#sportRegulationFiles').val('');
            $('#sportRegulationUploadStatus').removeClass('text-danger').addClass('text-primary').empty();
            renderSportRegulationFiles();
        }

        function loadSportRegulations(items) {
            const regulations = Array.isArray(items) ? items : [];
            const contentItem = regulations.find(item => !item.tepDinhKem) || null;
            sportRegulationContentId = contentItem ? (contentItem.id || 0) : 0;
            sportRegulationContentTitle = contentItem ? (contentItem.tieuDe || 'Điều lệ môn thi đấu') : 'Điều lệ môn thi đấu';
            sportRegulationContentStatus = contentItem ? contentItem.trangThai !== false : true;
            setSportRegulationContent(contentItem ? contentItem.noiDung : '');
            sportRegulationFiles = regulations.filter(item => item.tepDinhKem).map(item => ({
                id: item.id || 0,
                fileName: item.tieuDe || 'Tệp điều lệ',
                url: item.tepDinhKem,
                trangThai: item.trangThai !== false
            }));
            $('#sportRegulationFiles').val('');
            $('#sportRegulationUploadStatus').removeClass('text-danger').addClass('text-primary').empty();
            renderSportRegulationFiles();
        }

        function collectSportRegulations() {
            const content = sportRegulationEditor ? sportRegulationEditor.getData() : $('#sportRegulationContent').val();
            const plainText = (content || '').replace(/<[^>]*>/g, ' ').replace(/&nbsp;|&#160;/gi, ' ').trim();
            const regulations = [];
            if (plainText) {
                regulations.push({
                    id: sportRegulationContentId,
                    tieuDe: sportRegulationContentTitle,
                    noiDung: content,
                    tepDinhKem: null,
                    thuTu: 0,
                    trangThai: sportRegulationContentStatus
                });
            }
            sportRegulationFiles.forEach((file, index) => regulations.push({
                id: file.id || 0,
                tieuDe: file.fileName,
                noiDung: '',
                tepDinhKem: file.url,
                thuTu: index + 1,
                trangThai: file.trangThai !== false
            }));
            return regulations;
        }

        async function uploadSportRegulationFiles(files) {
            if (!files.length) return;
            regulationUploadsInProgress++;
            $('#sportRegulationUploadStatus').removeClass('text-danger').addClass('text-primary')
                .text(`Đang tải ${files.length} tệp điều lệ...`);
            try {
                for (const file of files) {
                    const formData = new FormData();
                    formData.append('file', file);
                    const response = await $.ajax({
                        url: '/Manager/MonTheThao/UploadRegulationFile',
                        type: 'POST',
                        data: formData,
                        processData: false,
                        contentType: false
                    });
                    if (!response.success) throw new Error(response.message || `Không thể tải tệp ${file.name}.`);
                    sportRegulationFiles.push({ id: 0, fileName: response.fileName || file.name, url: response.url });
                }
                $('#sportRegulationUploadStatus').removeClass('text-danger').addClass('text-success')
                    .text('Đã tải xong các tệp. Nhấn nút lưu môn để hoàn tất.');
                renderSportRegulationFiles();
            } catch (error) {
                const message = error.responseJSON?.message ||
                    (error.status ? `Máy chủ trả về lỗi HTTP ${error.status} khi tải tệp.` : '') ||
                    error.message || 'Tải tệp điều lệ thất bại.';
                $('#sportRegulationUploadStatus').removeClass('text-primary text-success').addClass('text-danger').text(message);
                Swal.fire('Không tải được tệp', message, 'error');
            } finally {
                regulationUploadsInProgress--;
                $('#sportRegulationFiles').val('');
            }
        }

        function renderSportRegulationFiles() {
            const $list = $('#sportRegulationFileList').empty();
            if (!sportRegulationFiles.length) {
                $list.html('<div class="text-muted small py-2">Chưa có tệp điều lệ nào được tải lên.</div>');
                return;
            }
            sportRegulationFiles.forEach((file, index) => {
                const safeUrl = escapeHtml(file.url || '#');
                const safeName = escapeHtml(file.fileName || 'Tệp điều lệ');
                $list.append(`<div class="list-group-item d-flex justify-content-between align-items-center gap-3">
                    <a class="regulation-file-link text-decoration-none" href="${safeUrl}" target="_blank" rel="noopener noreferrer"><i class="fa-solid fa-file-lines text-primary me-2"></i>${safeName}</a>
                    <button type="button" class="btn btn-sm btn-outline-danger flex-shrink-0" onclick="removeSportRegulationFile(${index})" aria-label="Gỡ tệp"><i class="fa-solid fa-xmark"></i></button>
                </div>`);
            });
        }

        function removeSportRegulationFile(index) {
            sportRegulationFiles.splice(index, 1);
            renderSportRegulationFiles();
        }

        function resetFilter() {
            $('#keyword').val('');
            $('#danhMucFilter').val('');
            $('#gioiTinhFilter').val('');
            $('#hinhThucFilter').val('');
            $('#quyMoFilter').val('');
            $('#trangThaiFilter').val('');
            $('#categoryStatusFilter').val('');
            loadData(1);
        }

        function escapeHtml(text) {
            if (!text) return '';
            return $('<div>').text(text).html();
        }

        // ================= CẤU HÌNH THỂ THỨC & LUẬT THI ĐẤU (THIẾT KẾ MỚI) =================

        let currentFormat = 'LoaiTrucTiep';
        let lastHeadToHeadScoringMode = 'ThoiGianHiep';

        // Switch tab + highlight card
        function switchFormat(format) {
            currentFormat = format;
            $('#fmtHinhThucThiDau').val(format);
            if (format === 'TinhDiemXepHang') {
                const selectedMode = $('#fmtLoaiTheThuc').val();
                if (selectedMode && selectedMode !== 'TinhDiemXepHang') lastHeadToHeadScoringMode = selectedMode;
                $('#fmtLoaiTheThuc').val('TinhDiemXepHang');
            } else if ($('#fmtLoaiTheThuc').val() === 'TinhDiemXepHang') {
                $('#fmtLoaiTheThuc').val(lastHeadToHeadScoringMode || 'ThoiGianHiep');
            }

            // Tab card styles
            const tabMap = {
                'LoaiTrucTiep': 'fmt-active',
                'VongBang': 'fmt-active-rr',
                'KetHopVongBangVaLoaiTrucTiep': 'fmt-active-grp',
                'TinhDiemXepHang': 'fmt-active-perf'
            };
            $('.fmt-tab-card').removeClass('fmt-active fmt-active-rr fmt-active-grp fmt-active-perf');
            $(`#tabCard_${format}`).addClass(tabMap[format]);

            // Panel visibility
            const panelMap = {
                'LoaiTrucTiep': 'mechLoaiTrucTiep',
                'VongBang': 'mechVongBang',
                'KetHopVongBangVaLoaiTrucTiep': 'mechKetHop',
                'TinhDiemXepHang': 'mechTinhDiem'
            };
            $('.format-mechanism-panel').addClass('d-none');
            $(`#${panelMap[format]}`).removeClass('d-none');
            onScoringModeChange();
        }

        function getPeriodUnit() {
            return $('#fmtLoaiTheThuc').val() === 'SetDiem' ? 'Set' : 'Hiệp';
        }

        function onScoringModeChange() {
            const mode = $('#fmtLoaiTheThuc').val() || 'ThoiGianHiep';
            if (mode === 'TinhDiemXepHang' && currentFormat !== 'TinhDiemXepHang') {
                switchFormat('TinhDiemXepHang');
                return;
            }
            if (mode !== 'TinhDiemXepHang') lastHeadToHeadScoringMode = mode;
            const periodUnit = mode === 'SetDiem' ? 'Set' : 'Hiệp';
            $('#fmtLoaiTheThuc').prop('disabled', currentFormat === 'TinhDiemXepHang');
            $('#setScoringOptions').toggleClass('d-none', mode !== 'SetDiem');
            $('#scoreModeSummary').toggleClass('alert-primary', mode === 'ThoiGianHiep')
                .toggleClass('alert-success', mode === 'SetDiem')
                .toggleClass('alert-warning', mode === 'TinhDiemXepHang');

            if (mode === 'SetDiem') {
                $('#scoreModeSummary').html('<strong>Điểm theo set:</strong> trọng tài nhập điểm từng pha trong set hiện tại; set kết thúc theo điểm đích/cách biệt; tỉ số trận là số set thắng.');
            } else if (mode === 'TinhDiemXepHang') {
                $('#scoreModeSummary').html('<strong>Đo thành tích:</strong> ghi thành tích từng vận động viên/làn và xếp hạng; không cộng tỉ số hai đội.');
            } else {
                $('#scoreModeSummary').html('<strong>Điểm theo hiệp:</strong> trọng tài nhập điểm trong hiệp hiện tại; tỉ số trận bằng tổng điểm các hiệp chính.');
            }

            $('#ko_periodTitle').text(mode === 'SetDiem' ? 'Số set trận đấu' : 'Số hiệp trận đấu');
            $('#ko_soHiepLabel, #rr_soHiepLabel, #comb_soHiepLabel').each(function () {
                const value = parseInt(String($(this).text()), 10) || 0;
                $(this).text(`${value} ${periodUnit}`);
            });
            $('.koHiepBtn, .rrHiepBtn, .combHiepBtn').each(function () {
                const value = parseInt($(this).text(), 10);
                if (Number.isInteger(value)) $(this).text(`${value} ${periodUnit}`);
            });
            updateAllComputedTimes();
        }

        // Compatibility alias
        function onFormatSelectChange() { switchFormat($('#fmtHinhThucThiDau').val()); }

        // Set field value + update label + mark active button
        function setFmtVal(inputId, labelId, value, unit, groupClass, btn) {
            $(`#${inputId}`).val(value);
            if (['koHiepBtn', 'rrHiepBtn', 'combHiepBtn'].includes(groupClass)) unit = getPeriodUnit();
            if (labelId) $(`#${labelId}`).text(`${value} ${unit}`);
            if (groupClass) {
                $(`.${groupClass}`).removeClass('active');
                if (btn) $(btn).addClass('active');
            }
            updateAllComputedTimes();
        }

        // ---- Computed time updaters ----
        function updateKoComputedTime() {
            const h = parseInt($('#ko_soHiep').val()) || 0;
            const t = parseInt($('#ko_tgHiep').val()) || 0;
            const total = h * t;
            const periodUnit = getPeriodUnit();
            $('#ko_totalTime').val(total);
            $('#ko_totalTimeHint').text(`${h} ${periodUnit.toLowerCase()} x ${t}p = ${total} phút`);
            $('#ko_soHiepLabel').text(`${h} ${periodUnit}`);
            $('#ko_tgHiepLabel').text(`${t} Phút`);
        }
        function updateKoPhuComputedTime() {
            const h = parseInt($('#ko_soHiepPhu').val()) || 0;
            const t = parseInt($('#ko_tgHiepPhu').val()) || 0;
            const total = h * t;
            $('#ko_totalPhuTime').val(total);
            $('#ko_totalPhuTimeHint').text(`${h} hiệp phụ x ${t}p = ${total} phút`);
            $('#ko_soHiepPhuLabel').text(`${h} Hiệp`);
            $('#ko_tgPhuLabel').text(`${t} Phút`);
        }
        function updateRrComputedTime() {
            const h = parseInt($('#rr_soHiep').val()) || 0;
            const t = parseInt($('#rr_tgHiep').val()) || 0;
            const total = h * t;
            const periodUnit = getPeriodUnit();
            $('#rr_totalTime').val(total);
            $('#rr_totalTimeHint').text(`${h} ${periodUnit.toLowerCase()} x ${t}p = ${total} phút`);
            $('#rr_soHiepLabel').text(`${h} ${periodUnit}`);
            $('#rr_tgHiepLabel').text(`${t} Phút`);
        }
        function updateCombComputedTime() {
            const h = parseInt($('#comb_soHiep').val()) || 0;
            const t = parseInt($('#comb_tgHiep').val()) || 0;
            const total = h * t;
            const periodUnit = getPeriodUnit();
            $('#comb_totalTime').val(total);
            $('#comb_totalTimeHint').text(`${h} ${periodUnit.toLowerCase()} x ${t}p = ${total} phút`);
            $('#comb_soHiepLabel').text(`${h} ${periodUnit}`);
            $('#comb_tgHiepLabel').text(`${t} Phút`);
        }
        function updateCombPhuComputedTime() {
            const h = parseInt($('#comb_soHiepPhu').val()) || 0;
            const t = parseInt($('#comb_tgHiepPhu').val()) || 0;
            const total = h * t;
            $('#comb_totalPhuTime').val(total);
            $('#comb_totalPhuTimeHint').text(`${h} hiệp phụ x ${t}p = ${total} phút`);
            $('#comb_soHiepPhuLabel').text(`${h} Hiệp`);
            $('#comb_tgPhuLabel').text(`${t} Phút`);
        }
        function updateAllComputedTimes() {
            updateKoComputedTime();
            updateKoPhuComputedTime();
            updateRrComputedTime();
            updateCombComputedTime();
            updateCombPhuComputedTime();
        }

        // ---- Quick time presets (inline buttons) ----
        function applyKoTimePreset(hiep, tg, nghi) {
            $('#ko_soHiep').val(hiep); $('#ko_tgHiep').val(tg); $('#ko_nghi').val(nghi);
            $('#ko_nghiLabel').text(`${nghi} Phút`);
            updateKoComputedTime();
            setActiveQbtn('.koHiepBtn', hiep); setActiveQbtn('.koTgHiepBtn', tg); setActiveQbtn('.koNghiBtn', nghi);
        }
        function applyRrTimePreset(hiep, tg, nghi) {
            $('#rr_soHiep').val(hiep); $('#rr_tgHiep').val(tg); $('#rr_nghi').val(nghi);
            $('#rr_nghiLabel').text(`${nghi} Phút`);
            updateRrComputedTime();
            setActiveQbtn('.rrHiepBtn', hiep); setActiveQbtn('.rrTgBtn', tg); setActiveQbtn('.rrNghiBtn', nghi);
        }
        function applyCombTimePreset(hiep, tg, nghi) {
            $('#comb_soHiep').val(hiep); $('#comb_tgHiep').val(tg); $('#comb_nghi').val(nghi);
            $('#comb_nghiLabel').text(`${nghi} Phút`);
            updateCombComputedTime();
            setActiveQbtn('.combHiepBtn', hiep); setActiveQbtn('.combTgBtn', tg); setActiveQbtn('.combNghiBtn', nghi);
        }
        function setActiveQbtn(selector, value) {
            $(selector).each(function() {
                const btnTxt = $(this).text().trim();
                const btnVal = parseFloat(btnTxt);
                $(this).toggleClass('active', btnVal === parseFloat(value));
            });
        }

        // ---- Criteria up/down ----
        function moveCriteria(listId, btn, direction) {
            const $row = $(btn).closest('.fmt-criteria-row');
            const $list = $(`#${listId}`);
            const $rows = $list.find('.fmt-criteria-row');
            const idx = $rows.index($row);
            if (direction === -1 && idx > 0) {
                $row.insertBefore($rows.eq(idx - 1));
            } else if (direction === 1 && idx < $rows.length - 1) {
                $row.insertAfter($rows.eq(idx + 1));
            }
            $list.find('.fmt-criteria-row').each(function(i) {
                $(this).find('.fmt-num-badge').text(`#${i + 1}`);
            });
        }

        // ---- Nạp cấu hình môn vào tab trong form thêm/sửa ----
        function openFormatModal(monId, monTen, hinhThucThiDau) {
            openEditModal(monId, true);
        }

        function loadFormatConfiguration(monId, monTen, hinhThucThiDau, onLoaded) {
            formatConfigured = false;
            resetFormatForm();
            $('#fmtMonId').val(monId || '');
            $('#fmtHinhThucThiDau').val(hinhThucThiDau || 'LoaiTrucTiep');
            $('#badgeModalSportName').text(monTen || (monId ? `#${monId}` : '')).toggleClass('d-none', !monId);
            $('#formatModalSubtitle').html(`Môn: <strong>${escapeHtml(monTen || 'Môn mới')}</strong> &nbsp;·&nbsp; Cấu hình thể thức và cách tính điểm`);
            if (hinhThucThiDau) switchFormat(hinhThucThiDau);

            if (!monId) {
                setFormatConfirmation(false);
                if (typeof onLoaded === 'function') onLoaded();
                return;
            }

            $.get('/Manager/CauHinhTheThuc/GetConfig', { monTheThaoId: monId }, function (res) {
                if (res && res.success && res.data) {
                    populateFormatForm(res.data);
                    formatConfigured = Number(res.data.id || 0) > 0;
                } else if (hinhThucThiDau) {
                    switchFormat(hinhThucThiDau);
                }
                setFormatConfirmation(formatConfigured);
                if (typeof onLoaded === 'function') onLoaded();
            }).fail(function () {
                if (hinhThucThiDau) switchFormat(hinhThucThiDau);
                setFormatConfirmation(false);
                if (typeof onLoaded === 'function') onLoaded();
            });
        }

        function setFormatConfirmation(isConfigured) {
            const $notice = $('#formatRequiredNotice');
            if (isConfigured) {
                $notice.removeClass('alert-warning d-none').addClass('alert-success')
                    .html('<i class="fa-solid fa-circle-check me-1"></i>Đã xác nhận cấu hình môn thi đấu. Cấu hình sẽ được lưu cùng thông tin môn.');
            } else {
                $notice.removeClass('alert-success d-none').addClass('alert-warning')
                    .html('<i class="fa-solid fa-circle-exclamation me-1"></i>Hãy mở và xác nhận cấu hình thể thức trước khi lưu môn thi đấu.');
            }
        }

        // ---- Reset form ----
        function resetFormatForm() {
            $('#fmtLoaiTheThuc').val('ThoiGianHiep');
            $('#scoreSetsToWin').val(2);
            $('#scorePointsPerSet').val(21);
            $('#scoreDecidingSetPoints').val(21);
            $('#scoreMinimumLead').val(2);
            $('#scorePointCap').val(30);
            lastHeadToHeadScoringMode = 'ThoiGianHiep';

            // KO defaults
            applyKoTimePreset(2, 45, 15);
            $('#ko_coTranhHangBa').prop('checked', true);
            $('#ko_coHiepPhu').prop('checked', true);
            $('#ko_overtimeSub').show();
            $('#ko_soHiepPhu').val(2); $('#ko_tgHiepPhu').val(15);
            updateKoPhuComputedTime();
            setActiveQbtn('.koPhuHiepBtn', 2); setActiveQbtn('.koPhuTgBtn', 15);
            $('#ko_coPenalty').prop('checked', true);

            // RR defaults
            applyRrTimePreset(2, 45, 15);
            $('#rr_diemThang').val(3); $('#rr_diemHoa').val(1); $('#rr_diemThua').val(0);

            // Comb defaults
            applyCombTimePreset(2, 45, 15);
            $('#comb_soBang').val(4);
            $('#comb_soDoiMoiBangVaoVongTrong').val(2);
            $('#comb_diemThang').val(3); $('#comb_diemHoa').val(1); $('#comb_diemThua').val(0);
            $('#comb_coTranhHangBa').prop('checked', true);
            $('#comb_coHiepPhu').prop('checked', true);
            $('#comb_overtimeSub').show();
            $('#comb_soHiepPhu').val(2); $('#comb_tgHiepPhu').val(15);
            updateCombPhuComputedTime();
            setActiveQbtn('.combPhuHiepBtn', 2); setActiveQbtn('.combPhuTgBtn', 15);
            $('#comb_coPenalty').prop('checked', true);

            $('#fmtPresetSelect').val('');
            switchFormat('LoaiTrucTiep');
            onScoringModeChange();
        }

        // ---- Populate from API data ----
        function populateFormatForm(data) {
            const format = data.hinhThucThiDau || 'LoaiTrucTiep';
            const scoringMode = data.loaiTheThuc || (format === 'TinhDiemXepHang' ? 'TinhDiemXepHang' : 'ThoiGianHiep');
            $('#fmtLoaiTheThuc').val(scoringMode);
            lastHeadToHeadScoringMode = scoringMode === 'TinhDiemXepHang' ? 'ThoiGianHiep' : scoringMode;
            $('#scoreSetsToWin').val(data.soHiepThangDeThangTran ?? 2);
            $('#scorePointsPerSet').val(data.diemMoiHiep ?? 21);
            $('#scoreDecidingSetPoints').val(data.diemHiepQuyetDinh ?? 21);
            $('#scoreMinimumLead').val(data.cachBietDiemToiThieu ?? 2);
            $('#scorePointCap').val(data.diemToiDaMoiHiep ?? 0);

            if (format === 'LoaiTrucTiep') {
                const h = data.soHiepToiDa || 2, t = data.thoiGianHiepChinhPhut || 45, n = data.nghiGiuaTranPhut ?? 15;
                applyKoTimePreset(h, t, n);
                const coHiepPhu = !!data.coHiepPhu;
                $('#ko_coTranhHangBa').prop('checked', data.coTranhHangBa !== false);
                $('#ko_coHiepPhu').prop('checked', coHiepPhu);
                $('#ko_overtimeSub').toggle(coHiepPhu);
                if (coHiepPhu) {
                    const ph = data.soHiepPhu || 2, pt = data.thoiGianHiepPhuPhut || 15;
                    $('#ko_soHiepPhu').val(ph); $('#ko_tgHiepPhu').val(pt);
                    updateKoPhuComputedTime();
                    setActiveQbtn('.koPhuHiepBtn', ph); setActiveQbtn('.koPhuTgBtn', pt);
                }
                $('#ko_coPenalty').prop('checked', data.coPenalty !== false);
            } else if (format === 'VongBang') {
                const h = data.soHiepToiDa || 2, t = data.thoiGianHiepChinhPhut || 45, n = data.nghiGiuaTranPhut ?? 15;
                applyRrTimePreset(h, t, n);
                $('#rr_diemThang').val(data.diemThang ?? 3);
                $('#rr_diemHoa').val(data.diemHoa ?? 1);
                $('#rr_diemThua').val(data.diemThua ?? 0);
            } else if (format === 'KetHopVongBangVaLoaiTrucTiep') {
                const h = data.soHiepToiDa || 2, t = data.thoiGianHiepChinhPhut || 45, n = data.nghiGiuaTranPhut ?? 15;
                applyCombTimePreset(h, t, n);
                $('#comb_soBang').val(data.soBang || 4);
                $('#comb_soDoiMoiBangVaoVongTrong').val(data.soDoiMoiBangVaoVongTrong || 2);
                $('#comb_diemThang').val(data.diemThang ?? 3);
                $('#comb_diemHoa').val(data.diemHoa ?? 1);
                $('#comb_diemThua').val(data.diemThua ?? 0);
                $('#comb_coTranhHangBa').prop('checked', data.coTranhHangBa !== false);
                const coHiepPhu = !!data.coHiepPhu;
                $('#comb_coHiepPhu').prop('checked', coHiepPhu);
                $('#comb_overtimeSub').toggle(coHiepPhu);
                if (coHiepPhu) {
                    const ph = data.soHiepPhu || 2, pt = data.thoiGianHiepPhuPhut || 15;
                    $('#comb_soHiepPhu').val(ph); $('#comb_tgHiepPhu').val(pt);
                    updateCombPhuComputedTime();
                    setActiveQbtn('.combPhuHiepBtn', ph); setActiveQbtn('.combPhuTgBtn', pt);
                }
                $('#comb_coPenalty').prop('checked', data.coPenalty !== false);
            }

            switchFormat(format);
        }

        // ---- Auto-guess preset from sport name ----
        function guessPreset(name) {
            const s = (name || '').toLowerCase();
            if (s.includes('bóng đá') || s.includes('football')) applyPreset('football');
            else if (s.includes('futsal')) applyPreset('futsal');
            else if (s.includes('bóng chuyền') || s.includes('volleyball')) applyPreset('volleyball');
            else if (s.includes('bóng rổ') || s.includes('basketball')) applyPreset('basketball');
            else if (s.includes('bóng bàn') || s.includes('table tennis')) applyPreset('tabletennis');
            else if (s.includes('cầu lông') || s.includes('badminton')) applyPreset('badminton');
            else if (s.includes('điền kinh') || s.includes('chạy')) applyPreset('athletics');
            else if (s.includes('bơi') || s.includes('swimming')) applyPreset('swimming');
        }

        // ---- Apply preset from dropdown ----
        function applyPresetFromSelect(val) {
            if (val) { applyPreset(val); setTimeout(() => $('#fmtPresetSelect').val(''), 100); }
        }

        // ---- Apply preset ----
        function applyPreset(preset) {
            switch (preset) {
                case 'football':
                    $('#fmtLoaiTheThuc').val('ThoiGianHiep');
                    switchFormat('KetHopVongBangVaLoaiTrucTiep');
                    applyCombTimePreset(2, 45, 15);
                    $('#comb_soBang').val(4); $('#comb_soDoiMoiBangVaoVongTrong').val(2);
                    $('#comb_diemThang').val(3); $('#comb_diemHoa').val(1); $('#comb_diemThua').val(0);
                    $('#comb_coTranhHangBa').prop('checked', true);
                    $('#comb_coHiepPhu').prop('checked', true); $('#comb_overtimeSub').show();
                    $('#comb_soHiepPhu').val(2); $('#comb_tgHiepPhu').val(15); updateCombPhuComputedTime();
                    setActiveQbtn('.combPhuHiepBtn', 2); setActiveQbtn('.combPhuTgBtn', 15);
                    $('#comb_coPenalty').prop('checked', true); break;
                case 'futsal':
                    $('#fmtLoaiTheThuc').val('ThoiGianHiep');
                    switchFormat('KetHopVongBangVaLoaiTrucTiep');
                    applyCombTimePreset(2, 20, 10);
                    $('#comb_soBang').val(4); $('#comb_soDoiMoiBangVaoVongTrong').val(2);
                    $('#comb_diemThang').val(3); $('#comb_diemHoa').val(1); $('#comb_diemThua').val(0);
                    $('#comb_coTranhHangBa').prop('checked', true);
                    $('#comb_coHiepPhu').prop('checked', true); $('#comb_overtimeSub').show();
                    $('#comb_soHiepPhu').val(2); $('#comb_tgHiepPhu').val(5); updateCombPhuComputedTime();
                    setActiveQbtn('.combPhuHiepBtn', 2); setActiveQbtn('.combPhuTgBtn', 5);
                    $('#comb_coPenalty').prop('checked', true); break;
                case 'volleyball':
                    $('#fmtLoaiTheThuc').val('SetDiem');
                    $('#scoreSetsToWin').val(3); $('#scorePointsPerSet').val(25);
                    $('#scoreDecidingSetPoints').val(15); $('#scoreMinimumLead').val(2); $('#scorePointCap').val(0);
                    switchFormat('KetHopVongBangVaLoaiTrucTiep');
                    applyCombTimePreset(5, 25, 15);
                    $('#comb_soBang').val(2); $('#comb_soDoiMoiBangVaoVongTrong').val(2);
                    $('#comb_diemThang').val(3); $('#comb_diemHoa').val(1);
                    $('#comb_coTranhHangBa').prop('checked', true);
                    $('#comb_coHiepPhu').prop('checked', false); $('#comb_overtimeSub').hide();
                    $('#comb_coPenalty').prop('checked', false); break;
                case 'basketball':
                    $('#fmtLoaiTheThuc').val('ThoiGianHiep');
                    switchFormat('LoaiTrucTiep');
                    applyKoTimePreset(4, 12, 5);
                    $('#ko_coTranhHangBa').prop('checked', true);
                    $('#ko_coHiepPhu').prop('checked', true); $('#ko_overtimeSub').show();
                    $('#ko_soHiepPhu').val(1); $('#ko_tgHiepPhu').val(5); updateKoPhuComputedTime();
                    setActiveQbtn('.koPhuHiepBtn', 1); setActiveQbtn('.koPhuTgBtn', 5);
                    $('#ko_coPenalty').prop('checked', false); break;
                case 'badminton':
                    $('#fmtLoaiTheThuc').val('SetDiem');
                    $('#scoreSetsToWin').val(2); $('#scorePointsPerSet').val(21);
                    $('#scoreDecidingSetPoints').val(21); $('#scoreMinimumLead').val(2); $('#scorePointCap').val(30);
                    switchFormat('LoaiTrucTiep');
                    applyKoTimePreset(3, 30, 15);
                    $('#ko_coHiepPhu').prop('checked', false); $('#ko_overtimeSub').hide();
                    $('#ko_coPenalty').prop('checked', false);
                    $('#ko_coTranhHangBa').prop('checked', true); break;
                case 'tabletennis':
                    $('#fmtLoaiTheThuc').val('SetDiem');
                    $('#scoreSetsToWin').val(3); $('#scorePointsPerSet').val(11);
                    $('#scoreDecidingSetPoints').val(11); $('#scoreMinimumLead').val(2); $('#scorePointCap').val(0);
                    switchFormat('VongBang');
                    applyRrTimePreset(5, 15, 10);
                    $('#rr_diemThang').val(2); $('#rr_diemHoa').val(1); $('#rr_diemThua').val(0); break;
                case 'athletics':
                case 'swimming':
                    $('#fmtLoaiTheThuc').val('TinhDiemXepHang');
                    switchFormat('TinhDiemXepHang'); break;
            }
            onScoringModeChange();
            if (window.SportApp && SportApp.toast) SportApp.toast('info', `Đã áp dụng mẫu: ${preset.toUpperCase()}`);
        }

        // ---- Thu thập và kiểm tra cấu hình để lưu cùng thông tin môn ----
        function buildFormatPayload() {
            const hinhThuc = currentFormat;
            const scoringMode = hinhThuc === 'TinhDiemXepHang' ? 'TinhDiemXepHang' : $('#fmtLoaiTheThuc').val();
            const periodSelector = hinhThuc === 'VongBang' ? '#rr_soHiep'
                : hinhThuc === 'KetHopVongBangVaLoaiTrucTiep' ? '#comb_soHiep' : '#ko_soHiep';
            const periodCount = parseInt($(periodSelector).val(), 10);
            if (scoringMode !== 'TinhDiemXepHang' && (!Number.isInteger(periodCount) || periodCount < 1 || periodCount > 15)) {
                Swal.fire('Cấu hình chưa hợp lệ', 'Số hiệp/set tối đa phải từ 1 đến 15.', 'warning');
                return null;
            }
            if (scoringMode === 'SetDiem') {
                const setsToWin = parseInt($('#scoreSetsToWin').val(), 10);
                const pointsPerSet = parseInt($('#scorePointsPerSet').val(), 10);
                const decidingSetPoints = parseInt($('#scoreDecidingSetPoints').val(), 10);
                const minimumLead = parseInt($('#scoreMinimumLead').val(), 10);
                const pointCap = parseInt($('#scorePointCap').val(), 10);
                if (!Number.isInteger(setsToWin) || setsToWin < 1 || setsToWin > periodCount ||
                    !Number.isInteger(pointsPerSet) || pointsPerSet < 1 ||
                    !Number.isInteger(decidingSetPoints) || decidingSetPoints < 1 ||
                    !Number.isInteger(minimumLead) || minimumLead < 1 ||
                    !Number.isInteger(pointCap) || pointCap < 0) {
                    Swal.fire('Cấu hình set chưa hợp lệ', 'Kiểm tra số set thắng, điểm đích, cách biệt và điểm trần; số set thắng phải không vượt quá số set tối đa.', 'warning');
                    return null;
                }
            }
            let payload = { hinhThucThiDau: hinhThuc };

            if (hinhThuc === 'LoaiTrucTiep') {
                payload.soHiepToiDa            = parseInt($('#ko_soHiep').val()) || 2;
                payload.thoiGianHiepChinhPhut  = parseInt($('#ko_tgHiep').val()) || 45;
                payload.nghiGiuaTranPhut        = parseInt($('#ko_nghi').val()) || 15;
                payload.thoiLuongTranPhut       = parseInt($('#ko_totalTime').val()) || 90;
                payload.coTranhHangBa           = $('#ko_coTranhHangBa').is(':checked');
                payload.coHiepPhu               = $('#ko_coHiepPhu').is(':checked');
                payload.soHiepPhu               = parseInt($('#ko_soHiepPhu').val()) || 2;
                payload.thoiGianHiepPhuPhut      = parseInt($('#ko_tgHiepPhu').val()) || 15;
                payload.coPenalty               = $('#ko_coPenalty').is(':checked');
                payload.soLuotPenaltyMoiDoi     = 5;
                payload.soBang                  = 0;
                payload.soDoiMoiBang             = 2;
                payload.soDoiMoiBangVaoVongTrong = 1;
            } else if (hinhThuc === 'VongBang') {
                payload.soHiepToiDa            = parseInt($('#rr_soHiep').val()) || 2;
                payload.thoiGianHiepChinhPhut  = parseInt($('#rr_tgHiep').val()) || 45;
                payload.nghiGiuaTranPhut        = parseInt($('#rr_nghi').val()) || 15;
                payload.thoiLuongTranPhut       = parseInt($('#rr_totalTime').val()) || 90;
                payload.diemThang               = parseFloat($('#rr_diemThang').val()) || 3;
                payload.diemHoa                 = parseFloat($('#rr_diemHoa').val()) || 1;
                payload.diemThua                = parseFloat($('#rr_diemThua').val()) || 0;
                payload.choPhepHoaVongBang       = true;
                payload.soBang                  = 1;
                payload.soDoiMoiBang             = 4;
                payload.soDoiMoiBangVaoVongTrong = 1;
                // Criteria order
                const crit = [];
                $('#rr_criteriaList .fmt-criteria-row').each(function() {
                    if ($(this).find('.fmt-criteria-cb').is(':checked')) crit.push($(this).data('criteria-id'));
                });
                payload.tieuChiXepHang = crit;
            } else if (hinhThuc === 'KetHopVongBangVaLoaiTrucTiep') {
                payload.soHiepToiDa              = parseInt($('#comb_soHiep').val()) || 2;
                payload.thoiGianHiepChinhPhut    = parseInt($('#comb_tgHiep').val()) || 45;
                payload.nghiGiuaTranPhut          = parseInt($('#comb_nghi').val()) || 15;
                payload.thoiLuongTranPhut         = parseInt($('#comb_totalTime').val()) || 90;
                payload.soBang                    = parseInt($('#comb_soBang').val()) || 4;
                payload.soDoiMoiBangVaoVongTrong  = parseInt($('#comb_soDoiMoiBangVaoVongTrong').val()) || 2;
                payload.diemThang                 = parseFloat($('#comb_diemThang').val()) || 3;
                payload.diemHoa                   = parseFloat($('#comb_diemHoa').val()) || 1;
                payload.diemThua                  = parseFloat($('#comb_diemThua').val()) || 0;
                payload.coTranhHangBa             = $('#comb_coTranhHangBa').is(':checked');
                payload.coHiepPhu                 = $('#comb_coHiepPhu').is(':checked');
                payload.soHiepPhu                 = parseInt($('#comb_soHiepPhu').val()) || 2;
                payload.thoiGianHiepPhuPhut       = parseInt($('#comb_tgHiepPhu').val()) || 15;
                payload.coPenalty                 = $('#comb_coPenalty').is(':checked');
                payload.soLuotPenaltyMoiDoi       = 5;
                payload.choPhepHoaVongBang        = true;
                const crit = [];
                $('#comb_criteriaList .fmt-criteria-row').each(function() {
                    if ($(this).find('.fmt-criteria-cb').is(':checked')) crit.push($(this).data('criteria-id'));
                });
                payload.tieuChiXepHang = crit;
            } else if (hinhThuc === 'TinhDiemXepHang') {
                payload.loaiTheThuc = 'TinhDiemXepHang';
            }

            payload.loaiTheThuc = scoringMode;
            if (scoringMode !== 'TinhDiemXepHang') {
                payload.soHiepToiDa = periodCount;
            }
            if (scoringMode === 'SetDiem') {
                payload.soHiepThangDeThangTran = parseInt($('#scoreSetsToWin').val(), 10);
                payload.diemMoiHiep = parseInt($('#scorePointsPerSet').val(), 10);
                payload.diemHiepQuyetDinh = parseInt($('#scoreDecidingSetPoints').val(), 10);
                payload.cachBietDiemToiThieu = parseInt($('#scoreMinimumLead').val(), 10);
                payload.diemToiDaMoiHiep = parseInt($('#scorePointCap').val(), 10);
                payload.cachTinhDiemTheoSet = true;
            } else {
                payload.cachTinhDiemTheoSet = false;
            }

            return payload;
        }

        // Init on page load
        $(document).ready(function() {
            updateAllComputedTimes();
            switchFormat('LoaiTrucTiep');
        });
    </script>
}
