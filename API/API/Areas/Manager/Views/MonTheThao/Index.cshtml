@using Dms.Application.DTOs
@{
    ViewData["Title"] = "Quản lý Môn Thể Thao";
    Layout = "~/Areas/Manager/Views/Shared/_ManagerLayout.cshtml";
    var danhMucs = ViewBag.DanhMucs as IEnumerable<DanhMucMonTheThaoDto> ?? Enumerable.Empty<DanhMucMonTheThaoDto>();
}

<div class="container-fluid p-0">
    <div class="card card-custom border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-body p-4">
            <!-- Header -->
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 pb-3 mb-4 border-bottom">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 bg-primary-subtle text-primary rounded-4">
                        <i class="fa-solid fa-volleyball fs-4"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-1 text-dark">Quản Lý Môn Thể Thao Thi Đấu</h4>
                        <p class="text-muted small mb-0">Cấu hình danh mục môn, thể thức thi đấu, giới tính và quy định số lượng VĐV.</p>
                    </div>
                </div>
                <div>
                    <button type="button" class="btn btn-primary px-3 py-2 fw-semibold rounded-3 d-inline-flex align-items-center gap-2 shadow-sm" onclick="openCreateModal()">
                        <i class="fa-solid fa-plus"></i> Thêm Môn Thể Thao Mới
                    </button>
                </div>
            </div>

            <!-- Bộ lọc tìm kiếm -->
            <div class="p-3 bg-light rounded-3 mb-4 border">
                <div class="row g-2 align-items-center">
                    <div class="col-md-3">
                        <div class="input-group bg-white rounded-3 border overflow-hidden">
                            <span class="input-group-text bg-white border-0 text-muted ps-3">
                                <i class="fa-solid fa-magnifying-glass"></i>
                            </span>
                            <input type="text" id="keyword" class="form-control border-0 shadow-none ps-2" placeholder="Tìm tên, mã môn...">
                        </div>
                    </div>
                    <div class="col-md-2">
                        <select id="danhMucFilter" class="form-select bg-white border rounded-3 shadow-none">
                            <option value="">-- Danh mục --</option>
                            @foreach (var dm in danhMucs)
                            {
                                <option value="@dm.Id">@dm.Ten</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select id="hinhThucFilter" class="form-select bg-white border rounded-3 shadow-none">
                            <option value="">-- Sơ đồ thi đấu --</option>
                            <option value="LoaiTrucTiep">Loại trực tiếp (Knockout)</option>
                            <option value="VongBang">Vòng tròn</option>
                            <option value="KetHopVongBangVaLoaiTrucTiep">Bảng + Knockout</option>
                            
                            <option value="TinhDiemXepHang">Đo thành tích</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select id="quyMoFilter" class="form-select bg-white border rounded-3 shadow-none">
                            <option value="">-- Quy mô --</option>
                            <option value="DongDoi">Đồng đội</option>
                            <option value="CaNhan">Cá nhân</option>
                        </select>
                    </div>
                    <div class="col-md-1">
                        <select id="gioiTinhFilter" class="form-select bg-white border rounded-3 shadow-none">
                            <option value="">-- Giới tính --</option>
                            <option value="Nam">Nam</option>
                            <option value="Nu">Nữ</option>
                            <option value="HonHop">Hỗn hợp</option>
                        </select>
                    </div>
                    <div class="col-md-2 d-flex gap-1">
                        <button type="button" class="btn btn-dark flex-grow-1 rounded-3" onclick="loadData(1)">
                            <i class="fa-solid fa-filter me-1"></i> Lọc
                        </button>
                        <button type="button" class="btn btn-outline-secondary rounded-3" onclick="resetFilter()" title="Làm mới">
                            <i class="fa-solid fa-arrows-rotate"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Bảng danh sách Môn thể thao -->
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="tblMonTheThao">
                    <thead class="table-light text-uppercase fs-7 text-muted">
                        <tr>
                            <th class="ps-3" style="width: 50px;">STT</th>
                            <th>Tên Môn Thể Thao</th>
                            <th>Nhóm Danh Mục</th>
                            <th>Quy Mô</th>
                            <th>Sơ Đồ Thi Đấu</th>
                            <th>Giới Tính</th>
                            <th>Số VĐV / Đội</th>
                            <th>Trạng Thái</th>
                            <th class="text-end pe-3" style="width: 130px;">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody id="tblBody">
                        <tr><td colspan="9" class="text-center py-5 text-muted">Đang tải danh sách môn thể thao...</td></tr>
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center py-3 mt-3 border-top">
                <div class="text-muted small" id="paginationInfo">Hiển thị 0 trên 0 môn thể thao</div>
                <ul class="pagination pagination-sm mb-0" id="paginationList"></ul>
            </div>
        </div>
    </div>
</div>

<!-- Modal Thêm / Sửa Môn Thể Thao -->
<div class="modal fade" id="modalMon" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-bottom px-4 py-3">
                <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2" id="modalTitle">
                    <i class="fa-solid fa-volleyball text-primary"></i>
                    <span>Thêm Môn Thể Thao Mới</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formMon">
                <input type="hidden" id="monId" value="">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold small">Tên môn thể thao <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="ten" required placeholder="Bóng đá nam 7 người">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">Mã môn</label>
                            <input type="text" class="form-control text-uppercase" id="ma" placeholder="BD-07">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Thuộc nhóm danh mục</label>
                            <select id="danhMucId" class="form-select">
                                <option value="">-- Chọn nhóm môn --</option>
                                @foreach (var dm in danhMucs)
                                {
                                    <option value="@dm.Id">@dm.Ten</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold small">Quy mô tham gia</label>
                            <select id="loaiThiDau" class="form-select">
                                <option value="DongDoi">Đồng đội</option>
                                <option value="CaNhan">Cá nhân</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold small">Giới tính</label>
                            <select id="gioiTinh" class="form-select">
                                <option value="Nam">Nam</option>
                                <option value="Nu">Nữ</option>
                                <option value="HonHop">Hỗn hợp (Nam/Nữ)</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Hình thức / Sơ đồ thi đấu</label>
                            <select id="hinhThucThiDau" class="form-select">
                                <option value="LoaiTrucTiep">Loại trực tiếp (Knockout)</option>
                                <option value="VongBang">Vòng tròn tính điểm </option>
                                <option value="KetHopVongBangVaLoaiTrucTiep">Kết hợp vòng bảng và loại trực tiếp</option>                                
                                <option value="TinhDiemXepHang">Đo thành tích / Tính điểm xếp hạng (Điền kinh, Bơi lội)</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold small">Số VĐV tối thiểu / đội</label>
                            <input type="number" class="form-control" id="soLuongVdvToiThieu" value="1" min="1">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold small">Số VĐV tối đa / đội</label>
                            <input type="number" class="form-control" id="soLuongVdvToiDa" value="1" min="1">
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold small">Mô tả / Luật thi đấu cơ bản</label>
                            <textarea class="form-control" id="moTa" rows="3" placeholder="Ghi chú về thể thức tính điểm, thời lượng trận đấu..."></textarea>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" id="trangThai" checked>
                                <label class="form-check-label fw-semibold small" for="trangThai">Hoạt động (Được đưa vào các giải đấu)</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top px-4 py-3 bg-light">
                    <button type="button" class="btn btn-secondary rounded-3 px-3" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary rounded-3 px-4" id="btnSave">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Lưu thông tin
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========== STYLES: FORMAT MODAL ========== -->
<style>
#modalTheThuc .fmt-tab-card {
    background:#fff; border:2px solid #e5e7eb; border-radius:12px;
    padding:16px; cursor:pointer; transition:all .2s ease;
    position:relative; user-select:none;
}
#modalTheThuc .fmt-tab-card:hover { border-color:#a5b4fc; }
#modalTheThuc .fmt-tab-card.fmt-active    { border-color:#4f46e5; }
#modalTheThuc .fmt-tab-card.fmt-active-rr  { border-color:#2563eb; }
#modalTheThuc .fmt-tab-card.fmt-active-grp { border-color:#16a34a; }
#modalTheThuc .fmt-tab-card.fmt-active-perf{ border-color:#9ca3af; }
#modalTheThuc .fmt-tab-dot {
    position:absolute; top:10px; right:12px;
    width:8px; height:8px; border-radius:50%;
    background:#22c55e; display:none;
}
#modalTheThuc .fmt-tab-card[class*="fmt-active"] .fmt-tab-dot { display:block; }
#modalTheThuc .fmt-tab-icon { font-size:18px; margin-bottom:8px; color:#9ca3af; }
#modalTheThuc .fmt-tab-card.fmt-active     .fmt-tab-icon { color:#4f46e5; }
#modalTheThuc .fmt-tab-card.fmt-active-rr  .fmt-tab-icon { color:#2563eb; }
#modalTheThuc .fmt-tab-card.fmt-active-grp .fmt-tab-icon { color:#16a34a; }
#modalTheThuc .fmt-tab-name { font-size:14px; font-weight:700; color:#111827; }
#modalTheThuc .fmt-tab-sub  { font-size:11px; color:#9ca3af; margin-top:2px; }

#modalTheThuc .fmt-section {
    background:#fff; border-radius:12px; padding:20px;
    margin-bottom:16px; box-shadow:0 1px 3px rgba(0,0,0,.07);
}
#modalTheThuc .fmt-section-hdr { display:flex; align-items:flex-start; gap:14px; margin-bottom:18px; }
#modalTheThuc .fmt-ico-circle {
    width:40px; height:40px; border-radius:50%;
    display:flex; align-items:center; justify-content:center;
    font-size:16px; flex-shrink:0;
}
#modalTheThuc .fmt-ico-blue   { background:#eff6ff; color:#3b82f6; }
#modalTheThuc .fmt-ico-orange  { background:#fff7ed; color:#f97316; }
#modalTheThuc .fmt-ico-indigo  { background:#eef2ff; color:#6366f1; }
#modalTheThuc .fmt-ico-green   { background:#f0fdf4; color:#22c55e; }
#modalTheThuc .fmt-ico-yellow  { background:#fffbeb; color:#eab308; }

#modalTheThuc .fmt-input-box {
    border:1.5px solid #e5e7eb; border-radius:10px; padding:14px;
    background:#fff; height:100%;
}
#modalTheThuc .fmt-lbl { font-size:12px; color:#6b7280; font-weight:500; margin-bottom:6px; }
#modalTheThuc .fmt-big-input {
    width:100%; border:none; outline:none;
    font-size:32px; font-weight:700; color:#111827;
    background:transparent; display:block; margin-bottom:4px;
    -moz-appearance:textfield;
}
#modalTheThuc .fmt-big-input::-webkit-outer-spin-button,
#modalTheThuc .fmt-big-input::-webkit-inner-spin-button { -webkit-appearance:none; }
#modalTheThuc .fmt-big-input.computed { color:#7c3aed; }
#modalTheThuc .fmt-unit-row { font-size:13px; color:#6b7280; }
#modalTheThuc .fmt-computed-box { background:#faf5ff!important; border-color:#e9d5ff!important; }
#modalTheThuc .fmt-computed-hint { font-size:11px; color:#9ca3af; margin-top:6px; }

#modalTheThuc .fmt-qbtns { display:flex; gap:5px; flex-wrap:wrap; margin-top:8px; }
#modalTheThuc .fmt-qbtn {
    font-size:11px; font-weight:600; padding:3px 10px;
    border:1.5px solid #d1d5db; border-radius:20px;
    background:transparent; color:#6b7280; cursor:pointer;
    transition:all .15s; line-height:1.5;
}
#modalTheThuc .fmt-qbtn:hover { border-color:#6366f1; color:#6366f1; background:#eef2ff; }
#modalTheThuc .fmt-qbtn.active { background:#6366f1; border-color:#6366f1; color:#fff; }

#modalTheThuc .fmt-toggle-row {
    display:flex; align-items:flex-start; justify-content:space-between;
    padding:14px 16px; border:1.5px solid #e5e7eb; border-radius:10px;
    gap:12px; margin-bottom:10px; background:#fff;
}
#modalTheThuc .fmt-toggle-row:last-child { margin-bottom:0; }
#modalTheThuc .fmt-toggle-title { font-size:14px; font-weight:600; color:#111827; }
#modalTheThuc .fmt-toggle-desc  { font-size:12px; color:#9ca3af; margin-top:2px; }

#modalTheThuc .fmt-toggle { position:relative; display:inline-block; width:46px; height:26px; flex-shrink:0; }
#modalTheThuc .fmt-toggle input { opacity:0; width:0; height:0; }
#modalTheThuc .fmt-slider {
    position:absolute; cursor:pointer; top:0; left:0; right:0; bottom:0;
    background:#d1d5db; border-radius:26px; transition:.25s;
}
#modalTheThuc .fmt-slider:before {
    content:""; position:absolute;
    height:20px; width:20px; left:3px; bottom:3px;
    background:white; border-radius:50%; transition:.25s;
    box-shadow:0 1px 4px rgba(0,0,0,.2);
}
#modalTheThuc .fmt-toggle input:checked + .fmt-slider.orange { background:#f97316; }
#modalTheThuc .fmt-toggle input:checked + .fmt-slider.blue   { background:#4f46e5; }
#modalTheThuc .fmt-toggle input:checked + .fmt-slider.green  { background:#22c55e; }
#modalTheThuc .fmt-toggle input:checked + .fmt-slider:before { transform:translateX(20px); }

#modalTheThuc .fmt-score-card { border-radius:10px; padding:16px; border:1.5px solid; }
#modalTheThuc .fmt-score-card.green  { background:#f0fdf4; border-color:#86efac; }
#modalTheThuc .fmt-score-card.yellow { background:#fffbeb; border-color:#fde68a; }
#modalTheThuc .fmt-score-card.red    { background:#fef2f2; border-color:#fca5a5; }
#modalTheThuc .fmt-score-lbl { font-size:12px; font-weight:600; display:flex; justify-content:space-between; margin-bottom:8px; }
#modalTheThuc .fmt-score-card.green  .fmt-score-lbl { color:#16a34a; }
#modalTheThuc .fmt-score-card.yellow .fmt-score-lbl { color:#d97706; }
#modalTheThuc .fmt-score-card.red    .fmt-score-lbl { color:#dc2626; }
#modalTheThuc .fmt-score-val {
    border:none; background:transparent; outline:none;
    font-size:36px; font-weight:700; width:100%;
    -moz-appearance:textfield;
}
#modalTheThuc .fmt-score-val::-webkit-outer-spin-button,
#modalTheThuc .fmt-score-val::-webkit-inner-spin-button { -webkit-appearance:none; }
#modalTheThuc .fmt-score-card.green  .fmt-score-val { color:#15803d; }
#modalTheThuc .fmt-score-card.yellow .fmt-score-val { color:#d97706; }
#modalTheThuc .fmt-score-card.red    .fmt-score-val { color:#dc2626; }
#modalTheThuc .fmt-score-hint { font-size:11px; color:#9ca3af; margin-top:4px; }

#modalTheThuc .fmt-criteria-row {
    display:flex; align-items:center; gap:10px;
    padding:10px 14px; border:1.5px solid #e5e7eb; border-radius:8px;
    margin-bottom:8px; background:#fff; transition:all .15s;
}
#modalTheThuc .fmt-criteria-row:hover { border-color:#c7d2fe; }
#modalTheThuc .fmt-criteria-cb { width:18px; height:18px; border-radius:4px; flex-shrink:0; cursor:pointer; accent-color:#6366f1; }
#modalTheThuc .fmt-criteria-cb.orange { accent-color:#f97316; }
#modalTheThuc .fmt-num-badge { font-size:11px; font-weight:700; padding:2px 8px; border-radius:4px; flex-shrink:0; background:#eef2ff; color:#6366f1; }
#modalTheThuc .fmt-num-badge.orange { background:#fff7ed; color:#f97316; }
#modalTheThuc .fmt-criteria-title { font-size:13px; font-weight:600; color:#111827; }
#modalTheThuc .fmt-criteria-desc  { font-size:11px; color:#9ca3af; }
#modalTheThuc .fmt-arr-btn {
    width:28px; height:28px; border:1.5px solid #e5e7eb; border-radius:6px;
    background:#fff; color:#6b7280; cursor:pointer; flex-shrink:0;
    display:flex; align-items:center; justify-content:center; font-size:10px;
    transition:all .15s;
}
#modalTheThuc .fmt-arr-btn:hover { border-color:#6366f1; color:#6366f1; background:#eef2ff; }
#modalTheThuc .fmt-overtime-sub {
    background:#f8fafc; border:1.5px solid #e2e8f0;
    border-radius:10px; padding:16px; margin-top:12px;
}
#modalTheThuc .fmt-inline-score-input {
    border:none; outline:none; background:transparent;
    font-weight:700; font-size:16px; text-align:center; width:56px;
}
</style>

<!-- ========== MODAL CẤU HÌNH THỂ THỨC (THIẾT KẾ MỚI) ========== -->
<div class="modal fade" id="modalTheThuc" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-centered" style="max-height:92vh">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden" style="max-height:92vh;display:flex;flex-direction:column">

            <!-- ── HEADER ── -->
            <div class="d-flex align-items-center px-4 py-3 bg-white gap-3" style="border-bottom:1px solid #e5e7eb;flex-shrink:0">
                <div class="d-flex align-items-center justify-content-center rounded-3 text-white" style="width:42px;height:42px;background:#4f46e5;flex-shrink:0">
                    <i class="fa-solid fa-sliders"></i>
                </div>
                <div class="flex-grow-1 min-w-0">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <h5 class="fw-bold mb-0" style="font-size:16px;color:#111827">Cấu Hình Thể Thức &amp; Luật Thi Đấu</h5>
                        <span class="fw-semibold px-2 py-1 rounded-2" style="background:#eef2ff;color:#4f46e5;font-size:11px;border:1px solid #c7d2fe">Chuẩn Điều Lệ</span>
                        <span class="fw-semibold px-2 py-1 rounded-2 d-none" id="badgeModalSportName" style="background:#f0fdf4;color:#16a34a;font-size:11px;border:1px solid #86efac"></span>
                    </div>
                    <div class="mt-1" id="formatModalSubtitle" style="font-size:12px;color:#9ca3af">Thiết lập số hiệp, thời lượng từng hiệp, hiệp phụ, điểm số và tiêu chí xếp hạng</div>
                </div>
                <div class="d-flex align-items-center gap-2 ms-auto">
                    <div class="input-group input-group-sm" style="width:240px">
                        <span class="input-group-text bg-white" style="border-color:#e5e7eb"><i class="fa-solid fa-book-open text-muted fa-xs"></i></span>
                        <select id="fmtPresetSelect" class="form-select form-select-sm" style="border-color:#e5e7eb;font-size:12px" onchange="applyPresetFromSelect(this.value)">
                            <option value="">-- Gợi ý mẫu điều lệ nhanh --</option>
                            <option value="football">⚽ Bóng đá (Bảng+KO · 2x45p)</option>
                            <option value="futsal">🥅 Futsal (Bảng+KO · 2x20p)</option>
                            <option value="volleyball">🏐 Bóng chuyền (Bảng+KO · 5 set)</option>
                            <option value="basketball">🏀 Bóng rổ (KO · 4x12p)</option>
                            <option value="badminton">🏸 Cầu lông (KO · 3 set)</option>
                            <option value="tabletennis">🏓 Bóng bàn (Vòng tròn · 5 set)</option>
                            <option value="athletics">🏃 Điền kinh (Tính giờ)</option>
                            <option value="swimming">🏊 Bơi lội (Tính giờ)</option>
                        </select>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="resetFormatForm()" title="Đặt lại mặc định" style="width:32px;height:32px;padding:0">
                        <i class="fa-solid fa-rotate fa-xs"></i>
                    </button>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>

            <form id="formTheThuc" style="flex:1;display:flex;flex-direction:column;overflow:hidden;min-height:0">
                <input type="hidden" id="fmtMonId" value="">
                <input type="hidden" id="fmtHinhThucThiDau" value="LoaiTrucTiep">

                <!-- ── FORMAT SELECTOR (sticky) ── -->
                <div class="px-4 py-3 bg-white" style="border-bottom:1px solid #e5e7eb;flex-shrink:0">
                    <div class="d-flex justify-content-between align-items-center mb-3">
