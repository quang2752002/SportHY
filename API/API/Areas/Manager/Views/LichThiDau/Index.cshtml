                    }

                    groupsHtml += `
                        <div class="col-12 mt-3">
                            <div class="card border border-warning shadow-sm" style="background: #fffdf7;">
                                <div class="card-header bg-warning bg-opacity-25 py-2 px-3 d-flex justify-content-between align-items-center">
                                    <span class="fw-bold text-dark small">
                                        <i class="fa-solid fa-trophy text-warning me-1"></i> Vòng Loại Trực Tiếp (Knockout — ${koMatches.length} trận)
                                    </span>
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Quyết Định Ngôi Vô Địch</span>
                                </div>
                                <div class="card-body p-3">
                                    ${koSectionsHtml}
                                    ${podiumHtml}
                                </div>
                            </div>
                        </div>
                    `;
                } else if (podiumHtml) {
                    groupsHtml += podiumHtml;
                }

                container.html(groupsHtml);
                return;
            }

            // Gắn hai cột Bảng A & Bảng B vào container (cho giải thuần Knockout)
            const branchesHtml = `
                <!-- BẢNG A (NHÁNH TRÊN) -->
                <div class="col-lg-6">
                    <div class="card bracket-branch-card shadow-sm h-100">
                        <div class="card-header py-2 px-3 text-white d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, #1d4ed8, #2563eb);">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-white text-primary fw-bold">BẢNG A</span>
                                <strong class="small">NHÁNH TRÊN (TOP HALF)</strong>
                            </div>
                            <span class="badge bg-white-subtle text-white small">${teamsA.length} đội</span>
                        </div>
                        <div class="card-body p-3">
                            <h6 class="fw-bold text-dark small mb-2"><i class="fa-solid fa-users-rectangle text-primary me-1"></i> Danh Sách Hạt Giống Xếp Vào Bảng A</h6>
                            ${buildBranchTableHtml(teamsA, 'A', 'primary')}

                            <h6 class="fw-bold text-dark small mt-3 mb-2"><i class="fa-solid fa-arrows-turn-to-dots text-primary me-1"></i> Tiến Trình Trận Đấu Bảng A</h6>
                            ${buildBranchMatchesHtml(branchAMatches)}
                        </div>
                    </div>
                </div>

                <!-- BẢNG B (NHÁNH DƯỚI) -->
                <div class="col-lg-6">
                    <div class="card bracket-branch-card shadow-sm h-100">
                        <div class="card-header py-2 px-3 text-white d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, #7c3aed, #6d28d9);">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-white text-purple fw-bold" style="color: #6d28d9;">BẢNG B</span>
                                <strong class="small">NHÁNH DƯỚI (BOTTOM HALF)</strong>
                            </div>
                            <span class="badge bg-white-subtle text-white small">${teamsB.length} đội</span>
                        </div>
                        <div class="card-body p-3">
                            <h6 class="fw-bold text-dark small mb-2"><i class="fa-solid fa-users-rectangle text-purple me-1" style="color: #6d28d9;"></i> Danh Sách Hạt Giống Xếp Vào Bảng B</h6>
                            ${buildBranchTableHtml(teamsB, 'B', 'purple')}

                            <h6 class="fw-bold text-dark small mt-3 mb-2"><i class="fa-solid fa-arrows-turn-to-dots text-purple me-1" style="color: #6d28d9;"></i> Tiến Trình Trận Đấu Bảng B</h6>
                            ${buildBranchMatchesHtml(branchBMatches)}
                        </div>
                    </div>
                </div>

                <!-- VÒNG CHUNG KẾT & PODIUM -->
                <div class="col-12 mt-3">
                    <div class="card border shadow-sm">
                        <div class="card-header bg-white py-2 px-3 d-flex justify-content-between align-items-center border-bottom">
                            <span class="fw-bold text-dark small">
                                <i class="fa-solid fa-crown text-warning me-1"></i> Vòng Quyết Định — Chung Kết & Tranh Hạng Ba
                            </span>
                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Huy Chương Vàng - Bạc - Đồng</span>
                        </div>
                        <div class="card-body p-3">
                            <div class="row g-3">
                                ${finalMatches.map(m => {
                                    const isFinal = isMatchFinal(m);
                                    const headerClass = isFinal ? 'bg-warning text-dark' : 'bg-secondary text-white';
                                    const ph = getMatchPlaceholderTeams(m);
                                    const d1 = m.doi1 ? escapeHtml(m.doi1.tenDangKy || m.doi1.tenDoi || 'Đội 1') : escapeHtml(ph.t1);
                                    const d2 = m.doi2 ? escapeHtml(m.doi2.tenDangKy || m.doi2.tenDoi || 'Đội 2') : escapeHtml(ph.t2);
                                    const timeStr = m.thoiGianDuKien ? formatDate(m.thoiGianDuKien, true) : 'Chưa xếp giờ';
                                    const sc1 = m.tySoDoi1 ?? m.diemDoi1;
                                    const sc2 = m.tySoDoi2 ?? m.diemDoi2;
                                    const scoreBadge = (sc1 != null && sc2 != null)
                                        ? `<span class="badge bg-dark fs-6 px-3 py-1">${sc1} - ${sc2}</span>`
                                        : `<span class="badge bg-light text-muted border">Chưa đấu</span>`;

                                    return `
                                        <div class="col-md-6">
                                            <div class="border rounded p-3 bg-white shadow-2xs h-100 ${isFinal ? 'border-warning' : ''}">
                                                <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                                                    <span class="badge ${headerClass} fw-bold">#${m.soTran || ''} • ${escapeHtml(m.tenTran)}</span>
                                                    <div class="d-flex align-items-center gap-1">
                                                        <small class="text-muted"><i class="fa-regular fa-clock me-1"></i>${timeStr}</small>
                                                    </div>
                                                </div>
                                                <div class="d-flex justify-content-between align-items-center my-2">
                                                    <div class="text-truncate me-2" style="max-width: 40%;">
                                                        <strong class="d-block text-dark ${m.doiThangDangKyId && m.doi1 && m.doi1.dangKyThiDauId === m.doiThangDangKyId ? 'text-success' : ''}">${d1}</strong>
                                                        <small class="text-muted">${escapeHtml(m.doi1?.tenDonVi || '')}</small>
                                                    </div>
                                                    <div>${scoreBadge}</div>
                                                    <div class="text-truncate text-end ms-2" style="max-width: 40%;">
                                                        <strong class="d-block text-dark ${m.doiThangDangKyId && m.doi2 && m.doi2.dangKyThiDauId === m.doiThangDangKyId ? 'text-success' : ''}">${d2}</strong>
                                                        <small class="text-muted">${escapeHtml(m.doi2?.tenDonVi || '')}</small>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    `;
                                }).join('')}
                            </div>
                            ${podiumHtml}
                        </div>
                    </div>
                </div>
            `;

            container.html(branchesHtml);
        }

        // ==================== KHÔNG GIAN 2: MODAL XẾP CẶP THỦ CÔNG (KÉO THẢ & CHỈNH SỬA) ====================
        function openManualPairingModal() {
            const currentGiaiDau = $('#mainGiaiDauSelect').val();
            const currentMon = $('#mainMonSelect').val();
            const currentDm = $('#mainDanhMucSelect').val();
            if (currentGiaiDau) {
                $('#modalGiaiDauId').val(currentGiaiDau);
                onModalGiaiDauChanged(currentGiaiDau, currentMon, currentDm);
            } else {
                $('#modalGiaiDauId').val('');
                onModalGiaiDauChanged('');
            }
            $('#modalManualPairing').modal('show');
        }

        function onModalGiaiDauChanged(giaiDauId, preferredMonId, preferredDmId) {
            if (!giaiDauId) {
                allModalSports = [];
                $('#modalDanhMucId').html('<option value="">-- Tất cả danh mục --</option>');
                $('#modalGiaiDauMonId').html('<option value="">-- Chọn môn thể thao --</option>');
                $('#modalVongDauId').html('<option value="">-- Tất cả vòng --</option>');
                $('#modalBangDauId').html('<option value="">-- Tất cả --</option>');
                $('#modalPairingPlaceholder').removeClass('d-none');
                $('#modalPairingContent').addClass('d-none');
                return;
            }

            $.get('/Manager/LichThiDau/GetMonByGiaiDau', { giaiDauId: parseInt(giaiDauId) }, function (res) {
                if (res.success && res.data && res.data.length > 0) {
                    allModalSports = res.data;

                    const dmMap = new Map();
                    allModalSports.forEach(m => {
                        if (m.danhMucId && m.tenDanhMuc) {
                            dmMap.set(m.danhMucId, m.tenDanhMuc);
                        }
                    });

                    let dmOpts = '<option value="">-- Tất cả danh mục --</option>';
                    dmMap.forEach((name, id) => {
                        dmOpts += `<option value="${id}">${escapeHtml(name)}</option>`;
                    });
                    $('#modalDanhMucId').html(dmOpts);

                    // Xác định môn và danh mục môn ưu tiên:
                    // 1. Theo preferredMonId (nếu mở từ ngoài màn hình chính)
                    // 2. Hoặc theo preferredDmId nếu có
                    // 3. Nếu không, tự động chọn môn và danh mục môn đầu tiên của giải đấu
                    let selectedSport = null;
                    if (preferredMonId && allModalSports.some(m => m.id == preferredMonId)) {
                        selectedSport = allModalSports.find(m => m.id == preferredMonId);
                    } else if (preferredDmId && dmMap.has(parseInt(preferredDmId))) {
                        selectedSport = allModalSports.find(m => m.danhMucId == parseInt(preferredDmId));
                    }

                    if (!selectedSport && allModalSports.length > 0) {
                        selectedSport = allModalSports[0];
                    }

                    if (selectedSport && selectedSport.danhMucId && dmMap.has(selectedSport.danhMucId)) {
                        $('#modalDanhMucId').val(selectedSport.danhMucId);
                        renderModalMonSelect(selectedSport.danhMucId, selectedSport.id);
                    } else {
                        $('#modalDanhMucId').val('');
                        renderModalMonSelect('', selectedSport ? selectedSport.id : null);
                    }

                    loadModalPairingData();
                } else {
                    allModalSports = [];
                    $('#modalDanhMucId').html('<option value="">-- Tất cả danh mục --</option>');
                    $('#modalGiaiDauMonId').html('<option value="">-- Chọn môn thể thao --</option>');
                    $('#modalVongDauId').html('<option value="">-- Tất cả vòng --</option>');
                    $('#modalBangDauId').html('<option value="">-- Tất cả --</option>');
                    $('#modalPairingPlaceholder').removeClass('d-none');
                    $('#modalPairingContent').addClass('d-none');
                }
            });
        }

        function onModalDanhMucChanged(danhMucId) {
            renderModalMonSelect(danhMucId);
            loadModalPairingData();
        }

        function onModalMonChanged(monId) {
            if (monId) {
                const sport = allModalSports.find(m => m.id == parseInt(monId));
                if (sport && sport.danhMucId) {
                    const currentDm = $('#modalDanhMucId').val();
                    if (!currentDm || currentDm != sport.danhMucId) {
                        $('#modalDanhMucId').val(sport.danhMucId);
                        renderModalMonSelect(sport.danhMucId, sport.id);
                    }
                }
            }
            loadModalPairingData();
        }

        function renderModalMonSelect(danhMucId, selectedMonId) {
            danhMucId = danhMucId !== undefined ? danhMucId : $('#modalDanhMucId').val();
            let filtered = allModalSports;
            if (danhMucId) {
                filtered = allModalSports.filter(m => m.danhMucId == parseInt(danhMucId));
            }

            let opts = '<option value="">-- Chọn môn thể thao --</option>';
            filtered.forEach(m => {
                const categoryBadge = m.tenDanhMuc ? ` [${escapeHtml(m.tenDanhMuc)}]` : '';
                opts += `<option value="${m.id}">${escapeHtml(m.ten)}${categoryBadge}</option>`;
            });
            $('#modalGiaiDauMonId').html(opts);

            if (selectedMonId && filtered.some(m => m.id == selectedMonId)) {
                $('#modalGiaiDauMonId').val(selectedMonId);
            } else {
                const currentVal = $('#modalGiaiDauMonId').val();
                if (currentVal && filtered.some(m => m.id == currentVal)) {
                    $('#modalGiaiDauMonId').val(currentVal);
                } else if (filtered.length > 0) {
                    $('#modalGiaiDauMonId').val(filtered[0].id);
                } else {
                    $('#modalGiaiDauMonId').val('');
                }
            }
        }

        let draggedGroupTeamPayload = null;

        function switchModalHybridTab(tab) {
            if (tab === 'grouping') {
                $('#tabBtnManualGrouping').addClass('active');
                $('#tabBtnManualFixtures').removeClass('active');
                $('#modalGroupingPane').removeClass('d-none');
                $('#modalFixturesPane').addClass('d-none');
                renderModalGroupingUI();
            } else {
                $('#tabBtnManualGrouping').removeClass('active');
                $('#tabBtnManualFixtures').addClass('active');
                $('#modalGroupingPane').addClass('d-none');
                $('#modalFixturesPane').removeClass('d-none');
                renderModalPairingUI();
            }
        }

        function loadModalPairingData() {
            const giaiDauMonTheThaoId = $('#modalGiaiDauMonId').val();
            if (!giaiDauMonTheThaoId) {
                $('#modalPairingPlaceholder').removeClass('d-none');
                $('#modalPairingContent').addClass('d-none');
                return;
            }

            const vongDauId = $('#modalVongDauId').val();
            const bangDauId = $('#modalBangDauId').val();

            $('#modalPairingPlaceholder').addClass('d-none');
            $('#modalPairingContent').addClass('d-none');
            $('#modalPairingLoading').removeClass('d-none');

            $.ajax({
                url: '/Manager/LichThiDau/GetManualPairingData',
                type: 'GET',
                data: {
                    giaiDauMonTheThaoId: parseInt(giaiDauMonTheThaoId),
                    vongDauId: vongDauId ? parseInt(vongDauId) : undefined,
                    bangDauId: bangDauId ? parseInt(bangDauId) : undefined
                },
                success: function (res) {
                    $('#modalPairingLoading').addClass('d-none');
                    if (res.success && res.data) {
                        const isHybrid = res.data.isKetHopVongBangKnockout ||
                                         res.data.hinhThucThiDau === 'KetHopVongBangVaLoaiTrucTiep' ||
                                         res.data.hinhThucThiDau == 3 ||
                                         res.data.hinhThucThiDau === '3';

                        modalData = {
                            giaiDauMonTheThaoId: res.data.giaiDauMonTheThaoId,
                            laMonDongDoi: res.data.laMonDongDoi,
                            hinhThucThiDau: res.data.hinhThucThiDau,
                            isKetHopVongBangKnockout: isHybrid,
                            soBangCauHinh: res.data.soBangCauHinh || 0,
                            soDoiMoiBang: res.data.soDoiMoiBang || 4,
                            soDoiMoiBangVaoVongTrong: res.data.soDoiMoiBangVaoVongTrong || 2,
                            vongDaus: res.data.vongDaus || [],
                            bangDaus: res.data.bangDaus || [],
                            sanDaus: res.data.sanDaus || [],
                            allTeams: res.data.allTeams || [],
                            unpairedTeams: res.data.unpairedTeams || [],
                            pairs: res.data.existingPairs || []
                        };

                        // Cập nhật Vòng đấu dropdown trong modal
                        updateModalVongDauSelect(modalData.vongDaus, vongDauId);
                        // Cập nhật Bảng đấu dropdown trong modal
                        updateModalBangDauSelect(modalData.bangDaus, bangDauId);

                        // Xử lý hiển thị theo thể thức môn
                        if (modalData.isKetHopVongBangKnockout) {
                            $('#modalHybridTabsNav').removeClass('d-none');
                            $('#modalHybridFixturesBadge').removeClass('d-none');

                            // Kiểm tra nếu các đội chưa được chia bảng và chưa có cặp đấu nào -> ưu tiên mở Tab Chia Bảng
                            const hasGrouped = modalData.allTeams.some(t => t.bangDauId);
                            const hasPairs = modalData.pairs && modalData.pairs.length > 0;

                            $('#modalPairingContent').removeClass('d-none');
                            if (!hasGrouped && !hasPairs) {
                                switchModalHybridTab('grouping');
                            } else {
                                switchModalHybridTab('fixtures');
                            }
                        } else {
                            $('#modalHybridTabsNav').addClass('d-none');
                            $('#modalHybridFixturesBadge').addClass('d-none');
                            $('#modalGroupingPane').addClass('d-none');
                            $('#modalFixturesPane').removeClass('d-none');

                            // Nếu chưa có cặp đấu nào trong DB và có đội chưa xếp -> khởi tạo các cặp đấu rỗng
                            if (modalData.pairs.length === 0 && modalData.allTeams.length > 0) {
                                const numPairs = Math.max(1, Math.ceil(modalData.unpairedTeams.length / 2));
                                for (let i = 1; i <= numPairs; i++) {
                                    modalData.pairs.push({
                                        tranDauId: null,
                                        soTran: i,
                                        tenTran: `Trận ${i}`,
                                        vongDauId: modalData.vongDaus[0]?.id || null,
                                        bangDauId: bangDauId ? parseInt(bangDauId) : (modalData.bangDaus[0]?.id || null),
                                        sanDauId: null,
                                        thoiGianDuKien: null,
                                        trangThai: 'ChuaDau',
                                        doi1: null,
                                        doi2: null
                                    });
                                }
                            }

                            $('#modalPairingContent').removeClass('d-none');
                            renderModalPairingUI();
                        }
                    } else {
                        $('#modalPairingPlaceholder').removeClass('d-none');
                        Swal.fire('Lỗi', res.message || 'Không thể tải dữ liệu xếp cặp.', 'error');
                    }
                },
                error: function (xhr) {
                    $('#modalPairingLoading').addClass('d-none');
                    $('#modalPairingPlaceholder').removeClass('d-none');
                    Swal.fire('Lỗi', xhr.responseJSON?.message || 'Có lỗi xảy ra khi tải dữ liệu.', 'error');
                }
            });
        }

        function updateModalVongDauSelect(vongDaus, selectedId) {
            let opts = '<option value="">-- Tất cả vòng --</option>';
            vongDaus.forEach(v => {
                const sel = (selectedId && parseInt(selectedId) === v.id) ? 'selected' : '';
                opts += `<option value="${v.id}" ${sel}>${escapeHtml(v.ten)}</option>`;
            });
            $('#modalVongDauId').html(opts);
        }

        function updateModalBangDauSelect(bangDaus, selectedId) {
            if (!bangDaus || bangDaus.length === 0) {
                $('#modalBangDauCol').addClass('d-none');
                return;
            }
            $('#modalBangDauCol').removeClass('d-none');
            let opts = '<option value="">-- Tất cả bảng --</option>';
            bangDaus.forEach(b => {
                const sel = (selectedId && parseInt(selectedId) === b.id) ? 'selected' : '';
                opts += `<option value="${b.id}" ${sel}>${escapeHtml(b.ten)}</option>`;
            });
            $('#modalBangDauId').html(opts);
        }

        // ==================== CÁC HÀM XỬ LÝ CHIA BẢNG ĐẤU THỦ CÔNG (TAB 1) ====================
        function renderModalGroupingUI() {
            const all = modalData.allTeams || [];
            const ungrouped = all.filter(t => !t.bangDauId);
            const assignedCount = all.length - ungrouped.length;

            $('#badgeModalGroupAssignedCount').text(`Đã chia ${assignedCount}/${all.length} đội`);
            $('#badgeModalGroupPairsCount').text(`${modalData.pairs.length} cặp`);
            $('#modalUngroupedCountBadge').text(ungrouped.length);

            const soBang = modalData.bangDaus.length;
            const configTxt = modalData.soBangCauHinh > 0
                ? `${soBang} Bảng (Cấu hình: ${modalData.soBangCauHinh} Bảng) • Tiêu chuẩn ${modalData.soDoiMoiBang} đội/bảng • Lấy Top ${modalData.soDoiMoiBangVaoVongTrong}`
                : `${soBang} Bảng • Tiêu chuẩn ${modalData.soDoiMoiBang} đội/bảng • Lấy Top ${modalData.soDoiMoiBangVaoVongTrong}`;
            $('#modalGroupConfigBadge').html(`<i class="fa-solid fa-sliders me-1"></i>${configTxt}`);

            renderModalUngroupedTeams(ungrouped);
            renderModalGroupsGrid();
        }

        function renderModalUngroupedTeams(ungrouped) {
            const container = $('#modalUngroupedTeamsList');
            container.empty();

            if (!ungrouped || ungrouped.length === 0) {
                container.html(`
                    <div class="text-center text-muted py-4">
                        <i class="fa-solid fa-circle-check text-success fa-2x mb-2"></i>
                        <div class="fw-semibold small text-success">Đã phân chia hết các đội!</div>
                        <small class="text-muted">Tất cả các đội đã được xếp vào các bảng đấu.</small>
                    </div>
                `);
                return;
            }

            ungrouped.forEach(team => {
                const teamName = escapeHtml(getParticipantDisplayName(team, true, `Đội #${team.dangKyThiDauId}`));
                const unitName = team.tenDonVi ? escapeHtml(team.tenDonVi) : 'Tự do';
                const vdvList = (team.vanDongVienNames && team.vanDongVienNames.length > 0)
                    ? `<div class="text-muted small mt-1" style="font-size: 0.75rem;"><i class="fa-solid fa-user me-1"></i>${escapeHtml(team.vanDongVienNames.slice(0, 2).join(', '))}${team.vanDongVienNames.length > 2 ? ` (+${team.vanDongVienNames.length - 2})` : ''}</div>`
                    : '';

                const cardHtml = `
                    <div class="group-team-item modal-ungrouped-team-item shadow-2xs"
                         draggable="true"
                         ondragstart="onGroupTeamDragStart(event, ${team.dangKyThiDauId}, null)"
                         ondragend="onGroupTeamDragEnd(event)"
                         data-team-id="${team.dangKyThiDauId}">
                        <div class="d-flex align-items-center justify-content-between w-100">
                            <div class="d-flex align-items-center flex-grow-1 overflow-hidden">
                                <i class="fa-solid fa-grip-vertical text-muted me-2"></i>
                                <div class="text-truncate">
                                    <strong class="text-dark d-block text-truncate" style="font-size: 0.85rem;" title="${teamName}">${teamName}</strong>
                                    <small class="text-muted"><i class="fa-solid fa-shield-halved text-secondary me-1"></i>${unitName}</small>
                                </div>
                            </div>
                        </div>
                        ${vdvList}
                    </div>
                `;
                container.append(cardHtml);
            });

            filterModalUngroupedTeams();
        }

        function filterModalUngroupedTeams() {
            const query = ($('#modalSearchUngroupedTeam').val() || '').toLowerCase().trim();
            if (!query) {
                $('.modal-ungrouped-team-item').removeClass('d-none');
                return;
            }
            $('.modal-ungrouped-team-item').each(function () {
                const text = $(this).text().toLowerCase();
                if (text.includes(query)) {
                    $(this).removeClass('d-none');
                } else {
                    $(this).addClass('d-none');
                }
            });
        }

        function renderModalGroupsGrid() {
            const container = $('#modalGroupsGridContainer');
            container.empty();

            if (!modalData.bangDaus || modalData.bangDaus.length === 0) {
                const targetCount = modalData.soBangCauHinh > 0 ? modalData.soBangCauHinh : 4;
                container.html(`
                    <div class="col-12 text-center text-muted py-5">
                        <i class="fa-solid fa-layer-group fa-3x text-primary mb-3"></i>
                        <h6 class="fw-bold text-dark">Chưa có bảng đấu nào được tạo</h6>
                        <p class="small text-muted mb-3">Môn này đã có cấu hình thể thức ${targetCount} bảng đấu.<br/>Bạn có thể bấm nút bên dưới để khởi tạo ngay danh sách Bảng A, B, C, D...</p>
                        <button type="button" class="btn btn-primary btn-sm px-4 shadow-sm" onclick="initModalGroups(${targetCount})">
                            <i class="fa-solid fa-plus-circle me-1"></i> Khởi Tạo ${targetCount} Bảng Đấu Ngay
                        </button>
                    </div>
                `);
                return;
            }

            const colors = ['group-header-a', 'group-header-b', 'group-header-c', 'group-header-d', 'group-header-e', 'group-header-f'];
            const colClass = modalData.bangDaus.length <= 2 ? 'col-md-6' : (modalData.bangDaus.length <= 4 ? 'col-md-6 col-xl-3' : 'col-md-4 col-xl-3');

            modalData.bangDaus.forEach((bang, idx) => {
                const headerColorClass = colors[idx % colors.length] || 'group-header-default';
                const groupTeams = modalData.allTeams.filter(t => t.bangDauId === bang.id);
                const targetCount = modalData.soDoiMoiBang || 4;

                let teamsListHtml = '';
                if (groupTeams.length === 0) {
                    teamsListHtml = `
                        <div class="text-center text-muted py-4 my-auto">
                            <i class="fa-solid fa-arrow-down-to-bracket text-muted fa-2x mb-2"></i>
                            <div class="small fw-semibold">Bảng trống</div>
                            <small class="text-muted" style="font-size: 0.75rem;">Kéo thả đội từ danh sách bên trái vào đây</small>
                        </div>
                    `;
                } else {
                    groupTeams.forEach((team, tIdx) => {
                        const teamName = escapeHtml(getParticipantDisplayName(team, true, `Đội #${team.dangKyThiDauId}`));
                        const unitName = team.tenDonVi ? escapeHtml(team.tenDonVi) : 'Tự do';
                        teamsListHtml += `
                            <div class="group-team-item shadow-2xs"
                                 draggable="true"
                                 ondragstart="onGroupTeamDragStart(event, ${team.dangKyThiDauId}, ${bang.id})"
                                 ondragend="onGroupTeamDragEnd(event)"
                                 data-team-id="${team.dangKyThiDauId}">
                                <div class="d-flex align-items-center justify-content-between w-100">
                                    <div class="d-flex align-items-center flex-grow-1 overflow-hidden me-2">
                                        <span class="badge bg-light text-dark border me-2" style="font-size: 0.75rem;">#${tIdx + 1}</span>
                                        <div class="text-truncate">
                                            <strong class="text-dark d-block text-truncate" style="font-size: 0.85rem;" title="${teamName}">${teamName}</strong>
                                            <small class="text-muted"><i class="fa-solid fa-shield-halved text-secondary me-1"></i>${unitName}</small>
                                        </div>
                                    </div>
                                    <button type="button" class="btn btn-xs btn-link text-danger p-0 ms-1"
                                            title="Gỡ khỏi bảng này"
                                            onclick="removeTeamFromGroup(${team.dangKyThiDauId})">
                                        <i class="fa-solid fa-xmark fs-6"></i>
                                    </button>
                                </div>
                            </div>
                        `;
                    });
                }

                const cardHtml = `
                    <div class="${colClass}">
                        <div class="group-box-card h-100 d-flex flex-column">
                            <div class="group-header ${headerColorClass}">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fa-solid fa-trophy text-warning"></i>
                                    <span>${escapeHtml(bang.ten)}</span>
                                </div>
                                <span class="badge bg-white text-dark rounded-pill fw-bold" style="font-size: 0.8rem;">
                                    ${groupTeams.length}/${targetCount} đội
                                </span>
                            </div>
                            <div class="group-dropzone flex-grow-1"
                                 data-bang-id="${bang.id}"
                                 ondragover="onGroupDragOver(event)"
                                 ondragleave="onGroupDragLeave(event)"
                                 ondrop="onGroupDrop(event, ${bang.id})">
                                ${teamsListHtml}
                            </div>
                            <div class="p-2 bg-light border-top text-center d-flex justify-content-between align-items-center">
                                <small class="text-muted" style="font-size: 0.75rem;">Thả đội vào đây</small>
                                <button type="button" class="btn btn-xs btn-outline-success py-0 px-2"
                                        title="Tạo cặp đấu vòng tròn cho riêng bảng này"
                                        onclick="generateRoundRobinForGroup(${bang.id})">
                                    <i class="fa-solid fa-bolt me-1"></i>Sinh cặp bảng
                                </button>
                            </div>
                        </div>
                    </div>
                `;
                container.append(cardHtml);
            });
        }

        // ==================== XỬ LÝ DRAG & DROP PHÂN BẢNG ====================
        function onGroupTeamDragStart(event, teamId, fromBangId) {
            draggedGroupTeamPayload = {
                teamId: parseInt(teamId),
                fromBangId: fromBangId ? parseInt(fromBangId) : null
            };
            event.dataTransfer.setData('text/plain', JSON.stringify(draggedGroupTeamPayload));
            event.dataTransfer.effectAllowed = 'move';
            $(event.currentTarget).addClass('dragging');
        }

        function onGroupTeamDragEnd(event) {
            $('.group-team-item').removeClass('dragging');
            $('.group-dropzone').removeClass('drag-hover');
            $('#modalUngroupedDropZone').removeClass('drag-hover');
        }

        function onGroupDragOver(event) {
            event.preventDefault();
            event.dataTransfer.dropEffect = 'move';
            $(event.currentTarget).addClass('drag-hover');
        }

        function onGroupDragLeave(event) {
            $(event.currentTarget).removeClass('drag-hover');
        }

        function onGroupDrop(event, targetBangId) {
            event.preventDefault();
            $(event.currentTarget).removeClass('drag-hover');
            if (!draggedGroupTeamPayload) return;

            const team = modalData.allTeams.find(t => t.dangKyThiDauId === draggedGroupTeamPayload.teamId);
            if (team) {
                team.bangDauId = parseInt(targetBangId);
                const targetBang = modalData.bangDaus.find(b => b.id === parseInt(targetBangId));
                team.tenBangDau = targetBang ? targetBang.ten : null;
                renderModalGroupingUI();
            }
            draggedGroupTeamPayload = null;
        }

        function onUngroupedDragOver(event) {
            event.preventDefault();
            event.dataTransfer.dropEffect = 'move';
            $('#modalUngroupedDropZone').addClass('drag-hover');
        }

        function onUngroupedDragLeave(event) {
            $('#modalUngroupedDropZone').removeClass('drag-hover');
        }

        function onUngroupedDrop(event) {
            event.preventDefault();
            $('#modalUngroupedDropZone').removeClass('drag-hover');
            if (!draggedGroupTeamPayload) return;

            const team = modalData.allTeams.find(t => t.dangKyThiDauId === draggedGroupTeamPayload.teamId);
            if (team) {
                team.bangDauId = null;
                team.tenBangDau = null;
                renderModalGroupingUI();
            }
            draggedGroupTeamPayload = null;
        }

        function removeTeamFromGroup(teamId) {
            const team = modalData.allTeams.find(t => t.dangKyThiDauId === teamId);
            if (team) {
                team.bangDauId = null;
                team.tenBangDau = null;
                renderModalGroupingUI();
            }
        }

        function initModalGroups(targetCount) {
            const gdmId = parseInt($('#modalGiaiDauMonId').val() || (modalData ? modalData.giaiDauMonTheThaoId : 0));
            if (!gdmId) {
                Swal.fire('Lưu ý', 'Vui lòng chọn môn thi đấu trước khi tạo bảng.', 'warning');
                return;
            }
            const count = targetCount || modalData.soBangCauHinh || 4;
