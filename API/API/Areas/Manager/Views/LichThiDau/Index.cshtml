                                    <i class="fa-solid fa-medal fa-2x text-warning mb-1"></i>
                                    <div class="fw-bold small">HẠNG BA (HCĐ)</div>
                                    <div class="text-truncate fw-bold mt-1" style="font-size: 0.8rem;" title="${escapeHtml(thirdPlaceTeam?.tenDangKy || thirdPlaceTeam?.tenDoi || 'Chờ xác định')}">${escapeHtml(thirdPlaceTeam?.tenDangKy || thirdPlaceTeam?.tenDoi || 'Chờ xác định')}</div>
                                    <small class="text-white-50 text-truncate d-block" style="font-size: 0.7rem;">${escapeHtml(thirdPlaceTeam?.tenDonVi || '')}</small>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }

            // Gắn hai cột Bảng A & Bảng B vào container
            const branchesHtml = `
                <!-- BẢNG A (NHÁNH TRÊN) -->
                <div class="col-lg-6">
                    <div class="card bracket-branch-card shadow-sm h-100">
                        <div class="card-header py-2 px-3 text-white d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, #1d4ed8, #2563eb);">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-white text-primary fw-bold">BẢNG A</span>
                                <strong class="small">NHÁNH TRÊN (TOP HALF)</strong>
                            </div>
                            <span class="badge bg-white-subtle text-white small">${teamsA.length} đội</span>
                        </div>
                        <div class="card-body p-3">
                            <h6 class="fw-bold text-dark small mb-2"><i class="fa-solid fa-users-rectangle text-primary me-1"></i> Danh Sách Hạt Giống Xếp Vào Bảng A</h6>
                            ${buildBranchTableHtml(teamsA, 'A', 'primary')}

                            <h6 class="fw-bold text-dark small mt-3 mb-2"><i class="fa-solid fa-arrows-turn-to-dots text-primary me-1"></i> Tiến Trình Trận Đấu Bảng A</h6>
                            ${buildBranchMatchesHtml(branchAMatches)}
                        </div>
                    </div>
                </div>

                <!-- BẢNG B (NHÁNH DƯỚI) -->
                <div class="col-lg-6">
                    <div class="card bracket-branch-card shadow-sm h-100">
                        <div class="card-header py-2 px-3 text-white d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, #7c3aed, #6d28d9);">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-white text-purple fw-bold" style="color: #6d28d9;">BẢNG B</span>
                                <strong class="small">NHÁNH DƯỚI (BOTTOM HALF)</strong>
                            </div>
                            <span class="badge bg-white-subtle text-white small">${teamsB.length} đội</span>
                        </div>
                        <div class="card-body p-3">
                            <h6 class="fw-bold text-dark small mb-2"><i class="fa-solid fa-users-rectangle text-purple me-1" style="color: #6d28d9;"></i> Danh Sách Hạt Giống Xếp Vào Bảng B</h6>
                            ${buildBranchTableHtml(teamsB, 'B', 'purple')}

                            <h6 class="fw-bold text-dark small mt-3 mb-2"><i class="fa-solid fa-arrows-turn-to-dots text-purple me-1" style="color: #6d28d9;"></i> Tiến Trình Trận Đấu Bảng B</h6>
                            ${buildBranchMatchesHtml(branchBMatches)}
                        </div>
                    </div>
                </div>

                <!-- VÒNG CHUNG KẾT & PODIUM -->
                <div class="col-12 mt-3">
                    <div class="card border shadow-sm">
                        <div class="card-header bg-white py-2 px-3 d-flex justify-content-between align-items-center border-bottom">
                            <span class="fw-bold text-dark small">
                                <i class="fa-solid fa-crown text-warning me-1"></i> Vòng Quyết Định — Chung Kết & Tranh Hạng Ba
                            </span>
                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Huy Chương Vàng - Bạc - Đồng</span>
                        </div>
                        <div class="card-body p-3">
                            <div class="row g-3">
                                ${finalMatches.map(m => {
                                    const isFinal = m.tenTran.toLowerCase().includes('chung kết') && !m.tenTran.toLowerCase().includes('bán') && !m.tenTran.toLowerCase().includes('tứ');
                                    const headerClass = isFinal ? 'bg-warning text-dark' : 'bg-secondary text-white';
                                    const d1 = m.doi1 ? escapeHtml(m.doi1.tenDangKy || m.doi1.tenDoi || 'Đội 1') : 'Thắng Bán kết 1';
                                    const d2 = m.doi2 ? escapeHtml(m.doi2.tenDangKy || m.doi2.tenDoi || 'Đội 2') : 'Thắng Bán kết 2';
                                    const timeStr = m.thoiGianDuKien ? formatDate(m.thoiGianDuKien, true) : 'Chưa xếp giờ';
                                    const scoreBadge = (m.diemDoi1 != null && m.diemDoi2 != null)
                                        ? `<span class="badge bg-dark fs-6 px-3 py-1">${m.diemDoi1} - ${m.diemDoi2}</span>`
                                        : `<span class="badge bg-light text-muted border">Chưa đấu</span>`;

                                    return `
                                        <div class="col-md-6">
                                            <div class="border rounded p-3 bg-white shadow-2xs h-100 ${isFinal ? 'border-warning' : ''}">
                                                <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                                                    <span class="badge ${headerClass} fw-bold">${escapeHtml(m.tenTran)}</span>
                                                    <div class="d-flex align-items-center gap-1">
                                                        <small class="text-muted"><i class="fa-regular fa-clock me-1"></i>${timeStr}</small>
                                                        ${m.tranDauId ? `<button type="button" class="btn btn-2xs btn-outline-primary" onclick="openScoreModal(${m.tranDauId})" title="Cập nhật điểm"><i class="fa-solid fa-pen-to-square"></i></button>` : ''}
                                                    </div>
                                                </div>
                                                <div class="d-flex justify-content-between align-items-center my-2">
                                                    <div class="text-truncate me-2" style="max-width: 40%;">
                                                        <strong class="d-block text-dark ${m.doiThangDangKyId && m.doi1 && m.doi1.dangKyThiDauId === m.doiThangDangKyId ? 'text-success' : ''}">${d1}</strong>
                                                        <small class="text-muted">${escapeHtml(m.doi1?.tenDonVi || '')}</small>
                                                    </div>
                                                    <div>${scoreBadge}</div>
                                                    <div class="text-truncate text-end ms-2" style="max-width: 40%;">
                                                        <strong class="d-block text-dark ${m.doiThangDangKyId && m.doi2 && m.doi2.dangKyThiDauId === m.doiThangDangKyId ? 'text-success' : ''}">${d2}</strong>
                                                        <small class="text-muted">${escapeHtml(m.doi2?.tenDonVi || '')}</small>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    `;
                                }).join('')}
                            </div>
                            ${podiumHtml}
                        </div>
                    </div>
                </div>
            `;

            container.html(branchesHtml);
        }

        // ==================== KHÔNG GIAN 2: MODAL XẾP CẶP THỦ CÔNG (KÉO THẢ & CHỈNH SỬA) ====================
        function openManualPairingModal() {
            const currentGiaiDau = $('#mainGiaiDauSelect').val();
            if (currentGiaiDau) {
                $('#modalGiaiDauId').val(currentGiaiDau);
                onModalGiaiDauChanged(currentGiaiDau);
            }
            $('#modalManualPairing').modal('show');
        }

        function onModalGiaiDauChanged(giaiDauId) {
            if (!giaiDauId) {
                allModalSports = [];
                $('#modalDanhMucId').html('<option value="">-- Tất cả danh mục --</option>');
                $('#modalGiaiDauMonId').html('<option value="">-- Chọn môn thể thao --</option>');
                $('#modalPairingPlaceholder').removeClass('d-none');
                $('#modalPairingContent').addClass('d-none');
                return;
            }

            $.get('/Manager/LichThiDau/GetMonByGiaiDau', { giaiDauId: parseInt(giaiDauId) }, function (res) {
                if (res.success && res.data && res.data.length > 0) {
                    allModalSports = res.data;

                    const dmMap = new Map();
                    allModalSports.forEach(m => {
                        if (m.danhMucId && m.tenDanhMuc) {
                            dmMap.set(m.danhMucId, m.tenDanhMuc);
                        }
                    });

                    let dmOpts = '<option value="">-- Tất cả danh mục --</option>';
                    dmMap.forEach((name, id) => {
                        dmOpts += `<option value="${id}">${escapeHtml(name)}</option>`;
                    });
                    $('#modalDanhMucId').html(dmOpts);

                    const currentMainDm = $('#mainDanhMucSelect').val();
                    if (currentMainDm && dmMap.has(parseInt(currentMainDm))) {
                        $('#modalDanhMucId').val(currentMainDm);
                    }

                    renderModalMonSelect();

                    const currentMon = $('#mainMonSelect').val();
                    if (currentMon && allModalSports.some(m => m.id == currentMon)) {
                        $('#modalGiaiDauMonId').val(currentMon);
                    }

                    loadModalPairingData();
                } else {
                    allModalSports = [];
                    $('#modalDanhMucId').html('<option value="">-- Tất cả danh mục --</option>');
                    $('#modalGiaiDauMonId').html('<option value="">-- Chọn môn thể thao --</option>');
                    $('#modalPairingPlaceholder').removeClass('d-none');
                    $('#modalPairingContent').addClass('d-none');
                }
            });
        }

        function onModalDanhMucChanged(danhMucId) {
            renderModalMonSelect(danhMucId);
            loadModalPairingData();
        }

        function renderModalMonSelect(danhMucId) {
            danhMucId = danhMucId !== undefined ? danhMucId : $('#modalDanhMucId').val();
            let filtered = allModalSports;
            if (danhMucId) {
                filtered = allModalSports.filter(m => m.danhMucId == parseInt(danhMucId));
            }

            let opts = '<option value="">-- Chọn môn thể thao --</option>';
            filtered.forEach(m => {
                const categoryBadge = m.tenDanhMuc ? ` [${escapeHtml(m.tenDanhMuc)}]` : '';
                opts += `<option value="${m.id}">${escapeHtml(m.ten)}${categoryBadge}</option>`;
            });
            $('#modalGiaiDauMonId').html(opts);
            if (filtered.length > 0) {
                $('#modalGiaiDauMonId').val(filtered[0].id);
            }
        }

        function loadModalPairingData() {
            const giaiDauMonTheThaoId = $('#modalGiaiDauMonId').val();
            if (!giaiDauMonTheThaoId) {
                $('#modalPairingPlaceholder').removeClass('d-none');
                $('#modalPairingContent').addClass('d-none');
                return;
            }

            const vongDauId = $('#modalVongDauId').val();
            const bangDauId = $('#modalBangDauId').val();

            $('#modalPairingPlaceholder').addClass('d-none');
            $('#modalPairingContent').addClass('d-none');
            $('#modalPairingLoading').removeClass('d-none');

            $.ajax({
                url: '/Manager/LichThiDau/GetManualPairingData',
                type: 'GET',
                data: {
                    giaiDauMonTheThaoId: parseInt(giaiDauMonTheThaoId),
                    vongDauId: vongDauId ? parseInt(vongDauId) : undefined,
                    bangDauId: bangDauId ? parseInt(bangDauId) : undefined
                },
                success: function (res) {
                    $('#modalPairingLoading').addClass('d-none');
                    if (res.success && res.data) {
                        modalData = {
                            giaiDauMonTheThaoId: res.data.giaiDauMonTheThaoId,
                            laMonDongDoi: res.data.laMonDongDoi,
                            vongDaus: res.data.vongDaus || [],
                            bangDaus: res.data.bangDaus || [],
                            sanDaus: res.data.sanDaus || [],
                            allTeams: res.data.allTeams || [],
                            unpairedTeams: res.data.unpairedTeams || [],
                            pairs: res.data.existingPairs || []
                        };

                        // Cập nhật Vòng đấu dropdown trong modal
                        updateModalVongDauSelect(modalData.vongDaus, vongDauId);
                        // Cập nhật Bảng đấu dropdown trong modal
                        updateModalBangDauSelect(modalData.bangDaus, bangDauId);

                        // Nếu chưa có cặp đấu nào trong DB và có đội chưa xếp -> khởi tạo các cặp đấu rỗng
                        if (modalData.pairs.length === 0 && modalData.allTeams.length > 0) {
                            const numPairs = Math.max(1, Math.ceil(modalData.unpairedTeams.length / 2));
                            for (let i = 1; i <= numPairs; i++) {
                                modalData.pairs.push({
                                    tranDauId: null,
                                    soTran: i,
                                    tenTran: `Trận ${i}`,
                                    vongDauId: modalData.vongDaus[0]?.id || null,
                                    bangDauId: bangDauId ? parseInt(bangDauId) : (modalData.bangDaus[0]?.id || null),
                                    sanDauId: null,
                                    thoiGianDuKien: null,
                                    trangThai: 'ChuaDau',
                                    doi1: null,
                                    doi2: null
                                });
                            }
                        }

                        $('#modalPairingContent').removeClass('d-none');
                        renderModalPairingUI();
                    } else {
                        $('#modalPairingPlaceholder').removeClass('d-none');
                        Swal.fire('Lỗi', res.message || 'Không thể tải dữ liệu xếp cặp.', 'error');
                    }
                },
                error: function (xhr) {
                    $('#modalPairingLoading').addClass('d-none');
                    $('#modalPairingPlaceholder').removeClass('d-none');
                    Swal.fire('Lỗi', xhr.responseJSON?.message || 'Có lỗi xảy ra khi tải dữ liệu.', 'error');
                }
            });
        }

        function updateModalVongDauSelect(vongDaus, selectedId) {
            let opts = '<option value="">-- Tất cả vòng --</option>';
            vongDaus.forEach(v => {
                const sel = (selectedId && parseInt(selectedId) === v.id) ? 'selected' : '';
                opts += `<option value="${v.id}" ${sel}>${escapeHtml(v.ten)}</option>`;
            });
            $('#modalVongDauId').html(opts);
        }

        function updateModalBangDauSelect(bangDaus, selectedId) {
            if (!bangDaus || bangDaus.length === 0) {
                $('#modalBangDauCol').addClass('d-none');
                return;
            }
            $('#modalBangDauCol').removeClass('d-none');
            let opts = '<option value="">-- Tất cả bảng --</option>';
            bangDaus.forEach(b => {
                const sel = (selectedId && parseInt(selectedId) === b.id) ? 'selected' : '';
                opts += `<option value="${b.id}" ${sel}>${escapeHtml(b.ten)}</option>`;
            });
            $('#modalBangDauId').html(opts);
        }

        function renderModalPairingUI() {
            renderModalUnpairedTeams();
            renderModalMatchesContainer();
            $('#modalUnpairedCountBadge').text(modalData.unpairedTeams.length);
            $('#modalPairCountBadge').text(`${modalData.pairs.length} cặp`);
        }

        function renderModalUnpairedTeams() {
            const container = $('#modalUnpairedTeamsList');
            container.empty();

            if (!modalData.unpairedTeams || modalData.unpairedTeams.length === 0) {
                container.html(`
                    <div class="text-center text-muted py-4">
                        <i class="fa-solid fa-circle-check text-success fa-2x mb-2"></i>
                        <div class="fw-semibold small text-success">Đã xếp hết các đội!</div>
                        <small class="text-muted">Tất cả các đội đã được phân vào cặp đấu.</small>
                    </div>
                `);
                return;
            }

            modalData.unpairedTeams.forEach(team => {
                const teamName = escapeHtml(getParticipantDisplayName(team, true, `Đội #${team.dangKyThiDauId}`));
                const unitName = team.tenDonVi ? escapeHtml(team.tenDonVi) : 'Tự do';
                const vdvList = (team.vanDongVienNames && team.vanDongVienNames.length > 0)
                    ? `<div class="text-muted small mt-1" style="font-size: 0.75rem;"><i class="fa-solid fa-user me-1"></i>${escapeHtml(team.vanDongVienNames.slice(0, 2).join(', '))}${team.vanDongVienNames.length > 2 ? ` (+${team.vanDongVienNames.length - 2})` : ''}</div>`
                    : '';
                const bangTag = team.tenBangDau ? `<span class="badge bg-info-subtle text-info border small me-1">${escapeHtml(team.tenBangDau)}</span>` : '';

                const cardHtml = `
                    <div class="team-drag-card modal-unpaired-team-item shadow-2xs"
                         draggable="true"
                         ondragstart="onTeamDragStart(event, ${team.dangKyThiDauId}, -1, 0)"
                         ondragend="onTeamDragEnd(event)"
                         data-team-id="${team.dangKyThiDauId}">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center flex-grow-1 overflow-hidden me-2">
                                <i class="fa-solid fa-grip-vertical text-muted me-2"></i>
                                <div class="text-truncate">
                                    <strong class="text-dark d-block text-truncate" style="font-size: 0.85rem;" title="${teamName}">${teamName}</strong>
                                    <small class="text-muted">${bangTag}<i class="fa-solid fa-shield-halved text-secondary me-1"></i>${unitName}</small>
                                </div>
                            </div>
                            <button type="button" class="btn btn-xs btn-outline-primary py-0 px-2 flex-shrink-0"
                                    title="Gán nhanh vào cặp đấu trống"
                                    onclick="quickAssignTeam(${team.dangKyThiDauId})">
                                <i class="fa-solid fa-plus me-1"></i>Gán
                            </button>
                        </div>
                        ${vdvList}
                    </div>
                `;
                container.append(cardHtml);
            });

            filterModalUnpairedTeams();
        }

        function filterModalUnpairedTeams() {
            const query = ($('#modalSearchUnpairedTeam').val() || '').toLowerCase().trim();
            if (!query) {
                $('.modal-unpaired-team-item').removeClass('d-none');
                return;
            }
            $('.modal-unpaired-team-item').each(function () {
                const text = $(this).text().toLowerCase();
                if (text.includes(query)) {
                    $(this).removeClass('d-none');
                } else {
                    $(this).addClass('d-none');
                }
            });
        }

        function renderModalMatchesContainer() {
            const container = $('#modalMatchesPairContainer');
            container.empty();

            if (!modalData.pairs || modalData.pairs.length === 0) {
                container.html(`
                    <div class="text-center text-muted py-5">
                        <i class="fa-solid fa-arrows-split-up-and-left fa-3x text-muted mb-3"></i>
                        <h6>Chưa có cặp đấu nào trong layout</h6>
                        <button type="button" class="btn btn-sm btn-primary mt-2" onclick="addNewPair()">
                            <i class="fa-solid fa-plus me-1"></i> Thêm Cặp Đấu Mới
                        </button>
                    </div>
                `);
                return;
            }

            modalData.pairs.forEach((pair, idx) => {
                const soTran = pair.soTran || (idx + 1);
                const tenTran = pair.tenTran || `Trận ${soTran}`;
                const timeVal = pair.thoiGianDuKien ? pair.thoiGianDuKien.substring(0, 16) : '';

                let sanOpts = '<option value="">-- Chưa gán sân --</option>';
                modalData.sanDaus.forEach(s => {
                    const sel = (pair.sanDauId && pair.sanDauId === s.id) ? 'selected' : '';
                    sanOpts += `<option value="${s.id}" ${sel}>${escapeHtml(s.ten)} (${escapeHtml(s.tenCumSan || '')})</option>`;
                });

                // Render Slot 1 trong Modal
                let slot1Html = '';
                if (pair.doi1) {
                    const d1Name = escapeHtml(getParticipantDisplayName(pair.doi1, true, `Đội #${pair.doi1.dangKyThiDauId}`));
                    const d1Unit = pair.doi1.tenDonVi ? escapeHtml(pair.doi1.tenDonVi) : 'Tự do';
                    slot1Html = `
                        <div class="slot-team-assigned"
                             draggable="true"
                             ondragstart="onTeamDragStart(event, ${pair.doi1.dangKyThiDauId}, ${idx}, 1)"
                             ondragend="onTeamDragEnd(event)">
                            <div class="overflow-hidden me-2">
                                <strong class="d-block text-truncate text-primary" style="font-size: 0.85rem;" title="${d1Name}">
                                    <i class="fa-solid fa-grip-vertical text-muted me-1"></i>${d1Name}
                                </strong>
                                <small class="text-muted"><i class="fa-solid fa-shield-halved me-1"></i>${d1Unit}</small>
                            </div>
                            <button type="button" class="btn btn-sm btn-link text-danger p-0 ms-1 flex-shrink-0"
                                    title="Gỡ đội về danh sách chưa xếp"
                                    onclick="removeTeamFromSlot(${idx}, 1)">
                                <i class="fa-solid fa-xmark fs-6"></i>
                            </button>
                        </div>
                    `;
                } else {
                    slot1Html = `
                        <span class="text-muted small">
                            <i class="fa-solid fa-arrow-down me-1 text-primary"></i>Kéo & thả <strong>Đội 1</strong> vào đây
                        </span>
                    `;
                }

                // Render Slot 2 trong Modal
                let slot2Html = '';
                if (pair.doi2) {
                    const d2Name = escapeHtml(getParticipantDisplayName(pair.doi2, true, `Đội #${pair.doi2.dangKyThiDauId}`));
                    const d2Unit = pair.doi2.tenDonVi ? escapeHtml(pair.doi2.tenDonVi) : 'Tự do';
                    slot2Html = `
                        <div class="slot-team-assigned"
                             draggable="true"
                             ondragstart="onTeamDragStart(event, ${pair.doi2.dangKyThiDauId}, ${idx}, 2)"
                             ondragend="onTeamDragEnd(event)">
                            <div class="overflow-hidden me-2">
                                <strong class="d-block text-truncate text-primary" style="font-size: 0.85rem;" title="${d2Name}">
                                    <i class="fa-solid fa-grip-vertical text-muted me-1"></i>${d2Name}
                                </strong>
                                <small class="text-muted"><i class="fa-solid fa-shield-halved me-1"></i>${d2Unit}</small>
                            </div>
                            <button type="button" class="btn btn-sm btn-link text-danger p-0 ms-1 flex-shrink-0"
                                    title="Gỡ đội về danh sách chưa xếp"
                                    onclick="removeTeamFromSlot(${idx}, 2)">
                                <i class="fa-solid fa-xmark fs-6"></i>
                            </button>
                        </div>
                    `;
                } else {
                    slot2Html = `
                        <span class="text-muted small">
                            <i class="fa-solid fa-arrow-down me-1 text-primary"></i>Kéo & thả <strong>Đội 2</strong> vào đây
                        </span>
                    `;
                }

                const card = `
                    <div class="match-pair-card p-3 shadow-xs">
                        <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 pb-2 border-bottom gap-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-dark rounded-pill">#${soTran}</span>
                                <strong class="text-dark small">${escapeHtml(tenTran)}</strong>
                            </div>
                            <div class="d-flex align-items-center gap-2 flex-grow-1 flex-md-grow-0 justify-content-end">
                                <div style="min-width: 150px;">
                                    <select class="form-select form-select-sm" id="pairSan_${idx}" onchange="modalData.pairs[${idx}].sanDauId = this.value ? parseInt(this.value) : null;">
                                        ${sanOpts}
                                    </select>
                                </div>
                                <div style="min-width: 160px;">
                                    <input type="datetime-local" class="form-control form-control-sm" id="pairTime_${idx}" value="${timeVal}" onchange="modalData.pairs[${idx}].thoiGianDuKien = this.value || null;">
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-danger" title="Xóa cặp đấu này" onclick="deleteMatchCard(${idx})">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </div>
                        </div>

                        <div class="row g-2 align-items-center">
                            <div class="col-md-5">
                                <div class="pair-dropzone p-2 ${pair.doi1 ? 'bg-white border-primary' : ''}"
                                     data-match-index="${idx}"
                                     data-slot="1"
                                     ondragover="onSlotDragOver(event)"
                                     ondragleave="onSlotDragLeave(event)"
                                     ondrop="onSlotDrop(event, ${idx}, 1)">
                                    ${slot1Html}
                                </div>
                            </div>
                            <div class="col-md-2 text-center">
                                <div class="vs-divider my-1">
                                    <div class="vs-circle">VS</div>
                                    <button type="button" class="btn btn-xs btn-light border p-1 rounded-circle mt-1 shadow-2xs"
                                            title="Đổi chỗ 2 đội (Swap)"
                                            onclick="swapTeams(${idx})">
                                        <i class="fa-solid fa-repeat text-secondary" style="font-size: 0.75rem;"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-5">
                                <div class="pair-dropzone p-2 ${pair.doi2 ? 'bg-white border-primary' : ''}"
                                     data-match-index="${idx}"
                                     data-slot="2"
                                     ondragover="onSlotDragOver(event)"
                                     ondragleave="onSlotDragLeave(event)"
                                     ondrop="onSlotDrop(event, ${idx}, 2)">
                                    ${slot2Html}
                                </div>
                            </div>
                        </div>
                    </div>
                `;
                container.append(card);
            });
        }

        // ==================== XỬ LÝ KÉO THẢ DRAG & DROP TRONG MODAL ====================
        function onTeamDragStart(event, teamId, fromMatchIndex, fromSlot) {
            draggedPayload = {
                teamId: parseInt(teamId),
                fromMatchIndex: parseInt(fromMatchIndex),
                fromSlot: parseInt(fromSlot)
            };
            event.dataTransfer.setData('text/plain', JSON.stringify(draggedPayload));
            event.dataTransfer.effectAllowed = 'move';
            $(event.currentTarget).addClass('dragging');
        }

        function onTeamDragEnd(event) {
            $('.team-drag-card').removeClass('dragging');
            $('.slot-team-assigned').removeClass('dragging');
            $('.pair-dropzone').removeClass('drag-hover');
            $('#modalUnpairedDropZone').removeClass('drag-hover');
        }

        function onSlotDragOver(event) {
            event.preventDefault();
            event.dataTransfer.dropEffect = 'move';
            $(event.currentTarget).addClass('drag-hover');
        }

        function onSlotDragLeave(event) {
            $(event.currentTarget).removeClass('drag-hover');
        }

        function onSlotDrop(event, targetMatchIndex, targetSlot) {
            event.preventDefault();
            $(event.currentTarget).removeClass('drag-hover');
            if (!draggedPayload) return;

            handleTeamDrop(draggedPayload, targetMatchIndex, targetSlot);
            draggedPayload = null;
        }

        function onUnpairedDragOver(event) {
            event.preventDefault();
            event.dataTransfer.dropEffect = 'move';
            $('#modalUnpairedDropZone').addClass('drag-hover');
        }

        function onUnpairedDragLeave(event) {
            $('#modalUnpairedDropZone').removeClass('drag-hover');
        }

        function onUnpairedDrop(event) {
            event.preventDefault();
            $('#modalUnpairedDropZone').removeClass('drag-hover');
            if (!draggedPayload) return;

            if (draggedPayload.fromMatchIndex >= 0) {
                removeTeamFromSlot(draggedPayload.fromMatchIndex, draggedPayload.fromSlot);
            }
            draggedPayload = null;
        }

        function handleTeamDrop(payload, targetMatchIndex, targetSlot) {
            const team = modalData.allTeams.find(t => t.dangKyThiDauId === payload.teamId);
            if (!team) return;

            const targetPair = modalData.pairs[targetMatchIndex];
            if (!targetPair) return;

            const currentOccupant = (targetSlot === 1) ? targetPair.doi1 : targetPair.doi2;

            if (payload.fromMatchIndex >= 0) {
                const sourcePair = modalData.pairs[payload.fromMatchIndex];
                if (payload.fromMatchIndex === targetMatchIndex && payload.fromSlot === targetSlot) {
                    return;
                }

                if (payload.fromMatchIndex === targetMatchIndex) {
                    swapTeams(targetMatchIndex);
                    return;
                }

                if (payload.fromSlot === 1) {
                    sourcePair.doi1 = currentOccupant;
                } else {
                    sourcePair.doi2 = currentOccupant;
                }

                if (targetSlot === 1) {
                    targetPair.doi1 = team;
                } else {
                    targetPair.doi2 = team;
                }
            } else {
                if (currentOccupant) {
                    if (!modalData.unpairedTeams.some(t => t.dangKyThiDauId === currentOccupant.dangKyThiDauId)) {
                        modalData.unpairedTeams.push(currentOccupant);
                    }
                }

                modalData.unpairedTeams = modalData.unpairedTeams.filter(t => t.dangKyThiDauId !== team.dangKyThiDauId);

                if (targetSlot === 1) {
                    targetPair.doi1 = team;
                } else {
                    targetPair.doi2 = team;
                }
            }

            renderModalPairingUI();
        }

        function removeTeamFromSlot(matchIndex, slot) {
            const pair = modalData.pairs[matchIndex];
            if (!pair) return;

            const removedTeam = (slot === 1) ? pair.doi1 : pair.doi2;
            if (!removedTeam) return;

            if (slot === 1) pair.doi1 = null;
            else pair.doi2 = null;

            if (!modalData.unpairedTeams.some(t => t.dangKyThiDauId === removedTeam.dangKyThiDauId)) {
                modalData.unpairedTeams.push(removedTeam);
            }

            renderModalPairingUI();
        }

        function swapTeams(matchIndex) {
            const pair = modalData.pairs[matchIndex];
            if (!pair) return;

            const temp = pair.doi1;
            pair.doi1 = pair.doi2;
            pair.doi2 = temp;

            renderModalPairingUI();
        }

        function deleteMatchCard(matchIndex) {
            const pair = modalData.pairs[matchIndex];
            if (!pair) return;

            if (pair.doi1 && !modalData.unpairedTeams.some(t => t.dangKyThiDauId === pair.doi1.dangKyThiDauId)) {
                modalData.unpairedTeams.push(pair.doi1);
            }
            if (pair.doi2 && !modalData.unpairedTeams.some(t => t.dangKyThiDauId === pair.doi2.dangKyThiDauId)) {
                modalData.unpairedTeams.push(pair.doi2);
            }

            modalData.pairs.splice(matchIndex, 1);

            modalData.pairs.forEach((p, idx) => {
                p.soTran = idx + 1;
                if (!p.tenTran || p.tenTran.startsWith('Trận ')) {
                    p.tenTran = `Trận ${idx + 1}`;
                }
            });

            renderModalPairingUI();
        }

        function addNewPair() {
            const newIdx = modalData.pairs.length + 1;
            modalData.pairs.push({
                tranDauId: null,
                soTran: newIdx,
                tenTran: `Trận ${newIdx}`,
                vongDauId: $('#modalVongDauId').val() ? parseInt($('#modalVongDauId').val()) : (modalData.vongDaus[0]?.id || null),
                bangDauId: $('#modalBangDauId').val() ? parseInt($('#modalBangDauId').val()) : null,
                sanDauId: null,
                thoiGianDuKien: null,
                trangThai: 'ChuaDau',
                doi1: null,
                doi2: null
            });
            renderModalPairingUI();
        }

        function resetAllPairs() {
            Swal.fire({
                title: 'Đặt lại tất cả cặp đấu?',
                text: 'Toàn bộ các đội sẽ được đưa trở lại danh sách chưa xếp!',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Đồng ý đặt lại',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    modalData.pairs.forEach(p => {
                        p.doi1 = null;
                        p.doi2 = null;
                    });
                    modalData.unpairedTeams = [...modalData.allTeams];
                    renderModalPairingUI();
                    SportApp.toast('info', 'Đã đưa tất cả đội về danh sách chưa xếp!');
                }
            });
        }

        function autoDrawRemaining() {
            if (!modalData.unpairedTeams || modalData.unpairedTeams.length === 0) {
                SportApp.toast('info', 'Tất cả các đội đã được xếp cặp đấu!');
                return;
            }

            const shuffled = [...modalData.unpairedTeams];
            for (let i = shuffled.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
            }

            let teamIdx = 0;
            for (let p of modalData.pairs) {
                if (teamIdx >= shuffled.length) break;
                if (!p.doi1) {
                    p.doi1 = shuffled[teamIdx++];
                }
                if (teamIdx >= shuffled.length) break;
                if (!p.doi2) {
                    p.doi2 = shuffled[teamIdx++];
                }
            }

            while (teamIdx < shuffled.length) {
                const t1 = shuffled[teamIdx++];
                const t2 = (teamIdx < shuffled.length) ? shuffled[teamIdx++] : null;
                const newIdx = modalData.pairs.length + 1;
                modalData.pairs.push({
                    tranDauId: null,
                    soTran: newIdx,
                    tenTran: `Trận ${newIdx}`,
                    vongDauId: $('#modalVongDauId').val() ? parseInt($('#modalVongDauId').val()) : (modalData.vongDaus[0]?.id || null),
                    bangDauId: $('#modalBangDauId').val() ? parseInt($('#modalBangDauId').val()) : null,
                    sanDauId: null,
                    thoiGianDuKien: null,
                    trangThai: 'ChuaDau',
                    doi1: t1,
                    doi2: t2
                });
            }

            modalData.unpairedTeams = [];
            renderModalPairingUI();
            SportApp.toast('success', 'Đã bốc thăm ngẫu nhiên các đội vào cặp đấu!');
        }

        function quickAssignTeam(teamId) {
            const team = modalData.unpairedTeams.find(t => t.dangKyThiDauId === teamId);
            if (!team) return;

            let found = false;
            for (let p of modalData.pairs) {
                if (!p.doi1) {
                    p.doi1 = team;
                    found = true;
                    break;
                }
                if (!p.doi2) {
                    p.doi2 = team;
                    found = true;
                    break;
                }
            }

            if (!found) {
                const newIdx = modalData.pairs.length + 1;
                modalData.pairs.push({
                    tranDauId: null,
                    soTran: newIdx,
                    tenTran: `Trận ${newIdx}`,
                    vongDauId: $('#modalVongDauId').val() ? parseInt($('#modalVongDauId').val()) : (modalData.vongDaus[0]?.id || null),
                    bangDauId: $('#modalBangDauId').val() ? parseInt($('#modalBangDauId').val()) : null,
                    sanDauId: null,
                    thoiGianDuKien: null,
                    trangThai: 'ChuaDau',
                    doi1: team,
                    doi2: null
                });
            }

            modalData.unpairedTeams = modalData.unpairedTeams.filter(t => t.dangKyThiDauId !== teamId);
            renderModalPairingUI();
        }

        function saveManualPairings() {
            const monId = $('#modalGiaiDauMonId').val();
            if (!monId) {
                Swal.fire('Lỗi', 'Vui lòng chọn môn thi đấu.', 'warning');
                return;
            }

            if (!modalData.pairs || modalData.pairs.length === 0) {
                Swal.fire('Thông báo', 'Chưa có cặp đấu nào được tạo để lưu.', 'info');
                return;
            }

            // Sync input values from DOM in modal
            modalData.pairs.forEach((p, idx) => {
                const sanVal = $(`#pairSan_${idx}`).val();
                const timeVal = $(`#pairTime_${idx}`).val();
                p.sanDauId = sanVal ? parseInt(sanVal) : null;
                p.thoiGianDuKien = timeVal || null;
            });

            const payload = {
                giaiDauMonTheThaoId: parseInt(monId),
                vongDauId: $('#modalVongDauId').val() ? parseInt($('#modalVongDauId').val()) : null,
                bangDauId: $('#modalBangDauId').val() ? parseInt($('#modalBangDauId').val()) : null,
                pairs: modalData.pairs.map((p, idx) => ({
                    tranDauId: p.tranDauId,
                    soTran: p.soTran || (idx + 1),
                    tenTran: p.tenTran || `Trận ${idx + 1}`,
                    vongDauId: p.vongDauId,
                    bangDauId: p.bangDauId,
                    sanDauId: p.sanDauId,
                    thoiGianDuKien: p.thoiGianDuKien,
                    doi1DangKyId: p.doi1 ? p.doi1.dangKyThiDauId : null,
                    doi2DangKyId: p.doi2 ? p.doi2.dangKyThiDauId : null
                }))
            };

            $('#btnSavePairs').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Đang lưu...');

            $.ajax({
                url: '/Manager/LichThiDau/SaveManualPairing',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    $('#btnSavePairs').prop('disabled', false).html('<i class="fa-solid fa-floppy-disk me-1"></i> Lưu Cặp Đấu');
                    if (res.success) {
                        $('#modalManualPairing').modal('hide');
                        Swal.fire('Thành Công!', res.message || 'Đã lưu danh sách xếp cặp thi đấu thành công!', 'success');
                        // Cập nhật lại giao diện xem ngoài trang chính
                        loadMainData();
                    } else {
                        Swal.fire('Lỗi', res.message || 'Không thể lưu xếp cặp.', 'error');
                    }
                },
                error: function (xhr) {
                    $('#btnSavePairs').prop('disabled', false).html('<i class="fa-solid fa-floppy-disk me-1"></i> Lưu Cặp Đấu');
                    Swal.fire('Lỗi', xhr.responseJSON?.message || 'Có lỗi xảy ra khi lưu xếp cặp.', 'error');
                }
            });
        }

        // ==================== KHÔNG GIAN 3: BẢNG TỔNG HỢP (TABLE VIEW) ====================
        function loadTableData(page) {
            currentTablePage = page;
            const keyword = $('#keyword').val().trim();
            const giaiDauId = $('#mainGiaiDauSelect').val();
            const danhMucId = $('#mainDanhMucSelect').val();
            const monId = $('#mainMonSelect').val();
            const date = $('#dateFilter').val();
            const status = $('#statusFilter').val();

            $.ajax({
                url: '/Manager/LichThiDau/GetPagedData',
                type: 'GET',
                data: {
                    pageIndex: page,
                    pageSize: pageSize,
                    keyword: keyword || undefined,
                    giaiDauId: giaiDauId ? parseInt(giaiDauId) : undefined,
                    danhMucMonTheThaoId: danhMucId ? parseInt(danhMucId) : undefined,
                    giaiDauMonTheThaoId: monId ? parseInt(monId) : undefined,
                    ngay: date || undefined,
                    trangThai: status || undefined
                },
                success: function (res) {
                    if (res.success && res.data) {
                        renderTable(res.data);
                    }
                }
            });
        }

        function loadData(page) {
            loadTableData(page);
        }

        function renderTable(data) {
            const items = data.items || [];
            if (items.length === 0) {
                $('#tblBody').html('<tr><td colspan="7" class="text-center py-5 text-muted">Không có trận đấu nào trong lịch thi đấu.</td></tr>');
                $('#paginationInfo').text('Hiển thị 0 trên 0 trận đấu');
                $('#paginationList').empty();
                return;
            }

            let html = '';
            const start = (data.pageIndex - 1) * data.pageSize;

            $.each(items, function (i, item) {
                const stt = start + i + 1;
                const statusBadge = getStatusBadge(item.trangThai);
                const startTime = item.thoiGianBatDau ? formatDate(item.thoiGianBatDau, true) : 'Chưa xếp giờ';
                const team1 = item.tenDoi1 || 'Đội 1';
                const team2 = item.tenDoi2 || 'Đội 2';
                const score1 = item.diemDoi1 ?? '-';
                const score2 = item.diemDoi2 ?? '-';

                        let participantColHtml = '';
                const isItemHeat = (item.thanhPhanTranDaus && item.thanhPhanTranDaus.length > 2) || (item.tenTran && (item.tenTran.includes('Lượt') || item.tenTran.includes('Heat')));
                if (isItemHeat && item.thanhPhanTranDaus && item.thanhPhanTranDaus.length > 0) {
                    const lanesList = item.thanhPhanTranDaus.map(tp => `<span class="badge bg-light text-dark border me-1 mb-1" style="font-size: 0.72rem;">Làn ${tp.soLane || tp.viTri}: <strong>${escapeHtml(tp.tenDangKy || tp.tenDoi || 'VĐV')}</strong></span>`).join('');
                    participantColHtml = `
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-primary-subtle text-primary border"><i class="fa-solid fa-flag-checkered me-1"></i>Lượt thi (${item.thanhPhanTranDaus.length} làn)</span>
                            <span class="fw-bold text-dark">${escapeHtml(item.tenTran || '')}</span>
                        </div>
                        <div class="text-muted small">
                            ${lanesList}
                        </div>
                        <small class="text-muted"><span class="badge bg-light text-secondary border">Mã: ${escapeHtml(item.ma || '')}</span> ${item.tenDanhMucMonTheThao ? `<span class="badge bg-primary-subtle text-primary border me-1">${escapeHtml(item.tenDanhMucMonTheThao)}</span>` : ''} ${escapeHtml(item.tenMonTheThao || '')}</small>
                    `;
                } else if (isItemHeat) {
                    participantColHtml = `
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-warning-subtle text-warning border"><i class="fa-solid fa-trophy me-1"></i>Lượt Chung Kết</span>
                            <span class="fw-bold text-dark">${escapeHtml(item.tenTran || '')}</span>
                        </div>
                        <small class="text-muted fst-italic">Chờ xếp Top 8 VĐV xuất sắc từ các lượt vòng loại</small>
                    `;
                } else {
                    participantColHtml = `
                        <div class="d-flex align-items-center gap-2">
                            <span class="fw-bold text-dark">${escapeHtml(team1)}</span>
                            <span class="badge bg-light text-secondary border px-2">VS</span>
                            <span class="fw-bold text-dark">${escapeHtml(team2)}</span>
                        </div>
                        <small class="text-muted"><span class="badge bg-light text-secondary border">Mã: ${escapeHtml(item.ma || '')}</span> ${item.tenDanhMucMonTheThao ? `<span class="badge bg-primary-subtle text-primary border me-1">${escapeHtml(item.tenDanhMucMonTheThao)}</span>` : ''} ${escapeHtml(item.tenMonTheThao || '')}</small>
                    `;
                }

                const scoreDisplay = isItemHeat 
                    ? `<span class="badge bg-info-subtle text-info border">Tính giờ / Xếp hạng</span>` 
                    : `<span class="fw-bold fs-6 text-dark">${score1} - ${score2}</span>`;

                html += `
                    <tr>
                        <td class="ps-3 fw-bold text-muted">${stt}</td>
                        <td>
                            ${participantColHtml}
                        </td>
                        <td>
                            <div class="fw-semibold text-primary"><i class="fa-regular fa-clock me-1"></i>${startTime}</div>
                            <small class="text-muted"><i class="fa-solid fa-location-dot me-1"></i>${escapeHtml(item.tenSanDau || 'Chưa xếp sân')}</small>
                        </td>
                        <td>
                            <div><span class="badge bg-info-subtle text-info border">${escapeHtml(item.tenVongDau || 'Vòng đấu')}</span></div>
                            ${item.tenBangDau ? `<small class="text-muted">Bảng: ${escapeHtml(item.tenBangDau)}</small>` : ''}
                        </td>
                        <td>
                            ${scoreDisplay}
                        </td>
                        <td>${statusBadge}</td>
                        <td class="text-end pe-3">
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-primary" title="Cập nhật tỷ số" onclick="openScoreModal(${item.id})">
                                    <i class="fa-solid fa-pen-to-square me-1"></i>Điểm
                                </button>
                                <button type="button" class="btn btn-light border" title="Xóa trận" onclick="deleteMatch(${item.id})">
                                    <i class="fa-solid fa-trash text-danger"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            });

            $('#tblBody').html(html);

            const total = data.totalCount || 0;
            const from = total === 0 ? 0 : start + 1;
            const to = Math.min(start + data.pageSize, total);
            $('#paginationInfo').text(`Hiển thị ${from} - ${to} trên tổng số ${total} trận đấu`);

            renderPagination(data.pageIndex, data.totalPages);
        }

        function getStatusBadge(status) {
            switch (status) {
                case 'ChuaDienRa':
                    return '<span class="badge bg-secondary-subtle text-secondary border badge-status">Chưa đấu</span>';
                case 'DangDienRa':
                    return '<span class="badge bg-primary-subtle text-primary border badge-status"><i class="fa-solid fa-spinner fa-spin me-1"></i>Đang đấu</span>';
                case 'KetThuc':
                    return '<span class="badge bg-success-subtle text-success border badge-status"><i class="fa-solid fa-check me-1"></i>Kết thúc</span>';
                case 'Huy':
                    return '<span class="badge bg-danger-subtle text-danger border badge-status">Đã hủy</span>';
                default:
                    return `<span class="badge bg-light text-dark border badge-status">${status}</span>`;
            }
        }

        function renderPagination(current, totalPages) {
            if (totalPages <= 1) {
                $('#paginationList').empty();
                return;
            }

            let pagHtml = '';
            pagHtml += `<li class="page-item ${current === 1 ? 'disabled' : ''}">
                <a class="page-link" href="javascript:void(0)" onclick="loadTableData(${current - 1})">&laquo;</a>
            </li>`;

            for (let i = 1; i <= totalPages; i++) {
                if (i === 1 || i === totalPages || (i >= current - 2 && i <= current + 2)) {
                    pagHtml += `<li class="page-item ${i === current ? 'active' : ''}">
                        <a class="page-link" href="javascript:void(0)" onclick="loadTableData(${i})">${i}</a>
                    </li>`;
                }
            }

            pagHtml += `<li class="page-item ${current === totalPages ? 'disabled' : ''}">
                <a class="page-link" href="javascript:void(0)" onclick="loadTableData(${current + 1})">&raquo;</a>
            </li>`;

            $('#paginationList').html(pagHtml);
        }

        function openScoreModal(id) {
            $.get('/Manager/LichThiDau/GetById', { id: id }, function (res) {
                if (res.success && res.data) {
                    currentMatchData = res.data;
                    $('#matchId').val(id);
                    $('#matchTeam1Name').text(currentMatchData.tenDoi1 || 'Đội 1');
                    $('#matchTeam2Name').text(currentMatchData.tenDoi2 || 'Đội 2');
                    $('#matchScore1').val(currentMatchData.diemDoi1 ?? 0);
                    $('#matchScore2').val(currentMatchData.diemDoi2 ?? 0);
                    $('#matchStatus').val(currentMatchData.trangThai || 'ChuaDienRa');
                    $('#matchSanDauId').val(currentMatchData.sanDauId || '');
                    $('#matchStartTime').val(currentMatchData.thoiGianBatDau ? currentMatchData.thoiGianBatDau.substring(0, 16) : '');
                    $('#matchEndTime').val(currentMatchData.thoiGianKetThuc ? currentMatchData.thoiGianKetThuc.substring(0, 16) : '');
                    $('#matchNote').val(currentMatchData.ghiChu || '');
                    $('#matchRoundInfo').text((currentMatchData.tenVongDau || '') + (currentMatchData.tenBangDau ? ' - ' + currentMatchData.tenBangDau : ''));
                    $('#modalScore').modal('show');
                }
            });
        }

        function saveScore() {
            const id = $('#matchId').val();
            if (!id || !currentMatchData) return;

            const payload = {
                giaiDauMonTheThaoId: currentMatchData.giaiDauMonTheThaoId,
                vongDauId: currentMatchData.vongDauId,
                bangDauId: currentMatchData.bangDauId,
                ma: currentMatchData.ma,
                ten: currentMatchData.ten,
                doi1Id: currentMatchData.doi1Id,
                doi2Id: currentMatchData.doi2Id,
                diemDoi1: parseInt($('#matchScore1').val()) || 0,
                diemDoi2: parseInt($('#matchScore2').val()) || 0,
                trangThai: $('#matchStatus').val(),
                sanDauId: $('#matchSanDauId').val() ? parseInt($('#matchSanDauId').val()) : null,
                thoiGianBatDau: $('#matchStartTime').val() || null,
                thoiGianKetThuc: $('#matchEndTime').val() || null,
                ghiChu: $('#matchNote').val().trim() || null
            };

            $.ajax({
                url: `/Manager/LichThiDau/Save?id=${id}`,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    if (res.success) {
                        $('#modalScore').modal('hide');
                        SportApp.toast('success', res.message || 'Cập nhật trận đấu thành công!');
                        loadMainData();
                    } else {
                        Swal.fire('Lỗi', res.message || 'Không thể lưu kết quả.', 'error');
                    }
                }
            });
        }

        function deleteMatch(id) {
            SportApp.confirm('Xóa Trận Đấu?', 'Bạn có chắc muốn xóa trận đấu này khỏi lịch trình?', function () {
                $.post('/Manager/LichThiDau/Delete', { id: id }, function (res) {
                    if (res.success) {
                        SportApp.toast('success', res.message || 'Đã xóa trận đấu!');
                        loadMainData();
                    } else {
                        Swal.fire('Lỗi', res.message || 'Không thể xóa.', 'error');
                    }
                });
            });
        }

        // ==================== TỰ ĐỘNG XẾP LỊCH & KIỂM TRA XUNG ĐỘT ====================
        let currentModalAvailableMons = [];

        function onMonSelected(monId) {
            if (!monId) {
                $('#autoCauHinhAlert').addClass('d-none');
                $('#groupAutoSoDoiMoiBang').removeClass('d-none');
                $('#groupAutoHeatConfig').addClass('d-none');
                return;
            }

            // Kiểm tra thể thức môn thi đấu (Điền kinh, Bơi lội...)
            const selectedOpt = $(`#autoGiaiDauMonId option[value="${monId}"]`);
            const hinhThuc = selectedOpt.data('hinhthuc') || '';
            const selectedMon = currentModalAvailableMons.find(m => m.id == monId);
            const optText = selectedOpt.text() || '';
            const isLeaderboardSport = (hinhThuc === 'TinhDiemXepHang') 
                || (selectedMon && selectedMon.hinhThucThiDau === 'TinhDiemXepHang')
                || optText.includes('Điền kinh') || optText.includes('Bơi') || optText.includes('100m');

            if (isLeaderboardSport) {
                $('#groupAutoSoDoiMoiBang').addClass('d-none');
                $('#groupAutoHeatConfig').removeClass('d-none');
            } else {
                $('#groupAutoSoDoiMoiBang').removeClass('d-none');
                $('#groupAutoHeatConfig').addClass('d-none');
            }

            $.ajax({
                url: '/api/CauHinhLichThiDau/' + monId,
                type: 'GET',
                success: function (res) {
                    if (res) {
                        $('#autoCauHinhAlert').removeClass('d-none');
                        $('#autoCauHinhTitle').html(`<i class="fa-solid fa-heart-pulse me-1 text-danger"></i> Quy tắc bảo vệ thể lực VĐV môn ${res.tenMonTheThao || ''}:`);
                        $('#autoCauHinhDesc').html(`
                            <div class="row g-2 mt-1">
                                <div class="col-6 col-md-3"><i class="fa-solid fa-calendar-day text-primary me-1"></i> Tối đa: <strong>${res.soTranToiDaMoiDoiMoiNgay} trận/ngày</strong></div>
                                <div class="col-6 col-md-3"><i class="fa-solid fa-bed text-success me-1"></i> Nghỉ hồi phục: <strong>${res.nghiToiThieuGiua2TranPhut} phút</strong></div>
                                <div class="col-6 col-md-3"><i class="fa-solid fa-hourglass-half text-warning me-1"></i> Cách vòng: <strong>${res.khoangCachGiuaCacVongGio} giờ</strong></div>
                                <div class="col-6 col-md-3"><i class="fa-solid fa-sun text-info me-1"></i> Ca trưa: <strong>Tránh 11:30 - 14:00</strong></div>
                            </div>
                        `);

                        if (res.thoiLuongTranMacDinhPhut > 0) {
                            $('#autoThoiLuong').val(res.thoiLuongTranMacDinhPhut);
                        }
                        if (res.thoiGianDemDonSanPhut > 0) {
                            $('#autoNghiGiuaTran').val(res.thoiGianDemDonSanPhut);
                        }
                    }
                },
                error: function () {
                    $('#autoCauHinhAlert').addClass('d-none');
                }
            });
        }

        function openAutoScheduleModal() {
            const currentGiaiDau = $('#mainGiaiDauSelect').val();
            if (currentGiaiDau) {
                $('#autoGiaiDauId').val(currentGiaiDau);
                loadMonByGiaiDau(currentGiaiDau);
            }
            $('#modalAutoSchedule').modal('show');
        }

        function loadMonByGiaiDau(giaiDauId) {
            if (!giaiDauId) {
                $('#autoGiaiDauMonId').html('<option value="">-- Chọn môn thể thao --</option>');
                currentModalAvailableMons = [];
                return;
            }
            $.get('/Manager/LichThiDau/GetMonByGiaiDau', { giaiDauId: parseInt(giaiDauId) }, function (res) {
                let opts = '<option value="">-- Chọn môn thể thao --</option>';
                if (res.success && res.data) {
                    currentModalAvailableMons = res.data;
                    res.data.forEach(m => {
                        opts += `<option value="${m.id}" data-hinhthuc="${m.hinhThucThiDau || ''}">${escapeHtml(m.ten)}</option>`;
                    });
                }
                $('#autoGiaiDauMonId').html(opts);
                const currentMon = $('#mainMonSelect').val();
                if (currentMon) {
                    $('#autoGiaiDauMonId').val(currentMon);
                    onMonSelected(currentMon);
                }
            });
        }

        function runAutoSchedule() {
            const giaiDauId = $('#autoGiaiDauId').val();
            const monId = $('#autoGiaiDauMonId').val();

            if (!giaiDauId || !monId) {
                Swal.fire('Lỗi', 'Vui lòng chọn giải đấu và môn thể thao.', 'warning');
                return;
            }

            const selectedSanIds = $('#autoSanDauIds').val() || [];
            const sanIds = selectedSanIds.map(x => parseInt(x));

            const request = {
                giaiDauMonTheThaoId: parseInt(monId),
                ngayBatDau: $('#autoNgayBatDau').val(),
                gioBatDauMoiNgay: $('#autoGioBatDau').val(),
                gioKetThucMoiNgay: $('#autoGioKetThuc').val(),
                thoiLuongTranPhut: parseInt($('#autoThoiLuong').val()) || 60,
                nghiGiuaTranPhut: parseInt($('#autoNghiGiuaTran').val()) || 15,
                soDoiMoiBang: parseInt($('#autoSoDoiMoiBang').val()) || 4,
                soVdvMoiLuotThi: parseInt($('#autoSoVdvMoiLuotThi').val()) || 8,
                soVongThi: parseInt($('#autoSoVongThi').val()) || 1,
                phuongThucPhanNhom: $('#autoPhuongThucPhanNhom').val() || 'random',
                sanDauIds: sanIds,
                xoaLichCu: $('#autoXoaLichCu').is(':checked'),
                tranhTrungLichVdv: $('#autoTranhTrungVdv').is(':checked')
            };

            $('#btnRunSchedule').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Đang tính toán & xếp lịch...');

            $.ajax({
                url: '/Manager/LichThiDau/AutoSchedule',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(request),
                success: function (res) {
                    $('#btnRunSchedule').prop('disabled', false).html('<i class="fa-solid fa-play me-1"></i> Bắt Đầu Xếp Lịch Tự Động');
                    if (res.success) {
                        $('#modalAutoSchedule').modal('hide');
                        Swal.fire('Thành Công!', res.message || 'Thuật toán đã xếp lịch thi đấu thành công!', 'success');
                        loadMainData();
                    } else {
                        Swal.fire('Không thành công', res.message || 'Không thể xếp lịch.', 'error');
                    }
                },
                error: function (xhr) {
                    $('#btnRunSchedule').prop('disabled', false).html('<i class="fa-solid fa-play me-1"></i> Bắt Đầu Xếp Lịch Tự Động');
                    Swal.fire('Lỗi', xhr.responseJSON?.message || 'Có lỗi xảy ra trong quá trình tính toán xếp lịch.', 'error');
                }
            });
        }

        function openConflictModal() {
            const giaiDauId = $('#mainGiaiDauSelect').val();
            if (!giaiDauId) {
                Swal.fire('Thông báo', 'Vui lòng chọn một giải đấu ở bộ lọc trước khi kiểm tra xung đột.', 'info');
                return;
            }

            Swal.fire({
                title: 'Đang kiểm tra xung đột...',
                text: 'Hệ thống đang quét toàn bộ lịch sân bãi và trùng lặp VĐV',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            $.get('/Manager/LichThiDau/CheckConflicts', { giaiDauId: parseInt(giaiDauId) }, function (res) {
                Swal.close();
                if (res.success && res.data) {
                    const report = res.data;
                    const totalConflicts = report.totalConflicts || 0;
                    if (totalConflicts === 0) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Lịch Thi Đấu Hoàn Hảo!',
                            text: 'Không phát hiện bất kỳ xung đột nào về giờ thi đấu, trùng sân hoặc trùng lặp Vận động viên.'
                        });
                    } else {
                        Swal.fire({
                            icon: 'warning',
                            title: `Phát Hiện ${totalConflicts} Xung Đột!`,
                            text: 'Có các trận đấu đang bị trùng sân hoặc VĐV thi đấu cùng lúc. Vui lòng kiểm tra lại khung giờ xếp lịch.'
                        });
                    }
                }
            });
        }

        function resetFilter() {
            $('#keyword').val('');
            $('#dateFilter').val('');
            $('#statusFilter').val('');
            $('#mainDanhMucSelect').val('');
            renderMainMonSelect();
            loadTableData(1);
        }

        function formatDate(str, withTime = false) {
            if (!str) return '-';
            const d = new Date(str);
            if (isNaN(d.getTime())) return str;
            const day = String(d.getDate()).padStart(2, '0');
            const month = String(d.getMonth() + 1).padStart(2, '0');
            const year = d.getFullYear();
            if (withTime) {
                const h = String(d.getHours()).padStart(2, '0');
                const m = String(d.getMinutes()).padStart(2, '0');
                return `${day}/${month}/${year} ${h}:${m}`;
            }
            return `${day}/${month}/${year}`;
        }

        function escapeHtml(text) {
            if (!text) return '';
            return $('<div>').text(text).html();
        }
    </script>
}
