                                            <small class="text-muted">${escapeHtml(m.doi1?.tenDonVi || '')}</small>
                                        </div>
                                        <div>${scoreBadge}</div>
                                        <div class="text-truncate text-end ms-2" style="max-width: 40%;">
                                            <strong class="d-block text-dark ${m.doiThangDangKyId && m.doi2 && m.doi2.dangKyThiDauId === m.doiThangDangKyId ? 'text-success' : ''}">${d2}</strong>
                                            <small class="text-muted">${escapeHtml(m.doi2?.tenDonVi || '')}</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        `;
                    };

                    let koSectionsHtml = '';

                    // 1. Các vòng loại / 1/8 trước Tứ kết (nếu có)
                    if (otherKoMatches.length > 0) {
                        koSectionsHtml += `
                            <div class="mb-4">
                                <div class="d-flex align-items-center justify-content-between mb-2 pb-1 border-bottom">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-secondary-subtle text-secondary border px-2 py-1 fw-bold">
                                            <i class="fa-solid fa-list-ol me-1"></i> VÒNG SƠ LOẠI / VÒNG 1/8
                                        </span>
                                        <span class="small text-muted fw-semibold">(${otherKoMatches.length} trận)</span>
                                    </div>
                                    <small class="text-muted" style="font-size: 0.72rem;">Các trận đấu loại trực tiếp mở màn</small>
                                </div>
                                <div class="row g-3">
                                    ${otherKoMatches.map(renderKoCard).join('')}
                                </div>
                            </div>
                        `;
                    }

                    // 2. Vòng Tứ Kết
                    if (quarterMatches.length > 0) {
                        koSectionsHtml += `
                            <div class="mb-4">
                                <div class="d-flex align-items-center justify-content-between mb-2 pb-1 border-bottom">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge px-2 py-1 fw-bold" style="background-color: #e0e7ff; color: #4338ca; border: 1px solid #c7d2fe;">
                                            <i class="fa-solid fa-layer-group me-1"></i> VÒNG TỨ KẾT (QUARTERFINALS)
                                        </span>
                                        <span class="small text-muted fw-semibold">(${quarterMatches.length} trận)</span>
                                    </div>
                                    <small class="text-muted" style="font-size: 0.72rem;">Xác định 4 đội chiến thắng bước vào Bán kết</small>
                                </div>
                                <div class="row g-3">
                                    ${quarterMatches.map(renderKoCard).join('')}
                                </div>
                            </div>
                        `;
                    }

                    // 3. Vòng Bán Kết
                    if (semiMatches.length > 0) {
                        koSectionsHtml += `
                            <div class="mb-4">
                                <div class="d-flex align-items-center justify-content-between mb-2 pb-1 border-bottom">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 fw-bold">
                                            <i class="fa-solid fa-shield-halved me-1"></i> VÒNG BÁN KẾT (SEMIFINALS)
                                        </span>
                                        <span class="small text-muted fw-semibold">(${semiMatches.length} trận)</span>
                                    </div>
                                    <small class="text-muted" style="font-size: 0.72rem;">Cạnh tranh 2 tấm vé danh giá vào Chung kết</small>
                                </div>
                                <div class="row g-3">
                                    ${semiMatches.map(renderKoCard).join('')}
                                </div>
                            </div>
