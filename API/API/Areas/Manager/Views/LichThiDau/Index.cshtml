                        <div class="overflow-hidden">
                            <strong class="d-block text-truncate text-warning-emphasis" style="font-size: 0.85rem;" title="${escapeHtml(placeholders.t1)}">
                                <i class="fa-solid fa-trophy text-warning me-1"></i>${escapeHtml(placeholders.t1)}
                            </strong>
                            <small class="text-muted"><i class="fa-regular fa-clock me-1"></i>Chờ kết quả Vòng bảng</small>
                        </div>
                    </div>
                `;
            } else {
                slot1Html = `
                    <div class="slot-team-view empty-slot">
                        <span class="small fst-italic">Chưa xếp Đội 1</span>
                    </div>
                `;
            }

            // Slot 2 Display (Chỉ xem)
            const doi2Obj = pair.doi2 || (pair.danhSachVdv && pair.danhSachVdv.length > 1 ? pair.danhSachVdv[1] : null);
            let slot2Html = '';
            if (doi2Obj) {
                const d2Name = escapeHtml(getParticipantDisplayName(doi2Obj, false, `Đội #${doi2Obj.dangKyThiDauId}`));
                const d2Unit = doi2Obj.tenDonVi ? escapeHtml(doi2Obj.tenDonVi) : 'Tự do';
                slot2Html = `
                    <div class="slot-team-view">
                        <div class="overflow-hidden">
                            <strong class="d-block text-truncate text-primary" style="font-size: 0.85rem;" title="${d2Name}">
                                <i class="fa-solid fa-user-shield me-1"></i>${d2Name}
                            </strong>
                            <small class="text-muted"><i class="fa-solid fa-shield-halved me-1"></i>${d2Unit}</small>
