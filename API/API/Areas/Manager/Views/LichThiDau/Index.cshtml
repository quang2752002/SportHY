            }

            const sc1 = pair.tySoDoi1 ?? pair.diemDoi1;
            const sc2 = pair.tySoDoi2 ?? pair.diemDoi2;

            const scoreBtnHtml = '';

            let matchBodyHtml = '';
            const isHeatSport = (mainViewData && (mainViewData.hinhThucThiDau === 'TinhDiemXepHang' || mainViewData.hinhThucThiDau == 6));
            const hasMoreThanTwo = pair.danhSachVdv && pair.danhSachVdv.length > 2;
