            if (!mainViewData.pairs || mainViewData.pairs.length === 0) {
                const totalParticipants = mainViewData.allTeams ? mainViewData.allTeams.length : 0;
                const participantFullLabel = isTeamSport ? 'đội bóng' : 'vận động viên';

                container.html(`
                    <div class="text-center py-5">
                        <div class="mb-3">
                            <span class="d-inline-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-circle" style="width: 72px; height: 72px;">
                                <i class="fa-solid fa-calendar-plus fa-2x"></i>
                            </span>
                        </div>
                        <h6 class="fw-bold text-dark mb-1">Chưa Có Lịch Thi Đấu Cho Môn Này</h6>
                        <p class="text-muted small mb-4 mx-auto" style="max-width: 480px;">
