        // ==================== THUẬT TOÁN ROUND ROBIN VÀ SINH CẶP ĐẤU CHO BẢNG ====================
        function generateRoundRobinAlgorithm(teams) {
            const list = [...teams];
            if (list.length % 2 !== 0) {
                list.push(-1); // Đội ảo biểu thị lượt nghỉ (bye)
            }
            const n = list.length;
            const rounds = n - 1;
            const half = n / 2;
            const schedule = [];

            for (let r = 0; r < rounds; r++) {
                const roundMatches = [];
                for (let i = 0; i < half; i++) {
                    const home = list[i];
                    const away = list[n - 1 - i];
                    if (home !== -1 && away !== -1) {
                        roundMatches.push({ home: home, away: away });
                    }
                }
                schedule.push(roundMatches);
                const last = list.pop();
                list.splice(1, 0, last);
            }
            return schedule;
        }

        function generateRoundRobinAllGroups() {
            if (!modalData.bangDaus || modalData.bangDaus.length === 0) {
                SportApp.toast('warning', 'Chưa có bảng đấu nào để tạo cặp.');
                return;
            }

            let newPairs = [];
            let matchCounter = 1;
            const defaultVongId = modalData.vongDaus[0]?.id || null;

            modalData.bangDaus.forEach(bang => {
                const groupTeams = modalData.allTeams.filter(t => t.bangDauId === bang.id);
                if (groupTeams.length < 2) return;

                const teamIds = groupTeams.map(t => t.dangKyThiDauId);
                const fixtures = generateRoundRobinAlgorithm(teamIds);

                fixtures.forEach((roundFixtures, rIdx) => {
                    roundFixtures.forEach(fix => {
                        const t1 = groupTeams.find(t => t.dangKyThiDauId === fix.home);
                        const t2 = groupTeams.find(t => t.dangKyThiDauId === fix.away);
                        newPairs.push({
                            tranDauId: null,
                            soTran: matchCounter,
                            tenTran: `${bang.ten} - Vòng ${rIdx + 1}: ${t1 ? t1.tenDangKy : ''} vs ${t2 ? t2.tenDangKy : ''}`,
                            vongDauId: defaultVongId,
                            bangDauId: bang.id,
                            tenBangDau: bang.ten,
                            sanDauId: null,
                            thoiGianDuKien: null,
                            trangThai: 'ChuaDau',
                            doi1: t1 || null,
                            doi2: t2 || null
                        });
                        matchCounter++;
                    });
                });
            });

            if (newPairs.length === 0) {
                SportApp.toast('warning', 'Cần ít nhất 2 đội trong mỗi bảng đấu để tạo cặp đấu.');
                return;
            }

            // Nếu là thể thức kết hợp Vòng bảng & Knockout: Tự động sinh luôn các cặp đấu Knockout (Tứ kết, Bán kết, Chung kết)
            if (modalData.isKetHopVongBangKnockout) {
                const koPairs = generateKnockoutBracketPairs(matchCounter);
                newPairs.push(...koPairs);
            }

            modalData.pairs = newPairs;
            modalData.unpairedTeams = [];
            switchModalHybridTab('fixtures');
            const koNotice = modalData.isKetHopVongBangKnockout ? ' kèm toàn bộ sơ đồ nhánh Knockout (Tứ kết/Bán kết/Chung kết)' : '';
            SportApp.toast('success', `Đã tự động tạo ${newPairs.length} cặp đấu vòng tròn theo từng bảng${koNotice}!`);
        }

        function generateRoundRobinForGroup(bangId) {
            const bang = modalData.bangDaus.find(b => b.id === bangId);
            if (!bang) return;

            const groupTeams = modalData.allTeams.filter(t => t.bangDauId === bangId);
            if (groupTeams.length < 2) {
                SportApp.toast('warning', `Bảng ${bang.ten} cần có ít nhất 2 đội để sinh cặp đấu.`);
                return;
            }

            // Xóa các cặp cũ của riêng bảng này
            modalData.pairs = modalData.pairs.filter(p => p.bangDauId !== bangId);

            const teamIds = groupTeams.map(t => t.dangKyThiDauId);
            const fixtures = generateRoundRobinAlgorithm(teamIds);
            const defaultVongId = modalData.vongDaus[0]?.id || null;

            fixtures.forEach((roundFixtures, rIdx) => {
                roundFixtures.forEach(fix => {
                    const t1 = groupTeams.find(t => t.dangKyThiDauId === fix.home);
                    const t2 = groupTeams.find(t => t.dangKyThiDauId === fix.away);
                    const nextNum = modalData.pairs.length + 1;
                    modalData.pairs.push({
                        tranDauId: null,
                        soTran: nextNum,
                        tenTran: `${bang.ten} - Vòng ${rIdx + 1}: ${t1 ? t1.tenDangKy : ''} vs ${t2 ? t2.tenDangKy : ''}`,
                        vongDauId: defaultVongId,
                        bangDauId: bang.id,
                        tenBangDau: bang.ten,
                        sanDauId: null,
                        thoiGianDuKien: null,
                        trangThai: 'ChuaDau',
                        doi1: t1 || null,
                        doi2: t2 || null
                    });
                });
            });

            // Đánh lại số trận
            modalData.pairs.forEach((p, idx) => p.soTran = idx + 1);

            switchModalHybridTab('fixtures');
            SportApp.toast('success', `Đã tạo cặp đấu vòng tròn cho ${bang.ten}!`);
        }

        // ==================== TỰ ĐỘNG SINH CÁC CẶP ĐẤU VÒNG KNOCKOUT (TỨ KẾT, BÁN KẾT, CHUNG KẾT) ====================
        function generateKnockoutBracketPairs(startCounter) {
            const numGroups = modalData.bangDaus ? modalData.bangDaus.length : 0;
            if (numGroups === 0) return [];

            const soDoiMoiBang = modalData.soDoiMoiBangVaoVongTrong || 2;
            const koPairs = [];
            let counter = startCounter;

            const getGName = (idx) => {
                if (idx < modalData.bangDaus.length) {
                    return modalData.bangDaus[idx].ten || `Bảng ${String.fromCharCode(65 + idx)}`;
                }
                return `Bảng ${String.fromCharCode(65 + idx)}`;
            };

            const findVong = (keyword) => {
                return (modalData.vongDaus || []).find(v => (v.ten || '').toLowerCase().includes(keyword.toLowerCase()))?.id || (modalData.vongDaus && modalData.vongDaus[0]?.id) || null;
            };

            const vongTuKetId = findVong('Tứ kết');
            const vongBanKetId = findVong('Bán kết');
            const vongChungKetId = findVong('Chung kết');

            // 1. Trường hợp 4 Bảng đấu lấy Top 2 (8 đội vào Tứ kết) - Phổ biến nhất
            if (numGroups >= 4 && soDoiMoiBang >= 2) {
                const tkSpecs = [
                    { name: 'Tứ kết 1', p1: `Nhất ${getGName(0)}`, p2: `Nhì ${getGName(1)}`, bracket: 'TK1' },
                    { name: 'Tứ kết 2', p1: `Nhất ${getGName(2)}`, p2: `Nhì ${getGName(3)}`, bracket: 'TK2' },
                    { name: 'Tứ kết 3', p1: `Nhất ${getGName(1)}`, p2: `Nhì ${getGName(0)}`, bracket: 'TK3' },
                    { name: 'Tứ kết 4', p1: `Nhất ${getGName(3)}`, p2: `Nhì ${getGName(2)}`, bracket: 'TK4' }
                ];

                tkSpecs.forEach(spec => {
                    koPairs.push({
                        tranDauId: null,
                        soTran: counter++,
                        tenTran: `${spec.name}: ${spec.p1} vs ${spec.p2}`,
                        tenVongDau: 'Tứ kết',
                        vongDauId: vongTuKetId,
                        bangDauId: null,
                        tenBangDau: null,
                        sanDauId: null,
                        thoiGianDuKien: null,
                        trangThai: 'ChuaDau',
                        doi1: null,
                        doi2: null,
                        ghiChu: `TBD: ${spec.p1} vs ${spec.p2}`,
                        maTranBracket: spec.bracket
                    });
                });

                koPairs.push({
                    tranDauId: null,
                    soTran: counter++,
                    tenTran: 'Bán kết 1: Thắng Tứ kết 1 vs Thắng Tứ kết 2',
                    tenVongDau: 'Bán kết',
                    vongDauId: vongBanKetId,
                    bangDauId: null,
                    tenBangDau: null,
                    sanDauId: null,
                    thoiGianDuKien: null,
                    trangThai: 'ChuaDau',
                    doi1: null,
                    doi2: null,
                    ghiChu: 'TBD: Thắng TK 1 vs Thắng TK 2',
                    maTranBracket: 'BK1'
                });

                koPairs.push({
                    tranDauId: null,
                    soTran: counter++,
                    tenTran: 'Bán kết 2: Thắng Tứ kết 3 vs Thắng Tứ kết 4',
                    tenVongDau: 'Bán kết',
                    vongDauId: vongBanKetId,
                    bangDauId: null,
                    tenBangDau: null,
                    sanDauId: null,
                    thoiGianDuKien: null,
                    trangThai: 'ChuaDau',
                    doi1: null,
                    doi2: null,
                    ghiChu: 'TBD: Thắng TK 3 vs Thắng TK 4',
                    maTranBracket: 'BK2'
                });

                koPairs.push({
                    tranDauId: null,
                    soTran: counter++,
                    tenTran: 'Trận tranh hạng 3 - 4: Thua Bán kết 1 vs Thua Bán kết 2',
                    tenVongDau: 'Tranh 3-4',
                    vongDauId: vongChungKetId,
                    bangDauId: null,
                    tenBangDau: null,
                    sanDauId: null,
                    thoiGianDuKien: null,
                    trangThai: 'ChuaDau',
                    doi1: null,
                    doi2: null,
                    ghiChu: 'TBD: Thua BK 1 vs Thua BK 2',
                    maTranBracket: 'T34'
                });

                koPairs.push({
                    tranDauId: null,
                    soTran: counter++,
                    tenTran: 'Chung kết: Thắng Bán kết 1 vs Thắng Bán kết 2',
                    tenVongDau: 'Chung kết',
                    vongDauId: vongChungKetId,
                    bangDauId: null,
                    tenBangDau: null,
                    sanDauId: null,
                    thoiGianDuKien: null,
                    trangThai: 'ChuaDau',
                    doi1: null,
                    doi2: null,
                    ghiChu: 'TBD: Thắng BK 1 vs Thắng BK 2',
                    maTranBracket: 'CK'
                });
            }
            // 2. Trường hợp 2 Bảng đấu (Top 2) hoặc 4 Bảng đấu chỉ lấy Nhất
            else if ((numGroups === 2 && soDoiMoiBang >= 2) || (numGroups === 4 && soDoiMoiBang === 1) || numGroups === 3) {
                let bk1_p1, bk1_p2, bk2_p1, bk2_p2;
                if (numGroups === 2) {
                    bk1_p1 = `Nhất ${getGName(0)}`; bk1_p2 = `Nhì ${getGName(1)}`;
                    bk2_p1 = `Nhất ${getGName(1)}`; bk2_p2 = `Nhì ${getGName(0)}`;
                } else if (numGroups === 4) {
                    bk1_p1 = `Nhất ${getGName(0)}`; bk1_p2 = `Nhất ${getGName(1)}`;
                    bk2_p1 = `Nhất ${getGName(2)}`; bk2_p2 = `Nhất ${getGName(3)}`;
                } else {
                    bk1_p1 = `Nhất ${getGName(0)}`; bk1_p2 = 'Nhì tốt nhất';
                    bk2_p1 = `Nhất ${getGName(1)}`; bk2_p2 = `Nhất ${getGName(2)}`;
                }

                koPairs.push({
                    tranDauId: null,
