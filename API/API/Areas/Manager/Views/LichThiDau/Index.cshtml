                case 'KetHopVongBangVaLoaiTrucTiep':
                case '3':
                    badgeClass += 'bg-primary text-white';
                    badgeHtml = '<i class="fa-solid fa-diagram-project me-1"></i> Kết hợp vòng bảng & loại trực tiếp';
                    break;
                case 'VongBang':
                case '2':
                    badgeClass += 'bg-success text-white';
                    badgeHtml = '<i class="fa-solid fa-table-cells me-1"></i> Vòng tròn tính điểm (Vòng bảng)';
                    break;
                case 'NhanhThangNhanhThua':
                case '4':
                    badgeClass += 'bg-warning text-dark';
                    badgeHtml = '<i class="fa-solid fa-code-branch me-1"></i> Nhánh thắng - nhánh thua';
                    break;
                case 'HeThuySi':
                case '5':
                    badgeClass += 'text-white';
                    badgeStyle = 'background-color: #7e22ce;';
                    badgeHtml = '<i class="fa-solid fa-chess me-1"></i> Hệ Thụy Sĩ';
                    break;
                case 'TinhDiemXepHang':
                case '6':
                    badgeClass += 'bg-info text-white';
                    badgeHtml = '<i class="fa-solid fa-stopwatch me-1"></i> Đo thành tích / Tính điểm';
                    break;
                case 'LoaiTrucTiep':
                case '1':
                default:
                    badgeClass += 'bg-danger text-white';
                    badgeHtml = '<i class="fa-solid fa-trophy me-1"></i> Loại trực tiếp (Knockout)';
