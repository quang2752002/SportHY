            <!-- Dải Tab chuyển chế độ (hiển thị khi môn là Bảng kết hợp Knockout) -->
            <div id="modalHybridTabsNav" class="d-none bg-white border-bottom px-3 pt-2">
                <ul class="nav nav-pills nav-fill gap-2 pb-2" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active fw-bold py-2 shadow-2xs" id="tabBtnManualGrouping" type="button" onclick="switchModalHybridTab('grouping')">
