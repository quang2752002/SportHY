                            <div class="row g-2">
                                ${lanesHtml}
                            </div>
                        `;
                    } else {
                        matchBodyHtml = `
                            <div class="alert alert-warning py-3 text-center mb-0 border-0 shadow-2xs">
                                <i class="fa-solid fa-trophy text-warning fa-2x mb-2 d-block"></i>
                                <strong class="text-dark">Lượt Chung Kết (Chờ xếp hạt giống từ các lượt vòng loại)</strong>
                                <div class="text-muted small mt-1">Khi các lượt vòng loại hoàn tất, hệ thống tự động bốc Top 8 VĐV có thành tích tốt nhất vào 8 làn trận chung kết theo tiêu chuẩn quốc tế.</div>
                            </div>
                        `;
                    }
                } else {
                    matchBodyHtml = `
                        <div class="row g-2 align-items-center">
                            <div class="col-md-5">
                                ${slot1Html}
