                groupsHtml += '</div>';

                // Nếu có trận Knockout (Chung kết, Bán kết...)
                const koMatches = (mainViewData.pairs || []).filter(p => isMatchKnockout(p));
                if (koMatches.length > 0) {
                    const sortMatches = (a, b) => (a.soTran || 0) - (b.soTran || 0);
                    const quarterMatches = koMatches.filter(m => isMatchQuarter(m)).sort(sortMatches);
                    const semiMatches = koMatches.filter(m => isMatchSemi(m)).sort(sortMatches);
                    const bronzeMatches = koMatches.filter(m => isMatchBronze(m)).sort(sortMatches);
                    const finalMatches = koMatches.filter(m => isMatchFinal(m)).sort(sortMatches);
                    const otherKoMatches = koMatches.filter(m => !isMatchQuarter(m) && !isMatchSemi(m) && !isMatchBronze(m) && !isMatchFinal(m)).sort(sortMatches);

                    const renderKoCard = (m) => {
                        const isFinal = isMatchFinal(m);
                        const isBronze = isMatchBronze(m);
                        const isSemi = isMatchSemi(m);
                        const isQuarter = isMatchQuarter(m);

                        let headerBadgeClass = 'bg-secondary text-white';
                        let cardBorder = '';
                        let cardBg = 'bg-white';

                        if (isFinal) {
                            headerBadgeClass = 'bg-warning text-dark fw-bold';
                            cardBorder = 'border-warning';
                            cardBg = 'style="background: #fffdf5;"';
                        } else if (isBronze) {
                            headerBadgeClass = 'bg-info text-white fw-bold';
                            cardBorder = 'border-info border-opacity-50';
                            cardBg = 'style="background: #f8fafc;"';
                        } else if (isSemi) {
                            headerBadgeClass = 'bg-primary text-white fw-semibold';
                            cardBorder = 'border-primary-subtle';
                        } else if (isQuarter) {
                            headerBadgeClass = 'bg-dark text-white fw-semibold';
                        }

                        const ph = getMatchPlaceholderTeams(m);
                        const d1 = m.doi1 ? escapeHtml(m.doi1.tenDangKy || m.doi1.tenDoi || 'Đội 1') : escapeHtml(ph.t1);
                        const d2 = m.doi2 ? escapeHtml(m.doi2.tenDangKy || m.doi2.tenDoi || 'Đội 2') : escapeHtml(ph.t2);
                        const timeStr = m.thoiGianDuKien ? formatDate(m.thoiGianDuKien, true) : 'Chưa xếp giờ';
