                    }

                    // 4. Trận Tranh Hạng 3 - 4 (Huy Chương Đồng)
                    if (bronzeMatches.length > 0) {
                        koSectionsHtml += `
                            <div class="mb-4">
                                <div class="d-flex align-items-center justify-content-between mb-2 pb-1 border-bottom">
                                    <div class="d-flex align-items-center gap-2">
