                    maTranBracket: 'BK1'
                });

                koPairs.push({
                    tranDauId: null,
                    soTran: counter++,
                    tenTran: `Bán kết 2: ${bk2_p1} vs ${bk2_p2}`,
                    tenVongDau: 'Bán kết',
                    vongDauId: vongBanKetId,
                    bangDauId: null,
                    tenBangDau: null,
                    sanDauId: null,
                    thoiGianDuKien: null,
                    trangThai: 'ChuaDau',
                    doi1: null,
                    doi2: null,
                    ghiChu: `TBD: ${bk2_p1} vs ${bk2_p2}`,
                    maTranBracket: 'BK2'
                });

                koPairs.push({
                    tranDauId: null,
                    soTran: counter++,
                    tenTran: 'Trận tranh hạng 3 - 4: Thua Bán kết 1 vs Thua Bán kết 2',
                    tenVongDau: 'Tranh 3-4',
                    vongDauId: vongChungKetId,
                    bangDauId: null,
                    tenBangDau: null,
                    sanDauId: null,
                    thoiGianDuKien: null,
                    trangThai: 'ChuaDau',
                    doi1: null,
                    doi2: null,
                    ghiChu: 'TBD: Thua BK 1 vs Thua BK 2',
                    maTranBracket: 'T34'
                });

                koPairs.push({
                    tranDauId: null,
                    soTran: counter++,
                    tenTran: 'Chung kết: Thắng Bán kết 1 vs Thắng Bán kết 2',
                    tenVongDau: 'Chung kết',
                    vongDauId: vongChungKetId,
                    bangDauId: null,
                    tenBangDau: null,
                    sanDauId: null,
                    thoiGianDuKien: null,
                    trangThai: 'ChuaDau',
                    doi1: null,
                    doi2: null,
                    ghiChu: 'TBD: Thắng BK 1 vs Thắng BK 2',
                    maTranBracket: 'CK'
                });
            }
            // 3. Trường hợp 2 đội vào thẳng Chung kết
            else {
                const ck_p1 = `Nhất ${getGName(0)}`;
                const ck_p2 = numGroups >= 2 ? `Nhất ${getGName(1)}` : `Nhì ${getGName(0)}`;
                koPairs.push({
                    tranDauId: null,
                    soTran: counter++,
                    tenTran: `Chung kết: ${ck_p1} vs ${ck_p2}`,
                    tenVongDau: 'Chung kết',
                    vongDauId: vongChungKetId,
                    bangDauId: null,
                    tenBangDau: null,
                    sanDauId: null,
                    thoiGianDuKien: null,
                    trangThai: 'ChuaDau',
                    doi1: null,
                    doi2: null,
                    ghiChu: `TBD: ${ck_p1} vs ${ck_p2}`,
                    maTranBracket: 'CK'
                });
            }

            return koPairs;
        }

        function generateKnockoutOnly() {
            if (!modalData.bangDaus || modalData.bangDaus.length === 0) {
                SportApp.toast('warning', 'Cần có các bảng đấu trước khi sinh nhánh Knockout.');
                return;
            }

            // Xóa các trận Knockout cũ (các trận không thuộc bảng nào)
            modalData.pairs = modalData.pairs.filter(p => p.bangDauId && modalData.bangDaus.some(b => b.id === p.bangDauId));

            const startCounter = modalData.pairs.length + 1;
            const koPairs = generateKnockoutBracketPairs(startCounter);

            if (koPairs.length === 0) {
                SportApp.toast('warning', 'Không thể sinh nhánh Knockout cho cấu hình hiện tại.');
                return;
            }

            modalData.pairs.push(...koPairs);
            renderModalPairingUI();
            switchModalHybridTab('fixtures');
            SportApp.toast('success', `Đã tự động tạo ${koPairs.length} trận đấu vòng Knockout (Tứ kết, Bán kết, Chung kết)!`);
        }

