                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="autoDrawRemaining()" title="Tự động bốc thăm các đội còn lại">
                            <i class="fa-solid fa-dice me-1"></i> Bốc Thăm Còn Lại
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="resetAllPairs()" title="Đưa toàn bộ đội về danh sách chưa xếp">
