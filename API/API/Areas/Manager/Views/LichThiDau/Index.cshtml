                <!-- Dải nút chức năng nhanh trong modal -->
                <div class="d-flex flex-wrap align-items-center justify-content-between mt-3 pt-2 border-top gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-sm btn-outline-success" onclick="addNewPair()">
