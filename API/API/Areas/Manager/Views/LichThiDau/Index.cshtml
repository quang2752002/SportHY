                <div id="modalPairingPlaceholder" class="text-center py-5">
                    <i class="fa-solid fa-hand-pointer text-muted fa-3x mb-3"></i>
                    <h6 class="fw-semibold text-secondary">Vui lòng chọn Giải đấu và Môn thi đấu để bắt đầu xếp cặp</h6>
                    <p class="text-muted small">Hệ thống sẽ tải danh sách các đội/VĐV đã được duyệt và layout các cặp đấu để bạn kéo thả.</p>
                </div>

                <div id="modalPairingContent" class="d-none">
                    <!-- VIEW 1: CHIA BẢNG ĐẤU THỦ CÔNG (Chỉ dùng cho môn Bảng kết hợp Knockout) -->
                    <div id="modalGroupingPane" class="row g-3 d-none">
                        <!-- Cột trái: Đội chưa phân bảng -->
                        <div class="col-lg-4 col-xl-3">
                            <div class="card h-100 border shadow-sm">
                                <div class="card-header bg-light py-2 px-3 d-flex justify-content-between align-items-center">
                                    <span class="fw-bold text-dark small">
                                        <i class="fa-solid fa-users text-danger me-1"></i>Chưa Phân Bảng
                                    </span>
