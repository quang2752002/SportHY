                                    </div>
                                </div>
                            `;
                        });
                        matchBodyHtml = `
                            <div class="mb-2 d-flex align-items-center justify-content-between">
                                <span class="badge bg-primary-subtle text-primary border"><i class="fa-solid fa-flag-checkered me-1"></i>Lượt thi: ${pair.danhSachVdv.length} làn VĐV</span>
                                <small class="text-muted">Các VĐV thi đấu cùng lượt tính thời gian / thành tích</small>
