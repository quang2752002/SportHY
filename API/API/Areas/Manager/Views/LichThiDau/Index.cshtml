                        </p>
                        <div class="d-flex flex-wrap justify-content-center gap-2">
                            <button type="button" class="btn btn-primary btn-sm shadow-sm fw-bold px-3" onclick="openAutoScheduleModal()">
                                <i class="fa-solid fa-wand-magic-sparkles me-1"></i> Tự Động Xếp Lịch
                            </button>
                            <button type="button" class="btn btn-outline-primary btn-sm shadow-sm fw-bold px-3" onclick="openManualPairingModal()">
                                <i class="fa-solid fa-arrows-split-up-and-left me-1"></i> Xếp Cặp Thủ Công
                            </button>
                           
                        </div>
                    </div>
                `);
                return;
            }

            const knockoutPairs = mainViewData.pairs.filter(p => isMatchKnockout(p));
            const groupPairs = mainViewData.pairs.filter(p => !isMatchKnockout(p));

            if (knockoutPairs.length > 0 && groupPairs.length > 0) {
                // Thể thức Kết Hợp: Vòng Bảng + Knockout (giữ như cũ)
                let grHtml = `
                    <div class="card border shadow-xs mb-3">
                        <div class="card-header bg-light py-2 px-3 d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center">
                                <i class="fa-solid fa-table-cells-large text-primary me-2 fs-5"></i>
                                <div>
                                    <strong class="text-primary small">LỊCH THI ĐẤU VÒNG BẢNG (${groupPairs.length} trận)</strong>
                                    <div class="text-muted" style="font-size: 0.72rem;">Thi đấu vòng tròn tính điểm theo bảng xếp hạng bên trái</div>
                                </div>
                            </div>
                        </div>
                        <div class="card-body p-3">
                `;
                groupPairs.forEach((pair, idx) => {
                    grHtml += renderPairCardHtml(pair, idx, false);
                });
                grHtml += `</div></div>`;
                container.append(grHtml);

                // Section Knockout ở dưới
                let koHtml = `
                    <div class="card border border-warning shadow-xs mb-3" style="background: #fffdf7;">
                        <div class="card-header bg-warning bg-opacity-25 py-2 px-3 d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center">
                                <i class="fa-solid fa-trophy text-warning me-2 fs-5"></i>
                                <div>
                                    <strong class="text-dark small">VÒNG LOẠI TRỰC TIẾP (KNOCKOUT - ${knockoutPairs.length} trận)</strong>
                                    <div class="text-muted" style="font-size: 0.72rem;">Các trận Chung kết, Bán kết quyết định ngôi vị vô địch</div>
                                </div>
                            </div>
                            <button type="button" class="btn btn-2xs btn-outline-dark fw-semibold" onclick="switchView('bracket')">
                                <i class="fa-solid fa-diagram-project me-1"></i>Xem Sơ Đồ Cây
                            </button>
                        </div>
                        <div class="card-body p-3">
                `;
                knockoutPairs.forEach((pair, idx) => {
                    koHtml += renderPairCardHtml(pair, idx, true);
                });
                koHtml += `</div></div>`;
                container.append(koHtml);
            } else {
                // Thuần Knockout hoặc Thuần Vòng Bảng
                const sortedPairs = [...mainViewData.pairs].sort((a, b) => {
                    const isKoA = isMatchKnockout(a) ? 1 : 0;
                    const isKoB = isMatchKnockout(b) ? 1 : 0;
                    if (isKoA !== isKoB) return isKoA - isKoB;
                    return (a.soTran || 0) - (b.soTran || 0);
                });
                sortedPairs.forEach((pair, idx) => {
                    const isKO = isMatchKnockout(pair);
                    container.append(renderPairCardHtml(pair, idx, isKO));
                });
            }
        }

        // ==================== KHÔNG GIAN 0: CHỨC NĂNG BẢNG ĐẤU & SƠ ĐỒ CÂY LOẠI TRỰC TIẾP (KNOCKOUT) ====================
        function switchBracketSubMode(mode) {
            if (mode === 'tree') {
                $('#btnSubBracketTree').addClass('btn-primary active').removeClass('btn-outline-secondary');
                $('#btnSubBracketBranches').removeClass('btn-primary active').addClass('btn-outline-secondary');
                $('#bracketSubModeTree').removeClass('d-none');
                $('#bracketSubModeBranches').addClass('d-none');
                renderBracketTree();
            } else {
                $('#btnSubBracketBranches').addClass('btn-primary active').removeClass('btn-outline-secondary');
                $('#btnSubBracketTree').removeClass('btn-primary active').addClass('btn-outline-secondary');
                $('#bracketSubModeBranches').removeClass('d-none');
                $('#bracketSubModeTree').addClass('d-none');
                renderBracketBranches();
            }
        }

        function updateBracketSportBadge() {
