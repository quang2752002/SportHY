        function filterModalUnpairedTeams() {
            const query = ($('#modalSearchUnpairedTeam').val() || '').toLowerCase().trim();
            if (!query) {
                $('.modal-unpaired-team-item').removeClass('d-none');
                return;
            }
            $('.modal-unpaired-team-item').each(function () {
                const text = $(this).text().toLowerCase();
                if (text.includes(query)) {
                    $(this).removeClass('d-none');
                } else {
                    $(this).addClass('d-none');
                }
            });
        }

        function updatePairMatchTitle(pair, idx) {
            if (!pair) return '';
            const soTran = pair.soTran || (idx + 1);
            const d1Name = pair.doi1 ? getParticipantDisplayName(pair.doi1, true, '') : '';
            const d2Name = pair.doi2 ? getParticipantDisplayName(pair.doi2, true, '') : '';

            // Xác định tiền tố hiển thị (Bảng đấu kèm Vòng đấu nếu có)
            let prefix = '';
            if (pair.tenTran && pair.tenTran.includes(':')) {
                prefix = pair.tenTran.split(':')[0].trim();
            } else if (pair.tenBangDau) {
                prefix = pair.tenBangDau;
            } else if (pair.tenVongDau) {
                prefix = pair.tenVongDau;
            }
            if (prefix) {
                prefix = prefix.replace(/ - Trận #?\d+$/i, '').trim();
            }

            // Trường hợp 1: Cả 2 slot đội đều trống (chưa có ai)
            if (!pair.doi1 && !pair.doi2) {
                // Nếu trận có ghi chú placeholder (ví dụ "TBD: Nhất Bảng A vs Nhì Bảng B")
                if (pair.ghiChu && pair.ghiChu.startsWith('TBD: ')) {
                    const placeholder = pair.ghiChu.substring(5).trim();
                    const stageLabel = prefix || (pair.tenVongDau || `Trận #${soTran}`);
                    pair.tenTran = `${stageLabel}: ${placeholder}`;
                    return pair.tenTran;
                }
                if (prefix) {
                    pair.tenTran = `${prefix} - Trận #${soTran}`;
                } else {
                    pair.tenTran = `Trận #${soTran}`;
                }
                return pair.tenTran;
            }

            // Trường hợp 2: Có ít nhất 1 đội được xếp vào slot
            const name1 = d1Name || '(Chưa xếp)';
            const name2 = d2Name || '(Chưa xếp)';
            if (prefix) {
                pair.tenTran = `${prefix}: ${name1} vs ${name2}`;
            } else {
                pair.tenTran = `Trận #${soTran}: ${name1} vs ${name2}`;
            }
            return pair.tenTran;
        }

        function renderSingleMatchCardHtml(pair, idx) {
            const soTran = pair.soTran || (idx + 1);

            // Luôn đảm bảo tiêu đề trận đấu đồng bộ chính xác 100% với trạng thái 2 slot hiện tại
            let tenTran = updatePairMatchTitle(pair, idx) || `Trận #${soTran}`;
            const timeVal = pair.thoiGianDuKien ? pair.thoiGianDuKien.substring(0, 16) : '';

            let sanOpts = '<option value="">-- Chưa gán sân --</option>';
            modalData.sanDaus.forEach(s => {
                const sel = (pair.sanDauId && pair.sanDauId === s.id) ? 'selected' : '';
                sanOpts += `<option value="${s.id}" ${sel}>${escapeHtml(s.ten)} (${escapeHtml(s.tenCumSan || '')})</option>`;
            });

            // Render Slot 1 trong Modal
            let slot1Html = '';
            if (pair.doi1) {
                const d1Name = escapeHtml(getParticipantDisplayName(pair.doi1, true, `Đội #${pair.doi1.dangKyThiDauId}`));
                const d1Unit = pair.doi1.tenDonVi ? escapeHtml(pair.doi1.tenDonVi) : 'Tự do';
                slot1Html = `
                    <div class="slot-team-assigned"
                         draggable="true"
                         ondragstart="onTeamDragStart(event, ${pair.doi1.dangKyThiDauId}, ${idx}, 1)"
                         ondragend="onTeamDragEnd(event)">
                        <div class="overflow-hidden me-2">
                            <strong class="d-block text-truncate text-primary" style="font-size: 0.85rem;" title="${d1Name}">
                                <i class="fa-solid fa-grip-vertical text-muted me-1"></i>${d1Name}
                            </strong>
                            <small class="text-muted"><i class="fa-solid fa-shield-halved me-1"></i>${d1Unit}</small>
                        </div>
                        <button type="button" class="btn btn-sm btn-link text-danger p-0 ms-1 flex-shrink-0"
                                title="Gỡ đội về danh sách chưa xếp"
                                onclick="removeTeamFromSlot(${idx}, 1)">
                            <i class="fa-solid fa-xmark fs-6"></i>
                        </button>
                    </div>
                `;
            } else {
                slot1Html = `
                    <span class="text-muted small">
                        <i class="fa-solid fa-arrow-down me-1 text-primary"></i>Kéo & thả <strong>Đội 1</strong> vào đây
                    </span>
                `;
            }

            // Render Slot 2 trong Modal
            let slot2Html = '';
            if (pair.doi2) {
                const d2Name = escapeHtml(getParticipantDisplayName(pair.doi2, true, `Đội #${pair.doi2.dangKyThiDauId}`));
                const d2Unit = pair.doi2.tenDonVi ? escapeHtml(pair.doi2.tenDonVi) : 'Tự do';
                slot2Html = `
                    <div class="slot-team-assigned"
                         draggable="true"
                         ondragstart="onTeamDragStart(event, ${pair.doi2.dangKyThiDauId}, ${idx}, 2)"
                         ondragend="onTeamDragEnd(event)">
                        <div class="overflow-hidden me-2">
                            <strong class="d-block text-truncate text-primary" style="font-size: 0.85rem;" title="${d2Name}">
                                <i class="fa-solid fa-grip-vertical text-muted me-1"></i>${d2Name}
                            </strong>
                            <small class="text-muted"><i class="fa-solid fa-shield-halved me-1"></i>${d2Unit}</small>
                        </div>
                        <button type="button" class="btn btn-sm btn-link text-danger p-0 ms-1 flex-shrink-0"
                                title="Gỡ đội về danh sách chưa xếp"
                                onclick="removeTeamFromSlot(${idx}, 2)">
                            <i class="fa-solid fa-xmark fs-6"></i>
                        </button>
                    </div>
                `;
            } else {
                slot2Html = `
                    <span class="text-muted small">
                        <i class="fa-solid fa-arrow-down me-1 text-primary"></i>Kéo & thả <strong>Đội 2</strong> vào đây
                    </span>
                `;
            }

            const mSc1 = pair.tySoDoi1 ?? pair.diemDoi1;
            const mSc2 = pair.tySoDoi2 ?? pair.diemDoi2;
            const mHasScore = (mSc1 != null && mSc2 != null);

            return `
                <div class="match-pair-card p-3 shadow-xs">
                    <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 pb-2 border-bottom gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-dark rounded-pill">#${soTran}</span>
                            <strong class="text-dark small">${escapeHtml(tenTran)}</strong>
                            ${pair.tenBangDau ? `<span class="badge bg-info-subtle text-info border small">${escapeHtml(pair.tenBangDau)}</span>` : ''}
                        </div>
                        <div class="d-flex align-items-center gap-2 flex-grow-1 flex-md-grow-0 justify-content-end">
                            <div style="min-width: 150px;">
                                <select class="form-select form-select-sm" id="pairSan_${idx}" onchange="modalData.pairs[${idx}].sanDauId = this.value ? parseInt(this.value) : null;">
                                    ${sanOpts}
                                </select>
                            </div>
                            <div style="min-width: 160px;">
                                <input type="datetime-local" class="form-control form-control-sm" id="pairTime_${idx}" value="${timeVal}" onchange="modalData.pairs[${idx}].thoiGianDuKien = this.value || null;">
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-danger" title="Xóa cặp đấu này" onclick="deleteMatchCard(${idx})">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </div>
                    </div>

                    <div class="row g-2 align-items-center">
                        <div class="col-md-5">
                            <div class="pair-dropzone p-2 ${pair.doi1 ? 'bg-white border-primary' : ''}"
                                 data-match-index="${idx}"
                                 data-slot="1"
                                 ondragover="onSlotDragOver(event)"
                                 ondragleave="onSlotDragLeave(event)"
                                 ondrop="onSlotDrop(event, ${idx}, 1)">
                                ${slot1Html}
                            </div>
                        </div>
                        <div class="col-md-2 text-center">
                            <div class="vs-divider my-1">
                                ${mHasScore ? `
                                    <div class="vs-score-badge mb-1" style="min-width: 65px; padding: 2px 10px;">
                                        <span class="score-val ${mSc1 > mSc2 ? 'text-warning' : 'text-white'}" style="font-size: 1rem;">${mSc1}</span>
                                        <span class="score-sep" style="font-size: 0.85rem; margin: 0 4px;">-</span>
                                        <span class="score-val ${mSc2 > mSc1 ? 'text-warning' : 'text-white'}" style="font-size: 1rem;">${mSc2}</span>
                                    </div>
                                ` : `
                                    <div class="vs-circle">VS</div>
                                `}
                                <button type="button" class="btn btn-xs btn-light border p-1 rounded-circle mt-1 shadow-2xs"
                                        title="Đổi chỗ 2 đội (Swap)"
                                        onclick="swapTeams(${idx})">
                                    <i class="fa-solid fa-repeat text-secondary" style="font-size: 0.75rem;"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-5">
                            <div class="pair-dropzone p-2 ${pair.doi2 ? 'bg-white border-primary' : ''}"
                                 data-match-index="${idx}"
                                 data-slot="2"
                                 ondragover="onSlotDragOver(event)"
                                 ondragleave="onSlotDragLeave(event)"
                                 ondrop="onSlotDrop(event, ${idx}, 2)">
                                ${slot2Html}
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }

        function renderModalMatchesContainer() {
            const container = $('#modalMatchesPairContainer');
            container.empty();

            if (!modalData.pairs || modalData.pairs.length === 0) {
                container.html(`
                    <div class="text-center text-muted py-5">
                        <i class="fa-solid fa-arrows-split-up-and-left fa-3x text-muted mb-3"></i>
                        <h6>Chưa có cặp đấu nào trong layout</h6>
                        <button type="button" class="btn btn-sm btn-primary mt-2" onclick="addNewPair()">
                            <i class="fa-solid fa-plus me-1"></i> Thêm Cặp Đấu Mới
                        </button>
                    </div>
                `);
                return;
            }

            // Nếu là thể thức Bảng kết hợp Knockout -> Hiển thị các cặp đấu phân nhóm theo từng Bảng Đấu
            if (modalData.isKetHopVongBangKnockout && modalData.bangDaus && modalData.bangDaus.length > 0) {
                const colors = ['border-primary', 'border-success', 'border-warning', 'border-info', 'border-secondary'];

                modalData.bangDaus.forEach((bang, bIdx) => {
                    const borderCls = colors[bIdx % colors.length] || 'border-primary';
                    const bangTeams = modalData.allTeams.filter(t => t.bangDauId === bang.id);
                    
                    // Tìm tất cả cặp đấu thuộc bảng này
                    const bangPairIndices = [];
                    modalData.pairs.forEach((p, pIdx) => {
                        if (p.bangDauId === bang.id) {
                            bangPairIndices.push(pIdx);
                        }
                    });

                    // Dải chips tóm tắt các đội thuộc bảng
                    let teamChipsHtml = '';
                    if (bangTeams.length > 0) {
                        teamChipsHtml = bangTeams.map(t => {
                            const name = escapeHtml(getParticipantDisplayName(t, true, 'Đội'));
                            return `<span class="group-chip-tag me-1 mb-1"><i class="fa-solid fa-shield-halved text-secondary me-1"></i>${name}</span>`;
                        }).join('');
                    } else {
                        teamChipsHtml = `<span class="text-muted small fst-italic">Chưa có đội trong bảng này. Vui lòng sang tab "Chia Bảng Đấu" để gán đội.</span>`;
                    }

                    // Render các match card của bảng này
                    let matchesHtml = '';
                    if (bangPairIndices.length === 0) {
                        matchesHtml = `
                            <div class="text-center text-muted py-3 bg-light rounded border border-dashed mb-2">
                                <small>Chưa có cặp đấu nào cho ${escapeHtml(bang.ten)}.</small>
                                <div class="mt-2">
                                    <button type="button" class="btn btn-xs btn-outline-success me-1" onclick="generateRoundRobinForGroup(${bang.id})">
                                        <i class="fa-solid fa-bolt me-1"></i>Sinh Cặp Vòng Tròn
                                    </button>
                                    <button type="button" class="btn btn-xs btn-outline-primary" onclick="addNewPairForGroup(${bang.id})">
                                        <i class="fa-solid fa-plus me-1"></i>Thêm Cặp Đấu
                                    </button>
                                </div>
                            </div>
                        `;
                    } else {
                        bangPairIndices.forEach(idx => {
                            matchesHtml += renderSingleMatchCardHtml(modalData.pairs[idx], idx);
                        });
                    }

                    const sectionHtml = `
                        <div class="group-fixture-section ${borderCls}">
                            <div class="group-fixture-header">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-primary fs-6 px-2 py-1"><i class="fa-solid fa-trophy me-1 text-warning"></i>${escapeHtml(bang.ten)}</span>
                                    <span class="badge bg-light text-dark border small">${bangTeams.length} đội • ${bangPairIndices.length} trận</span>
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    <button type="button" class="btn btn-xs btn-outline-success" onclick="generateRoundRobinForGroup(${bang.id})" title="Sinh toàn bộ cặp đấu vòng tròn cho bảng này">
                                        <i class="fa-solid fa-bolt me-1"></i>Sinh Cặp Vòng Tròn
                                    </button>
                                    <button type="button" class="btn btn-xs btn-outline-primary" onclick="addNewPairForGroup(${bang.id})" title="Thêm 1 trận mới vào bảng này">
                                        <i class="fa-solid fa-plus me-1"></i>Thêm Trận
                                    </button>
                                </div>
                            </div>
                            <div class="p-2 px-3 bg-light-subtle border-bottom">
                                <div class="small fw-semibold text-muted mb-1"><i class="fa-solid fa-users me-1 text-primary"></i>Các đội trong ${escapeHtml(bang.ten)}:</div>
                                <div class="d-flex flex-wrap align-items-center">${teamChipsHtml}</div>
                            </div>
                            <div class="p-3">
                                ${matchesHtml}
                            </div>
                        </div>
                    `;
                    container.append(sectionHtml);
                });

                // Các trận đấu không thuộc bảng nào (nếu có)
                const unassignedIndices = [];
                modalData.pairs.forEach((p, pIdx) => {
                    if (!p.bangDauId || !modalData.bangDaus.some(b => b.id === p.bangDauId)) {
                        unassignedIndices.push(pIdx);
                    }
                });

                if (unassignedIndices.length > 0) {
                    let unassignedHtml = '';
                    unassignedIndices.forEach(idx => {
                        unassignedHtml += renderSingleMatchCardHtml(modalData.pairs[idx], idx);
                    });

                    const extraSection = `
                        <div class="group-fixture-section border-secondary">
                            <div class="group-fixture-header bg-secondary-subtle d-flex justify-content-between align-items-center">
                                <strong class="text-dark small"><i class="fa-solid fa-arrows-split-up-and-left text-secondary me-1"></i>Các Cặp Đấu Chung / Vòng Loại Trực Tiếp (${unassignedIndices.length} trận)</strong>
                                <div class="d-flex align-items-center gap-2">
                                    <button type="button" class="btn btn-xs btn-primary fw-semibold" onclick="generateKnockoutOnly()" title="Sinh lại sơ đồ Knockout (Tứ kết, Bán kết, Chung kết) với vị trí Nhất/Nhì bảng">
                                        <i class="fa-solid fa-sitemap me-1"></i>Sinh Lại Nhánh Knockout
                                    </button>
                                    <button type="button" class="btn btn-xs btn-outline-secondary" onclick="addNewPair()">
                                        <i class="fa-solid fa-plus me-1"></i>Thêm Trận
                                    </button>
                                </div>
                            </div>
                            <div class="p-3">
                                ${unassignedHtml}
                            </div>
                        </div>
                    `;
                    container.append(extraSection);
                } else {
                    const emptyKnockoutSection = `
                        <div class="group-fixture-section border-primary border-opacity-50">
                            <div class="group-fixture-header bg-primary-subtle d-flex justify-content-between align-items-center">
                                <strong class="text-primary small"><i class="fa-solid fa-sitemap me-1"></i>Vòng Loại Trực Tiếp (Knockout: Tứ kết, Bán kết, Chung kết)</strong>
                                <button type="button" class="btn btn-xs btn-primary fw-semibold" onclick="generateKnockoutOnly()">
                                    <i class="fa-solid fa-wand-magic-sparkles me-1"></i>Tự Động Sinh Nhánh Knockout
                                </button>
                            </div>
                            <div class="p-4 text-center bg-white">
                                <i class="fa-solid fa-sitemap fa-2x text-primary-subtle mb-2"></i>
                                <div class="fw-semibold small text-secondary">Chưa có các trận vòng Knockout trong layout</div>
                                <p class="text-muted small mb-2">Bấm nút bên dưới để tự động tạo sơ đồ Tứ kết (Nhất A vs Nhì B, v.v.), Bán kết và Chung kết.</p>
                                <button type="button" class="btn btn-sm btn-outline-primary" onclick="generateKnockoutOnly()">
                                    <i class="fa-solid fa-sitemap me-1"></i>Tạo Sơ Đồ Nhánh Knockout Ngay
                                </button>
                            </div>
                        </div>
                    `;
                    container.append(emptyKnockoutSection);
                }
            } else {
                // Thể thức loại trực tiếp hoặc danh sách phẳng thông thường
                modalData.pairs.forEach((pair, idx) => {
                    container.append(renderSingleMatchCardHtml(pair, idx));
                });
            }
        }

        function addNewPairForGroup(bangId) {
            const bang = modalData.bangDaus.find(b => b.id === bangId);
            const bangName = bang ? bang.ten : '';
            const newIdx = modalData.pairs.length + 1;
            modalData.pairs.push({
                tranDauId: null,
                soTran: newIdx,
                tenTran: bangName ? `${bangName} - Trận ${newIdx}` : `Trận ${newIdx}`,
                vongDauId: $('#modalVongDauId').val() ? parseInt($('#modalVongDauId').val()) : (modalData.vongDaus[0]?.id || null),
                bangDauId: bangId,
                tenBangDau: bangName,
                sanDauId: null,
                thoiGianDuKien: null,
                trangThai: 'ChuaDau',
                doi1: null,
                doi2: null
            });
            renderModalPairingUI();
        }

        // ==================== XỬ LÝ KÉO THẢ DRAG & DROP TRONG MODAL ====================
        function onTeamDragStart(event, teamId, fromMatchIndex, fromSlot) {
            draggedPayload = {
                teamId: parseInt(teamId),
                fromMatchIndex: parseInt(fromMatchIndex),
                fromSlot: parseInt(fromSlot)
            };
            event.dataTransfer.setData('text/plain', JSON.stringify(draggedPayload));
            event.dataTransfer.effectAllowed = 'move';
            $(event.currentTarget).addClass('dragging');
        }

        function onTeamDragEnd(event) {
            $('.team-drag-card').removeClass('dragging');
            $('.slot-team-assigned').removeClass('dragging');
            $('.pair-dropzone').removeClass('drag-hover');
            $('#modalUnpairedDropZone').removeClass('drag-hover');
        }

        function onSlotDragOver(event) {
            event.preventDefault();
            event.dataTransfer.dropEffect = 'move';
            $(event.currentTarget).addClass('drag-hover');
        }

        function onSlotDragLeave(event) {
            $(event.currentTarget).removeClass('drag-hover');
        }

        function onSlotDrop(event, targetMatchIndex, targetSlot) {
            event.preventDefault();
            $(event.currentTarget).removeClass('drag-hover');
            if (!draggedPayload) return;

            handleTeamDrop(draggedPayload, targetMatchIndex, targetSlot);
            draggedPayload = null;
        }

        function onUnpairedDragOver(event) {
            event.preventDefault();
            event.dataTransfer.dropEffect = 'move';
            $('#modalUnpairedDropZone').addClass('drag-hover');
        }

        function onUnpairedDragLeave(event) {
            $('#modalUnpairedDropZone').removeClass('drag-hover');
        }

        function onUnpairedDrop(event) {
            event.preventDefault();
            $('#modalUnpairedDropZone').removeClass('drag-hover');
            if (!draggedPayload) return;

            if (draggedPayload.fromMatchIndex >= 0) {
                removeTeamFromSlot(draggedPayload.fromMatchIndex, draggedPayload.fromSlot);
            }
            draggedPayload = null;
        }

        function handleTeamDrop(payload, targetMatchIndex, targetSlot) {
            const team = modalData.allTeams.find(t => t.dangKyThiDauId === payload.teamId);
            if (!team) return;

            const targetPair = modalData.pairs[targetMatchIndex];
            if (!targetPair) return;

            const currentOccupant = (targetSlot === 1) ? targetPair.doi1 : targetPair.doi2;

            if (payload.fromMatchIndex >= 0) {
                const sourcePair = modalData.pairs[payload.fromMatchIndex];
                if (payload.fromMatchIndex === targetMatchIndex && payload.fromSlot === targetSlot) {
                    return;
                }

                if (payload.fromMatchIndex === targetMatchIndex) {
                    swapTeams(targetMatchIndex);
                    return;
                }

                if (payload.fromSlot === 1) {
                    sourcePair.doi1 = currentOccupant;
                } else {
                    sourcePair.doi2 = currentOccupant;
                }

                if (targetSlot === 1) {
                    targetPair.doi1 = team;
                } else {
                    targetPair.doi2 = team;
                }
                updatePairMatchTitle(sourcePair, draggedPayload.fromMatchIndex);
                updatePairMatchTitle(targetPair, targetMatchIndex);
            } else {
                if (currentOccupant) {
                    if (!modalData.unpairedTeams.some(t => t.dangKyThiDauId === currentOccupant.dangKyThiDauId)) {
                        modalData.unpairedTeams.push(currentOccupant);
                    }
                }

                modalData.unpairedTeams = modalData.unpairedTeams.filter(t => t.dangKyThiDauId !== team.dangKyThiDauId);

                if (targetSlot === 1) {
                    targetPair.doi1 = team;
                } else {
                    targetPair.doi2 = team;
                }
                updatePairMatchTitle(targetPair, targetMatchIndex);
            }

            renderModalPairingUI();
        }

        function removeTeamFromSlot(matchIndex, slot) {
            const pair = modalData.pairs[matchIndex];
            if (!pair) return;

            const removedTeam = (slot === 1) ? pair.doi1 : pair.doi2;
            if (!removedTeam) return;

            if (slot === 1) pair.doi1 = null;
            else pair.doi2 = null;

            updatePairMatchTitle(pair, matchIndex);

            if (!modalData.unpairedTeams.some(t => t.dangKyThiDauId === removedTeam.dangKyThiDauId)) {
                modalData.unpairedTeams.push(removedTeam);
            }

            renderModalPairingUI();
        }

        function swapTeams(matchIndex) {
            const pair = modalData.pairs[matchIndex];
            if (!pair) return;

            const temp = pair.doi1;
            pair.doi1 = pair.doi2;
            pair.doi2 = temp;

            updatePairMatchTitle(pair, matchIndex);

            renderModalPairingUI();
        }

        function deleteMatchCard(matchIndex) {
            const pair = modalData.pairs[matchIndex];
            if (!pair) return;

            if (pair.doi1 && !modalData.unpairedTeams.some(t => t.dangKyThiDauId === pair.doi1.dangKyThiDauId)) {
                modalData.unpairedTeams.push(pair.doi1);
            }
            if (pair.doi2 && !modalData.unpairedTeams.some(t => t.dangKyThiDauId === pair.doi2.dangKyThiDauId)) {
                modalData.unpairedTeams.push(pair.doi2);
            }

            modalData.pairs.splice(matchIndex, 1);

            modalData.pairs.forEach((p, idx) => {
                p.soTran = idx + 1;
                if (!p.tenTran || p.tenTran.startsWith('Trận ')) {
                    p.tenTran = `Trận ${idx + 1}`;
                }
            });

            renderModalPairingUI();
        }

        function addNewPair() {
            const newIdx = modalData.pairs.length + 1;
            modalData.pairs.push({
                tranDauId: null,
                soTran: newIdx,
                tenTran: `Trận ${newIdx}`,
                vongDauId: $('#modalVongDauId').val() ? parseInt($('#modalVongDauId').val()) : (modalData.vongDaus[0]?.id || null),
                bangDauId: $('#modalBangDauId').val() ? parseInt($('#modalBangDauId').val()) : null,
                sanDauId: null,
                thoiGianDuKien: null,
                trangThai: 'ChuaDau',
                doi1: null,
                doi2: null
            });
            renderModalPairingUI();
        }

        function resetAllPairs() {
            Swal.fire({
                title: 'Đặt lại tất cả cặp đấu?',
                text: 'Toàn bộ các đội sẽ được đưa trở lại danh sách chưa xếp!',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Đồng ý đặt lại',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    modalData.pairs.forEach(p => {
                        p.doi1 = null;
                        p.doi2 = null;
                    });
                    modalData.unpairedTeams = [...modalData.allTeams];
                    renderModalPairingUI();
                    SportApp.toast('info', 'Đã đưa tất cả đội về danh sách chưa xếp!');
                }
            });
        }

        function autoDrawRemaining() {
            if (!modalData.unpairedTeams || modalData.unpairedTeams.length === 0) {
                SportApp.toast('info', 'Tất cả các đội đã được xếp cặp đấu!');
                return;
            }

            const shuffled = [...modalData.unpairedTeams];
            for (let i = shuffled.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
            }

            let teamIdx = 0;
            for (let p of modalData.pairs) {
                if (teamIdx >= shuffled.length) break;
                if (!p.doi1) {
                    p.doi1 = shuffled[teamIdx++];
                }
                if (teamIdx >= shuffled.length) break;
                if (!p.doi2) {
                    p.doi2 = shuffled[teamIdx++];
                }
            }

            while (teamIdx < shuffled.length) {
                const t1 = shuffled[teamIdx++];
                const t2 = (teamIdx < shuffled.length) ? shuffled[teamIdx++] : null;
                const newIdx = modalData.pairs.length + 1;
                modalData.pairs.push({
                    tranDauId: null,
                    soTran: newIdx,
                    tenTran: `Trận ${newIdx}`,
                    vongDauId: $('#modalVongDauId').val() ? parseInt($('#modalVongDauId').val()) : (modalData.vongDaus[0]?.id || null),
                    bangDauId: $('#modalBangDauId').val() ? parseInt($('#modalBangDauId').val()) : null,
                    sanDauId: null,
                    thoiGianDuKien: null,
                    trangThai: 'ChuaDau',
                    doi1: t1,
                    doi2: t2
                });
            }

            modalData.unpairedTeams = [];
            renderModalPairingUI();
            SportApp.toast('success', 'Đã bốc thăm ngẫu nhiên các đội vào cặp đấu!');
        }

        function quickAssignTeam(teamId) {
            const team = modalData.unpairedTeams.find(t => t.dangKyThiDauId === teamId);
            if (!team) return;

            let found = false;
            for (let p of modalData.pairs) {
                if (!p.doi1) {
                    p.doi1 = team;
                    found = true;
                    break;
                }
                if (!p.doi2) {
                    p.doi2 = team;
                    found = true;
                    break;
                }
            }

            if (!found) {
                const newIdx = modalData.pairs.length + 1;
                modalData.pairs.push({
                    tranDauId: null,
                    soTran: newIdx,
                    tenTran: `Trận ${newIdx}`,
                    vongDauId: $('#modalVongDauId').val() ? parseInt($('#modalVongDauId').val()) : (modalData.vongDaus[0]?.id || null),
                    bangDauId: $('#modalBangDauId').val() ? parseInt($('#modalBangDauId').val()) : null,
                    sanDauId: null,
                    thoiGianDuKien: null,
                    trangThai: 'ChuaDau',
                    doi1: team,
                    doi2: null
                });
            }

            modalData.unpairedTeams = modalData.unpairedTeams.filter(t => t.dangKyThiDauId !== teamId);
            renderModalPairingUI();
        }

        function saveManualPairings() {
            const monId = $('#modalGiaiDauMonId').val();
            if (!monId) {
                Swal.fire('Lỗi', 'Vui lòng chọn môn thi đấu.', 'warning');
                return;
            }

            if (!modalData.pairs || modalData.pairs.length === 0) {
                Swal.fire('Thông báo', 'Chưa có cặp đấu nào được tạo để lưu.', 'info');
                return;
            }

            // Sync input values from DOM in modal
            modalData.pairs.forEach((p, idx) => {
                const sanVal = $(`#pairSan_${idx}`).val();
                const timeVal = $(`#pairTime_${idx}`).val();
                p.sanDauId = sanVal ? parseInt(sanVal) : null;
                p.thoiGianDuKien = timeVal || null;
            });

            // Thu thập phân bảng đấu (teamGroups) nếu có
            const teamGroups = modalData.isKetHopVongBangKnockout
                ? modalData.allTeams.filter(t => t.bangDauId).map(t => ({
                    dangKyThiDauId: t.dangKyThiDauId,
                    bangDauId: t.bangDauId
                  }))
                : null;

            const payload = {
                giaiDauMonTheThaoId: parseInt(monId),
                vongDauId: $('#modalVongDauId').val() ? parseInt($('#modalVongDauId').val()) : null,
                bangDauId: $('#modalBangDauId').val() ? parseInt($('#modalBangDauId').val()) : null,
                teamGroups: teamGroups,
                pairs: modalData.pairs.map((p, idx) => ({
                    tranDauId: p.tranDauId,
                    soTran: p.soTran || (idx + 1),
                    tenTran: updatePairMatchTitle(p, idx) || p.tenTran || `Trận ${idx + 1}`,
                    vongDauId: p.vongDauId,
                    bangDauId: p.bangDauId,
                    sanDauId: p.sanDauId,
                    thoiGianDuKien: p.thoiGianDuKien,
                    doi1DangKyId: p.doi1 ? p.doi1.dangKyThiDauId : null,
                    doi2DangKyId: p.doi2 ? p.doi2.dangKyThiDauId : null
                }))
            };

            $('#btnSavePairs').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Đang lưu...');

            $.ajax({
                url: '/Manager/LichThiDau/SaveManualPairing',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    $('#btnSavePairs').prop('disabled', false).html('<i class="fa-solid fa-floppy-disk me-1"></i> Lưu Cặp Đấu');
                    if (res.success) {
                        $('#modalManualPairing').modal('hide');
                        Swal.fire('Thành Công!', res.message || 'Đã lưu danh sách xếp cặp thi đấu thành công!', 'success');
                        // Cập nhật lại giao diện xem ngoài trang chính
                        loadMainData();
                    } else {
                        Swal.fire('Lỗi', res.message || 'Không thể lưu xếp cặp.', 'error');
                    }
                },
                error: function (xhr) {
                    $('#btnSavePairs').prop('disabled', false).html('<i class="fa-solid fa-floppy-disk me-1"></i> Lưu Cặp Đấu');
                    Swal.fire('Lỗi', xhr.responseJSON?.message || 'Có lỗi xảy ra khi lưu xếp cặp.', 'error');
                }
            });
        }

        // ==================== KHÔNG GIAN 3: BẢNG TỔNG HỢP (TABLE VIEW) ====================
        function loadTableData(page) {
            currentTablePage = page;
            const keyword = $('#keyword').val().trim();
            const giaiDauId = $('#mainGiaiDauSelect').val();
            const danhMucId = $('#mainDanhMucSelect').val();
            const monId = $('#mainMonSelect').val();
            const date = $('#dateFilter').val();
            const status = $('#statusFilter').val();

            $.ajax({
                url: '/Manager/LichThiDau/GetPagedData',
                type: 'GET',
                data: {
                    pageIndex: page,
                    pageSize: pageSize,
                    keyword: keyword || undefined,
                    giaiDauId: giaiDauId ? parseInt(giaiDauId) : undefined,
                    danhMucMonTheThaoId: danhMucId ? parseInt(danhMucId) : undefined,
                    giaiDauMonTheThaoId: monId ? parseInt(monId) : undefined,
                    ngay: date || undefined,
                    trangThai: status || undefined
                },
                success: function (res) {
                    if (res.success && res.data) {
                        renderTable(res.data);
                    }
                }
            });
        }

        function loadData(page) {
            loadTableData(page);
        }

        function renderTable(data) {
            const items = data.items || [];
            if (items.length === 0) {
                $('#tblBody').html('<tr><td colspan="7" class="text-center py-5 text-muted">Không có trận đấu nào trong lịch thi đấu.</td></tr>');
                $('#paginationInfo').text('Hiển thị 0 trên 0 trận đấu');
                $('#paginationList').empty();
                return;
            }

            let html = '';
            const start = (data.pageIndex - 1) * data.pageSize;

            $.each(items, function (i, item) {
                const stt = start + i + 1;
                const statusBadge = getStatusBadge(item.trangThai);
                const startTime = item.thoiGianBatDau ? formatDate(item.thoiGianBatDau, true) : 'Chưa xếp giờ';
                const team1 = item.tenDoi1 || 'Đội 1';
                const team2 = item.tenDoi2 || 'Đội 2';
                const score1 = (item.tySoDoi1 !== null && item.tySoDoi1 !== undefined) ? item.tySoDoi1 : ((item.diemDoi1 !== null && item.diemDoi1 !== undefined) ? item.diemDoi1 : null);
                const score2 = (item.tySoDoi2 !== null && item.tySoDoi2 !== undefined) ? item.tySoDoi2 : ((item.diemDoi2 !== null && item.diemDoi2 !== undefined) ? item.diemDoi2 : null);

                let participantColHtml = '';
                const isItemHeat = (item.thanhPhanTranDaus && item.thanhPhanTranDaus.length > 2) || (item.tenTran && item.tenTran.includes('Heat'));
                if (isItemHeat && item.thanhPhanTranDaus && item.thanhPhanTranDaus.length > 0) {
                    const lanesList = item.thanhPhanTranDaus.map(tp => `<span class="badge bg-light text-dark border me-1 mb-1" style="font-size: 0.72rem;">Làn ${tp.soLane || tp.viTri}: <strong>${escapeHtml(tp.tenDangKy || tp.tenDoi || 'VĐV')}</strong></span>`).join('');
                    participantColHtml = `
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-primary-subtle text-primary border"><i class="fa-solid fa-flag-checkered me-1"></i>Lượt thi (${item.thanhPhanTranDaus.length} làn)</span>
                            <span class="fw-bold text-dark">${escapeHtml(item.tenTran || '')}</span>
                        </div>
                        <div class="text-muted small">
                            ${lanesList}
                        </div>
                        <small class="text-muted"><span class="badge bg-light text-secondary border">Mã: ${escapeHtml(item.ma || '')}</span> ${item.tenDanhMucMonTheThao ? `<span class="badge bg-primary-subtle text-primary border me-1">${escapeHtml(item.tenDanhMucMonTheThao)}</span>` : ''} ${escapeHtml(item.tenMonTheThao || '')}</small>
                    `;
                } else if (isItemHeat) {
                    participantColHtml = `
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-warning-subtle text-warning border"><i class="fa-solid fa-trophy me-1"></i>Lượt Chung Kết</span>
                            <span class="fw-bold text-dark">${escapeHtml(item.tenTran || '')}</span>
                        </div>
                        <small class="text-muted fst-italic">Chờ xếp Top 8 VĐV xuất sắc từ các lượt vòng loại</small>
                    `;
                } else {
                    participantColHtml = `
                        <div class="d-flex align-items-center gap-2">
                            <span class="fw-bold text-dark">${escapeHtml(team1)}</span>
                            <span class="badge bg-light text-secondary border px-2">VS</span>
                            <span class="fw-bold text-dark">${escapeHtml(team2)}</span>
                        </div>
                        <small class="text-muted"><span class="badge bg-light text-secondary border">Mã: ${escapeHtml(item.ma || '')}</span> ${item.tenDanhMucMonTheThao ? `<span class="badge bg-primary-subtle text-primary border me-1">${escapeHtml(item.tenDanhMucMonTheThao)}</span>` : ''} ${escapeHtml(item.tenMonTheThao || '')}</small>
                    `;
                }

                const scoreDisplay = isItemHeat 
                    ? `<span class="badge bg-info-subtle text-info border">Tính giờ / Xếp hạng</span>` 
                    : (score1 !== null && score2 !== null 
                        ? `<span class="fw-bold fs-6 text-dark">${score1} - ${score2}</span>` 
                        : `<span class="text-muted fw-semibold">---</span>`);

                html += `
                    <tr>
                        <td class="ps-3 fw-bold text-muted">${stt}</td>
                        <td>
                            ${participantColHtml}
                        </td>
                        <td>
                            <div class="fw-semibold text-primary"><i class="fa-regular fa-clock me-1"></i>${startTime}</div>
                            <small class="text-muted"><i class="fa-solid fa-location-dot me-1"></i>${escapeHtml(item.tenSanDau || 'Chưa xếp sân')}</small>
                        </td>
                        <td>
                            <div><span class="badge bg-info-subtle text-info border">${escapeHtml(item.tenVongDau || 'Vòng đấu')}</span></div>
                            ${item.tenBangDau ? `<small class="text-muted">Bảng: ${escapeHtml(item.tenBangDau)}</small>` : ''}
                        </td>
                        <td>
                            ${scoreDisplay}
                        </td>
                        <td>${statusBadge}</td>
                        <td class="text-end pe-3">
                            <button type="button" class="btn btn-sm btn-outline-danger" title="Xóa trận" onclick="deleteMatch(${item.id})">
                                <i class="fa-solid fa-trash me-1"></i>Xóa
                            </button>
                        </td>
                    </tr>
                `;
            });

            $('#tblBody').html(html);

            const total = data.totalCount || 0;
            const from = total === 0 ? 0 : start + 1;
            const to = Math.min(start + data.pageSize, total);
            $('#paginationInfo').text(`Hiển thị ${from} - ${to} trên tổng số ${total} trận đấu`);

            renderPagination(data.pageIndex, data.totalPages);
        }

        function getStatusBadge(status) {
            switch (status) {
                case 'ChuaDienRa':
                    return '<span class="badge bg-secondary-subtle text-secondary border badge-status">Chưa đấu</span>';
                case 'DangDienRa':
                    return '<span class="badge bg-primary-subtle text-primary border badge-status"><i class="fa-solid fa-spinner fa-spin me-1"></i>Đang đấu</span>';
                case 'KetThuc':
                    return '<span class="badge bg-success-subtle text-success border badge-status"><i class="fa-solid fa-check me-1"></i>Kết thúc</span>';
                case 'Huy':
                    return '<span class="badge bg-danger-subtle text-danger border badge-status">Đã hủy</span>';
                default:
                    return `<span class="badge bg-light text-dark border badge-status">${status}</span>`;
            }
        }

        function renderPagination(current, totalPages) {
            if (totalPages <= 1) {
                $('#paginationList').empty();
                return;
            }

            let pagHtml = '';
            pagHtml += `<li class="page-item ${current === 1 ? 'disabled' : ''}">
                <a class="page-link" href="javascript:void(0)" onclick="loadTableData(${current - 1})">&laquo;</a>
            </li>`;

            for (let i = 1; i <= totalPages; i++) {
                if (i === 1 || i === totalPages || (i >= current - 2 && i <= current + 2)) {
                    pagHtml += `<li class="page-item ${i === current ? 'active' : ''}">
                        <a class="page-link" href="javascript:void(0)" onclick="loadTableData(${i})">${i}</a>
                    </li>`;
                }
            }

            pagHtml += `<li class="page-item ${current === totalPages ? 'disabled' : ''}">
                <a class="page-link" href="javascript:void(0)" onclick="loadTableData(${current + 1})">&raquo;</a>
            </li>`;

            $('#paginationList').html(pagHtml);
        }

        function deleteMatch(id) {
            SportApp.confirm('Xóa Trận Đấu?', 'Bạn có chắc muốn xóa trận đấu này khỏi lịch trình?', function () {
                $.post('/Manager/LichThiDau/Delete', { id: id }, function (res) {
                    if (res.success) {
                        SportApp.toast('success', res.message || 'Đã xóa trận đấu!');
                        loadMainData();
                    } else {
                        Swal.fire('Lỗi', res.message || 'Không thể xóa.', 'error');
                    }
                });
            });
        }

        // ==================== CHỐT VÒNG BẢNG & TỰ ĐỘNG ĐẨY ĐỘI VÀO KNOCKOUT ====================
        function triggerAdvanceGroupStage(forceAdvance = false) {
            const monId = $('#modalGiaiDauMonId').val() || $('#mainMonSelect').val();
            if (!monId) {
                Swal.fire('Thông báo', 'Vui lòng chọn Môn thi đấu trước khi thực hiện thao tác.', 'warning');
                return;
            }

            SportApp.loading(true, 'Đang phân tích thứ hạng vòng bảng và xếp đội vào Knockout...');

            $.ajax({
                url: '/Manager/LichThiDau/AdvanceGroupStage',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    giaiDauMonTheThaoId: parseInt(monId),
                    forceAdvance: forceAdvance
                }),
                success: function (res) {
                    SportApp.loading(false);
                    if (res.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Chốt Vòng Bảng Thành Công',
                            html: `
                                <div class="text-start">
                                    <p class="mb-2"><strong>${escapeHtml(res.message || 'Đã đưa các đội vào vòng Knockout!')}</strong></p>
                                    ${res.data?.details && res.data.details.length > 0 
                                        ? `<ul class="small text-muted ps-3 mb-0">${res.data.details.map(d => `<li>${escapeHtml(d)}</li>`).join('')}</ul>` 
                                        : ''}
                                </div>
                            `
                        });
                        if ($('#modalManualPairing').hasClass('show')) {
                            loadModalPairingData();
                        }
                        loadMainData();
                    } else {
                        // Nếu chưa hoàn tất vòng bảng, hỏi người dùng có muốn ép chốt không
                        if (res.data?.pendingGroups && res.data.pendingGroups.length > 0 && !forceAdvance) {
                            const pendingHtml = res.data.pendingGroups.map(p => `<li>${escapeHtml(p)}</li>`).join('');
                            Swal.fire({
                                icon: 'warning',
                                title: 'Vòng Bảng Chưa Đấu Hết',
                                html: `
                                    <div class="text-start">
                                        <p class="mb-2">Tiến độ các bảng hiện tại:</p>
                                        <ul class="text-danger small ps-3 mb-3">${pendingHtml}</ul>
                                        <p class="mb-0 text-muted small">Bạn có muốn <strong>CHỐT NGAY</strong> dựa trên BXH điểm số tạm thời hiện tại để điền các đội vào Tứ kết không?</p>
                                    </div>
                                `,
                                showCancelButton: true,
                                confirmButtonColor: '#2563eb',
                                cancelButtonColor: '#6c757d',
                                confirmButtonText: '<i class="fa-solid fa-check me-1"></i> Chốt ngay theo BXH hiện tại',
                                cancelButtonText: 'Để sau (chờ đấu hết)'
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    triggerAdvanceGroupStage(true);
                                }
                            });
                        } else {
                            Swal.fire('Thông báo', res.message || 'Không thể chốt vòng bảng.', 'info');
                        }
                    }
                },
                error: function (xhr) {
                    SportApp.loading(false);
                    Swal.fire('Lỗi', xhr.responseJSON?.message || 'Có lỗi xảy ra khi xử lý.', 'error');
                }
            });
        }

        // ==================== TỰ ĐỘNG XẾP LỊCH & KIỂM TRA XUNG ĐỘT ====================
        let currentModalAvailableMons = [];

        function onMonSelected(giaiDauMonId) {
            if (!giaiDauMonId) {
                $('#autoCauHinhAlert').addClass('d-none');
                $('#autoTheThucSummary').addClass('d-none');
                return;
            }

            const selectedOpt = $(`#autoGiaiDauMonId option[value="${giaiDauMonId}"]`);
            const monId = selectedOpt.data('monid') || giaiDauMonId;

            // Nạp cấu hình Thể thức & Luật thi đấu của môn để hiển thị tóm tắt
            $.get('/Manager/CauHinhTheThuc/GetConfig', { monTheThaoId: parseInt(monId), giaiDauMonTheThaoId: parseInt(giaiDauMonId) }, function (res) {
                if (res && res.success && res.data) {
                    const cfg = res.data;
                    $('#autoTheThucSummary').removeClass('d-none');
                    let summaryText = `<span><i class="fa-solid fa-stopwatch text-primary me-1"></i>Thời lượng: <strong>${cfg.thoiLuongTranPhut || 60} phút</strong>/trận</span> • `
                        + `<span><i class="fa-solid fa-mug-hot text-primary me-1"></i>Nghỉ giữa 2 trận: <strong>${cfg.nghiGiuaTranPhut ?? 15} phút</strong></span>`;

                    if (cfg.loaiTheThuc === 'TinhDiemXepHang') {
                        summaryText += ` • <span><i class="fa-solid fa-person-running text-primary me-1"></i>Số làn: <strong>${cfg.soVdvMoiLuotThi || 8} làn</strong></span> • `
                            + `<span>Số vòng thi: <strong>${cfg.soVongThi || 2} vòng</strong></span>`;
                    } else if (cfg.soBang > 0) {
                        summaryText += ` • <span><i class="fa-solid fa-table-cells-large text-primary me-1"></i>Chia <strong>${cfg.soBang} bảng</strong> (${cfg.soDoiMoiBang || 4} đội/bảng, Top ${cfg.soDoiMoiBangVaoVongTrong || 2} vào Knockout)</span>`;
                    } else {
                        summaryText += ` • <span><i class="fa-solid fa-table-cells-large text-primary me-1"></i>Chia bảng: <strong>Tự động</strong> (${cfg.soDoiMoiBang || 4} đội/bảng, Top ${cfg.soDoiMoiBangVaoVongTrong || 2} vào Knockout)</span>`;
                    }
                    $('#autoTheThucDetails').html(summaryText);
                } else {
                    $('#autoTheThucSummary').addClass('d-none');
                }
            });

            $.ajax({
                url: '/api/CauHinhLichThiDau/' + monId,
                type: 'GET',
                success: function (res) {
                    if (res) {
                        $('#autoCauHinhAlert').removeClass('d-none');
                        $('#autoCauHinhTitle').html(`<i class="fa-solid fa-heart-pulse me-1 text-danger"></i> Quy tắc bảo vệ thể lực VĐV môn ${res.tenMonTheThao || ''}:`);
                        $('#autoCauHinhDesc').html(`
                            <div class="row g-2 mt-1">
                                <div class="col-6 col-md-3"><i class="fa-solid fa-calendar-day text-primary me-1"></i> Tối đa: <strong>${res.soTranToiDaMoiDoiMoiNgay} trận/ngày</strong></div>
                                <div class="col-6 col-md-3"><i class="fa-solid fa-bed text-success me-1"></i> Nghỉ hồi phục: <strong>${res.nghiToiThieuGiua2TranPhut} phút</strong></div>
                                <div class="col-6 col-md-3"><i class="fa-solid fa-hourglass-half text-warning me-1"></i> Cách vòng: <strong>${res.khoangCachGiuaCacVongGio} giờ</strong></div>
                                <div class="col-6 col-md-3"><i class="fa-solid fa-sun text-info me-1"></i> Ca trưa: <strong>Tránh 11:30 - 14:00</strong></div>
                            </div>
                        `);

                        // Đồng bộ giờ các ca nếu môn có cấu hình riêng
                        if (res.caSangBatDau) $('#autoGioBatDauCaSang').val(res.caSangBatDau.substring(0, 5));
                        if (res.caSangKetThuc) $('#autoGioKetThucCaSang').val(res.caSangKetThuc.substring(0, 5));
                        if (res.caChieuBatDau) $('#autoGioBatDauCaChieu').val(res.caChieuBatDau.substring(0, 5));
                        if (res.caChieuKetThuc) $('#autoGioKetThucCaChieu').val(res.caChieuKetThuc.substring(0, 5));
                        if (res.caToiBatDau) $('#autoGioBatDauCaToi').val(res.caToiBatDau.substring(0, 5));
                        if (res.caToiKetThuc) $('#autoGioKetThucCaToi').val(res.caToiKetThuc.substring(0, 5));
                    }
                },
                error: function () {
                    $('#autoCauHinhAlert').addClass('d-none');
                }
            });
        }

        function togglePhanBoDeu() {
            const isChecked = $('#autoPhanBoDeuXuyenSuot').is(':checked');
            if (isChecked) {
                $('#boxSoTranToiDaMoiNgay').removeClass('opacity-50');
                $('#autoSoTranToiDaMoiNgayCuaMon').prop('disabled', false);
            } else {
                $('#boxSoTranToiDaMoiNgay').addClass('opacity-50');
                $('#autoSoTranToiDaMoiNgayCuaMon').prop('disabled', true);
            }
        }

        function toggleShiftInput(shift) {
            const isChecked = $(`#autoApDungCa${shift}`).is(':checked');
            const box = $(`#boxCa${shift}`);
            $(`#autoGioBatDauCa${shift}`).prop('disabled', !isChecked);
            $(`#autoGioKetThucCa${shift}`).prop('disabled', !isChecked);
            if (isChecked) {
                box.removeClass('opacity-50 bg-light').addClass('bg-white');
            } else {
                box.removeClass('bg-white').addClass('opacity-50 bg-light');
            }
        }

        function openAutoScheduleModal() {
            const currentGiaiDau = $('#mainGiaiDauSelect').val();
            if (currentGiaiDau) {
                $('#autoGiaiDauId').val(currentGiaiDau);
                loadMonByGiaiDau(currentGiaiDau);
            }
            toggleShiftInput('Sang');
            toggleShiftInput('Chieu');
            toggleShiftInput('Toi');
            togglePhanBoDeu();
            $('#modalAutoSchedule').modal('show');
        }

        function loadMonByGiaiDau(giaiDauId) {
            if (!giaiDauId) {
                $('#autoGiaiDauMonId').html('<option value="">-- Chọn môn thể thao --</option>');
                currentModalAvailableMons = [];
                $('#autoGiaiDauTimeInfo').addClass('d-none');
                return;
            }
            $.get('/Manager/LichThiDau/GetMonByGiaiDau', { giaiDauId: parseInt(giaiDauId) }, function (res) {
                let opts = '<option value="">-- Chọn môn thể thao --</option>';
                if (res.success && res.data) {
                    currentModalAvailableMons = res.data;
                    res.data.forEach(m => {
                        opts += `<option value="${m.id}" data-hinhthuc="${m.hinhThucThiDau || ''}" data-monid="${m.monTheThaoId || m.id}">${escapeHtml(m.ten)}</option>`;
                    });

                    if (res.ngayBatDau) {
                        $('#autoNgayBatDau').val(res.ngayBatDau);
                        $('#autoNgayBatDau').attr('min', res.ngayBatDau);
                    }
                    if (res.ngayKetThuc) {
                        $('#autoNgayKetThuc').val(res.ngayKetThuc);
                        $('#autoNgayKetThuc').attr('max', res.ngayKetThuc);
                    }
                    if (res.ngayBatDau && res.ngayKetThuc) {
                        $('#autoGiaiDauRangeText').text(`Từ ${res.ngayBatDau} đến ${res.ngayKetThuc}${res.tenGiaiDau ? ' (' + res.tenGiaiDau + ')' : ''}`);
                        $('#autoGiaiDauTimeInfo').removeClass('d-none');
                    }
                }
                $('#autoGiaiDauMonId').html(opts);
                const currentMon = $('#mainMonSelect').val();
                if (currentMon) {
                    $('#autoGiaiDauMonId').val(currentMon);
                    onMonSelected(currentMon);
                }
            });
        }

        function runAutoSchedule() {
            const giaiDauId = $('#autoGiaiDauId').val();
            const monId = $('#autoGiaiDauMonId').val();

            if (!giaiDauId || !monId) {
                Swal.fire('Lỗi', 'Vui lòng chọn giải đấu và môn thể thao.', 'warning');
                return;
            }

            const apDungCaSang = $('#autoApDungCaSang').is(':checked');
            const apDungCaChieu = $('#autoApDungCaChieu').is(':checked');
            const apDungCaToi = $('#autoApDungCaToi').is(':checked');

            if (!apDungCaSang && !apDungCaChieu && !apDungCaToi) {
                Swal.fire('Chú ý', 'Vui lòng chọn ít nhất một ca thi đấu (Ca sáng, Ca chiều hoặc Ca tối) để xếp lịch.', 'warning');
                return;
            }

            const selectedSanIds = $('#autoSanDauIds').val() || [];
            const sanIds = selectedSanIds.map(x => parseInt(x));

            const gioBatDauSang = $('#autoGioBatDauCaSang').val() || "08:00";
            const gioKetThucSang = $('#autoGioKetThucCaSang').val() || "11:30";
            const gioBatDauChieu = $('#autoGioBatDauCaChieu').val() || "14:00";
            const gioKetThucChieu = $('#autoGioKetThucCaChieu').val() || "17:30";
            const gioBatDauToi = $('#autoGioBatDauCaToi').val() || "18:30";
            const gioKetThucToi = $('#autoGioKetThucCaToi').val() || "21:30";

            const request = {
                giaiDauMonTheThaoId: parseInt(monId),
                ngayBatDau: $('#autoNgayBatDau').val(),
                ngayKetThuc: $('#autoNgayKetThuc').val() || null,
                phanBoDeuXuyenSuot: $('#autoPhanBoDeuXuyenSuot').is(':checked'),
                soTranToiDaMoiNgayCuaMon: $('#autoSoTranToiDaMoiNgayCuaMon').val() ? parseInt($('#autoSoTranToiDaMoiNgayCuaMon').val()) : null,
                apDungCaSang: apDungCaSang,
                gioBatDauCaSang: gioBatDauSang,
                gioKetThucCaSang: gioKetThucSang,
                apDungCaChieu: apDungCaChieu,
                gioBatDauCaChieu: gioBatDauChieu,
                gioKetThucCaChieu: gioKetThucChieu,
                apDungCaToi: apDungCaToi,
                gioBatDauCaToi: gioBatDauToi,
                gioKetThucCaToi: gioKetThucToi,
                gioBatDauMoiNgay: apDungCaSang ? gioBatDauSang : (apDungCaChieu ? gioBatDauChieu : gioBatDauToi),
                gioKetThucMoiNgay: apDungCaToi ? gioKetThucToi : (apDungCaChieu ? gioKetThucChieu : gioKetThucSang),
                sanDauIds: sanIds,
                xoaLichCu: $('#autoXoaLichCu').is(':checked'),
                tranhTrungLichVdv: $('#autoTranhTrungVdv').is(':checked')
            };

            $('#btnRunSchedule').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Đang tính toán & xếp lịch...');

            $.ajax({
                url: '/Manager/LichThiDau/AutoSchedule',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(request),
                success: function (res) {
                    $('#btnRunSchedule').prop('disabled', false).html('<i class="fa-solid fa-play me-1"></i> Bắt Đầu Xếp Lịch Tự Động');
                    if (res.success) {
                        $('#modalAutoSchedule').modal('hide');
                        Swal.fire('Thành Công!', res.message || 'Thuật toán đã xếp lịch thi đấu thành công!', 'success');
                        loadMainData();
                    } else {
                        Swal.fire('Không thành công', res.message || 'Không thể xếp lịch.', 'error');
                    }
                },
                error: function (xhr) {
                    $('#btnRunSchedule').prop('disabled', false).html('<i class="fa-solid fa-play me-1"></i> Bắt Đầu Xếp Lịch Tự Động');
                    Swal.fire('Lỗi', xhr.responseJSON?.message || 'Có lỗi xảy ra trong quá trình tính toán xếp lịch.', 'error');
                }
            });
        }

        function openConflictModal() {
            const giaiDauId = $('#mainGiaiDauSelect').val();
            if (!giaiDauId) {
                Swal.fire('Thông báo', 'Vui lòng chọn một giải đấu ở bộ lọc trước khi kiểm tra xung đột.', 'info');
                return;
            }

            Swal.fire({
                title: 'Đang kiểm tra xung đột...',
                text: 'Hệ thống đang quét toàn bộ lịch sân bãi và trùng lặp VĐV',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            $.get('/Manager/LichThiDau/CheckConflicts', { giaiDauId: parseInt(giaiDauId) }, function (res) {
                Swal.close();
                if (res.success && res.data) {
                    const report = res.data;
                    const totalConflicts = report.totalConflicts || 0;
                    if (totalConflicts === 0) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Lịch Thi Đấu Hoàn Hảo!',
                            text: 'Không phát hiện bất kỳ xung đột nào về giờ thi đấu, trùng sân hoặc trùng lặp Vận động viên.'
                        });
                    } else {
                        Swal.fire({
                            icon: 'warning',
                            title: `Phát Hiện ${totalConflicts} Xung Đột!`,
                            text: 'Có các trận đấu đang bị trùng sân hoặc VĐV thi đấu cùng lúc. Vui lòng kiểm tra lại khung giờ xếp lịch.'
                        });
                    }
                }
            });
        }

        function resetFilter() {
            $('#keyword').val('');
            $('#dateFilter').val('');
            $('#statusFilter').val('');
            $('#mainDanhMucSelect').val('');
            renderMainMonSelect();
            loadTableData(1);
        }

        function formatDate(str, withTime = false) {
            if (!str) return '-';
            const d = new Date(str);
            if (isNaN(d.getTime())) return str;
            const day = String(d.getDate()).padStart(2, '0');
            const month = String(d.getMonth() + 1).padStart(2, '0');
            const year = d.getFullYear();
            if (withTime) {
                const h = String(d.getHours()).padStart(2, '0');
                const m = String(d.getMinutes()).padStart(2, '0');
                return `${day}/${month}/${year} ${h}:${m}`;
            }
            return `${day}/${month}/${year}`;
        }

        function escapeHtml(text) {
            if (!text) return '';
            return $('<div>').text(text).html();
        }
    </script>
}
