        function isMatchFinal(pair) {
            if (!pair) return false;
            const m = (pair.maTranBracket || '').toUpperCase().trim();
            if (m === 'CK' || m === 'FINAL') return true;

            const v = (pair.tenVongDau || '').toLowerCase().trim();
            if (v === 'chung kết' || (v.includes('chung kết') && !v.includes('bán') && !v.includes('tứ'))) return true;

            const t = (pair.tenTran || '').toLowerCase().trim();
            if (t.startsWith('chung kết')) return true;
            if (t.includes('chung kết') && !t.startsWith('bán kết') && !t.startsWith('tứ kết') && !t.includes('tranh hạng') && !t.includes('hạng 3')) return true;

            return false;
        }

        function isMatchBronze(pair) {
            if (!pair) return false;
            const m = (pair.maTranBracket || '').toUpperCase().trim();
            if (m === 'T34' || m === '3RD' || m === 'TRANH3') return true;

            const v = (pair.tenVongDau || '').toLowerCase().trim();
            if (v.includes('hạng 3') || v.includes('tranh hạng') || v.includes('hạng ba')) return true;

            const t = (pair.tenTran || '').toLowerCase().trim();
            if (t.startsWith('tranh hạng') || t.startsWith('trận tranh hạng') || t.startsWith('hạng 3') || t.includes('hạng 3 - 4') || t.includes('tranh hạng 3')) return true;

            return false;
        }

        function isMatchSemi(pair) {
            if (!pair) return false;
            if (isMatchFinal(pair) || isMatchBronze(pair)) return false;

            const m = (pair.maTranBracket || '').toUpperCase().trim();
            if (m.startsWith('BK') || m.startsWith('SF')) return true;

            const v = (pair.tenVongDau || '').toLowerCase().trim();
            if (v.includes('bán kết') || (v.includes('bán') && !v.includes('tứ') && !v.includes('chung'))) return true;

            const t = (pair.tenTran || '').toLowerCase().trim();
            if (t.startsWith('bán kết')) return true;
            if (t.includes('bán kết') && !t.includes('thắng bán kết') && !t.includes('thua bán kết')) return true;

            return false;
        }

        function isMatchQuarter(pair) {
            if (!pair) return false;
            if (isMatchFinal(pair) || isMatchBronze(pair) || isMatchSemi(pair)) return false;

            const m = (pair.maTranBracket || '').toUpperCase().trim();
            if (m.startsWith('TK') || m.startsWith('QF')) return true;

            const v = (pair.tenVongDau || '').toLowerCase().trim();
            if (v.includes('tứ kết') || (v.includes('tứ') && !v.includes('bán') && !v.includes('chung'))) return true;

            const t = (pair.tenTran || '').toLowerCase().trim();
            if (t.startsWith('tứ kết')) return true;
            if (t.includes('tứ kết') && !t.includes('thắng tứ kết') && !t.includes('thua tứ kết')) return true;

            return false;
        }

        function isMatchKnockout(pair) {
            if (!pair) return false;
            if (isMatchFinal(pair) || isMatchBronze(pair) || isMatchSemi(pair) || isMatchQuarter(pair)) return true;
            const m = (pair.maTranBracket || '').toUpperCase().trim();
            if (m.startsWith('CK') || m.startsWith('BK') || m.startsWith('TK') || m.startsWith('T34') || m.startsWith('V18') || m.startsWith('V32') || m.startsWith('R16') || m.startsWith('R32')) return true;
            const v = (pair.tenVongDau || '').toLowerCase().trim();
            if (v.includes('chung kết') || v.includes('bán kết') || v.includes('tứ kết') || v.includes('tranh hạng') || v.includes('hạng 3') || v.includes('1/8') || v.includes('1/16') || v.includes('loại trực tiếp') || v.includes('knockout')) return true;
            const t = (pair.tenTran || '').toLowerCase().trim();
            if (t.includes('chung kết') || t.includes('bán kết') || t.includes('tứ kết') || t.includes('tranh hạng') || t.includes('hạng 3') || t.includes('1/8') || t.includes('1/16')) return true;
            if (!pair.bangDauId && (t.includes('nhất') || t.includes('nhì') || t.includes('thắng') || t.includes('thua'))) return true;
            return false;
        }

        function getMatchPlaceholderTeams(pair) {
            let t1 = 'Chờ xác định đội 1';
            let t2 = 'Chờ xác định đội 2';
            if (!pair) return { t1, t2 };

            if (pair.tenDoi1Placeholder) t1 = pair.tenDoi1Placeholder;
            if (pair.tenDoi2Placeholder) t2 = pair.tenDoi2Placeholder;

            if (pair.ghiChu && pair.ghiChu.toLowerCase().startsWith('tbd:')) {
                const parts = pair.ghiChu.substring(4).split(' vs ');
                if (parts.length === 2) {
                    t1 = parts[0].trim();
                    t2 = parts[1].trim();
                }
            } else if (pair.tenTran && pair.tenTran.includes(':') && pair.tenTran.includes(' vs ')) {
                const afterColon = pair.tenTran.split(':')[1];
                if (afterColon) {
                    const parts = afterColon.split(' vs ');
                    if (parts.length === 2 && !pair.doi1 && !pair.doi2) {
                        t1 = parts[0].trim();
                        t2 = parts[1].trim();
                    }
                }
            }
            return { t1, t2 };
        }

        function getRoundOrderAndLabel(pair) {
            if (isMatchFinal(pair) || isMatchBronze(pair)) {
                return { order: 90, label: 'Chung Kết & Tranh Hạng Ba', isFinalCol: true };
            }
            if (isMatchSemi(pair)) {
                return { order: 80, label: 'Bán Kết', isFinalCol: false };
            }
            if (isMatchQuarter(pair)) {
                return { order: 70, label: 'Tứ Kết', isFinalCol: false };
            }

            const t = (pair.tenTran || '').toLowerCase().trim();
            const v = (pair.tenVongDau || '').toLowerCase().trim();
            const m = (pair.maTranBracket || '').toUpperCase().trim();

            if (m.startsWith('V18') || m.startsWith('R16') || v.includes('1/8') || t.includes('1/8')) {
                return { order: 60, label: 'Vòng 1/8 (Vòng 16)', isFinalCol: false };
            }
            if (m.startsWith('V32') || m.startsWith('R32') || v.includes('1/16') || t.includes('1/16')) {
                return { order: 50, label: 'Vòng 1/16 (Vòng 32)', isFinalCol: false };
            }
            const thuTu = pair.vongThuTu || 1;
            return { order: thuTu * 10, label: pair.tenVongDau || `Vòng ${thuTu}`, isFinalCol: false };
        }

        function renderBracketTree() {
            const container = $('#bracketRoundsRow');
            container.empty();

            if (!mainViewData.pairs || mainViewData.pairs.length === 0) return;

            const isHybrid = (mainViewData.hinhThucThiDau === 'KetHopVongBangVaLoaiTrucTiep' || mainViewData.hinhThucThiDau == 3);
            const hasKnockout = mainViewData.pairs.some(p => isMatchKnockout(p));
            const hasGroup = mainViewData.pairs.some(p => !isMatchKnockout(p));

            let pairsToRender = mainViewData.pairs;
            // Nếu là thể thức kết hợp hoặc có cả trận vòng bảng và knockout: chỉ vẽ các trận Knockout trong cây nhánh
            if (isHybrid || (hasKnockout && hasGroup)) {
                pairsToRender = mainViewData.pairs.filter(p => isMatchKnockout(p));
            }

            if (pairsToRender.length === 0) {
                container.html(`
                    <div class="col-12 text-center text-muted py-5">
                        <i class="fa-solid fa-circle-info fa-3x mb-3 text-secondary"></i>
                        <h6>Thể thức thi đấu vòng tròn tính điểm (Round Robin)</h6>
                        <p class="small">Môn này thi đấu vòng bảng tính điểm, không có các vòng loại trực tiếp. Vui lòng xem bảng xếp hạng và lịch thi đấu ở chế độ <strong>Lịch Thi Đấu</strong> hoặc xem tab <strong>Bảng Đấu & Hạt Giống</strong>.</p>
                    </div>
                `);
                return;
            }

            // Nhóm trận đấu theo vòng
            const roundMap = new Map();
            pairsToRender.forEach(p => {
                const info = getRoundOrderAndLabel(p);
                const key = info.label;
                if (!roundMap.has(key)) {
                    roundMap.set(key, {
                        order: info.order,
                        label: info.label,
                        isFinalCol: info.isFinalCol,
                        matches: []
                    });
                }
                roundMap.get(key).matches.push(p);
            });

            // Sắp xếp các vòng theo thứ tự tiến vào chung kết
            const sortedRounds = Array.from(roundMap.values()).sort((a, b) => a.order - b.order);

            sortedRounds.forEach(round => {
                // Sắp xếp trận trong vòng theo số trận
                round.matches.sort((a, b) => (a.soTran || 0) - (b.soTran || 0));

                let matchesHtml = '';
                round.matches.forEach(pair => {
                    const soTran = pair.soTran || '';
                    const tenTran = pair.tenTran || `Trận ${soTran}`;
                    const timeStr = pair.thoiGianDuKien ? formatDate(pair.thoiGianDuKien, true) : 'Chưa xếp giờ';
                    const sanObj = mainViewData.sanDaus.find(s => s.id === pair.sanDauId);
                    const tenSan = sanObj ? escapeHtml(sanObj.ten) : 'Chưa gán sân';

                    const sc1 = pair.tySoDoi1 ?? pair.diemDoi1;
                    const sc2 = pair.tySoDoi2 ?? pair.diemDoi2;
                    const isFinished = pair.trangThai === 'KetThuc' || (sc1 != null && sc2 != null);
                    let isDoi1Winner = false;
                    let isDoi2Winner = false;

                    if (pair.doiThangDangKyId) {
                        isDoi1Winner = pair.doi1 && pair.doi1.dangKyThiDauId === pair.doiThangDangKyId;
                        isDoi2Winner = pair.doi2 && pair.doi2.dangKyThiDauId === pair.doiThangDangKyId;
                    } else if (isFinished && sc1 != null && sc2 != null) {
                        if (sc1 > sc2) isDoi1Winner = true;
                        else if (sc2 > sc1) isDoi2Winner = true;
                        else if (pair.diemPenaltyDoi1 != null && pair.diemPenaltyDoi2 != null) {
                            if (pair.diemPenaltyDoi1 > pair.diemPenaltyDoi2) isDoi1Winner = true;
                            else if (pair.diemPenaltyDoi2 > pair.diemPenaltyDoi1) isDoi2Winner = true;
                        }
                    }

                    // Tùy biến kiểu Card
                    const isFinalMatch = isMatchFinal(pair);
                    const isBronzeMatch = isMatchBronze(pair);
                    let extraCardClass = isFinalMatch ? 'card-final' : (isBronzeMatch ? 'card-bronze' : '');

                    // Điểm số & Penalty
                    const score1Badge = sc1 != null
                        ? `<span class="badge bg-light text-dark border px-2 py-1 badge-score fw-bold fs-6">${sc1}${pair.diemPenaltyDoi1 != null ? `<span class="small fw-normal text-warning ms-1">(${pair.diemPenaltyDoi1})</span>` : ''}</span>`
                        : `<span class="text-muted fw-normal fs-6">-</span>`;

                    const score2Badge = sc2 != null
                        ? `<span class="badge bg-light text-dark border px-2 py-1 badge-score fw-bold fs-6">${sc2}${pair.diemPenaltyDoi2 != null ? `<span class="small fw-normal text-warning ms-1">(${pair.diemPenaltyDoi2})</span>` : ''}</span>`
                        : `<span class="text-muted fw-normal fs-6">-</span>`;

                    // Đội 1
                    let team1Html = '';
                    if (pair.doi1) {
                        const d1Name = escapeHtml(getParticipantDisplayName(pair.doi1, false, 'Đội 1'));
                        const d1Unit = pair.doi1.tenDonVi ? escapeHtml(pair.doi1.tenDonVi) : 'Tự do';
                        const winIcon = isDoi1Winner ? '<i class="fa-solid fa-crown text-warning me-1" title="Thắng trận"></i>' : '';
                        team1Html = `
                            <div class="bracket-slot-row ${isDoi1Winner ? 'is-winner' : ''}">
                                <div class="d-flex align-items-center gap-2 overflow-hidden flex-grow-1 me-2">
                                    <span class="badge bg-secondary-subtle text-secondary rounded-circle px-2 py-1 flex-shrink-0" style="font-size: 0.72rem;">1</span>
                                    <div class="overflow-hidden">
                                        <div class="text-truncate fw-semibold" style="font-size: 0.83rem;" title="${d1Name}">${winIcon}${d1Name}</div>
                                        <small class="text-muted text-truncate d-block" style="font-size: 0.72rem;"><i class="fa-solid fa-shield-halved me-1 text-secondary"></i>${d1Unit}</small>
                                    </div>
                                </div>
                                <div class="flex-shrink-0">${score1Badge}</div>
                            </div>
                        `;
                    } else {
                        const ph = getMatchPlaceholderTeams(pair);
                        team1Html = `
                            <div class="bracket-slot-row text-muted fst-italic" style="background: #fffdf5;">
                                <div class="d-flex align-items-center gap-2 overflow-hidden flex-grow-1 me-2">
                                    <span class="badge bg-warning-subtle text-warning rounded-circle px-2 py-1 flex-shrink-0" style="font-size: 0.72rem;"><i class="fa-solid fa-clock"></i></span>
                                    <span style="font-size: 0.82rem;" class="text-warning-emphasis fw-semibold text-truncate" title="${escapeHtml(ph.t1)}">${escapeHtml(ph.t1)}</span>
                                </div>
                                <span class="text-muted fs-6">-</span>
                            </div>
                        `;
                    }

                    // Đội 2
                    let team2Html = '';
                    if (pair.doi2) {
                        const d2Name = escapeHtml(getParticipantDisplayName(pair.doi2, false, 'Đội 2'));
                        const d2Unit = pair.doi2.tenDonVi ? escapeHtml(pair.doi2.tenDonVi) : 'Tự do';
                        const winIcon = isDoi2Winner ? '<i class="fa-solid fa-crown text-warning me-1" title="Thắng trận"></i>' : '';
                        team2Html = `
                            <div class="bracket-slot-row ${isDoi2Winner ? 'is-winner' : ''}">
                                <div class="d-flex align-items-center gap-2 overflow-hidden flex-grow-1 me-2">
                                    <span class="badge bg-secondary-subtle text-secondary rounded-circle px-2 py-1 flex-shrink-0" style="font-size: 0.72rem;">2</span>
                                    <div class="overflow-hidden">
                                        <div class="text-truncate fw-semibold" style="font-size: 0.83rem;" title="${d2Name}">${winIcon}${d2Name}</div>
                                        <small class="text-muted text-truncate d-block" style="font-size: 0.72rem;"><i class="fa-solid fa-shield-halved me-1 text-secondary"></i>${d2Unit}</small>
                                    </div>
                                </div>
                                <div class="flex-shrink-0">${score2Badge}</div>
                            </div>
                        `;
                    } else {
                        const ph = getMatchPlaceholderTeams(pair);
                        team2Html = `
                            <div class="bracket-slot-row text-muted fst-italic" style="background: #fffdf5;">
                                <div class="d-flex align-items-center gap-2 overflow-hidden flex-grow-1 me-2">
                                    <span class="badge bg-warning-subtle text-warning rounded-circle px-2 py-1 flex-shrink-0" style="font-size: 0.72rem;"><i class="fa-solid fa-clock"></i></span>
                                    <span style="font-size: 0.82rem;" class="text-warning-emphasis fw-semibold text-truncate" title="${escapeHtml(ph.t2)}">${escapeHtml(ph.t2)}</span>
                                </div>
                                <span class="text-muted fs-6">-</span>
                            </div>
                        `;
                    }

                    // Badge trạng thái
                    let statusBadge = '';
                    if (pair.trangThai === 'KetThuc') {
                        statusBadge = '<span class="badge bg-success-subtle text-success border border-success-subtle py-1" style="font-size: 0.72rem;">Đã kết thúc</span>';
                    } else if (pair.trangThai === 'DangDienRa') {
                        statusBadge = '<span class="badge bg-danger-subtle text-danger border border-danger-subtle py-1 animate-pulse" style="font-size: 0.72rem;">Đang diễn ra</span>';
                    } else {
                        statusBadge = '<span class="badge bg-light text-secondary border py-1" style="font-size: 0.72rem;">Chưa diễn ra</span>';
                    }

                    // Nhãn tiến trình
                    let progressLabel = '';
                    if (isFinalMatch) {
                        progressLabel = '<span class="text-warning fw-bold small"><i class="fa-solid fa-trophy me-1"></i>Tranh Cúp Vô Địch (HCV/HCB)</span>';
                    } else if (isBronzeMatch) {
                        progressLabel = '<span class="text-secondary fw-semibold small"><i class="fa-solid fa-medal me-1 text-warning"></i>Tranh Huy Chương Đồng</span>';
                    } else if (pair.nextTranDauId) {
                        const nextM = mainViewData.pairs.find(p => p.tranDauId === pair.nextTranDauId);
                        const nextName = nextM ? (nextM.tenTran || `Trận #${nextM.soTran}`) : `Trận kế tiếp`;
                        progressLabel = `<small class="text-muted"><i class="fa-solid fa-arrow-right text-primary me-1"></i>Thắng vào: <strong>${escapeHtml(nextName)}</strong></small>`;
                    }

                    const scoreBtnHtml = '';

                    matchesHtml += `
                        <div class="bracket-match-node ${extraCardClass}">
                            <div class="px-3 py-2 bg-light d-flex justify-content-between align-items-center border-bottom">
                                <div class="d-flex align-items-center gap-2 overflow-hidden">
                                    <span class="badge bg-dark rounded-pill" style="font-size: 0.75rem;">#${soTran}</span>
                                    <strong class="text-dark small text-truncate" title="${escapeHtml(tenTran)}">${escapeHtml(tenTran)}</strong>
                                </div>
                                <div class="d-flex align-items-center gap-1 flex-shrink-0">
                                    ${scoreBtnHtml}
                                </div>
                            </div>
                            <div class="px-3 py-1 bg-white border-bottom d-flex justify-content-between align-items-center gap-2 text-muted" style="font-size: 0.72rem;">
                                <span class="text-truncate"><i class="fa-solid fa-location-dot text-danger me-1"></i>${tenSan}</span>
                                <span class="flex-shrink-0"><i class="fa-regular fa-clock text-primary me-1"></i>${timeStr}</span>
                            </div>
                            ${team1Html}
                            ${team2Html}
                            <div class="px-3 py-1 bg-light border-top d-flex justify-content-between align-items-center gap-1">
                                <div>${progressLabel}</div>
                                <div>${statusBadge}</div>
                            </div>
                        </div>
                    `;
                });

                const headerIcon = round.isFinalCol ? '<i class="fa-solid fa-crown me-2"></i>' : '<i class="fa-solid fa-shield-halved me-2"></i>';
                const colHtml = `
                    <div class="bracket-round-col">
                        <div class="bracket-round-header ${round.isFinalCol ? 'final-header' : ''}">
                            ${headerIcon}${escapeHtml(round.label)} (${round.matches.length} trận)
                        </div>
                        <div class="bracket-matches-list">
                            ${matchesHtml}
                        </div>
                    </div>
                `;
                container.append(colHtml);
            });
        }

        function renderBracketBranches() {
            const container = $('#bracketBranchesRow');
            container.empty();

            if (!mainViewData.pairs || mainViewData.pairs.length === 0) return;

            // Phân loại các trận đấu vào Bảng A (Nhánh trên), Bảng B (Nhánh dưới), và Vòng Quyết Định (Finals)
            // Nhận diện vòng đầu tiên (thường là Tứ kết hoặc Vòng 1/8 hoặc Vòng loại)
            const openingMatches = mainViewData.pairs.filter(p => {
                return !isMatchFinal(p) && !isMatchBronze(p) && !isMatchSemi(p);
            }).sort((a, b) => (a.soTran || 0) - (b.soTran || 0));

            let matchesHalf = Math.ceil(openingMatches.length / 2);
            let branchAMatches = [];
            let branchBMatches = [];

            if (openingMatches.length > 0) {
                branchAMatches = openingMatches.slice(0, matchesHalf);
                branchBMatches = openingMatches.slice(matchesHalf);
            }

            // Thêm các trận Bán kết tương ứng
            const semiMatches = mainViewData.pairs.filter(p => isMatchSemi(p)).sort((a, b) => (a.soTran || 0) - (b.soTran || 0));

            if (semiMatches.length >= 1) branchAMatches.push(semiMatches[0]);
            if (semiMatches.length >= 2) branchBMatches.push(semiMatches[1]);

            // Trận Chung kết và Hạng 3
            const finalMatches = mainViewData.pairs.filter(p => isMatchFinal(p) || isMatchBronze(p)).sort((a, b) => (a.soTran || 0) - (b.soTran || 0));

            // Lấy danh sách đội hạt giống cho Bảng A
            const teamsA = [];
            branchAMatches.forEach(m => {
                if (m.doi1 && !teamsA.some(x => x.dangKyThiDauId === m.doi1.dangKyThiDauId)) {
                    teamsA.push({ team: m.doi1, seed: `A${teamsA.length + 1}`, match: m });
                }
                if (m.doi2 && !teamsA.some(x => x.dangKyThiDauId === m.doi2.dangKyThiDauId)) {
                    teamsA.push({ team: m.doi2, seed: `A${teamsA.length + 1}`, match: m });
                }
            });

            // Lấy danh sách đội hạt giống cho Bảng B
            const teamsB = [];
            branchBMatches.forEach(m => {
                if (m.doi1 && !teamsB.some(x => x.dangKyThiDauId === m.doi1.dangKyThiDauId)) {
                    teamsB.push({ team: m.doi1, seed: `B${teamsB.length + 1}`, match: m });
                }
                if (m.doi2 && !teamsB.some(x => x.dangKyThiDauId === m.doi2.dangKyThiDauId)) {
                    teamsB.push({ team: m.doi2, seed: `B${teamsB.length + 1}`, match: m });
                }
            });

            function buildBranchTableHtml(teams, branchLetter, badgeColor) {
                if (teams.length === 0) {
                    return '<div class="text-muted text-center py-3 fst-italic small">Chưa xếp đội vào nhánh này</div>';
                }
                let rows = '';
                teams.forEach(item => {
                    const t = item.team;
                    const name = escapeHtml(t.tenDangKy || t.tenDoi || `Đội #${t.dangKyThiDauId}`);
                    const unit = t.tenDonVi ? escapeHtml(t.tenDonVi) : 'Tự do';
                    const vdvNames = (t.vanDongVienNames && t.vanDongVienNames.length > 0)
                        ? `<div class="text-muted small" style="font-size: 0.72rem;"><i class="fa-solid fa-user me-1 text-secondary"></i>${escapeHtml(t.vanDongVienNames.join(', '))}</div>`
                        : '';

                    // Kiểm tra tình trạng của đội trong giải
                    let statusBadge = '<span class="badge bg-light text-secondary border">Đang đấu</span>';
                    const m = item.match;
                    if (m && (m.diemDoi1 != null && m.diemDoi2 != null)) {
                        const isWin = (m.doiThangDangKyId === t.dangKyThiDauId) ||
                            (m.doi1 && m.doi1.dangKyThiDauId === t.dangKyThiDauId && m.diemDoi1 > m.diemDoi2) ||
                            (m.doi2 && m.doi2.dangKyThiDauId === t.dangKyThiDauId && m.diemDoi2 > m.diemDoi1);
                        if (isWin) {
                            statusBadge = '<span class="badge bg-success-subtle text-success border border-success-subtle"><i class="fa-solid fa-check me-1"></i>Thắng trận mở màn</span>';
                        } else {
                            statusBadge = '<span class="badge bg-secondary-subtle text-muted border"><i class="fa-solid fa-xmark me-1"></i>Dừng bước</span>';
                        }
                    }

                    rows += `
                        <tr>
                            <td class="text-center fw-bold text-${badgeColor}" style="width: 50px;">
                                <span class="badge bg-${badgeColor}-subtle text-${badgeColor} border">${item.seed}</span>
                            </td>
                            <td>
                                <strong class="d-block text-dark" style="font-size: 0.85rem;">${name}</strong>
                                ${vdvNames}
                            </td>
                            <td class="small text-muted">${unit}</td>
                            <td class="small text-muted">${m ? escapeHtml(m.tenTran || `Trận #${m.soTran}`) : '-'}</td>
                            <td>${statusBadge}</td>
                        </tr>
                    `;
                });

                return `
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-center" style="width: 60px;">Vị Trí</th>
                                    <th>Đội Thi Đấu / VĐV</th>
                                    <th>Đơn Vị</th>
                                    <th>Trận Đầu</th>
                                    <th>Trạng Thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                ${rows}
                            </tbody>
                        </table>
                    </div>
                `;
            }

            function buildBranchMatchesHtml(matches) {
                if (matches.length === 0) return '';
                let items = '';
                matches.forEach(m => {
                    const timeStr = m.thoiGianDuKien ? formatDate(m.thoiGianDuKien, true) : 'Chưa xếp giờ';
                    const sc1 = m.tySoDoi1 ?? m.diemDoi1;
                    const sc2 = m.tySoDoi2 ?? m.diemDoi2;
                    const scoreText = (sc1 != null && sc2 != null)
                        ? `<span class="badge bg-dark px-2 py-1">${sc1} - ${sc2}</span>`
                        : `<span class="badge bg-light text-muted border">Chưa đấu</span>`;
                    const ph = getMatchPlaceholderTeams(m);
                    const d1 = m.doi1 ? escapeHtml(m.doi1.tenDangKy || m.doi1.tenDoi || 'Đội 1') : escapeHtml(ph.t1);
                    const d2 = m.doi2 ? escapeHtml(m.doi2.tenDangKy || m.doi2.tenDoi || 'Đội 2') : escapeHtml(ph.t2);

                    items += `
                        <div class="p-2 border rounded bg-white shadow-2xs mb-2">
                            <div class="d-flex justify-content-between align-items-center mb-1 pb-1 border-bottom">
                                <span class="fw-bold small text-dark">#${m.soTran} • ${escapeHtml(m.tenTran)}</span>
                                <div class="d-flex align-items-center gap-1">
                                    <small class="text-muted" style="font-size: 0.72rem;">${timeStr}</small>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="small text-truncate ${m.doiThangDangKyId && m.doi1 && m.doi1.dangKyThiDauId === m.doiThangDangKyId ? 'fw-bold text-success' : 'text-dark'}" style="max-width: 42%;" title="${d1}">${d1}</span>
                                ${scoreText}
                                <span class="small text-truncate text-end ${m.doiThangDangKyId && m.doi2 && m.doi2.dangKyThiDauId === m.doiThangDangKyId ? 'fw-bold text-success' : 'text-dark'}" style="max-width: 42%;" title="${d2}">${d2}</span>
                            </div>
                        </div>
                    `;
                });
                return items;
            }

            // Tìm thông tin Vô địch, Á quân, Hạng 3 từ trận Chung kết & Hạng 3
            let championTeam = null;
            let runnerUpTeam = null;
            let thirdPlaceTeam = null;

            finalMatches.forEach(fm => {
                const isFinal = isMatchFinal(fm);
                const isBronze = isMatchBronze(fm);

                const sc1 = fm.tySoDoi1 ?? fm.diemDoi1;
                const sc2 = fm.tySoDoi2 ?? fm.diemDoi2;
                if (isFinal && (fm.doiThangDangKyId || (sc1 != null && sc2 != null))) {
                    const d1Won = fm.doiThangDangKyId ? (fm.doi1 && fm.doi1.dangKyThiDauId === fm.doiThangDangKyId) : (sc1 > sc2);
                    if (d1Won) {
                        championTeam = fm.doi1;
                        runnerUpTeam = fm.doi2;
                    } else {
                        championTeam = fm.doi2;
                        runnerUpTeam = fm.doi1;
                    }
                }
                if (isBronze && (fm.doiThangDangKyId || (sc1 != null && sc2 != null))) {
                    const d1Won = fm.doiThangDangKyId ? (fm.doi1 && fm.doi1.dangKyThiDauId === fm.doiThangDangKyId) : (sc1 > sc2);
                    thirdPlaceTeam = d1Won ? fm.doi1 : fm.doi2;
                }
            });

            // HTML Bục Vinh Quang (Podium)
            let podiumHtml = '';
            if (championTeam || runnerUpTeam || thirdPlaceTeam) {
                podiumHtml = `
                    <div class="card border-0 shadow-sm mt-3 bg-gradient" style="background: linear-gradient(135deg, #0f172a, #1e293b); color: #fff;">
                        <div class="card-header bg-transparent text-center border-0 pt-3 pb-0">
                            <h6 class="fw-bold text-warning mb-0"><i class="fa-solid fa-award me-1"></i> BỤC VINH QUANG VÀ HUY CHƯƠNG GIẢI ĐẤU</h6>
                        </div>
                        <div class="card-body">
                            <div class="podium-box">
                                <!-- Á QUÂN (HCB) -->
                                <div class="podium-step silver">
