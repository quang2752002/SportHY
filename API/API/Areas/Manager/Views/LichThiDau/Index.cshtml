                                    </div>
                                    <small class="text-muted" style="font-size: 0.72rem;">Quyết định chủ nhân tấm Huy chương Đồng</small>
                                </div>
                                <div class="row g-3">
                                    ${bronzeMatches.map(renderKoCard).join('')}
                                </div>
                            </div>
                        `;
                    }

                    // 5. Trận Chung Kết (Huy Chương Vàng & Bạc)
                    if (finalMatches.length > 0) {
                        koSectionsHtml += `
                            <div class="mb-2">
                                <div class="d-flex align-items-center justify-content-between mb-2 pb-1 border-bottom">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-warning text-dark border border-warning px-2 py-1 fw-bold">
                                            <i class="fa-solid fa-trophy text-dark me-1"></i> CHUNG KẾT (TRANH NGÔI VÔ ĐỊCH — HCV & HCB)
                                        </span>
                                        <span class="small text-muted fw-semibold">(${finalMatches.length} trận)</span>
                                    </div>
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle" style="font-size: 0.72rem;">Trận Đấu Đỉnh Cao</span>
                                </div>
                                <div class="row g-3">
                                    ${finalMatches.map(renderKoCard).join('')}
                                </div>
                            </div>
