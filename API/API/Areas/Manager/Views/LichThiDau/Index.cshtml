                            <strong class="d-block text-truncate text-primary" style="font-size: 0.85rem;" title="${d1Name}">
                                <i class="fa-solid fa-user-shield me-1"></i>${d1Name}
                            </strong>
                            <small class="text-muted"><i class="fa-solid fa-shield-halved me-1"></i>${d1Unit}</small>
                        </div>
                    </div>
                `;
