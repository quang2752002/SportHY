                                    <i class="fa-solid fa-trophy fa-2x text-white mb-1"></i>
                                    <div class="fw-bold small">VÔ ĐỊCH (HCV)</div>
                                    <div class="text-truncate fw-bold mt-1" style="font-size: 0.85rem;" title="${escapeHtml(championTeam?.tenDangKy || championTeam?.tenDoi || 'Chờ xác định')}">${escapeHtml(championTeam?.tenDangKy || championTeam?.tenDoi || 'Chờ xác định')}</div>
                                    <small class="text-white-50 text-truncate d-block" style="font-size: 0.72rem;">${escapeHtml(championTeam?.tenDonVi || '')}</small>
                                </div>
                                <!-- HẠNG BA (HCĐ) -->
