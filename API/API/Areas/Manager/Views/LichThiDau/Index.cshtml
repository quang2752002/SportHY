                                </div>
                                <div class="p-2 border-bottom bg-white">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                                        <input type="text" id="modalSearchUngroupedTeam" class="form-control border-start-0" placeholder="Tìm đội chưa chia bảng..." oninput="filterModalUngroupedTeams()">
                                    </div>
                                </div>
                                <div class="card-body p-2 group-dropzone" id="modalUngroupedDropZone"
                                     ondragover="onUngroupedDragOver(event)"
                                     ondragleave="onUngroupedDragLeave(event)"
                                     ondrop="onUngroupedDrop(event)"
                                     style="max-height: 60vh; min-height: 250px; overflow-y: auto; background-color: #fafbfc;">
                                    <div id="modalUngroupedTeamsList" class="d-flex flex-column gap-2">
                                        <!-- Danh sách thẻ đội chưa phân bảng -->
                                    </div>
                                </div>
                                <div class="card-footer bg-light p-2 text-center">
                                    <small class="text-muted"><i class="fa-solid fa-circle-info me-1"></i> Kéo đội vào các Bảng ở khung bên phải</small>
                                </div>
                            </div>
                        </div>

                        <!-- Cột phải: Lưới các Bảng đấu (A, B, C, D...) -->
                        <div class="col-lg-8 col-xl-9">
                            <div class="card h-100 border shadow-sm">
                                <div class="card-header bg-light py-2 px-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fw-bold text-dark small">
                                            <i class="fa-solid fa-layer-group text-primary me-1"></i>Danh Sách Các Bảng Đấu
                                        </span>
                                        <span id="modalGroupConfigBadge" class="badge bg-primary-subtle text-primary border border-primary-subtle small">Cấu hình</span>
                                    </div>
                                    <div class="d-flex flex-wrap align-items-center gap-1">
                                        <!--<button type="button" class="btn btn-xs btn-outline-secondary" onclick="initModalGroups()" title="Khởi tạo hoặc thêm bảng đấu theo cấu hình môn">
                                            <i class="fa-solid fa-plus me-1"></i>Thêm Bảng
                                        </button>-->
                                        <!-- <button type="button" class="btn btn-xs btn-outline-primary" onclick="autoDistributeTeamsToGroups()" title="Bốc thăm ngẫu nhiên chia đều vào các bảng">
                                            <i class="fa-solid fa-dice me-1"></i>Bốc Thăm Chia Bảng
                                        </button> -->
                                        <button type="button" class="btn btn-xs btn-outline-danger" onclick="resetAllGroupAssignments()" title="Đưa toàn bộ đội về danh sách chưa phân bảng">
                                            <i class="fa-solid fa-arrow-rotate-left me-1"></i>Xóa Phân Bảng
                                        </button>
                                        <!-- <button type="button" class="btn btn-xs btn-outline-success" onclick="generateRoundRobinAllGroups()" title="Tự động sinh các cặp đấu vòng tròn cho tất cả bảng">
                                            <i class="fa-solid fa-bolt me-1"></i>Sinh Cặp Vòng Tròn
                                        </button>  -->
                                        <button type="button" class="btn btn-xs btn-outline-info" onclick="generateKnockoutOnly()" title="Sinh nhanh các cặp đấu Tứ kết, Bán kết, Chung kết với placeholder">
                                            <i class="fa-solid fa-sitemap me-1"></i>Sinh Nhánh Knockout
                                        </button>
                                        <button type="button" class="btn btn-xs btn-primary fw-semibold" onclick="switchModalHybridTab('fixtures')">
                                            Xếp Cặp Đấu <i class="fa-solid fa-arrow-right ms-1"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="card-body p-3" style="max-height: 65vh; overflow-y: auto; background-color: #f8fafc;">
                                    <div class="row g-3" id="modalGroupsGridContainer">
                                        <!-- Khung các bảng đấu A, B, C... -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- VIEW 2: LAYOUT CÁC CẶP THI ĐẤU (Phân nhóm theo bảng nếu là môn kết hợp) -->
                    <div id="modalFixturesPane" class="row g-3">
                        <!-- CỘT TRÁI: DANH SÁCH ĐỘI CHƯA XẾP CẶP (CÓ KÉO THẢ) -->
                        <div class="col-lg-4 col-xl-3">
                            <div class="card h-100 border shadow-sm">
                                <div class="card-header bg-light py-2 px-3 d-flex justify-content-between align-items-center">
                                    <span class="fw-bold text-dark small">
                                        <i class="fa-solid fa-users text-primary me-1"></i>Đội Chưa Xếp Cặp
                                    </span>
                                    <span class="badge bg-danger rounded-pill" id="modalUnpairedCountBadge">0</span>
                                </div>
                                <div class="p-2 border-bottom bg-white">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                                        <input type="text" id="modalSearchUnpairedTeam" class="form-control border-start-0" placeholder="Tìm tên đội, VĐV..." oninput="filterModalUnpairedTeams()">
                                    </div>
                                </div>
                                <div class="card-body p-2 unpaired-dropzone" id="modalUnpairedDropZone"
                                     ondragover="onUnpairedDragOver(event)"
                                     ondragleave="onUnpairedDragLeave(event)"
                                     ondrop="onUnpairedDrop(event)"
                                     style="max-height: 60vh; overflow-y: auto; background-color: #fafbfc;">
                                    <div id="modalUnpairedTeamsList" class="d-flex flex-column gap-2">
                                        <!-- Thẻ đội draggable -->
                                    </div>
                                </div>
                                <div class="card-footer bg-light p-2 text-center">
                                    <small class="text-muted"><i class="fa-solid fa-circle-info me-1"></i> Kéo thẻ đội sang ô cặp đấu bên phải</small>
                                </div>
                            </div>
                        </div>

                        <!-- CỘT PHẢI: LAYOUT CÁC CẶP ĐẤU (CÓ KÉO THẢ & CHỈNH SỬA, PHÂN THEO BẢNG) -->
                        <div class="col-lg-8 col-xl-9">
                            <div class="card h-100 border shadow-sm">
                                <div class="card-header bg-light py-2 px-3 d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fw-bold text-dark small">
                                            <i class="fa-solid fa-sitemap text-success me-1"></i>Layout Các Cặp Thi Đấu
                                        </span>
                                        <span id="modalHybridFixturesBadge" class="badge bg-info-subtle text-info border border-info-subtle small d-none">Hiển thị theo bảng đấu</span>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-primary rounded-pill" id="modalPairCountBadge">0 cặp</span>
                                    </div>
                                </div>
                                <div class="card-body p-3" id="modalMatchesPairContainer" style="max-height: 65vh; overflow-y: auto; background-color: #f8fafc;">
                                    <!-- Thẻ cặp đấu có dropzone (phân nhóm theo bảng hoặc danh sách phẳng) -->
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentView = 'layout';
        let currentTablePage = 1;
        const pageSize = 20;
        let draggedPayload = null;

        // Dữ liệu cho giao diện CHỈ XEM ngoài trang chính
        let mainViewData = {
            giaiDauMonTheThaoId: 0,
            vongDaus: [],
            bangDaus: [],
            sanDaus: [],
            allTeams: [],
            unpairedTeams: [],
            pairs: []
        };

        // Dữ liệu cho giao diện KÉO THẢ CHỈNH SỬA trong Modal
        let modalData = {
            giaiDauMonTheThaoId: 0,
            vongDaus: [],
            bangDaus: [],
            sanDaus: [],
            allTeams: [],
            unpairedTeams: [],
            pairs: []
        };

        $(document).ready(function () {
            // Khởi tạo giải đấu ban đầu nếu có
            const initialGiaiDau = $('#mainGiaiDauSelect').val();
            if (initialGiaiDau) {
                onMainGiaiDauChanged(initialGiaiDau);
            }

            // Bộ lọc Bảng tổng hợp
            $('#keyword').on('keypress', function (e) {
                if (e.which === 13) loadTableData(1);
            });
            $('#dateFilter, #statusFilter').on('change', function () {
                loadTableData(1);
            });

            // Submit Modals
            $('#formAutoSchedule').on('submit', function (e) {
                e.preventDefault();
                runAutoSchedule();
            });
        });

        // ==================== CHUYỂN ĐỔI CHẾ ĐỘ XEM TRANG CHÍNH ====================
        function switchView(view) {
            currentView = view;
            $('#btnViewBracket').removeClass('active');
            $('#btnViewLayout').removeClass('active');

            $('#viewBracketContainer').addClass('d-none');
            $('#viewLayoutContainer').addClass('d-none');

            if (view === 'bracket') {
                $('#viewBracketContainer').removeClass('d-none');
                $('#layoutActionStrip').removeClass('d-none');
                $('#btnViewBracket').addClass('active');
                if ((!mainViewData.pairs || mainViewData.pairs.length === 0) && $('#mainMonSelect').val()) {
                    loadMainLayoutViewData();
                } else {
                    renderBracketUI();
                }
            } else {
                $('#viewLayoutContainer').removeClass('d-none');
                $('#layoutActionStrip').removeClass('d-none');
                $('#btnViewLayout').addClass('active');
                if ((!mainViewData.pairs || mainViewData.pairs.length === 0) && $('#mainMonSelect').val()) {
                    loadMainLayoutViewData();
                } else {
                    renderMainViewOnlyUI();
                }
            }
        }

        let allMainSports = [];
        let allModalSports = [];

        // ==================== BỘ LỌC TRANG CHÍNH ====================
        function onMainGiaiDauChanged(giaiDauId) {
            if (!giaiDauId) {
                allMainSports = [];
                $('#mainDanhMucSelect').html('<option value="">-- Tất cả danh mục --</option>');
                $('#mainMonSelect').html('<option value="">-- Chọn môn thể thao --</option>');
                $('#layoutPlaceholder').removeClass('d-none');
                $('#layoutWorkspace').addClass('d-none');
                $('#layoutLoading').addClass('d-none');
                return;
            }

            $.get('/Manager/LichThiDau/GetMonByGiaiDau', { giaiDauId: parseInt(giaiDauId) }, function (res) {
                if (res.success && res.data && res.data.length > 0) {
                    allMainSports = res.data;

                    // Tạo danh sách Danh mục môn có trong giải đấu
                    const dmMap = new Map();
                    allMainSports.forEach(m => {
                        if (m.danhMucId && m.tenDanhMuc) {
                            dmMap.set(m.danhMucId, m.tenDanhMuc);
                        }
                    });

                    let dmOpts = '<option value="">-- Tất cả danh mục --</option>';
                    dmMap.forEach((name, id) => {
                        dmOpts += `<option value="${id}">${escapeHtml(name)}</option>`;
                    });
                    $('#mainDanhMucSelect').html(dmOpts);

                    // Tự động chọn danh mục môn đầu tiên theo môn thi đấu đầu tiên của giải
                    const firstSport = allMainSports[0];
                    if (firstSport && firstSport.danhMucId && dmMap.has(firstSport.danhMucId)) {
                        $('#mainDanhMucSelect').val(firstSport.danhMucId);
                        renderMainMonSelect(firstSport.danhMucId);
                    } else {
                        $('#mainDanhMucSelect').val('');
                        renderMainMonSelect();
                    }
                    loadMainData();
                } else {
                    allMainSports = [];
                    $('#mainDanhMucSelect').html('<option value="">-- Tất cả danh mục --</option>');
                    $('#mainMonSelect').html('<option value="">-- Chọn môn thể thao --</option>');
                    $('#layoutPlaceholder').removeClass('d-none');
                    $('#layoutWorkspace').addClass('d-none');
                    $('#layoutLoading').addClass('d-none');
                }
            });
        }

        function onMainDanhMucChanged(danhMucId) {
            renderMainMonSelect(danhMucId);
            loadMainData();
        }

        function onMainMonChanged(monId) {
            if (monId) {
                const sport = allMainSports.find(m => m.id == parseInt(monId));
                if (sport && sport.danhMucId) {
                    $('#mainDanhMucSelect').val(sport.danhMucId);
                }
            }
            loadMainData();
        }

        function renderMainMonSelect(danhMucId) {
            danhMucId = danhMucId !== undefined ? danhMucId : $('#mainDanhMucSelect').val();
            let filtered = allMainSports;
            if (danhMucId) {
                filtered = allMainSports.filter(m => m.danhMucId == parseInt(danhMucId));
            }

            let opts = '<option value="">-- Chọn môn thể thao --</option>';
            filtered.forEach(m => {
                const categoryBadge = m.tenDanhMuc ? ` [${escapeHtml(m.tenDanhMuc)}]` : '';
                opts += `<option value="${m.id}">${escapeHtml(m.ten)}${categoryBadge}</option>`;
            });
            $('#mainMonSelect').html(opts);

            const currentVal = $('#mainMonSelect').val();
            if (currentVal && filtered.some(m => m.id == currentVal)) {
                $('#mainMonSelect').val(currentVal);
            } else if (filtered.length > 0) {
                $('#mainMonSelect').val(filtered[0].id);
            }
        }

        function loadMainData() {
            loadMainLayoutViewData();
        }

        // ==================== KHÔNG GIAN 1: LAYOUT CHỈ XEM NGOÀI TRANG CHÍNH ====================
        function loadMainLayoutViewData() {
            const giaiDauMonTheThaoId = $('#mainMonSelect').val();
            if (!giaiDauMonTheThaoId) {
                $('#layoutPlaceholder').removeClass('d-none');
                $('#layoutWorkspace').addClass('d-none');
                $('#layoutLoading').addClass('d-none');
                return;
            }

            $('#layoutPlaceholder').addClass('d-none');
            $('#layoutWorkspace').addClass('d-none');
            $('#layoutLoading').removeClass('d-none');

            $.ajax({
                url: '/Manager/LichThiDau/GetManualPairingData',
                type: 'GET',
                data: {
                    giaiDauMonTheThaoId: parseInt(giaiDauMonTheThaoId)
                },
                success: function (res) {
                    $('#layoutLoading').addClass('d-none');
                    if (res.success && res.data) {
                        mainViewData = {
                            giaiDauMonTheThaoId: res.data.giaiDauMonTheThaoId,
                            tenMonTheThao: res.data.tenMonTheThao,
                            hinhThucThiDau: res.data.hinhThucThiDau,
                            laMonDongDoi: res.data.laMonDongDoi,
                            vongDaus: res.data.vongDaus || [],
                            bangDaus: res.data.bangDaus || [],
                            sanDaus: res.data.sanDaus || [],
                            allTeams: res.data.allTeams || [],
                            unpairedTeams: res.data.unpairedTeams || [],
                            pairs: res.data.existingPairs || []
                        };

                        // Chỉ hiển thị tab Sơ Đồ Nhánh khi môn thi đấu có thể thức Bảng Kết Hợp Knockout
                        const isKnockoutOnly = mainViewData.hinhThucThiDau === 'LoaiTrucTiep' || mainViewData.hinhThucThiDau == 1 || mainViewData.hinhThucThiDau === '1';
                        const isHybrid = mainViewData.hinhThucThiDau === 'KetHopVongBangVaLoaiTrucTiep' || mainViewData.hinhThucThiDau == 3 || mainViewData.hinhThucThiDau === '3';
                        const showBracket = isHybrid;

                        if (showBracket) {
                            $('#btnViewBracket').removeClass('d-none');
                            $('#btnRightViewBracket').removeClass('d-none');
                            if (currentView === 'bracket') {
                                renderBracketUI();
                            }
                        } else {
                            $('#btnViewBracket').addClass('d-none');
                            $('#btnRightViewBracket').addClass('d-none');
                            if (currentView === 'bracket') {
                                switchView('layout');
                            }
                        }

                        $('#layoutWorkspace').removeClass('d-none');
                        renderMainViewOnlyUI();
                        if (showBracket) {
                            renderBracketUI();
                        }
                    } else {
                        $('#layoutPlaceholder').removeClass('d-none');
                    }
                },
                error: function () {
                    $('#layoutLoading').addClass('d-none');
                    $('#layoutPlaceholder').removeClass('d-none');
                }
            });
        }

        function getParticipantDisplayName(team, isModal = false, fallback = 'Chưa xếp') {
            if (!team) return fallback;
            const isTeamSport = isModal ? (modalData && modalData.laMonDongDoi) : (mainViewData && mainViewData.laMonDongDoi);
            if (isTeamSport) {
                // Môn đồng đội: Ưu tiên tên đội
                if (team.tenDoi && !team.tenDoi.startsWith('Tham gia -')) return team.tenDoi;
                if (team.tenDangKy && !team.tenDangKy.startsWith('Tham gia -')) return team.tenDangKy;
                return fallback;
            } else {
                // Môn cá nhân: Ưu tiên tên VĐV
                if (team.vanDongVienNames && team.vanDongVienNames.length > 0 && team.vanDongVienNames[0]) return team.vanDongVienNames[0];
                if (team.tenDangKy && !team.tenDangKy.startsWith('Tham gia -')) return team.tenDangKy;
                if (team.tenDoi && !team.tenDoi.startsWith('Tham gia -')) return team.tenDoi;
                return fallback;
            }
        }

        function renderMainViewOnlyUI() {
            renderMainLeftColumn();
            renderMainMatchesContainer();
            $('#mainPairCountBadge').text(`${mainViewData.pairs.length} trận`);
        }

        function switchLeftTab(tab) {
            if (tab === 'groups') {
                $('#tabLeftGroupsBtn').addClass('active');
                $('#tabLeftParticipantsBtn').removeClass('active');
                $('#mainGroupsContainer').removeClass('d-none');
                $('#mainParticipantsCard').addClass('d-none');
                if (mainViewData.unpairedTeams && mainViewData.unpairedTeams.length > 0) {
                    $('#mainUnpairedCard').removeClass('d-none');
                } else {
                    $('#mainUnpairedCard').addClass('d-none');
                }
            } else {
                $('#tabLeftParticipantsBtn').addClass('active');
                $('#tabLeftGroupsBtn').removeClass('active');
                $('#mainParticipantsCard').removeClass('d-none');
                $('#mainGroupsContainer').addClass('d-none');
                $('#mainUnpairedCard').addClass('d-none');
            }
        }

        function renderMainLeftColumn() {
            const isHybrid = mainViewData.hinhThucThiDau === 'KetHopVongBangVaLoaiTrucTiep' || mainViewData.hinhThucThiDau == 3;
            const isRoundRobin = mainViewData.hinhThucThiDau === 'VongBang' || mainViewData.hinhThucThiDau == 2;
            const isKnockoutOnly = mainViewData.hinhThucThiDau === 'LoaiTrucTiep' || mainViewData.hinhThucThiDau == 1;
            const isTeamSport = !!mainViewData.laMonDongDoi;

            // Gom các đội theo Bảng đấu nếu có
            const groupMap = new Map();
            if (mainViewData.bangDaus && mainViewData.bangDaus.length > 0) {
                mainViewData.bangDaus.forEach(b => {
                    groupMap.set(b.id, { id: b.id, ten: b.ten || `Bảng ${b.ma || b.thuTu}`, teams: [] });
                });
            }
            if (mainViewData.allTeams) {
                mainViewData.allTeams.forEach(t => {
                    if (t.bangDauId && groupMap.has(t.bangDauId)) {
                        groupMap.get(t.bangDauId).teams.push(t);
                    } else if (t.bangDauId || t.tenBangDau) {
                        const key = t.bangDauId || t.tenBangDau;
                        if (!groupMap.has(key)) {
                            groupMap.set(key, { id: t.bangDauId || 0, ten: t.tenBangDau || `Bảng #${t.bangDauId}`, teams: [] });
                        }
                        groupMap.get(key).teams.push(t);
                    }
                });
            }
            const activeGroups = Array.from(groupMap.values()).filter(g => g.teams.length > 0);
            const hasGroups = activeGroups.length > 0;

            const totalTeams = mainViewData.allTeams ? mainViewData.allTeams.length : 0;
            $('#leftTabTeamsCountBadge').text(totalTeams);

            if (isHybrid && hasGroups) {
                // Thể thức Kết Hợp ĐÃ CÓ BẢNG: Giữ nguyên như cũ, bổ sung tab xem toàn bộ danh sách
                $('#mainLeftColumnTabs').removeClass('d-none');
                $('#tabLeftGroupsBtn').addClass('active');
                $('#tabLeftParticipantsBtn').removeClass('active');
                $('#mainGroupsContainer').removeClass('d-none');
                $('#mainParticipantsCard').addClass('d-none');
                $('#mainLeftWarningBanner').addClass('d-none');
                renderMainGroupsUI(activeGroups);
                renderMainUnpairedTeams();
                renderMainParticipantsCard();
            } else if (isHybrid && !hasGroups) {
                // Thể thức Kết Hợp nhưng CHƯA CHIA BẢNG:
                // Hiện banner nhắc nhở chia bảng + Luôn hiển thị danh sách VĐV & Đội đầy đủ
                $('#mainLeftColumnTabs').addClass('d-none');
                $('#mainGroupsContainer').addClass('d-none');
                $('#mainUnpairedCard').addClass('d-none');
                $('#mainParticipantsCard').removeClass('d-none');
                const curGiaiDau = $('#mainGiaiDauSelect').val() || '';
                const curMon = $('#mainMonSelect').val() || '';
                $('#mainLeftWarningBanner').removeClass('d-none').html(`
                    <div class="alert alert-warning py-2 px-2 small mb-2 d-flex align-items-center justify-content-between">
                        <div><i class="fa-solid fa-triangle-exclamation me-1"></i>Chưa chia bảng đấu</div>
                       
                    </div>
                `);
                renderMainParticipantsCard();
            } else if (isRoundRobin && hasGroups) {
                // Vòng tròn tính điểm ĐÃ CÓ BẢNG
                $('#mainLeftColumnTabs').removeClass('d-none');
                $('#tabLeftGroupsBtn').addClass('active');
                $('#tabLeftParticipantsBtn').removeClass('active');
                $('#mainGroupsContainer').removeClass('d-none');
                $('#mainParticipantsCard').addClass('d-none');
                $('#mainLeftWarningBanner').addClass('d-none');
                renderMainGroupsUI(activeGroups);
                renderMainUnpairedTeams();
                renderMainParticipantsCard();
            } else {
                // Loại trực tiếp (Knockout), hoặc Vòng tròn chưa chia bảng, hoặc Tính điểm:
                // Luôn hiển thị Danh Sách Vận Động Viên & Đội Tham Gia trực quan, đầy đủ
                $('#mainLeftColumnTabs').addClass('d-none');
                $('#mainGroupsContainer').addClass('d-none');
                $('#mainUnpairedCard').addClass('d-none');
                $('#mainParticipantsCard').removeClass('d-none');
                $('#mainLeftWarningBanner').addClass('d-none');
                renderMainParticipantsCard();
            }
        }

        function renderMainParticipantsCard() {
            const container = $('#mainParticipantsList');
            container.empty();

            const isTeamSport = !!mainViewData.laMonDongDoi;
            const participantLabel = isTeamSport ? 'Đội' : 'VĐV';
            const participantTitle = isTeamSport ? 'Danh Sách Đội Tham Gia' : 'Danh Sách VĐV Tham Gia';
            const iconClass = isTeamSport ? 'fa-solid fa-shield-halved' : 'fa-solid fa-user-ninja';

            $('#mainParticipantsCardTitle').html(`<i class="${iconClass} text-primary me-1"></i>${participantTitle}`);

            if (!mainViewData || !mainViewData.allTeams || mainViewData.allTeams.length === 0) {
                $('#mainParticipantsCountBadge').text(`0 ${participantLabel}`);
                $('#mainStatsPaired').text('0');
                $('#mainStatsUnpaired').text('0');
                container.html(`
                    <div class="text-center text-muted py-4">
                        <i class="fa-solid fa-users-slash fa-2x mb-2 text-secondary"></i>
                        <div class="fw-semibold small">Chưa có ${isTeamSport ? 'đội' : 'VĐV'} nào đăng ký</div>
                        <small class="text-muted">Các hồ sơ đăng ký thi đấu đã duyệt sẽ hiển thị ở đây.</small>
                    </div>
                `);
                return;
            }

            // Xây dựng bản đồ các đội/VĐV đã được xếp trận
            const pairedMap = new Map();
            if (mainViewData.pairs && mainViewData.pairs.length > 0) {
                mainViewData.pairs.forEach(p => {
                    const matchLabel = p.soTran ? `Trận #${p.soTran}` : (p.tenTran || 'Đã xếp');
                    if (p.doi1 && p.doi1.dangKyThiDauId) {
                        pairedMap.set(p.doi1.dangKyThiDauId, matchLabel);
                    }
                    if (p.doi2 && p.doi2.dangKyThiDauId) {
                        pairedMap.set(p.doi2.dangKyThiDauId, matchLabel);
                    }
                    if (p.danhSachVdv && p.danhSachVdv.length > 0) {
                        p.danhSachVdv.forEach(v => {
                            if (v.dangKyThiDauId) pairedMap.set(v.dangKyThiDauId, matchLabel);
                        });
                    }
                });
            }

            const total = mainViewData.allTeams.length;
            const pairedCount = mainViewData.allTeams.filter(t => pairedMap.has(t.dangKyThiDauId)).length;
            const unpairedCount = total - pairedCount;

            $('#mainParticipantsCountBadge').text(`${total} ${participantLabel}`);
            $('#mainStatsPaired').text(pairedCount);
            $('#mainStatsUnpaired').text(unpairedCount);

            mainViewData.allTeams.forEach((team, idx) => {
                const displayName = escapeHtml(getParticipantDisplayName(team, false, `${participantLabel} #${team.dangKyThiDauId}`));
                const unitName = team.tenDonVi ? escapeHtml(team.tenDonVi) : 'Tự do';
                const sbdTag = team.soDangKy ? `<span class="badge bg-light text-muted border me-1" style="font-size: 0.7rem;">${escapeHtml(team.soDangKy)}</span>` : '';

                const isPaired = pairedMap.has(team.dangKyThiDauId);
                const statusBadge = !isPaired
                    ? `<span class="badge bg-light text-secondary border" style="font-size: 0.72rem;"><i class="fa-solid fa-circle-dot me-1"></i>Chưa xếp</span>`
                    : '';

                // Thành viên VĐV (nếu là môn đồng đội)
                const vdvList = (isTeamSport && team.vanDongVienNames && team.vanDongVienNames.length > 0)
                    ? `<div class="text-muted small mt-1" style="font-size: 0.73rem;"><i class="fa-solid fa-user me-1 text-secondary"></i>${escapeHtml(team.vanDongVienNames.slice(0, 3).join(', '))}${team.vanDongVienNames.length > 3 ? ` (+${team.vanDongVienNames.length - 3})` : ''}</div>`
                    : '';

                const avatarLetter = displayName ? displayName.charAt(0).toUpperCase() : '#';
                const bgColors = ['bg-primary', 'bg-success', 'bg-info', 'bg-warning', 'bg-danger', 'bg-secondary'];
                const avatarBg = bgColors[idx % bgColors.length];

                const bottomMetaHtml = sbdTag
                    ? `<div class="d-flex flex-wrap align-items-center mt-1 pt-1 border-top" style="font-size: 0.72rem;">${sbdTag}</div>`
                    : '';

                const cardHtml = `
                    <div class="participant-item-card main-participant-item shadow-2xs">
                        <div class="d-flex align-items-center justify-content-between gap-2">
                            <div class="d-flex align-items-center gap-2 overflow-hidden">
                                <div class="participant-avatar ${avatarBg} text-white shadow-2xs">${avatarLetter}</div>
                                <div class="overflow-hidden">
                                    <strong class="text-dark d-block text-truncate" style="font-size: 0.85rem;" title="${displayName}">${displayName}</strong>
                                    <small class="text-muted d-block text-truncate" style="font-size: 0.73rem;">
                                        <i class="fa-solid fa-shield-halved text-secondary me-1"></i>${unitName}
                                    </small>
                                </div>
                            </div>
                            ${statusBadge ? `<div class="text-end flex-shrink-0">${statusBadge}</div>` : ''}
                        </div>
                        ${bottomMetaHtml}
                        ${vdvList}
                    </div>
                `;
                container.append(cardHtml);
            });

            filterMainParticipants();
        }

        function filterMainParticipants() {
            const query = ($('#mainSearchParticipant').val() || '').toLowerCase().trim();
            if (!query) {
                $('.main-participant-item').removeClass('d-none');
                return;
            }
            $('.main-participant-item').each(function () {
                const text = $(this).text().toLowerCase();
                if (text.includes(query)) {
                    $(this).removeClass('d-none');
                } else {
                    $(this).addClass('d-none');
                }
            });
        }

        function renderMainGroupsUI(providedGroups = null) {
            const container = $('#mainGroupsContainer');
            container.empty();

            if (!mainViewData || !mainViewData.allTeams || mainViewData.allTeams.length === 0) {
                container.addClass('d-none');
                return;
            }

            let activeGroups = providedGroups;
            if (!activeGroups) {
                const groupMap = new Map();
                if (mainViewData.bangDaus && mainViewData.bangDaus.length > 0) {
                    mainViewData.bangDaus.forEach(b => {
                        groupMap.set(b.id, {
                            id: b.id,
                            ten: b.ten || `Bảng ${b.ma || b.thuTu}`,
                            teams: []
                        });
                    });
                }
                mainViewData.allTeams.forEach(t => {
                    if (t.bangDauId && groupMap.has(t.bangDauId)) {
                        groupMap.get(t.bangDauId).teams.push(t);
                    } else if (t.bangDauId || t.tenBangDau) {
                        const key = t.bangDauId || t.tenBangDau;
                        if (!groupMap.has(key)) {
                            groupMap.set(key, {
                                id: t.bangDauId || 0,
                                ten: t.tenBangDau || `Bảng #${t.bangDauId}`,
                                teams: []
                            });
                        }
                        groupMap.get(key).teams.push(t);
                    }
                });
                activeGroups = Array.from(groupMap.values()).filter(g => g.teams.length > 0);
            }

            if (!activeGroups || activeGroups.length === 0) {
                container.addClass('d-none');
                return;
            }

            container.removeClass('d-none');

            // Tính điểm và bảng xếp hạng cho từng bảng từ các trận đấu vòng bảng
            activeGroups.forEach(group => {
                const teamsStats = group.teams.map(t => {
                    return {
                        team: t,
                        p: 0,   // Played
                        w: 0,   // Won
                        d: 0,   // Draw
                        l: 0,   // Lost
                        gf: 0,  // Goals For
                        ga: 0,  // Goals Against
                        gd: 0,  // Goal Difference
                        pts: 0  // Points
                    };
                });

                const statsMap = new Map();
                teamsStats.forEach(ts => statsMap.set(ts.team.dangKyThiDauId, ts));

                // Quét qua các trận vòng bảng thuộc bảng này
                if (mainViewData.pairs && mainViewData.pairs.length > 0) {
                    const groupMatches = mainViewData.pairs.filter(p => {
                        if (isMatchKnockout(p)) return false;
                        if (group.id > 0 && p.bangDauId === group.id) return true;
                        if (p.tenBangDau && p.tenBangDau === group.ten) return true;
                        if (!p.bangDauId && activeGroups.length === 1) return true;
                        return false;
                    });

                    groupMatches.forEach(m => {
                        if (m.diemDoi1 != null && m.diemDoi2 != null) {
                            const d1Id = m.doi1 ? m.doi1.dangKyThiDauId : null;
                            const d2Id = m.doi2 ? m.doi2.dangKyThiDauId : null;
                            const s1 = statsMap.get(d1Id);
                            const s2 = statsMap.get(d2Id);

                            if (s1 && s2) {
                                s1.p++;
                                s2.p++;
                                s1.gf += m.diemDoi1;
                                s1.ga += m.diemDoi2;
                                s2.gf += m.diemDoi2;
                                s2.ga += m.diemDoi1;

                                if (m.diemDoi1 > m.diemDoi2) {
                                    s1.w++;
                                    s1.pts += 3;
                                    s2.l++;
                                } else if (m.diemDoi2 > m.diemDoi1) {
                                    s2.w++;
                                    s2.pts += 3;
                                    s1.l++;
                                } else {
                                    s1.d++;
                                    s1.pts += 1;
                                    s2.d++;
                                    s2.pts += 1;
                                }
                            }
                        }
                    });
                }

                // Tính hiệu số & sắp xếp bảng xếp hạng
                teamsStats.forEach(ts => ts.gd = ts.gf - ts.ga);
                teamsStats.sort((a, b) => {
                    if (b.pts !== a.pts) return b.pts - a.pts;
                    if (b.gd !== a.gd) return b.gd - a.gd;
                    return b.gf - a.gf;
                });

                // Render HTML bảng điểm của bảng này
                let rowsHtml = '';
                teamsStats.forEach((item, rIdx) => {
                    const rank = rIdx + 1;
                    const t = item.team;
                    const name = escapeHtml(getParticipantDisplayName(t, false, `Đội #${t.dangKyThiDauId}`));
                    const unit = t.tenDonVi ? escapeHtml(t.tenDonVi) : 'Tự do';
                    
                    const isAdvancing = rank <= 2;
                    const rankBadge = isAdvancing 
                        ? `<span class="badge bg-success text-white rounded-circle" style="width: 20px; height: 20px; font-size: 0.7rem; padding: 2px 0;">${rank}</span>`
                        : `<span class="badge bg-light text-secondary border rounded-circle" style="width: 20px; height: 20px; font-size: 0.7rem; padding: 2px 0;">${rank}</span>`;

                    const rowBg = isAdvancing ? 'style="background-color: #f0fdf4;"' : '';

                    rowsHtml += `
                        <tr ${rowBg}>
                            <td class="text-center ps-2">${rankBadge}</td>
                            <td>
                                <strong class="d-block text-truncate text-dark" style="font-size: 0.8rem; max-width: 140px;" title="${name}">${name}</strong>
                                <small class="text-muted d-block text-truncate" style="font-size: 0.7rem; max-width: 140px;">${unit}</small>
                            </td>
                            <td class="text-center small">${item.p}</td>
                            <td class="text-center small text-success fw-semibold">${item.w}</td>
                            <td class="text-center small text-secondary">${item.d}</td>
                            <td class="text-center small text-danger">${item.l}</td>
                            <td class="text-center small fw-semibold">${item.gd > 0 ? `+${item.gd}` : item.gd}</td>
                            <td class="text-center pe-2"><strong class="badge bg-primary text-white" style="font-size: 0.75rem;">${item.pts}</strong></td>
                        </tr>
                    `;
                });

                const curGiaiDau = $('#mainGiaiDauSelect').val() || '';
                const curMon = $('#mainMonSelect').val() || '';

                const groupCardHtml = `
                    <div class="card border shadow-sm mb-3">
                        <div class="card-header bg-white py-2 px-3 d-flex justify-content-between align-items-center border-bottom">
                            <span class="fw-bold text-dark small">
                                <i class="fa-solid fa-table-cells-large text-primary me-1"></i>${escapeHtml(group.ten)} (${group.teams.length} đội)
                            </span>
                            <a href="/Manager/BangDau?giaiDauId=${curGiaiDau}&monId=${curMon}" class="btn btn-2xs btn-outline-primary" title="Quản lý chia bảng đấu">
                                <i class="fa-solid fa-pen-to-square me-1"></i>Chia bảng
                            </a>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle mb-0" style="font-size: 0.78rem;">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-2 text-center" style="width: 24px;">#</th>
                                        <th>Đội bóng</th>
                                        <th class="text-center" title="Trận đã đấu">Tr</th>
                                        <th class="text-center text-success" title="Thắng">T</th>
                                        <th class="text-center" title="Hòa">H</th>
                                        <th class="text-center text-danger" title="Bại">B</th>
                                        <th class="text-center" title="Hiệu số">HS</th>
                                        <th class="text-center pe-2" title="Điểm">Điểm</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    ${rowsHtml}
                                </tbody>
                            </table>
                        </div>
                        <div class="card-footer bg-light py-1 px-2 text-center">
                            <small class="text-muted" style="font-size: 0.7rem;"><i class="fa-solid fa-trophy text-success me-1"></i>Top 2 dẫn đầu tiến vào vòng Knockout</small>
                        </div>
                    </div>
                `;
                container.append(groupCardHtml);
            });
        }

        function renderMainUnpairedTeams() {
            const container = $('#mainUnpairedTeamsList');
            container.empty();

            if (!mainViewData.unpairedTeams || mainViewData.unpairedTeams.length === 0) {
                $('#mainUnpairedCard').addClass('d-none');
                return;
            }

            $('#mainUnpairedCard').removeClass('d-none');
            $('#mainUnpairedCountBadge').text(mainViewData.unpairedTeams.length);

            mainViewData.unpairedTeams.forEach(team => {
                const teamName = escapeHtml(getParticipantDisplayName(team, false, `Đội #${team.dangKyThiDauId}`));
                const unitName = team.tenDonVi ? escapeHtml(team.tenDonVi) : 'Tự do';
                const vdvList = (team.vanDongVienNames && team.vanDongVienNames.length > 0)
                    ? `<div class="text-muted small mt-1" style="font-size: 0.75rem;"><i class="fa-solid fa-user me-1"></i>${escapeHtml(team.vanDongVienNames.slice(0, 2).join(', '))}${team.vanDongVienNames.length > 2 ? ` (+${team.vanDongVienNames.length - 2})` : ''}</div>`
                    : '';
                const bangTag = team.tenBangDau ? `<span class="badge bg-info-subtle text-info border small me-1">${escapeHtml(team.tenBangDau)}</span>` : '';

                const cardHtml = `
                    <div class="team-view-card main-unpaired-team-item shadow-2xs">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="overflow-hidden">
                                <strong class="text-dark d-block text-truncate" style="font-size: 0.85rem;" title="${teamName}">${teamName}</strong>
                                <small class="text-muted">${bangTag}<i class="fa-solid fa-shield-halved text-secondary me-1"></i>${unitName}</small>
                            </div>
                            <span class="badge bg-light text-secondary border small">Chưa xếp</span>
                        </div>
                        ${vdvList}
                    </div>
                `;
                container.append(cardHtml);
            });

            filterMainUnpairedTeams();
        }

        function filterMainUnpairedTeams() {
            const query = ($('#mainSearchUnpairedTeam').val() || '').toLowerCase().trim();
            if (!query) {
                $('.main-unpaired-team-item').removeClass('d-none');
                return;
            }
            $('.main-unpaired-team-item').each(function () {
                const text = $(this).text().toLowerCase();
                if (text.includes(query)) {
                    $(this).removeClass('d-none');
                } else {
                    $(this).addClass('d-none');
                }
            });
        }

