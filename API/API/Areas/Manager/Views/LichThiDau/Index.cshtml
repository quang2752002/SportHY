                                <!-- HẠNG BA (HCĐ) -->
                                <div class="podium-step bronze">
                                    <i class="fa-solid fa-medal fa-2x text-warning mb-1"></i>
                                    <div class="fw-bold small">HẠNG BA (HCĐ)</div>
                                    <div class="text-truncate fw-bold mt-1" style="font-size: 0.8rem;" title="${escapeHtml(thirdPlaceTeam?.tenDangKy || thirdPlaceTeam?.tenDoi || 'Chờ xác định')}">${escapeHtml(thirdPlaceTeam?.tenDangKy || thirdPlaceTeam?.tenDoi || 'Chờ xác định')}</div>
                                    <small class="text-white-50 text-truncate d-block" style="font-size: 0.7rem;">${escapeHtml(thirdPlaceTeam?.tenDonVi || '')}</small>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }

            // Kiểm tra xem môn có bảng đấu thực tế không
            const hasRealBangDaus = mainViewData.bangDaus && mainViewData.bangDaus.length > 0;
            const hasAssignedTeams = mainViewData.allTeams && mainViewData.allTeams.some(t => t.bangDauId);

            if (hasRealBangDaus || hasAssignedTeams) {
                // Hiển thị các bảng đấu thực tế từ dữ liệu
                let groupsHtml = '<div class="row g-3">';
                const bangList = (mainViewData.bangDaus && mainViewData.bangDaus.length > 0)
                    ? mainViewData.bangDaus
                    : [{ id: null, ten: 'Bảng Đấu Mặc Định' }];

                const badgeColors = ['primary', 'purple', 'success', 'warning', 'info', 'danger'];

                bangList.forEach((b, bIdx) => {
                    const color = badgeColors[bIdx % badgeColors.length];
                    const bTeams = (mainViewData.allTeams || []).filter(t => b.id ? t.bangDauId === b.id : true);
                    const bMatches = (mainViewData.pairs || []).filter(p => b.id ? p.bangDauId === b.id : !isMatchKnockout(p));

                    let teamsRows = '';
                    bTeams.forEach((t, tIdx) => {
                        const name = escapeHtml(t.tenDangKy || t.tenDoi || `Đội #${t.dangKyThiDauId}`);
                        const unit = t.tenDonVi ? escapeHtml(t.tenDonVi) : 'Tự do';
                        const vdvNames = (t.vanDongVienNames && t.vanDongVienNames.length > 0)
                            ? `<div class="text-muted small" style="font-size: 0.72rem;"><i class="fa-solid fa-user me-1 text-secondary"></i>${escapeHtml(t.vanDongVienNames.join(', '))}</div>`
                            : '';
                        teamsRows += `
                            <tr>
                                <td class="text-center fw-bold text-${color}" style="width: 45px;">
                                    <span class="badge bg-${color}-subtle text-${color} border">${tIdx + 1}</span>
                                </td>
                                <td>
                                    <strong class="d-block text-dark" style="font-size: 0.85rem;">${name}</strong>
                                    ${vdvNames}
                                </td>
                                <td class="small text-muted">${unit}</td>
                            </tr>
                        `;
                    });

                    groupsHtml += `
                        <div class="col-lg-6">
                            <div class="card bracket-branch-card shadow-sm h-100">
                                <div class="card-header py-2 px-3 text-white d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, #1d4ed8, #1e293b);">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-white text-dark fw-bold">${escapeHtml(b.ten || `Bảng ${bIdx + 1}`)}</span>
                                        <strong class="small">VÒNG BẢNG</strong>
                                    </div>
                                    <span class="badge bg-white-subtle text-white small">${bTeams.length} đội</span>
                                </div>
                                <div class="card-body p-3">
                                    <h6 class="fw-bold text-dark small mb-2"><i class="fa-solid fa-users-rectangle text-${color} me-1"></i> Danh Sách Đội Trong Bảng</h6>
                                    <div class="table-responsive mb-3">
                                        <table class="table table-sm table-hover align-middle mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th class="text-center" style="width: 45px;">#</th>
                                                    <th>Đội Thi Đấu / VĐV</th>
                                                    <th>Đơn Vị</th>
                                                </tr>
                                            </thead>
