@{
    ViewData["Title"] = "Quản lý Cụm Sân";
    Layout = "~/Areas/Manager/Views/Shared/_ManagerLayout.cshtml";
}

<div class="container-fluid p-0">
    <div class="card card-custom border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-body p-4">
            <!-- Header -->
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 pb-3 mb-4 border-bottom">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 bg-primary-subtle text-primary rounded-4">
                        <i class="fa-solid fa-map-location-dot fs-4"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-1 text-dark">Quản Lý Cụm Sân Thi Đấu</h4>
                        <p class="text-muted small mb-0">Quản lý các địa điểm thi đấu, cụm tổ hợp sân và trung tâm thể thao.</p>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <a href="/Manager/SanDau" class="btn btn-outline-info rounded-3 px-3">
                        <i class="fa-solid fa-futbol me-1"></i> Quản lý Sân Đấu Chi Tiết
                    </a>
                    <button type="button" class="btn btn-primary px-3 py-2 fw-semibold rounded-3 d-inline-flex align-items-center gap-2 shadow-sm" onclick="openCreateModal()">
                        <i class="fa-solid fa-plus"></i> Thêm Cụm Sân Mới
                    </button>
                </div>
            </div>

            <!-- Bộ lọc tìm kiếm -->
            <div class="p-3 bg-light rounded-3 mb-4 border">
                <div class="row g-2 align-items-center">
                    <div class="col-md-5">
                        <div class="input-group bg-white rounded-3 border overflow-hidden">
                            <span class="input-group-text bg-white border-0 text-muted ps-3">
                                <i class="fa-solid fa-magnifying-glass"></i>
                            </span>
                            <input type="text" id="keyword" class="form-control border-0 shadow-none ps-2" placeholder="Tìm theo tên cụm sân, địa chỉ...">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <select id="trangThaiFilter" class="form-select bg-white border rounded-3 shadow-none">
                            <option value="">-- Tất cả trạng thái --</option>
                            <option value="true">Đang hoạt động</option>
                            <option value="false">Tạm dừng</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="button" class="btn btn-dark w-100 rounded-3" onclick="loadData(1)">
                            <i class="fa-solid fa-filter me-1"></i> Lọc
                        </button>
                    </div>
                    <div class="col-md-2">
                        <button type="button" class="btn btn-outline-secondary w-100 rounded-3" onclick="resetFilter()">
                            <i class="fa-solid fa-arrows-rotate me-1"></i> Làm mới
                        </button>
                    </div>
                </div>
            </div>

            <!-- Bảng Cụm Sân -->
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="tblCumSan">
                    <thead class="table-light text-uppercase fs-7 text-muted">
                        <tr>
                            <th class="ps-3" style="width: 50px;">STT</th>
                            <th>Tên Cụm Sân</th>
                            <th>Mã Cụm</th>
                            <th>Địa Chỉ</th>
                            <th>Số Sân Đấu</th>
                            <th>Trạng Thái</th>
                            <th class="text-end pe-3" style="width: 130px;">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody id="tblBody">
                        <tr><td colspan="7" class="text-center py-5 text-muted">Đang tải danh sách cụm sân...</td></tr>
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center py-3 mt-3 border-top">
                <div class="text-muted small" id="paginationInfo">Hiển thị 0 trên 0 cụm sân</div>
                <ul class="pagination pagination-sm mb-0" id="paginationList"></ul>
            </div>
        </div>
    </div>
</div>

<!-- Modal Thêm / Sửa Cụm Sân -->
<div class="modal fade" id="modalCumSan" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-bottom px-4 py-3">
                <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2" id="modalTitle">
                    <i class="fa-solid fa-map-location-dot text-primary"></i>
                    <span>Thêm Cụm Sân Mới</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formCumSan">
                <input type="hidden" id="cumSanId" value="">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Tên cụm sân thi đấu <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="ten" required placeholder="Nhà thi đấu Quân Khu 7">
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Mã cụm sân</label>
                        <input type="text" class="form-control text-uppercase" id="ma" placeholder="CS-QK7 (để trống tự sinh)">
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Địa chỉ cụm sân</label>
                        <input type="text" class="form-control" id="diaChi" placeholder="202 Hoàng Văn Thụ, Q. Phú Nhuận...">
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Mô tả / Ghi chú</label>
                        <textarea class="form-control" id="moTa" rows="3" placeholder="Ghi chú về cơ sở vật chất, bãi đỗ xe..."></textarea>
                    </div>

                    <div class="form-check form-switch mt-3">
                        <input class="form-check-input" type="checkbox" id="trangThai" checked>
                        <label class="form-check-label fw-semibold small" for="trangThai">Hoạt động (Sẵn sàng xếp lịch thi đấu)</label>
                    </div>
                </div>
                <div class="modal-footer border-top px-4 py-3 bg-light">
                    <button type="button" class="btn btn-secondary rounded-3 px-3" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary rounded-3 px-4" id="btnSave">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Lưu thông tin
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentPage = 1;
        const pageSize = 10;

        $(document).ready(function () {
            loadData(1);

            $('#keyword').on('keypress', function (e) {
                if (e.which === 13) loadData(1);
            });

            $('#trangThaiFilter').on('change', function () {
                loadData(1);
            });

            $('#formCumSan').on('submit', function (e) {
                e.preventDefault();
                saveData();
            });
        });

        function loadData(page) {
            currentPage = page;
            const keyword = $('#keyword').val().trim();
            const trangThai = $('#trangThaiFilter').val();

            $.ajax({
                url: '/Manager/CumSan/GetPagedData',
                type: 'GET',
                data: {
                    pageIndex: page,
                    pageSize: pageSize,
                    keyword: keyword || undefined,
                    trangThai: trangThai !== '' ? (trangThai === 'true') : undefined
                },
                success: function (res) {
                    if (res.success && res.data) {
                        renderTable(res.data);
                    }
                }
            });
        }

        function renderTable(data) {
            const items = data.items || [];
            if (items.length === 0) {
                $('#tblBody').html('<tr><td colspan="7" class="text-center py-5 text-muted">Chưa có cụm sân nào.</td></tr>');
                $('#paginationInfo').text('Hiển thị 0 trên 0 cụm sân');
                $('#paginationList').empty();
                return;
            }

            let html = '';
            const start = (data.pageIndex - 1) * data.pageSize;

            $.each(items, function (i, item) {
                const stt = start + i + 1;
                html += `
                    <tr>
                        <td class="ps-3 fw-bold text-muted">${stt}</td>
                        <td>
                            <div class="fw-bold text-dark">${escapeHtml(item.ten)}</div>
                            <small class="text-muted">${escapeHtml(item.moTa || '-')}</small>
                        </td>
                        <td><span class="badge bg-light text-secondary border font-monospace">${escapeHtml(item.ma)}</span></td>
                        <td><i class="fa-solid fa-location-dot text-danger me-1"></i><small>${escapeHtml(item.diaChi || '-')}</small></td>
                        <td>
                            <a href="/Manager/SanDau?cumSanId=${item.id}" class="badge bg-info-subtle text-info border p-2 text-decoration-none" title="Xem các sân thuộc cụm">
                                <i class="fa-solid fa-futbol me-1"></i>${item.soSanDau || 0} sân đấu
                            </a>
                        </td>
                        <td>
                            <span class="badge ${item.trangThai ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-danger-subtle text-danger border border-danger-subtle'} px-2.5 py-1 rounded-pill">
                                ${item.trangThai ? 'Hoạt động' : 'Tạm dừng'}
                            </span>
                        </td>
                        <td class="text-end pe-3">
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-light border" title="Sửa" onclick="openEditModal(${item.id})">
                                    <i class="fa-solid fa-pen-to-square text-success"></i>
                                </button>
                                <button type="button" class="btn btn-light border" title="Xóa" onclick="deleteItem(${item.id}, '${escapeHtml(item.ten)}')">
                                    <i class="fa-solid fa-trash text-danger"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            });

            $('#tblBody').html(html);

            const total = data.totalCount || 0;
            const from = total === 0 ? 0 : start + 1;
            const to = Math.min(start + data.pageSize, total);
            $('#paginationInfo').text(`Hiển thị ${from} - ${to} trên tổng số ${total} cụm sân`);

            renderPagination(data.pageIndex, data.totalPages);
        }

        function renderPagination(current, totalPages) {
            if (totalPages <= 1) {
                $('#paginationList').empty();
                return;
            }

            let pagHtml = '';
            pagHtml += `<li class="page-item ${current === 1 ? 'disabled' : ''}">
                <a class="page-link" href="javascript:void(0)" onclick="loadData(${current - 1})">&laquo;</a>
            </li>`;

            for (let i = 1; i <= totalPages; i++) {
                if (i === 1 || i === totalPages || (i >= current - 2 && i <= current + 2)) {
                    pagHtml += `<li class="page-item ${i === current ? 'active' : ''}">
                        <a class="page-link" href="javascript:void(0)" onclick="loadData(${i})">${i}</a>
                    </li>`;
                }
            }

            pagHtml += `<li class="page-item ${current === totalPages ? 'disabled' : ''}">
                <a class="page-link" href="javascript:void(0)" onclick="loadData(${current + 1})">&raquo;</a>
            </li>`;

            $('#paginationList').html(pagHtml);
        }

        function openCreateModal() {
            $('#modalTitle span').text('Thêm Cụm Sân Mới');
            $('#cumSanId').val('');
            $('#ten').val('');
            $('#ma').val('');
            $('#diaChi').val('');
            $('#moTa').val('');
            $('#trangThai').prop('checked', true);
            $('#modalCumSan').modal('show');
        }

        function openEditModal(id) {
            $.get('/Manager/CumSan/GetById', { id: id }, function (res) {
                if (res.success && res.data) {
                    const item = res.data;
                    $('#modalTitle span').text('Chỉnh Sửa Cụm Sân');
                    $('#cumSanId').val(item.id);
                    $('#ten').val(item.ten);
                    $('#ma').val(item.ma || '');
                    $('#diaChi').val(item.diaChi || '');
                    $('#moTa').val(item.moTa || '');
                    $('#trangThai').prop('checked', item.trangThai);
                    $('#modalCumSan').modal('show');
                }
            });
        }

        function saveData() {
            const id = $('#cumSanId').val();
            const ten = $('#ten').val().trim();
            if (!ten) {
                Swal.fire('Lỗi', 'Vui lòng nhập tên cụm sân.', 'warning');
                return;
            }

            const payload = {
                ten: ten,
                ma: $('#ma').val().trim() || null,
                diaChi: $('#diaChi').val().trim() || null,
                moTa: $('#moTa').val().trim() || null,
                trangThai: $('#trangThai').is(':checked')
            };

            const url = id ? `/Manager/CumSan/Save?id=${id}` : '/Manager/CumSan/Save';

            $.ajax({
                url: url,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    if (res.success) {
                        $('#modalCumSan').modal('hide');
                        SportApp.toast('success', res.message || 'Lưu cụm sân thành công!');
                        loadData(currentPage);
                    } else {
                        Swal.fire('Lỗi', res.message || 'Không thể lưu cụm sân.', 'error');
                    }
                }
            });
        }

        function deleteItem(id, name) {
            SportApp.confirm('Xóa Cụm Sân?', `Bạn có chắc muốn xóa cụm sân "${name}"? Các sân đấu thuộc cụm này cũng có thể bị ảnh hưởng.`, function () {
                $.post('/Manager/CumSan/Delete', { id: id }, function (res) {
                    if (res.success) {
                        SportApp.toast('success', res.message || 'Đã xóa cụm sân!');
                        loadData(currentPage);
                    } else {
                        Swal.fire('Lỗi', res.message || 'Không thể xóa.', 'error');
                    }
                });
            });
        }

        function resetFilter() {
            $('#keyword').val('');
            $('#trangThaiFilter').val('');
            loadData(1);
        }

        function escapeHtml(text) {
            if (!text) return '';
            return $('<div>').text(text).html();
        }
    </script>
}
