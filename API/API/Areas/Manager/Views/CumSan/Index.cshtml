@{
    ViewData["Title"] = "Cụm Sân Thi Đấu";
    Layout = "~/Areas/Manager/Views/Shared/_ManagerLayout.cshtml";
}

<div class="container-fluid p-0">
    <div class="card card-custom border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 pb-3 mb-4 border-bottom">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 bg-primary-subtle text-primary rounded-4"><i class="fa-solid fa-map-location-dot fs-4"></i></div>
                    <div>
                        <h4 class="fw-bold mb-1 text-dark">Cụm Sân Thi Đấu</h4>
                        <p class="text-muted small mb-0">Nhấn vào một cụm sân để xem các sân thuộc cụm. Manager chỉ có quyền xem.</p>
                    </div>
                </div>
            </div>

            <div class="p-3 bg-light rounded-3 mb-4 border">
                <div class="row g-2 align-items-center">
                    <div class="col-md-6">
                        <div class="input-group bg-white rounded-3 border overflow-hidden">
                            <span class="input-group-text bg-white border-0 text-muted ps-3"><i class="fa-solid fa-magnifying-glass"></i></span>
                            <input type="text" id="keyword" class="form-control border-0 shadow-none ps-2" placeholder="Tìm theo tên, mã, địa chỉ...">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <select id="trangThaiFilter" class="form-select bg-white border rounded-3 shadow-none">
                            <option value="">-- Tất cả trạng thái --</option>
                            <option value="true">Đang hoạt động</option>
                            <option value="false">Tạm dừng</option>
                        </select>
                    </div>
                    <div class="col-md-1"><button type="button" class="btn btn-dark w-100 rounded-3" onclick="loadData(1)"><i class="fa-solid fa-filter"></i></button></div>
                    <div class="col-md-2"><button type="button" class="btn btn-outline-secondary w-100 rounded-3" onclick="resetFilter()"><i class="fa-solid fa-arrows-rotate me-1"></i>Làm mới</button></div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase fs-7 text-muted">
                        <tr>
                            <th class="ps-3" style="width:50px">STT</th>
                            <th>Tên Cụm Sân</th>
                            <th>Mã Cụm</th>
                            <th>Đơn vị sở hữu</th>
                            <th>Địa chỉ</th>
                            <th>Số sân</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody id="tblBody"><tr><td colspan="7" class="text-center py-5 text-muted">Đang tải...</td></tr></tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-center py-3 mt-3 border-top">
                <div class="text-muted small" id="paginationInfo">Hiển thị 0 trên 0 cụm sân</div>
                <ul class="pagination pagination-sm mb-0" id="paginationList"></ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let currentPage = 1;
    const pageSize = 10;

    $(function () {
        loadData(1);
        $('#keyword').on('keypress', e => { if (e.which === 13) loadData(1); });
        $('#trangThaiFilter').on('change', () => loadData(1));
        $('#tblBody').on('click', '[data-action="toggle-courts"]', function () {
            toggleCourts($(this).data('cum-san-id'));
        });
    });

    function loadData(page) {
        currentPage = page;
        $.get('/Manager/CumSan/GetPagedData', {
            pageIndex: page,
            pageSize: pageSize,
            keyword: $('#keyword').val().trim() || undefined,
            trangThai: $('#trangThaiFilter').val() === '' ? undefined : $('#trangThaiFilter').val() === 'true'
        }, function (res) {
            if (res.success && res.data) renderTable(res.data);
        });
    }

    function renderTable(data) {
        const items = data.items || [];
        if (!items.length) {
            $('#tblBody').html('<tr><td colspan="7" class="text-center py-5 text-muted">Chưa có cụm sân nào.</td></tr>');
            $('#paginationInfo').text('Hiển thị 0 trên 0 cụm sân');
            $('#paginationList').empty();
            return;
        }

        const start = (data.pageIndex - 1) * data.pageSize;
        $('#tblBody').html(items.map((item, index) => `
            <tr class="cum-san-row">
                <td class="ps-3 fw-bold text-muted">${start + index + 1}</td>
                <td>
                    <button type="button" class="btn btn-link p-0 text-decoration-none text-start" data-action="toggle-courts" data-cum-san-id="${item.id}">
                        <i class="fa-solid fa-chevron-right text-primary me-2 court-toggle-icon"></i><span class="fw-bold text-dark">${escapeHtml(item.ten)}</span>
                    </button>
                    <small class="d-block text-muted ms-4">${escapeHtml(item.moTa || '-')}</small>
                </td>
                <td><span class="badge bg-light text-secondary border font-monospace">${escapeHtml(item.ma)}</span></td>
                <td><span class="badge bg-primary-subtle text-primary border">${escapeHtml(item.tenDonVi || 'Chưa gán')}</span></td>
                <td><small><i class="fa-solid fa-location-dot text-danger me-1"></i>${escapeHtml(item.diaChi || '-')}</small></td>
                <td><button type="button" class="btn btn-sm btn-info-subtle text-info border p-2" data-action="toggle-courts" data-cum-san-id="${item.id}">${item.soSanHienCo || 0} sân</button></td>
                <td><span class="badge ${item.trangThai ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-danger-subtle text-danger border border-danger-subtle'} rounded-pill">${item.trangThai ? 'Hoạt động' : 'Tạm dừng'}</span></td>
            </tr>`).join(''));

        const total = data.totalCount || 0;
        $('#paginationInfo').text(`Hiển thị ${start + 1} - ${Math.min(start + data.pageSize, total)} trên tổng số ${total} cụm sân`);
        renderPagination(data.pageIndex, data.totalPages);
    }

    function toggleCourts(cumSanId) {
        const detailId = `courts-${cumSanId}`;
        const detailRow = $(`#${detailId}`);
        if (detailRow.length) {
            detailRow.remove();
            updateToggleIcon(cumSanId, false);
            return;
        }

        const parentRow = $(`[data-cum-san-id="${cumSanId}"]`).first().closest('tr');
        parentRow.after(`<tr id="${detailId}" class="court-detail-row"><td colspan="7" class="bg-light p-3"><div class="text-center text-muted py-3"><i class="fa-solid fa-spinner fa-spin me-2"></i>Đang tải danh sách sân...</div></td></tr>`);
        updateToggleIcon(cumSanId, true);

        $.get('/Manager/CumSan/GetCourts', { cumSanId }, function (res) {
            if (res.success && res.data) renderCourtDetails(cumSanId, res.data.items || []);
            else $(`#${detailId} td`).html(`<div class="text-center text-danger py-3">${escapeHtml(res.message || 'Không thể tải danh sách sân.')}</div>`);
        }).fail(function () {
            $(`#${detailId} td`).html('<div class="text-center text-danger py-3">Không thể tải danh sách sân.</div>');
        });
    }

    function renderCourtDetails(cumSanId, items) {
        const detailCell = $(`#courts-${cumSanId} td`);
        if (!items.length) {
            detailCell.html('<div class="text-muted py-2"><i class="fa-solid fa-circle-info me-2"></i>Cụm sân này chưa có sân đấu.</div>');
            return;
        }

        const rows = items.map((item, index) => `
            <tr>
                <td>${index + 1}</td>
                <td><span class="fw-semibold">${escapeHtml(item.ten)}</span><small class="d-block text-muted">${escapeHtml(item.loaiSan || '-')}</small></td>
                <td><span class="badge bg-white text-secondary border font-monospace">${escapeHtml(item.ma)}</span></td>
                <td>${escapeHtml(item.tenMonTheThao || 'Đa năng')}</td>
                <td>${item.sucChua ? `${item.sucChua} người` : '-'}</td>
                <td><span class="badge ${item.trangThai ? 'bg-success-subtle text-success' : 'bg-danger-subtle text-danger'} rounded-pill">${item.trangThai ? 'Hoạt động' : 'Tạm dừng'}</span></td>
            </tr>`).join('');

        detailCell.html(`
            <div class="bg-white border rounded-3 p-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-semibold text-primary"><i class="fa-solid fa-futbol me-2"></i>Các sân thuộc cụm</span>
                    <span class="small text-muted">${items.length} sân</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead><tr><th>STT</th><th>Tên sân</th><th>Mã sân</th><th>Môn chuyên dụng</th><th>Sức chứa</th><th>Trạng thái</th></tr></thead>
                        <tbody>${rows}</tbody>
                    </table>
                </div>
            </div>`);
    }

    function updateToggleIcon(cumSanId, expanded) {
        $(`[data-cum-san-id="${cumSanId}"]`).find('.court-toggle-icon').toggleClass('fa-chevron-right', !expanded).toggleClass('fa-chevron-down', expanded);
    }

    function renderPagination(current, totalPages) {
        if (totalPages <= 1) { $('#paginationList').empty(); return; }
        let html = `<li class="page-item ${current === 1 ? 'disabled' : ''}"><a class="page-link" href="javascript:void(0)" onclick="loadData(${current - 1})">&laquo;</a></li>`;
        for (let i = 1; i <= totalPages; i++) {
            if (i === 1 || i === totalPages || (i >= current - 2 && i <= current + 2)) html += `<li class="page-item ${i === current ? 'active' : ''}"><a class="page-link" href="javascript:void(0)" onclick="loadData(${i})">${i}</a></li>`;
        }
        html += `<li class="page-item ${current === totalPages ? 'disabled' : ''}"><a class="page-link" href="javascript:void(0)" onclick="loadData(${current + 1})">&raquo;</a></li>`;
        $('#paginationList').html(html);
    }

    function resetFilter() { $('#keyword').val(''); $('#trangThaiFilter').val(''); loadData(1); }
    function escapeHtml(value) { return $('<div>').text(value ?? '').html(); }
</script>
}
