@using Dms.Application.Common
@{
    Layout = "_Layout";
    ViewData["Title"] = "Không Có Quyền Truy Cập (403)";
    var returnUrl = Context.Request.Query["ReturnUrl"].ToString();
    var currentUsername = User.Identity?.Name ?? "Chưa xác định";
    var isManager = User.IsInRole(AppRoles.Manager);
    var isAdmin = User.IsInRole(AppRoles.Admin);
    var isHeadReferee = User.IsInRole(AppRoles.HeadReferee);
    var isReferee = User.IsInRole(AppRoles.Referee);
}

<div class="row justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="col-md-7 col-lg-6">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden text-center p-4 p-md-5 bg-white">
            <div class="mb-3">
                <div class="d-inline-flex align-items-center justify-content-center bg-danger-subtle text-danger rounded-circle shadow-sm" style="width: 80px; height: 80px;">
                    <i class="fa-solid fa-shield-halved fa-3x"></i>
                </div>
            </div>

            <h3 class="fw-bold text-dark mb-2">403 - Quyền Truy Cập Bị Từ Chối</h3>
            <p class="text-muted small mb-3">Tài khoản chưa được phép truy cập đường dẫn này hoặc chưa được cấp phạm vi phù hợp.</p>

            <div class="alert alert-warning py-3 px-3 small rounded-3 my-2 text-start border-0 bg-warning-subtle">
                <div class="fw-semibold text-dark mb-1">
                    <i class="fa-solid fa-circle-info text-warning me-1"></i> Thông tin phiên đăng nhập hiện tại:
                </div>
                <div class="mt-1">
                    • Tài khoản đang đăng nhập: <strong class="text-primary">@currentUsername</strong>
                </div>
                <div class="mt-1">
                    • Vai trò: 
                    @if (isAdmin)
                    {
                        <span class="badge bg-danger text-white me-1">Quản Trị Viên (Admin)</span>
                    }
                    @if (isManager)
                    {
                        <span class="badge bg-primary text-white me-1">Quản Lý Giải (Manager)</span>
                    }
                    @if (isHeadReferee)
                    {
                        <span class="badge bg-warning text-dark me-1">Trưởng Ban Trọng Tài</span>
                    }
                    @if (isReferee)
                    {
                        <span class="badge bg-info text-dark me-1">Trọng Tài</span>
                    }
                    @if (!isAdmin && !isManager && !isHeadReferee && !isReferee)
                    {
                        <span class="badge bg-secondary text-white">Chưa cấp role phù hợp</span>
                    }
                </div>
                @if (!string.IsNullOrEmpty(returnUrl))
                {
                    <div class="mt-2 text-muted">
                        • Đường dẫn cố gắng truy cập: <code class="text-danger">@returnUrl</code>
                        @if (returnUrl.StartsWith("/Admin", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="text-danger fw-semibold d-block mt-1">
                                <i class="fa-solid fa-triangle-exclamation me-1"></i>Phân vùng này dành riêng cho tài khoản Quản trị hệ thống (Admin)!
                            </span>
                        }
                    </div>
                }
            </div>

            <div class="d-flex flex-column gap-2 mt-4">
                @if (isAdmin)
                {
                    <a href="/Admin/GiaiDau" class="btn btn-primary py-2 fw-semibold shadow-sm">
                        <i class="fa-solid fa-sliders me-2"></i> Đến Trang Quản Trị Hệ Thống
                    </a>
                }
                @if (isManager)
                {
                    <a href="/Manager/GiaiDau" class="btn btn-primary py-2 fw-semibold shadow-sm">
                        <i class="fa-solid fa-trophy me-2"></i> Đến Trang Quản Lý Giải
                    </a>
                }
                @if (isHeadReferee)
                {
                    <a href="/TruongBanTrongTai/Home" class="btn btn-warning py-2 fw-semibold shadow-sm">
                        <i class="fa-solid fa-whistle me-2"></i> Vào cổng Trưởng Ban Trọng Tài
                    </a>
                }
                @if (isReferee)
                {
                    <a href="/TrongTai/Home" class="btn btn-info py-2 fw-semibold shadow-sm">
                        <i class="fa-solid fa-clipboard-check me-2"></i> Vào cổng Trọng Tài
                    </a>
                }

                <a href="/Account/Logout" class="btn btn-outline-danger py-2 fw-semibold">
                    <i class="fa-solid fa-arrow-right-from-bracket me-2"></i> Đăng Xuất Để Đổi Tài Khoản Admin
                </a>
            </div>

            @if (!isAdmin && !isManager && !isHeadReferee && !isReferee)
            {
                <div class="border-top pt-3 mt-4 text-muted small">
                    Vui lòng liên hệ quản trị viên để được cấp vai trò phù hợp.
                </div>
            }
        </div>
    </div>
</div>
