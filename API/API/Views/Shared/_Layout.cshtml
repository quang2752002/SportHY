@using Dms.Application.Common
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SPORT DMS | Cổng Thông Tin Đại Hội & Giải Đấu Thể Thao</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS & FontAwesome & Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <!-- SweetAlert2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet" />

    <style>
        :root {
            --portal-primary: #0284c7;
            --portal-navy: #0f172a;
            --portal-dark: #1e293b;
            --portal-accent: #f59e0b;
            --portal-orange: #ea580c;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8fafc;
            color: #334155;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Navbar */
        .portal-navbar {
            background: rgba(255, 255, 255, 0.96);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(226, 232, 240, 0.8);
            position: sticky;
            top: 0;
            z-index: 1050;
            transition: all 0.3s ease;
        }

        .portal-logo {
            font-weight: 800;
            font-size: 1.25rem;
            color: var(--portal-navy);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .portal-logo-badge {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            font-size: 1.1rem;
            box-shadow: 0 4px 10px rgba(2, 132, 199, 0.3);
        }

        .portal-nav-link {
            font-weight: 600;
            font-size: 0.92rem;
            color: #475569;
            padding: 8px 16px;
            border-radius: 8px;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .portal-nav-link:hover {
            color: var(--portal-primary);
            background: #f1f5f9;
        }

        /* Footer */
        .portal-footer {
            background-color: var(--portal-navy);
            color: #94a3b8;
            margin-top: auto;
            border-top: 1px solid #334155;
        }

        .portal-footer a {
            color: #cbd5e1;
            text-decoration: none;
            transition: color 0.2s;
        }

        .portal-footer a:hover {
            color: #38bdf8;
        }

        .hover-lift {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .hover-lift:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 24px -10px rgba(0, 0, 0, 0.15) !important;
        }

        /* Search input style */
        .search-box-wrap {
            position: relative;
        }
        .search-box-input {
            border-radius: 0.6rem;
            border: 1px solid #e2e8f0;
            padding-left: 2.4rem;
            font-size: 0.875rem;
            background-color: #ffffff;
            height: 40px;
        }
        .search-box-input:focus {
            border-color: #f97316;
            box-shadow: 0 0 0 0.2rem rgba(249, 115, 22, 0.15);
            outline: none;
        }
        .search-icon-pos {
            position: absolute;
            left: 0.85rem;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            pointer-events: none;
        }

        /* Custom Nav Links (Desktop) */
        .nav-link-custom {
            font-weight: 600;
            font-size: 0.88rem;
            color: #475569;
            padding: 7px 13px;
            border-radius: 8px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s ease;
        }
        .nav-link-custom:hover {
            color: #ea580c;
            background: #fff7ed;
        }
        .nav-link-custom.active {
            color: #ea580c;
            background: #fff7ed;
            font-weight: 700;
        }
        .nav-link-custom i {
            font-size: 1rem;
        }

        /* Mobile Bottom Navigation Bar */
        .mobile-bottom-nav {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            height: 64px;
            background: #ffffff;
            border-top: 1px solid #e2e8f0;
            box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.06);
            display: flex;
            align-items: center;
            justify-content: space-around;
            z-index: 1040;
            padding-bottom: env(safe-area-inset-bottom, 0);
        }
        .mobile-bottom-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            flex: 1;
            height: 100%;
            text-decoration: none;
            color: #64748b;
            font-size: 0.72rem;
            font-weight: 600;
            gap: 3px;
            transition: all 0.15s ease;
            background: none;
            border: none;
            padding: 0;
            cursor: pointer;
        }
        .mobile-bottom-item i {
            font-size: 1.25rem;
            line-height: 1;
            transition: transform 0.15s ease, color 0.15s ease;
        }
        .mobile-bottom-item:hover,
        .mobile-bottom-item.active {
            color: #ea580c;
        }
        .mobile-bottom-item.active i {
            transform: scale(1.08);
            color: #ea580c;
        }

        /* Mobile adjustments */
        @@media (max-width: 767.98px) {
            body {
                padding-bottom: 70px;
            }
            .portal-footer {
                margin-bottom: 64px;
            }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @{
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
        var currentPath = Context.Request.Path.Value ?? "";
        bool isLichThiDau = currentAction.Equals("LichThiDau", StringComparison.OrdinalIgnoreCase) || currentPath.Contains("LichThiDau");
        bool isBangXepHang = currentAction.Equals("BangXepHang", StringComparison.OrdinalIgnoreCase) || currentPath.Contains("BangXepHang");
        bool isHomeIndex = currentAction.Equals("Index", StringComparison.OrdinalIgnoreCase) && !isLichThiDau && !isBangXepHang;
    }

    <!-- Top Navbar -->
    <nav class="portal-navbar shadow-sm py-2">
        <div class="container-fluid px-lg-4 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <a href="/" class="portal-logo d-flex align-items-center text-decoration-none">
                    <div class="rounded-circle d-flex align-items-center justify-content-center shadow-sm overflow-hidden"
                         style="width: 44px; height: 44px; background: radial-gradient(circle, #f97316 0%, #1e3a8a 100%); border: 2px solid #ea580c;">
                        <span class="text-white fw-bold" style="font-size: 10px; text-align: center; line-height: 1.1;">
                            SPORT<br />DMS
                        </span>
                    </div>
                    <div class="ms-2 d-none d-sm-block">
                        <div class="fw-bold text-dark lh-1" style="font-size: 1.1rem;">SPORT <span style="color: #ea580c;">DMS</span></div>
                        <div class="text-muted" style="font-size: 0.65rem; letter-spacing: 0.5px;">CỔNG THÔNG TIN THỂ THAO</div>
                    </div>
                </a>

                <!-- Desktop Menu Navigation Links -->
                <nav class="d-none d-md-flex align-items-center gap-1 ms-2">
                    <a href="/" class="nav-link-custom @(isHomeIndex ? "active" : "")">
                        <i class="bi bi-trophy"></i>
                        <span>Giải đấu</span>
                    </a>
                    <a href="/BangXepHang" class="nav-link-custom @(isBangXepHang ? "active" : "")">
                        <i class="bi bi-award-fill text-warning"></i>
                        <span>BXH Huy chương</span>
                    </a>
                    <a href="/LichThiDau" class="nav-link-custom @(isLichThiDau ? "active" : "")">
                        <i class="bi bi-calendar3"></i>
                        <span>Lịch & Bảng đấu</span>
                    </a>
                    <a href="/Home#diem-trinh" class="nav-link-custom">
                        <i class="bi bi-people"></i>
                        <span>Điểm trình</span>
                    </a>
                    <a href="/Home#clb" class="nav-link-custom">
                        <i class="bi bi-buildings"></i>
                        <span>Câu lạc bộ</span>
                    </a>
                    <a href="/Home#livestream" class="nav-link-custom">
                        <i class="bi bi-broadcast"></i>
                        <span>Xem trực tiếp</span>
                    </a>
                </nav>
            </div>

            <!-- User Auth Bar -->
            <div class="d-flex align-items-center gap-2">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    var isManager = User.IsInRole(AppRoles.Manager);
                    var isAdmin = User.IsInRole(AppRoles.Admin);
                    var isDelegation = User.IsInRole(AppRoles.Delegation);
                    var isSecretary = User.IsInRole(AppRoles.Secretary);
                    var isReferee = User.IsInRole(AppRoles.Referee);
                    var isHeadReferee = User.IsInRole(AppRoles.HeadReferee);
                    var isSportCoordinator = User.IsInRole(AppRoles.SportCoordinator);

                    <div class="dropdown">
                        <button class="btn btn-sm btn-light border dropdown-toggle d-flex align-items-center gap-2 py-1 px-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width: 28px; height: 28px; font-size: 0.8rem;">
                                <i class="fa-solid fa-user"></i>
                            </div>
                            <span class="fw-semibold text-dark small">@User.Identity.Name</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                            <li class="px-3 py-2 border-bottom">
                                <div class="small text-muted">Đang đăng nhập:</div>
                                <div class="fw-bold text-dark">@User.Identity.Name</div>
                                @if (isDelegation)
                                {
                                    <span class="badge bg-success text-white mt-1">Đoàn Thi Đấu</span>
                                }
                                else if (isManager)
                                {
                                    <span class="badge bg-warning text-dark mt-1">Quản Lý Giải</span>
                                }
                                else if (isAdmin)
                                {
                                    <span class="badge bg-danger text-white mt-1">Quản Trị Viên</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary text-white mt-1">Thành viên</span>
                                }
                            </li>
                            @if (isHeadReferee || isManager || isAdmin)
                            {
                                <li>
                                    <a class="dropdown-item py-2" href="/TruongBanTrongTai/Home">
                                        <i class="fa-solid fa-whistle text-warning me-2"></i> Cổng Trưởng Ban Trọng Tài
                                    </a>
                                </li>
                            }
                            @if (isSportCoordinator || isManager || isAdmin)
                            {
                                <li>
                                    <a class="dropdown-item py-2" href="/DieuHanhMon/Home">
                                        <i class="fa-solid fa-volleyball text-info me-2"></i> Cổng Điều Hành Môn
                                    </a>
                                </li>
                            }
                            @if (isSecretary || isManager || isAdmin)
                            {
                                <li>
                                    <a class="dropdown-item py-2" href="/ThuKy/Home">
                                        <i class="fa-solid fa-clipboard-check text-primary me-2"></i> Cổng Thư Ký Giải
                                    </a>
                                </li>
                            }
                            @if (isReferee)
                            {
                                <li>
                                    <a class="dropdown-item py-2" href="/TrongTai/Home">
                                        <i class="fa-solid fa-flag text-warning me-2"></i> Cổng Trọng Tài
                                    </a>
                                </li>
                            }
                            @if (isDelegation)
                            {
                                <li>
                                    <a class="dropdown-item py-2" href="/DonVi/Home">
                                        <i class="fa-solid fa-building-columns text-success me-2"></i> Cổng Quản Lý Đoàn
                                    </a>
                                </li>
                            }
                            @if (isManager)
                            {
                                <li>
                                    <a class="dropdown-item py-2" href="/Manager/GiaiDau">
                                        <i class="fa-solid fa-trophy text-warning me-2"></i> Bảng Quản Lý Giải
                                    </a>
                                </li>
                            }
                            @if (isAdmin)
                            {
                                <li>
                                    <a class="dropdown-item py-2" href="/Admin/GiaiDau">
                                        <i class="fa-solid fa-sliders text-primary me-2"></i> Bảng Quản Trị Hệ Thống
                                    </a>
                                </li>
                            }
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item py-2 text-danger" href="/Account/Logout">
                                    <i class="fa-solid fa-arrow-right-from-bracket me-2"></i> Đăng Xuất
                                </a>
                            </li>
                        </ul>
                    </div>

                    @if (isReferee)
                    {
                        <a href="/TrongTai/Home" class="btn btn-warning btn-sm fw-bold shadow-sm d-none d-sm-inline-flex align-items-center text-dark">
                            <i class="fa-solid fa-flag me-1"></i> Cổng Trọng Tài
                        </a>
                    }
                    else if (isDelegation)
                    {
                        <a href="/DonVi/Home" class="btn btn-success btn-sm fw-bold shadow-sm d-none d-sm-inline-flex align-items-center">
                            <i class="fa-solid fa-building-columns me-1"></i> Cổng Đoàn
                        </a>
                    }
                    else if (isManager)
                    {
                        <a href="/Manager/GiaiDau" class="btn btn-warning btn-sm fw-bold shadow-sm d-none d-sm-inline-flex align-items-center">
                            <i class="fa-solid fa-trophy me-1"></i> Quản Lý Giải
                        </a>
                    }
                    else if (isAdmin)
                    {
                        <a href="/Admin/GiaiDau" class="btn btn-primary btn-sm fw-bold shadow-sm d-none d-sm-inline-flex align-items-center">
                            <i class="fa-solid fa-sliders me-1"></i> Trang Admin
                        </a>
                    }
                }
                else
                {
                    <a href="/Account/Register" class="btn btn-sm btn-outline-secondary rounded-3 px-2.5 py-1.5 fw-semibold d-flex align-items-center gap-1 shadow-sm text-dark bg-white" style="font-size: 0.85rem; border-color: #d1d5db;">
                        <i class="bi bi-person-plus"></i>
                        <span>Đăng ký</span>
                    </a>
                    <a href="/Account/Login" class="btn btn-sm rounded-3 px-3 py-1.5 fw-semibold text-white d-flex align-items-center gap-1 shadow-sm" style="background-color: #ea580c; border-color: #ea580c; font-size: 0.85rem;">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <span>Đăng nhập</span>
                    </a>
                }
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main role="main" class="container py-3 py-md-4 flex-grow-1">
        @RenderBody()
    </main>

    <!-- Mobile Bottom Navigation Bar -->
    <nav class="mobile-bottom-nav d-md-none">
        <a href="/" class="mobile-bottom-item @(isHomeIndex ? "active" : "")">
            <i class="bi bi-trophy"></i>
            <span>Giải đấu</span>
        </a>
        <a href="/BangXepHang" class="mobile-bottom-item @(isBangXepHang ? "active" : "")">
            <i class="bi bi-award"></i>
            <span>BXH</span>
        </a>
        <a href="/LichThiDau" class="mobile-bottom-item @(isLichThiDau ? "active" : "")">
            <i class="bi bi-calendar3"></i>
            <span>Lịch & Bảng</span>
        </a>
        <button type="button" class="mobile-bottom-item" data-bs-toggle="offcanvas" data-bs-target="#mobileMoreMenu" aria-controls="mobileMoreMenu">
            <i class="bi bi-three-dots"></i>
            <span>Thêm</span>
        </button>
    </nav>

    <!-- Offcanvas Thêm (Khi bấm nút 'Thêm' trên mobile) -->
    <div class="offcanvas offcanvas-bottom rounded-top-4" tabindex="-1" id="mobileMoreMenu" style="height: auto; max-height: 80vh;">
        <div class="offcanvas-header border-bottom py-3">
            <h6 class="offcanvas-title fw-bold text-dark d-flex align-items-center gap-2">
                <i class="bi bi-grid-fill text-warning" style="color: #ea580c !important;"></i>
                <span>Menu chức năng</span>
            </h6>
            <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body p-3">
            <div class="row g-2 text-center">
                <div class="col-4">
                    <a href="/BangXepHang" class="d-flex flex-column align-items-center p-2.5 rounded-3 text-decoration-none text-dark bg-light border">
                        <div class="rounded-circle bg-warning bg-opacity-10 text-warning p-2 mb-1" style="width: 42px; height: 42px; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-award fs-5" style="color: #f59e0b !important;"></i>
                        </div>
                        <span class="small fw-semibold">BXH Huy chương</span>
                    </a>
                </div>
                <div class="col-4">
                    <a href="/LichThiDau" class="d-flex flex-column align-items-center p-2.5 rounded-3 text-decoration-none text-dark bg-light border">
                        <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-2 mb-1" style="width: 42px; height: 42px; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-calendar3 fs-5"></i>
                        </div>
                        <span class="small fw-semibold">Lịch & Bảng đấu</span>
                    </a>
                </div>
                <div class="col-4">
                    <a href="/Home#livestream" class="d-flex flex-column align-items-center p-2.5 rounded-3 text-decoration-none text-dark bg-light border">
                        <div class="rounded-circle bg-danger bg-opacity-10 text-danger p-2 mb-1" style="width: 42px; height: 42px; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-broadcast fs-5"></i>
                        </div>
                        <span class="small fw-semibold">Xem trực tiếp</span>
                    </a>
                </div>
                <div class="col-4">
                    <a href="/Manager/BangDau" class="d-flex flex-column align-items-center p-2.5 rounded-3 text-decoration-none text-dark bg-light border">
                        <div class="rounded-circle bg-info bg-opacity-10 text-info p-2 mb-1" style="width: 42px; height: 42px; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-diagram-3 fs-5"></i>
                        </div>
                        <span class="small fw-semibold">Bảng đấu</span>
                    </a>
                </div>
                <div class="col-4">
                    <a href="/Account/Login" class="d-flex flex-column align-items-center p-2.5 rounded-3 text-decoration-none text-dark bg-light border">
                        <div class="rounded-circle bg-warning bg-opacity-10 text-warning p-2 mb-1" style="width: 42px; height: 42px; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-box-arrow-in-right fs-5" style="color: #ea580c !important;"></i>
                        </div>
                        <span class="small fw-semibold">Đăng nhập</span>
                    </a>
                </div>
                <div class="col-4">
                    <a href="/Account/Register" class="d-flex flex-column align-items-center p-2.5 rounded-3 text-decoration-none text-dark bg-light border">
                        <div class="rounded-circle bg-success bg-opacity-10 text-success p-2 mb-1" style="width: 42px; height: 42px; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-person-plus fs-5"></i>
                        </div>
                        <span class="small fw-semibold">Đăng ký</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Public Footer -->
    <footer class="portal-footer py-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-5">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="portal-logo-badge" style="width: 32px; height: 32px; font-size: 0.9rem;">
                            <i class="fa-solid fa-trophy"></i>
                        </div>
                        <span class="text-white fw-bold fs-5">SPORT DMS</span>
                    </div>
                    <p class="small text-muted mb-3" style="max-width: 400px;">
                        Hệ thống phần mềm quản lý, điều hành và tổ chức các đại hội thể thao, giải đấu thể dục thể thao chuyên nghiệp và phong trào toàn diện.
                    </p>
                    <div class="d-flex gap-3 text-white-50">
                        <a href="#" class="fs-5"><i class="fa-brands fa-facebook"></i></a>
                        <a href="#" class="fs-5"><i class="fa-brands fa-youtube"></i></a>
                        <a href="#" class="fs-5"><i class="fa-solid fa-globe"></i></a>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <h6 class="text-white fw-bold mb-3">Liên Kết Nhanh</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2 mb-0">
                        <li><a href="/"><i class="fa-solid fa-chevron-right me-1 text-primary" style="font-size: 0.7rem;"></i> Danh Sách Giải Đấu</a></li>
                        <li><a href="/BangXepHang"><i class="fa-solid fa-chevron-right me-1 text-primary" style="font-size: 0.7rem;"></i> Bảng Xếp Hạng Huy Chương</a></li>
                        <li><a href="/LichThiDau"><i class="fa-solid fa-chevron-right me-1 text-primary" style="font-size: 0.7rem;"></i> Lịch Thi Đấu & Bảng Đấu</a></li>
                        <li><a href="/Account/Login"><i class="fa-solid fa-chevron-right me-1 text-primary" style="font-size: 0.7rem;"></i> Đăng Nhập Ban Tổ Chức</a></li>
                    </ul>
                </div>
                <div class="col-sm-6 col-lg-4">
                    <h6 class="text-white fw-bold mb-3">Hỗ Trợ & Liên Hệ</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2 mb-0 text-muted">
                        <li><i class="fa-solid fa-location-dot me-2 text-primary"></i> Sở Văn Hóa & Thể Thao TP.HCM</li>
                        <li><i class="fa-solid fa-phone me-2 text-primary"></i> Hotline: (028) 3822 5588 - 0909 123 456</li>
