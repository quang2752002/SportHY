@{
    ViewData["Title"] = "Cổng Thông Tin Giải Đấu Thể Thao";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="py-3 py-md-4">
    <div class="container-fluid px-lg-4">
        <!-- 1. Box Header: Thanh Điều Hướng & Tìm kiếm (Đồng bộ theo bản React) -->
        <div class="bg-white rounded-4 border p-3 p-md-4 shadow-sm mb-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <!-- Tiêu đề & Bộ Tab trạng thái -->
                <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-3">
                    <h4 class="fw-bold mb-0 text-dark me-2">Giải đấu</h4>

                    <div class="d-flex align-items-center gap-2 flex-wrap" id="statusPillsGroup">
                        <!-- Tab Tất cả -->
                        <button type="button" class="status-pill-btn active-orange" data-tab="tatCa" onclick="switchTab('tatCa')">
                            <i class="bi bi-grid"></i>
                            <span>Tất cả</span>
                            <span class="badge-pill-count" id="countTatCa">0</span>
                        </button>

                        <!-- Tab Sắp diễn ra -->
                        <button type="button" class="status-pill-btn" data-tab="sapDienRa" onclick="switchTab('sapDienRa')">
                            <i class="bi bi-calendar-event"></i>
                            <span>Sắp diễn ra</span>
                            <span class="badge-pill-count" id="countSapDienRa">0</span>
                        </button>

                        <!-- Tab Đang diễn ra -->
                        <button type="button" class="status-pill-btn" data-tab="dangDienRa" onclick="switchTab('dangDienRa')">
                            <i class="bi bi-trophy"></i>
                            <span>Đang diễn ra</span>
                            <span class="badge-pill-count" id="countDangDienRa">0</span>
                        </button>

                        <!-- Tab Đã kết thúc -->
                        <button type="button" class="status-pill-btn" data-tab="daKetThuc" onclick="switchTab('daKetThuc')">
                            <i class="bi bi-check2-circle"></i>
                            <span>Đã kết thúc</span>
                            <span class="badge-pill-count" id="countDaKetThuc">0</span>
                        </button>
                    </div>
                </div>

                <!-- Ô Tìm Kiếm & Nút Tải lại -->
                <div class="d-flex align-items-center gap-2">
                    <div class="search-box-wrap flex-grow-1 flex-md-grow-0" style="min-width: 220px;">
                        <i class="bi bi-search search-icon-pos"></i>
                        <input type="text"
                               class="form-control search-box-input"
                               placeholder="Tìm giải đấu..."
                               id="searchBoxInput"
                               oninput="handleSearchInput(this.value)">
                    </div>
                    <button type="button"
                            class="btn btn-outline-secondary border d-flex align-items-center justify-content-center"
                            style="width: 40px; height: 40px; border-radius: 0.6rem;"
                            onclick="loadTournaments()"
                            title="Tải lại danh sách">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- 2. Loading State -->
        <div class="text-center py-5" id="loadingState">
            <div class="spinner-border text-warning" role="status" style="color: #ea580c !important;">
                <span class="visually-hidden">Đang tải...</span>
            </div>
            <p class="text-muted mt-2 small">Đang tải danh sách giải đấu...</p>
        </div>

        <!-- 3. Empty State (Không có giải đấu phù hợp) -->
        <div class="bg-white rounded-4 border p-5 text-center shadow-sm d-none" id="emptyState">
            <i class="bi bi-calendar-x text-muted" style="font-size: 3rem;"></i>
            <h5 class="fw-bold mt-3 text-secondary">Không có giải đấu nào phù hợp</h5>
            <p class="text-muted small">Hãy thử tìm kiếm với từ khóa khác hoặc chuyển sang tab trạng thái khác.</p>
            <button type="button"
                    class="btn btn-outline-warning rounded-pill px-3"
                    style="border-color: #ea580c; color: #ea580c;"
                    onclick="resetSearchAndTab()">
                Xem tất cả giải đấu
            </button>
        </div>

        <!-- 4. Danh sách Tournament Cards -->
        <div class="d-flex flex-column gap-4" id="tournamentContainer">
            <!-- Render động bằng AJAX Javascript tương tự Component TournamentCard của React -->
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // State management tương tự React Home Component
        let allTournaments = [];
        let activeTab = 'tatCa'; // 'tatCa' | 'sapDienRa' | 'dangDienRa' | 'daKetThuc'
        let searchQuery = '';
        const sportPageMap = {}; // Lưu trang môn thi đấu theo từng tournament id

        $(document).ready(function () {
            loadTournaments();
        });

        // Tải danh sách giải đấu từ API
        function loadTournaments() {
            $('#loadingState').removeClass('d-none');
            $('#emptyState').addClass('d-none');
            $('#tournamentContainer').empty();

            $.ajax({
                url: '/Home/GetTournaments',
                type: 'GET',
                dataType: 'json',
                success: function (res) {
                    $('#loadingState').addClass('d-none');
                    if (res && res.success && Array.isArray(res.data)) {
                        allTournaments = res.data;
                    } else if (Array.isArray(res)) {
                        allTournaments = res;
                    } else {
                        allTournaments = [];
                    }
                    updateCounts();
                    renderList();
                },
                error: function (xhr, status, error) {
                    $('#loadingState').addClass('d-none');
                    console.warn('Không thể tải dữ liệu giải đấu từ API:', error);
                    allTournaments = [];
                    updateCounts();
                    renderList();
                }
            });
        }

        // Tính số lượng badge cho từng tab
        function updateCounts() {
            let sapDienRaCount = 0;
            let dangDienRaCount = 0;
            let daKetThucCount = 0;

            allTournaments.forEach(function (t) {
                const tt = (t.trangThai || '').toString();
                const ttText = (t.trangThaiText || '').toLowerCase();

                if (tt === 'DangDienRa' || tt === '3' || ttText.includes('đang')) {
                    dangDienRaCount++;
                } else if (tt === 'KetThuc' || tt === '4' || ttText.includes('kết thúc')) {
                    daKetThucCount++;
                } else {
                    sapDienRaCount++; // Bao gồm SapDienRa=2, Nhap=1
                }
            });

            $('#countTatCa').text(allTournaments.length);
            $('#countSapDienRa').text(sapDienRaCount);
            $('#countDangDienRa').text(dangDienRaCount);
            $('#countDaKetThuc').text(daKetThucCount);
        }

        // Chuyển tab trạng thái
        function switchTab(tab) {
            activeTab = tab;
            $('#statusPillsGroup .status-pill-btn').removeClass('active-orange');
            $(`#statusPillsGroup .status-pill-btn[data-tab="${tab}"]`).addClass('active-orange');
            renderList();
        }

        // Tìm kiếm theo từ khóa
        function handleSearchInput(val) {
            searchQuery = (val || '').trim().toLowerCase();
            renderList();
        }

        // Reset bộ lọc
        function resetSearchAndTab() {
            searchQuery = '';
            $('#searchBoxInput').val('');
            switchTab('tatCa');
        }

        // Lọc giải đấu theo tab và từ khóa
        function getFilteredTournaments() {
            return allTournaments.filter(function (t) {
                const tt = (t.trangThai || '').toString();
                const ttText = (t.trangThaiText || '').toLowerCase();

                // 1. Lọc trạng thái
                let matchStatus = true;
                if (activeTab === 'sapDienRa') {
                    matchStatus = (tt === 'SapDienRa' || tt === '2' || tt === 'Nhap' || tt === '1' || ttText.includes('sắp') || ttText.includes('nháp'));
                } else if (activeTab === 'dangDienRa') {
                    matchStatus = (tt === 'DangDienRa' || tt === '3' || ttText.includes('đang'));
                } else if (activeTab === 'daKetThuc') {
                    matchStatus = (tt === 'KetThuc' || tt === '4' || ttText.includes('kết thúc'));
                }

                // 2. Lọc keyword
                const ten = (t.ten || '').toLowerCase();
                const diaDiem = (t.diaDiem || '').toLowerCase();
                const ma = (t.ma || '').toLowerCase();
                const matchKeyword = !searchQuery ||
                    ten.includes(searchQuery) ||
                    diaDiem.includes(searchQuery) ||
                    ma.includes(searchQuery);

                return matchStatus && matchKeyword;
            });
        }

        // Hiển thị danh sách giải đấu
        function renderList() {
            const list = getFilteredTournaments();
            const $container = $('#tournamentContainer');
            $container.empty();

            if (list.length === 0) {
                $('#emptyState').removeClass('d-none');
                return;
            }

            $('#emptyState').addClass('d-none');

            list.forEach(function (t) {
                const cardHtml = buildTournamentCardHtml(t);
                $container.append(cardHtml);
            });
        }

        // Đổi trang danh sách môn thi đấu trong một giải (4 môn / trang)
        function changeSportPage(tournamentId, newPage) {
            sportPageMap[tournamentId] = newPage;
            // Chỉ cập nhật lại card tương ứng
            const t = allTournaments.find(x => x.id === tournamentId);
            if (t) {
                const $oldCard = $(`#tournament-card-${tournamentId}`);
                if ($oldCard.length) {
                    const newCardHtml = buildTournamentCardHtml(t);
                    $oldCard.replaceWith(newCardHtml);
                }
            }
        }

        // Dựng HTML cho từng TournamentCard đồng bộ chính xác với bản React
        function buildTournamentCardHtml(t) {
            const sports = t.monTheThaos || [];
            const pageSize = 4;
            const curPage = sportPageMap[t.id] || 1;
            const totalPages = Math.ceil(sports.length / pageSize) || 1;
            const safePage = Math.min(Math.max(curPage, 1), totalPages);
            sportPageMap[t.id] = safePage;

            const startIndex = (safePage - 1) * pageSize;
            const currentSports = sports.slice(startIndex, startIndex + pageSize);

            const hasImage = !!t.hinhAnh;
            const bannerUrl = hasImage ? t.hinhAnh : '';
            const bannerBg = hasImage ? '#0f172a' : 'linear-gradient(145deg, #0f172a 0%, #1e293b 50%, #0369a1 100%)';

            const statusText = t.trangThaiText || getStatusText(t.trangThai);
            const statusClass = getStatusBadgeClass(t.trangThai);
            const linkUrl = `/Home/Details/${t.id}`;

            // HTML danh sách môn
            let sportsHtml = '';
            if (sports.length === 0) {
                sportsHtml = `
                    <div class="text-muted small py-3 px-3 bg-light rounded-3 text-center border">
                        Chưa có môn thi đấu nào được gán cho giải đấu này.
                    </div>
                `;
            } else {
                sportsHtml += `<div class="d-flex flex-column gap-2">`;
                currentSports.forEach(function (mon, idx) {
                    const num = startIndex + idx + 1;
                    sportsHtml += `
                        <div class="category-item d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 py-2 px-3">
                            <div class="d-flex align-items-center gap-2.5 flex-grow-1 min-w-0">
                                <div class="category-index-badge flex-shrink-0 me-2">${num}</div>
                                <div class="text-truncate">
                                    <span class="fw-bold text-dark d-block text-truncate" style="font-size: 0.95rem;">${escapeHtml(mon.ten)}</span>
                                    ${mon.moTa ? `<span class="text-muted small d-block text-truncate" style="font-size: 0.78rem;">${escapeHtml(mon.moTa)}</span>` : ''}
                                </div>
                            </div>
                            <div class="d-flex flex-wrap align-items-center gap-2 flex-shrink-0">
                                ${mon.tenDanhMuc ? `
                                    <span class="badge rounded-pill px-2.5 py-1.5 fw-medium d-flex align-items-center gap-1" style="background-color: #f1f5f9; color: #334155; border: 1px solid #e2e8f0;">
                                        <i class="bi bi-tag text-muted"></i>
                                        <span>${escapeHtml(mon.tenDanhMuc)}</span>
                                    </span>
                                ` : ''}
                                <span class="badge rounded-pill px-2.5 py-1.5 fw-medium d-flex align-items-center gap-1" style="background-color: ${mon.laMonDongDoi ? '#eff6ff' : '#f5f3ff'}; color: ${mon.laMonDongDoi ? '#1d4ed8' : '#6d28d9'};">
                                    <i class="${mon.laMonDongDoi ? 'bi bi-people-fill' : 'bi bi-person-fill'}"></i>
                                    <span>${mon.laMonDongDoi ? 'Đồng đội' : 'Cá nhân'}</span>
                                </span>
                            </div>
                        </div>
                    `;
                });
                sportsHtml += `</div>`;

                // Phân trang môn thi đấu (4 môn / trang)
                if (totalPages > 1) {
                    sportsHtml += `
                        <div class="d-flex justify-content-between align-items-center pt-3 mt-3 border-top border-light-subtle">
                            <span class="small text-muted" style="font-size: 0.78rem;">
                                Hiển thị ${startIndex + 1} - ${Math.min(startIndex + pageSize, sports.length)} trong tổng số ${sports.length} môn
                            </span>
                            <div class="d-flex align-items-center gap-1">
                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary p-0 d-inline-flex align-items-center justify-content-center rounded-circle"
                                        style="width: 26px; height: 26px; font-size: 0.75rem;"
                                        ${safePage === 1 ? 'disabled' : ''}
                                        onclick="changeSportPage(${t.id}, ${safePage - 1})"
                                        title="Trang trước">
                                    <i class="bi bi-chevron-left"></i>
                                </button>
                    `;

                    for (let p = 1; p <= totalPages; p++) {
                        const isActive = (p === safePage);
                        sportsHtml += `
                            <button type="button"
                                    class="btn btn-sm rounded-circle p-0 d-inline-flex align-items-center justify-content-center ${isActive ? 'btn-warning text-white fw-bold' : 'btn-light border text-secondary'}"
                                    style="width: 26px; height: 26px; font-size: 0.75rem; ${isActive ? 'background-color: #ea580c; border-color: #ea580c;' : ''}"
                                    onclick="changeSportPage(${t.id}, ${p})">
                                ${p}
                            </button>
                        `;
                    }

                    sportsHtml += `
                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary p-0 d-inline-flex align-items-center justify-content-center rounded-circle"
                                        style="width: 26px; height: 26px; font-size: 0.75rem;"
                                        ${safePage === totalPages ? 'disabled' : ''}
                                        onclick="changeSportPage(${t.id}, ${safePage + 1})"
                                        title="Trang sau">
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                            </div>
                        </div>
                    `;
                }
            }

            return `
                <div class="tournament-card overflow-hidden" id="tournament-card-${t.id}">
                    <div class="row g-0">
                        <!-- Cột Trái: Banner Poster Giải Đấu -->
                        <div class="col-lg-4 p-3 p-md-4">
                            <a href="${linkUrl}" class="d-block text-decoration-none h-100 banner-click-hover" title="Xem chi tiết giải đấu ${escapeHtml(t.ten)}">
                                <div class="tournament-banner-container h-100 rounded-4 overflow-hidden position-relative shadow-sm d-flex flex-column justify-content-between"
                                     style="min-height: 340px; background: ${bannerBg}; cursor: pointer;">
                                    ${hasImage ? `
                                        <img src="${bannerUrl}"
                                             alt="${escapeHtml(t.ten)}"
                                             class="w-100 h-100 position-absolute top-0 start-0"
                                             style="object-fit: cover; object-position: center;" />
                                    ` : ''}
                                    <div class="position-absolute top-0 start-0 w-100 h-100"
                                         style="background: linear-gradient(180deg, rgba(0,0,0,0.3) 0%, rgba(0,0,0,0.1) 40%, rgba(0,0,0,0.85) 100%);">
                                    </div>

                                    <!-- Top Badges -->
                                    <div class="position-relative z-1 p-3 d-flex justify-content-between align-items-center">
                                        <span class="badge bg-warning text-dark fw-bold px-2.5 py-1.5 shadow-sm">${escapeHtml(t.ma || 'GIẢI ĐẤU')}</span>
                                        <span class="badge ${statusClass} px-2.5 py-1.5 shadow-sm">${escapeHtml(statusText)}</span>
                                    </div>

                                    <!-- Bottom Info -->
                                    <div class="position-relative z-1 p-3 text-white mt-auto">
                                        <div class="badge bg-primary bg-opacity-75 text-white mb-2 small">${escapeHtml(t.phamViText || 'Giải Đấu Thể Thao')}</div>
                                        <div class="pt-3 border-top border-secondary border-opacity-25 d-flex justify-content-between align-items-center small text-light text-opacity-75">
                                            <div>
                                                <i class="bi bi-clock me-1 text-warning"></i>
                                                ${formatDate(t.ngayBatDau)}
                                            </div>
                                            <div class="text-warning fw-semibold">
                                                ${t.ngayKetThuc ? `Đến ${formatDate(t.ngayKetThuc)}` : ''}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>

                        <!-- Cột Phải: Thông tin chi tiết & Danh sách Môn thi đấu -->
                        <div class="col-lg-8 p-3 p-md-4 d-flex flex-column justify-content-between">
                            <div>
                                <!-- Tiêu đề giải & Trạng thái -->
                                <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-2">
                                    <h4 class="fw-bold text-dark mb-0 text-uppercase flex-grow-1" style="font-size: 1.25rem;">
                                        ${escapeHtml(t.ten)}
                                    </h4>
                                    <span class="badge rounded-pill px-3 py-1.5 fw-semibold" style="background-color: #e0f2fe; color: #0369a1; font-size: 0.78rem;">
                                        ${escapeHtml(statusText)}
                                    </span>
                                </div>

                                <!-- Địa điểm, Thời gian, Hạn ĐK -->
                                <div class="d-flex flex-wrap align-items-center gap-3 text-secondary small mb-3">
                                    <div class="d-flex align-items-center gap-1 text-primary">
                                        <i class="bi bi-geo-alt"></i>
                                        <span>${escapeHtml(t.diaDiem || 'Địa điểm đang cập nhật')}</span>
                                    </div>
                                    <div class="d-flex align-items-center gap-1 text-success">
                                        <i class="bi bi-calendar-check"></i>
                                        <span>${formatDate(t.ngayBatDau)} - ${formatDate(t.ngayKetThuc)}</span>
                                    </div>
                                    <div class="d-flex align-items-center gap-1 text-danger fw-medium">
                                        <i class="bi bi-clock-history"></i>
                                        <span>Hạn ĐK: ${formatDate(t.hanDangKy || t.ngayBatDau)}</span>
                                    </div>
                                </div>

                                <!-- Danh sách Môn / Nội Dung Thi Đấu -->
                                <div class="mt-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div class="fw-bold text-secondary text-uppercase small" style="letter-spacing: 0.5px;">
                                            MÔN THI ĐẤU (${sports.length})
                                        </div>
                                    </div>
                                    ${sportsHtml}
                                </div>
                            </div>

                            <!-- Footer Card: Xem chi tiết điều lệ giải đấu -->
                            <div class="mt-3 pt-3 border-top d-flex align-items-center justify-content-end">
                                <a href="${linkUrl}"
                                   class="btn btn-outline-warning rounded-3 px-3.5 py-2 fw-semibold d-inline-flex align-items-center gap-1.5 text-decoration-none shadow-sm"
                                   style="border-color: #ea580c; color: #ea580c; font-size: 0.88rem;">
                                    <span>Xem chi tiết điều lệ giải đấu</span>
                                    <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }

        // Định dạng ngày hiển thị dd/MM/yyyy
        function formatDate(dateStr) {
            if (!dateStr) return '';
            try {
                const d = new Date(dateStr);
                if (isNaN(d.getTime())) return dateStr;
                const day = String(d.getDate()).padStart(2, '0');
                const month = String(d.getMonth() + 1).padStart(2, '0');
                const year = d.getFullYear();
                return `${day}/${month}/${year}`;
            } catch {
                return dateStr;
            }
        }

        function getStatusText(val) {
            const str = (val || '').toString();
            if (str === 'DangDienRa' || str === '3') return 'Đang diễn ra';
            if (str === 'SapDienRa' || str === '2') return 'Sắp diễn ra';
            if (str === 'KetThuc' || str === '4') return 'Đã kết thúc';
            if (str === 'Nhap' || str === '1') return 'Bản nháp';
            return 'Đang mở đăng ký';
        }

        function getStatusBadgeClass(val) {
            const str = (val || '').toString();
            if (str === 'DangDienRa' || str === '3') return 'bg-danger';
            if (str === 'SapDienRa' || str === '2') return 'bg-primary';
            if (str === 'KetThuc' || str === '4') return 'bg-secondary';
            return 'bg-warning text-dark';
        }

        function escapeHtml(text) {
            if (!text) return '';
            return $('<div>').text(text).html();
        }
    </script>
}
